    width: 100%;
}
.service {
    border: 1px solid #000;
    padding: 10px;
    text-align: center;
}
footer {
    background-color: #000;
    color: #fff;
    padding: 10px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}
.social-icons a {
    margin-left: 10px;
}
.footer-links a {
    color: #fff;
    margin-right: 10px;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
