<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 151.0mm; inset-block-start: 64.4mm; inline-size: 47.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<div  style="inset-inline-start: 3.3mm; inset-block-start: 69.4mm; inline-size: 202.8mm; block-size: 102.2mm; font-size: 15.3pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 31.1mm; inset-block-start: 183.5mm; inline-size: 80.4mm; block-size: 35.0mm; font-size: 11.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 118.4mm; inset-block-start: 183.5mm; inline-size: 80.4mm; block-size: 30.9mm; font-size: 11.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.1mm; inset-block-start: 221.8mm; inline-size: 80.4mm; block-size: 14.8mm; font-size: 10.5pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 118.4mm; inset-block-start: 220.5mm; inline-size: 37.5mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 118.4mm; inset-block-start: 226.6mm; inline-size: 41.6mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 118.4mm; inset-block-start: 230.3mm; inline-size: 74.6mm; block-size: 2.8mm; font-size: 7.8pt">{{ slot_6 }}</p>
</div></body>
</html>
