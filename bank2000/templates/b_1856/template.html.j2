<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 85.2mm; inline-size: 73.2mm; block-size: 94.7mm; font-size: 13.4pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 85.2mm; inline-size: 73.8mm; block-size: 37.1mm; font-size: 13.1pt">{{ slot_1 }}</p>
