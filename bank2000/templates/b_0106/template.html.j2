<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.8; --align: start; --page-width: 297mm; --page-height: 210mm; --page-margin: 16mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
<style>/* flowing columns (reading order): a block stays in one column, a heading stays with what follows */
[style*="column-count"] > *, [style*="column-width"] > * { break-inside: avoid; }
[style*="column-count"] > h1, [style*="column-count"] > h2, [style*="column-count"] > h3, [style*="column-count"] > h4, [style*="column-count"] > h5, [style*="column-count"] > h6, [style*="column-width"] > h1, [style*="column-width"] > h2, [style*="column-width"] > h3, [style*="column-width"] > h4, [style*="column-width"] > h5, [style*="column-width"] > h6 { break-after: avoid; }</style>
</head>
<body><div class="page">
<main style="column-count: 2; column-gap: 8mm; column-rule: 1px solid #bbb"><blockquote style="border-inline-start: 2px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_0 }}</blockquote>
<p style="margin-block: 0 1em; text-indent: 0; text-align: start; font-size: 1.05em">{{ slot_1 }}</p>
<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.8em">
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ul>
<p style="margin-block: 0 0.7em; text-indent: 1.5em; text-align: var(--align); font-size: 1.05em">{{ slot_4 }}</p>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 45mm; margin-inline: auto; inline-size: 50%" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_5 }}</figcaption></figure><p style="margin-block: 0 0.4em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_6 }}</p></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_7 }}</span><span>{{ slot_8 }}</span><span>{{ slot_9 }}</span></footer>
</div></body>
</html>
