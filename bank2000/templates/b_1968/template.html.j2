<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div  style="inset-inline-start: 14.5mm; inset-block-start: 29.6mm; inline-size: 145.9mm; block-size: 79.6mm; font-size: 8.5pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 116.8mm; inline-size: 151.1mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 134.4mm; inline-size: 41.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div  style="inset-inline-start: 73.7mm; inset-block-start: 144.9mm; inline-size: 109.9mm; block-size: 15.6mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 157.6mm; inline-size: 6.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div  style="inset-inline-start: 81.2mm; inset-block-start: 164.9mm; inline-size: 102.3mm; block-size: 7.2mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 174.6mm; inline-size: 151.1mm; block-size: 15.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 190.5mm; inline-size: 151.1mm; block-size: 19.0mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div  style="inset-inline-start: 96.0mm; inset-block-start: 209.8mm; inline-size: 87.5mm; block-size: 10.0mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_3" src="{{ pic_3 }}" alt=""></div>
<footer class="box" style="inset-inline-start: 103.8mm; inset-block-start: 236.5mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
