<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 105.3mm; inset-block-start: 54.5mm; inline-size: 80.2mm; block-size: 33.1mm; font-size: 13.4pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 16.7mm; inset-block-start: 60.7mm; inline-size: 37.5mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 15.5mm; inset-block-start: 69.9mm; inline-size: 50.4mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 74.8mm; inline-size: 80.0mm; block-size: 28.1mm; font-size: 13.3pt">{{ slot_3 }}</p>
<div  style="inset-inline-start: 114.8mm; inset-block-start: 103.8mm; inline-size: 86.1mm; block-size: 81.8mm; font-size: 15.5pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 106.3mm; inline-size: 80.0mm; block-size: 13.1mm; font-size: 12.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 121.3mm; inline-size: 24.7mm; block-size: 38.1mm; font-size: 13.5pt">{{ slot_5 }}</p>
<div  style="inset-inline-start: 42.3mm; inset-block-start: 121.5mm; inline-size: 66.7mm; block-size: 35.8mm; font-size: 40.0pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<header class="box" style="inset-inline-start: 205.2mm; inset-block-start: 135.5mm; inline-size: 3.1mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 161.2mm; inline-size: 80.0mm; block-size: 28.1mm; font-size: 13.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 193.2mm; inline-size: 80.1mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 105.3mm; inset-block-start: 192.7mm; inline-size: 80.1mm; block-size: 38.1mm; font-size: 13.5pt">{{ slot_9 }}</p>
<div  style="inset-inline-start: 15.6mm; inset-block-start: 215.5mm; inline-size: 79.7mm; block-size: 51.4mm; font-size: 14.6pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
</div></body>
</html>
