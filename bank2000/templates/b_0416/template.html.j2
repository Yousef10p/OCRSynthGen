<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.4; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
<style>/* flowing columns (reading order): a block stays in one column, a heading stays with what follows */
[style*="column-count"] > *, [style*="column-width"] > * { break-inside: avoid; }
[style*="column-count"] > h1, [style*="column-count"] > h2, [style*="column-count"] > h3, [style*="column-count"] > h4, [style*="column-count"] > h5, [style*="column-count"] > h6, [style*="column-width"] > h1, [style*="column-width"] > h2, [style*="column-width"] > h3, [style*="column-width"] > h4, [style*="column-width"] > h5, [style*="column-width"] > h6 { break-after: avoid; }</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main style="column-count: 2; column-gap: 8mm; column-rule: none"><div style="margin-block: 0.6em">
<div style="display: flex; gap: 0.8em; align-items: baseline; margin-block: 0.35em">
<span style="font-weight: bold; white-space: nowrap">{{ slot_1 }}</span><span style="border: 1px solid #555; padding-inline: 0.4em; flex: 1; min-inline-size: 5em">{{ slot_2 }}</span>
</div>
<div style="display: flex; gap: 0.8em; align-items: baseline; margin-block: 0.35em">
<span style="font-weight: bold; white-space: nowrap">{{ slot_3 }}</span><span style="border: 1px solid #555; padding-inline: 0.4em; flex: 1; min-inline-size: 5em">{{ slot_4 }}</span>
</div>
</div>
<h3 style="font-size: calc(var(--base-size) * 1.5); text-align: center; margin-block: 0.6em 0.4em">{{ slot_5 }}</h3>
<ol style="list-style-type: decimal; margin-block: 0.3em; padding-inline-start: 1.8em">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
</ol>
<blockquote style="border-inline-start: 2px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_9 }}</blockquote>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_10 }}</blockquote>
<aside style="border: 1px solid #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><h4>{{ slot_11 }}</h4>
<p style="margin-block: 0.2em">{{ slot_12 }}</p></aside><div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
<p style="margin-block: 0.15em">{{ slot_13 }}</p>
<p style="margin-block: 0.15em">{{ slot_14 }}</p>
<p style="margin-block: 0.15em">{{ slot_15 }}</p>
</div></main>
</div></body>
</html>
