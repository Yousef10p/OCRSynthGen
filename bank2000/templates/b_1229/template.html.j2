.py-2{padding-top:.5rem;padding-bottom:.5rem}
.py-8{padding-top:2rem;padding-bottom:2rem}
.text-sm{font-size:.875rem;line-height:1.25rem}
.text-xl{font-size:1.25rem;line-height:1.75rem}
.text-3xl{font-size:1.875rem;line-height:2.25rem}
.font-semibold{font-weight:600}
.font-bold{font-weight:700}
.leading-normal{line-height:1.5}
.tracking-tight{letter-spacing:-.025em}
.text-white{--tw-text-opacity:1;color:rgba(255,255,255,var(--tw-text-opacity))}
.text-gray-700{--tw-text-opacity:1;color:rgba(55,65,81,var(--tw-text-opacity))}
*,::after,::before{--tw-shadow:0 0 #0000}
*,::after,::before{--tw-ring-inset:var(--tw-empty, );--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgba(59, 130, 246, 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000}
@media (min-width:1024px){.lg\:mt-0{margin-top:0}}
@media (min-width:1024px){.lg\:inline-block{display:inline-block}}
@media (min-width:1024px){.lg\:flex{display:flex}}
@media (min-width:1024px){.lg\:w-auto{width:auto}}
@media (min-width:1024px){.lg\:flex-grow{flex-grow:1}}
@media (min-width:1024px){.lg\:items-center{align-items:center}}
.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
