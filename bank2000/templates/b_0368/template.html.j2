<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.8; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
<style>/* flowing columns (reading order): a block stays in one column, a heading stays with what follows */
[style*="column-count"] > *, [style*="column-width"] > * { break-inside: avoid; }
[style*="column-count"] > h1, [style*="column-count"] > h2, [style*="column-count"] > h3, [style*="column-count"] > h4, [style*="column-count"] > h5, [style*="column-count"] > h6, [style*="column-width"] > h1, [style*="column-width"] > h2, [style*="column-width"] > h3, [style*="column-width"] > h4, [style*="column-width"] > h5, [style*="column-width"] > h6 { break-after: avoid; }</style>
</head>
<body><div class="page"><main style="column-count: 2; column-gap: 8mm; column-rule: none"><p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_0 }}</p>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_1 }}</blockquote>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.3em 1em; margin-block: 0.6em; break-inside: avoid">
<div style="font-weight: bold">{{ slot_2 }}</div>
<div>{{ slot_3 }}</div>
<div style="font-weight: bold">{{ slot_4 }}</div>
<div>{{ slot_5 }}</div>
<div style="font-weight: bold">{{ slot_6 }}</div>
<div>{{ slot_7 }}</div>
<div style="font-weight: bold">{{ slot_8 }}</div>
<div>{{ slot_9 }}</div>
<div style="font-weight: bold">{{ slot_10 }}</div>
<div>{{ slot_11 }}</div>
<div style="font-weight: bold">{{ slot_12 }}</div>
<div>{{ slot_13 }}</div>
</div>
<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_14 }}</p>
<div style="border: 1px solid #333; padding: 0.6em 0.9em; border-radius: 4px; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_15 }}</strong><p style="margin-block: 0">{{ slot_16 }}</p>
</div>
<ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 1.8em">
<li>{{ slot_17 }}</li>
<li>{{ slot_18 }}</li>
<li>{{ slot_19 }}</li>
<li>{{ slot_20 }}</li>
<li>{{ slot_21 }}</li>
</ol></main></div></body>
</html>
