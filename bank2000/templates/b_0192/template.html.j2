<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_19 }}</figcaption></figure><h2 style="font-size: calc(var(--base-size) * 1.3); text-align: end; margin-block: 1.4em 0.4em">{{ slot_20 }}</h2></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_21 }}</span></footer>
</div></body>
</html>
