</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_23 }}</span><span>{{ slot_24 }}</span></footer>
</div></body>
</html>
