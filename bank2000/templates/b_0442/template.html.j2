<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.8; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 24mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.6); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_1 }}</p>
<main style="display: grid; column-gap: 7mm; grid-template-columns: 2.4fr 1fr"><div>
<p style="margin-block: 0 0.7em; text-indent: 1.5em; text-align: start; font-size: 1.05em">{{ slot_2 }}</p>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_3 }}</h3>
<div style="border: 1px solid #333; padding: 0.6em 0.9em; border-radius: 4px; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_4 }}</strong><p style="margin-block: 0">{{ slot_5 }}</p>
</div>
<dl style="margin-block: 0.6em">
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_6 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_7 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_8 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_9 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_10 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_11 }}</dd>
</dl>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: var(--align); font-size: 0.95em">{{ slot_12 }}</p>
</div>
<aside style="background: #f2f2f2; padding: 0.6em; border-inline-start: 1px solid #999"><h3>{{ slot_13 }}</h3>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_14 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_15 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_16 }}</p></aside><div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em"><p style="margin-block: 0.15em">{{ slot_17 }}</p></div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_18 }}</span><span>{{ slot_19 }}</span></footer>
</div></body>
</html>
