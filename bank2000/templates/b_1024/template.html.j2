</main>
<footer class="bg-gray-800 text-white p-4">
<div class="max-w-screen-lg mx-auto">
<h2 class="text-xl mb-4">{{ slot_12 }}</h2>
<p class="mb-4">
        {{ slot_13 }}<br>
        {{ slot_14 }}<br>
        {{ slot_15 }}<br>
        {{ slot_16 }}
      </p>
<div  style="block-size: 450px" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
</div>
</footer>
</body>
</html>