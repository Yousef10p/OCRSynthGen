<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.8; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 13mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
<style>/* flowing columns (reading order): a block stays in one column, a heading stays with what follows */
[style*="column-count"] > *, [style*="column-width"] > * { break-inside: avoid; }
[style*="column-count"] > h1, [style*="column-count"] > h2, [style*="column-count"] > h3, [style*="column-count"] > h4, [style*="column-count"] > h5, [style*="column-count"] > h6, [style*="column-width"] > h1, [style*="column-width"] > h2, [style*="column-width"] > h3, [style*="column-width"] > h4, [style*="column-width"] > h5, [style*="column-width"] > h6 { break-after: avoid; }</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.2); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main style="column-count: 3; column-gap: 8mm; column-rule: 1px solid #bbb"><ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ol>
<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_4 }}</p>
<p style="margin-block: 0 1em; text-indent: 0; text-align: start; font-size: 1.05em">{{ slot_5 }}</p>
<p style="margin-block: 0 0.4em; text-indent: 0; text-align: var(--align); font-size: 0.95em">{{ slot_6 }}</p>
<dl style="margin-block: 0.6em">
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_7 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_8 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_9 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_10 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_11 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_12 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_13 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_14 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_15 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_16 }}</dd>
</dl></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_17 }}</span></footer>
</div></body>
</html>
