<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.4; --align: start; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page"><main style="column-count: 3; column-gap: 8mm; column-rule: 1px solid #bbb"><p style="margin-block: 0 1em; text-indent: 1.5em; text-align: var(--align); font-size: 1em">{{ slot_0 }}</p>
<h3 style="font-size: calc(var(--base-size) * 1.3); text-align: end; margin-block: 1em 0.4em">{{ slot_1 }}</h3>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: var(--align); font-size: 1em">{{ slot_2 }}</p>
<aside style="border: 1px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_3 }}</p>
<p style="margin-block: 0.2em">{{ slot_4 }}</p></aside><div style="border: 1px solid #333; padding: 0.6em 0.9em; border-radius: 4px; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_5 }}</strong><p style="margin-block: 0">{{ slot_6 }}</p>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: center; margin-block: 0.6em 0.4em">{{ slot_7 }}</h2>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1.4em 0.4em">{{ slot_8 }}</h2>
<table style="border-collapse: collapse; inline-size: 100%; margin-block: 0.6em; font-size: 0.9em; break-inside: avoid">
<thead><tr>
<th style="border: 1px solid #000; padding: 0.2em 0.5em; text-align: start; background: #e8e8e8; font-weight: bold">{{ slot_9 }}</th>
<th style="border: 1px solid #000; padding: 0.2em 0.5em; text-align: start; background: #e8e8e8; font-weight: bold">{{ slot_10 }}</th>
</tr></thead>
<tbody>
<tr><td style="border: 1px solid #000; padding: 0.2em 0.5em; text-align: start" colspan="2">{{ slot_11 }}</td></tr>
<tr>
<td style="border: 1px solid #000; padding: 0.2em 0.5em; text-align: start">{{ slot_12 }}</td>
<td style="border: 1px solid #000; padding: 0.2em 0.5em; text-align: start">{{ slot_13 }}</td>
</tr>
</tbody>
</table></main></div></body>
</html>
