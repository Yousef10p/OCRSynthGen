<p style="margin-block: 0.2em">{{ slot_16 }}</p></aside><h2 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_17 }}</h2></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_18 }}</span><span>{{ slot_19 }}</span></footer>
