<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.4; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 16mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main style="display: grid; column-gap: 7mm; grid-template-columns: 2.4fr 1fr"><div>
<aside style="border: 1px solid #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_1 }}</p>
<p style="margin-block: 0.2em">{{ slot_2 }}</p></aside><div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 1"><p style="margin-block: 0">{{ slot_3 }}</p></div>
<div style="flex: 0 0 35%; block-size: 40mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
</div>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: start; font-size: 1.05em">{{ slot_4 }}</p>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: var(--align); font-size: 1.05em">{{ slot_5 }}</p>
<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_6 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 0.6em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_7 }}</h2>
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: none; padding: 0.6em; border-radius: 6px">
<div style="block-size: 28mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_8 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_9 }}</p>
</div>
<div style="border: none; padding: 0.6em; border-radius: 6px">
<div style="block-size: 35mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_10 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_11 }}</p>
</div>
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 0">
<div style="block-size: 33mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_3" src="{{ pic_3 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_12 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_13 }}</p>
</div>
</div>
<aside style="border: 1px solid #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_14 }}</p></aside><ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_15 }}</li>
<li>{{ slot_16 }}</li>
<li>{{ slot_17 }}</li>
<li>{{ slot_18 }}</li>
<li>{{ slot_19 }}</li>
</ol>
</div>
<aside style="background: #f2f2f2; padding: 0.6em; border-inline-start: 1px solid #999"><h3>{{ slot_20 }}</h3>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_21 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_22 }}</p></aside></main>
</div></body>
</html>
