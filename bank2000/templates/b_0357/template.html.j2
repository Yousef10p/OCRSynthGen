<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.4; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 24mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div style="border-block: 2px solid #222; padding: 0.6em 0; margin-block-end: 1em; text-align: start">
<h1 style="margin: 0; font-size: calc(var(--base-size) * 2.4)">{{ slot_0 }}</h1>
<div style="font-size: 1.05em; margin-block-start: 0.3em">{{ slot_1 }}</div>
</div>
<main><div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_2 }}</h3>
<p style="margin-block: 0">{{ slot_3 }}</p>
</div>
<div style="flex: 0 0 30%; block-size: 45mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 0.6em 0.4em">{{ slot_4 }}</h2>
<aside style="border: 2px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><h4>{{ slot_5 }}</h4>
<p style="margin-block: 0.2em">{{ slot_6 }}</p>
<p style="margin-block: 0.2em">{{ slot_7 }}</p></aside><div style="margin-block: 0.8em; border-inline-start: 2px solid #666; padding-inline-start: 0.9em">
<div style="margin-block: 0.5em">
<div style="font-weight: bold; font-size: 0.9em">{{ slot_8 }}</div>
<div>{{ slot_9 }}</div>
</div>
<div style="margin-block: 0.5em">
<div style="font-weight: bold; font-size: 0.9em">{{ slot_10 }}</div>
<div>{{ slot_11 }}</div>
</div>
<div style="margin-block: 0.5em">
<div style="font-weight: bold; font-size: 0.9em">{{ slot_12 }}</div>
<div>{{ slot_13 }}</div>
</div>
<div style="margin-block: 0.5em">
<div style="font-weight: bold; font-size: 0.9em">{{ slot_14 }}</div>
<div>{{ slot_15 }}</div>
</div>
</div></main>
</div></body>
</html>
