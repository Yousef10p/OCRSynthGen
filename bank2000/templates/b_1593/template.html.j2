<div  style="inset-inline-start: 95.0mm; inset-block-start: 163.6mm; inline-size: 83.5mm; block-size: 11.4mm; font-size: 10.0pt" class="box pic-frame"><img data-pic="pic_3" src="{{ pic_3 }}" alt=""></div>
<p class="box" style="inset-inline-start: 58.3mm; inset-block-start: 177.1mm; inline-size: 10.0mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div  style="inset-inline-start: 76.2mm; inset-block-start: 191.2mm; inline-size: 83.2mm; block-size: 21.1mm; font-size: 10.0pt" class="box pic-frame"><img data-pic="pic_4" src="{{ pic_4 }}" alt=""></div>
<p class="box" style="inset-inline-start: 58.3mm; inset-block-start: 219.3mm; inline-size: 120.3mm; block-size: 10.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 117.5mm; inset-block-start: 251.5mm; inline-size: 1.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
