<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 279.4mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 168.4mm; inset-block-start: 23.5mm; inline-size: 79.2mm; block-size: 57.6mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<div  style="inset-inline-start: 0.2mm; inset-block-start: 53.4mm; inline-size: 159.0mm; block-size: 85.7mm; font-size: 15.2pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 168.1mm; inset-block-start: 88.5mm; inline-size: 78.9mm; block-size: 12.3mm; font-size: 11.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 168.1mm; inset-block-start: 102.1mm; inline-size: 81.8mm; block-size: 16.8mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 168.1mm; inset-block-start: 120.2mm; inline-size: 79.5mm; block-size: 11.3mm; font-size: 10.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 43.9mm; inset-block-start: 143.6mm; inline-size: 99.0mm; block-size: 10.9mm; font-size: 31.0pt">{{ slot_4 }}</h2>
<div  style="inset-inline-start: 114.3mm; inset-block-start: 157.6mm; inline-size: 164.8mm; block-size: 30.8mm; font-size: 14.6pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 167.5mm; inline-size: 87.1mm; block-size: 21.0mm; font-size: 11.9pt">{{ slot_5 }}</p>
</div></body>
</html>
