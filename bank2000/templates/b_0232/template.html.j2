</div>
<div style="display: flex; gap: 0.8em; align-items: baseline; margin-block: 0.35em">
<span style="font-weight: bold; white-space: nowrap">{{ slot_10 }}</span><span style="border-block-end: 1px solid #000; flex: 1; min-inline-size: 5em">{{ slot_11 }}</span>
</div>
<div style="display: flex; gap: 0.8em; align-items: baseline; margin-block: 0.35em">
<span style="font-weight: bold; white-space: nowrap">{{ slot_12 }}</span><span style="border-block-end: 1px solid #000; flex: 1; min-inline-size: 5em">{{ slot_13 }}</span>
</div>
</div>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: center; margin-block: 1em 0.4em">{{ slot_14 }}</h3>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 40%; block-size: 32mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<div style="flex: 1"><p style="margin-block: 0">{{ slot_15 }}</p></div>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1.4em 0.4em">{{ slot_16 }}</h2>
</div>
<aside style="background: transparent; padding: 0.6em; border-inline-start: 1px solid #999"><h3>{{ slot_17 }}</h3>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_18 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_19 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_20 }}</p></aside></main>
</div></body>
</html>
