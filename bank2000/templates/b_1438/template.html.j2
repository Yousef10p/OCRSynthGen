<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 355.6mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 276.4mm; inset-block-start: 4.3mm; inline-size: 21.0mm; block-size: 11.4mm; font-size: 10.8pt">{{ slot_0 }}</p>
<h1 class="box" style="inset-inline-start: 190.1mm; inset-block-start: 11.5mm; inline-size: 41.9mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 253.0mm; inset-block-start: 39.6mm; inline-size: 17.6mm; block-size: 7.8mm; font-size: 11.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 229.2mm; inset-block-start: 61.3mm; inline-size: 20.7mm; block-size: 7.9mm; font-size: 11.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 206.5mm; inset-block-start: 74.5mm; inline-size: 20.1mm; block-size: 7.9mm; font-size: 11.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 182.6mm; inset-block-start: 82.1mm; inline-size: 20.0mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 176.5mm; inset-block-start: 148.3mm; inline-size: 2.6mm; block-size: 64.3mm; font-size: 40.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 14.4mm; inset-block-start: 185.2mm; inline-size: 29.2mm; block-size: 10.0mm; font-size: 9.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 14.4mm; inset-block-start: 197.9mm; inline-size: 26.4mm; block-size: 2.8mm; font-size: 7.8pt">{{ slot_8 }}</p>
<div  style="inset-inline-start: 305.0mm; inset-block-start: 202.0mm; inline-size: 39.5mm; block-size: 7.9mm; font-size: 22.4pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<div  style="inset-inline-start: 12.3mm; inset-block-start: 206.2mm; inline-size: 37.4mm; block-size: 7.5mm; font-size: 21.2pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 309.2mm; inset-block-start: 211.0mm; inline-size: 27.9mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_9 }}</p>
</div></body>
</html>
