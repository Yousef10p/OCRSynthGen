<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 23mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.2); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_1 }}</p>
<main style="display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 8mm"><div>
<h3 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1em 0.4em">{{ slot_2 }}</h3>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: var(--align); font-size: 1em">{{ slot_3 }}</p>
<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: none; padding: 0.6em; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_4 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_5 }}</p>
</div>
<div style="border: none; padding: 0.6em; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_6 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_7 }}</p>
</div>
</div>
<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 6mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: none; padding: 0.6em; border-radius: 6px">
<div style="block-size: 21mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_8 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_9 }}</p>
</div>
<div style="border: none; padding: 0; border-radius: 6px">
<div style="block-size: 33mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_10 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_11 }}</p>
</div>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 0.6em 0.4em">{{ slot_12 }}</h2>
</div>
<div>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1.4em 0.4em">{{ slot_13 }}</h2>
<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 6mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_14 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_15 }}</p>
</div>
<div style="border: none; padding: 0; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_16 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_17 }}</p>
</div>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 1em 0.4em">{{ slot_18 }}</h2>
<p style="margin-block: 0 0.4em; text-indent: 0; text-align: justify; font-size: 1.05em">{{ slot_19 }}</p>
<div style="border: 1px solid #333; padding: 0.6em 0.9em; border-radius: 4px; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_20 }}</strong><p style="margin-block: 0">{{ slot_21 }}</p>
</div>
</div></main>
</div></body>
</html>
