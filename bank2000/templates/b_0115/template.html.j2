<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.8; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 13mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.2); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main style="display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 8mm"><div>
<div style="border-inline-start: 4px solid #333; background: #f3f3f3; padding: 0.6em 0.9em; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_1 }}</strong><p style="margin-block: 0">{{ slot_2 }}</p>
</div>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 40%; block-size: 33mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<div style="flex: 1"><p style="margin-block: 0">{{ slot_3 }}</p></div>
</div>
<ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ol>
</div>
<div>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 40%; block-size: 29mm" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_8 }}</h3>
<p style="margin-block: 0">{{ slot_9 }}</p>
</div>
</div>
<aside style="border: 2px solid #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_10 }}</p></aside><h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 0.6em 0.4em">{{ slot_11 }}</h2>
</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_12 }}</span></footer>
</div></body>
</html>
