<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}


.grid-container {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    grid-gap: 20px;
    padding: 20px;
}


.left-column, .right-column, .main-section {
    padding: 20px;
    background-color: #f2f2f2;
}


.car-image {
    width: 100%;
    height: 200px;
    background-color: #ccc;
    margin-bottom: 20px;
}


footer {
    padding: 20px;
    background-color: #333;
    color: #fff;
}

footer a {
    color: #fff;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
<body>
<div class="grid-container">
<div class="left-column">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<p>{{ slot_2 }}</p>
</div>
<div class="right-column">
<h1>{{ slot_3 }}</h1>
<p>{{ slot_4 }}</p>
<p>{{ slot_5 }}</p>
</div>
<div class="main-section">
<h1>{{ slot_6 }}</h1>
<div class="car-image pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p>{{ slot_7 }}</p>
<div class="car-image pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p>{{ slot_8 }}</p>
</div>
</div>
<footer>
<p>{{ slot_9 }} <a>{{ slot_10 }}</a>{{ slot_11 }} <a>{{ slot_12 }}</a>{{ slot_13 }} <a>{{ slot_14 }}</a>{{ slot_15 }}</p>
<p>{{ slot_16 }} <a>{{ slot_17 }}</a> {{ slot_18 }}</p>
<p><a>{{ slot_19 }}</a> {{ slot_20 }}</p>
</footer>
</body>
</html>