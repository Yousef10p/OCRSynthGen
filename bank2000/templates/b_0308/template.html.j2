<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.8; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 25mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span></header><h1 style="font-size: calc(var(--base-size) * 2.2); text-align: start; margin-block: 0.3em 0.5em">{{ slot_1 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_2 }}</p>
<main style="display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 8mm"><div>
<aside style="border: 1px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_3 }}</p>
<p style="margin-block: 0.2em">{{ slot_4 }}</p></aside><p style="margin-block: 0 0.7em; text-indent: 0; text-align: justify; font-size: 1em">{{ slot_5 }}</p>
</div>
<div>
<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_10 }}<ol style="list-style-type: arabic-indic; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
</ol>
</li>
<li>{{ slot_13 }}</li>
</ul>
</li>
</ul>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: end; margin-block: 1.4em 0.4em">{{ slot_14 }}</h2>
</div>
<div><div style="border-block: 2px solid #333; padding: 0.5em 0; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_15 }}</strong><p style="margin-block: 0">{{ slot_16 }}</p>
</div></div>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
<p style="margin-block: 0.15em">{{ slot_17 }}</p>
<p style="margin-block: 0.15em">{{ slot_18 }}</p>
<p style="margin-block: 0.15em">{{ slot_19 }}</p>
</div></main>
</div></body>
</html>
