<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_3 }}</h3>
<p style="margin-block: 0">{{ slot_4 }}</p>
</div>
</div>
<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_7 }}</p>
</div>
