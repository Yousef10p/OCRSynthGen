<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 25.9mm; inline-size: 44.9mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_0 }}</p>
<div  style="inset-inline-start: 40.7mm; inset-block-start: 34.3mm; inline-size: 128.7mm; block-size: 11.8mm; font-size: 10.0pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 50.3mm; inline-size: 159.2mm; block-size: 23.3mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 74.0mm; inline-size: 159.2mm; block-size: 14.5mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 91.6mm; inline-size: 120.5mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 101.7mm; inline-size: 159.1mm; block-size: 18.4mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 126.3mm; inline-size: 159.2mm; block-size: 28.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div  style="inset-inline-start: 42.3mm; inset-block-start: 157.0mm; inline-size: 132.6mm; block-size: 25.3mm; font-size: 10.0pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 185.9mm; inline-size: 43.3mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_6 }}</p>
<div  style="inset-inline-start: 61.8mm; inset-block-start: 196.3mm; inline-size: 93.2mm; block-size: 50.6mm; font-size: 10.0pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 103.3mm; inset-block-start: 279.1mm; inline-size: 3.5mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_7 }}</p>
</div></body>
</html>
