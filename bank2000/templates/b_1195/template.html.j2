</section>
</main>
<footer class="bg-white p-4 flex justify-between">
<div>
<p class="text-gray-600">{{ slot_9 }}</p>
<ul class="flex space-x-2">
<li><a class="text-gray-600">{{ slot_10 }}</a></li>
<li><a class="text-gray-600">{{ slot_11 }}</a></li>
<li><a class="text-gray-600">{{ slot_12 }}</a></li>
</ul>
</div>
<div>
<p class="text-gray-600">{{ slot_13 }}</p>
<p class="text-gray-600">{{ slot_14 }}</p>
<p class="text-gray-600">{{ slot_15 }}</p>
</div>
<div>
<p class="text-gray-600">{{ slot_16 }}</p>
<form>
<span class="p-2 rounded" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_17 }}</span>
<button class="bg-yellow-500 text-white p-2 rounded">{{ slot_18 }}</button>
</form>
</div>
</footer>
</body>
</html>