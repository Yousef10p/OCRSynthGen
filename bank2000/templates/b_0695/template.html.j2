<!DOCTYPE html>
<html lang="en" dir="ltr"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

header {
  background-color: #F5F5F5;
  display: flex;
  justify-content: space-between;
}

header nav ul {
  display: flex;
  list-style: none;
  padding: 10px;
}

header nav ul li {
  margin-right: 10px;
}

header aside img {
  width: 20px;
  height: 20px;
}

.slider {
  display: flex;
  justify-content: space-between;
  margin: 20px 0;
}

.slider .slides {
  width: 30%;
  height: 200px;
  background-color: #D3D3D3;
}

.filters ul {
  display: flex;
  list-style: none;
  justify-content: space-between;
  margin-bottom: 20px;
}

.filters ul li {
  background-color: #B0C4DE;
  padding: 10px;
}

.recommended {
  display: flex;
  justify-content: space-between;
}

.recommended .recommend-item {
  width: 30%;
  height: 200px;
  background-color: #E6E6FA;
}

.content {
  padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<aside>
<a><div  style="inline-size: 100%; block-size: 150px" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div></a>
<a><div  style="inline-size: 100%; block-size: 150px" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div></a>
<a><div  style="inline-size: 100%; block-size: 150px" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div></a>
</aside>
</header>
<div class="slider">

<div class="slides">{{ slot_5 }}</div>
<div class="slides">{{ slot_6 }}</div>
<div class="slides">{{ slot_7 }}</div>
</div>
<div class="filters">
