<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
</div>
<div class="content">
<div class="recommended">

<div class="recommend-item">{{ slot_12 }}</div>
<div class="recommend-item">{{ slot_13 }}</div>
<div class="recommend-item">{{ slot_14 }}</div>
</div>

</div>
</body>
</html>