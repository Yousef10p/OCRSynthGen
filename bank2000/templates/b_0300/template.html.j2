<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.4; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 16mm; }
