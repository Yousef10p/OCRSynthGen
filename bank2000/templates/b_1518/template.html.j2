<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 98.8mm; inset-block-start: 11.8mm; inline-size: 78.4mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_0 }}</p>
<div  style="inset-inline-start: 59.4mm; inset-block-start: 51.8mm; inline-size: 76.7mm; block-size: 50.4mm; font-size: 14.3pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 139.9mm; inset-block-start: 64.9mm; inline-size: 60.8mm; block-size: 42.8mm; font-size: 15.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 139.9mm; inset-block-start: 115.7mm; inline-size: 61.1mm; block-size: 25.9mm; font-size: 14.7pt">{{ slot_2 }}</p>
<div  style="inset-inline-start: 18.1mm; inset-block-start: 152.7mm; inline-size: 76.3mm; block-size: 51.8mm; font-size: 14.7pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 137.1mm; inset-block-start: 215.0mm; inline-size: 65.5mm; block-size: 19.9mm; font-size: 40.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 57.5mm; inset-block-start: 258.9mm; inline-size: 78.0mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_4 }}</p>
</div></body>
</html>
