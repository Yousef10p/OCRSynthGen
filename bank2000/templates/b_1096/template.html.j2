</div>
<div class="w-full md:w-1/2 px-2">
<h2 class="font-bold text-2xl mb-5">{{ slot_13 }}</h2>
<p class="mb-5">{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
</div>
</div>
</main>
</body>
</html>