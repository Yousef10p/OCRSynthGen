<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div  style="inset-inline-start: 24.9mm; inset-block-start: 24.9mm; inline-size: 56.7mm; block-size: 80.4mm; font-size: 15.2pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 88.9mm; inset-block-start: 34.3mm; inline-size: 102.4mm; block-size: 21.5mm; font-size: 9.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 88.9mm; inset-block-start: 61.1mm; inline-size: 102.4mm; block-size: 35.4mm; font-size: 9.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 88.9mm; inset-block-start: 100.4mm; inline-size: 102.4mm; block-size: 16.8mm; font-size: 9.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 110.5mm; inline-size: 43.2mm; block-size: 8.2mm; font-size: 10.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 88.9mm; inset-block-start: 122.6mm; inline-size: 102.4mm; block-size: 21.5mm; font-size: 9.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 124.1mm; inline-size: 53.2mm; block-size: 35.4mm; font-size: 9.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 88.9mm; inset-block-start: 149.3mm; inline-size: 102.4mm; block-size: 21.5mm; font-size: 9.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 163.4mm; inline-size: 53.2mm; block-size: 7.5mm; font-size: 9.0pt">{{ slot_7 }}</p>
<div  style="inset-inline-start: 25.2mm; inset-block-start: 179.8mm; inline-size: 161.0mm; block-size: 63.7mm; font-size: 15.1pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<h2 class="box" style="inset-inline-start: 41.3mm; inset-block-start: 249.1mm; inline-size: 17.3mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_8 }}</h2>
<footer class="box" style="inset-inline-start: 175.3mm; inset-block-start: 259.3mm; inline-size: 14.3mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
