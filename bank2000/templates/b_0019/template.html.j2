<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.8; --align: start; --page-width: 210mm; --page-height: 297mm; --page-margin: 13mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span></header><div style="border-block: 2px solid #222; padding: 0.6em 0; margin-block-end: 1em; text-align: center">
<h1 style="margin: 0; font-size: calc(var(--base-size) * 2.1)">{{ slot_1 }}</h1>
<div style="font-size: 1.05em; margin-block-start: 0.3em">{{ slot_2 }}</div>
</div>
<main><p style="margin-block: 0 0.7em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_3 }}</p>
<p style="margin-block: 0 1em; text-indent: 0; text-align: justify; font-size: 0.95em">{{ slot_4 }}</p>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_5 }}</h3>
<p style="margin-block: 0">{{ slot_6 }}</p>
</div>
<div style="flex: 0 0 40%; block-size: 27mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
</div>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: justify; font-size: 1em">{{ slot_7 }}</p>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 36mm; margin-inline: auto; inline-size: 50%" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_8 }}</figcaption></figure><h3 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1em 0.4em">{{ slot_9 }}</h3>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_10 }}</h2>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_11 }}</h3>
<p style="margin-block: 0">{{ slot_12 }}</p>
</div>
<div style="flex: 0 0 40%; block-size: 37mm" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 0.6em 0.4em">{{ slot_13 }}</h2>
<div style="border-block: 2px solid #333; padding: 0.5em 0; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_14 }}</strong><p style="margin-block: 0">{{ slot_15 }}</p>
</div>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: start; font-size: 1.05em">{{ slot_16 }}</p></main>
</div></body>
</html>
