  color: #b00;
}


.carousel {
  display: flex;
  overflow-x: scroll;
}

.cta {
  text-align: center;
  margin: 20px 0;
}

button {
  background-color: #b00;
  color: #fff;
  border: none;
  padding: 10px 20px;
  font-size: 18px;
}

.col {
  display: flex;
}

.col div {
  flex: 1;
  padding: 20px;
  background-color: #ffcdd2;
  margin: 10px;
}


footer {
  background-color: #ddd;
  padding: 10px;
  text-align: center;
  position: fixed;
  bottom: 0;
  width: 100%;
}

footer a {
  color: #444;
  margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
