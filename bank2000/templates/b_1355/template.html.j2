<li><a class="text-gray-800">{{ slot_0 }}</a></li>
<li><a class="text-gray-800">{{ slot_1 }}</a></li>
<li><a class="text-gray-800">{{ slot_2 }}</a></li>
<li><a class="text-gray-800">{{ slot_3 }}</a></li>
</ul>
