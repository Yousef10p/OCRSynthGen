<div style="inline-size: 100%; block-size: 150px" class="w-full pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
</div>
<div class="w-full md:w-1/2 text-center md:text-left p-6">
<h1 class="text-3xl font-bold">{{ slot_4 }}</h1>
<p class="text-gray-600">{{ slot_5 }}</p>
</div>
</div>
<div class="mt-8">
<h2 class="text-2xl font-bold mb-4">{{ slot_6 }}</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<div class="bg-white shadow rounded p-4">
<div style="inline-size: 100%; block-size: 150px" class="w-full pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<h3 class="text-xl font-bold mt-2">{{ slot_7 }}</h3>
</div>

</div>
</div>
</main>
<footer class="bg-white shadow mt-8 py-4">
<div class="container mx-auto px-6 flex justify-between">
<div>
<p>{{ slot_8 }}</p>
</div>
<div class="flex space-x-4">
<a class="text-gray-800">{{ slot_9 }}</a>
<a class="text-gray-800">{{ slot_10 }}</a>
<a class="text-gray-800">{{ slot_11 }}</a>
</div>
</div>
</footer>
</div>
</body>
</html>