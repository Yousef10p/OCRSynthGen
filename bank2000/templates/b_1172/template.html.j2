        </p>
<form class="mb-4">
<span class="border p-2 mr-2" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<span class="border p-2 mr-2" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<button class="bg-purple-500 text-white p-2">{{ slot_5 }}</button>
</form>
<p class="text-lg mb-4">
            {{ slot_6 }}
        </p>
<div class="flex justify-center">
<a class="text-lg mr-4">{{ slot_7 }}</a>
<a class="text-lg mr-4">{{ slot_8 }}</a>
<a class="text-lg">{{ slot_9 }}</a>
</div>
<p class="text-lg mb-4">
            {{ slot_10 }}
        </p>
<form>
<span class="border p-2 mr-2" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<button class="bg-purple-500 text-white p-2">{{ slot_12 }}</button>
</form>
</footer>
</body>
</html>