<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 6.2mm; inset-block-start: 9.6mm; inline-size: 3.2mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 20.4mm; inset-block-start: 9.6mm; inline-size: 50.9mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 45.4mm; inset-block-start: 35.0mm; inline-size: 82.9mm; block-size: 29.9mm; font-size: 21.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 90.9mm; inset-block-start: 72.7mm; inline-size: 94.8mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 90.9mm; inset-block-start: 86.9mm; inline-size: 97.1mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 90.9mm; inset-block-start: 101.0mm; inline-size: 99.0mm; block-size: 54.3mm; font-size: 11.8pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 90.9mm; inset-block-start: 157.6mm; inline-size: 97.5mm; block-size: 24.7mm; font-size: 11.6pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 6.9mm; inset-block-start: 190.1mm; inline-size: 56.2mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 12.9mm; inset-block-start: 202.4mm; inline-size: 48.1mm; block-size: 10.3mm; font-size: 29.2pt">{{ slot_8 }}</p>
</div></body>
</html>
