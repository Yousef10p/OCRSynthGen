<h2 class="box" style="inset-inline-start: 31.6mm; inset-block-start: 156.0mm; inline-size: 68.1mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 167.1mm; inline-size: 112.5mm; block-size: 7.3mm; font-size: 10.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 177.1mm; inline-size: 75.4mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_5 }}</p>
