<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 55.7mm; inset-block-start: 15.3mm; inline-size: 101.3mm; block-size: 9.6mm; font-size: 8.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 23.4mm; inset-block-start: 16.9mm; inline-size: 28.0mm; block-size: 6.4mm; font-size: 8.0pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 166.5mm; inset-block-start: 18.5mm; inline-size: 15.7mm; block-size: 3.1mm; font-size: 8.0pt">{{ slot_2 }}</header><h2 class="box" style="inset-inline-start: 23.4mm; inset-block-start: 38.1mm; inline-size: 164.1mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_3 }}</h2>
<div  style="inset-inline-start: 27.1mm; inset-block-start: 57.2mm; inline-size: 156.2mm; block-size: 211.6mm; font-size: 15.0pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
</div></body>
</html>
