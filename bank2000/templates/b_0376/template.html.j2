</div>
</div>
<div style="border: 1px solid #333; padding: 0.6em 0.9em; border-radius: 4px; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_9 }}</strong><p style="margin-block: 0">{{ slot_10 }}</p>
</div>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_11 }}</h3>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_12 }}</h3>
<p style="margin-block: 0">{{ slot_13 }}</p>
</div>
<div style="flex: 0 0 35%; block-size: 28mm" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
</div>
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_14 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_15 }}</p>
</div>
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_16 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_17 }}</p>
</div>
<div style="border: none; padding: 0; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_18 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_19 }}</p>
</div>
</div>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: justify; font-size: 0.95em">{{ slot_20 }}</p>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 41mm; margin-inline: auto; inline-size: 75%" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_21 }}</figcaption></figure></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_22 }}</span><span>{{ slot_23 }}</span></footer>
</div></body>
</html>
