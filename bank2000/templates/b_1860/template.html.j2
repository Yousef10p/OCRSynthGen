<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 86.1mm; inset-block-start: 33.2mm; inline-size: 42.0mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 84.7mm; inset-block-start: 63.2mm; inline-size: 44.8mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 76.7mm; inset-block-start: 72.6mm; inline-size: 61.9mm; block-size: 7.1mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div  style="inset-inline-start: 67.4mm; inset-block-start: 87.9mm; inline-size: 79.3mm; block-size: 48.8mm; font-size: 9.2pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 69.0mm; inset-block-start: 136.8mm; inline-size: 74.3mm; block-size: 1.9mm; font-size: 5.5pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 89.2mm; inset-block-start: 156.8mm; inline-size: 35.7mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 72.7mm; inset-block-start: 166.1mm; inline-size: 68.8mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_5 }}</p>
<div  style="inset-inline-start: 67.2mm; inset-block-start: 181.4mm; inline-size: 79.7mm; block-size: 48.0mm; font-size: 15.1pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 68.8mm; inset-block-start: 230.5mm; inline-size: 75.5mm; block-size: 1.9mm; font-size: 5.5pt">{{ slot_6 }}</p>
</div></body>
</html>
