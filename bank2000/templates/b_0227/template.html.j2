<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.4; --align: start; --page-width: 210mm; --page-height: 148mm; --page-margin: 15mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page"><main style="display: grid; column-gap: 7mm; grid-template-columns: 2.4fr 1fr"><div>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: end; margin-block: 1.4em 0.4em">{{ slot_0 }}</h2>
<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 4mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_1 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_2 }}</p>
</div>
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_3 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_4 }}</p>
</div>
</div>
<aside style="border: 1px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_5 }}</p>
<p style="margin-block: 0.2em">{{ slot_6 }}</p></aside><p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_7 }}</p>
</div>
<aside style="background: transparent; padding: 0.6em; border-inline-start: 1px solid #999"><h3>{{ slot_8 }}</h3>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_9 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_10 }}</p></aside></main></div></body>
</html>
