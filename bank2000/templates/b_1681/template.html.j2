<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 167.2mm; inset-block-start: 32.9mm; inline-size: 6.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 47.4mm; inline-size: 85.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div  style="inset-inline-start: 38.5mm; inset-block-start: 59.5mm; inline-size: 134.9mm; block-size: 16.9mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 79.7mm; inline-size: 137.1mm; block-size: 24.1mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div  style="inset-inline-start: 56.4mm; inset-block-start: 108.6mm; inline-size: 117.0mm; block-size: 10.8mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 127.4mm; inline-size: 38.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div  style="inset-inline-start: 48.9mm; inset-block-start: 139.4mm; inline-size: 124.5mm; block-size: 54.9mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 201.3mm; inline-size: 137.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div  style="inset-inline-start: 88.8mm; inset-block-start: 215.5mm; inline-size: 84.6mm; block-size: 10.6mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_3" src="{{ pic_3 }}" alt=""></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 232.1mm; inline-size: 6.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div  style="inset-inline-start: 88.4mm; inset-block-start: 239.3mm; inline-size: 85.0mm; block-size: 10.6mm; font-size: 11.0pt" class="box pic-frame"><img data-pic="pic_4" src="{{ pic_4 }}" alt=""></div>
</div></body>
</html>
