<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 42.3mm; inline-size: 145.0mm; block-size: 29.5mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div  style="inset-inline-start: 72.8mm; inset-block-start: 76.0mm; inline-size: 97.7mm; block-size: 7.2mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 87.8mm; inline-size: 145.0mm; block-size: 16.1mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 108.1mm; inline-size: 144.9mm; block-size: 29.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 133.9mm; inline-size: 144.9mm; block-size: 12.9mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div  style="inset-inline-start: 39.3mm; inset-block-start: 154.4mm; inline-size: 117.4mm; block-size: 15.6mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 172.7mm; inline-size: 145.0mm; block-size: 21.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div  style="inset-inline-start: 34.8mm; inset-block-start: 205.5mm; inline-size: 135.7mm; block-size: 7.2mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 220.9mm; inline-size: 145.0mm; block-size: 15.6mm; font-size: 12.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 95.9mm; inset-block-start: 268.6mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
