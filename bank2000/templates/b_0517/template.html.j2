}

.slider-item {
  flex: 1;
  background-color: #a6cc70;
  margin: 20px;
}

.food-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  padding: 20px;
}

.food-item {
  background-color: #66a182;
  padding: 20px;
  text-align: center;
}

.footer-info, .footer-blog, .footer-contact{
