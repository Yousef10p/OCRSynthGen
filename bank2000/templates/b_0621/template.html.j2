<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  background-color: #f5f5f5;
  font-family: var(--font-body);
}

.grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  padding: 20px;
}

.grid-item {
  background-color: #fff;
  padding: 20px;
}

.room-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
}

.room-item {
  background-color: #eee;
  padding: 10px;
}

h1 {
  text-align: center;
  padding-bottom: 20px;
  border-bottom: 1px solid #000;
}

img {
  width: 100%;
  height: 200px;
  background-color: #000;
}

form {
  padding-top: 20px;
  position: relative;
}

input {
  margin: 20px 0;
}

label {
  margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
<body>
<div class="grid-container">
<div class="grid-item">
<h1>{{ slot_0 }}</h1>
<div class="room-grid">
<div class="room-item">
<div  style="inline-size: 100%; block-size: 150px" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<h2>{{ slot_1 }}</h2>
<p>{{ slot_2 }}</p>
<a>{{ slot_3 }}</a>
</div>
<div class="room-item">
<div  style="inline-size: 100%; block-size: 150px" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<a>{{ slot_6 }}</a>
</div>
<div class="room-item">
<div  style="inline-size: 100%; block-size: 150px" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<a>{{ slot_9 }}</a>
</div>
</div>
</div>
<div class="grid-item">
<h1>{{ slot_10 }}</h1>
<form>
<label>{{ slot_11 }}</label><br>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_12 }}</span><br><br>
<label>{{ slot_13 }}</label><br>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_14 }}</span><br><br>
<span class="">{{ slot_15 }}</span>
</form>
</div>
</div>
</body>
</html>