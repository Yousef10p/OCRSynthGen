<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: #333;
}

header {
    height: 80px;
    background: lightblue;
}

nav ul {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 100%;
}

nav ul li a {
    color: #333;
    text-decoration: none;
}

#shop-banner {
    height: 500px;
    display: flex;
    justify-content: space-around;
    align-items: center;
}

#shop-banner .image {
    width: 300px;
    height: 200px;
    background: lightgray;
    display: flex;
    justify-content: center;
    align-items: center;
}

#reviews {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    padding: 20px;
}

#reviews .review {
    padding: 20px;
    background: #eee;
    display: flex;
    flex-direction: column;
}

#reviews .review img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: lightgray;
}

#reviews .review p {
    margin-top: 10px;
}

footer {
    background: lightblue;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 20px 0;
}

#social-media img {
    width: 40px;
    height: 40px;
    background: lightgray;
}

#newsletter form {
    display: flex;
}

#newsletter form input {
    padding: 10px;
    border: 1px solid #333;
    margin-left: 10px;
}

#newsletter form button {
    padding: 10px;
    background: #333;
    color: #fff;
    border: none;
}

#newsletter form button:hover {
    background: #555;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
