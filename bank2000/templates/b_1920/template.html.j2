<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 36.5mm; inline-size: 135.0mm; block-size: 38.0mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 78.6mm; inline-size: 135.0mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div  style="inset-inline-start: 96.5mm; inset-block-start: 95.4mm; inline-size: 82.0mm; block-size: 7.3mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 107.7mm; inline-size: 3.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div  style="inset-inline-start: 91.2mm; inset-block-start: 113.3mm; inline-size: 87.3mm; block-size: 10.0mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 128.4mm; inline-size: 40.5mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div  style="inset-inline-start: 91.1mm; inset-block-start: 139.6mm; inline-size: 87.4mm; block-size: 13.9mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 159.2mm; inline-size: 135.0mm; block-size: 29.5mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div  style="inset-inline-start: 71.3mm; inset-block-start: 197.0mm; inline-size: 107.2mm; block-size: 13.9mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_3" src="{{ pic_3 }}" alt=""></div>
<div  style="inset-inline-start: 83.4mm; inset-block-start: 207.1mm; inline-size: 95.1mm; block-size: 13.9mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_4" src="{{ pic_4 }}" alt=""></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 226.7mm; inline-size: 135.0mm; block-size: 21.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 251.7mm; inline-size: 135.0mm; block-size: 12.0mm; font-size: 10.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 108.9mm; inset-block-start: 279.7mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
