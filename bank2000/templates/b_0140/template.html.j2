<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.6); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_1 }}</p>
<main style="display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 8mm"><div>
<p style="margin-block: 0 0.4em; text-indent: 0; text-align: justify; font-size: 1.05em">{{ slot_2 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: end; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_3 }}</h2>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: center; margin-block: 1.4em 0.4em">{{ slot_4 }}</h2>
<h2 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1.4em 0.4em">{{ slot_5 }}</h2>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: var(--align); font-size: 1em">{{ slot_6 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1.4em 0.4em">{{ slot_7 }}</h2>
</div>
<div>
<aside style="border: 2px solid #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><h4>{{ slot_8 }}</h4>
<p style="margin-block: 0.2em">{{ slot_9 }}</p></aside><aside style="border: 2px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_10 }}</p></aside><figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 55mm; margin-inline: auto; inline-size: 100%" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_11 }}</figcaption></figure><p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: start; font-size: 0.95em">{{ slot_12 }}</p>
<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_13 }}</p>
<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 4mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_14 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_15 }}</p>
</div>
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_16 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_17 }}</p>
</div>
</div>
</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_18 }}</span><span>{{ slot_19 }}</span></footer>
</div></body>
</html>
