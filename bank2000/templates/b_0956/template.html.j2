audio,canvas,embed,iframe,img,object,svg,video{display:block;vertical-align:middle}
img,video{max-width:100%;height:auto}
[hidden]{display:none}
*,::after,::before{--tw-border-opacity:1;border-color:rgba(229,231,235,var(--tw-border-opacity))}
.mt-4{margin-top:1rem}
.mr-4{margin-right:1rem}
.mr-6{margin-right:1.5rem}
.mb-2{margin-bottom:.5rem}
.mb-4{margin-bottom:1rem}
.block{display:block}
.flex{display:flex}
.w-full{width:100%}
.flex-shrink-0{flex-shrink:0}
.flex-grow{flex-grow:1}
.flex-wrap{flex-wrap:wrap}
.items-center{align-items:center}
.justify-between{justify-content:space-between}
.bg-gray-100{--tw-bg-opacity:1;background-color:rgba(243,244,246,var(--tw-bg-opacity))}
.bg-gray-800{--tw-bg-opacity:1;background-color:rgba(31,41,55,var(--tw-bg-opacity))}
.p-4{padding:1rem}
.p-6{padding:1.5rem}
.font-sans{font-family: var(--font-body)}
.text-sm{font-size:.875rem;line-height:1.25rem}
.text-xl{font-size:1.25rem;line-height:1.75rem}
.text-2xl{font-size:1.5rem;line-height:2rem}
.font-semibold{font-weight:600}
.font-bold{font-weight:700}
.leading-normal{line-height:1.5}
.tracking-tight{letter-spacing:-.025em}
.tracking-normal{letter-spacing:0}
.text-white{--tw-text-opacity:1;color:rgba(255,255,255,var(--tw-text-opacity))}
.text-pink-400{--tw-text-opacity:1;color:rgba(244,114,182,var(--tw-text-opacity))}
.text-pink-500{--tw-text-opacity:1;color:rgba(236,72,153,var(--tw-text-opacity))}
*,::after,::before{--tw-shadow:0 0 #0000}
*,::after,::before{--tw-ring-inset:var(--tw-empty, );--tw-ring-offset-width:0px;--tw-ring-offset-color:#fff;--tw-ring-color:rgba(59, 130, 246, 0.5);--tw-ring-offset-shadow:0 0 #0000;--tw-ring-shadow:0 0 #0000}
@media (min-width:1024px){.lg\:mt-0{margin-top:0}}
@media (min-width:1024px){.lg\:inline-block{display:inline-block}}
@media (min-width:1024px){.lg\:flex{display:flex}}
@media (min-width:1024px){.lg\:w-auto{width:auto}}
@media (min-width:1024px){.lg\:w-1\/3{width:33.333333%}}
@media (min-width:1024px){.lg\:w-2\/3{width:66.666667%}}
@media (min-width:1024px){.lg\:flex-grow{flex-grow:1}}
@media (min-width:1024px){.lg\:items-center{align-items:center}}
.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
