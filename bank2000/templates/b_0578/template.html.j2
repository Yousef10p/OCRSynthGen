    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 80%;
    margin: auto;
    padding: 1em;
    text-align: center;
}

figure {
    border: 1px solid white;
    margin: 1em;
    padding: 1em;
}

iframe {
    border: none;
    width: 80vw;
    height: 45vw;
    margin: auto;
}

form {
    display: flex;
    flex-direction: column;
    margin: 1em;
    padding: 1em;
    text-align: center;
}

input[type="text"], input[type="email"], input[type="submit"] {
    margin: 0.5em;
    padding: 0.5em;
    border: none;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
