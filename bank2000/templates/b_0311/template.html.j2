<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 17mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span></header><h1 style="font-size: calc(var(--base-size) * 2.6); text-align: center; margin-block: 0.3em 0.5em">{{ slot_1 }}</h1>
<main><h3 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1em 0.4em">{{ slot_2 }}</h3>
<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_3 }}</p>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: justify; font-size: 1em">{{ slot_4 }}</p>
<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1.05em">{{ slot_5 }}</p>
<div style="border-block: 2px solid #333; padding: 0.5em 0; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_6 }}</strong><p style="margin-block: 0">{{ slot_7 }}</p>
</div>
<aside style="border: 1px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><h4>{{ slot_8 }}</h4>
<p style="margin-block: 0.2em">{{ slot_9 }}</p>
<p style="margin-block: 0.2em">{{ slot_10 }}</p></aside><aside style="border: 2px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><h4>{{ slot_11 }}</h4>
<p style="margin-block: 0.2em">{{ slot_12 }}</p></aside><figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 34mm; margin-inline: auto; inline-size: 50%" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_13 }}</figcaption></figure><div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 35%; block-size: 30mm" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_14 }}</h3>
<p style="margin-block: 0">{{ slot_15 }}</p>
</div>
</div>
<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_16 }}</li>
<li>{{ slot_17 }}</li>
<li>{{ slot_18 }}</li>
</ul></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_19 }}</span></footer>
</div></body>
</html>
