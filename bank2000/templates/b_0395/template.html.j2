<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.6; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 22mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.2); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main style="display: grid; column-gap: 7mm; grid-template-columns: 2.4fr 1fr"><div>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: end; margin-block: 1em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_1 }}</h2>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 70mm; margin-inline: auto; inline-size: 50%" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_2 }}</figcaption></figure><div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 1"><p style="margin-block: 0">{{ slot_3 }}</p></div>
<div style="flex: 0 0 35%; block-size: 45mm" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
</div>
</div>
<aside style="background: #f2f2f2; padding: 0.6em; border-inline-start: 1px solid #999"><h3>{{ slot_4 }}</h3>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_5 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_6 }}</p></aside><div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
<p style="margin-block: 0.15em">{{ slot_7 }}</p>
<p style="margin-block: 0.15em">{{ slot_8 }}</p>
</div></main>
</div></body>
</html>
