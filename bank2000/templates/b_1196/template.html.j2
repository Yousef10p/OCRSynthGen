<li><a class="text-pink-500">{{ slot_3 }}</a></li>
<li><a class="text-pink-500">{{ slot_4 }}</a></li>
<li><a class="text-pink-500">{{ slot_5 }}</a></li>
</ul>
</nav>
<main class="p-4">
<h2 class="text-2xl mb-4">{{ slot_6 }}</h2>
<p class="mb-4">{{ slot_7 }}</p>
<button class="bg-pink-500 text-white font-bold py-2 px-4 rounded">
      {{ slot_8 }}
    </button>
</main>
<footer class="bg-white p-4">
<div class="mb-4">
<h3 class="text-xl mb-2">{{ slot_9 }}</h3>

</div>
<div>
<h3 class="text-xl mb-2">{{ slot_10 }}</h3>
<ul>
<li><a class="text-pink-500">{{ slot_11 }}</a></li>
<li><a class="text-pink-500">{{ slot_12 }}</a></li>
</ul>
</div>
</footer>
</body>
</html>