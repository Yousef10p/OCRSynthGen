<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.8; --align: start; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 25mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div style="border-block: 3px solid #222; padding: 0.6em 0; margin-block-end: 1em; text-align: center">
<h1 style="margin: 0; font-size: calc(var(--base-size) * 2.1)">{{ slot_0 }}</h1>
<div style="font-size: 1.05em; margin-block-start: 0.3em">{{ slot_1 }}</div>
</div>
<main><h2 style="font-size: calc(var(--base-size) * 1.15); text-align: end; margin-block: 0.6em 0.4em">{{ slot_2 }}</h2>
<p style="margin-block: 0 1em; text-indent: 0; text-align: start; font-size: 0.95em">{{ slot_3 }}</p>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_4 }}</blockquote>
<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
<aside style="border: 2px solid #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><h4>{{ slot_7 }}</h4>
<p style="margin-block: 0.2em">{{ slot_8 }}</p></aside><aside style="border: 2px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><h4>{{ slot_9 }}</h4>
<p style="margin-block: 0.2em">{{ slot_10 }}</p>
<p style="margin-block: 0.2em">{{ slot_11 }}</p></aside><div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 1"><p style="margin-block: 0">{{ slot_12 }}</p></div>
<div style="flex: 0 0 30%; block-size: 30mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
</div>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
<p style="margin-block: 0.15em">{{ slot_13 }}</p>
<p style="margin-block: 0.15em">{{ slot_14 }}</p>
<p style="margin-block: 0.15em">{{ slot_15 }}</p>
</div></main>
</div></body>
</html>
