<div  style="inset-inline-start: 136.6mm; inset-block-start: 32.0mm; inline-size: 47.2mm; block-size: 61.1mm; font-size: 7.7pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 30.8mm; inset-block-start: 113.5mm; inline-size: 152.3mm; block-size: 6.6mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 125.4mm; inline-size: 164.5mm; block-size: 10.6mm; font-size: 12.0pt">{{ slot_1 }}</p>
