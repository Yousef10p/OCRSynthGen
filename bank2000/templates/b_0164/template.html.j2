<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 0.95em">{{ slot_4 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.3); text-align: end; margin-block: 0.6em 0.4em">{{ slot_5 }}</h2>
<aside style="border: 1px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><h4>{{ slot_6 }}</h4>
<p style="margin-block: 0.2em">{{ slot_7 }}</p></aside><h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 1em 0.4em">{{ slot_8 }}</h2>
