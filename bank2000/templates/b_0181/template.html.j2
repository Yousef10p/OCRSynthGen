<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.8; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 16mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
<style>/* flowing columns (reading order): a block stays in one column, a heading stays with what follows */
[style*="column-count"] > *, [style*="column-width"] > * { break-inside: avoid; }
[style*="column-count"] > h1, [style*="column-count"] > h2, [style*="column-count"] > h3, [style*="column-count"] > h4, [style*="column-count"] > h5, [style*="column-count"] > h6, [style*="column-width"] > h1, [style*="column-width"] > h2, [style*="column-width"] > h3, [style*="column-width"] > h4, [style*="column-width"] > h5, [style*="column-width"] > h6 { break-after: avoid; }</style>
</head>
<body><div class="page">
<main style="column-count: 3; column-gap: 8mm; column-rule: 1px solid #bbb"><div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_0 }}</h3>
<p style="margin-block: 0">{{ slot_1 }}</p>
</div>
<div style="flex: 0 0 30%; block-size: 30mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: end; margin-block: 1.4em 0.4em">{{ slot_2 }}</h2>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.3em 1em; margin-block: 0.6em; break-inside: avoid">
<div style="font-weight: bold">{{ slot_3 }}</div>
<div>{{ slot_4 }}</div>
<div style="font-weight: bold">{{ slot_5 }}</div>
<div>{{ slot_6 }}</div>
<div style="font-weight: bold">{{ slot_7 }}</div>
<div>{{ slot_8 }}</div>
<div style="font-weight: bold">{{ slot_9 }}</div>
<div>{{ slot_10 }}</div>
<div style="font-weight: bold">{{ slot_11 }}</div>
<div>{{ slot_12 }}</div>
<div style="font-weight: bold">{{ slot_13 }}</div>
<div>{{ slot_14 }}</div>
</div>
<p style="margin-block: 0 1em; text-indent: 0; text-align: justify; font-size: 0.95em">{{ slot_15 }}</p>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 0.6em 0.4em">{{ slot_16 }}</h3>
<p style="margin-block: 0 1em; text-indent: 0; text-align: justify; font-size: 0.95em">{{ slot_17 }}</p></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_18 }}</span><span>{{ slot_19 }}</span></footer>
</div></body>
</html>
