<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</div>
<div>
<h4 class="text-lg mb-2">{{ slot_9 }}</h4>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>
</div>
</div>
</footer>
</body>
</html>