<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.8em">
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
<div style="border-block: 2px solid #333; padding: 0.5em 0; margin-block: 0.8em; break-inside: avoid">
