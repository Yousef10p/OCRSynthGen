<h4 style="margin-block: 0.2em">{{ slot_5 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_6 }}</p>
</div>
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_7 }}</h4>
