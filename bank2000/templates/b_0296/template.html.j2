<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.8; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 22mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span><span>{{ slot_1 }}</span></header><main style="column-count: 2; column-gap: 8mm; column-rule: 1px solid #bbb"><div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 6mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_2 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_3 }}</p>
</div>
<div style="border: 1px solid #999; padding: 0; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_4 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_5 }}</p>
</div>
</div>
<aside style="border: 1px solid #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><h4>{{ slot_6 }}</h4>
<p style="margin-block: 0.2em">{{ slot_7 }}</p>
<p style="margin-block: 0.2em">{{ slot_8 }}</p></aside><h2 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1em 0.4em">{{ slot_9 }}</h2>
<blockquote style="border-inline-start: 2px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_10 }}</blockquote>
<aside style="border: 1px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_11 }}</p>
<p style="margin-block: 0.2em">{{ slot_12 }}</p></aside><table style="border-collapse: collapse; inline-size: 100%; margin-block: 0.6em; font-size: 0.85em; break-inside: avoid"><tbody>
<tr>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_13 }}</td>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_14 }}</td>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_15 }}</td>
</tr>
<tr>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_16 }}</td>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_17 }}</td>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_18 }}</td>
</tr>
</tbody></table></main>
</div></body>
</html>
