<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 36.3mm; inset-block-start: 32.9mm; inline-size: 62.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 169.3mm; inset-block-start: 32.9mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 47.4mm; inline-size: 130.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 36.3mm; inset-block-start: 64.3mm; inline-size: 20.4mm; block-size: 6.5mm; font-size: 12.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 73.5mm; inline-size: 96.8mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div  style="inset-inline-start: 65.6mm; inset-block-start: 85.4mm; inline-size: 107.8mm; block-size: 33.1mm; font-size: 8.0pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 126.2mm; inline-size: 137.0mm; block-size: 24.1mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div  style="inset-inline-start: 89.3mm; inset-block-start: 151.5mm; inline-size: 84.1mm; block-size: 7.2mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 163.7mm; inline-size: 6.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</p>
<div  style="inset-inline-start: 86.5mm; inset-block-start: 168.4mm; inline-size: 86.9mm; block-size: 11.0mm; font-size: 8.0pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 184.4mm; inline-size: 94.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_7 }}</p>
<div  style="inset-inline-start: 84.5mm; inset-block-start: 196.0mm; inline-size: 88.9mm; block-size: 13.3mm; font-size: 8.0pt" class="box pic-frame"><img data-pic="pic_3" src="{{ pic_3 }}" alt=""></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 215.2mm; inline-size: 86.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_8 }}</p>
<div  style="inset-inline-start: 95.8mm; inset-block-start: 230.6mm; inline-size: 77.6mm; block-size: 7.2mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_4" src="{{ pic_4 }}" alt=""></div>
</div></body>
</html>
