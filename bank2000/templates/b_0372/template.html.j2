<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.4; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 13mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span></header><div style="border-block: 2px solid #222; padding: 0.6em 0; margin-block-end: 1em; text-align: center">
<h1 style="margin: 0; font-size: calc(var(--base-size) * 2.4)">{{ slot_1 }}</h1>
<div style="font-size: 1.05em; margin-block-start: 0.3em">{{ slot_2 }}</div>
</div>
<main><h2 style="font-size: calc(var(--base-size) * 1.5); text-align: center; margin-block: 0.6em 0.4em">{{ slot_3 }}</h2>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 40%; block-size: 28mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<div style="flex: 1"><p style="margin-block: 0">{{ slot_4 }}</p></div>
</div>
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0; border-radius: 0">
<div style="block-size: 21mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_5 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_6 }}</p>
</div>
<div style="border: none; padding: 0; border-radius: 6px">
<div style="block-size: 20mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_7 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_8 }}</p>
</div>
<div style="border: none; padding: 0.6em; border-radius: 0">
<div style="block-size: 27mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_3" src="{{ pic_3 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_9 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_10 }}</p>
</div>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.3); text-align: end; margin-block: 1em 0.4em">{{ slot_11 }}</h2></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_12 }}</span></footer>
</div></body>
</html>
