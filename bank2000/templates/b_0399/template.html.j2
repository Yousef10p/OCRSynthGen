</div>
</div>
<ol style="list-style-type: decimal; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_8 }}<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
</ul>
</li>
<li>{{ slot_12 }}</li>
</ol>
<h3 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_13 }}</h3>
<div style="margin-block: 0.8em; border-inline-start: 2px solid #666; padding-inline-start: 0.9em">
<div style="margin-block: 0.5em">
<div style="font-weight: bold; font-size: 0.9em">{{ slot_14 }}</div>
<div>{{ slot_15 }}</div>
</div>
<div style="margin-block: 0.5em">
<div style="font-weight: bold; font-size: 0.9em">{{ slot_16 }}</div>
<div>{{ slot_17 }}</div>
</div>
<div style="margin-block: 0.5em">
<div style="font-weight: bold; font-size: 0.9em">{{ slot_18 }}</div>
<div>{{ slot_19 }}</div>
</div>
</div>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: center; margin-block: 0.6em 0.4em">{{ slot_20 }}</h3>
<dl style="margin-block: 0.6em">
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_21 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_22 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_23 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_24 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_25 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_26 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_27 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_28 }}</dd>
</dl>
<p style="margin-block: 0 0.7em; text-indent: 1.5em; text-align: start; font-size: 1em">{{ slot_29 }}</p>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: end; margin-block: 0.6em 0.4em">{{ slot_30 }}</h3></main>
</div></body>
</html>
