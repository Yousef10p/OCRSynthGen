<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.6; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 16mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span><span>{{ slot_1 }}</span></header><main style="column-count: 3; column-gap: 8mm; column-rule: 1px solid #bbb"><div style="margin-block: 0.6em">
<div style="display: flex; gap: 0.8em; align-items: baseline; margin-block: 0.35em">
<span style="font-weight: bold; white-space: nowrap">{{ slot_2 }}</span><span style="border: 1px solid #555; padding-inline: 0.4em; flex: 1; min-inline-size: 5em">{{ slot_3 }}</span>
</div>
<div style="display: flex; gap: 0.8em; align-items: baseline; margin-block: 0.35em">
<span style="font-weight: bold; white-space: nowrap">{{ slot_4 }}</span><span style="border: 1px solid #555; padding-inline: 0.4em; flex: 1; min-inline-size: 5em">{{ slot_5 }}</span>
</div>
</div>
<dl style="margin-block: 0.6em">
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_6 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_7 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_8 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_9 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_10 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_11 }}</dd>
</dl>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 33mm; margin-inline: auto; inline-size: 75%" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_12 }}</figcaption></figure><figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 60mm; margin-inline: auto; inline-size: 100%" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_13 }}</figcaption></figure><p style="margin-block: 0 0.4em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_14 }}</p>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_15 }}</blockquote></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_16 }}</span></footer>
</div></body>
</html>
