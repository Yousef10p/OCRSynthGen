<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 62.5mm; inset-block-start: 43.9mm; inline-size: 91.0mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 24.4mm; inset-block-start: 58.8mm; inline-size: 167.8mm; block-size: 14.6mm; font-size: 13.8pt">{{ slot_1 }}</p>
<div  style="inset-inline-start: 24.0mm; inset-block-start: 84.9mm; inline-size: 44.6mm; block-size: 31.2mm; font-size: 14.7pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<div  style="inset-inline-start: 85.6mm; inset-block-start: 85.1mm; inline-size: 44.3mm; block-size: 31.0mm; font-size: 14.7pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<div  style="inset-inline-start: 147.0mm; inset-block-start: 85.1mm; inline-size: 44.8mm; block-size: 30.9mm; font-size: 14.6pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 24.4mm; inset-block-start: 123.5mm; inline-size: 33.7mm; block-size: 25.8mm; font-size: 18.3pt">{{ slot_2 }}</p>
