<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 14.0mm; inset-block-start: 13.0mm; inline-size: 61.5mm; block-size: 12.4mm; font-size: 10.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 112.6mm; inset-block-start: 28.5mm; inline-size: 83.1mm; block-size: 9.0mm; font-size: 10.0pt">{{ slot_1 }}</p>
<div  style="inset-inline-start: 36.2mm; inset-block-start: 31.0mm; inline-size: 44.5mm; block-size: 7.8mm; font-size: 11.9pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 108.3mm; inset-block-start: 37.9mm; inline-size: 89.0mm; block-size: 44.8mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.9mm; inset-block-start: 40.2mm; inline-size: 13.0mm; block-size: 4.7mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 45.7mm; inline-size: 73.4mm; block-size: 19.6mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 14.0mm; inset-block-start: 67.7mm; inline-size: 89.8mm; block-size: 154.2mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 108.4mm; inset-block-start: 82.8mm; inline-size: 91.0mm; block-size: 104.5mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 108.8mm; inset-block-start: 187.7mm; inline-size: 89.4mm; block-size: 69.8mm; font-size: 11.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 14.6mm; inset-block-start: 222.1mm; inline-size: 88.1mm; block-size: 24.6mm; font-size: 11.9pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 247.8mm; inline-size: 82.8mm; block-size: 9.7mm; font-size: 11.9pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 102.3mm; inset-block-start: 260.0mm; inline-size: 6.9mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
