<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.4; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 23mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span></header><h1 style="font-size: calc(var(--base-size) * 1.8); text-align: center; margin-block: 0.3em 0.5em">{{ slot_1 }}</h1>
<main style="column-count: 3; column-gap: 8mm; column-rule: none"><aside style="border: 1px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><h4>{{ slot_2 }}</h4>
<p style="margin-block: 0.2em">{{ slot_3 }}</p>
<p style="margin-block: 0.2em">{{ slot_4 }}</p></aside><div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 40%; block-size: 26mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<div style="flex: 1"><p style="margin-block: 0">{{ slot_5 }}</p></div>
</div>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 28mm; margin-inline: auto; inline-size: 50%" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_6 }}</figcaption></figure><dl style="margin-block: 0.6em">
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_7 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_8 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_9 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_10 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_11 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_12 }}</dd>
</dl>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 30mm; margin-inline: auto; inline-size: 50%" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_13 }}</figcaption></figure><h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1.4em 0.4em">{{ slot_14 }}</h2></main>
</div></body>
</html>
