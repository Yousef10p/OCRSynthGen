<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.4; --align: start; --page-width: 210mm; --page-height: 297mm; --page-margin: 22mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.6); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_1 }}</p>
<main><h3 style="font-size: calc(var(--base-size) * 1.15); text-align: center; margin-block: 1.4em 0.4em">{{ slot_2 }}</h3>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 35%; block-size: 25mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<div style="flex: 1"><p style="margin-block: 0">{{ slot_3 }}</p></div>
</div>
<h3 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_4 }}</h3>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_5 }}</h3>
<ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
</li>
</ol>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: justify; font-size: 1em">{{ slot_10 }}</p>
<p style="margin-block: 0 0.4em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_11 }}</p>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_12 }}</blockquote>
<div style="border-block: 2px solid #333; padding: 0.5em 0; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_13 }}</strong><p style="margin-block: 0">{{ slot_14 }}</p>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 0.6em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_15 }}</h2>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
<p style="margin-block: 0.15em">{{ slot_16 }}</p>
<p style="margin-block: 0.15em">{{ slot_17 }}</p>
<p style="margin-block: 0.15em">{{ slot_18 }}</p>
</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_19 }}</span><span>{{ slot_20 }}</span><span>{{ slot_21 }}</span></footer>
</div></body>
</html>
