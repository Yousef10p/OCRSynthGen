<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.4; --align: start; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 17mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span></header><h1 style="font-size: calc(var(--base-size) * 2.6); text-align: start; margin-block: 0.3em 0.5em">{{ slot_1 }}</h1>
<main style="column-count: 2; column-gap: 8mm; column-rule: 1px solid #bbb"><h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 1em 0.4em">{{ slot_2 }}</h2>
<p style="margin-block: 0 0.7em; text-indent: 1.5em; text-align: var(--align); font-size: 1.05em">{{ slot_3 }}</p>
<div style="border: 1px solid #333; padding: 0.6em 0.9em; border-radius: 4px; margin-block: 0.8em; break-inside: avoid">
<strong style="display: block; margin-block-end: 0.2em">{{ slot_4 }}</strong><p style="margin-block: 0">{{ slot_5 }}</p>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.3); text-align: center; margin-block: 1.4em 0.4em">{{ slot_6 }}</h2>
<h3 style="font-size: calc(var(--base-size) * 1.3); text-align: center; margin-block: 1em 0.4em">{{ slot_7 }}</h3>
<p style="margin-block: 0 0.7em; text-indent: 1.5em; text-align: justify; font-size: 0.95em">{{ slot_8 }}</p>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: justify; font-size: 0.95em">{{ slot_9 }}</p>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: var(--align); font-size: 1.05em">{{ slot_10 }}</p>
<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: none; padding: 0.6em; border-radius: 0">
<div style="block-size: 32mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_11 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_12 }}</p>
</div>
<div style="border: none; padding: 0.6em; border-radius: 6px">
<div style="block-size: 29mm; margin-block-end: 0.4em" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<h4 style="margin-block: 0.2em">{{ slot_13 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_14 }}</p>
</div>
</div>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 32mm; margin-inline: auto; inline-size: 75%" class="pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_15 }}</figcaption></figure></main>
</div></body>
</html>
