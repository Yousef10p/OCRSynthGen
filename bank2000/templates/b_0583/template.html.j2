<!DOCTYPE html>
<html lang="en" dir="ltr"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  flex-direction: row;
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

.container {
  flex: 1;
  display: flex;
  flex-direction: row;
  padding: 20px;
}

.sidebar {
  flex: 1;
  background-color: #f0f0f0;
}

.main-content {
  flex: 3;
  background-color: #fff;
}

.post, .feature {
  margin: 20px 0;
  padding: 20px;
  border: 1px solid #ccc;
}

.featured-section, .recent-posts, .popular-posts, .categories {
  margin: 20px 0;
}

h1 {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 20px;
}

ul {
  list-style-type: none;
  padding: 0;
}

li {
  margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="sidebar">
<div class="popular-posts">
<h1>{{ slot_0 }}</h1>
<div class="post">{{ slot_1 }}</div>
<div class="post">{{ slot_2 }}</div>
<div class="post">{{ slot_3 }}</div>
</div>
<div class="categories">
<h1>{{ slot_4 }}</h1>
<ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</div>
</div>
<div class="main-content">
<div class="featured-section">
<h1>{{ slot_8 }}</h1>
<div class="feature">{{ slot_9 }}</div>
<div class="feature">{{ slot_10 }}</div>
</div>
<div class="recent-posts">
<h1>{{ slot_11 }}</h1>
<div class="post">{{ slot_12 }}</div>
<div class="post">{{ slot_13 }}</div>
<div class="post">{{ slot_14 }}</div>
</div>
</div>
</div>
</body>
</html>