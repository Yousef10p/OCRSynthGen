<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 36.5mm; inline-size: 60.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div  style="inset-inline-start: 94.7mm; inset-block-start: 47.9mm; inline-size: 83.8mm; block-size: 13.9mm; font-size: 8.0pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 67.3mm; inline-size: 135.0mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div  style="inset-inline-start: 97.2mm; inset-block-start: 98.2mm; inline-size: 81.3mm; block-size: 10.6mm; font-size: 12.0pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 113.3mm; inline-size: 135.0mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 138.5mm; inline-size: 135.0mm; block-size: 29.5mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 169.1mm; inline-size: 135.0mm; block-size: 74.8mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 248.2mm; inline-size: 135.0mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 107.9mm; inset-block-start: 279.7mm; inline-size: 6.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
