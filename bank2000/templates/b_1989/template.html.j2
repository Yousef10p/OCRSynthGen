<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div  style="inset-inline-start: 27.2mm; inset-block-start: 27.5mm; inline-size: 67.8mm; block-size: 44.6mm; font-size: 18.1pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 28.7mm; inline-size: 80.4mm; block-size: 58.3mm; font-size: 13.8pt">{{ slot_0 }}</p>
<div  style="inset-inline-start: 25.2mm; inset-block-start: 91.4mm; inline-size: 69.8mm; block-size: 44.8mm; font-size: 14.1pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 93.4mm; inline-size: 81.9mm; block-size: 53.4mm; font-size: 13.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 153.1mm; inline-size: 79.6mm; block-size: 28.5mm; font-size: 13.5pt">{{ slot_2 }}</p>
<div  style="inset-inline-start: 25.7mm; inset-block-start: 155.4mm; inline-size: 68.8mm; block-size: 44.3mm; font-size: 18.0pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 213.5mm; inline-size: 120.3mm; block-size: 54.9mm; font-size: 19.4pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 165.8mm; inset-block-start: 268.9mm; inline-size: 29.7mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_4 }}</footer>
</div></body>
</html>
