<span class="w-full p-2" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_13 }}</span>
<button class="bg-purple-500 text-white px-4 py-2">{{ slot_14 }}</button>
