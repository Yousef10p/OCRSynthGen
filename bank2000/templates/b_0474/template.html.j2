<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.8; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 21mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span><span>{{ slot_1 }}</span><span>{{ slot_2 }}</span></header><h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_3 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_4 }}</p>
<main style="column-count: 2; column-gap: 8mm; column-rule: none"><p style="margin-block: 0 1em; text-indent: 0; text-align: start; font-size: 1em">{{ slot_5 }}</p>
<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 0.3em 1em; margin-block: 0.6em; break-inside: avoid">
<div style="font-weight: bold">{{ slot_6 }}</div>
<div>{{ slot_7 }}</div>
<div style="font-weight: bold">{{ slot_8 }}</div>
<div>{{ slot_9 }}</div>
<div style="font-weight: bold">{{ slot_10 }}</div>
<div>{{ slot_11 }}</div>
<div style="font-weight: bold">{{ slot_12 }}</div>
<div>{{ slot_13 }}</div>
<div style="font-weight: bold">{{ slot_14 }}</div>
<div>{{ slot_15 }}</div>
</div>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: center; margin-block: 1.4em 0.4em">{{ slot_16 }}</h2>
<h2 style="font-size: calc(var(--base-size) * 1.3); text-align: end; margin-block: 1.4em 0.4em">{{ slot_17 }}</h2>
<p style="margin-block: 0 0.4em; text-indent: 0; text-align: var(--align); font-size: 0.95em">{{ slot_18 }}</p>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em"><p style="margin-block: 0.15em">{{ slot_19 }}</p></div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_20 }}</span><span>{{ slot_21 }}</span></footer>
</div></body>
</html>
