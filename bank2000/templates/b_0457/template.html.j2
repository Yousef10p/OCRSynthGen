<ol style="list-style-type: arabic-indic; margin-block: 0.3em; padding-inline-start: 1.8em">
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ol>
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4mm; margin-block: 0.8em; break-inside: avoid">
