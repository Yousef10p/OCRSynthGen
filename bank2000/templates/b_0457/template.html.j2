<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_12 }}</p>
</div>
</div>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: start; font-size: 0.95em">{{ slot_13 }}</p>
<p style="margin-block: 0 1em; text-indent: 0; text-align: justify; font-size: 1em">{{ slot_14 }}</p>
<aside style="border: 2px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_15 }}</p></aside><div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_16 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_17 }}</p>
</div>
<div style="border: 1px solid #999; padding: 0; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_18 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_19 }}</p>
</div>
</div>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: end; margin-block: 0.6em 0.4em">{{ slot_20 }}</h3>
<p style="margin-block: 0 1em; text-indent: 0; text-align: justify; font-size: 0.95em">{{ slot_21 }}</p>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: var(--align); font-size: 1em">{{ slot_22 }}</p>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: var(--align); font-size: 0.95em">{{ slot_23 }}</p>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em"><p style="margin-block: 0.15em">{{ slot_24 }}</p></div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_25 }}</span><span>{{ slot_26 }}</span></footer>
</div></body>
</html>
