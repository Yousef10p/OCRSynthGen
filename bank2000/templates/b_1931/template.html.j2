<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div  style="inset-inline-start: 18.8mm; inset-block-start: 12.6mm; inline-size: 184.9mm; block-size: 61.2mm; font-size: 14.5pt" class="box pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 75.1mm; inline-size: 119.5mm; block-size: 14.8mm; font-size: 14.0pt">{{ slot_0 }}</p>
<div  style="inset-inline-start: 19.0mm; inset-block-start: 99.0mm; inline-size: 121.2mm; block-size: 49.5mm; font-size: 15.6pt" class="box pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 150.2mm; inline-size: 106.3mm; block-size: 9.9mm; font-size: 14.0pt">{{ slot_1 }}</p>
<div  style="inset-inline-start: 19.1mm; inset-block-start: 165.8mm; inline-size: 121.0mm; block-size: 78.9mm; font-size: 14.9pt" class="box pic-frame"><img data-pic="pic_2" src="{{ pic_2 }}" alt=""></div>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 246.6mm; inline-size: 104.1mm; block-size: 9.9mm; font-size: 14.0pt">{{ slot_2 }}</p>
</div></body>
</html>
