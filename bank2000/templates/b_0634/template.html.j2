}

nav ul {
    list-style-type: none;
}

nav li {
    display: inline-block;
    margin: 0 10px;
}

.slider {
    position: relative;
    height: 300px;
    overflow: hidden;
}

.slide {
    display: none;
}

.slide:first-child {
    display: block;
}

.bios {
    margin: 20px 0;
}

.bios article {
