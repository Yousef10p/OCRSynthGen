<!DOCTYPE html>
<html lang="en" dir="ltr"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}


nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: #333;
    color: #fff;
    padding: 1em 0;
}

nav input[type="checkbox"] {
    display: none;
}

nav label {
    display: block;
    cursor: pointer;
}

nav ul {
    display: none;
}

nav input[type="checkbox"]:checked ~ ul {
    display: block;
}


.product {
    text-align: center;
    margin-bottom: 2em;
}

.product-img {
    width: 200px;
    height: 200px;
    background: #ccc;
    display: inline-block;
    margin-bottom: 1em;
}


.add-to-cart {
    background: #05B800;
    color: #fff;
    border: none;
    padding: 0.5em 1em;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
