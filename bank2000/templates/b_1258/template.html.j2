<span class="w-full bg-gray-200 text-gray-700 border border-gray-200 rounded py-3 px-4 mb-3" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>
<button class="bg-blue-500 text-white font-bold py-2 px-4 rounded">{{ slot_10 }}</button>
