<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.8; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 24mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 1.8); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main><p style="margin-block: 0 0.7em; text-indent: 1.5em; text-align: justify; font-size: 1.05em">{{ slot_1 }}</p>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 44mm; margin-inline: auto; inline-size: 100%" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_2 }}</figcaption></figure><div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 40%; block-size: 37mm" class="pic-frame"><img data-pic="pic_1" src="{{ pic_1 }}" alt=""></div>
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_3 }}</h3>
<p style="margin-block: 0">{{ slot_4 }}</p>
</div>
</div>
<aside style="border: 1px solid #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_5 }}</p></aside><div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_6 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_7 }}</p>
</div>
<div style="border: none; padding: 0; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_8 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_9 }}</p>
</div>
<div style="border: none; padding: 0.6em; border-radius: 6px">
<h4 style="margin-block: 0.2em">{{ slot_10 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_11 }}</p>
</div>
</div></main>
</div></body>
</html>
