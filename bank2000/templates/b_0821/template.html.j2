    color: #555;
    padding-top: 10px;
    min-height: 50px;
    border-bottom: #e8491d 3px solid;
}

header img {
    float: right;
    height: 50px;
    width: auto;
}

header nav {
    float: left;
    margin-top: 20px;
}

header nav li {
    display: inline;
    margin-left: 10px;
}

header nav li a{
    text-transform: uppercase;
    color: #555;
}

section.banner {
    color: #f4f4f4;
