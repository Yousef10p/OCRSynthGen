<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: start; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span><span>{{ slot_1 }}</span><span>{{ slot_2 }}</span></header><h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_3 }}</h1>
<main style="column-count: 3; column-gap: 8mm; column-rule: none"><figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 27mm; margin-inline: auto; inline-size: 100%" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_4 }}</figcaption></figure><p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: var(--align); font-size: 1.05em">{{ slot_5 }}</p>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: start; font-size: 1em">{{ slot_6 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 0.6em 0.4em">{{ slot_7 }}</h2>
<aside style="border: 2px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><h4>{{ slot_8 }}</h4>
<p style="margin-block: 0.2em">{{ slot_9 }}</p></aside><h2 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 0.6em 0.4em">{{ slot_10 }}</h2>
<p style="margin-block: 0 1em; text-indent: 0; text-align: start; font-size: 1.05em">{{ slot_11 }}</p>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: var(--align); font-size: 0.95em">{{ slot_12 }}</p>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: var(--align); font-size: 1em">{{ slot_13 }}</p>
<h3 style="font-size: calc(var(--base-size) * 1.5); text-align: center; margin-block: 0.6em 0.4em">{{ slot_14 }}</h3>
<dl style="margin-block: 0.6em">
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_15 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_16 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_17 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_18 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_19 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_20 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_21 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_22 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_23 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_24 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_25 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_26 }}</dd>
</dl></main>
</div></body>
</html>
