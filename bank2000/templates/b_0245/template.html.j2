<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.6; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 14mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.2); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_1 }}</p>
<main style="display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 8mm"><div>
<h2 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 0.6em 0.4em">{{ slot_2 }}</h2>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: var(--align); font-size: 0.95em">{{ slot_3 }}</p>
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4mm; margin-block: 0.8em; text-align: center; break-inside: avoid">
<div style="border: 2px solid #444; padding: 0.5em">
<div style="font-size: 1.8em; font-weight: bold">{{ slot_4 }}</div>
<div style="font-size: 0.85em">{{ slot_5 }}</div>
</div>
<div style="border: none; padding: 0.5em">
<div style="font-size: 1.8em; font-weight: bold">{{ slot_6 }}</div>
<div style="font-size: 0.85em">{{ slot_7 }}</div>
</div>
<div style="border: none; padding: 0.5em">
<div style="font-size: 1.8em; font-weight: bold">{{ slot_8 }}</div>
<div style="font-size: 0.85em">{{ slot_9 }}</div>
</div>
</div>
</div>
<div>
<blockquote style="border-inline-start: 2px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_10 }}</blockquote>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div  style="block-size: 69mm; margin-inline: auto; inline-size: 50%" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_11 }}</figcaption></figure>
</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_12 }}</span><span>{{ slot_13 }}</span><span>{{ slot_14 }}</span></footer>
</div></body>
</html>
