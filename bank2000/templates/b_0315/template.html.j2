<div style="font-size: 0.85em">{{ slot_10 }}</div>
</div>
<div style="border: 1px solid #999; padding: 0.5em">
<div style="font-size: 1.8em; font-weight: bold">{{ slot_11 }}</div>
<div style="font-size: 0.85em">{{ slot_12 }}</div>
</div>
</div>
<dl style="margin-block: 0.6em">
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_13 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_14 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_15 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_16 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_17 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_18 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_19 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_20 }}</dd>
<dt style="font-weight: bold; margin-block-start: 0.4em">{{ slot_21 }}</dt>
<dd style="margin-inline-start: 1.5em">{{ slot_22 }}</dd>
</dl>
<aside style="border: 1px solid #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_23 }}</p></aside><h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 0.6em 0.4em">{{ slot_24 }}</h2>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: var(--align); font-size: 0.95em">{{ slot_25 }}</p>
<ol style="list-style-type: decimal; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_26 }}</li>
<li>{{ slot_27 }}</li>
<li>{{ slot_28 }}</li>
<li>{{ slot_29 }}</li>
<li>{{ slot_30 }}</li>
</ol>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
<p style="margin-block: 0.15em">{{ slot_31 }}</p>
<p style="margin-block: 0.15em">{{ slot_32 }}</p>
</div></main>
</div></body>
</html>
