<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.6; --align: start; --page-width: 297mm; --page-height: 210mm; --page-margin: 16mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main style="display: grid; column-gap: 7mm; grid-template-columns: 2.4fr 1fr"><div>
<p style="margin-block: 0 1em; text-indent: 0; text-align: start; font-size: 0.95em">{{ slot_1 }}</p>
<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 6mm; margin-block: 0.8em; break-inside: avoid">
<div style="border: 1px solid #999; padding: 0.6em; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_2 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_3 }}</p>
</div>
<div style="border: none; padding: 0.6em; border-radius: 0">
<h4 style="margin-block: 0.2em">{{ slot_4 }}</h4>
<p style="margin-block: 0.2em; font-size: 0.92em">{{ slot_5 }}</p>
</div>
</div>
<h3 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 1em 0.4em">{{ slot_6 }}</h3>
<p style="margin-block: 0 0.7em; text-indent: 1.5em; text-align: var(--align); font-size: 0.95em">{{ slot_7 }}</p>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: justify; font-size: 1em">{{ slot_8 }}</p>
<div style="display: flex; gap: 5mm; align-items: flex-start; margin-block: 0.8em; break-inside: avoid">
<div style="flex: 0 0 40%; block-size: 25mm" class="pic-frame"><img data-pic="pic_0" src="{{ pic_0 }}" alt=""></div>
<div style="flex: 1">
<h3 style="margin-block: 0 0.3em">{{ slot_9 }}</h3>
<p style="margin-block: 0">{{ slot_10 }}</p>
</div>
</div>
<aside style="border: 2px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_11 }}</p></aside><div style="margin-block: 0.6em">
<div style="display: flex; gap: 0.8em; align-items: baseline; margin-block: 0.35em">
<span style="font-weight: bold; white-space: nowrap">{{ slot_12 }}</span><span style="border-block-end: 1px solid #000; flex: 1; min-inline-size: 5em">{{ slot_13 }}</span>
</div>
<div style="display: flex; gap: 0.8em; align-items: baseline; margin-block: 0.35em">
<span style="font-weight: bold; white-space: nowrap">{{ slot_14 }}</span><span style="border-block-end: 1px solid #000; flex: 1; min-inline-size: 5em">{{ slot_15 }}</span>
</div>
</div>
</div>
<aside style="background: transparent; padding: 0.6em; border-inline-start: none"><h3>{{ slot_16 }}</h3>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_17 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_18 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_19 }}</p></aside><div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em"><p style="margin-block: 0.15em">{{ slot_20 }}</p></div></main>
</div></body>
</html>
