<!DOCTYPE html>
<html lang="en" dir="ltr"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  font-family: var(--font-body);
  color: #333;
}


nav {
  position: sticky;
  top: 0;
  background: #f8d7da;
  text-align: center;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline-block;
  margin: 0 10px;
}

nav ul li a {
  text-decoration: none;
  color: #333;
}


main {
  width: 70%;
  margin: 0 auto;
}

.blog-post {
  margin-bottom: 30px;
}

.blog-post img {
  width: 100%;
  height: 300px;
  background: #f8d7da;
}


aside {
  width: 25%;
  float: right;
  background: #d1ecf1;
  padding: 10px;
}

.popular-post img {
  width: 100%;
  height: 150px;
  background: #cce5ff;
}

.social-links a {
  margin-right: 10px;
  text-decoration: none;
  color: #007bff;
}

@media (max-width: 600px) {
  main, aside {
    width: 100%;
    float: none;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
.pic-frame { overflow: hidden; min-block-size: 2em; }
.pic-frame > img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style><style>{{ style }}</style></head>
