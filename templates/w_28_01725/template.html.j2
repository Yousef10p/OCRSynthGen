}

footer form {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 20px;
}

footer form input {
    padding: 10px;
    border: none;
    margin-left: 10px;
}

footer .social-media-icons {
    display: flex;
    justify-content: center;
    align-items: center;
}

footer .social-media-icons a {
    margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
