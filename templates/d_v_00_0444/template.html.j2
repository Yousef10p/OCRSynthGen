<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 83.6mm; inset-block-start: 18.2mm; inline-size: 25.0mm; block-size: 2.3mm; font-size: 6.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 50.6mm; inset-block-start: 44.4mm; inline-size: 47.0mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 83.6mm; inset-block-start: 57.5mm; inline-size: 104.3mm; block-size: 6.4mm; font-size: 18.0pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 104.4mm; inset-block-start: 76.1mm; inline-size: 69.7mm; block-size: 34.2mm; font-size: 16.2pt"></div>
<h2 class="box" style="inset-inline-start: 83.6mm; inset-block-start: 119.3mm; inline-size: 43.9mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 142.3mm; inset-block-start: 119.2mm; inline-size: 47.4mm; block-size: 41.8mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 83.6mm; inset-block-start: 124.3mm; inline-size: 49.2mm; block-size: 124.6mm; font-size: 12.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 142.3mm; inset-block-start: 167.1mm; inline-size: 48.6mm; block-size: 41.8mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 142.3mm; inset-block-start: 215.0mm; inline-size: 48.5mm; block-size: 33.1mm; font-size: 11.7pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 21.5mm; inset-block-start: 265.1mm; inline-size: 1.5mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
