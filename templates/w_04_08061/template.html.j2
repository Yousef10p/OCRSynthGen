<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

nav {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
}

nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

nav ul li {
    margin: 2em 0;
    background: rgba(0,0,0,0.3);
    width: 15em;
    height: 3em;
    line-height: 3em;
    text-align: center;
    transition: all 0.3s;
    position: relative;
}

nav ul li:after {
    content: "";
    position: absolute;
    top: -1em;
    left: -1em;
    bottom: -1em;
    right: -1em;
    background: rgba(0,0,0,0.5);
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s;
}

nav ul li:hover:after {
    opacity: 1;
}

nav ul li a {
    color: white;
    text-decoration: none;
    display: block;
}

section {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    scroll-snap-align: start;
}

section:nth-child(odd) {
    background: #ccc;
}

.social-icons a {
    display: inline-block;
    width: 2em;
    height: 2em;
    background: black;
    color: white;
    margin: 0 1em;
    text-align: center;
    line-height: 2em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
