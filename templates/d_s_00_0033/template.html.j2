<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 159.2mm; inline-size: 73.9mm; block-size: 57.8mm; font-size: 13.7pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 2.6mm; inset-block-start: 166.4mm; inline-size: 2.0mm; block-size: 14.7mm; font-size: 40.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 183.9mm; inline-size: 73.9mm; block-size: 43.0mm; font-size: 13.5pt">{{ slot_7 }}</p>
