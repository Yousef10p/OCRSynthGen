<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.container {
    display: flex;
    margin: 20px;
}

.left-column, .center-column, .right-column {
    margin: 10px;
    flex: 1;
}

.blue-box {
    background-color: blue;
    color: white;
    padding: 10px;
    margin: 10px 0;
}

.social-media {
    width: 70%;
}

.image {
    height: 100px;
}

input[type="text"] {
    margin-bottom: 10px;
    padding: 5px;
    width: 100%;
}

a {
    color: blue;
    text-decoration: none;
}

ul {
    list-style-type: none;
    padding: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="left-column">
<h2>{{ slot_0 }}</h2>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
<h2>{{ slot_2 }}</h2>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
<h2>{{ slot_5 }}</h2>
<div class="promotion">{{ slot_6 }}</div>
</div>
<div class="center-column">
<div class="blue-box image">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
<div class="blue-box image">{{ slot_9 }}</div>
<p>{{ slot_10 }}</p>
</div>
<div class="right-column">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<div class="blue-box social-media">{{ slot_14 }}</div>
<div class="blue-box social-media">{{ slot_15 }}</div>
<div class="blue-box social-media">{{ slot_16 }}</div>
</div>
</div>
</body>
</html>