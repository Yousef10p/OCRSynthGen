<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	font-family: var(--font-body);
}

#hero {
	width: 100%;
	height: 50vh;
	background-color: #333;
	color: white;
	text-align: center;
	display: flex;
	flex-direction: column;
	justify-content: center;
}

#menu {
	position: fixed;
	width: 100%;
	background-color: white;
	list-style-type: none;
}

#menu li {
	float: right;
	display: inline;
}

#menu li a, .dropbtn {
	display: inline-block;
	color: white;
	text-align: center;
	padding: 14px 16px;
	text-decoration: none;
}

#carousel {
	height: 50vh;
	background-color: blue;
}

footer {
	display: flex;
	justify-content: space-around;
	align-items: center;
	width: 100%;
	color: white;
}

footer div {
	width: 45%;
	padding: 20px;
}

footer a {
	display: block;
}


.dropdown {
	position: relative;
	display: inline-block;
}

.dropdown-content {
	display: none;
	position: absolute;
	background-color: #f1f1f1;
	min-width: 160px;
	z-index: 1;
}
.dropdown-content a {
	color: black;
	padding: 12px 16px;
	text-decoration: none;
	display: block;
}
.dropdown-content a:hover {background-color: #ddd;}
.dropdown:hover .dropdown-content {display: block;}




.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
