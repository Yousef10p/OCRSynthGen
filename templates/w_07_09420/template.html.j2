<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</div>
</div>
<div class="content">
<div class="main">{{ slot_10 }}</div>
<div class="sidebar">{{ slot_11 }}</div>
</div>
<div class="footer">
<ul>
