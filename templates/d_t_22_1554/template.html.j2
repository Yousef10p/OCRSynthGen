<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 3.6mm; inline-size: 120.6mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 53.0mm; inset-block-start: 14.5mm; inline-size: 62.3mm; block-size: 29.8mm; font-size: 28.1pt">{{ slot_1 }}</h2>
<header class="box" style="inset-inline-start: 34.8mm; inset-block-start: 18.7mm; inline-size: 13.6mm; block-size: 177.7mm; font-size: 40.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 53.0mm; inset-block-start: 44.9mm; inline-size: 56.0mm; block-size: 11.6mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 53.0mm; inset-block-start: 58.9mm; inline-size: 59.7mm; block-size: 26.8mm; font-size: 10.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 53.0mm; inset-block-start: 88.0mm; inline-size: 61.0mm; block-size: 19.2mm; font-size: 10.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 65.2mm; inset-block-start: 110.6mm; inline-size: 35.7mm; block-size: 34.0mm; font-size: 16.1pt"></div>
<p class="box" style="inset-inline-start: 66.8mm; inset-block-start: 146.2mm; inline-size: 33.1mm; block-size: 7.0mm; font-size: 19.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 53.0mm; inset-block-start: 155.9mm; inline-size: 56.0mm; block-size: 16.1mm; font-size: 11.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 53.0mm; inset-block-start: 174.3mm; inline-size: 55.9mm; block-size: 12.1mm; font-size: 11.5pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 71.0mm; inset-block-start: 189.2mm; inline-size: 24.5mm; block-size: 7.1mm; font-size: 20.1pt"></div>
<footer class="box" style="inset-inline-start: 61.0mm; inset-block-start: 200.4mm; inline-size: 76.0mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
