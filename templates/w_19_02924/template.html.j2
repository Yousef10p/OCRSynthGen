}

.slider {
	display: flex;
	overflow: hidden;
	transform: translate3d(50%, 0, 0);
}

.slide {
	height: 100%;
	flex: 0 0 100%;
	background: #f0f0f0;
	padding: 2rem;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
