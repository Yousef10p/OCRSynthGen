    margin-top: 3em;
}

button {
    background: #333;
    color: #fff;
    border: none;
    padding: 1em;
    margin-top: 1em;
    cursor: pointer;
    transition: background 0.2s;
}

button:hover {
    background: #666;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
