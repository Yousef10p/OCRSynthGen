}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
}

nav ul li {
    margin: 0 1em;
}

nav ul li a {
    text-decoration: none;
    color: #333;
    transition: color 0.2s;
}

nav ul li a:hover {
    color: #666;
}

.menu {
    display: flex;
    justify-content: space-around;
    margin: 3em 0;
}

.menu-item {
    text-align: center;
    width: 30%;
}

footer {
    background: #f4f4f4;
    padding: 1em;
