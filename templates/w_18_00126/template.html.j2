    margin-bottom: 30px;
}

footer input, footer textarea, footer button {
    margin-bottom: 15px;
    padding: 10px;
    font-size: 1em;
}

footer #locations {
    width: 100%;
    height: 200px;
    background-color: lightsalmon;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
