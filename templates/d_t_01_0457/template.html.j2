<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 21.1mm; inline-size: 91.6mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 22.2mm; inset-block-start: 31.8mm; inline-size: 36.2mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 35.1mm; inline-size: 158.8mm; block-size: 9.7mm; font-size: 9.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 22.2mm; inset-block-start: 47.4mm; inline-size: 8.0mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 50.8mm; inline-size: 158.8mm; block-size: 16.8mm; font-size: 9.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 68.5mm; inline-size: 159.7mm; block-size: 20.3mm; font-size: 9.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 89.6mm; inline-size: 158.8mm; block-size: 23.8mm; font-size: 9.7pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 88.8mm; inset-block-start: 263.2mm; inline-size: 16.3mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 118.0mm; inset-block-start: 263.2mm; inline-size: 2.3mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_8 }}</footer>
</div></body>
</html>
