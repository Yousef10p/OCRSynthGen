<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: var(--font-body);
  line-height: 1.6;
  color: #333;
  background-color: #fff;
}
section {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 20px;
  padding: 20px;  
}
header {
  display: flex;
  justify-content: center;
  align-items: center;
  grid-column: 1 / -1;
  background-color: #f8f8f8;
  padding: 20px;
}
input[type="text"] {
  width: 100%;
  padding: 10px;
  border: 1px solid #ccc;
}
.image-placeholder {
  background-color: #ccc;
  height: 500px;
  grid-column: 1 / -1;
}
.form-section {
  grid-column: 1 / -1;
}
.form-section label {
  display: block;
  margin-bottom: 10px;
}
.form-section input[type="text"],
.form-section input[type="email"],
.form-section input[type="tel"] {
  width: 100%;
  padding: 10px;
  border: 1px solid #ccc;
}
.form-section button {
  padding: 10px 20px;
  background-color: #007BFF;
  color: #fff;
  border: none;
  cursor: pointer;
}
.videos-section {
  grid-column: 1 / -1;
}
.videos-section article h2 {
  margin-bottom: 10px;
}
.videos-section article p {
  margin-bottom: 20px;
}
.video-placeholder {
  background-color: #ccc;
  height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
