<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 28.8mm; inset-block-start: 25.8mm; inline-size: 91.8mm; block-size: 7.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 75.9mm; inset-block-start: 32.7mm; inline-size: 114.0mm; block-size: 17.3mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 95.4mm; inset-block-start: 48.1mm; inline-size: 94.5mm; block-size: 10.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 59.9mm; inline-size: 153.9mm; block-size: 11.6mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 28.3mm; inset-block-start: 77.6mm; inline-size: 106.5mm; block-size: 7.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 88.1mm; inset-block-start: 81.6mm; inline-size: 101.8mm; block-size: 13.7mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 98.3mm; inset-block-start: 97.7mm; inline-size: 91.6mm; block-size: 10.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 110.3mm; inline-size: 164.5mm; block-size: 48.5mm; font-size: 12.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 170.4mm; inline-size: 110.6mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 182.3mm; inline-size: 164.5mm; block-size: 78.0mm; font-size: 12.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 103.5mm; inset-block-start: 266.7mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
