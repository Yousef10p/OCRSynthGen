<p class="box" style="inset-inline-start: 116.2mm; inset-block-start: 97.6mm; inline-size: 43.2mm; block-size: 12.2mm; font-size: 17.3pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 123.0mm; inline-size: 61.2mm; block-size: 23.8mm; font-size: 22.5pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 116.2mm; inset-block-start: 123.0mm; inline-size: 55.7mm; block-size: 12.2mm; font-size: 17.3pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 184.7mm; inset-block-start: 262.4mm; inline-size: 2.9mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_11 }}</footer>
</div></body>
</html>
