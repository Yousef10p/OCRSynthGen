<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 23.4mm; inset-block-start: 9.2mm; inline-size: 37.1mm; block-size: 23.9mm; font-size: 13.5pt"></div>
<header class="box" style="inset-inline-start: 153.3mm; inset-block-start: 16.4mm; inline-size: 35.4mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 95.5mm; inset-block-start: 19.5mm; inline-size: 35.3mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 172.9mm; inset-block-start: 22.5mm; inline-size: 15.1mm; block-size: 10.4mm; font-size: 14.7pt"></div>
<ul class="box" style="inset-inline-start: 37.4mm; inset-block-start: 35.4mm; inline-size: 151.7mm; block-size: 8.1mm; font-size: 11.5pt"><li>{{ slot_2 }}</li></ul>
<h2 class="box" style="inset-inline-start: 45.4mm; inset-block-start: 48.2mm; inline-size: 63.8mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 57.0mm; inline-size: 151.8mm; block-size: 11.4mm; font-size: 10.7pt">{{ slot_4 }}</p>
