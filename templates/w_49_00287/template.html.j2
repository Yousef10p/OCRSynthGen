<div class="container">
<div class="column left">
<h2>{{ slot_0 }}</h2>
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
</ul>
<h2>{{ slot_3 }}</h2>
<div class="popular-item">{{ slot_4 }}</div>
<div class="popular-item">{{ slot_5 }}</div>
</div>
<div class="column main">
<h2>{{ slot_6 }}</h2>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
</div>
<div class="column right">
<h2>{{ slot_9 }}</h2>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
<span class="">{{ slot_11 }}</span>
</form>
<h2>{{ slot_12 }}</h2>
<div class="social-feed">{{ slot_13 }}</div>
<div class="social-feed">{{ slot_14 }}</div>
</div>
</div>
</body>
</html>