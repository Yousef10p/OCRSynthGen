}
.search input[type="text"] {
    width: 100%;
    margin-bottom: 10px;
}
form input[type="text"], 
form input[type="email"] {
    width: 100%;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
