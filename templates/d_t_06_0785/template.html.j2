<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 23.2mm; inset-block-start: 9.4mm; inline-size: 20.4mm; block-size: 12.2mm; font-size: 34.7pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 31.1mm; inline-size: 215.8mm; block-size: 139.6mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 56.3mm; inset-block-start: 182.3mm; inline-size: 1.4mm; block-size: 4.7mm; font-size: 13.2pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 35.6mm; inset-block-start: 193.1mm; inline-size: 43.0mm; block-size: 8.6mm; font-size: 8.1pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 38.5mm; inset-block-start: 201.9mm; inline-size: 37.1mm; block-size: 3.8mm; font-size: 5.4pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 52.3mm; inset-block-start: 211.9mm; inline-size: 9.6mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 29.8mm; inset-block-start: 216.9mm; inline-size: 54.6mm; block-size: 7.7mm; font-size: 10.9pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 51.7mm; inset-block-start: 225.9mm; inline-size: 10.7mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 48.8mm; inset-block-start: 230.9mm; inline-size: 16.6mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 47.7mm; inset-block-start: 236.5mm; inline-size: 18.7mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 40.3mm; inset-block-start: 241.5mm; inline-size: 33.5mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_9 }}</p>
</div></body>
</html>
