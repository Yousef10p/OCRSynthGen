<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.8mm; inset-block-start: 19.1mm; inline-size: 83.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 13.1mm; inset-block-start: 24.4mm; inline-size: 158.0mm; block-size: 28.9mm; font-size: 11.7pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 177.2mm; inset-block-start: 37.7mm; inline-size: 38.6mm; block-size: 53.3mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 25.8mm; inset-block-start: 56.1mm; inline-size: 32.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 13.1mm; inset-block-start: 61.4mm; inline-size: 153.5mm; block-size: 7.7mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 185.6mm; inset-block-start: 92.8mm; inline-size: 24.7mm; block-size: 19.2mm; font-size: 13.6pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 124.4mm; inset-block-start: 268.9mm; inline-size: 40.2mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 178.2mm; inset-block-start: 271.4mm; inline-size: 9.2mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
