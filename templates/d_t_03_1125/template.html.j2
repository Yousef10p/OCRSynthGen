<header class="box" style="inset-inline-start: 14.6mm; inset-block-start: 131.9mm; inline-size: 2.6mm; block-size: 29.6mm; font-size: 40.0pt">{{ slot_5 }}</header><h2 class="box" style="inset-inline-start: 54.3mm; inset-block-start: 136.9mm; inline-size: 31.1mm; block-size: 4.0mm; font-size: 11.5pt">{{ slot_6 }}</h2>
