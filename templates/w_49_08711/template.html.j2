<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
    color: white;
}

body {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

header {
    background-color: red;
    padding: 10px;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

nav ul li {
    list-style-type: none;
}

nav ul li a {
    color: white;
    text-decoration: none;
}

.slides {
    display: flex;
    justify-content: space-around;
}

.slides .slide {
    width: 30%;
    height: 200px;
    padding: 20px;
}

.promotions {
    flex: 1;
    display: flex;
    justify-content: space-around;
    align-items: center;
}

.promotions .promotion {
    width: 45%;
    height: 150px;
    padding: 20px;
}

aside {
    background-color: red;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<div class="slider">
<div class="slides">
<div class="slide" style="background-color: red;">{{ slot_4 }}</div>
<div class="slide" style="background-color: red;">{{ slot_5 }}</div>
<div class="slide" style="background-color: red;">{{ slot_6 }}</div>
</div>
</div>
<div class="promotions">
<h2>{{ slot_7 }}</h2>
<div class="promotion" style="background-color: red;">{{ slot_8 }}</div>
<div class="promotion" style="background-color: red;">{{ slot_9 }}</div>
</div>
<aside>
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}<br>{{ slot_14 }}</p>
</aside>
</body>
</html>