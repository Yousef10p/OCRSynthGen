<ul class="box" style="inset-inline-start: 26.1mm; inset-block-start: 100.1mm; inline-size: 83.6mm; block-size: 8.6mm; font-size: 12.2pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 113.7mm; inline-size: 83.2mm; block-size: 13.2mm; font-size: 12.5pt">{{ slot_6 }}</p>
