<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.5mm; inset-block-start: 33.5mm; inline-size: 51.3mm; block-size: 10.8mm; font-size: 30.7pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 135.2mm; inset-block-start: 59.1mm; inline-size: 25.4mm; block-size: 15.7mm; font-size: 22.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 18.5mm; inset-block-start: 63.8mm; inline-size: 42.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 18.4mm; inset-block-start: 74.5mm; inline-size: 48.7mm; block-size: 10.9mm; font-size: 15.4pt">{{ slot_3 }}</h2>
<div class="box ph" style="inset-inline-start: 84.1mm; inset-block-start: 75.6mm; inline-size: 101.4mm; block-size: 103.2mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 18.3mm; inset-block-start: 90.8mm; inline-size: 60.7mm; block-size: 85.3mm; font-size: 16.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 18.5mm; inset-block-start: 188.0mm; inline-size: 80.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</h2>
<h2 class="box" style="inset-inline-start: 18.5mm; inset-block-start: 198.6mm; inline-size: 116.4mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_6 }}</h2>
