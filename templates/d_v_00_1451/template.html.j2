<footer class="box" style="inset-inline-start: 11.8mm; inset-block-start: 279.6mm; inline-size: 5.8mm; block-size: 7.2mm; font-size: 20.4pt">{{ slot_9 }}</footer><footer class="box" style="inset-inline-start: 24.8mm; inset-block-start: 282.6mm; inline-size: 56.8mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
