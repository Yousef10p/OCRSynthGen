<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.3mm; inset-block-start: 25.4mm; inline-size: 173.0mm; block-size: 17.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 54.7mm; inline-size: 165.1mm; block-size: 37.5mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 32.0mm; inset-block-start: 100.9mm; inline-size: 151.9mm; block-size: 17.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 130.2mm; inline-size: 165.1mm; block-size: 12.3mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 25.4mm; inset-block-start: 151.1mm; inline-size: 168.8mm; block-size: 17.7mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 187.3mm; inset-block-start: 180.2mm; inline-size: 3.1mm; block-size: 3.5mm; font-size: 9.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 189.9mm; inline-size: 121.2mm; block-size: 8.5mm; font-size: 8.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 27.7mm; inset-block-start: 205.1mm; inline-size: 160.5mm; block-size: 32.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 245.8mm; inline-size: 165.1mm; block-size: 5.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 261.6mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_4 }}</footer>
</div></body>
</html>
