<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 141.6mm; inline-size: 24.8mm; block-size: 5.5mm; font-size: 7.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 146.1mm; inline-size: 163.3mm; block-size: 36.5mm; font-size: 11.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 186.0mm; inline-size: 22.4mm; block-size: 5.5mm; font-size: 7.9pt">{{ slot_5 }}</h2>
