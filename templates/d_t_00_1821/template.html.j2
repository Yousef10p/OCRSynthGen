<div class="box ph" style="inset-inline-start: 86.0mm; inset-block-start: 61.7mm; inline-size: 31.9mm; block-size: 78.7mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 141.5mm; inset-block-start: 62.4mm; inline-size: 30.9mm; block-size: 78.5mm; font-size: 37.1pt"></div>
