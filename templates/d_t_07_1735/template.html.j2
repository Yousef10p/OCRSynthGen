<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 148mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 65.4mm; inset-block-start: 21.5mm; inline-size: 82.7mm; block-size: 17.2mm; font-size: 24.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 16.4mm; inset-block-start: 54.3mm; inline-size: 36.5mm; block-size: 17.9mm; font-size: 25.4pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 82.6mm; inset-block-start: 54.2mm; inline-size: 44.7mm; block-size: 9.8mm; font-size: 27.7pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 170.8mm; inset-block-start: 54.7mm; inline-size: 19.7mm; block-size: 6.5mm; font-size: 18.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 151.7mm; inset-block-start: 64.1mm; inline-size: 47.7mm; block-size: 6.5mm; font-size: 9.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 170.8mm; inset-block-start: 73.5mm; inline-size: 22.4mm; block-size: 6.5mm; font-size: 18.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 66.6mm; inset-block-start: 83.2mm; inline-size: 80.4mm; block-size: 13.7mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 66.2mm; inset-block-start: 97.6mm; inline-size: 82.2mm; block-size: 18.5mm; font-size: 10.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 159.7mm; inset-block-start: 118.3mm; inline-size: 47.3mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_8 }}</p>
</div></body>
</html>
