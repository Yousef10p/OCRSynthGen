<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 85.2mm; inline-size: 143.1mm; block-size: 13.0mm; font-size: 12.0pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 109.5mm; inline-size: 50.8mm; block-size: 5.1mm; font-size: 12.0pt">{{ slot_5 }}</h2>
