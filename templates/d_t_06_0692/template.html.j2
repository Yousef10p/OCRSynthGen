<p class="box" style="inset-inline-start: 133.7mm; inset-block-start: 97.5mm; inline-size: 34.0mm; block-size: 4.9mm; font-size: 13.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 133.7mm; inset-block-start: 165.8mm; inline-size: 36.0mm; block-size: 2.8mm; font-size: 7.8pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 20.6mm; inset-block-start: 181.0mm; inline-size: 26.0mm; block-size: 10.0mm; font-size: 14.1pt"></div>
