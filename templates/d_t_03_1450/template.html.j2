<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 8.2mm; inline-size: 105.5mm; block-size: 25.5mm; font-size: 24.1pt">{{ slot_0 }}</p>
<header class="box" style="inset-inline-start: 175.0mm; inset-block-start: 9.2mm; inline-size: 32.0mm; block-size: 156.4mm; font-size: 40.0pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 80.3mm; inset-block-start: 60.0mm; inline-size: 61.9mm; block-size: 212.5mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 74.9mm; inline-size: 57.0mm; block-size: 46.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 126.2mm; inline-size: 57.8mm; block-size: 51.5mm; font-size: 12.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 144.9mm; inset-block-start: 174.4mm; inline-size: 60.6mm; block-size: 42.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 182.9mm; inline-size: 55.2mm; block-size: 33.7mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 221.8mm; inline-size: 58.1mm; block-size: 33.7mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 144.9mm; inset-block-start: 221.9mm; inline-size: 58.8mm; block-size: 33.7mm; font-size: 11.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 201.9mm; inset-block-start: 267.3mm; inline-size: 1.4mm; block-size: 2.4mm; font-size: 6.8pt">{{ slot_8 }}</footer>
</div></body>
</html>
