<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    position: absolute;
    top: 0;
    right: 0;
    background-color: #333;
    color: #fff;
    width: 100%;
    padding: 20px 0;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

#featured {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    width: 100%;
    text-align: center;
}

.image {
    width: 300px;
    height: 300px;
    background-color: #999;
    margin: 0 auto;
}

input[type="search"] {
    width: 50%;
    margin: 30px auto;
    display: block;
}

footer {
    position: absolute;
    bottom: 0;
    right: 0;
    background-color: #333;
    color: #fff;
    width: 100%;
    padding: 20px 0;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<main>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<div id="featured">
<div class="image ph"></div>
<p>{{ slot_5 }}</p>
</div>
</main>
<footer>
<p>{{ slot_6 }} <a>{{ slot_7 }}</a> {{ slot_8 }} <a>{{ slot_9 }}</a> {{ slot_10 }} <a>{{ slot_11 }}</a></p>
<p><a>{{ slot_12 }}</a> {{ slot_13 }} <a>{{ slot_14 }}</a></p>
</footer>
</body>
</html>