<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 56.9mm; inline-size: 88.6mm; block-size: 81.1mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 56.9mm; inline-size: 88.6mm; block-size: 106.5mm; font-size: 12.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 139.5mm; inline-size: 84.5mm; block-size: 64.1mm; font-size: 12.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 164.9mm; inline-size: 88.7mm; block-size: 59.9mm; font-size: 12.1pt">{{ slot_7 }}</p>
