<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 32.1mm; inset-block-start: 4.8mm; inline-size: 12.7mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 31.9mm; inset-block-start: 14.0mm; inline-size: 64.8mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 25.4mm; inline-size: 73.3mm; block-size: 25.5mm; font-size: 14.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 114.9mm; inset-block-start: 25.4mm; inline-size: 76.1mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 56.2mm; inline-size: 73.3mm; block-size: 14.2mm; font-size: 13.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 114.9mm; inset-block-start: 61.8mm; inline-size: 74.9mm; block-size: 19.8mm; font-size: 14.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 75.6mm; inline-size: 75.4mm; block-size: 87.6mm; font-size: 15.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 114.9mm; inset-block-start: 86.9mm; inline-size: 75.2mm; block-size: 59.3mm; font-size: 15.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 114.9mm; inset-block-start: 151.6mm; inline-size: 73.2mm; block-size: 8.5mm; font-size: 12.1pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 172.7mm; inline-size: 164.7mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 178.3mm; inline-size: 216.0mm; block-size: 101.0mm; font-size: 15.1pt"></div>
</div></body>
</html>
