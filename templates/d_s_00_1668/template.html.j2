<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 64.9mm; inset-block-start: 24.6mm; inline-size: 86.1mm; block-size: 57.1mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 86.1mm; inset-block-start: 86.6mm; inline-size: 43.7mm; block-size: 3.7mm; font-size: 10.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 101.9mm; inline-size: 63.9mm; block-size: 3.3mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 109.1mm; inline-size: 165.1mm; block-size: 10.2mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 126.5mm; inline-size: 165.1mm; block-size: 24.4mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 158.3mm; inline-size: 147.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 76.7mm; inset-block-start: 171.0mm; inline-size: 113.8mm; block-size: 5.4mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 183.4mm; inline-size: 144.1mm; block-size: 4.5mm; font-size: 7.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 82.3mm; inset-block-start: 196.2mm; inline-size: 108.2mm; block-size: 28.2mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 234.2mm; inline-size: 190.2mm; block-size: 17.2mm; font-size: 10.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 106.2mm; inset-block-start: 262.1mm; inline-size: 3.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
