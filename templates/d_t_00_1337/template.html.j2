<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 33.4mm; inline-size: 108.4mm; block-size: 27.6mm; font-size: 15.7pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 26.3mm; inset-block-start: 35.8mm; inline-size: 49.4mm; block-size: 73.9mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 64.0mm; inline-size: 110.0mm; block-size: 95.9mm; font-size: 19.4pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 193.6mm; inline-size: 65.9mm; block-size: 69.0mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 74.4mm; inset-block-start: 197.4mm; inline-size: 35.8mm; block-size: 7.9mm; font-size: 11.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 74.4mm; inset-block-start: 211.5mm; inline-size: 59.6mm; block-size: 11.3mm; font-size: 16.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 139.3mm; inset-block-start: 212.8mm; inline-size: 61.5mm; block-size: 48.2mm; font-size: 17.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 74.4mm; inset-block-start: 225.4mm; inline-size: 60.9mm; block-size: 35.5mm; font-size: 16.8pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 12.7mm; inset-block-start: 266.1mm; inline-size: 1.8mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 27.3mm; inset-block-start: 266.7mm; inline-size: 20.9mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
