}

nav a {
  color: white;
  font-weight: bold;
  text-decoration: none;
}

#masonry {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  grid-gap: 10px;
  margin-bottom: 20px;
}

.box {
  height: 200px;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

#trip-section {
  display: flex;
  justify-content: space-around;
}

.trip {
  width: 20%;
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}

form {
  display: flex;
  flex-direction: column;
  width: 50%;
  margin: 0 auto;
}

input, textarea, button {
  margin-bottom: 1em;
  padding: 0.5em;
}

button {
  background-color: blue;
  color: white;
  border: none;
  cursor: pointer;
  padding: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
