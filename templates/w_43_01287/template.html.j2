body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

header {
  background-image: none; 
  background-size: cover;
  color: white;
  padding: 100px 0;
  text-align: center;
}

nav ul {
  margin: 0;
  padding: 0;
  list-style: none;
