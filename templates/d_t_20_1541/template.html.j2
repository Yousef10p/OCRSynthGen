<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 34.4mm; inset-block-start: 13.9mm; inline-size: 46.5mm; block-size: 5.0mm; font-size: 14.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 25.8mm; inline-size: 19.4mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 47.3mm; inset-block-start: 35.1mm; inline-size: 62.9mm; block-size: 25.1mm; font-size: 14.3pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 34.1mm; inset-block-start: 64.7mm; inline-size: 57.5mm; block-size: 5.9mm; font-size: 16.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 74.0mm; inline-size: 141.3mm; block-size: 44.5mm; font-size: 18.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 32.7mm; inset-block-start: 130.8mm; inline-size: 145.3mm; block-size: 26.6mm; font-size: 25.2pt"></div>
<p class="box" style="inset-inline-start: 52.0mm; inset-block-start: 160.2mm; inline-size: 105.8mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.3mm; inset-block-start: 170.9mm; inline-size: 141.3mm; block-size: 18.5mm; font-size: 17.5pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 32.9mm; inset-block-start: 204.7mm; inline-size: 146.3mm; block-size: 30.1mm; font-size: 28.4pt"></div>
<p class="box" style="inset-inline-start: 67.8mm; inset-block-start: 238.3mm; inline-size: 74.1mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 34.7mm; inset-block-start: 249.3mm; inline-size: 141.0mm; block-size: 12.2mm; font-size: 17.4pt">{{ slot_8 }}</p>
</div></body>
</html>
