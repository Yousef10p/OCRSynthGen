<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 157.7mm; inset-block-start: 12.5mm; inline-size: 33.1mm; block-size: 20.4mm; font-size: 14.4pt"></div>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 25.4mm; inline-size: 60.7mm; block-size: 9.0mm; font-size: 25.4pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 93.6mm; inset-block-start: 42.0mm; inline-size: 29.5mm; block-size: 4.2mm; font-size: 11.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 93.6mm; inset-block-start: 49.9mm; inline-size: 101.8mm; block-size: 28.7mm; font-size: 13.6pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 12.7mm; inset-block-start: 50.9mm; inline-size: 71.6mm; block-size: 48.5mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 93.6mm; inset-block-start: 82.4mm; inline-size: 101.5mm; block-size: 28.7mm; font-size: 13.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.4mm; inset-block-start: 102.6mm; inline-size: 47.9mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 93.6mm; inset-block-start: 120.1mm; inline-size: 66.2mm; block-size: 6.7mm; font-size: 18.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 93.6mm; inset-block-start: 130.0mm; inline-size: 103.3mm; block-size: 33.6mm; font-size: 13.6pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 173.5mm; inline-size: 215.9mm; block-size: 98.2mm; font-size: 18.6pt"></div>
</div></body>
</html>
