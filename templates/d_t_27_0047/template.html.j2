<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 25.2mm; inline-size: 144.8mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_0 }}</li></ul>
<div class="box ph" style="inset-inline-start: 47.9mm; inset-block-start: 37.9mm; inline-size: 144.6mm; block-size: 28.4mm; font-size: 16.1pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 67.1mm; inline-size: 63.1mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 48.3mm; inset-block-start: 76.3mm; inline-size: 89.1mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 81.6mm; inline-size: 147.6mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 93.6mm; inline-size: 144.1mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 108.1mm; inline-size: 140.3mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 53.5mm; inset-block-start: 120.8mm; inline-size: 139.6mm; block-size: 102.9mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 53.3mm; inset-block-start: 224.7mm; inline-size: 95.7mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 140.6mm; inset-block-start: 266.3mm; inline-size: 52.4mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
