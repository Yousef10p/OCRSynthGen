    height: 100vh;
    display: grid;
    grid-template-columns: 70% 30%;
    grid-template-rows: 60px 2fr 2fr;
    grid-template-areas: 
        "nav nav"
        "hero sidebar"
        "portfolio contact";
}

.hero {
    grid-area: hero;
    background: red;
}

.sidebar {
    grid-area: sidebar;
    display: flex;
    flex-direction: column;
    padding: 20px;
}

.about-us {
    flex: 1;
