}

.portfolio-item {
    flex: 1;
    background: silver;
}

.contact {
    grid-area: contact;
    display: flex;
    flex-direction: column;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
