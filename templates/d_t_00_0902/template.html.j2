<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 148.2mm; inset-block-start: 8.7mm; inline-size: 30.3mm; block-size: 2.3mm; font-size: 6.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 24.7mm; inset-block-start: 53.9mm; inline-size: 48.2mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 0.1mm; inset-block-start: 59.3mm; inline-size: 209.8mm; block-size: 88.3mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 157.1mm; inline-size: 69.6mm; block-size: 57.9mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 216.7mm; inline-size: 69.8mm; block-size: 48.7mm; font-size: 12.6pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 113.3mm; inset-block-start: 243.0mm; inline-size: 57.1mm; block-size: 37.3mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 267.1mm; inline-size: 69.3mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_4 }}</p>
</div></body>
</html>
