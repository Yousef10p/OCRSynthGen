<div class="cell"><div class="image">{{ slot_6 }}</div></div>
<div class="cell"><div class="image">{{ slot_7 }}</div></div>
</div>
<h2>{{ slot_8 }}</h2>
<div class="testimonials">
<div class="testimonial">{{ slot_9 }}</div>
