    display: inline-block;
    margin: 0 20px;
}
nav a {
    text-decoration: none;
    color: #333;
}
h1, h2, p {
    padding: 20px;
}
footer {
    text-align: center;
    padding: 10px;
    background-color: #333;
    color: #fff;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.colored-rectangle {
    display: inline-block;
    width: 50px;
    height: 50px;
    background-color: #f00;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
