<h2 class="box" style="inset-inline-start: 47.3mm; inset-block-start: 56.9mm; inline-size: 28.7mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 65.9mm; inline-size: 90.4mm; block-size: 55.7mm; font-size: 10.0pt">{{ slot_5 }}</p>
