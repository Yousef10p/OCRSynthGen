<h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 35.3mm; inline-size: 19.1mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 56.4mm; inline-size: 97.6mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 130.0mm; inset-block-start: 64.1mm; inline-size: 25.8mm; block-size: 5.5mm; font-size: 7.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 85.2mm; inline-size: 70.1mm; block-size: 37.4mm; font-size: 13.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 85.2mm; inline-size: 73.8mm; block-size: 48.0mm; font-size: 13.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 124.7mm; inline-size: 74.0mm; block-size: 57.1mm; font-size: 13.5pt">{{ slot_5 }}</p>
