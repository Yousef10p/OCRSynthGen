<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 188.9mm; inline-size: 73.8mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 24.9mm; inset-block-start: 239.7mm; inline-size: 50.2mm; block-size: 30.3mm; font-size: 14.3pt"></div>
<div class="box ph" style="inset-inline-start: 77.0mm; inset-block-start: 239.8mm; inline-size: 50.0mm; block-size: 30.5mm; font-size: 14.4pt"></div>
