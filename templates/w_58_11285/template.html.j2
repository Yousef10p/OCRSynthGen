}
.artist img {
        width: 100%;
        height: 100px;
        object-fit: cover;
        margin-bottom: 12px;
}
.artist p {
        text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
