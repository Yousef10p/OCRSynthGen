<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 40.9mm; inset-block-start: 0.9mm; inline-size: 64.6mm; block-size: 10.5mm; font-size: 29.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 11.8mm; inline-size: 32.9mm; block-size: 5.6mm; font-size: 16.0pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 70.4mm; inset-block-start: 13.7mm; inline-size: 70.3mm; block-size: 82.1mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 20.3mm; inline-size: 60.0mm; block-size: 39.3mm; font-size: 12.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 63.3mm; inline-size: 44.0mm; block-size: 4.4mm; font-size: 12.4pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 71.4mm; inline-size: 55.8mm; block-size: 13.1mm; font-size: 9.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 84.8mm; inline-size: 58.3mm; block-size: 13.1mm; font-size: 7.4pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 98.1mm; inline-size: 124.5mm; block-size: 8.8mm; font-size: 6.2pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 107.0mm; inline-size: 131.8mm; block-size: 8.7mm; font-size: 6.2pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 116.0mm; inline-size: 126.2mm; block-size: 8.7mm; font-size: 8.3pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 124.9mm; inline-size: 87.9mm; block-size: 4.4mm; font-size: 12.4pt"><li>{{ slot_9 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 129.5mm; inline-size: 103.9mm; block-size: 4.4mm; font-size: 12.4pt"><li>{{ slot_10 }}</li></ul>
<p class="box" style="inset-inline-start: 40.4mm; inset-block-start: 137.5mm; inline-size: 100.5mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_11 }}</p>
</div></body>
</html>
