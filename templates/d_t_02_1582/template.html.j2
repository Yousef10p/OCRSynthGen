<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 119.8mm; inset-block-start: 47.2mm; inline-size: 64.5mm; block-size: 65.1mm; font-size: 15.4pt"></div>
<h2 class="box" style="inset-inline-start: 14.8mm; inset-block-start: 70.1mm; inline-size: 6.0mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 14.8mm; inset-block-start: 84.2mm; inline-size: 90.8mm; block-size: 9.3mm; font-size: 13.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 14.8mm; inset-block-start: 110.6mm; inline-size: 90.9mm; block-size: 51.5mm; font-size: 14.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 21.8mm; inset-block-start: 169.9mm; inline-size: 38.3mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 21.7mm; inset-block-start: 175.2mm; inline-size: 63.7mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.7mm; inset-block-start: 185.8mm; inline-size: 79.1mm; block-size: 18.6mm; font-size: 10.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 21.8mm; inset-block-start: 212.2mm; inline-size: 68.0mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 21.7mm; inset-block-start: 217.4mm; inline-size: 83.8mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 198.1mm; inset-block-start: 270.2mm; inline-size: 1.4mm; block-size: 2.0mm; font-size: 5.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
