<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 16px;
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-around;
    align-items: center;
    width: 100%;
    background-color: #f8f9fa;
}.logo {
    width: 100px;
    height: 100px;
    background-color: #f00;
}

nav ul {
    display: flex;
    justify-content: space-evenly;
    width: 100%;
    padding: 20px;
    list-style: none;
    font-size: 1.2rem;
}.nav-item a {
    color: #fff;
    text-decoration: none;
}

.nav-item a:hover {
    color: #000;
}

section {
    width: 80%;
    margin: 20px;
    padding: 20px;
    background-color: #f8f9fa;
}

form {
    display: flex;
    flex-direction: column;
    width: 80%;
    margin: 20px auto;
}

form input, form textarea {
    margin: 5px;
    padding: 10px;
    border: none;
    background-color: #f0f0f0;
}

form button {
    padding: 10px;
    background-color: #000;
    color: #fff;
    border: none;
}

footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 20px;
    background-color: #f8f9fa;
}

footer div a {
    color: #000;
    margin: 0 10px;
    text-decoration: none;
}

.footer_copyright {
    color: #000;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
