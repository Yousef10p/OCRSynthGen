  padding: 1em;
  background-color: #ffffff;
  text-align: center;
  max-width: 300px;
}
footer {
  margin-top: 2em;
  padding: 1em;
  background-color: #222;
  color: #fff;
  text-align: center;
}

@media screen and (max-width: 700px) and (min-width: 500px) {
  body {
    color: #666;
    background-color: #444;
  }
  nav a {
    color: #f7f7f7;
  }
  #blog article {
    display: block;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
