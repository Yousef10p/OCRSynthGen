    align-items: center;
    min-height: 100vh;
    background: #f6f6f6;
}
header, footer {
    width: 100%;
    background: #333;
    color: #fff;
}
#logo {
    font-size: 2em;
    text-align: center;
    padding: 1em;
    display: block;
}
nav {
    width: 100%;
    background: #666;
    display: flex;
    justify-content: center;
}
nav a {
    color: #fff;
    margin: 0 1em;
}
header, main, aside {
    padding: 1em;
}
h2 {
    color: #333;
}
p, li {
    color: #666;
}
.portfolio-item {
  width: 100%;
  height: 200px;
  background-color: grey;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
