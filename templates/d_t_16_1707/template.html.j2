<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 17.9mm; inset-block-start: 13.0mm; inline-size: 174.7mm; block-size: 109.0mm; font-size: 19.3pt"></div>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 125.5mm; inline-size: 173.7mm; block-size: 9.9mm; font-size: 9.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 143.0mm; inline-size: 83.2mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 108.9mm; inset-block-start: 143.1mm; inline-size: 44.1mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 108.9mm; inset-block-start: 147.4mm; inline-size: 83.3mm; block-size: 46.7mm; font-size: 12.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 18.4mm; inset-block-start: 156.3mm; inline-size: 23.5mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 160.3mm; inline-size: 83.3mm; block-size: 55.4mm; font-size: 12.1pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 108.9mm; inset-block-start: 203.1mm; inline-size: 17.6mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 108.9mm; inset-block-start: 207.7mm; inline-size: 83.4mm; block-size: 55.4mm; font-size: 12.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 221.0mm; inline-size: 83.3mm; block-size: 42.4mm; font-size: 12.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 18.4mm; inset-block-start: 269.1mm; inline-size: 6.3mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
