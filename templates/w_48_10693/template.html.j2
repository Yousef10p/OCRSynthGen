  background-color: #6699cc;
}

header h1 {
  text-align: center;
  color: #ffffff;
}

header nav ul {
  display: flex;
  justify-content: space-around;
  list-style-type: none;
}

header nav ul li a {
  text-decoration: none;
  color: #ffffff;
}

#menu, #about, #contact {
