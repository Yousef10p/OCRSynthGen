  padding: 1em;
}

#menu .menu-item, #about .about-us, #contact .contact-us {
  background-color: #ffffff;
  padding: 1em;
  border-radius: 1em;
}


header, #menu, #about, #contact {
  background-attachment: fixed;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
