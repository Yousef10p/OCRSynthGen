<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 141.8mm; inline-size: 126.0mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 52.6mm; inset-block-start: 151.0mm; inline-size: 114.5mm; block-size: 24.9mm; font-size: 11.1pt"></div>
