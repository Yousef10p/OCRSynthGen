}


header, footer {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 20px;
}
header nav a, footer a {
    margin-right: 10px;
}


main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 20px;
}
section {
    background-color: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
