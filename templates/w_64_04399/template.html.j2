<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
</div>
<div class="stage">
<h2>{{ slot_5 }}</h2>
<ul>
<li class="performer">{{ slot_6 }}</li>
<li class="performer">{{ slot_7 }}</li>
<li class="performer">{{ slot_8 }}</li>
</ul>
<h2>{{ slot_9 }}</h2>
<table>
<tr>
<th>{{ slot_10 }}</th>
<th>{{ slot_11 }}</th>
</tr>
<tr>
<td>{{ slot_12 }}</td>
<td>{{ slot_13 }}</td>
</tr>
<tr>
<td>{{ slot_14 }}</td>
<td>{{ slot_15 }}</td>
</tr>
<tr>
<td>{{ slot_16 }}</td>
<td>{{ slot_17 }}</td>
</tr>
</table>
</div>
</body>
</html>