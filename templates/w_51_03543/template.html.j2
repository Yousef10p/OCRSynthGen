}

.contact-form input[type=text], .contact-form textarea {
    width: 80%;
    padding: 12px;
    margin: 8px 0;
}

.contact-form button {
    padding: 10px 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
