    text-decoration: none;
    color: #333;
}


nav ul li ul {
    display: none;
    position: absolute;
    background-color: #f1f1f1;
    min-width: 160px;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    z-index: 1;
}

nav ul li:hover ul {
    display: block;
}


.search-container {
    margin: 20px 0;
}

.search-container input[type=text] {
    padding: 6px;
    font-size: 17px;
}


.banner {
    height: 300px;
