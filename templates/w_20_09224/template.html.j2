<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

#hero {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  color: white;
  font-size: 2em;
  background: none no-repeat center center;
  background-size: cover;
}

#navbar {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: 150px;
  padding: 50px;
  background-color: #333;
  color: white;
  font-size: 1em;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

#navbar a {
  color: white;
  text-decoration: none;
}

#navbar a:hover {
  color: #bbb;
}

div[id^="product"] {
  height: 100vh;
  background-color: lightgrey;
  margin-right: 150px;
  padding: 50px;
  text-align: center;
  font-size: 1em;
}

div[id^="service"] {
  height: 100vh;
  background-color: darkgrey;
  margin-right: 150px;
  padding: 50px;
  text-align: center;
  font-size: 1em;
}

body {
  margin: 0;
  font-family: var(--font-body);
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="hero">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<button>{{ slot_2 }}</button>
</div>
<div id="navbar">
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</div>
<div id="product1">{{ slot_9 }}</div>
<div id="product2">{{ slot_10 }}</div>
<div id="product3">{{ slot_11 }}</div>
<div id="service1">{{ slot_12 }}</div>
<div id="service2">{{ slot_13 }}</div>
<div id="service3">{{ slot_14 }}</div>
</body>
</html>