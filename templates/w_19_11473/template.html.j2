</ul>
</nav>
</header>
<section id="slider">
<div class="slide">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</div>
<div class="slide">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="slide">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
</section>
<footer>
<nav>
<ul>
