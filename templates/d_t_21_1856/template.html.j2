<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 82.1mm; inset-block-start: 12.6mm; inline-size: 46.9mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 10.0mm; inset-block-start: 25.2mm; inline-size: 165.5mm; block-size: 12.0mm; font-size: 14.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 43.3mm; inline-size: 53.7mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_2 }}</p>
<footer class="box" style="inset-inline-start: 17.5mm; inset-block-start: 278.5mm; inline-size: 12.3mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_3 }}</footer><footer class="box" style="inset-inline-start: 95.3mm; inset-block-start: 278.5mm; inline-size: 25.6mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 185.7mm; inset-block-start: 278.5mm; inline-size: 5.4mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
