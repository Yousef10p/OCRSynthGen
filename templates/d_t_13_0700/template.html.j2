<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.0mm; inset-block-start: 14.8mm; inline-size: 69.6mm; block-size: 17.1mm; font-size: 20.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 71.9mm; inline-size: 63.8mm; block-size: 7.4mm; font-size: 9.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 18.0mm; inset-block-start: 81.1mm; inline-size: 107.6mm; block-size: 4.7mm; font-size: 13.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 88.9mm; inline-size: 20.2mm; block-size: 3.1mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 93.2mm; inline-size: 31.8mm; block-size: 3.1mm; font-size: 9.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 14.6mm; inset-block-start: 106.2mm; inline-size: 16.0mm; block-size: 15.5mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 106.0mm; inline-size: 91.4mm; block-size: 13.5mm; font-size: 10.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 125.4mm; inline-size: 89.7mm; block-size: 11.6mm; font-size: 9.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 139.2mm; inline-size: 88.7mm; block-size: 11.6mm; font-size: 9.0pt">{{ slot_7 }}</p>
<header class="box" style="inset-inline-start: 201.9mm; inset-block-start: 146.0mm; inline-size: 3.9mm; block-size: 3.6mm; font-size: 10.0pt">{{ slot_8 }}</header><p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 152.9mm; inline-size: 73.3mm; block-size: 3.1mm; font-size: 9.0pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 34.7mm; inset-block-start: 161.6mm; inline-size: 96.8mm; block-size: 79.9mm; font-size: 15.1pt"></div>
</div></body>
</html>
