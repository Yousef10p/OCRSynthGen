}

main {
    display: grid;
    grid-template-areas: 
        "hero hero"
        "about menu"
        "contact blog"
        "instagram instagram";
    grid-gap: 1em;
}

main > div {
    height: 200px;
    background-color: lightgray;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
