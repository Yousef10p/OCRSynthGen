<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 93.9mm; inline-size: 138.4mm; block-size: 14.9mm; font-size: 22.1pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 117.2mm; inline-size: 168.4mm; block-size: 62.7mm; font-size: 22.1pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 35.3mm; inset-block-start: 182.2mm; inline-size: 40.7mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 25.9mm; inset-block-start: 195.7mm; inline-size: 116.5mm; block-size: 24.9mm; font-size: 39.5pt">{{ slot_6 }}</h2>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 229.3mm; inline-size: 165.3mm; block-size: 30.0mm; font-size: 22.1pt"><li>{{ slot_7 }}</li></ul>
