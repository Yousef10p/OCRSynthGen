    padding: 0;
}

ul {
    list-style: none;
    padding: 0;
}

section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 50px;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

.rect {
    width: 200px;
    height: 200px;
    background-color: red;
}

button {
    animation: bounce 2s infinite ease-in-out;
}

@keyframes bounce {
    50% { transform: scale(1.2); }
}

footer {
    background-color: #f9f9f9;
    color: #333;
    padding: 20px;
    text-align: center;
    width: 100%;
    position: absolute;
    bottom: 0;
}

@media (max-width: 1024px) {
    body {
        font-size: 16px;
    }

    .rect {
        width: 100px;
        height: 100px;
    }
}


#schedule {
    background-color: red !important;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
