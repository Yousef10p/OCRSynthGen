<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html {
    font-size: 16px;
    box-sizing: border-box;
}

*, *::before, *::after {
    box-sizing: inherit;
}

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


nav {
    display: flex;
    justify-content: space-between;
    padding: 1em;
    background-color: blue;
    color: white;
}

#logo {
    font-weight: bold;
    font-size: 1.5em;
}

#hamburger {
    display: none;
    font-size: 2em;
    cursor: pointer;
}

aside {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2em;
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    width: 200px;
    padding: 1em;
    background-color: green;
    color: white;
}

section {
    padding: 2em;
    text-align: center;
}

.img-placeholder {
    height: 200px;
    margin: 0 auto;
    background: none no-repeat;
}

footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    padding: 1em;
    text-align: center;
    background-color: orange;
    color: white;
}


@media (max-width: 600px) {
    aside {
        position: absolute;
        height: auto;
        width: 100%;
    }

    #hamburger {
        display: block;
    }

    .show-menu {
        display: flex !important;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
