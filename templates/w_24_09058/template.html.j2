    background: #ddd;
}

.showcase li, .testimonial, .item {
    margin-bottom: 20px;
}

.case-study-graphic, .item > h3 {
    margin-top: 20px;
    height: 200px;
    width: 100%;
    background: #ddd;
}

.testimonial, .item > h3 {
    font-weight: bold;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
