<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 54.0mm; inline-size: 80.1mm; block-size: 28.1mm; font-size: 13.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 105.3mm; inset-block-start: 54.0mm; inline-size: 80.1mm; block-size: 13.1mm; font-size: 12.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 105.3mm; inset-block-start: 74.0mm; inline-size: 80.0mm; block-size: 33.1mm; font-size: 13.4pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 15.5mm; inset-block-start: 89.0mm; inline-size: 52.5mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 93.9mm; inline-size: 85.1mm; block-size: 58.1mm; font-size: 13.7pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 127.0mm; inset-block-start: 121.9mm; inline-size: 50.6mm; block-size: 14.5mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 127.3mm; inset-block-start: 136.5mm; inline-size: 19.9mm; block-size: 6.7mm; font-size: 9.5pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 205.2mm; inset-block-start: 135.5mm; inline-size: 1.5mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_6 }}</header><div class="box ph" style="inset-inline-start: 127.5mm; inset-block-start: 147.8mm; inline-size: 57.4mm; block-size: 9.7mm; font-size: 27.6pt"></div>
<p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 153.9mm; inline-size: 80.0mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 128.0mm; inset-block-start: 159.8mm; inline-size: 21.0mm; block-size: 6.7mm; font-size: 9.5pt">{{ slot_8 }}</p>
</div></body>
</html>
