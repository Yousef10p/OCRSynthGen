<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 165.0mm; inline-size: 15.0mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_3 }}</h2>
<ul class="box" style="inset-inline-start: 19.1mm; inset-block-start: 169.6mm; inline-size: 84.8mm; block-size: 31.7mm; font-size: 12.8pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 110.9mm; inset-block-start: 171.8mm; inline-size: 85.7mm; block-size: 14.1mm; font-size: 10.0pt">{{ slot_5 }}</p>
