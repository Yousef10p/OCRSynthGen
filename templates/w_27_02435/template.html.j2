<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	background-color: #222;
	color: #fff;
	font-family: var(--font-body);
	overflow: hidden;
}

header {
	position: relative;
}

h1 {
	font-size: 2.5em;
	margin: 1em 0;
}

li {
	display: inline;
	margin: 0 1em;
}

.call-to-action {
	position: absolute;
	top: 0;
	left: 0;
}

.call-to-action a {
	display: block;
	background-color: #ff0000;
	color: #fff;
	padding: 1em;
	border-radius: 5px;
	text-decoration: none;
}

.call-to-action a:hover {
	background-color: #000;
}

section {
	margin: 1em 0;
	width: 100%;
	display: flex;
	justify-content: center;
	border-radius: 5px;
	padding: 1em;
}

.products-container {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
}

.product {
	background-color: #fff;
	width: 30%;
	height: 300px;
	margin-bottom: 1em;
}

form {
	display: grid;
	grid-template-areas: 
		'name email'
		'message message'
		'submit submit';
	gap: 1em;
}

input, textarea, button {
	padding: 1em;
}

input[type='text'] {
	grid-area: name;
}

input[type='email'] {
	grid-area: email;
}

textarea {
	grid-area: message;
}

button[type='submit'] {
	grid-area: submit;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
