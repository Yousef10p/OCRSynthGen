<div class="box ph" style="inset-inline-start: 66.5mm; inset-block-start: 94.3mm; inline-size: 123.4mm; block-size: 12.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 106.6mm; inline-size: 164.5mm; block-size: 11.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
