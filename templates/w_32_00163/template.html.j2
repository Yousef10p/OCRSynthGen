<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<section id="hero">
<div class="slideshow">
<div class="slide">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<div class="property-image ph"></div>
</div>
