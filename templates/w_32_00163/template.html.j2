<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}

header, footer {
  background-color: #333;
  color: #fff;
  padding: 10px;
}

nav ul {
  list-style-type: none;
  padding: 0;
  display: flex;
  justify-content: space-around;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}

#hero .slideshow {
  position: relative;
  display: flex;
}

#hero .slide {
  display: none;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 100%;
}

#hero .property-image {
  background-color: #ddd;
  height: 300px;
  width: 100%;
}

#hero #prev, #hero #next {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background-color: #fff;
  border: none;
  font-size: 24px;
  padding: 10px;
}

#hero #prev {
  right: 0;
}

#hero #next {
  left: 0;
}

#search {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20px 0;
}

#search #search-properties {
  margin-bottom: 10px;
  padding: 10px;
  width: 80%;
}

#search #search-button {
  padding: 10px;
  width: 80%;
}

footer {
  margin-top: auto;
  text-align: center;
  padding: 10px;
}

@media (max-width: 600px){
  nav ul {
    flex-direction: column;
  }

  #search #search-properties, #search #search-button {
    width: 100%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
