    align-items: center;
    justify-content: center;
    height: 100vh;
    text-align: center;
}

#search-bar {
    margin-top: 200px;
}

#hero {
    background-color: #f00;
    height: 500px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    background-color: #f8f8f8;
    border-top: 1px solid #ddd;
    padding: 0 20px;
    text-align: center;
}

#links {
    display: flex;
    justify-content: space-around;
    margin-top: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
