<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}
header {
  height: 100vh;
  background: #eee;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  grid-gap: 10px;
  padding: 10px;
}
nav {
  position: fixed;
  top: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20px;
}
nav ul {
  display: flex;
}
nav ul li {
  margin-right: 30px;
}
form input {
  padding: 5px;
}
.hero-image {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100vh;
  background: #666;
}
section.package {
  padding: 10px;
  display: flex;
  flex-direction: column;
}
section.package .image {
  margin-bottom: 10px;
  height: 200px;
  background: #666;
}
section.package p {
  flex: 1;
}
footer {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 100%;
  background: #999;
  padding: 20px;
  text-align: center;
}
.social a {
  margin: 0 10px;
}
section#reviews {
  position: absolute;
  top: 100vh;
  right: 0;
  width: 100%;
  background: #999;
  padding: 20px;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
