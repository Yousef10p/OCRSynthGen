<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #f0f0f0;
}

header {
    background-color: #333;
    padding: 20px;
    color: #fff;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-left: 20px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

.slideshow {
    position: relative;
    width: 100%;
    height: 300px;
}

.slideshow .slide {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: slide 20s infinite;
}

.slideshow .slide:first-child {
    animation-delay: 0s;
    background-color: #f00;    
}

.slideshow .slide:nth-child(2) {
    animation-delay: 10s;
    background-color: #0f0;
}

.slideshow .slide:last-child {
    animation-delay: 20s;
    background-color: #00f;
}

footer {
    background-color: #333;
    padding: 20px;
    color: #fff;
}

footer a {
    color: #fff;
    text-decoration: none;
}

@keyframes slide {
    25% { opacity: 1; } 
    40% { opacity: 0; }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</header>
<main>
<div class="slideshow">
<div class="slide">
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
</div>
<div class="slide">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</div>
<div class="slide">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
</div>
</main>
<footer>
<p>{{ slot_9 }} <a>{{ slot_10 }}</a>{{ slot_11 }} <a>{{ slot_12 }}</a>{{ slot_13 }} <a>{{ slot_14 }}</a>{{ slot_15 }}</p>
</footer>
</body>
</html>