* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: #f8f8f8;
    box-shadow: 0px 2px 5px rgba(0,0,0,0.1);
}

#logo {
    font-size: 2em;
    font-weight: bold;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin: 0 15px;
}

nav ul li a {
    text-decoration: none;
    color: #333;
    font-size: 1.2em;
}

#home h1 {
    font-size: 2em;
    text-align: center;
    margin-bottom: 20px;
}

.law-section {
    display: flex;
    justify-content: space-around;
    margin-bottom: 20px;
}

.law-item {
    background-color: #ddd;
    width: 20%;
    padding: 20px;
    text-align: center;
    border-radius: 5px;
}

footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 2.5rem;
    background-color: #f8f8f8;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0px -2px 5px rgba(0,0,0,0.1);
}

footer p {
    color: #777;
    font-size: 0.8em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
