<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 91.0mm; inline-size: 92.1mm; block-size: 27.4mm; font-size: 11.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 103.2mm; inline-size: 27.6mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 107.2mm; inline-size: 92.1mm; block-size: 120.7mm; font-size: 11.4pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 111.1mm; inset-block-start: 123.5mm; inline-size: 42.9mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_7 }}</h2>
