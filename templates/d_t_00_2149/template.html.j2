<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 2.9mm; inset-block-start: 2.3mm; inline-size: 4.0mm; block-size: 36.0mm; font-size: 40.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 15.2mm; inset-block-start: 154.3mm; inline-size: 61.4mm; block-size: 22.4mm; font-size: 31.8pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 168.8mm; inset-block-start: 173.0mm; inline-size: 36.0mm; block-size: 54.6mm; font-size: 30.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 176.5mm; inline-size: 144.7mm; block-size: 26.9mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 207.2mm; inline-size: 125.6mm; block-size: 38.2mm; font-size: 15.5pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 14.5mm; inset-block-start: 263.3mm; inline-size: 3.2mm; block-size: 6.7mm; font-size: 19.0pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 68.5mm; inset-block-start: 266.1mm; inline-size: 80.6mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_6 }}</footer>
</div></body>
</html>
