    text-align: center;
    padding: 20px;
    margin: 0;
}

.calculator {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px;
    text-align: center;
}

.calculator form {
    display: flex;
    flex-direction: column;
}

.calculator input {
    margin-bottom: 10px;
}

.calculator button {
    margin-top: 20px;
}

.products ul {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
}

.products li {
    border: 1px solid #ddd;
    padding: 10px;
    flex: 0 1 24%;
    box-sizing: border-box;
    margin: 15px 0;
}


.product-img {
    background-color: #ddd;
    height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
