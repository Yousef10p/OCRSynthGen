<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 103.5mm; inline-size: 110.4mm; block-size: 19.0mm; font-size: 13.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 125.2mm; inline-size: 108.8mm; block-size: 47.4mm; font-size: 13.4pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 74.7mm; inset-block-start: 175.7mm; inline-size: 45.0mm; block-size: 45.5mm; font-size: 14.3pt"></div>
