<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 104.3mm; inline-size: 153.2mm; block-size: 10.3mm; font-size: 9.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 119.4mm; inline-size: 155.1mm; block-size: 32.9mm; font-size: 10.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 157.1mm; inline-size: 151.2mm; block-size: 14.0mm; font-size: 9.9pt">{{ slot_6 }}</p>
