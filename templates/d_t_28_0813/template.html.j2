<ul class="box" style="inset-inline-start: 10.0mm; inset-block-start: 72.5mm; inline-size: 191.7mm; block-size: 12.8mm; font-size: 13.0pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 92.0mm; inline-size: 36.8mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 98.6mm; inline-size: 194.7mm; block-size: 9.6mm; font-size: 13.0pt">{{ slot_6 }}</p>
