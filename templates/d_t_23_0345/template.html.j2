<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 9.0mm; inset-block-start: 7.9mm; inline-size: 33.2mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 9.0mm; inset-block-start: 16.0mm; inline-size: 39.0mm; block-size: 4.5mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<ul class="box" style="inset-inline-start: 9.0mm; inset-block-start: 22.0mm; inline-size: 124.1mm; block-size: 23.2mm; font-size: 9.8pt"><li>{{ slot_2 }}</li></ul>
<h2 class="box" style="inset-inline-start: 9.0mm; inset-block-start: 50.1mm; inline-size: 38.8mm; block-size: 4.5mm; font-size: 10.0pt">{{ slot_3 }}</h2>
<div class="box ph" style="inset-inline-start: 8.6mm; inset-block-start: 57.0mm; inline-size: 10.9mm; block-size: 9.5mm; font-size: 13.5pt"></div>
<ul class="box" style="inset-inline-start: 9.0mm; inset-block-start: 68.6mm; inline-size: 123.0mm; block-size: 8.9mm; font-size: 9.8pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 9.0mm; inset-block-start: 78.2mm; inline-size: 121.5mm; block-size: 8.9mm; font-size: 9.8pt"><li>{{ slot_5 }}</li></ul>
<h2 class="box" style="inset-inline-start: 9.0mm; inset-block-start: 92.0mm; inline-size: 34.3mm; block-size: 4.5mm; font-size: 10.0pt">{{ slot_6 }}</h2>
<ul class="box" style="inset-inline-start: 9.0mm; inset-block-start: 98.0mm; inline-size: 122.6mm; block-size: 13.7mm; font-size: 9.8pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 9.0mm; inset-block-start: 204.9mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 9.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
