body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f8f9fa;
    padding: 20px;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

nav ul {
    display: flex;
