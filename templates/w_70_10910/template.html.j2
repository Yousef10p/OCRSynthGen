  padding: 10px;
  background-color: #007BFF;
  color: white;
  text-align: center;
  text-decoration: none;
  border-radius: 5px;
}

form {
  margin: 0 auto;
  width: 200px;
}

form input, form textarea {
  display: block;
  width: 100%;
  margin-bottom: 10px;
}

footer {
  background-color: #f8f8f8;
  padding: 10px 0;
  text-align: center;
}

footer a {
  margin: 0 10px;
  text-decoration: none;
  color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
