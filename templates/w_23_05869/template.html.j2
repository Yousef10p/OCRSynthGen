}

nav ul li {
    display: inline;
    margin-left: 10px;
}

nav ul li a {
    text-decoration: none;
    color: #333;
}

nav ul li ul {
    display: none;
    position: absolute;
    background-color: #f8f8f8;
    padding: 10px;
}

nav ul li:hover ul {
    display: block;
}

section p {
    text-align: center;
    margin-top: 50px;
}

.card {
    width: 30%;
    margin: auto;
    margin-bottom: 20px;
    border: 1px solid #ccc;
}

.card-image {
    width: 100%;
    height: 200px;
    background-color: #ccc;
}

.card-title, .card-text {
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
