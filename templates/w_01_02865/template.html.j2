}

#menu, #ambiance {
    display: flex;
    justify-content: space-around;
    padding: 20px 0;
}

#starters, #mains, #desserts {
    text-align: center;
}

#starters img, #mains img, #desserts img, #ambiance img {
    height: 200px;
    width: 200px;
    background-color: #333;
}

#book form {
    display: flex;
    flex-direction: column;
    max-width: 500px;
    margin: 0 auto;
}

#book form label {
    margin-bottom: 10px;
}

#book form input, #book form textarea {
    padding: 10px;
    margin-bottom: 20px;
}

#book form button {
    padding: 10px 20px;
    background-color: #f44336;
    color: #fff;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
