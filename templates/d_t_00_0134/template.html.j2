<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 8.5mm; inset-block-start: 13.8mm; inline-size: 65.3mm; block-size: 7.5mm; font-size: 21.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 50.1mm; inset-block-start: 40.4mm; inline-size: 126.4mm; block-size: 28.9mm; font-size: 16.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 70.8mm; inset-block-start: 78.6mm; inline-size: 54.6mm; block-size: 31.7mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 133.3mm; inset-block-start: 78.9mm; inline-size: 55.8mm; block-size: 88.5mm; font-size: 11.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 70.8mm; inset-block-start: 115.1mm; inline-size: 57.5mm; block-size: 19.6mm; font-size: 11.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 70.8mm; inset-block-start: 139.4mm; inline-size: 56.0mm; block-size: 23.6mm; font-size: 11.2pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 8.5mm; inset-block-start: 178.7mm; inline-size: 78.3mm; block-size: 52.3mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 8.8mm; inset-block-start: 236.7mm; inline-size: 77.6mm; block-size: 21.8mm; font-size: 10.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 6.9mm; inset-block-start: 270.9mm; inline-size: 1.6mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
