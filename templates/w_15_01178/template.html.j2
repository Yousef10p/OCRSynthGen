div[id^='service'] {
    margin-top: 2em;
    height: 200px;
    width: 200px;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
