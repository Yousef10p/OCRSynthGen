}
#cta {
    display: block;
    margin-top: 2em;
    padding: 1em 2em;
    border: none;
    background-color: blue;
    color: white;
    cursor: pointer;
    text-decoration: none;
}
#cta:hover {
    background-color: darkblue;
}
nav {
    position: absolute;
