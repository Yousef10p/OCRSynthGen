<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 14.5mm; inset-block-start: 14.0mm; inline-size: 42.4mm; block-size: 7.5mm; font-size: 21.4pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 22.5mm; inline-size: 54.8mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 14.5mm; inset-block-start: 40.0mm; inline-size: 70.8mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 14.5mm; inset-block-start: 44.5mm; inline-size: 86.4mm; block-size: 42.3mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 14.5mm; inset-block-start: 90.2mm; inline-size: 83.9mm; block-size: 11.7mm; font-size: 11.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 14.5mm; inset-block-start: 105.3mm; inline-size: 83.7mm; block-size: 29.1mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 14.5mm; inset-block-start: 137.9mm; inline-size: 86.0mm; block-size: 33.5mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 14.5mm; inset-block-start: 174.9mm; inline-size: 76.5mm; block-size: 16.0mm; font-size: 11.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 14.5mm; inset-block-start: 194.4mm; inline-size: 82.3mm; block-size: 20.4mm; font-size: 11.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 5.4mm; inset-block-start: 288.0mm; inline-size: 49.6mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
