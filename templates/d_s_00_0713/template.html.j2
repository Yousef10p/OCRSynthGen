<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 11.6mm; inline-size: 173.0mm; block-size: 8.6mm; font-size: 12.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 32.8mm; inline-size: 171.2mm; block-size: 31.6mm; font-size: 11.2pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 24.2mm; inset-block-start: 71.1mm; inline-size: 12.2mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 79.1mm; inline-size: 168.8mm; block-size: 43.8mm; font-size: 11.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 127.8mm; inline-size: 168.2mm; block-size: 27.5mm; font-size: 11.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 160.3mm; inline-size: 171.6mm; block-size: 43.8mm; font-size: 11.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 208.9mm; inline-size: 171.2mm; block-size: 51.9mm; font-size: 11.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 162.3mm; inset-block-start: 267.1mm; inline-size: 40.3mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
