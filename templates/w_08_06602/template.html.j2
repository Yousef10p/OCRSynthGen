  background-color: gray;
}

form {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

form label,
form button,
form select {
  margin: 10px 0;
}

footer {
  background: linear-gradient(to left, #92FE9D, #00C9FF);
  color: white;
  text-align: center;
  padding: 20px;
  position: fixed;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
