}

iframe, embed {
    width: 100%;
    height: 300px;
    background-color: #000; 
}

form {
    display: flex;
    flex-direction: column;
}

input, textarea {
    margin-bottom: 10px;
    padding: 10px;
}

button[type="submit"] {
    background-color: #007BFF;
    color: #fff;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    align-self: flex-end;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
