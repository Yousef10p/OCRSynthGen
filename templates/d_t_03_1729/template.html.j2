<p class="box" style="inset-inline-start: 18.9mm; inset-block-start: 93.1mm; inline-size: 88.5mm; block-size: 87.6mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 114.1mm; inset-block-start: 105.8mm; inline-size: 88.3mm; block-size: 41.0mm; font-size: 11.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 114.1mm; inset-block-start: 148.2mm; inline-size: 88.8mm; block-size: 70.7mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.9mm; inset-block-start: 182.0mm; inline-size: 88.6mm; block-size: 41.0mm; font-size: 11.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 114.1mm; inset-block-start: 220.1mm; inline-size: 87.3mm; block-size: 36.8mm; font-size: 11.6pt">{{ slot_7 }}</p>
