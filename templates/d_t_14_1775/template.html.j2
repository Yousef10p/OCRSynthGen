<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 163.9mm; inset-block-start: 0.4mm; inline-size: 45.8mm; block-size: 22.5mm; font-size: 15.9pt"></div>
<div class="box ph" style="inset-inline-start: 13.0mm; inset-block-start: 8.6mm; inline-size: 31.2mm; block-size: 14.6mm; font-size: 13.8pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 30.1mm; inline-size: 161.2mm; block-size: 8.6mm; font-size: 10.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 43.6mm; inline-size: 161.2mm; block-size: 8.5mm; font-size: 10.0pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 45.0mm; inset-block-start: 56.5mm; inline-size: 122.9mm; block-size: 4.3mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 45.0mm; inset-block-start: 65.1mm; inline-size: 103.7mm; block-size: 4.3mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 45.0mm; inset-block-start: 73.6mm; inline-size: 79.5mm; block-size: 4.3mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 45.0mm; inset-block-start: 82.2mm; inline-size: 124.6mm; block-size: 4.3mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
<footer class="box" style="inset-inline-start: 194.2mm; inset-block-start: 285.9mm; inline-size: 4.4mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
