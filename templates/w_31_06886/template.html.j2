<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

.wrapper {
  display: flex;
  justify-content: space-between;
}

.left-column {
  width: 20%;
  background-color: #f0f0f0;
  padding: 20px;
}

.center-column {
  width: 75%;
  display: grid;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.img-placeholder {
  width: 100%;
  height: 300px;
  background-color: #ddd;
}

.review {
  margin-top: 20px;
}

form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 10px;
  margin-top: 20px;
}

input[type="submit"] {
  grid-column: 1 / span 2;
  background-color: #0095ff;
  color: #fff;
  border: none;
  padding: 10px;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="wrapper">
<div class="left-column">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<h2>{{ slot_2 }}</h2>
<ul>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
</div>
<div class="center-column">
<div class="img-placeholder ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="review">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
</div>
<div class="reservation">
<h2>{{ slot_14 }}</h2>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_15 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_16 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_17 }}</span>
<span class="">{{ slot_18 }}</span>
</form>
</div>
</div>
</div>
</body>
</html>