<p>{{ slot_6 }}</p>
<h2 id="hours">{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="right-column">
<h2>{{ slot_9 }}</h2>
<div class="image1 ph"></div>
<div class="image2 ph"></div>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
</div>
<div class="footer">
<a>{{ slot_12 }}</a>
