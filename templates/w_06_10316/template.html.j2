<div class="service-img">{{ slot_9 }}</div>
</div>
<div>
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
<div class="service-img">{{ slot_12 }}</div>
</div>
<div>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
<div class="service-img">{{ slot_15 }}</div>
</div>
</div>
</section>
<button>{{ slot_16 }}</button>
</body>
</html>