}

.item, .promotion {
  background: #add8e6;
  flex: 1 0 30%;
  margin: 1%;
  text-align: center;
  line-height: 100px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
