<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 75.0mm; inline-size: 24.9mm; block-size: 103.9mm; font-size: 14.7pt"></div>
<h2 class="box" style="inset-inline-start: 30.9mm; inset-block-start: 80.9mm; inline-size: 23.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 123.5mm; inset-block-start: 80.9mm; inline-size: 40.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 30.9mm; inset-block-start: 91.7mm; inline-size: 64.8mm; block-size: 11.1mm; font-size: 15.7pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 123.5mm; inset-block-start: 91.5mm; inline-size: 54.0mm; block-size: 10.9mm; font-size: 15.4pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 30.9mm; inset-block-start: 107.8mm; inline-size: 71.7mm; block-size: 27.0mm; font-size: 15.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 123.5mm; inset-block-start: 107.8mm; inline-size: 59.2mm; block-size: 21.1mm; font-size: 15.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 123.5mm; inset-block-start: 132.5mm; inline-size: 80.4mm; block-size: 38.6mm; font-size: 15.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 30.9mm; inset-block-start: 138.3mm; inline-size: 70.5mm; block-size: 21.1mm; font-size: 15.0pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 29.9mm; inset-block-start: 177.2mm; inline-size: 141.3mm; block-size: 97.4mm; font-size: 34.5pt"></div>
<footer class="box" style="inset-inline-start: 128.3mm; inset-block-start: 279.6mm; inline-size: 69.6mm; block-size: 7.2mm; font-size: 20.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
