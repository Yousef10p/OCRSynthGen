<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body, html {
    height: 100vh;
    font-family: var(--font-body);
}

header {
    background: lightgray;
    height: 100px;
    align-items: center;
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
}

h1 {
    text-align: center;
}

header form {
    display: flex;
}

nav {
    float: left;
    position: fixed;
    left: 20px;
    top: 100px;
}

li {
    float: right;
}

li.dropdown a {
    display: block;
    color: black;
    text-decoration: none;
    padding: 10px 15px;
}

.dropdown-content {
    display: none;
    min-width: 150px;
    background: lightgray;
}

.dropdown-content a:hover {
    background: dimgray;
    color: white;
}

li:hover .dropdown-content {
    display: block;
}

main {
    margin: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</form>
</header>
<nav>
<ul>
<li class="dropdown">
<a>{{ slot_2 }}</a>
<div class="dropdown-content">
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
</div>
</li>
<li class="dropdown">
<a>{{ slot_6 }}</a>
<div class="dropdown-content">
<a>{{ slot_7 }}</a>
<a>{{ slot_8 }}</a>
<a>{{ slot_9 }}</a>
</div>
</li>
<li class="dropdown">
<a>{{ slot_10 }}</a>
<div class="dropdown-content">
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
</div>
</li>
</ul>
</nav>
<main>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }} </p>
</main>
</body>
</html>