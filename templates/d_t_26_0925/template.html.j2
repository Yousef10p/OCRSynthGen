<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 70.2mm; inline-size: 165.4mm; block-size: 20.0mm; font-size: 9.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 94.2mm; inline-size: 164.1mm; block-size: 20.0mm; font-size: 11.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 118.2mm; inline-size: 85.4mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_6 }}</p>
