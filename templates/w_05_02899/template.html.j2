    background-color: #00529B;
    color: #fff;
    padding: 20px;
    margin: 10px;
    box-shadow: -2px 2px 5px rgba(0, 0, 0, 0.3);
}

header {
    flex-basis: 100%;
}

aside {
    flex-basis: 20%;
}

section {
    flex-basis: 60%;
}

h1,
h2,
