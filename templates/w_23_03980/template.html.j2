    padding: 1em;
    margin-bottom: 2em;
}

nav ul {
    list-style: none;
}

nav ul li {
    display: inline;
    margin-left: 1em;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

main {
    width: 90%;
    margin: 0 auto;
}

h1 {
    margin-bottom: 1em;
}

.filter {
    margin-bottom: 1em;
}

.filter label {
    display: block;
