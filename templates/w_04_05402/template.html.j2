<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    background-color: lightblue;
}

.menu {
    background-color: lightgray;
    width: 100%;
    height: 50px;
    line-height: 50px;
}

.menu a {
    text-decoration: none;
    color: black;
    display: inline-block;
    padding: 0 20px;
}

.menu .dropdown-content {
    display: none;
    position: absolute;
    min-width: 160px;
    box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
    z-index: 1;
}

.menu .dropdown-content a {
    color: black;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
}

.menu .dropdown-content a:hover {background-color: #f1f1f1}

.content {
    width: 80%;
    margin: auto;
}

.dropdown:hover .dropdown-content {
    display: block;
}

.image {
    width: 100px;
    height: 100px;
    background-color: lightgreen;
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li class="dropdown">
<a class="dropbtn">{{ slot_2 }}</a>
<div class="dropdown-content">
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
</div>
</li>
</ul>
</nav>
</div>
<div class="content">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="image">{{ slot_8 }}</div>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<div class="image">{{ slot_11 }}</div>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="image">{{ slot_14 }}</div>
</div>
</body>
</html>