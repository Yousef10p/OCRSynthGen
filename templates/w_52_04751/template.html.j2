<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

header {
    background: #f8f8f8; 
    border-bottom: 1px solid #ddd; 
    padding: 20px; 
    position: relative;
}

nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
}

nav ul li {
    display: inline-block;
    margin-left: 10px; 
    position: relative;
}

nav ul li a {
    color: #333; 
    text-decoration: none;
    display: block;
}


nav ul li.dropdown { 
    position: relative;
    padding-left: 20px; 
}

nav ul li.dropdown div.dropdown-content {
    display: none; 
    position: absolute; 
    background-color: #f9f9f9;
    min-width: 160px; 
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    padding: 12px 16px;
    z-index: 1;
}

nav ul li.dropdown div.dropdown-content a {
    color: black;
    padding: 12px 16px; 
    text-decoration: none; 
    display: block; 
    text-align: right;
}

nav ul li.dropdown div.dropdown-content a:hover {background-color: #f1f1f1}

.col-1, .col-2, .col-3 {
    float: right; 
    width: 33.33%; 
    padding: 10px;
    height: 400px; 
}

img {
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
