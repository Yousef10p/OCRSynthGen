<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 36.3mm; inset-block-start: 32.9mm; inline-size: 62.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 169.3mm; inset-block-start: 32.9mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 49.8mm; inset-block-start: 45.5mm; inline-size: 110.3mm; block-size: 63.4mm; font-size: 6.1pt"></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 114.0mm; inline-size: 137.1mm; block-size: 19.5mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 146.2mm; inline-size: 136.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 91.0mm; inset-block-start: 158.7mm; inline-size: 82.5mm; block-size: 9.9mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 177.0mm; inline-size: 94.8mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 87.9mm; inset-block-start: 192.4mm; inline-size: 85.6mm; block-size: 7.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 207.8mm; inline-size: 137.1mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 96.6mm; inset-block-start: 236.8mm; inline-size: 76.9mm; block-size: 13.1mm; font-size: 12.0pt"></div>
</div></body>
</html>
