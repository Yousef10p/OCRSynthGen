<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  font-family: var(--font-body);
  font-size: 16px;
}

#header {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 50px;
  background-color: lightgrey;
}

#header ul {
  display: flex;
  justify-content: space-around;
}

#header li {
  list-style-type: none;
}

.product {
  margin: 100px auto;
  width: 60%;
  border: 1px solid black;
  padding: 10px;
  text-align: center;
}

#footer {
  position: absolute;
  bottom: 0;
  right: 0;
  left: 0;
  height: 75px;
  text-align: center;
  background-color: lightgrey;
}

#footer div {
  margin: 0 auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body> 

<div id="header">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>


<div class="product" id="product1">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<div class="ph"></div>
</div>

<div class="product" id="product2">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div class="ph"></div>
</div>

<div class="product" id="product3">
<h1>{{ slot_8 }}</h1>
<p>{{ slot_9 }}</p>
<div class="ph"></div>
</div>

<div class="product" id="product4">
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
<div class="ph"></div>
</div>

<div id="footer">
<div class="ph"></div>
<address>
{{ slot_12 }} <br> {{ slot_13 }} <br> {{ slot_14 }}
</address>
</div>
</body>
</html>