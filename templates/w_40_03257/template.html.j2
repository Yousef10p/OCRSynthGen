    margin-left: 10px;
  }
  
  .product-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }
  
  .product-card {
    display: flex;
    justify-content: center;
    align-items: center;
    border: 1px solid #CCC;
    height: 200px;
  }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
