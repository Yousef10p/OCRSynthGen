<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 24.3mm; inline-size: 55.5mm; block-size: 237.3mm; font-size: 14.9pt"></div>
<div class="box ph" style="inset-inline-start: 133.6mm; inset-block-start: 34.3mm; inline-size: 59.0mm; block-size: 86.2mm; font-size: 15.3pt"></div>
<h2 class="box" style="inset-inline-start: 70.1mm; inset-block-start: 36.2mm; inline-size: 44.6mm; block-size: 7.7mm; font-size: 10.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 70.1mm; inset-block-start: 45.9mm; inline-size: 58.3mm; block-size: 32.1mm; font-size: 10.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 70.1mm; inset-block-start: 81.9mm; inline-size: 53.2mm; block-size: 35.7mm; font-size: 10.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 70.1mm; inset-block-start: 121.4mm; inline-size: 55.8mm; block-size: 10.5mm; font-size: 9.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 133.7mm; inset-block-start: 122.9mm; inline-size: 56.6mm; block-size: 9.2mm; font-size: 8.7pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 70.2mm; inset-block-start: 136.5mm; inline-size: 122.0mm; block-size: 117.0mm; font-size: 11.8pt"></div>
<footer class="box" style="inset-inline-start: 163.5mm; inset-block-start: 263.4mm; inline-size: 37.0mm; block-size: 2.5mm; font-size: 7.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
