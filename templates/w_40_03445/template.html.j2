    font-size: 2em;
    margin: 0;
}

.menu ul {
    list-style: none;
    padding: 0;
    text-align: center;
}

.menu li {
    display: inline;
    margin: 0 10px;
}

.menu a {
    text-decoration: none;
    color: #333;
}

.menu ul ul {
    display: none;
    position: absolute;
    background-color: #f8f8f8;
    padding: 10px;
}

.menu li:hover ul {
    display: block;
}

.image-placeholder {
    width: 200px;
    height: 200px;
    background-color: #ccc;
    margin: 20px auto;
    text-align: center;
    line-height: 200px;
    color: #fff;
}

.footer {
    background-color: #333;
