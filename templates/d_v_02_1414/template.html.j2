<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 28.9mm; inline-size: 160.3mm; block-size: 11.3mm; font-size: 11.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 52.2mm; inline-size: 160.5mm; block-size: 34.5mm; font-size: 11.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 99.0mm; inline-size: 132.6mm; block-size: 3.3mm; font-size: 10.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 114.6mm; inline-size: 160.1mm; block-size: 11.0mm; font-size: 9.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 137.7mm; inline-size: 60.6mm; block-size: 3.3mm; font-size: 10.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.3mm; inset-block-start: 153.5mm; inline-size: 55.5mm; block-size: 3.0mm; font-size: 9.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 168.9mm; inline-size: 98.2mm; block-size: 3.1mm; font-size: 9.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 184.1mm; inline-size: 160.6mm; block-size: 34.6mm; font-size: 11.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 230.6mm; inline-size: 160.7mm; block-size: 26.9mm; font-size: 11.4pt">{{ slot_8 }}</p>
</div></body>
</html>
