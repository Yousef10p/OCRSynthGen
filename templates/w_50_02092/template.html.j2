<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

header {
    background-color: #343a40;
    color: #fff;
    padding: 10px 0;
    position: fixed;
    width: 100%;
}

.logo {
    height: 50px;
    width: 50px;
    background-color: #6c757d;
    display: inline-block;
    margin: 10px;
}

nav ul {
    float: left;
    margin-left: 20px;
}

nav ul li {
    display: inline-block;
    line-height: 80px;
    margin: 0 5px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    padding: 10px;
}

section {
    margin-top: 120px;
    padding: 20px;
}

.course, .instructor, .testimonial {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.course div, .instructor div, .testimonial div {
    height: 100px;
    width: 100px;
    margin: 10px;
}

.course div {
    background-color: #007bff;
}

.instructor div {
    background-color: #28a745;
}

.testimonial div {
    background-color: #ffc107;
}

@media (max-width: 768px) {
    nav ul li a {
        display: block;
        text-align: center;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<section class="courses">
<h2>{{ slot_6 }}</h2>
<div class="course"><div></div><p>{{ slot_7 }}</p></div>
<div class="course"><div></div><p>{{ slot_8 }}</p></div>
<div class="course"><div></div><p>{{ slot_9 }}</p></div>
</section>
<section class="instructors">
<h2>{{ slot_10 }}</h2>
<div class="instructor"><div></div><p>{{ slot_11 }}</p></div>
<div class="instructor"><div></div><p>{{ slot_12 }}</p></div>
</section>
<section class="testimonials">
<h2>{{ slot_13 }}</h2>
<div class="testimonial"><p>{{ slot_14 }}</p><p>{{ slot_15 }}</p></div>
<div class="testimonial"><p>{{ slot_16 }}</p><p>{{ slot_17 }}</p></div>
</section>
</body>
</html>