<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 140.5mm; inset-block-start: 2.1mm; inline-size: 69.4mm; block-size: 35.3mm; font-size: 14.3pt"></div>
<div class="box ph" style="inset-inline-start: 14.0mm; inset-block-start: 16.7mm; inline-size: 42.7mm; block-size: 20.9mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 25.3mm; inset-block-start: 56.3mm; inline-size: 159.6mm; block-size: 10.3mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 76.3mm; inline-size: 36.8mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 87.0mm; inline-size: 32.5mm; block-size: 4.3mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 93.4mm; inline-size: 160.5mm; block-size: 55.7mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 151.2mm; inline-size: 160.4mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 175.0mm; inline-size: 55.0mm; block-size: 4.3mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 181.4mm; inline-size: 160.4mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 200.7mm; inline-size: 160.4mm; block-size: 34.3mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 247.6mm; inline-size: 160.2mm; block-size: 10.3mm; font-size: 8.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 257.9mm; inline-size: 160.2mm; block-size: 13.7mm; font-size: 8.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 201.4mm; inset-block-start: 282.3mm; inline-size: 3.2mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
