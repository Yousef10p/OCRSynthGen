<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

#page {
    display: flex;
    width: 100%;
}

#left-column {
    width: 25%;
    background-color: lightgray;
    padding: 10px;
    margin-left: 10px;
}

#right-column {
    width: 75%;
    background-color: darkgray;
    padding: 10px;
}

#footer {
    background-color: black;
    color: white;
    padding: 20px;
    width: 100%;
    position: fixed;
    bottom: 0;
}

.category, .featured-products, .about, .contact, .social {
    margin-top: 0;
    padding: 10px;
}

.category-desc, .about-desc, .contact-info {
    margin-top: 5px;
    padding: 10px;
}

.product {
    list-style-type: none;
    margin-bottom: 10px;
}

.product-image, .product-desc {
    background-color: lightblue;
    width: 100%;
    height: 200px;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="page">

<div id="left-column">
<h1 class="category">{{ slot_0 }}</h1>
<p class="category-desc">{{ slot_1 }}</p>
<ul id="category-list">
<li class="category-item">{{ slot_2 }}</li>
<li class="category-item">{{ slot_3 }}</li>
<li class="category-item">{{ slot_4 }}</li>
<li class="category-item">{{ slot_5 }}</li>
</ul>
</div>

<div id="right-column">
<h1 class="featured-products">{{ slot_6 }}</h1>
<ul id="featured-product-list">
<li class="product">
<h2 class="product-title">{{ slot_7 }}</h2>
<div class="product-image">{{ slot_8 }}</div>
<p class="product-desc">{{ slot_9 }}</p>
</li>
<li class="product">
<h2 class="product-title">{{ slot_10 }}</h2>
<div class="product-image">{{ slot_11 }}</div>
<p class="product-desc">{{ slot_12 }}</p>
</li>
</ul>
</div>
</div>

<div id="footer">
