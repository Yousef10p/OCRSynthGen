<p class="about-desc">{{ slot_14 }}</p>
<h1 class="contact">{{ slot_15 }}</h1>
<p class="contact-info">{{ slot_16 }}</p>
<h1 class="social">{{ slot_17 }}</h1>
<ul id="social-links">
