<ul class="box" style="inset-inline-start: 113.7mm; inset-block-start: 144.5mm; inline-size: 76.1mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 113.7mm; inset-block-start: 153.8mm; inline-size: 77.5mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 113.7mm; inset-block-start: 163.2mm; inline-size: 75.9mm; block-size: 4.0mm; font-size: 11.3pt"><li>{{ slot_5 }}</li></ul>
