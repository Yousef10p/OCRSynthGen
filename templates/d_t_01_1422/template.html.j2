<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 182.0mm; inline-size: 79.7mm; block-size: 46.2mm; font-size: 13.1pt">{{ slot_8 }}</p>
<ul class="box" style="inset-inline-start: 113.7mm; inset-block-start: 186.7mm; inline-size: 73.2mm; block-size: 4.0mm; font-size: 11.3pt"><li>{{ slot_9 }}</li></ul>
