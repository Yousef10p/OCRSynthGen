body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(to left, #7dd2a3, #3c5b86);
    color: white;
}


header {
    width: 100%;
    padding: 20px;
