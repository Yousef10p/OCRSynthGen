.services-content {
    display: flex;
    justify-content: space-around;
}

.services-content .service {
    display: flex;
    flex-direction: column;
    align-items: center;
}


footer {
    width: 100%;
    padding: 20px;
    text-align: center;
    margin-top: 50px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
