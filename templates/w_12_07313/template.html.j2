  height: 400px;
  margin: auto;
}

#slideshow .content {
  position: absolute;
  top: 300px;
  right: 0;
  color: white;
}

main {
  margin: 40px;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 40px;
}

main img, main p {
  width: 100%;
  height: 200px;
}

main h2 {
  width: 100%;
}

main p {
  position: relative;
  top: -70px;  
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
