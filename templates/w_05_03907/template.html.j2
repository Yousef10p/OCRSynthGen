    padding: 10px 0;
    text-align: right;
    font-size: 24px;
}

main {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 10px;
    padding: 10px;
}

main section {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: lightgray;
}

main section div {
