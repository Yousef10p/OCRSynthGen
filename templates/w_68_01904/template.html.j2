<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.sidebar {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 200px;
    background: #f1f1f1;
    padding: 20px;
}

.sidebar ul {
    list-style-type: none;
    padding-right: 0;
}

.sidebar li {
    margin-bottom: 10px;
}

.sidebar a {
    color: #333;
    text-decoration: none;
}

.content {
    margin-right: 220px;
    padding: 20px;
}

.content h1, .content h2 {
    color: #333;
}

.content p {
    color: #666;
}

.image-placeholder {
    width: 100%;
    height: 200px;
    background-color: #999;
    margin: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="sidebar">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="content">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<h2 id="savings">{{ slot_6 }}</h2>
<div class="image-placeholder">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
<h2 id="checking">{{ slot_9 }}</h2>
<div class="image-placeholder">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
<h2 id="loans">{{ slot_12 }}</h2>
<div class="image-placeholder">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
<h2 id="credit-cards">{{ slot_15 }}</h2>
<div class="image-placeholder">{{ slot_16 }}</div>
<p>{{ slot_17 }}</p>
</div>

</body>
</html>