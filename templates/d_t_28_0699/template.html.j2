<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 15.6mm; inline-size: 92.7mm; block-size: 16.1mm; font-size: 13.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 15.6mm; inline-size: 92.7mm; block-size: 16.1mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 34.3mm; inline-size: 92.7mm; block-size: 35.6mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 34.3mm; inline-size: 92.7mm; block-size: 42.1mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 72.5mm; inline-size: 92.7mm; block-size: 29.1mm; font-size: 13.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 144.9mm; inset-block-start: 78.4mm; inline-size: 60.6mm; block-size: 58.8mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 104.3mm; inline-size: 92.7mm; block-size: 29.1mm; font-size: 13.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 136.0mm; inline-size: 29.9mm; block-size: 3.8mm; font-size: 16.0pt">{{ slot_6 }}</h2>
<h2 class="box" style="inset-inline-start: 111.8mm; inset-block-start: 139.7mm; inline-size: 39.2mm; block-size: 3.8mm; font-size: 16.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 142.3mm; inline-size: 92.7mm; block-size: 16.1mm; font-size: 13.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 145.9mm; inline-size: 92.7mm; block-size: 38.9mm; font-size: 13.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 161.0mm; inline-size: 92.7mm; block-size: 19.3mm; font-size: 13.0pt">{{ slot_10 }}</p>
</div></body>
</html>
