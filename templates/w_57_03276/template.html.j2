<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
  margin: 0;
  padding: 0;
}

.fullscreen-video {
  width: 100%;
  height: 100vh;
  object-fit: cover;
  position: fixed;
  top: 0;
  right: 0;
}

.title, .subtitle {
  text-align: center;
  color: white;
}

.video-container {
  position: relative;
}

.testimonials, .schedules, .membership-options {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
}

p {
  width: 80%;
  text-align: justify;
}

table {
  width: 50%;
  border-collapse: collapse;
}

tr:nth-child(even) {background: #EEE}
tr:nth-child(odd) {background: #CCC}

th, td {
  padding: 15px;
  text-align: right;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="video-container">
<div class="fullscreen-video ph" style="inline-size: 100%; block-size: 150px"></div>
<h1 class="title">{{ slot_0 }}</h1>
<p class="subtitle">{{ slot_1 }}</p>
</div>
<div class="testimonials">
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<p>{{ slot_4 }}</p>
</div>
<div class="schedules">
<h2>{{ slot_5 }}</h2>
<table>
<tr>
<th>{{ slot_6 }}</th>
<th>{{ slot_7 }}</th>
<th>{{ slot_8 }}</th>
</tr>
<tr>
<td>{{ slot_9 }}</td>
<td>{{ slot_10 }}</td>
<td>{{ slot_11 }}</td>
</tr>
<tr>
<td>{{ slot_12 }}</td>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
</tr>

</table>
</div>
<div class="membership-options">
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<p>{{ slot_17 }}</p>
<p>{{ slot_18 }}</p>
</div>
</body>
</html>