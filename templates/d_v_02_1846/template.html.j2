<ul class="box" style="inset-inline-start: 25.8mm; inset-block-start: 94.9mm; inline-size: 164.3mm; block-size: 41.4mm; font-size: 16.8pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 144.1mm; inline-size: 164.2mm; block-size: 30.1mm; font-size: 17.1pt"><li>{{ slot_5 }}</li></ul>
