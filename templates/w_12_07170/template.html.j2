}
.logo {
    color: #333;
}
header nav a {
    text-decoration: none;
    color: #333;
    margin-right: 10px;
}
main {
    width: 80%;
    margin: 0 auto;
}
main form {
    display: flex;
}
main form input[type="text"] {
    flex-grow: 1;
}
main .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 10px;
}
main .trending {
    margin-bottom: 20px;
}
main .new-releases {
    margin-top: 20px;
}
footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
