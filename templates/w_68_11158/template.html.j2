}

#pie-chart {
  margin-bottom: 10px;
}

#pie-chart div {
  display: inline-block;
  height: 50px;
  width: 20%;
  background-color: red;
}

#pie-chart div:nth-child(2n+1) {
  background-color: blue;
}

#transactions table {
  width: 100%;
  border-collapse: collapse;
}

#transactions th, #transactions td {
  padding: 10px;
  text-align: right;
  border-bottom: 1px solid #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
