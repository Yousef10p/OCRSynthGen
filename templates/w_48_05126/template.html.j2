<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ul>
<h2>{{ slot_4 }}</h2>
<ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</div>
<div class="content">
<div class="dropdown">
<button class="dropbtn">{{ slot_8 }}</button>
<div class="dropdown-content">
<a>{{ slot_9 }}</a>
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
</div>
</div>
<h1>{{ slot_13 }}</h1>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>