<ul class="box" style="inset-inline-start: 45.1mm; inset-block-start: 108.3mm; inline-size: 48.8mm; block-size: 12.4mm; font-size: 35.1pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 45.1mm; inset-block-start: 124.2mm; inline-size: 44.0mm; block-size: 12.4mm; font-size: 35.1pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 45.1mm; inset-block-start: 141.5mm; inline-size: 61.6mm; block-size: 12.4mm; font-size: 35.1pt"><li>{{ slot_6 }}</li></ul>
