<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.bg-img {
    background-color: #333;
    color: white;
    height: 300px;
    padding: 20px;
}

.heading {
    text-align: center;
    margin: 50px;
}

.heading h1 {
    font-size: 28px;
}

.heading p {
    font-size: 18px;
}

.schedule-section {
    width: 80%;
    margin: auto;
    margin-top: 50px;
    height: 500px;
    overflow: auto;
}

.schedule-section h2 {
    text-align: center;
    font-size: 24px;
}

.schedule-section table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.schedule-section th, .schedule-section td {
    padding: 10px;
    border: 1px solid #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="bg-img">
<div class="heading">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</div>
</div>
<div class="schedule-section">
<h2>{{ slot_2 }}</h2>
<table>
<tr>
<th>{{ slot_3 }}</th>
<th>{{ slot_4 }}</th>
<th>{{ slot_5 }}</th>
</tr>
<tr>
<td>{{ slot_6 }}</td>
<td>{{ slot_7 }}</td>
<td>{{ slot_8 }}</td>
</tr>
<tr>
<td>{{ slot_9 }}</td>
<td>{{ slot_10 }}</td>
<td>{{ slot_11 }}</td>
</tr>
<tr>
<td>{{ slot_12 }}</td>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
</tr>
</table>
</div>
</body>
</html>