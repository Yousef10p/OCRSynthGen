<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 355.6mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 34.2mm; inset-block-start: 96.2mm; inline-size: 23.4mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 30.6mm; inset-block-start: 100.7mm; inline-size: 29.7mm; block-size: 11.8mm; font-size: 11.2pt">{{ slot_1 }}</p>
<h1 class="box" style="inset-inline-start: 255.3mm; inset-block-start: 103.3mm; inline-size: 44.8mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_2 }}</h1>
<p class="box" style="inset-inline-start: 32.6mm; inset-block-start: 114.6mm; inline-size: 25.7mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 305.3mm; inset-block-start: 200.7mm; inline-size: 34.1mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_4 }}</p>
</div></body>
</html>
