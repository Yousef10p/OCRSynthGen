<div class="box ph" style="inset-inline-start: 48.1mm; inset-block-start: 111.1mm; inline-size: 145.3mm; block-size: 59.7mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 171.5mm; inline-size: 81.6mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 180.7mm; inline-size: 82.7mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_4 }}</p>
