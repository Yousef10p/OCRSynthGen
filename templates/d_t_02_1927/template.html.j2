<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.0mm; inset-block-start: 8.5mm; inline-size: 57.0mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 13.3mm; inset-block-start: 25.5mm; inline-size: 2.3mm; block-size: 2.3mm; font-size: 6.5pt"></div>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 25.4mm; inline-size: 52.4mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 92.3mm; inset-block-start: 29.1mm; inline-size: 123.1mm; block-size: 177.0mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 13.2mm; inset-block-start: 39.5mm; inline-size: 1.9mm; block-size: 1.9mm; font-size: 5.3pt"></div>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 38.3mm; inline-size: 41.0mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 46.9mm; inline-size: 48.3mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 13.0mm; inset-block-start: 47.8mm; inline-size: 2.1mm; block-size: 2.4mm; font-size: 6.8pt"></div>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 55.5mm; inline-size: 51.8mm; block-size: 12.1mm; font-size: 11.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 13.1mm; inset-block-start: 56.6mm; inline-size: 1.9mm; block-size: 2.2mm; font-size: 6.2pt"></div>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 221.9mm; inline-size: 182.4mm; block-size: 39.3mm; font-size: 15.9pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 13.0mm; inset-block-start: 268.1mm; inline-size: 1.4mm; block-size: 2.4mm; font-size: 6.8pt">{{ slot_6 }}</footer>
</div></body>
</html>
