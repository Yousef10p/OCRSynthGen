<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
  color: #333;
}

header {
  background-color: #f8f8f8;
  padding: 20px;
  position: relative;
  width: 100%;
}

header nav {
  position: relative;
  display: inline-block;
}

header nav ul {
  list-style-type: none;
  float: left;
}

header nav ul li {
  display: inline;
  margin-right: 20px;
}

header nav ul li.services {
  position: relative;
}

header nav ul li.services ul {
  position: absolute;
  top: 100%;
  right: 0;
  width: 200px;
  display: none;
  background-color: #f8f8f8;
  padding: 20px;
}

header nav ul li.services:hover ul {
  display: block;
}

header nav ul li.services:hover span {
  color: blue;
}

main {
  max-width: 1000px;
  margin: 0 auto;
  padding: 30px 20px;
  text-align: center;
}

main .image {
  width: 100%;
  height: 400px;
  background-color: #333;
  margin-bottom: 20px;
  color: #f8f8f8;
}

footer {
  background-color: #111;
  color: #f8f8f8;
  text-align: center;
  padding: 10px;
  position: absolute;
  width: 100%;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
