<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header, footer {
    background-color: #f8f9fa;
    padding: 20px;
    text-align: center;
}

nav {
    background-color: #e9ecef;
    padding: 10px;
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
}

main {
    display: flex;
    justify-content: space-around;
}

section {
    width: calc(50% - 20px);
}

aside {
    background-color: #e9ecef;
    width: 25%;
    padding: 10px;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
}

.placeholder {
    background-color: #dee2e6;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
</header>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<main>
<section id="soccer">
<h2>{{ slot_4 }}</h2>
<div class="placeholder">{{ slot_5 }}</div>
<p>{{ slot_6 }}</p>
</section>
<section id="basketball">
<h2>{{ slot_7 }}</h2>
<div class="placeholder">{{ slot_8 }}</div>
<p>{{ slot_9 }}</p>
</section>
<section id="baseball">
<h2>{{ slot_10 }}</h2>
<div class="placeholder">{{ slot_11 }}</div>
<p>{{ slot_12 }}</p>
</section>
</main>
<aside>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
<h3>{{ slot_15 }}</h3>
<p>{{ slot_16 }}</p>
</aside>
</body>
</html>