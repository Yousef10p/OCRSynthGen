}
.slide {
    height: 200px;
    background-color: #c5c5c5;
    margin-top: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
