  font-family: var(--font-body);
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.hero {
  background: #f95d5d;
  flex: 1;
}

.content {
  display: flex;
  flex: 8;
}

.left-column, .right-column {
  background: #ff796d;
  flex: 1;
  padding: 20px;
  box-sizing: border-box;
}

h2 {
  color: #fffaf0;
}

ul {
  list-style-type: none;
  padding: 0;
}

form {
  display: flex;
  flex-direction: column;
}

input, textarea, button {
  margin-bottom: 10px;
  padding: 10px;
}

.footer {
  background: #f7352f;
  color: #fffaf0;
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

a {
  color: #fffaf0;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
