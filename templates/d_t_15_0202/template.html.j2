<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.0mm; inset-block-start: 18.4mm; inline-size: 81.0mm; block-size: 12.8mm; font-size: 18.2pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 39.0mm; inline-size: 23.0mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 45.3mm; inline-size: 172.6mm; block-size: 26.3mm; font-size: 14.9pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 28.7mm; inset-block-start: 72.2mm; inline-size: 168.2mm; block-size: 31.5mm; font-size: 12.8pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 28.7mm; inset-block-start: 103.2mm; inline-size: 162.8mm; block-size: 26.3mm; font-size: 12.4pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 132.6mm; inline-size: 177.9mm; block-size: 41.9mm; font-size: 14.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 178.1mm; inline-size: 13.7mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 184.4mm; inline-size: 178.7mm; block-size: 52.2mm; font-size: 14.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 239.6mm; inline-size: 178.6mm; block-size: 16.0mm; font-size: 15.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 19.1mm; inset-block-start: 265.6mm; inline-size: 106.5mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_9 }}</footer><footer class="box" style="inset-inline-start: 192.6mm; inset-block-start: 265.6mm; inline-size: 4.3mm; block-size: 5.7mm; font-size: 16.1pt">{{ slot_10 }}</footer>
</div></body>
</html>
