<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 123.0mm; inline-size: 123.9mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 130.8mm; inline-size: 62.5mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_5 }}</p>
