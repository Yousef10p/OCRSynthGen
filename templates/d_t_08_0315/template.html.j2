<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 49.1mm; inline-size: 78.9mm; block-size: 7.8mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 53.0mm; inset-block-start: 59.1mm; inline-size: 125.3mm; block-size: 84.0mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 146.7mm; inline-size: 141.0mm; block-size: 13.3mm; font-size: 11.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 74.5mm; inset-block-start: 166.0mm; inline-size: 103.8mm; block-size: 16.9mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 184.8mm; inline-size: 140.9mm; block-size: 27.6mm; font-size: 11.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 67.0mm; inset-block-start: 217.0mm; inline-size: 111.4mm; block-size: 16.9mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 237.0mm; inline-size: 134.3mm; block-size: 6.7mm; font-size: 11.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 244.8mm; inline-size: 141.0mm; block-size: 19.6mm; font-size: 11.1pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 292.7mm; inline-size: 3.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_5 }}</footer>
</div></body>
</html>
