<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 74.2mm; inset-block-start: 47.3mm; inline-size: 57.8mm; block-size: 2.8mm; font-size: 8.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 164.0mm; inset-block-start: 47.3mm; inline-size: 61.9mm; block-size: 2.8mm; font-size: 8.1pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 74.2mm; inset-block-start: 53.3mm; inline-size: 78.9mm; block-size: 34.2mm; font-size: 13.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 164.0mm; inset-block-start: 53.3mm; inline-size: 83.5mm; block-size: 29.0mm; font-size: 13.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 164.0mm; inset-block-start: 89.4mm; inline-size: 83.2mm; block-size: 18.7mm; font-size: 13.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 74.2mm; inset-block-start: 94.5mm; inline-size: 81.9mm; block-size: 49.7mm; font-size: 14.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 164.0mm; inset-block-start: 115.2mm; inline-size: 82.8mm; block-size: 23.9mm; font-size: 13.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 281.9mm; inset-block-start: 188.7mm; inline-size: 5.4mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_7 }}</footer>
</div></body>
</html>
