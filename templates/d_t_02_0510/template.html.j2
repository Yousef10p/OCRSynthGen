<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 84.0mm; inset-block-start: 31.6mm; inline-size: 42.1mm; block-size: 3.5mm; font-size: 5.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 26.4mm; inset-block-start: 34.0mm; inline-size: 155.1mm; block-size: 12.4mm; font-size: 11.7pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 21.5mm; inset-block-start: 49.1mm; inline-size: 79.9mm; block-size: 69.5mm; font-size: 13.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 49.1mm; inline-size: 77.2mm; block-size: 27.5mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 78.8mm; inline-size: 79.5mm; block-size: 41.5mm; font-size: 13.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.5mm; inset-block-start: 120.8mm; inline-size: 80.5mm; block-size: 74.1mm; font-size: 13.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 122.6mm; inline-size: 80.7mm; block-size: 69.5mm; font-size: 13.1pt">{{ slot_6 }}</p>
<header class="box" style="inset-inline-start: 5.5mm; inset-block-start: 145.9mm; inline-size: 3.3mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_7 }}</header><p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 194.3mm; inline-size: 79.1mm; block-size: 46.1mm; font-size: 13.1pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 21.5mm; inset-block-start: 197.2mm; inline-size: 80.7mm; block-size: 36.8mm; font-size: 13.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 242.7mm; inline-size: 80.8mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_10 }}</p>
</div></body>
</html>
