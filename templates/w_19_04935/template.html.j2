<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</section>
<section>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
</section>
<section>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
