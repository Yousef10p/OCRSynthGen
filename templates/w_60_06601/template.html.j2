<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  background-color: powderblue;
  font-family: var(--font-body);
}

h1, h2 {
  color: blue;
}

p1, p2, p3, p4, p5 {
  color: black;
}


.navbar {
  list-style-type: none;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background-color: #333;
}

.navbar li {
  float: right;
}

.navbar li a {
  display: block;
  color: white;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}


#leftcolumn {
  width: 60%;
  float: right;
  padding: 0 20px;
}

#leftcolumn h1 {
  text-align: center;
}

#leftcolumn p1, #leftcolumn p2 {
  text-align: justify;
  padding: 0 20px;
}


#rightcolumn {
  width: 40%;
  float: left;
  padding: 0 20px;
}

#rightcolumn h1 {
  text-align: center;
}

#rightcolumn p3, #rightcolumn p4, #rightcolumn p5 {
  text-align: justify;
  padding: 0 20px;
}

.image {
  display: block;
  width: 100%;
  height: 200px;
  background: #333;
  margin: 10px auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

<ul class="navbar">
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>

<div id="leftcolumn">
<h1>{{ slot_4 }}</h1>
<p1>{{ slot_5 }}</p1>
<br>
<h2>{{ slot_6 }}</h2>
<p2>{{ slot_7 }}</p2>
</div>

<div id="rightcolumn">
<h1>{{ slot_8 }}</h1>
<p3>{{ slot_9 }}</p3>
<div class="ph"></div>
<h2>{{ slot_10 }}</h2>
<p4>{{ slot_11 }} <a>{{ slot_12 }}</a>{{ slot_13 }}</p4>
<p5>{{ slot_14 }} <a>{{ slot_15 }}</a> {{ slot_16 }}</p5>
</div>
</body>
</html>