<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 184.6mm; inset-block-start: 42.6mm; inline-size: 79.2mm; block-size: 14.2mm; font-size: 10.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 49.5mm; inset-block-start: 69.0mm; inline-size: 50.6mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 74.2mm; inset-block-start: 81.3mm; inline-size: 172.8mm; block-size: 32.6mm; font-size: 18.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 74.2mm; inset-block-start: 119.4mm; inline-size: 82.1mm; block-size: 44.5mm; font-size: 14.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 164.0mm; inset-block-start: 119.4mm; inline-size: 83.5mm; block-size: 18.7mm; font-size: 13.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 164.0mm; inset-block-start: 145.2mm; inline-size: 83.5mm; block-size: 18.7mm; font-size: 13.3pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 18.6mm; inset-block-start: 185.5mm; inline-size: 34.5mm; block-size: 6.6mm; font-size: 9.3pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 282.7mm; inset-block-start: 188.7mm; inline-size: 3.8mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_7 }}</footer>
</div></body>
</html>
