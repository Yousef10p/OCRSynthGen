<div class="grid">
<div class="image">{{ slot_7 }}</div>
<div class="description"><a>{{ slot_8 }}</a><br>{{ slot_9 }}</div>
<div class="image">{{ slot_10 }}</div>
<div class="description"><a>{{ slot_11 }}</a><br>{{ slot_12 }}</div>
<div class="image">{{ slot_13 }}</div>
<div class="description"><a>{{ slot_14 }}</a><br>{{ slot_15 }}</div>
</div>
</section>
</main>
</body>
</html>