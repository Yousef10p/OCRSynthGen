<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 126.4mm; inset-block-start: 8.7mm; inline-size: 43.7mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 175.0mm; inset-block-start: 8.8mm; inline-size: 3.6mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 50.3mm; inline-size: 109.2mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 0.1mm; inset-block-start: 60.3mm; inline-size: 209.8mm; block-size: 86.9mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 157.1mm; inline-size: 68.2mm; block-size: 25.8mm; font-size: 12.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 184.6mm; inline-size: 69.6mm; block-size: 30.4mm; font-size: 12.3pt">{{ slot_4 }}</p>
</div></body>
</html>
