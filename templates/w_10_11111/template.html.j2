    margin-top: 50px;
}

.main .colored-rectangle {
    width: 300px;
    height: 200px;
    background: #ddd;
    margin: 20px;
}

.footer {
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
