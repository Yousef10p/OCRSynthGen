<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 195.9mm; inset-block-start: 10.4mm; inline-size: 1.8mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 24.2mm; inset-block-start: 24.1mm; inline-size: 172.9mm; block-size: 111.4mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 143.6mm; inline-size: 179.2mm; block-size: 10.5mm; font-size: 9.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 162.6mm; inline-size: 75.6mm; block-size: 6.0mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 111.2mm; inset-block-start: 162.8mm; inline-size: 86.6mm; block-size: 63.9mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 166.7mm; inline-size: 88.5mm; block-size: 55.9mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 111.2mm; inset-block-start: 227.5mm; inline-size: 86.5mm; block-size: 15.5mm; font-size: 10.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 37.6mm; inset-block-start: 231.2mm; inline-size: 48.1mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 240.0mm; inline-size: 86.5mm; block-size: 15.3mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 111.2mm; inset-block-start: 244.1mm; inline-size: 88.4mm; block-size: 11.2mm; font-size: 10.0pt">{{ slot_8 }}</p>
</div></body>
</html>
