<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  line-height: 1.6;
  color: #333;
  background: #f4f4f4;
  margin: 0;
  padding: 0;
}

a {
  color: #333;
  text-decoration: none;
}

header {
  background: #333;
  color: #fff;
  padding: 10px 0;
  position: sticky;
  top: 0;
}

nav ul {
  list-style: none;
  padding: 0;
  display: flex;
  justify-content: space-around;
}

.hero {
  height: calc(100vh - 48px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  background: #00703c;
  color: #fff;
}

.hero h1 {
  font-size: 48px;
  font-weight: bold;
}

.hero .cta {
  background: #f6881f;
  color: #fff;
  padding: 1em 2em;
  border-radius: 5px;
  text-transform: uppercase;
  margin-top: 20px;
}

#services {
  padding: 50px;
}

#services article {
  font-family: var(--font-body);
  padding: 20px;
  border: 1px solid #ddd;
  margin-bottom: 20px;
}

footer {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 10px;
  position: fixed;
  width: 100%;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
