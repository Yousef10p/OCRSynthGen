  top: 0;
  background-color: #333;
  color: #fff;
  padding: 10px 0;
}

header nav ul {
  list-style: none;
  text-align: center;
}

header nav ul li {
  display: inline-block;
  margin: 0 20px;
}

header nav ul li a {
  color: #fff;
  text-decoration: none;
}

section {
  padding: 50px;
}

.image-placeholder {
  background-color: #333;
  width: 100%;
  height: 200px;
}

footer {
  background-color: #333;
  color: #fff;
  padding: 20px 0;
  text-align: center;
}

footer ul {
  list-style: none;
