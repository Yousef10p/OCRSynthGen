  margin: 10px 0;
  padding: 0;
}

footer ul li {
  display: inline-block;
  margin: 0 20px;
}

footer ul li a {
  color: #fff;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
