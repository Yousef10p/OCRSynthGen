<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 11.9mm; inset-block-start: 24.9mm; inline-size: 73.3mm; block-size: 59.4mm; font-size: 15.3pt"></div>
<h2 class="box" style="inset-inline-start: 176.5mm; inset-block-start: 32.9mm; inline-size: 7.8mm; block-size: 13.0mm; font-size: 37.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 48.3mm; inset-block-start: 89.9mm; inline-size: 142.6mm; block-size: 19.4mm; font-size: 27.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 123.0mm; inline-size: 144.7mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 135.0mm; inline-size: 77.2mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 141.0mm; inline-size: 44.1mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 147.0mm; inline-size: 140.1mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 157.2mm; inline-size: 64.7mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 163.2mm; inline-size: 37.0mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 22.9mm; inset-block-start: 266.5mm; inline-size: 67.9mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 187.2mm; inset-block-start: 266.3mm; inline-size: 5.9mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
