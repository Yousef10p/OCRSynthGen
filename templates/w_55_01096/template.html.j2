<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 10px 0;
    background: #666666;
    color: white;
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

nav ul {
    display: flex;
}

nav li {
    margin: 0 10px;
}

nav a {
    text-decoration: none;
    color: white;
}

.slider, .alumni, .testimonials {
    display: flex;
    justify-content: space-around;
    margin: 100px 0;
    padding: 20px;
}

.slider-item, .alumni-item, .testimonial-item {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 30%;
    height: 200px;
    background: #f2f2f2;
    box-shadow: -3px 3px 10px #666666;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<div class="slider">
<div class="slider-item">{{ slot_6 }}</div>
<div class="slider-item">{{ slot_7 }}</div>
<div class="slider-item">{{ slot_8 }}</div>
</div>
<div class="alumni">
<div class="alumni-item">{{ slot_9 }}</div>
<div class="alumni-item">{{ slot_10 }}</div>
<div class="alumni-item">{{ slot_11 }}</div>
</div>
<div class="testimonials">
<div class="testimonial-item">{{ slot_12 }}</div>
<div class="testimonial-item">{{ slot_13 }}</div>
<div class="testimonial-item">{{ slot_14 }}</div>
</div>
</body>
</html>