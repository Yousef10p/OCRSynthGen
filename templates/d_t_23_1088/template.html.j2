<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.2mm; inset-block-start: 17.5mm; inline-size: 26.8mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 152.3mm; inset-block-start: 17.5mm; inline-size: 37.6mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 20.4mm; inset-block-start: 28.7mm; inline-size: 160.8mm; block-size: 20.5mm; font-size: 19.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 52.3mm; inline-size: 160.5mm; block-size: 20.7mm; font-size: 19.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 75.3mm; inline-size: 160.6mm; block-size: 28.7mm; font-size: 20.3pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 61.6mm; inset-block-start: 113.3mm; inline-size: 46.8mm; block-size: 35.4mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 121.5mm; inset-block-start: 139.5mm; inline-size: 11.9mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 157.6mm; inline-size: 160.3mm; block-size: 35.5mm; font-size: 20.1pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 55.2mm; inset-block-start: 203.2mm; inline-size: 79.1mm; block-size: 50.8mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 78.7mm; inset-block-start: 262.4mm; inline-size: 8.8mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_7 }}</p>
</div></body>
</html>
