<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.8; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 13mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.6); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_1 }}</p>
<main style="display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 8mm"><div>
<aside style="border: 2px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><h4>{{ slot_2 }}</h4>
<p style="margin-block: 0.2em">{{ slot_3 }}</p>
<p style="margin-block: 0.2em">{{ slot_4 }}</p></aside><figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 34mm; margin-inline: auto; inline-size: 50%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_5 }}</figcaption></figure><figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 35mm; margin-inline: auto; inline-size: 100%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_6 }}</figcaption></figure><h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1em 0.4em">{{ slot_7 }}</h2>
</div>
<div>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_8 }}</blockquote>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: var(--align); font-size: 1.05em">{{ slot_9 }}</p>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: justify; font-size: 1.05em">{{ slot_10 }}</p>
</div>
<div>
<aside style="border: 2px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><h4>{{ slot_11 }}</h4>
<p style="margin-block: 0.2em">{{ slot_12 }}</p></aside><p style="margin-block: 0 0.4em; text-indent: 0; text-align: start; font-size: 0.95em">{{ slot_13 }}</p>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: start; font-size: 1.05em">{{ slot_14 }}</p>
</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_15 }}</span></footer>
</div></body>
</html>
