    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
}

header a {
    color: #fff;
    text-decoration: none;
}

main {
    padding: 10px;
}

main section {
    margin-bottom: 20px;
}

footer {
    background-color: #000;
    color: #fff;
    text-align: center;
    padding: 20px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.event-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
}
.event {
    width: 200px;
