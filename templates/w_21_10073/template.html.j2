<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    background-color: #f8f8f8;
    padding: 20px;
    text-align: center;
}

.container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 20px;
}

.live-games, .upcoming-events {
    grid-column: 1 / span 1;
}

.news {
    grid-column: 2 / span 1;
}

.live-game, .event, .article {
    background-color: #ddd;
    padding: 20px;
    margin-bottom: 20px;
}

.placeholder, .article {
    background-color: #bbb;
    height: 200px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
</header>
<div class="container">
<section class="live-games">
<h2>{{ slot_1 }}</h2>
<div class="live-game">
<h3>{{ slot_2 }}</h3>
<div class="placeholder">{{ slot_3 }}</div>
</div>
<div class="live-game">
<h3>{{ slot_4 }}</h3>
<div class="placeholder">{{ slot_5 }}</div>
</div>
</section>
<section class="upcoming-events">
<h2>{{ slot_6 }}</h2>
<div class="event">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</div>
<div class="event">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
</div>
</section>
<aside class="news">
<h2>{{ slot_11 }}</h2>
<article>
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
</article>
<article>
<h3>{{ slot_14 }}</h3>
<p>{{ slot_15 }}</p>
</article>
</aside>
</div>
</body>
</html>