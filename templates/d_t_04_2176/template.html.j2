<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.2mm; inline-size: 215.6mm; block-size: 59.4mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 156.1mm; inset-block-start: 65.0mm; inline-size: 51.9mm; block-size: 16.1mm; font-size: 15.2pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 69.4mm; inline-size: 106.3mm; block-size: 23.9mm; font-size: 33.9pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 20.6mm; inset-block-start: 102.6mm; inline-size: 109.4mm; block-size: 13.9mm; font-size: 19.7pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 122.7mm; inline-size: 167.8mm; block-size: 36.0mm; font-size: 14.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 162.9mm; inline-size: 167.1mm; block-size: 25.4mm; font-size: 14.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 66.9mm; inset-block-start: 192.6mm; inline-size: 120.9mm; block-size: 25.4mm; font-size: 14.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 93.8mm; inset-block-start: 233.0mm; inline-size: 75.8mm; block-size: 21.7mm; font-size: 15.4pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 208.5mm; inset-block-start: 269.1mm; inline-size: 1.5mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
