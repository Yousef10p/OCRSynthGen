}

form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 20px;
  align-items: center;
}

label {
  grid-column: 1 / 2;
}

input, textarea {
  grid-column: 2 / 3;
}

@media (min-width: 600px) {
  main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
