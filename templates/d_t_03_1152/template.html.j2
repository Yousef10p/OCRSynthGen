<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 59.4mm; inset-block-start: 25.8mm; inline-size: 93.1mm; block-size: 53.9mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 101.9mm; inline-size: 69.2mm; block-size: 51.2mm; font-size: 16.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 111.7mm; inset-block-start: 101.9mm; inline-size: 68.8mm; block-size: 45.2mm; font-size: 16.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 111.7mm; inset-block-start: 151.8mm; inline-size: 68.6mm; block-size: 69.2mm; font-size: 16.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 157.8mm; inline-size: 69.1mm; block-size: 33.2mm; font-size: 15.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 195.7mm; inline-size: 67.1mm; block-size: 63.2mm; font-size: 16.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 111.7mm; inset-block-start: 225.7mm; inline-size: 13.5mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 111.8mm; inset-block-start: 230.3mm; inline-size: 43.1mm; block-size: 17.4mm; font-size: 16.4pt"></div>
<p class="box" style="inset-inline-start: 111.7mm; inset-block-start: 252.0mm; inline-size: 60.0mm; block-size: 6.9mm; font-size: 9.8pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 10.0mm; inset-block-start: 255.8mm; inline-size: 1.3mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
