<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 355.6mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 11.3mm; inset-block-start: 20.5mm; inline-size: 31.6mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 22.5mm; inset-block-start: 26.9mm; inline-size: 7.9mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 94.5mm; inset-block-start: 27.3mm; inline-size: 26.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 21.1mm; inset-block-start: 37.6mm; inline-size: 173.7mm; block-size: 71.7mm; font-size: 18.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 21.3mm; inset-block-start: 110.5mm; inline-size: 176.1mm; block-size: 144.4mm; font-size: 18.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 256.0mm; inline-size: 173.8mm; block-size: 45.3mm; font-size: 18.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 302.5mm; inline-size: 173.2mm; block-size: 12.1mm; font-size: 17.1pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 105.8mm; inset-block-start: 321.5mm; inline-size: 8.9mm; block-size: 5.0mm; font-size: 14.1pt">{{ slot_7 }}</footer>
</div></body>
</html>
