<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
  color: #333;
  background-color: #f2f2f2;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background-color: #fff;
  box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.1);
}

header img {
  width: 100px;
  height: 50px;
}

nav ul {
  list-style: none;
  padding: 0;
  display: flex;
}

nav ul li {
  margin: 0 10px;
}

aside {
  width: 20%;
  padding: 20px;
  background-color: #f9f9f9;
}

main {
  width: 80%;
  padding: 20px;
}

.flex {
  display: flex;
}

footer {
  text-align: center;
  margin-top: 20px;
  padding: 20px 0;
  background-color: #333;
  color: #f2f2f2;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<div class="flex">
<aside>
<h3>{{ slot_5 }}</h3>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</aside>
<main>
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</main>
</div>
<footer>
<p>{{ slot_12 }}</p>
<nav>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</nav>
</footer>
</body>
</html>