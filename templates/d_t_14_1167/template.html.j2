<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 106.5mm; inline-size: 167.2mm; block-size: 38.4mm; font-size: 13.6pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 146.6mm; inline-size: 159.5mm; block-size: 14.7mm; font-size: 13.9pt"><li>{{ slot_5 }}</li></ul>
