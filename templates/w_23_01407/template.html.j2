<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


.sidebar {
    width: 200px;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #f1f1f1;
    overflow-x: hidden;
    padding: 20px;
}

.sidebar h1 {
    margin-bottom: 20px;
}

.sidebar ul {
    list-style-type: none;
}

.sidebar li {
    margin-bottom: 10px;
}

.sidebar a {
    text-decoration: none;
    color: black;
}


.search-bar {
    margin-top: 10px;
    margin-right: 220px;
    position: fixed;
    top: 0;
    left: 0;
    padding: 20px;
    background-color: #f1f1f1;
}

.search-bar input[type="text"] {
    width: 100%;
    padding: 10px;
}


.content {
    margin-right: 220px;
    margin-top: 20px;
    padding: 20px;
}

.content h1 {
    margin-bottom: 20px;
}

.content a {
    display: block;
    text-decoration: none;
    color: black;
}

.content .recipe {
    height: 200px;
    margin-bottom: 10px;
}

.content p {
    margin-bottom: 30px;
}


.social-links {
    margin-top: 840px;
    background-color: #f1f1f1;
    padding: 20px;
    position: fixed;
    bottom: 0;
    right: 0;
    left: 0;
    text-align: center;
}

.social-links a {
    margin-left: 10px;
    text-decoration: none;
    color: black;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="sidebar">
<h1>{{ slot_0 }}</h1>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="search-bar">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</div>
<div class="content">
<h1>{{ slot_5 }}</h1>
<a>
<div class="recipe" style="background-color: red;">{{ slot_6 }}</div>
<p>{{ slot_7 }}</p>
</a>
<a>
<div class="recipe" style="background-color: orange;">{{ slot_8 }}</div>
<p>{{ slot_9 }}</p>
</a>
<a>
<div class="recipe" style="background-color: yellow;">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
</a>
</div>
<div class="social-links">
<h1>{{ slot_12 }}</h1>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
</div>
</body>
</html>