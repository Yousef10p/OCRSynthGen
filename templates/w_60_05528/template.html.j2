}

header {
  background-color: #000;
  color: #fff;
  text-align: center;
  padding: 20px;
}

ul {
  list-style-type: none;
}

li {
  display: inline;
  margin: 0 10px;
}

main {
  display: flex;
  justify-content: space-around;
}

.product {
  width: 30%;
  margin: 20px;
  padding: 20px;
  border: 1px solid #000;
