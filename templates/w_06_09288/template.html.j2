<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
}

a {
    color: white;
    text-decoration: none;
}

ul {
    list-style-type: none;
    padding: 0;
}

header {
    background-color: red;
    width: 100%;
    padding: 1em 0;
    text-align: center;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

.left-column {
    background-color: red;
    margin-top: 2em;
    padding: 1em;
    min-height: 200px;
    width: 20%;
    float: right;
}

.logo {
    background-color: red;
    padding: 5em;
    margin: 2em 0;
    width: 60%;
    text-align: center;
    font-size: 2em;
    font-weight: bold;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<div class="left-column">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<a>{{ slot_7 }}</a>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<a>{{ slot_10 }}</a>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<a>{{ slot_13 }}</a>
</div>
<div class="logo">
<p>{{ slot_14 }}</p>
</div>
</body>
</html>