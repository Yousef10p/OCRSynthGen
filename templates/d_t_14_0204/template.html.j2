<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 22.0mm; inset-block-start: 18.9mm; inline-size: 67.4mm; block-size: 7.3mm; font-size: 20.8pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 22.0mm; inset-block-start: 31.3mm; inline-size: 49.5mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 41.0mm; inline-size: 168.4mm; block-size: 33.8mm; font-size: 13.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 21.5mm; inset-block-start: 78.8mm; inline-size: 168.9mm; block-size: 57.2mm; font-size: 13.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 139.9mm; inline-size: 168.3mm; block-size: 43.2mm; font-size: 13.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 187.0mm; inline-size: 168.1mm; block-size: 19.7mm; font-size: 14.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 22.0mm; inset-block-start: 212.0mm; inline-size: 51.3mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 221.6mm; inline-size: 167.2mm; block-size: 10.5mm; font-size: 14.9pt">{{ slot_7 }}</p>
