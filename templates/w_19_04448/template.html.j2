    padding: 20px;
    position: fixed;
    width: 100%;
    top: 0;
    right: 0;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

nav ul li a {
    text-decoration: none;
    color: #333;
}

.hero {
    background-color: #eee;
    padding: 100px 20px;
    text-align: center;
}

.hero-text h1, .hero-text p {
    color: #333;
}

button {
    background-color: #333;
    color: #fff;
    padding: 10px 20px;
    border: none;
    cursor: pointer;
}

.product, .blog {
    padding: 80px 20px;
    text-align: center;
}

.product-zoom, .hero-text h1, .product h2, .product p, .blog h2, .blog p {
    background-color: #ccc;
    color: #333;
    margin: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
