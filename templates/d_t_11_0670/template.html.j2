<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 35.6mm; inset-block-start: 25.5mm; inline-size: 144.0mm; block-size: 14.0mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 37.6mm; inset-block-start: 46.5mm; inline-size: 139.8mm; block-size: 4.5mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 79.6mm; inset-block-start: 54.3mm; inline-size: 56.2mm; block-size: 27.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 58.2mm; inline-size: 6.4mm; block-size: 145.0mm; font-size: 20.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 78.0mm; inset-block-start: 85.2mm; inline-size: 59.3mm; block-size: 27.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 99.1mm; inset-block-start: 125.6mm; inline-size: 17.2mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 133.9mm; inline-size: 166.6mm; block-size: 41.9mm; font-size: 10.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 184.9mm; inline-size: 64.1mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 104.5mm; inset-block-start: 267.0mm; inline-size: 2.1mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
