<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 27.0mm; inset-block-start: 16.1mm; inline-size: 175.5mm; block-size: 66.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 85.2mm; inline-size: 49.2mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 26.4mm; inset-block-start: 92.8mm; inline-size: 176.0mm; block-size: 120.0mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 214.9mm; inline-size: 46.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 36.5mm; inset-block-start: 220.8mm; inline-size: 76.7mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 220.8mm; inline-size: 83.2mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 231.5mm; inline-size: 83.2mm; block-size: 26.7mm; font-size: 12.6pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 235.8mm; inline-size: 70.0mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_5 }}</h2>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 241.5mm; inline-size: 23.6mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 246.6mm; inline-size: 86.5mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 196.9mm; inset-block-start: 262.8mm; inline-size: 5.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
