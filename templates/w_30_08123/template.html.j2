<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background: none no-repeat center center fixed; 
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    background-size: cover;
}

#main_menu {
    position: fixed;
    top: 0;
    right: 0;
    width: 100px;
    height: 100%;
    background: #333;
    padding: 20px 0;
    box-sizing: border-box;
}

#main_menu a {
    display: block;
    color: #fff;
    text-decoration: none;
    padding: 10px 15px;
}

#search_bar {
    margin-top: 50px;
    margin-right: 120px;
}

#search_bar input {
    padding: 10px 15px;
    width: 200px;
    border-radius: 20px;
    border: 1px solid #ccc;
}

#popular_dishes ul {
    list-style: none;
}

#popular_dishes ul li {
    margin-bottom: 20px;
    display: grid;
    grid-template-columns: 200px auto;
    align-items: center;
    gap: 20px;
}

#popular_dishes ul li img {
    background: #f00;
}

#footer {
    background: #333;
    color: white;
    padding: 20px;
    position: fixed;
    bottom: 0;
    width: 100%;
    box-sizing: border-box;
}

#footer h2 {
    margin-bottom: 10px;
}

#footer ul {
    list-style: none;
}

#footer li {
    margin-bottom: 10px;
    padding: 10px;
    background: #444;
    border-radius: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="main_menu">
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
