</div>
<div id="search_bar">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</div>
<div id="popular_dishes">
<h2>{{ slot_6 }}</h2>
<ul>
<li><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_7 }}</p></li>
