  font-size: 17px;
  border: none;
}



main {
  max-width: 1200px;
  margin: auto;
  padding: 20px;
}

ul li {
  list-style: none;
}

ul li a img {
  width: 300px;
  height: 200px;
}

footer {
  text-align: center;
  padding: 30px 0;
