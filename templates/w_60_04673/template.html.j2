@media screen and (max-width: 480px) {
  .search-container input[type=text] {
    float: none;
  }
  ul li a img {
    width: 100%;
    height: auto;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
