  color: #fff;
  text-decoration: none;
  border-radius: 5px;
}

footer {
  background: #333;
  color: #fff;
  padding: 10px 0;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
