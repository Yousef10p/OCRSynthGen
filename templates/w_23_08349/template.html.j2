* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: #333;
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 20px;
    background: #fff;
}

nav ul {
    list-style-type: none;
    display: flex;
}

nav ul li {
    margin: 0 10px;
}

header nav a {
    text-decoration: none;
    color: #000;
}

#hero {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), none;
    background-size: cover;
    padding: 50px;
    position: relative;
}

#hero img {
    width: 50%;
    height: auto;  
    position: absolute;
    left: 0;
    bottom: 0;
}

footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    background: #000;
    color: #fff;
}

footer nav ul {
    list-style-type: none;
    display: flex;
}

footer nav ul li {
    margin: 0 10px;
}

footer nav a {
    text-decoration: none;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
