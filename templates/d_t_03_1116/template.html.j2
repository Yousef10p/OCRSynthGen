<ul class="box" style="inset-inline-start: 18.7mm; inset-block-start: 223.7mm; inline-size: 43.7mm; block-size: 3.5mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.7mm; inset-block-start: 229.3mm; inline-size: 47.1mm; block-size: 3.5mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.7mm; inset-block-start: 235.0mm; inline-size: 43.4mm; block-size: 3.5mm; font-size: 10.0pt"><li>{{ slot_6 }}</li></ul>
