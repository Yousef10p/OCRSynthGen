<button>{{ slot_5 }}</button>
</div>

<div id="categories">
<div class="category" id="soccer">{{ slot_6 }}
                <div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_7 }}</p>
</div>
