<p class="box" style="inset-inline-start: 100.8mm; inset-block-start: 130.1mm; inline-size: 14.2mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 46.9mm; inset-block-start: 138.9mm; inline-size: 121.7mm; block-size: 46.3mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 100.8mm; inset-block-start: 191.6mm; inline-size: 14.2mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 47.1mm; inset-block-start: 200.7mm; inline-size: 121.3mm; block-size: 52.3mm; font-size: 14.8pt"></div>
<footer class="box" style="inset-inline-start: 23.9mm; inset-block-start: 264.1mm; inline-size: 26.7mm; block-size: 4.1mm; font-size: 11.8pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 182.4mm; inset-block-start: 264.8mm; inline-size: 10.6mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_6 }}</footer>
</div></body>
</html>
