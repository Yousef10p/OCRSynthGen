<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #333;
    background-color: #f5f5f5;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: #222;
    color: #fff;
}

.menu {
    display: flex;
    list-style-type: none;
}

.menu li {
    margin-left: 20px;
}

.menu a {
    color: #fff;
    text-decoration: none;
}

.search-bar input {
    padding: 10px;
    border-radius: 5px;
    border: none;
}

.dish-image, .location-listing {
    width: 100px;
    height: 100px;
    margin: 20px;
    background-color: #ccc;
}

.dish-image , .location-listing li {
    margin-bottom: 15px;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="search-bar">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</div>
</header>
<div class="signature-dish">
<h2>{{ slot_6 }}</h2>
<div class="dish-image ph"></div>
<p>{{ slot_7 }}</p>
</div>
<div class="location-listing">
<h2>{{ slot_8 }}</h2>
<ul>
<li><p>{{ slot_9 }}</p><p>{{ slot_10 }}</p></li>
<li><p>{{ slot_11 }}</p><p>{{ slot_12 }}</p></li>
<li><p>{{ slot_13 }}</p><p>{{ slot_14 }}</p></li>
</ul>
</div>
</body>
</html>