<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.3mm; inset-block-start: 6.4mm; inline-size: 60.0mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 21.0mm; inline-size: 165.3mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 44.2mm; inline-size: 169.5mm; block-size: 36.3mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 86.1mm; inline-size: 171.3mm; block-size: 27.0mm; font-size: 12.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 17.1mm; inset-block-start: 122.2mm; inline-size: 30.5mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 128.1mm; inline-size: 171.5mm; block-size: 40.9mm; font-size: 12.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 174.6mm; inline-size: 170.9mm; block-size: 31.6mm; font-size: 12.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 211.9mm; inline-size: 167.1mm; block-size: 27.0mm; font-size: 12.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 244.5mm; inline-size: 170.1mm; block-size: 13.0mm; font-size: 12.3pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 10.8mm; inset-block-start: 270.5mm; inline-size: 3.4mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
