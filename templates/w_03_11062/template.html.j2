<div class="case-study">{{ slot_3 }}</div>
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<div class="testimonial">{{ slot_6 }}</div>
<div class="testimonial">{{ slot_7 }}</div>
</div>
<div id="sidebar">
<h2>{{ slot_8 }}</h2>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
</div>
<div id="footer">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>