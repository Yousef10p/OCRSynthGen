<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<main>
<section id="services">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<div class="service-image">{{ slot_7 }}</div>
</section>
<section id="about">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="about-image">{{ slot_10 }}</div>
</section>
<section id="contact">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<div class="contact-image">{{ slot_13 }}</div>
</section>
</main>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>