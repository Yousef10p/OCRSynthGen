<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 48.1mm; inset-block-start: 5.2mm; inline-size: 51.8mm; block-size: 5.6mm; font-size: 15.7pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 124.9mm; inset-block-start: 5.8mm; inline-size: 4.2mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 12.4mm; inline-size: 109.0mm; block-size: 20.0mm; font-size: 11.3pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 88.4mm; inset-block-start: 33.2mm; inline-size: 38.9mm; block-size: 43.2mm; font-size: 10.2pt"><li>{{ slot_3 }}</li></ul>
<div class="box ph" style="inset-inline-start: 18.6mm; inset-block-start: 35.2mm; inline-size: 66.7mm; block-size: 36.6mm; font-size: 40.0pt"></div>
<ul class="box" style="inset-inline-start: 18.8mm; inset-block-start: 76.4mm; inline-size: 107.5mm; block-size: 12.3mm; font-size: 7.0pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 88.8mm; inline-size: 89.2mm; block-size: 11.7mm; font-size: 8.3pt">{{ slot_5 }}</h2>
