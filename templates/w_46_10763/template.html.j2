<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    font-family: var(--font-body);
}

body {
    display: flex;
    flex-direction: column;
    align-items: center;
}

header, nav, h1, h2, h3, p {
    margin: 1rem;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

main {
    width: 80%;
    display: flex;
}

.main-content, aside {
    margin: 1rem;
    padding: 1rem;
}

article {
    width: 100%;
}

aside {
    width: 20%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header style="width:100%; background:red;">{{ slot_0 }}</header>
<nav style="width:100%; background:blue;">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<main style="display:flex;">
<div class="main-content">
<article style="background:green;">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</article>
</div>
<aside style="width:20%; background:yellow;">
<h3>{{ slot_8 }}</h3>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
<h3>{{ slot_12 }}</h3>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</aside>
</main>
</body>
</html>