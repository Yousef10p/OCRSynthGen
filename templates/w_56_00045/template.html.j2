}
header nav ul li a, footer ul li a {
    color: white;
    text-decoration: none;
}
main {
    padding: 20px;
    background: white;
    opacity: 0.8;
    margin: 0;
}
#placeholder {
    width: 100%;
    height: 200px;
    background: gray;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
