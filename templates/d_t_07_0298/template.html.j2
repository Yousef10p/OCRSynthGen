<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 137.4mm; inline-size: 100.7mm; block-size: 33.0mm; font-size: 15.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 172.3mm; inline-size: 100.9mm; block-size: 48.9mm; font-size: 15.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 19.7mm; inset-block-start: 211.5mm; inline-size: 48.5mm; block-size: 52.0mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 233.4mm; inline-size: 98.3mm; block-size: 38.6mm; font-size: 15.6pt">{{ slot_5 }}</p>
