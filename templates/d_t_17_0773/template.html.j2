<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 98.1mm; inline-size: 86.4mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 111.3mm; inline-size: 9.8mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_4 }}</h2>
