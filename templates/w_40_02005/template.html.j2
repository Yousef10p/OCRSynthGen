<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  font-family: var(--font-body);
}

.fullscreen-image {
  background: #1abc9c;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100vh;
}

.navigation {
  background: #34495e;
  color: white;
  display: flex;
  justify-content: space-around;
  padding: 20px 0;
}

.navigation ul {
  display: flex;
  list-style-type: none;
}

.navigation ul li a {
  color: white;
  text-decoration: none;
}

.posts-grid, .reviews-section {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 20px;
  padding: 20px;
}

.post-card, .review-card {
  background: #ecf0f1;
  padding: 20px;
  color: black;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="fullscreen-image">{{ slot_0 }}</div>
<nav class="navigation">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<div class="posts-grid">
<div class="post-card">{{ slot_6 }}</div>
<div class="post-card">{{ slot_7 }}</div>
<div class="post-card">{{ slot_8 }}</div>
<div class="post-card">{{ slot_9 }}</div>
</div>
<div class="reviews-section">
<h2>{{ slot_10 }}</h2>
<div class="review-card">{{ slot_11 }}</div>
<div class="review-card">{{ slot_12 }}</div>
<div class="review-card">{{ slot_13 }}</div>
<div class="review-card">{{ slot_14 }}</div>
</div>
</body>
</html>