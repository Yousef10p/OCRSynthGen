    margin: 0;
    padding: 0;
    color: #333;
}

nav {
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 100vh;
    background-color: #f1f1f1;
    padding: 20px;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    padding: 10px 0;
}

nav ul li a {
    text-decoration: none;
    color: #333;
}

#hero {
    position: relative;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
}

#hero h1, #hero p {
    color: white;
}

#about, #sports, #events, #contact {
    padding: 20px;
}

img, video {
    width: 100px;
    height: 100px;
    background-color: #f1f1f1;
}

form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
