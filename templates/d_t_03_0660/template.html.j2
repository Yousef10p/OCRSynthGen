<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 24.0mm; inset-block-start: 20.8mm; inline-size: 51.8mm; block-size: 95.6mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 81.2mm; inset-block-start: 20.8mm; inline-size: 52.1mm; block-size: 95.5mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 139.3mm; inset-block-start: 20.8mm; inline-size: 52.1mm; block-size: 95.3mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 118.7mm; inline-size: 40.8mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 88.3mm; inset-block-start: 118.7mm; inline-size: 40.5mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 144.3mm; inset-block-start: 118.7mm; inline-size: 44.4mm; block-size: 18.1mm; font-size: 10.3pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 23.9mm; inset-block-start: 150.7mm; inline-size: 50.8mm; block-size: 95.3mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 82.6mm; inset-block-start: 150.6mm; inline-size: 50.5mm; block-size: 95.5mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 139.6mm; inset-block-start: 150.7mm; inline-size: 51.5mm; block-size: 95.5mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 31.2mm; inset-block-start: 248.5mm; inline-size: 38.8mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 86.6mm; inset-block-start: 248.5mm; inline-size: 44.0mm; block-size: 14.6mm; font-size: 10.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 146.2mm; inset-block-start: 248.5mm; inline-size: 40.8mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 11.4mm; inset-block-start: 267.7mm; inline-size: 5.0mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_6 }}</footer>
</div></body>
</html>
