</ul>
</nav>
<main>
<section class="service" id="banking">
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
<button>{{ slot_5 }}</button>
<div class="image">{{ slot_6 }}</div>
</section>
<section class="service" id="investments">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<button>{{ slot_9 }}</button>
<div class="image">{{ slot_10 }}</div>
</section>
<section class="service" id="loans">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<button>{{ slot_13 }}</button>
<div class="image">{{ slot_14 }}</div>
</section>
</main>
</body>
</html>