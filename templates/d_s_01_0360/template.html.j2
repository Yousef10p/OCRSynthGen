<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 10.0mm; inset-block-start: 17.2mm; inline-size: 46.5mm; block-size: 8.1mm; font-size: 9.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 10.0mm; inset-block-start: 28.3mm; inline-size: 89.3mm; block-size: 127.9mm; font-size: 11.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 104.0mm; inset-block-start: 28.2mm; inline-size: 87.5mm; block-size: 64.0mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 104.2mm; inset-block-start: 98.3mm; inline-size: 12.9mm; block-size: 4.6mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 112.6mm; inset-block-start: 102.9mm; inline-size: 51.9mm; block-size: 14.5mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 104.3mm; inset-block-start: 121.5mm; inline-size: 88.3mm; block-size: 14.6mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 104.5mm; inset-block-start: 136.2mm; inline-size: 88.2mm; block-size: 59.2mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 10.7mm; inset-block-start: 156.5mm; inline-size: 87.9mm; block-size: 102.3mm; font-size: 11.8pt">{{ slot_7 }}</p>
