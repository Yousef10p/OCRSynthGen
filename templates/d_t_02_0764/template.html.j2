<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.2mm; inset-block-start: 15.0mm; inline-size: 74.8mm; block-size: 8.2mm; font-size: 11.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 36.9mm; inline-size: 164.6mm; block-size: 7.5mm; font-size: 10.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 48.2mm; inline-size: 170.2mm; block-size: 7.5mm; font-size: 10.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.1mm; inset-block-start: 59.5mm; inline-size: 179.4mm; block-size: 26.3mm; font-size: 12.4pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 3.0mm; inset-block-start: 77.6mm; inline-size: 4.4mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 15.1mm; inset-block-start: 89.5mm; inline-size: 178.7mm; block-size: 16.9mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 15.1mm; inset-block-start: 110.1mm; inline-size: 178.6mm; block-size: 26.3mm; font-size: 12.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 140.1mm; inline-size: 182.0mm; block-size: 30.9mm; font-size: 12.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 174.8mm; inline-size: 181.7mm; block-size: 82.5mm; font-size: 13.0pt">{{ slot_8 }}</p>
<header class="box" style="inset-inline-start: 5.0mm; inset-block-start: 219.1mm; inline-size: 2.2mm; block-size: 45.4mm; font-size: 40.0pt">{{ slot_9 }}</header>
</div></body>
</html>
