<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.9mm; inset-block-start: 22.2mm; inline-size: 123.1mm; block-size: 6.4mm; font-size: 18.2pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 154.5mm; inset-block-start: 22.2mm; inline-size: 21.3mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 15.9mm; inset-block-start: 35.9mm; inline-size: 125.5mm; block-size: 52.7mm; font-size: 21.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 154.5mm; inset-block-start: 36.4mm; inline-size: 30.8mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 154.5mm; inset-block-start: 44.2mm; inline-size: 47.0mm; block-size: 96.4mm; font-size: 21.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 11.4mm; inset-block-start: 92.0mm; inline-size: 127.9mm; block-size: 115.7mm; font-size: 12.6pt"></div>
<h2 class="box" style="inset-inline-start: 154.5mm; inset-block-start: 154.9mm; inline-size: 40.9mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 154.5mm; inset-block-start: 169.1mm; inline-size: 47.3mm; block-size: 57.5mm; font-size: 20.4pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 15.9mm; inset-block-start: 221.0mm; inline-size: 47.3mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 15.9mm; inset-block-start: 225.9mm; inline-size: 123.3mm; block-size: 35.3mm; font-size: 12.5pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 154.5mm; inset-block-start: 252.9mm; inline-size: 37.4mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 190.6mm; inset-block-start: 268.4mm; inline-size: 1.3mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_10 }}</footer>
</div></body>
</html>
