<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 66.8mm; inline-size: 151.4mm; block-size: 3.1mm; font-size: 7.0pt">{{ slot_4 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 83.1mm; inline-size: 6.3mm; block-size: 128.2mm; font-size: 20.0pt">{{ slot_5 }}</header><h2 class="box" style="inset-inline-start: 97.3mm; inset-block-start: 83.9mm; inline-size: 15.4mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 93.4mm; inline-size: 159.2mm; block-size: 25.2mm; font-size: 10.0pt">{{ slot_7 }}</p>
