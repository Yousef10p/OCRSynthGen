<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 149.8mm; inline-size: 159.2mm; block-size: 39.3mm; font-size: 10.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 192.0mm; inline-size: 159.2mm; block-size: 74.4mm; font-size: 10.0pt">{{ slot_11 }}</p>
<p class="box" style="inset-inline-start: 29.3mm; inset-block-start: 269.6mm; inline-size: 132.1mm; block-size: 2.6mm; font-size: 7.0pt">{{ slot_12 }}</p>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 278.9mm; inline-size: 1.8mm; block-size: 4.2mm; font-size: 10.0pt">{{ slot_13 }}</footer>
</div></body>
</html>
