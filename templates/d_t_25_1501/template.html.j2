<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 58.6mm; inset-block-start: 35.7mm; inline-size: 97.6mm; block-size: 3.7mm; font-size: 9.3pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 22.6mm; inset-block-start: 44.6mm; inline-size: 159.4mm; block-size: 20.3mm; font-size: 9.3pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 57.9mm; inset-block-start: 69.6mm; inline-size: 125.3mm; block-size: 12.1mm; font-size: 9.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 58.1mm; inset-block-start: 86.8mm; inline-size: 123.1mm; block-size: 11.4mm; font-size: 8.3pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 22.6mm; inset-block-start: 103.8mm; inline-size: 161.8mm; block-size: 28.7mm; font-size: 9.3pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 58.0mm; inset-block-start: 137.9mm; inline-size: 118.1mm; block-size: 11.3mm; font-size: 9.3pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 22.6mm; inset-block-start: 154.5mm; inline-size: 162.0mm; block-size: 20.3mm; font-size: 9.3pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.6mm; inset-block-start: 179.9mm; inline-size: 161.6mm; block-size: 11.6mm; font-size: 9.3pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.6mm; inset-block-start: 196.9mm; inline-size: 159.5mm; block-size: 20.2mm; font-size: 9.3pt"><li>{{ slot_8 }}</li></ul>
</div></body>
</html>
