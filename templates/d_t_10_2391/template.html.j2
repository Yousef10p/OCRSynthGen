<h2 class="box" style="inset-inline-start: 30.7mm; inset-block-start: 94.7mm; inline-size: 79.4mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 106.8mm; inline-size: 164.5mm; block-size: 78.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 54.6mm; inset-block-start: 189.2mm; inline-size: 135.3mm; block-size: 16.4mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 206.7mm; inline-size: 88.3mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 68.2mm; inset-block-start: 215.3mm; inline-size: 121.7mm; block-size: 16.4mm; font-size: 12.0pt"></div>
