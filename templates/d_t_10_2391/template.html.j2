<div class="box ph" style="inset-inline-start: 40.7mm; inset-block-start: 241.5mm; inline-size: 149.2mm; block-size: 18.9mm; font-size: 8.0pt"></div>
<footer class="box" style="inset-inline-start: 103.5mm; inset-block-start: 266.7mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
