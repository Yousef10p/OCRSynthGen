</ul>
</nav>
<div id="signature_dish_1">
<h2>{{ slot_2 }}</h2>
<div class="ph"></div>
<p>{{ slot_3 }}</p>
</div>
<div id="signature_dish_2">
<h2>{{ slot_4 }}</h2>
<div class="ph"></div>
<p>{{ slot_5 }}</p>
</div>
<footer>
<h3>{{ slot_6 }}</h3>
<p>{{ slot_7 }}</p>
<p>{{ slot_8 }}</p>
<h3>{{ slot_9 }}</h3>
<p><a>{{ slot_10 }}</a> {{ slot_11 }} <a>{{ slot_12 }}</a> {{ slot_13 }} <a>{{ slot_14 }}</a></p>
</footer>
</body>
</html>