<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 138.6mm; inset-block-start: 13.7mm; inline-size: 35.6mm; block-size: 5.0mm; font-size: 14.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 26.6mm; inline-size: 141.4mm; block-size: 18.7mm; font-size: 17.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 46.3mm; inline-size: 142.3mm; block-size: 38.1mm; font-size: 18.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 34.0mm; inset-block-start: 97.0mm; inline-size: 74.9mm; block-size: 7.1mm; font-size: 20.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 111.0mm; inline-size: 142.6mm; block-size: 31.8mm; font-size: 18.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 143.6mm; inline-size: 142.2mm; block-size: 50.7mm; font-size: 18.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 195.0mm; inline-size: 141.8mm; block-size: 31.6mm; font-size: 17.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 227.4mm; inline-size: 142.3mm; block-size: 38.5mm; font-size: 18.2pt">{{ slot_7 }}</p>
</div></body>
</html>
