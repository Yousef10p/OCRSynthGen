<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #f4f4f4;
    color: #333;
}


.header {
    background-color: #0078d7;
    color: white;
    padding: 1.5em;
    text-align: center;
}


.product-catalog {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.product-one, .product-two {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 2em;
}

.img-placeholder {
    width: 200px;
    height: 200px;
    background-color: #ddd;
    margin-bottom: 1em;
}


.reviews {
    margin-top: 2em;
}


.awards {
    margin-top: 2em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
<h2>{{ slot_1 }}</h2>
</div>
<div class="product-catalog">
<h2>{{ slot_2 }}</h2>
<div class="product-one">
<h3>{{ slot_3 }}</h3>
<div class="img-placeholder ph"></div>
<p>{{ slot_4 }}</p>
</div>
<div class="product-two">
<h3>{{ slot_5 }}</h3>
<div class="img-placeholder ph"></div>
<p>{{ slot_6 }}</p>
</div>
</div>
<div class="reviews">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }} <strong>{{ slot_9 }}</strong></p>
<p>{{ slot_10 }} <strong>{{ slot_11 }}</strong></p>
</div>
<div class="awards">
<h2>{{ slot_12 }}</h2>
<ul>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</div>
</body>
</html>