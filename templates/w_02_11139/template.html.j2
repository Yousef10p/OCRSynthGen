nav ul li {
    display: inline;
    position: relative;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
    padding: 10px 20px;
    display: inline-block;
}

nav ul li a:hover {
    background-color: #456;
}

nav ul li .dropdown-content {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 160px;
    padding: 12px 16px;
    z-index: 1;
}

nav ul li .dropdown-content a:hover {
    background-color: #f1f1f1;
}


#travel-details, #destinations, #activities, #accommodations {
    padding: 20px;
}

#travel-details {
