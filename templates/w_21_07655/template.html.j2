	padding: 10px 0;
}

main {
	display: flex;
	justify-content: space-around;
	text-align: center;
}

footer {
	background-color: #BF5B04;
	color: #E9E7C7;
	text-align: center;
	padding: 10px 0;
	position: fixed;
	width: 100%;
	bottom: 0px;
}

.item .image {
	width: 100px;
	height: 100px;
	background-color: #FF0000; 
	margin: 0 auto;
	animation: wiggle 2s infinite;
}

@keyframes wiggle {
	0% { transform: rotate(0deg); }
	25% { transform: rotate(-5deg); }
	50% { transform: rotate(0deg); }
	75% { transform: rotate(5deg); }
	100% { transform: rotate(0deg); }
}

nav ul {
	list-style: none;
	display: flex;
	justify-content: space-around;
}

nav ul li a {
	text-decoration: none;
	color: #E9E7C7;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
