<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 12.5mm; inline-size: 25.7mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 20.7mm; inline-size: 47.4mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_1 }}</p>
<h1 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 40.3mm; inline-size: 157.8mm; block-size: 5.5mm; font-size: 15.5pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 58.3mm; inline-size: 140.0mm; block-size: 13.5mm; font-size: 19.1pt">{{ slot_3 }}</h1>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 84.2mm; inline-size: 160.2mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 97.0mm; inline-size: 153.8mm; block-size: 8.9mm; font-size: 12.6pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 106.6mm; inline-size: 153.8mm; block-size: 18.3mm; font-size: 13.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 125.4mm; inline-size: 153.8mm; block-size: 9.0mm; font-size: 12.7pt"><li>{{ slot_7 }}</li></ul>
