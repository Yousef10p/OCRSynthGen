    color: #333;
    background: #f4f4f4;
}

nav {
    display: flex;
    justify-content: space-around;
    background: #333;
    color: #fff;
    padding: 20px 0;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin-left: 20px;
}

header {
    text-align: center;
    padding: 50px 0;
    background: #3f51b5;
    color: #fff;
}

section {
    padding: 50px;
}

#map {
    width: 100%;
    height: 500px;
    background: #ddd;
}

#trip-form {
    display: flex;
    flex-direction: column;
    max-width: 300px;
    margin: auto;
}

#trip-form label {
    margin-bottom: 10px;
}

#trip-form input,
#trip-form select {
    margin-bottom: 20px;
    padding: 10px;
}

footer {
    text-align: center;
    padding: 20px;
    background: #333;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
