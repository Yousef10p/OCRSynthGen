<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 35.3mm; inline-size: 23.6mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 60.1mm; inset-block-start: 73.3mm; inline-size: 94.3mm; block-size: 5.2mm; font-size: 14.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 60.1mm; inset-block-start: 85.2mm; inline-size: 112.9mm; block-size: 22.5mm; font-size: 12.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 60.1mm; inset-block-start: 109.9mm; inline-size: 118.7mm; block-size: 22.5mm; font-size: 12.8pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 2.6mm; inset-block-start: 134.9mm; inline-size: 2.0mm; block-size: 17.8mm; font-size: 40.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 60.1mm; inset-block-start: 139.5mm; inline-size: 119.1mm; block-size: 23.3mm; font-size: 13.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 60.1mm; inset-block-start: 164.2mm; inline-size: 119.7mm; block-size: 43.0mm; font-size: 13.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 60.1mm; inset-block-start: 208.6mm; inline-size: 118.1mm; block-size: 18.3mm; font-size: 13.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 60.1mm; inset-block-start: 228.4mm; inline-size: 118.8mm; block-size: 28.2mm; font-size: 13.3pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 10.5mm; inset-block-start: 287.3mm; inline-size: 34.8mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
