<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<div class="hero">
<div class="hero-content">
<h1>{{ slot_3 }}</h1>
<a class="cta">{{ slot_4 }}</a>
</div>
</div>
</header>
<aside>
<h3>{{ slot_5 }}</h3>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
<h3>{{ slot_8 }}</h3>
<ul class="social">
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
<h3>{{ slot_12 }}</h3>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
