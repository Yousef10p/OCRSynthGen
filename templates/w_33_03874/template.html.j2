}

header {
  position: sticky;
  top: 0;
  width: 100%;
  background: linear-gradient(to left, #f7ba2b, #ea5455);
}

nav ul {
  display: flex;
  justify-content: space-around;
}

nav ul li {
  list-style: none;
}

h1, h2, h3, p {
  margin: 0;
  padding: 1rem;
}

#menu {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1rem;
}

#menu:hover img,
#locations:hover .location {
  transform: scale(1.05);
  transition: all 0.2s ease-in-out;
}

footer {
  background: #ea5455;
  color: white;
  text-align: center;
  position: fixed;
  bottom: 0;
  width: 100%;
}

@media (max-width: 600px) {
  nav ul {
    flex-direction: column;
  }
  nav ul li {
    border-bottom: 1px solid white;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
