    background-color: #f0f0f0;
    padding: 20px;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    text-align: center;
    background-color: black;
    color: white;
    padding: 20px 0;
}

footer a {
    color: white;
    margin: 0 10px;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
