</ul>
</div>
<div class="sub-menu">
<h3>{{ slot_3 }}</h3>
<ul>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
<div class="sub-menu">
<h3>{{ slot_6 }}</h3>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
</ul>
</div>
</div>
<div class="banner">
<div class="banner-desc">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
</div>
<div class="footer">
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>