<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 172.4mm; inline-size: 84.9mm; block-size: 17.7mm; font-size: 12.5pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 192.0mm; inline-size: 84.7mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 202.7mm; inline-size: 83.8mm; block-size: 17.7mm; font-size: 12.5pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 208.5mm; inline-size: 82.2mm; block-size: 26.7mm; font-size: 12.6pt"><li>{{ slot_6 }}</li></ul>
