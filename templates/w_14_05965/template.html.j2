  font-size: 16px;
}

.left-menu {
  width: 200px;
  float: right;
  padding: 20px;
}

.sliding-banner {
  width: calc(100% - 200px);
  float: left;
}

.banner-img {
  width: 100%;
  height: 300px;
  background-color: #cccccc;
  padding: 20px;
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
