    display: flex;
    justify-content: space-between;
    background-color: #f8f8f8;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li a {
    margin-left: 10px;
    text-decoration: none;
    color: #000;
}

aside {
    background-color: #ddd;
}

main {
    display: flex;
