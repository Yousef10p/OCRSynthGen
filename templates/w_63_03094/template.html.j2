    align-items: center;
}

.featured-products .product {
    width: 200px;
    height: 100px;
    background-color: #ccc;
    margin-bottom: 10px;
}

footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    background-color: #f8f8f8;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
