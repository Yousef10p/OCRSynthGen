<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
  color: white;
}
header {
  background: blue;
  height: 70px;
}
header ul {
  padding: 0;
  margin: 0;
  list-style: none;
}
header li {
  float: right;
  width: 100px;
  height: 70px;
  line-height: 70px;
  text-align: center;
}
main {
  overflow: hidden;
}
.video-contain {
  height: 400px;
  background: none;
  background-size: cover;
  text-align: center;
  padding-top: 150px;
  color: black;
}
.testimonials {
  background: gray;
  padding: 30px 0;
  color: black;
}
.slide {
  text-align: center;
  display: none;
}
.testimony {
  width: 50%;
  display: inline-block;
}
.prev, .next {
  cursor: pointer;
  position: absolute;
  top: 50%;
  width: auto;
  margin-top: -22px;
  padding: 16px;
  color: white;
  font-weight: bold;
  font-size: 18px;
  transition: 0.6s ease;
  border-radius: 3px 0 0 3px;
}
section {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 400px;
  background: black;
  color: white;
}
footer {
  background: black;
  height: 100px;
  line-height: 100px;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
