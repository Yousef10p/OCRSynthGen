nav ul {
    list-style-type: none;
    font-family: var(--font-body);
}

nav ul li {
    display: inline-block;
    position: relative;
}

nav ul li ul {
    display: none;
    position: absolute;
    background-color: white;
    padding: 10px;
}

nav ul li:hover ul {
    display: block;
}

nav li ul li {
    width: 200px;
