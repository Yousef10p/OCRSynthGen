    height: 50px;
}
nav ul {
    display: flex;
    list-style: none;
}
nav ul li {
    position: relative;
}
nav ul li ul {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background-color: #fff;
    box-shadow: 0 2px 2px rgba(0,0,0,0.2);
    padding: 10px;
}
nav ul li:hover ul {
    display: block;
}
.product, .review {
    width: 200px;
    height: 200px;
    background-color: #f8f9fa;
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
