<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 65.2mm; inset-block-start: 85.2mm; inline-size: 119.6mm; block-size: 23.3mm; font-size: 13.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 65.2mm; inset-block-start: 109.8mm; inline-size: 118.0mm; block-size: 23.3mm; font-size: 13.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 65.2mm; inset-block-start: 134.5mm; inline-size: 116.5mm; block-size: 23.3mm; font-size: 13.2pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 205.7mm; inset-block-start: 135.3mm; inline-size: 2.0mm; block-size: 17.8mm; font-size: 40.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 65.2mm; inset-block-start: 159.2mm; inline-size: 118.7mm; block-size: 28.2mm; font-size: 13.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 65.2mm; inset-block-start: 188.9mm; inline-size: 118.6mm; block-size: 8.4mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 65.2mm; inset-block-start: 198.7mm; inline-size: 119.0mm; block-size: 28.2mm; font-size: 13.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 164.9mm; inset-block-start: 287.3mm; inline-size: 34.8mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_7 }}</footer>
</div></body>
</html>
