    width: 90%;
    max-width: 1200px;
    margin: auto;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
}

nav ul li a {
    text-decoration: none;
    color: black;
    margin: 0 1em;
}

#welcome, #products, #about, #contact {
    margin: 2em 0;
    padding: 1em;
    text-align: center;
}

article {
    width: 80%;
    max-width: 800px;
    margin: 2em auto;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.product-image {
    width: 100px;
    height: 100px;
    background-color: #888;
    margin: 1em 0;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-weight: bold;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
