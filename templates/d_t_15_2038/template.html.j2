<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.2mm; inset-block-start: 15.7mm; inline-size: 175.9mm; block-size: 92.4mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 110.2mm; inline-size: 115.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 116.3mm; inset-block-start: 118.4mm; inline-size: 85.8mm; block-size: 116.5mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 119.7mm; inline-size: 86.3mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 137.8mm; inline-size: 86.5mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 164.9mm; inline-size: 87.0mm; block-size: 58.3mm; font-size: 12.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 227.6mm; inline-size: 33.7mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 232.7mm; inline-size: 87.0mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 237.4mm; inline-size: 86.8mm; block-size: 17.2mm; font-size: 12.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 196.9mm; inset-block-start: 262.8mm; inline-size: 5.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_7 }}</footer>
</div></body>
</html>
