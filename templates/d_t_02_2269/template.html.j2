<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 18.5mm; inset-block-start: 13.2mm; inline-size: 185.6mm; block-size: 33.6mm; font-size: 10.6pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.5mm; inset-block-start: 51.7mm; inline-size: 185.6mm; block-size: 29.8mm; font-size: 10.6pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.5mm; inset-block-start: 86.3mm; inline-size: 185.6mm; block-size: 22.2mm; font-size: 10.5pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.5mm; inset-block-start: 113.5mm; inline-size: 185.6mm; block-size: 56.2mm; font-size: 10.6pt"><li>{{ slot_3 }}</li></ul>
<h2 class="box" style="inset-inline-start: 12.3mm; inset-block-start: 174.5mm; inline-size: 97.1mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 182.8mm; inline-size: 191.6mm; block-size: 37.3mm; font-size: 10.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 225.0mm; inline-size: 191.8mm; block-size: 41.1mm; font-size: 10.6pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 6.2mm; inset-block-start: 270.1mm; inline-size: 3.4mm; block-size: 2.8mm; font-size: 7.8pt">{{ slot_7 }}</footer>
</div></body>
</html>
