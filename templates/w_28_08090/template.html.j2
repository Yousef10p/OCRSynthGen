<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  background-color: AliceBlue;
  color: midnightblue;
  font-family: var(--font-body);
}

header, footer {
  background-color: white;
  padding: 20px;
  text-align: center;
}

#destinations, #photoSlider, #booking {
  padding: 20px;
}

#destinations ul {
  list-style-type: none;
  display: flex;
  justify-content: center;
}

#destinations li {
  margin: 0 10px;
}

.destination {
  background-color: lightblue;
  width: 200px;
  height: 200px;
}

#slider {
  position: relative;
  width: 100%;
  overflow: hidden;
  height: 200px;
}

.slide {
  position: absolute;
  top: 0;
  right: 0;
  background-color: lightgreen;
  width: 100%;
  height: 100%;
}

button {
  display: block;
  margin: 0 auto;
  padding: 10px 20px;
  font-size: 18px;
}

#booking form {
  margin-top: 20px;
}

#booking form label, #booking form input, #booking form select {
  display: block;
  width: 100%;
  margin-bottom: 10px;
}

#booking form input[type="submit"] {
  padding: 10px 20px;
  background-color: steelblue;
  color: white;
  border: none;
}

footer {
  position: fixed;
  width: 100%;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
