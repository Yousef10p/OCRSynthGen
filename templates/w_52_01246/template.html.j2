    margin-bottom: 20px;
}

.service-icon {
    width: 50px;
    height: 50px;
    background-color: #333;
    margin-left: 20px;
}

#about, #contact {
    background-color: #e5e5e5;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
