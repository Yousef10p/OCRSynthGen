    height: 100vh;
    background-color: #f5f5f5;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

nav ul {
    list-style: none;
}

nav a {
    text-decoration: none;
    color: #333;
}

#hero, #services, #about, #contact {
    height: 100vh;
    padding: 20px;
}

#hero {
