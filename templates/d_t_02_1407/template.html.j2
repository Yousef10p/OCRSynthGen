<ul class="box" style="inset-inline-start: 140.1mm; inset-block-start: 109.4mm; inline-size: 38.9mm; block-size: 2.6mm; font-size: 7.3pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 140.1mm; inset-block-start: 114.0mm; inline-size: 54.5mm; block-size: 135.7mm; font-size: 12.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 140.4mm; inline-size: 24.0mm; block-size: 2.3mm; font-size: 6.4pt">{{ slot_6 }}</h2>
