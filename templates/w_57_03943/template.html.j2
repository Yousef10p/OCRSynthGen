#classes-table {
  width: 100%;
  border-collapse: collapse;
}

#classes-table tr:nth-child(even) {background: #CCC}
#classes-table tr:nth-child(odd) {background: #FFF}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
