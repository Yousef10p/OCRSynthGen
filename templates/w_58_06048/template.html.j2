<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    background-color: #f0f0f0;
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}
.header {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #333;
    color: white;
    text-align: center;
    padding: 10px;
    font-size: 24px;
}
.logo {
    background-color: #f0f0f0;
    color: #333;
    padding: 50px;
    text-align: center;
}
.content {
    max-width: 800px;
    margin: 60px auto;
    padding: 20px;
    background: white;
    box-shadow: -10px 10px 5px grey;
}
table {
    width: 100%;
    text-align: center;
}
th {
    background-color: #f0f0f0;
}
tr:nth-child(even) {
    background-color: #f7f7f7;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">{{ slot_0 }}</div>
</div>
<div class="content">
<h1>{{ slot_1 }}</h1>
<p>{{ slot_2 }}</p>
<table>
<tr>
<th>{{ slot_3 }}</th>
<th>{{ slot_4 }}</th>
<th>{{ slot_5 }}</th>
<th>{{ slot_6 }}</th>
<th>{{ slot_7 }}</th>
<th>{{ slot_8 }}</th>
</tr>
<tr>
<td>{{ slot_9 }}</td>
<td>{{ slot_10 }}</td>
<td>{{ slot_11 }}</td>
<td>{{ slot_12 }}</td>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
</tr>
<tr>
<td>{{ slot_15 }}</td>
<td>{{ slot_16 }}</td>
<td>{{ slot_17 }}</td>
<td>{{ slot_18 }}</td>
<td>{{ slot_19 }}</td>
<td>{{ slot_20 }}</td>
</tr>
</table>
</div>
</body>
</html>