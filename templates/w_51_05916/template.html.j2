}

footer a {
    margin-left: 10px;
}

footer form {
    display: flex;
    align-items: center;
}

footer input[type='email'] {
    margin-left: 10px;
    padding: 0;
}

footer button[type='submit'] {
    background-color: #333;
    color: white;
    border: none;
    padding: 10px;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
