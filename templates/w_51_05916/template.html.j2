body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

nav {
    background-color: #f8f8f8;
    padding: 10px;
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
}

nav a {
    color: black;
