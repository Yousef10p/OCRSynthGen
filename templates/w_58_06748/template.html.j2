    color: #fff;
    padding: 1em 0;
}

footer section {
    flex: 1;
}

footer a {
    color: #fff;
    text-decoration: none;
}


header, #hero, footer {
    color: transparent;
    background: #000;
    height: 100px;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
