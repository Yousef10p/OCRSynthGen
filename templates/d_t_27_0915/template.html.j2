<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 25.2mm; inline-size: 113.1mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_0 }}</li></ul>
<div class="box ph" style="inset-inline-start: 48.5mm; inset-block-start: 34.2mm; inline-size: 132.3mm; block-size: 104.7mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 140.3mm; inline-size: 110.8mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 22.9mm; inset-block-start: 150.5mm; inline-size: 90.9mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 159.7mm; inline-size: 141.9mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 180.2mm; inline-size: 104.1mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 186.2mm; inline-size: 83.5mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 192.2mm; inline-size: 139.1mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_6 }}</li></ul>
<div class="box ph" style="inset-inline-start: 48.3mm; inset-block-start: 200.9mm; inline-size: 144.8mm; block-size: 41.1mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 243.2mm; inline-size: 70.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 22.9mm; inset-block-start: 266.3mm; inline-size: 157.3mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
