<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.navigation-bar {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    background-color: #f8f8f8;
    padding: 20px;
}

.navigation-bar ul {
    display: flex;
    justify-content: space-around;
    list-style-type: none;
}

.header {
    width: 100%;
    height: 400px;
    background-color: #f2f2f2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.product-display, .collections-display {
    width: 50%;
    text-align: center;
}

.content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    width: 60%;
    margin: 40px 0;
}

.product, .collection {
    width: 200px;
    height: 200px;
    background-color: #ccc;
    margin: 20px 0;
    display: flex;
    justify-content: center;
    align-items: center;
}

.footer {
    width: 100%;
    height: 200px;
    background-color: #f2f2f2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.customer-review {
    width: 50%;
    margin: 20px 0;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="product-display">{{ slot_0 }}</div>
<div class="collections-display">{{ slot_1 }}</div>
</div>
<div class="navigation-bar">
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="content">
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
<div class="collection">{{ slot_9 }}</div>
<div class="collection">{{ slot_10 }}</div>
<div class="collection">{{ slot_11 }}</div>
</div>
<div class="footer">
<div class="customer-review">{{ slot_12 }}</div>
<div class="customer-review">{{ slot_13 }}</div>
<div class="customer-review">{{ slot_14 }}</div>
</div>
</body>
</html>