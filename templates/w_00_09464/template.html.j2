<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.header, .content, .footer {
    padding: 20px;
}

.header {
    background-color: #000;
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 2em;
}

.menu ul {
    display: flex;
    list-style-type: none;
}

.menu li {
    margin-right: 15px;
}

.scores-news, .footer {
    display: flex;
    justify-content: space-between;
}

.colored-rectangle {
    width: 100px;
    height: 100px;
    background-color: #ccc;
    margin: 10px 0;
}

.footer {
    background-color: #000;
    color: #fff;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">{{ slot_0 }}</div>
<div class="menu">
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
</div>
<div class="content">
<div class="scores-news">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="colored-rectangle">{{ slot_8 }}</div>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<div class="colored-rectangle">{{ slot_11 }}</div>
</div>
</div>
<div class="footer">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="colored-rectangle">{{ slot_14 }}</div>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<div class="colored-rectangle">{{ slot_17 }}</div>
</div>
</body>
</html>