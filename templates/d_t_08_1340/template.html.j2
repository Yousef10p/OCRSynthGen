<div class="box ph" style="inset-inline-start: 64.6mm; inset-block-start: 189.0mm; inline-size: 113.7mm; block-size: 14.5mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 208.6mm; inline-size: 140.9mm; block-size: 35.2mm; font-size: 11.1pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 75.4mm; inset-block-start: 250.3mm; inline-size: 102.9mm; block-size: 15.4mm; font-size: 11.1pt"></div>
