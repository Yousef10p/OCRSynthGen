<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.4mm; inset-block-start: 39.1mm; inline-size: 58.2mm; block-size: 72.5mm; font-size: 14.7pt"></div>
<h2 class="box" style="inset-inline-start: 69.4mm; inset-block-start: 64.9mm; inline-size: 114.5mm; block-size: 8.5mm; font-size: 24.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 69.4mm; inset-block-start: 80.6mm; inline-size: 132.3mm; block-size: 13.7mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 69.4mm; inset-block-start: 98.6mm; inline-size: 129.1mm; block-size: 18.7mm; font-size: 13.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 69.4mm; inset-block-start: 122.8mm; inline-size: 127.9mm; block-size: 19.1mm; font-size: 13.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 9.9mm; inset-block-start: 127.5mm; inline-size: 41.7mm; block-size: 27.9mm; font-size: 15.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 69.4mm; inset-block-start: 146.2mm; inline-size: 131.5mm; block-size: 23.6mm; font-size: 13.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 8.4mm; inset-block-start: 173.2mm; inline-size: 50.7mm; block-size: 14.2mm; font-size: 10.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 69.4mm; inset-block-start: 175.4mm; inline-size: 134.3mm; block-size: 38.9mm; font-size: 13.8pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 5.7mm; inset-block-start: 190.6mm; inline-size: 51.3mm; block-size: 70.9mm; font-size: 12.6pt"></div>
<p class="box" style="inset-inline-start: 69.4mm; inset-block-start: 219.9mm; inline-size: 132.7mm; block-size: 38.9mm; font-size: 13.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 5.7mm; inset-block-start: 269.2mm; inline-size: 1.5mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
