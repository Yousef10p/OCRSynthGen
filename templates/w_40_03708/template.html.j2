<div class="dish">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</div>
<div class="dish">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
</div>
</div>
<div class="specials">
<h2>{{ slot_11 }}</h2>
<div class="special">
