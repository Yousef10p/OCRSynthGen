<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #333;
}

header {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #f90;
    color: #fff;
    text-align: center;
}

header h1 {
    font-size: 3em;
    margin-bottom: 1em;
}

header p {
    font-size: 1.5em;
    margin-bottom: 2em;
}

header button {
    font-size: 1.2em;
    background-color: #fff;
    color: #f90;
    border: none;
    padding: 1em 2em;
    border-radius: 5px;
    cursor: pointer;
}

main {
    margin: 2em;
}
.services, .products, .events {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 2em;
}

.services div, .products div, .events div {
    height: 200px;
    background-color: #ccc;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<button>{{ slot_2 }}</button>
</header>
<main>
<div class="services">
<h2>{{ slot_3 }}</h2>
<div class="service">{{ slot_4 }}</div>
<div class="service">{{ slot_5 }}</div>
<div class="service">{{ slot_6 }}</div>
</div>
<div class="products">
<h2>{{ slot_7 }}</h2>
<div class="product">{{ slot_8 }}</div>
<div class="product">{{ slot_9 }}</div>
<div class="product">{{ slot_10 }}</div>
</div>
<div class="events">
<h2>{{ slot_11 }}</h2>
<div class="event">{{ slot_12 }}</div>
<div class="event">{{ slot_13 }}</div>
<div class="event">{{ slot_14 }}</div>
</div>
</main>
</body>
</html>