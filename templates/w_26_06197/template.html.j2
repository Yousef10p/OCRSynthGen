}

.info-box {
  width: 50px;
  height: 50px;
  background-color: #ccc;
  margin: 10px 0;
}

form {
  display: flex;
  flex-direction: column;
}

input[type="text"] {
  padding: 10px;
  border: 1px solid #ccc;
  margin-bottom: 10px;
}

input[type="submit"] {
  padding: 10px;
  border: 0;
  background-color: #008CBA;
  color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
