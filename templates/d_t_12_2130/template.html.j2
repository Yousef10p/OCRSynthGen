<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.4mm; inset-block-start: 10.3mm; inline-size: 3.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 111.5mm; inset-block-start: 17.6mm; inline-size: 85.2mm; block-size: 130.0mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 19.4mm; inline-size: 86.5mm; block-size: 19.3mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 40.2mm; inline-size: 86.5mm; block-size: 55.7mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 97.4mm; inline-size: 86.5mm; block-size: 59.7mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 111.2mm; inset-block-start: 150.6mm; inline-size: 86.5mm; block-size: 13.9mm; font-size: 7.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 158.6mm; inline-size: 86.5mm; block-size: 75.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 111.2mm; inset-block-start: 174.1mm; inline-size: 86.5mm; block-size: 35.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 111.2mm; inset-block-start: 211.7mm; inline-size: 86.5mm; block-size: 43.5mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 235.9mm; inline-size: 86.5mm; block-size: 19.3mm; font-size: 10.0pt">{{ slot_8 }}</p>
</div></body>
</html>
