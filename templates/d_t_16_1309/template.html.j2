<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 140.0mm; inset-block-start: 13.5mm; inline-size: 57.8mm; block-size: 15.4mm; font-size: 10.9pt">{{ slot_0 }}</header><h1 class="box" style="inset-inline-start: 81.8mm; inset-block-start: 42.3mm; inline-size: 60.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_1 }}</h1>
<h1 class="box" style="inset-inline-start: 63.2mm; inset-block-start: 68.9mm; inline-size: 96.8mm; block-size: 20.0mm; font-size: 14.2pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 68.7mm; inset-block-start: 94.1mm; inline-size: 86.1mm; block-size: 10.2mm; font-size: 14.5pt">{{ slot_3 }}</h1>
<h1 class="box" style="inset-inline-start: 84.9mm; inset-block-start: 111.2mm; inline-size: 53.8mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_4 }}</h1>
<div class="box ph" style="inset-inline-start: 71.5mm; inset-block-start: 126.6mm; inline-size: 78.9mm; block-size: 112.4mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 251.2mm; inline-size: 136.8mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 255.3mm; inline-size: 115.6mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 263.4mm; inline-size: 82.5mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 176.0mm; inset-block-start: 263.4mm; inline-size: 21.7mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
