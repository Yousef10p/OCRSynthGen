<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

a {
  text-decoration: none;
}

ul {
  list-style: none;
  padding: 0;
}


.hero-header {
  background-image: linear-gradient(to left, #000, #fff);
  height: 300px;
}

.hero-header nav ul {
  display: flex;
  justify-content: space-around;
  margin: 0;
  padding: 16px 0;
}

.hero-header nav ul li a {
  color: #fff;
}


.content {
  display: flex;
  justify-content: space-around;
  margin-top: 30px;
}

.section {
  flex: 1;
  margin: 0 15px;
}

.product, .price {
  background-color: #ddd;
  height: 150px;
  margin: 0 0 15px;
  padding: 15px;
}

.section h2 {
  text-align: center;
}

.section p {
  line-height: 24px;
  margin: 0 0 15px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header class="hero-header">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<div class="content">
<div class="section">
<h2>{{ slot_4 }}</h2>
<div class="product">{{ slot_5 }}</div>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
</div>
<div class="section">
<h2>{{ slot_8 }}</h2>
<div class="price">{{ slot_9 }}</div>
<div class="price">{{ slot_10 }}</div>
<div class="price">{{ slot_11 }}</div>
</div>
<div class="section">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>