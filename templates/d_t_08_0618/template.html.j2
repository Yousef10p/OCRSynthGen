<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 42.9mm; inset-block-start: 70.4mm; inline-size: 123.9mm; block-size: 6.6mm; font-size: 20.7pt">{{ slot_0 }}</h1>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 89.9mm; inline-size: 6.3mm; block-size: 116.8mm; font-size: 20.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 82.1mm; inset-block-start: 90.5mm; inline-size: 91.0mm; block-size: 5.1mm; font-size: 12.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 46.6mm; inset-block-start: 103.2mm; inline-size: 160.3mm; block-size: 5.1mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 96.4mm; inset-block-start: 138.7mm; inline-size: 16.9mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 46.7mm; inset-block-start: 150.3mm; inline-size: 116.4mm; block-size: 22.6mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 46.7mm; inset-block-start: 179.0mm; inline-size: 116.4mm; block-size: 13.0mm; font-size: 10.9pt">{{ slot_6 }}</p>
