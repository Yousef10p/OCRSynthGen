<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 115.7mm; inline-size: 22.3mm; block-size: 4.3mm; font-size: 12.3pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 121.8mm; inline-size: 32.4mm; block-size: 4.3mm; font-size: 12.3pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 123.3mm; inline-size: 86.9mm; block-size: 31.4mm; font-size: 12.7pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 127.9mm; inline-size: 50.1mm; block-size: 4.3mm; font-size: 12.3pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 134.1mm; inline-size: 15.6mm; block-size: 4.3mm; font-size: 12.3pt"><li>{{ slot_7 }}</li></ul>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 143.8mm; inline-size: 86.3mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 14.3mm; inset-block-start: 164.4mm; inline-size: 174.4mm; block-size: 41.5mm; font-size: 16.8pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 209.0mm; inline-size: 55.8mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 14.3mm; inset-block-start: 215.4mm; inline-size: 174.4mm; block-size: 26.5mm; font-size: 18.7pt"></div>
