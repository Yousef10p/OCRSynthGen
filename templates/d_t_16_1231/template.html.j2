<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 102.7mm; inline-size: 50.3mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 109.5mm; inline-size: 19.9mm; block-size: 4.3mm; font-size: 12.3pt"><li>{{ slot_1 }}</li></ul>
