<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.3mm; inset-block-start: 12.6mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 91.0mm; inset-block-start: 15.4mm; inline-size: 27.3mm; block-size: 26.6mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 15.3mm; inset-block-start: 18.9mm; inline-size: 59.9mm; block-size: 28.3mm; font-size: 11.5pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 15.3mm; inset-block-start: 55.9mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 90.9mm; inset-block-start: 57.4mm; inline-size: 27.3mm; block-size: 25.4mm; font-size: 14.4pt"></div>
<p class="box" style="inset-inline-start: 15.3mm; inset-block-start: 62.1mm; inline-size: 59.8mm; block-size: 40.7mm; font-size: 11.5pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 91.3mm; inset-block-start: 109.5mm; inline-size: 26.8mm; block-size: 26.4mm; font-size: 15.0pt"></div>
<h2 class="box" style="inset-inline-start: 15.3mm; inset-block-start: 110.2mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 15.3mm; inset-block-start: 116.4mm; inline-size: 59.5mm; block-size: 20.1mm; font-size: 11.4pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 131.3mm; inset-block-start: 198.0mm; inline-size: 1.5mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
