    padding: 10px;
}

nav ul {
    list-style: none;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

aside {
    float: right;
    width: 20%;
    background-color: #f0f0f0;
    padding: 10px;
}

article {
    float: right;
    width: 60%;
    padding: 10px;
}

.product-img, .event-img {
    background-color: #ddd;
    height: 200px;
    margin-bottom: 10px;
}

.product-img:after, .event-img:after {
    content: "";
    display: block;
    margin-top: 70px;
}

aside:last-of-type {
    float: left;
    width: 20%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
