    background-color: #cc92f2;
    padding: 20px;
    border-radius: 15px;
}
.projects {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
}
.projects div {
    width: 30%;
    height: 200px;
    margin: 10px;
    background-color: #f992f2;
    color: transparent;
    border: 1px solid #6610f2;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2em;
    border-radius: 15px;
}


@media screen and (max-width: 768px) {
    .projects div {
        width: 100%;
    } 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
