* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
}

header {
    background-color: #f8f8f8;
    padding: 10px 0;
    text-align: center;
    position: fixed;
    width: 100%;
}

nav ul {
    list-style: none;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

.hero {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 150px 100px;
}

.graphic {
    background-color: #ddd;
    height: 200px;
    width: 300px;
}

.form-section {
    padding: 100px 20px;
    text-align: center;
}

input, textarea {
    width: 300px;
    padding: 10px;
    margin: 10px 0;
}

footer {
    background-color: #f8f8f8;
    padding: 20px;
    text-align: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}

footer > div {
    margin-bottom: 20px;
}

footer > div:last-child {
    margin-bottom: 0;
}

footer a {
    margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
