    background-color: #ccc;
    padding: 10px;
}

header img {
	width: 50px; 
	height: 50px;
	background: #000;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

section {
	padding: 20px;
}

#media-content article {
	display: flex;
    flex-wrap: wrap;
}

#media-content article .color-rectangle {
    width: 300px;
    height: 200px;
    background: #000;
}


@media (max-width: 768px) {
    header {
        flex-direction: column;
    }
    
    nav ul li {
        display: block;
    }

    #media-content article {
        flex-direction: column;
    }
    
    iframe {
        width: 100%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
