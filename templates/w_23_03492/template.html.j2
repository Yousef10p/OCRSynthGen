    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.product, .service {
    width: 50%;
    margin: 20px;
}

.product-image, .placeholder {
    background-color: #ddd;
    height: 150px;
    margin-bottom: 20px;
}

footer {
    background-color: #333;
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

footer p {
    margin-bottom: 0;
}

footer ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
}

footer a {
    color: white;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
