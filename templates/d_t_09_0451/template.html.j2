<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 71.4mm; inset-block-start: 52.2mm; inline-size: 79.1mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 49.3mm; inset-block-start: 60.4mm; inline-size: 123.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 75.7mm; inset-block-start: 68.8mm; inline-size: 70.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 86.2mm; inline-size: 6.3mm; block-size: 120.5mm; font-size: 20.0pt">{{ slot_3 }}</header><h1 class="box" style="inset-inline-start: 63.5mm; inset-block-start: 135.0mm; inline-size: 94.9mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_4 }}</h1>
<p class="box" style="inset-inline-start: 108.8mm; inset-block-start: 146.8mm; inline-size: 4.3mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 86.4mm; inset-block-start: 158.7mm; inline-size: 49.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 68.3mm; inset-block-start: 224.7mm; inline-size: 85.4mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 102.2mm; inset-block-start: 250.0mm; inline-size: 17.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_8 }}</p>
</div></body>
</html>
