<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}
nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}
nav li {
    float: right;
}
nav li a, .dropdown-btn {
    display: inline-block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}
nav li a:hover, .dropdown:hover .dropdown-btn {
    background-color: red;
}
nav li.dropdown {
    display: inline-block;
}
nav .dropdown-content {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 160px;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    z-index: 1;
}
nav .dropdown-content a {
    color: black;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
    text-align: right;
}
nav .dropdown-content a:hover {background-color: #f1f1f1}
nav .dropdown:hover .dropdown-content {
    display: block;
}
main {
    margin: 15px;
}
#blog {
    column-count: 2;
}
#blog div {
    height: 50px;
    background: gray;
    color: white;
    margin: 15px 0;
}
footer {
    clear: both;
    background-color: #333;
    color: white;
    text-align: center;
    padding: 10px;
}
.social a {
    color: white;
    margin: 0 10px;
    text-decoration: none;
}
.social a:hover {
    color: red;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
