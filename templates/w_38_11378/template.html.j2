    font-family: var(--font-body);
}


.hero {
    background-color: #f8f9fa;
    padding: 30px;
    text-align: center;
    font-size: 35px;
}


nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}

nav ul li {
    float: right;
}

nav ul li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}


.container {
    display: flex;
}

.container aside {
    flex: 1;
    background: #f1f1f1;
    padding: 20px;
}

.container main {
    flex: 2;
    background: white;
    padding: 20px;
}

#hero-image {
    background-color: #bbb;
    height: 200px;
}


@media screen and (max-width: 600px) {
    .container, nav ul {
        flex-direction: column;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
