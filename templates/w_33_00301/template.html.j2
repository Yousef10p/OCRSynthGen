<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    font-family: var(--font-body);
}

header {
    background-color: #f7f7f7;
    padding: 20px;
    text-align: center;
}

nav ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
}

nav a {
    text-decoration: none;
    color: #333;
}

#banner {
    height: 500px;
    background-color: #333;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

#equipment .grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    column-gap: 20px;
    row-gap: 20px;
    margin: 20px;
}

#equipment .grid-item {
    display: flex;
    flex-direction: column;
}

#equipment .placeholder {
    width: 100%;
    height: 200px;
    background-color: #ccc;
}

#workouts {
    background-color: #f7f7f7;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<section id="banner">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</section>
<section id="equipment">
<h2>{{ slot_7 }}</h2>
<div class="grid">
<div class="grid-item">
<div class="placeholder">{{ slot_8 }}</div>
<p>{{ slot_9 }}</p>
</div>
<div class="grid-item">
<div class="placeholder">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
</div>
<div class="grid-item">
<div class="placeholder">{{ slot_12 }}</div>
<p>{{ slot_13 }}</p>
</div>
</div>
</section>
<section id="workouts">
