<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #eee;
}

nav ul {
  display: flex;
  list-style-type: none;
}

nav li {
  margin-left: 10px;
}

form input {
  margin: 10px 0;
}


nav li a {
  text-decoration: none;
  color: #333;
}


section {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 20px;
}

section div {
  border: 1px solid #ccc;
  padding: 10px;
}

section .movie,
section .tv-show,
section .song,
section .game {
  height: 150px;
  background: #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</form>
</header>
<section>
<div class="display-movies">
<h2>{{ slot_5 }}</h2>
<div class="movie">{{ slot_6 }}</div>
<div class="movie">{{ slot_7 }}</div>
</div>
<div class="display-tv">
<h2>{{ slot_8 }}</h2>
<div class="tv-show">{{ slot_9 }}</div>
<div class="tv-show">{{ slot_10 }}</div>
</div>
<div class="display-music">
<h2>{{ slot_11 }}</h2>
<div class="song">{{ slot_12 }}</div>
<div class="song">{{ slot_13 }}</div>
</div>
<div class="display-games">
<h2>{{ slot_14 }}</h2>
<div class="game">{{ slot_15 }}</div>
<div class="game">{{ slot_16 }}</div>
</div>
</section>
</body>
</html>