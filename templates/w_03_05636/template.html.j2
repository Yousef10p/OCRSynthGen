<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<main>
<section id="hero">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<a class="cta-button">{{ slot_6 }}</a>
</section>
<section id="features">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="feature-item">{{ slot_9 }}</div>
<div class="feature-item">{{ slot_10 }}</div>
<div class="feature-item">{{ slot_11 }}</div>
</section>
<section id="free-trial">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<a class="cta-button">{{ slot_14 }}</a>
</section>
</main>
<footer>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>