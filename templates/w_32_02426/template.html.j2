<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

#header {
    width: 100%;
    height: 100px;
    background-color: pink;
    text-align: center;
    padding: 20px 0;
}

#nav-menu {
    float: left;
    margin-top: 20px;
}

#nav-menu ul {
    list-style: none;
}

#nav-menu ul li {
    display: inline;
    position: relative;
}

#nav-menu ul li .dropdown-content {
    display: none;
    position: absolute;
    background-color: pink;
    min-width: 160px;
    padding: 12px 16px;
}

#nav-menu ul li:hover .dropdown-content {
    display: block;
}

#slider {
    background-color: lightgrey;
    width: 100%;
    height: 300px;
    overflow: hidden;
}

#slider ul {
    list-style: none;
}

#slider ul li {
    width: 100%;
    height: 300px;
    overflow: hidden;
}

#content {
    width: 100%;
    padding: 20px;
    text-align: justify;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div id="nav-menu">
<ul>
<li class="dropdown">
<a class="dropdown-btn">{{ slot_0 }}</a>
<div class="dropdown-content">
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
</div>
</li>
<li class="dropdown">
<a class="dropdown-btn">{{ slot_5 }}</a>
<div class="dropdown-content">
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
<a>{{ slot_8 }}</a>
<a>{{ slot_9 }}</a>
</div>
</li>
</ul>
</div>
<div id="slider">
<ul>
<li><div style="background-color:blue;">{{ slot_10 }}</div></li>
<li><div style="background-color:red;">{{ slot_11 }}</div></li>
<li><div style="background-color:green;">{{ slot_12 }}</div></li>
</ul>
</div>
<div id="content">
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</div></body>
</html>