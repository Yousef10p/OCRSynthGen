<p class="box" style="inset-inline-start: 105.5mm; inset-block-start: 77.8mm; inline-size: 75.1mm; block-size: 53.9mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 89.2mm; inline-size: 75.2mm; block-size: 26.5mm; font-size: 10.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 122.4mm; inline-size: 75.1mm; block-size: 18.7mm; font-size: 10.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 105.5mm; inset-block-start: 136.8mm; inline-size: 75.1mm; block-size: 30.4mm; font-size: 10.8pt">{{ slot_7 }}</p>
