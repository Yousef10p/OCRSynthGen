<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 9.3mm; inset-block-start: 13.8mm; inline-size: 61.0mm; block-size: 88.0mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 75.3mm; inset-block-start: 13.0mm; inline-size: 60.2mm; block-size: 88.0mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 141.0mm; inset-block-start: 13.0mm; inline-size: 60.2mm; block-size: 88.4mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 9.7mm; inset-block-start: 105.1mm; inline-size: 60.6mm; block-size: 87.1mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 140.2mm; inset-block-start: 105.6mm; inline-size: 60.6mm; block-size: 87.1mm; font-size: 15.4pt"></div>
<h2 class="box" style="inset-inline-start: 79.6mm; inset-block-start: 138.9mm; inline-size: 53.2mm; block-size: 9.7mm; font-size: 27.4pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 79.7mm; inset-block-start: 152.7mm; inline-size: 53.1mm; block-size: 5.8mm; font-size: 16.3pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 140.2mm; inset-block-start: 196.9mm; inline-size: 60.6mm; block-size: 87.1mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 9.7mm; inset-block-start: 197.3mm; inline-size: 60.6mm; block-size: 86.3mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 74.9mm; inset-block-start: 197.3mm; inline-size: 61.0mm; block-size: 86.7mm; font-size: 15.4pt"></div>
</div></body>
</html>
