<p>{{ slot_10 }}</p>
<div class="new-grid">
<div class="new-item">{{ slot_11 }}</div>
<div class="new-item">{{ slot_12 }}</div>
<div class="new-item">{{ slot_13 }}</div>

</div>
</section>
<footer>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
<a>{{ slot_16 }}</a>
<a>{{ slot_17 }}</a>
</footer>
</body>
</html>