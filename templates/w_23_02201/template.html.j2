<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

a {
    color: blue;
    text-decoration: none;
}

ul {
    list-style: none;
    padding: 0;
}

#header {
    height: 80px;
    background: lightblue;
}

#header h1 {
    margin: 0;
    padding: 20px;
}

#main {
    padding: 10px;
}

#main h2 {
    margin: 0;
}

#footer {
    clear: both;
    text-align: center;
    padding: 10px;
}

#footer a {
    color: darkblue;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header" style="text-align:center;">
<h1 style="color:blue;">{{ slot_0 }}</h1>
</div>
<div id="menu" style="float:right; width:15%; background:lightgrey; height:100%;">
<h2>{{ slot_1 }}</h2>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div id="main" style="float:left; width:85%; background:beige; height:100%;">
<h2>{{ slot_5 }}</h2>


<p style="border:2px solid darkblue; padding:10px;">{{ slot_6 }}</p>
</div>
<div id="footer" style="background:lightgrey;">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
<h3>{{ slot_11 }}</h3>
<a>{{ slot_12 }}</a> {{ slot_13 }} <a>{{ slot_14 }}</a> {{ slot_15 }} <a>{{ slot_16 }}</a>
<h3><a>{{ slot_17 }}</a></h3>
</div>
</body>
</html>