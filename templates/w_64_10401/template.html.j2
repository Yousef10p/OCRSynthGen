body {
    font-family: var(--font-body);
    color: #333;
}
#slider ul {
    list-style: none;
    display: flex;
    justify-content: space-between;
    padding: 1em;
    background-color: lightblue;
}
#slider li {
    width: 20%;
    height: 100px;
    background-color: blue;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
}
#booking {
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 1em;
}
#booking > * {
    flex-grow: 1;
}
#booking-submit {
    background-color: green;
    color: white;
    border: none;
    padding: 0.5em;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
