<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 175.4mm; inset-block-start: 18.2mm; inline-size: 14.8mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 35.3mm; inset-block-start: 32.0mm; inline-size: 156.1mm; block-size: 14.0mm; font-size: 22.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 35.3mm; inset-block-start: 48.4mm; inline-size: 157.3mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 62.5mm; inline-size: 87.8mm; block-size: 5.9mm; font-size: 22.1pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 69.4mm; inline-size: 105.4mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 77.6mm; inline-size: 123.0mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 85.8mm; inline-size: 140.1mm; block-size: 14.9mm; font-size: 22.1pt"><li>{{ slot_6 }}</li></ul>
<div class="box ph" style="inset-inline-start: 19.9mm; inset-block-start: 107.6mm; inline-size: 172.0mm; block-size: 110.2mm; font-size: 14.9pt"></div>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 225.8mm; inline-size: 167.4mm; block-size: 38.2mm; font-size: 22.1pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 133.0mm; inset-block-start: 269.8mm; inline-size: 38.4mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 184.9mm; inset-block-start: 269.8mm; inline-size: 6.5mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
