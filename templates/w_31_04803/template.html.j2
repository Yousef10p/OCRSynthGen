<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


.hero-image-container {
    position: relative;
    width: 100%;
    height: 500px;
}

.hero-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

nav {
    display: flex;
    justify-content: space-around;
    background-color: #333;
    color: #fff;
    height: 50px;
    line-height: 50px;
}

nav a {
    color: #fff;
    text-decoration: none;
}


aside {
    width: 20%;
    background-color: #f2f2f2;
    padding: 20px;
}

ul {
    padding: 0;
}

ul li {
    list-style-type: none;
    padding-bottom: 10px;
}


main {
    width: 80%;
    padding: 20px;
}

main img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    background-color: #999;
}


footer {
    display: flex;
    justify-content: space-between;
    background-color: #333;
    color: #fff;
    padding: 20px;
}

footer ul {
    padding: 0;
}

footer li {
    list-style-type: none;
    display: inline;
    padding-left: 10px;
}

footer form {
    display: inline-block;
    text-align: left;
}

footer form input[type="text"], footer form input[type="email"] {
    display: block;
    margin-bottom: 10px;
}

footer form input[type="submit"] {
    background-color: #fff;
    color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

