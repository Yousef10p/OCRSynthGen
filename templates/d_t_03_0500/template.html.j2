<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 54.8mm; inset-block-start: 7.7mm; inline-size: 73.8mm; block-size: 15.3mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 139.8mm; inset-block-start: 50.0mm; inline-size: 60.3mm; block-size: 31.5mm; font-size: 14.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 13.4mm; inset-block-start: 54.3mm; inline-size: 78.3mm; block-size: 52.7mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 139.8mm; inset-block-start: 89.5mm; inline-size: 60.7mm; block-size: 25.9mm; font-size: 14.7pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 48.2mm; inset-block-start: 142.8mm; inline-size: 76.1mm; block-size: 52.5mm; font-size: 14.9pt"></div>
<div class="box ph" style="inset-inline-start: 128.9mm; inset-block-start: 175.4mm; inline-size: 80.2mm; block-size: 54.6mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 259.0mm; inline-size: 65.8mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 94.2mm; inset-block-start: 259.0mm; inline-size: 74.4mm; block-size: 15.3mm; font-size: 10.8pt">{{ slot_4 }}</p>
</div></body>
</html>
