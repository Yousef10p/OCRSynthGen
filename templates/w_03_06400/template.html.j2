<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

.grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.grid-item {
    border: 1px solid black;
    padding: 10px;
    text-align: center;
    background-color: white;
}

.featured {
    grid-column: 1 / span 2;
}

.category {
    grid-column: 2 / span 1;
}

.about {
    grid-column: 1 / span 2;
}

.sidebar {
    position: fixed;
    left: 0;
    width: 200px;
    top: 0;
    bottom: 0;
    padding: 20px;
    background-color:#f4f4f4;
}

h1, h2, h3 {
    border-bottom: 1px solid black;
    padding-bottom: 10px;
}

form {
    margin-top: 20px;
}

img {
    display: block;
    margin: auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="grid-container">
<div class="grid-item featured">
<h1>{{ slot_0 }}</h1>
<div class="ph" style="inline-size: 250px; block-size: 250px"></div>
<p>{{ slot_1 }}</p>
</div>
<div class="grid-item category">
<a><h2>{{ slot_2 }}</h2></a>
<div class="ph" style="inline-size: 250px; block-size: 250px"></div>
<p>{{ slot_3 }}</p>
</div>
<div class="grid-item featured">
<h1>{{ slot_4 }}</h1>
<div class="ph" style="inline-size: 250px; block-size: 250px"></div>
<p>{{ slot_5 }}</p>
</div>
<div class="grid-item about">
<h2>{{ slot_6 }}</h2>
<div class="ph" style="inline-size: 250px; block-size: 250px"></div>
<p>{{ slot_7 }}</p>
</div>
</div>
<div class="sidebar">
<a>{{ slot_8 }}</a>
<a>{{ slot_9 }}</a>
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_14 }}</span>
</form>
</div>
</body>
</html>