}

#book {
    background-color: #f00;
}

#book form input, #book form button {
    display: block;
    margin: 10px 0;
    padding: 10px;
}

#book form button {
    background-color: #000;
    color: #fff;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
