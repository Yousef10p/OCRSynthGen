    list-style-type: none;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

#banner, #locations, #book {
    margin: 20px;
    padding: 20px;
    border: 1px solid #333;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
}

#banner {
    background-color: #ff0;
    text-align: center;
}

#locations {
    background-color: #0f0;
}

.location {
    background-color: #00f;
