<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 18.7mm; inset-block-start: 18.5mm; inline-size: 62.9mm; block-size: 6.3mm; font-size: 17.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 18.7mm; inset-block-start: 69.4mm; inline-size: 13.2mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 76.1mm; inline-size: 15.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 82.2mm; inline-size: 111.7mm; block-size: 7.3mm; font-size: 10.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 96.6mm; inline-size: 15.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 102.8mm; inline-size: 111.2mm; block-size: 15.5mm; font-size: 11.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 125.5mm; inline-size: 15.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 131.6mm; inline-size: 111.2mm; block-size: 15.5mm; font-size: 11.0pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 18.7mm; inset-block-start: 155.9mm; inline-size: 13.2mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 162.5mm; inline-size: 15.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 168.7mm; inline-size: 111.2mm; block-size: 11.4mm; font-size: 10.8pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 187.2mm; inline-size: 15.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_11 }}</p>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 193.4mm; inline-size: 111.2mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_12 }}</p>
</div></body>
</html>
