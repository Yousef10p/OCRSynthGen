    text-align: center;
}

#left-nav {
    width: 20%;
    min-height: 100vh;
    background-color: #ddd;
}

#event-list, #blog {
    width: 60%;
    min-height: 100vh;
    background-color: #ccc;
    display: flex;
    flex-direction: column;
}

.event, .blog-post {
    margin: 20px;
    padding: 20px;
    background-color: #aaa;
}

#right-sidebar {
    width: 20%;
    min-height: 100vh;
    background-color: #bbb;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#right-sidebar form {
    display: flex;
    flex-direction: column;
}

#right-sidebar form input[type="text"] {
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
