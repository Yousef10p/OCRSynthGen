    margin-left: 1em;
}
.hero {
    position: relative;
    height: 500px;
}
.carousel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    position: absolute;
}
.slide {
    flex: 1;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #fff;
    font-size: 2em;
    text-align: center;
}
.services {
    padding: 2em;
}
.services h1 {
    font-size: 2em;
    text-align: center;
}
.services p, .services li {
    font-size: 1em;
    margin-bottom: 1.5em;
    text-align: center;
    list-style: none;
    padding: 0;
}
footer {
    background-color: #000;
    color: #fff;
    text-align: center;
    padding: 2em;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
