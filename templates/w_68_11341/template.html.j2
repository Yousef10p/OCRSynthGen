<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  background-color: #f2f2f2;
}

.hero {
  background-color: #4b6b8a;
  padding: 20px;
  text-align: center;
  color: white;
}

.hero h1 {
  font-size: 2.5em;
}

.hero h2 {
  font-size: 1.5em;
}

.hero nav {
  margin-top: 20px;
}

.hero nav a {
  color: white;
  margin: 0 10px;
  font-size: 1em;
}

.non-profits {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
  margin: 20px;
}

.non-profit {
  background-color: #8f8f8f;
  padding: 10px;
  color: white;
}

.non-profit h2 {
  font-size: 1.5em;
  margin-bottom: 10px;
}

.contact {
  margin: 20px;
}

.contact h2 {
  font-size: 2em;
  margin-bottom: 10px;
}

.contact form {
  display: grid;
  gap: 10px;
}

.contact form input,
.contact form textarea {
  border: none;
  padding: 10px;
  font-size: 1em;
}

.contact form input[type="submit"] {
  background-color: #4a1d1ed;
  color: white;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
