    width: 300px;
    background-color: #ff0000;
}

header #banner {
    height: 400px;
    width: 100%;
    background-color: #00ff00;
}

nav {
    width: 100%;
    background-color: #0000ff;
}

nav ul {
    display: flex;
    justify-content: space-around;
    list-style-type: none;
}

#recipes .recipe {
    height: 200px;
    width: 200px;
    background-color: #ffff00;
}

#recipes p, #reviews p {
    width: 50%;
    text-align: center;
}

#reviews .review {
    height: 200px;
    width: 200px;
    background-color: #ff00ff;
}


#contact form {
    display: flex;
    flex-direction: column;
    width: 50%;
}

#contact form input, #contact form textarea {
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
