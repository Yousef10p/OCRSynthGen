<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 28.8mm; inline-size: 6.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 91.8mm; inset-block-start: 36.4mm; inline-size: 27.3mm; block-size: 5.6mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 49.0mm; inline-size: 165.1mm; block-size: 32.9mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 65.9mm; inset-block-start: 89.0mm; inline-size: 79.2mm; block-size: 8.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 105.4mm; inline-size: 165.1mm; block-size: 24.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 74.2mm; inset-block-start: 129.8mm; inline-size: 62.5mm; block-size: 8.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 143.0mm; inline-size: 165.1mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 86.4mm; inset-block-start: 166.8mm; inline-size: 101.7mm; block-size: 7.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 185.9mm; inline-size: 165.1mm; block-size: 46.8mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 77.9mm; inset-block-start: 238.8mm; inline-size: 110.1mm; block-size: 21.5mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 103.4mm; inset-block-start: 265.8mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
