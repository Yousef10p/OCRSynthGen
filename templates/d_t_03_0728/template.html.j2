<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 26.9mm; inset-block-start: 15.9mm; inline-size: 70.0mm; block-size: 15.7mm; font-size: 22.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 175.4mm; inset-block-start: 16.8mm; inline-size: 91.8mm; block-size: 51.9mm; font-size: 14.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 26.9mm; inset-block-start: 50.3mm; inline-size: 99.3mm; block-size: 19.7mm; font-size: 13.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.9mm; inset-block-start: 71.8mm; inline-size: 97.7mm; block-size: 35.8mm; font-size: 14.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 176.6mm; inset-block-start: 75.8mm; inline-size: 92.8mm; block-size: 25.0mm; font-size: 14.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 175.4mm; inset-block-start: 108.0mm; inline-size: 92.9mm; block-size: 35.8mm; font-size: 14.5pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 26.9mm; inset-block-start: 114.7mm; inline-size: 18.5mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 26.9mm; inset-block-start: 120.0mm; inline-size: 97.2mm; block-size: 35.8mm; font-size: 14.5pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 14.3mm; inset-block-start: 199.3mm; inline-size: 69.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 162.7mm; inset-block-start: 199.4mm; inline-size: 69.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_9 }}</footer>
</div></body>
</html>
