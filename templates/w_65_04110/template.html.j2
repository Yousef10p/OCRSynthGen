<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	font-family: var(--font-body);
}

header {
	background: lightgray;
	text-align: center;
	padding: 20px;
}

nav ul {
	list-style: none;
	display: flex;
	justify-content: space-around;
}

button {
	background: pink;
	color: white;
	padding: 10px 20px;
	margin: 20px 0;
}

.product, .testimonial {
	margin: 10px;
	height: 200px;
	text-align: center;
	padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<div style="background-color: pink;">{{ slot_3 }}</div>
<a><button>{{ slot_4 }}</button></a>
</header>
<aside>
<h2>{{ slot_5 }}</h2>
<div class="product" style="background-color: lightblue;">{{ slot_6 }}</div>
<div class="product" style="background-color: lightgreen;">{{ slot_7 }}</div>
<div class="product" style="background-color: lightyellow;">{{ slot_8 }}</div>
</aside>
<section id="testimonials">
<h2>{{ slot_9 }}</h2>
<div class="testimonial" style="background-color: lightgray;">{{ slot_10 }}</div>
<div class="testimonial" style="background-color: lightpink;">{{ slot_11 }}</div>
<div class="testimonial" style="background-color: lightgray;">{{ slot_12 }}</div>
</section>
<section id="buy">
<h2>{{ slot_13 }}</h2>
<div style="background-color: lightblue;">{{ slot_14 }}</div>
</section>
</body>
</html>