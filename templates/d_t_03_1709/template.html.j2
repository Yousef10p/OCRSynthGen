<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.5mm; inline-size: 57.5mm; block-size: 51.1mm; font-size: 14.5pt"></div>
<div class="box ph" style="inset-inline-start: 158.8mm; inset-block-start: 0.7mm; inline-size: 51.1mm; block-size: 50.8mm; font-size: 14.4pt"></div>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 64.0mm; inline-size: 23.9mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 68.1mm; inline-size: 121.9mm; block-size: 29.2mm; font-size: 13.8pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 199.7mm; inset-block-start: 89.4mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_2 }}</header><h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 101.4mm; inline-size: 14.1mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_3 }}</h2>
<div class="box ph" style="inset-inline-start: 158.5mm; inset-block-start: 102.0mm; inline-size: 51.5mm; block-size: 51.8mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 105.5mm; inline-size: 121.7mm; block-size: 29.2mm; font-size: 13.8pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 138.1mm; inline-size: 9.8mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 143.0mm; inline-size: 121.8mm; block-size: 29.2mm; font-size: 13.8pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 176.4mm; inline-size: 11.9mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 180.5mm; inline-size: 121.0mm; block-size: 24.3mm; font-size: 13.8pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 208.9mm; inline-size: 23.9mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 213.0mm; inline-size: 121.0mm; block-size: 24.3mm; font-size: 13.8pt">{{ slot_10 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 245.0mm; inline-size: 108.6mm; block-size: 51.3mm; font-size: 14.5pt"></div>
<div class="box ph" style="inset-inline-start: 158.5mm; inset-block-start: 245.2mm; inline-size: 51.3mm; block-size: 51.1mm; font-size: 14.5pt"></div>
</div></body>
</html>
