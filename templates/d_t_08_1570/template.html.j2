<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 26.1mm; inline-size: 64.1mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 40.8mm; inline-size: 39.5mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 54.2mm; inline-size: 85.5mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 63.8mm; inline-size: 160.0mm; block-size: 94.7mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 162.4mm; inline-size: 160.0mm; block-size: 17.2mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 183.5mm; inline-size: 160.0mm; block-size: 10.2mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 75.8mm; inset-block-start: 197.5mm; inline-size: 58.4mm; block-size: 3.1mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 208.1mm; inline-size: 3.1mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 90.0mm; inset-block-start: 215.1mm; inline-size: 30.1mm; block-size: 3.1mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 225.7mm; inline-size: 9.0mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_7 }}</p>
<ul class="box" style="inset-inline-start: 30.3mm; inset-block-start: 235.3mm; inline-size: 154.7mm; block-size: 10.3mm; font-size: 10.0pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.3mm; inset-block-start: 252.2mm; inline-size: 116.7mm; block-size: 13.2mm; font-size: 10.0pt"><li>{{ slot_9 }}</li></ul>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 280.1mm; inline-size: 1.8mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
