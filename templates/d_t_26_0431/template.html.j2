<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 143.2mm; inset-block-start: 12.0mm; inline-size: 58.6mm; block-size: 16.4mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 24.7mm; inline-size: 97.4mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<h1 class="box" style="inset-inline-start: 15.8mm; inset-block-start: 38.9mm; inline-size: 178.8mm; block-size: 30.3mm; font-size: 40.0pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 106.5mm; inline-size: 25.8mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 115.0mm; inline-size: 40.4mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 123.4mm; inline-size: 21.2mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 131.9mm; inline-size: 31.5mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 140.4mm; inline-size: 21.1mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 148.8mm; inline-size: 26.0mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 157.3mm; inline-size: 22.0mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 15.9mm; inset-block-start: 227.9mm; inline-size: 22.7mm; block-size: 8.6mm; font-size: 12.2pt"></div>
<div class="box ph" style="inset-inline-start: 16.3mm; inset-block-start: 258.3mm; inline-size: 29.7mm; block-size: 12.3mm; font-size: 17.5pt"></div>
<div class="box ph" style="inset-inline-start: 162.3mm; inset-block-start: 261.4mm; inline-size: 39.9mm; block-size: 8.8mm; font-size: 24.8pt"></div>
</div></body>
</html>
