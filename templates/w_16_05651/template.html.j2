<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background-color: #ffb3b3;
  color: #440000;
}

header, footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background-color: #ff6666;
  color: white;
}

header nav ul, footer nav ul {
  display: flex;
  list-style-type: none;
}

header nav ul li, footer nav ul li {
  margin-left: 10px;
}

aside {
  width: 20%;
  background-color: #ff9999;
  color: white;
  padding: 20px;
}

aside ul {
  list-style-type: none;
}

main {
  width: 75%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20px;
}

.product {
  width: 45%;
  margin-bottom: 20px;
}

.product-image {
  width: 100%;
  height: 200px;
  background-size: cover;
  background-position: center;
}

footer {
  position: fixed;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div id="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<aside>
<ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
</ul>
</aside>
<main>
<h2>{{ slot_9 }}</h2>
<div class="product">
<h3>{{ slot_10 }}</h3>
<div class="product-image ph"></div>
<p>{{ slot_11 }}</p>
</div>

</main>
<footer>
<div id="logo">{{ slot_12 }}</div>
<nav>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</nav>
</footer>
</body>
</html>