<p class="box" style="inset-inline-start: 66.5mm; inset-block-start: 92.1mm; inline-size: 40.9mm; block-size: 34.4mm; font-size: 12.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 114.9mm; inset-block-start: 92.1mm; inline-size: 37.3mm; block-size: 38.8mm; font-size: 12.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 163.3mm; inset-block-start: 92.1mm; inline-size: 39.2mm; block-size: 47.8mm; font-size: 12.3pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 110.8mm; inset-block-start: 160.2mm; inline-size: 45.9mm; block-size: 45.1mm; font-size: 14.2pt"></div>
<div class="box ph" style="inset-inline-start: 159.2mm; inset-block-start: 160.4mm; inline-size: 46.5mm; block-size: 44.7mm; font-size: 15.8pt"></div>
