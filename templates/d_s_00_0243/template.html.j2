<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 118.8mm; inset-block-start: 20.0mm; inline-size: 52.3mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 64.5mm; inset-block-start: 40.3mm; inline-size: 72.3mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 139.3mm; inset-block-start: 39.3mm; inline-size: 31.8mm; block-size: 45.5mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 52.8mm; inline-size: 104.1mm; block-size: 32.2mm; font-size: 15.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 87.3mm; inline-size: 139.3mm; block-size: 14.9mm; font-size: 14.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 41.5mm; inset-block-start: 110.3mm; inline-size: 95.2mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 139.6mm; inset-block-start: 109.9mm; inline-size: 31.6mm; block-size: 44.9mm; font-size: 15.9pt"></div>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 122.8mm; inline-size: 104.1mm; block-size: 32.2mm; font-size: 15.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 157.3mm; inline-size: 139.3mm; block-size: 20.7mm; font-size: 14.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 186.0mm; inline-size: 139.3mm; block-size: 14.9mm; font-size: 14.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 209.0mm; inline-size: 139.3mm; block-size: 14.9mm; font-size: 14.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 183.8mm; inset-block-start: 271.8mm; inline-size: 4.1mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_9 }}</footer><div class="box ph" style="inset-inline-start: 179.9mm; inset-block-start: 275.4mm; inline-size: 23.0mm; block-size: 17.8mm; font-size: 25.2pt"></div>
</div></body>
</html>
