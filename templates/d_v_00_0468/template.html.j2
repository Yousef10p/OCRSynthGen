<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 12.2mm; inline-size: 84.0mm; block-size: 60.6mm; font-size: 13.2pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 13.0mm; inset-block-start: 12.6mm; inline-size: 35.8mm; block-size: 46.1mm; font-size: 14.5pt"></div>
<header class="box" style="inset-inline-start: 192.1mm; inset-block-start: 71.9mm; inline-size: 10.9mm; block-size: 136.4mm; font-size: 40.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 77.9mm; inline-size: 84.0mm; block-size: 65.3mm; font-size: 13.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 88.0mm; inline-size: 21.9mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 97.4mm; inline-size: 83.3mm; block-size: 26.9mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 130.3mm; inline-size: 83.5mm; block-size: 31.6mm; font-size: 12.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 148.3mm; inline-size: 85.3mm; block-size: 51.2mm; font-size: 13.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 167.8mm; inline-size: 84.6mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 204.6mm; inline-size: 85.2mm; block-size: 65.3mm; font-size: 13.2pt">{{ slot_8 }}</p>
</div></body>
</html>
