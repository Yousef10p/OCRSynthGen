<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    background-color: white;
    color: black;
}

.header {
    background-color: blue;
    color: white;
    padding: 20px;
    text-align: center;
}

.main-menu ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: green;
}

.main-menu li {
    float: right;
}

.main-menu li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

.testimonial {
    background-color: blue;
    color: white;
    padding: 20px;
    text-align: center;
}

.grid {
    display: grid;
    grid-template-columns: auto auto auto;
    background-color: lightgrey;
    padding: 10px;
}

.grid div {
    background-color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.8);
    padding: 20px;
    font-size: 30px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header class="header">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</header>
<nav class="main-menu">
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<section class="testimonial">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</section>
<section class="services">
<h2>{{ slot_8 }}</h2>
<div class="grid">
<div class="service">{{ slot_9 }}</div>
<div class="service">{{ slot_10 }}</div>
<div class="service">{{ slot_11 }}</div>
</div>
</section>
<section class="providers">
<h2>{{ slot_12 }}</h2>
<div class="grid">
<div class="provider">{{ slot_13 }}</div>
<div class="provider">{{ slot_14 }}</div>
<div class="provider">{{ slot_15 }}</div>
</div>
</section>
<section class="insurance">
