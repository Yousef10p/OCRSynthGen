<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 32.8mm; inline-size: 169.4mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 15.0mm; inset-block-start: 45.4mm; inline-size: 49.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 48.7mm; inset-block-start: 54.0mm; inline-size: 28.6mm; block-size: 7.0mm; font-size: 19.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 58.6mm; inset-block-start: 61.5mm; inline-size: 94.5mm; block-size: 18.4mm; font-size: 13.1pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 48.7mm; inset-block-start: 104.4mm; inline-size: 50.0mm; block-size: 7.0mm; font-size: 19.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 58.7mm; inset-block-start: 112.6mm; inline-size: 118.7mm; block-size: 16.7mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 58.7mm; inset-block-start: 133.9mm; inline-size: 121.1mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 14.4mm; inset-block-start: 150.4mm; inline-size: 187.8mm; block-size: 127.1mm; font-size: 15.0pt"></div>
<footer class="box" style="inset-inline-start: 8.0mm; inset-block-start: 285.2mm; inline-size: 3.3mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
