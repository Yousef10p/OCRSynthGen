.ph { background: #d0d0d0; }

body {
    max-width: 1200px;
    margin: auto;
    font-family: var(--font-body);
}


header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
}

header h1 {
    margin: 0;
}


.blog-container {
    display: flex;
    justify-content: space-between;
    margin: 20px 0;
}

.blog-post {
    flex: 1;
    margin-left: 20px;
}

.blog-post:last-child {
    margin-left: 0;
}


.social-media a {
    display: block;
    margin: 20px 0;
}


aside {
    position: fixed;
    left: 0;
    top: 0;
    padding: 20px;
    width: 300px;
}

aside ul {
    list-style: none;
    padding: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
