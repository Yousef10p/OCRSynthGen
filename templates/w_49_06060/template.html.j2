    --font-size: 30px;

    --height: 100px;
    --width: 100%;
    
}

--.menu {
    
    --background-color: #333;
    --height: 100vh;
    --width: 20%;
    --float: left;
    --padding: 20px;
    --color: white;
    --text-decoration: none;
    --display: block;
    --margin-top: 100px;

    --li {
        --list-style-type: none;
        --padding: 8px;
        --color: white;
    }
}

--.gallery {
    
    --float: right;
   --width: 80%;
   --padding: 20px;
