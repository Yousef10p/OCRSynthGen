<h2 class="box" style="inset-inline-start: 140.8mm; inset-block-start: 59.9mm; inline-size: 5.3mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 140.8mm; inset-block-start: 66.0mm; inline-size: 49.0mm; block-size: 94.4mm; font-size: 9.9pt">{{ slot_5 }}</p>
