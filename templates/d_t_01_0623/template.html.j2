<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 105.9mm; inline-size: 82.4mm; block-size: 85.0mm; font-size: 14.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 110.8mm; inset-block-start: 105.9mm; inline-size: 67.8mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_4 }}</p>
