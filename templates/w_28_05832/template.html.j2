<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.header, footer {
    background-color: #333;
    color: #fff;
    padding: 10px 0;
}

.logo {
    float: right;
    margin: 0 20px;
}

.menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
}

.menu li {
    display: inline-block;
    position: relative;
    margin: 0 10px;
}

.menu ul ul {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background-color: #333;
    padding: 10px 0;
    border-radius: 0 0 5px 5px;
}

.menu li:hover > ul {
    display: block;
}

.content {
    margin: 20px;
}

.colored-rectangle {
    width: 100px;
    height: 100px;
    background-color: #000;
}

.chatbot, .contact-form {
    float: right;
    margin: 20px;
}

footer {
    clear: both;
    text-align: center;
    padding: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">{{ slot_0 }}</div>
<div class="menu">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</li>
<li>
<a>{{ slot_6 }}</a>
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</div>
</div>
<div class="content">
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
<div class="colored-rectangle"></div>
</div>
<footer>
<div class="chatbot">{{ slot_12 }}</div>
<div class="contact-form">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>