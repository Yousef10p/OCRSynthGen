<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #00008B;  
    color: #FFFFFF;
}


#header {
    background-color: #FF0000;  
    padding: 10px;
}

#header ul {
    list-style-type: none;
    padding: 0;
}

#header ul li {
    display: inline;
    margin-left: 10px;
}

#header ul li a {
    color: #FFFFFF;
    text-decoration: none;
}


#content {
    margin: 15px;
}


.section {
    margin: 10px 0;
}

.section h2 {
    border-bottom: 2px solid #FFFFFF;
    padding-bottom: 5px;
}


.player {
    display: inline-block;
    width: 200px;
    margin: 10px;
}

.player-image {
    height: 150px;
    background-color: #0000FF;  
    color: #FFFFFF; 
    text-align: center;
    padding-top: 60px;
}


.game {
    margin: 10px 0;
}


#tickets {
    text-align: center;
}

#tickets button {
    background-color: #FF0000;  
    color: #FFFFFF;
    border: none;
    padding: 10px 20px;
    font-size: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
</ul>
</div>
<div id="content">
<h1>{{ slot_2 }}</h1>
<div class="section">
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
</div>
<div class="section" id="players">
<h2>{{ slot_5 }}</h2>
<div class="player">
<div class="player-image">{{ slot_6 }}</div>
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</div>

</div>
<div class="section" id="schedule">
<h2>{{ slot_9 }}</h2>

<div class="game">
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>
</div>
<div class="section" id="tickets">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<button>{{ slot_14 }}</button>
</div>
</div>
</body>
</html>