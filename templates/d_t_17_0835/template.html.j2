<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 88.9mm; inset-block-start: 12.8mm; inline-size: 38.1mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 178.1mm; inset-block-start: 12.8mm; inline-size: 13.3mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_1 }}</header><ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 22.3mm; inline-size: 162.2mm; block-size: 8.0mm; font-size: 11.4pt"><li>{{ slot_2 }}</li></ul>
<div class="box ph" style="inset-inline-start: 34.5mm; inset-block-start: 34.3mm; inline-size: 121.3mm; block-size: 100.1mm; font-size: 40.0pt"></div>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 142.4mm; inline-size: 116.5mm; block-size: 3.9mm; font-size: 11.2pt"><li>{{ slot_3 }}</li></ul>
<div class="box ph" style="inset-inline-start: 50.8mm; inset-block-start: 154.8mm; inline-size: 113.3mm; block-size: 81.2mm; font-size: 40.0pt"></div>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 262.7mm; inline-size: 16.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 97.8mm; inset-block-start: 262.7mm; inline-size: 18.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_5 }}</footer>
</div></body>
</html>
