<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-columns: 1fr 3fr 1fr;
    grid-template-rows: auto auto;
}
header {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
}
#cart, #search {
    margin: 10px;
}
button {
    margin: 5px;
}
#category {
    display: flex;
    flex-direction: column;
    grid-row: 2;
    grid-column: 1;
}
#sidebar, #sidebar2 {
    display: flex;
    flex-direction: column;
    align-items: center;
}
#sidebar {
    grid-row: 2 / -1;
    grid-column: 2;
}
#sidebar2 {
    grid-row: 2 / -1;
    grid-column: 3;
}
main {
    display: flex;
    flex-direction: column;
    grid-row: 2;
    grid-column: 2 / -1;
}
#restaurant1, #restaurant2 {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<button id="cart">{{ slot_1 }}</button>
</header>
<aside id="sidebar">
<p>{{ slot_2 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_3 }}</p>
</aside>
<aside id="sidebar2">
<p>{{ slot_4 }}</p>
<p>{{ slot_5 }}</p>
<p>{{ slot_6 }}</p>
</aside>
<section id="category">
<p>{{ slot_7 }}</p>
<button>{{ slot_8 }}</button>
<button>{{ slot_9 }}</button>
<button>{{ slot_10 }}</button>
</section>
<main>
<div id="restaurant1">
<p>{{ slot_11 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_12 }}</p>
</div>
<div id="restaurant2">
<p>{{ slot_13 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_14 }}</p>
</div>
</main>
</body>
</html>