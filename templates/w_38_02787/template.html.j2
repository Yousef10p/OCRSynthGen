<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<main>
<section class="hero">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</section>

<div id="image-placeholder">{{ slot_8 }}</div>
<section class="popular-items">
