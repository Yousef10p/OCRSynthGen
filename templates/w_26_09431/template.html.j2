    background: #fbfbfb;
    height: 100vh;
    margin: 20px;
}

.card {
    background: #f4f4f4;
    padding: 20px;
    margin: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
