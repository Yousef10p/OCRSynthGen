    background-color: var(--back-color-gray);
}

button {
    color: var(--text-color-light);
    background-color: var(--back-color-light);
    border: none;
    padding: 10px 20px;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
