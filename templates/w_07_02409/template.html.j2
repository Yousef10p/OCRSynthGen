:root {
    
    --brown: #694020;
    --light-brown: #806040;
    --white: #FFFFFF;
    --gray: #D3D3D3;

    
    --text-color-dark: var(--brown);
    --text-color-light: var(--white);
    
    
    --back-color-dark: var(--white);
    --back-color-light: var(--light-brown);
    --back-color-gray: var(--gray);
}

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: var(--back-color-dark);
    color: var(--text-color-dark);
}

header, footer {
    background-color: var(--back-color-light);
    color: var(--text-color-light);
    text-align: center;
    padding: 10px 0;
}

header h1, footer p {
    margin: 0;
}

ul {
    list-style-type: none;
    padding: 0;
}

li {
    display: inline;
    margin: 0 10px;
}

a {
    text-decoration: none;
    color: inherit;
}

section {
    padding: 20px;
