  top: 0;
  width: 100%;
  background: #333;
  padding: 20px 0;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin-left: 10px;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}

header {
  height: 500px;
  background: #f4f4f4;
  padding: 200px 0;
  text-align: center;
}

.btn {
