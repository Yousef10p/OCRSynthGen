<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #333;
    background: #ddd;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#logo {
    font-size: 3em;
    text-align: center;
    margin-top: 20px;
}

#tagline {
    font-size: 1.2em;
    text-align: center;
    margin: 10px 0 20px;
    font-style: italic;
}

nav {
    width: 100%;
    background: #333;
    display: flex;
    justify-content: space-around;
    padding: 20px 0;
    position: sticky;
    top: 0;
}

nav ul {
    list-style: none;
    display: flex;
}

nav ul li a {
    color: #ddd;
    text-decoration: none;
    margin: 0 20px;
}

main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    width: 80%;
}

#home-content {
    flex: 1 1 600px;
    margin-left: 20px;
}

#home-img {
    flex: 1 1 400px;
    background-size: cover;
    background-position: center;
    margin-bottom: 20px;
}

footer {
    width: 100%;
    background: #333;
    color: #ddd;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0;
    margin-top: 40px;
    position: sticky;
    bottom: 0;
}
footer a {
    color: #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
