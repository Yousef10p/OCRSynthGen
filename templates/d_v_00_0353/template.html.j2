<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 155.3mm; inset-block-start: 24.2mm; inline-size: 28.1mm; block-size: 25.3mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 155.4mm; inset-block-start: 57.7mm; inline-size: 27.2mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 1.3mm; inset-block-start: 77.5mm; inline-size: 212.9mm; block-size: 85.8mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 27.2mm; inset-block-start: 177.2mm; inline-size: 107.7mm; block-size: 14.1mm; font-size: 13.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 27.2mm; inset-block-start: 199.1mm; inline-size: 107.7mm; block-size: 29.3mm; font-size: 13.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 27.2mm; inset-block-start: 236.1mm; inline-size: 107.7mm; block-size: 24.0mm; font-size: 13.6pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 105.4mm; inset-block-start: 270.0mm; inline-size: 5.1mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</footer>
</div></body>
</html>
