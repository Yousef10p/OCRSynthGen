<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}
header {
    background-color: #f8f9fa;
    padding: 10px 0;
    position: fixed;
    width: 100%;
    top: 0;
}
nav {
    display: flex;
    justify-content: space-around;
    max-width: 800px;
    margin: auto;
}
nav ul li {
    list-style: none;
    display: inline-block;
}
nav ul li a {
    text-decoration: none;
    color: #495057;
}
#slideshow {
    width: 100%;
    height: 500px;
    background-color: #dee2e6;
    display: flex;
}
#slideshow .slideshow-image {
    width: 100%;
    height: 100%;
}
aside {
    padding: 20px 0;
    width: 200px;
    background-color: #ced4da;
    position: fixed;
    left: 0;
    top: 100px;
    bottom: 0;
    overflow: auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</header>
<section id="slideshow">
<div class="slideshow-image ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="slideshow-image ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="slideshow-image ph" style="inline-size: 100%; block-size: 150px"></div>
</section>
<aside>
<h2>{{ slot_3 }}</h2>
<p><a>{{ slot_4 }}</a></p>
<p><a>{{ slot_5 }}</a></p>
<p><a>{{ slot_6 }}</a></p>
<h2>{{ slot_7 }}</h2>
<p><a>{{ slot_8 }}</a></p>
<p><a>{{ slot_9 }}</a></p>
<p><a>{{ slot_10 }}</a></p>
<h2>{{ slot_11 }}</h2>
<p><a>{{ slot_12 }}</a></p>
<p><a>{{ slot_13 }}</a></p>
<p><a>{{ slot_14 }}</a></p>
</aside>
</body>
</html>