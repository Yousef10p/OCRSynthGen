.featured .product .image-placeholder, .blog article .image-placeholder {
    width: 100px;
    height: 100px;
    background: #3498db;
    margin-left: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
