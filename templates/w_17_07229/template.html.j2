<li>{{ slot_4 }}</li>
</ul>
<h2>{{ slot_5 }}</h2>
<ul>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
<h2>{{ slot_8 }}</h2>
<ul>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</div>
<div class="main">
<h2>{{ slot_11 }}</h2>
<div class="product-image ph"></div>
