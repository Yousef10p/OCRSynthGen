}
.product-box {
	width: 150px;
	height: 150px;
	margin: 1em;
	background-color: #ccc;
	display: flex;
	justify-content: center;
	align-items: center;
}
.footer {
	width: 100%;
	background-color: #f0f0f0;
	text-align: center;
	padding: 1em;
	position: fixed;
	bottom: 0;
	width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
