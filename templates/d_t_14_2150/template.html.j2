<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 157.0mm; inset-block-start: 12.1mm; inline-size: 41.8mm; block-size: 2.6mm; font-size: 8.0pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 30.6mm; inset-block-start: 22.4mm; inline-size: 36.6mm; block-size: 18.5mm; font-size: 17.5pt"></div>
<p class="box" style="inset-inline-start: 71.8mm; inset-block-start: 22.6mm; inline-size: 53.9mm; block-size: 8.0mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 71.8mm; inset-block-start: 35.5mm; inline-size: 63.7mm; block-size: 6.4mm; font-size: 8.0pt">{{ slot_2 }}</p>
<h1 class="box" style="inset-inline-start: 52.0mm; inset-block-start: 70.0mm; inline-size: 119.7mm; block-size: 14.4mm; font-size: 18.0pt">{{ slot_3 }}</h1>
<p class="box" style="inset-inline-start: 39.8mm; inset-block-start: 92.0mm; inline-size: 145.4mm; block-size: 21.6mm; font-size: 18.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 57.6mm; inset-block-start: 121.2mm; inline-size: 109.8mm; block-size: 7.0mm; font-size: 18.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 70.6mm; inset-block-start: 150.4mm; inline-size: 83.7mm; block-size: 7.0mm; font-size: 18.0pt">{{ slot_6 }}</h2>
<h2 class="box" style="inset-inline-start: 68.7mm; inset-block-start: 165.0mm; inline-size: 86.1mm; block-size: 7.0mm; font-size: 18.0pt">{{ slot_7 }}</h2>
<footer class="box" style="inset-inline-start: 31.8mm; inset-block-start: 280.8mm; inline-size: 42.6mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 176.5mm; inset-block-start: 280.8mm; inline-size: 2.7mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
