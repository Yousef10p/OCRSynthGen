<p class="box" style="inset-inline-start: 22.7mm; inset-block-start: 196.5mm; inline-size: 77.2mm; block-size: 18.7mm; font-size: 13.2pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 112.0mm; inset-block-start: 204.4mm; inline-size: 81.7mm; block-size: 44.7mm; font-size: 14.1pt">{{ slot_8 }}</p>
