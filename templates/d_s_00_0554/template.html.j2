<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 20.0mm; inset-block-start: 19.4mm; inline-size: 39.3mm; block-size: 39.4mm; font-size: 16.0pt"></div>
<div class="box ph" style="inset-inline-start: 156.5mm; inset-block-start: 19.4mm; inline-size: 39.3mm; block-size: 39.3mm; font-size: 15.9pt"></div>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 59.9mm; inline-size: 67.8mm; block-size: 14.5mm; font-size: 13.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 126.9mm; inset-block-start: 59.9mm; inline-size: 66.9mm; block-size: 14.4mm; font-size: 13.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 22.7mm; inset-block-start: 85.0mm; inline-size: 80.2mm; block-size: 34.3mm; font-size: 13.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 112.0mm; inset-block-start: 85.0mm; inline-size: 81.6mm; block-size: 65.5mm; font-size: 14.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.7mm; inset-block-start: 123.9mm; inline-size: 78.3mm; block-size: 29.1mm; font-size: 13.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 112.0mm; inset-block-start: 155.1mm; inline-size: 80.4mm; block-size: 44.7mm; font-size: 14.1pt">{{ slot_5 }}</p>
