<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 29.2mm; inline-size: 88.3mm; block-size: 40.8mm; font-size: 11.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.6mm; inset-block-start: 33.1mm; inline-size: 85.2mm; block-size: 7.0mm; font-size: 9.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 15.6mm; inset-block-start: 41.6mm; inline-size: 88.5mm; block-size: 36.6mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 71.5mm; inline-size: 87.0mm; block-size: 36.6mm; font-size: 11.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 15.6mm; inset-block-start: 79.6mm; inline-size: 87.8mm; block-size: 53.5mm; font-size: 11.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 109.5mm; inline-size: 86.9mm; block-size: 23.9mm; font-size: 11.3pt">{{ slot_7 }}</p>
