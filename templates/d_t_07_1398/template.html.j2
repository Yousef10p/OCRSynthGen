<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 150.2mm; inset-block-start: 9.6mm; inline-size: 53.7mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 20.1mm; inset-block-start: 20.6mm; inline-size: 83.7mm; block-size: 10.2mm; font-size: 28.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 19.8mm; inset-block-start: 59.7mm; inline-size: 139.8mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 65.4mm; inline-size: 55.9mm; block-size: 3.4mm; font-size: 9.6pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 19.9mm; inset-block-start: 71.2mm; inline-size: 164.1mm; block-size: 3.4mm; font-size: 9.6pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 19.1mm; inset-block-start: 76.9mm; inline-size: 168.9mm; block-size: 16.1mm; font-size: 11.4pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.1mm; inset-block-start: 95.3mm; inline-size: 164.8mm; block-size: 24.6mm; font-size: 11.6pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.1mm; inset-block-start: 122.2mm; inline-size: 159.3mm; block-size: 11.9mm; font-size: 11.2pt"><li>{{ slot_7 }}</li></ul>
<p class="box" style="inset-inline-start: 19.8mm; inset-block-start: 136.4mm; inline-size: 134.2mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 16.1mm; inset-block-start: 142.4mm; inline-size: 176.3mm; block-size: 133.5mm; font-size: 14.0pt"></div>
</div></body>
</html>
