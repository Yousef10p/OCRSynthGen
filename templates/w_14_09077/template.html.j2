</ul>
</div>
<div id="contact-form">
        {{ slot_6 }} <span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span><br>
        {{ slot_8 }} <span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span><br>
        {{ slot_10 }} <span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_11 }}</span><br>
<button>{{ slot_12 }}</button>
</div>
<div id="main-content">
