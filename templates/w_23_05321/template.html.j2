}
nav ul {
    list-style-type: none;
}
nav ul li {
    display: inline;
    margin: 0 10px;
}
header a, footer a{
    color: white;
    text-decoration: none;
}
#slideshow {
    width: 100%;
    height: 600px;
    background: red;
}
.filters {
    width: 20%;
