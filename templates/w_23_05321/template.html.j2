    padding: 10px 0;
    text-align: center;
}
.product-item {
    height: 200px;
    width: 200px;
    background: grey;
    display: inline-block;
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
