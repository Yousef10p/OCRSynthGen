    align-items: center;
}

.contact form input,
.contact form textarea {
    width: 80%;
    margin: 10px;
    padding: 10px;
    border: none;
    border-radius: 5px;
}

.contact form input[type="submit"] {
    background-color: #aaf;
    color: white;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
