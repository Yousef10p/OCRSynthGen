}

.hero-image {
    height: 200px;
    background-color: lightgrey;
}

.cta-button {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    background-color: lightblue;
    border: none;
    padding: 10px 20px;
    font-size: 20px;
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
    background-color: darkgrey;
}

nav ul li a {
    text-decoration: none;
    color: white;
}

.product, .testimonial {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 20px 0;
}

.product-image, .client-image {
    width: 100px;
    height: 100px;
    background-color: lightgrey;
}

footer {
    background-color: darkgrey;
    color: white;
    text-align: center;
    padding: 20px 0;
}

footer ul {
    list-style-type: none;
    padding: 0;
}

footer ul li {
    display: inline;
    margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
