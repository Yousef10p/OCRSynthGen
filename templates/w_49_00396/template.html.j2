    align-items: center;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

.destination, .blog-post, .review {
    position: relative;
    width: 200px;
    height: 200px;
    margin: 10px;
}

.destination {
    background-color: red;
}

.blog-post {
    background-color: blue;
}

.review {
    background-color: green;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    left: 0;
    text-align: center;
}

button {
    font-size: 20px;
    padding: 10px 20px;
    background-color: grey;
    color: white;
    border: none;
    border-radius: 5px;
    margin: 20px;
}

button:hover {
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
