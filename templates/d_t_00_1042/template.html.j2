<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 43.3mm; inline-size: 87.1mm; block-size: 54.0mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 83.5mm; inline-size: 88.2mm; block-size: 54.0mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 98.3mm; inline-size: 88.5mm; block-size: 96.3mm; font-size: 11.9pt">{{ slot_6 }}</p>
