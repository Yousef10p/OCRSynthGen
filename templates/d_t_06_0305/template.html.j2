<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 128.0mm; inset-block-start: 18.8mm; inline-size: 63.3mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 145.4mm; inset-block-start: 26.6mm; inline-size: 45.9mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 35.2mm; inline-size: 68.6mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 44.1mm; inline-size: 161.8mm; block-size: 30.8mm; font-size: 14.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 80.3mm; inline-size: 162.4mm; block-size: 19.9mm; font-size: 14.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 30.2mm; inset-block-start: 105.6mm; inline-size: 50.7mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 111.1mm; inline-size: 162.1mm; block-size: 58.0mm; font-size: 15.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 174.5mm; inline-size: 162.4mm; block-size: 36.2mm; font-size: 14.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 216.2mm; inline-size: 162.4mm; block-size: 25.3mm; font-size: 14.4pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 108.6mm; inset-block-start: 263.7mm; inline-size: 82.9mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_9 }}</footer>
</div></body>
</html>
