* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: #f8f8f8;
  font-family: var(--font-body);
  color: #333;
}

header {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background-color: #333;
  color: #fff;
}

header a {
  color: #fff;
  text-decoration: none;
}

main, aside {
  margin-top: 80px;
}

main {
  flex: 1;
  padding: 20px;
}

.product {
  width: 200px;
  height: 200px;
  background-color: #ccc;
  margin: 20px 0;
}

button {
  background-color: #333;
  color: #fff;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
}

aside {
  width: 300px;
  padding: 20px;
  border-right: 1px solid #ccc;
  height: 100vh;
  overflow-y: scroll;
}

footer {
  position: fixed;
  bottom: 0;
  right: 0;
  left: 0;
  padding: 20px;
  background-color: #333;
  color: #fff;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
