<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 130.0mm; inset-block-start: 0.1mm; inline-size: 79.9mm; block-size: 61.1mm; font-size: 14.4pt"></div>
<h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 35.3mm; inline-size: 25.9mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 56.4mm; inline-size: 68.5mm; block-size: 13.7mm; font-size: 19.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 130.0mm; inset-block-start: 64.1mm; inline-size: 27.5mm; block-size: 5.5mm; font-size: 7.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 85.2mm; inline-size: 72.0mm; block-size: 31.6mm; font-size: 12.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 85.2mm; inline-size: 73.8mm; block-size: 41.9mm; font-size: 13.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 118.8mm; inline-size: 73.8mm; block-size: 41.2mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 128.3mm; inline-size: 73.5mm; block-size: 27.5mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 157.1mm; inline-size: 72.7mm; block-size: 56.3mm; font-size: 13.3pt">{{ slot_7 }}</p>
