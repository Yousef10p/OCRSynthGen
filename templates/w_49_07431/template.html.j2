<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    padding: 1rem;
    background: linear-gradient(to bottom left, #333, #999);
    min-height: 100vh;
}
body > div {
    background: white;
    padding: 1rem;
    font-size: 1.2rem;
    text-align: center;
}
.nav-items {
    display: flex;
    justify-content: space-around;
}
.card {
    grid-row: span 2;
    margin: 3rem;
    padding: 2rem;
    background-color: #f4f4f4;
    box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
    transition: 0.3s;
}
.card:hover {
    box-shadow: 0 8px 16px 0 rgba(0,0,0,0.2);
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navbar">
<div class="logo ph"></div>
<div class="nav-items">
<div class="nav-item">{{ slot_0 }}</div>
<div class="nav-item">{{ slot_1 }}</div>
<div class="nav-item">{{ slot_2 }}</div>
<div class="nav-item">{{ slot_3 }}</div>
</div>
</div>
<div class="hero"></div>
<div class="card-container">
<div class="card">{{ slot_4 }}<p>{{ slot_5 }}</p></div>
<div class="card">{{ slot_6 }}<p>{{ slot_7 }}</p></div>
<div class="card">{{ slot_8 }}<p>{{ slot_9 }}</p></div>
<div class="card">{{ slot_10 }}<p>{{ slot_11 }}</p></div>
<div class="card">{{ slot_12 }}<p>{{ slot_13 }}</p></div>
<div class="card">{{ slot_14 }}<p>{{ slot_15 }}</p></div>
</div>
</body>
</html>