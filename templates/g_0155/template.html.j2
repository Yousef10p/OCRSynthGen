<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.8; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 24mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page"><main style="display: grid; column-gap: 7mm; grid-template-columns: 2.4fr 1fr"><div>
<ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_0 }}<ol style="list-style-type: arabic-indic; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
</ol>
</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ol>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 58mm; margin-inline: auto; inline-size: 75%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_5 }}</figcaption></figure><ol style="list-style-type: decimal; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ol>
<p style="margin-block: 0 0.4em; text-indent: 0; text-align: var(--align); font-size: 1.05em">{{ slot_11 }}</p>
</div>
<aside style="background: #f2f2f2; padding: 0.6em; border-inline-start: 1px solid #999"><h3>{{ slot_12 }}</h3>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_13 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_14 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_15 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_16 }}</p>
<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_17 }}</li>
<li>{{ slot_18 }}</li>
</ul></aside></main></div></body>
</html>
