<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 27.0mm; inset-block-start: 25.4mm; inline-size: 161.3mm; block-size: 14.0mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 40.0mm; inset-block-start: 47.3mm; inline-size: 135.2mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 50.7mm; inset-block-start: 55.0mm; inline-size: 114.0mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 61.8mm; inline-size: 6.4mm; block-size: 155.2mm; font-size: 20.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 74.8mm; inset-block-start: 62.9mm; inline-size: 65.6mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 98.2mm; inset-block-start: 71.4mm; inline-size: 18.9mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 79.8mm; inline-size: 164.5mm; block-size: 79.9mm; font-size: 10.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 167.8mm; inline-size: 54.3mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 256.2mm; inline-size: 58.2mm; block-size: 3.8mm; font-size: 8.5pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 104.5mm; inset-block-start: 266.9mm; inline-size: 2.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
