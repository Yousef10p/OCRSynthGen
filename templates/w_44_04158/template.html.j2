<p>{{ slot_5 }}</p>
<button id="order-now">{{ slot_6 }}</button>
<div class="animated-image ph"></div>
<section id="menu">
<h2>{{ slot_7 }}</h2>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
</ul>
</section>
<section id="order">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<form>

</form>
</section>
</main>
<footer>
