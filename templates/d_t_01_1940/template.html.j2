<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 23.2mm; inset-block-start: 14.7mm; inline-size: 130.0mm; block-size: 47.7mm; font-size: 15.0pt"></div>
<header class="box" style="inset-inline-start: 206.1mm; inset-block-start: 32.7mm; inline-size: 1.8mm; block-size: 21.7mm; font-size: 30.8pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 69.7mm; inline-size: 162.0mm; block-size: 16.9mm; font-size: 16.0pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 206.1mm; inset-block-start: 72.1mm; inline-size: 1.8mm; block-size: 26.7mm; font-size: 37.8pt">{{ slot_2 }}</header><div class="box ph" style="inset-inline-start: 20.3mm; inset-block-start: 93.7mm; inline-size: 82.5mm; block-size: 71.7mm; font-size: 14.5pt"></div>
<header class="box" style="inset-inline-start: 206.1mm; inset-block-start: 111.5mm; inline-size: 1.8mm; block-size: 6.8mm; font-size: 19.3pt">{{ slot_3 }}</header><header class="box" style="inset-inline-start: 206.1mm; inset-block-start: 151.0mm; inline-size: 1.8mm; block-size: 22.8mm; font-size: 21.5pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 166.8mm; inline-size: 79.6mm; block-size: 98.0mm; font-size: 17.4pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 206.1mm; inset-block-start: 190.4mm; inline-size: 1.8mm; block-size: 18.4mm; font-size: 26.1pt">{{ slot_6 }}</header><header class="box" style="inset-inline-start: 206.1mm; inset-block-start: 229.8mm; inline-size: 1.8mm; block-size: 16.8mm; font-size: 23.8pt">{{ slot_7 }}</header><footer class="box" style="inset-inline-start: 206.3mm; inset-block-start: 270.1mm; inline-size: 1.7mm; block-size: 2.4mm; font-size: 6.9pt">{{ slot_8 }}</footer>
</div></body>
</html>
