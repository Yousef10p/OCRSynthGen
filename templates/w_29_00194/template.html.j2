    justify-content: space-between;
    align-items: center;
    padding: 10px;
    background-color: hsl(240, 50%, 50%);
}

nav ul {
    display: flex;
    list-style-type: none;
    margin: 0;
    padding: 0;
}

nav ul li {
    margin-right: 10px;
    color: white;
}

nav ul li a {
    text-decoration: none;
    color: white;
}

input[type="text"] {
    padding: 5px;
    margin-right: 20px;
}

main {
    padding: 20px;
}

article {
    margin-bottom: 20px;
}

footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    background-color: hsl(240, 100%, 50%);
    color: white;
    text-align: center;
    padding: 10px;
}

footer img {
    width: 50px;
    height: 50px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
