<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 23.2mm; inset-block-start: 18.9mm; inline-size: 140.2mm; block-size: 18.1mm; font-size: 17.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 22.7mm; inset-block-start: 42.7mm; inline-size: 62.0mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 32.8mm; inset-block-start: 51.2mm; inline-size: 7.2mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 32.8mm; inset-block-start: 59.5mm; inline-size: 160.8mm; block-size: 8.1mm; font-size: 11.5pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 32.8mm; inset-block-start: 72.1mm; inline-size: 160.9mm; block-size: 16.7mm; font-size: 11.8pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 32.8mm; inset-block-start: 93.3mm; inline-size: 161.2mm; block-size: 25.3mm; font-size: 11.9pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 32.8mm; inset-block-start: 123.0mm; inline-size: 160.9mm; block-size: 33.8mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 32.8mm; inset-block-start: 161.3mm; inline-size: 161.0mm; block-size: 29.5mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 32.8mm; inset-block-start: 195.3mm; inline-size: 160.8mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 22.7mm; inset-block-start: 265.7mm; inline-size: 79.4mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_9 }}</footer>
</div></body>
</html>
