<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 23.7mm; inset-block-start: 24.1mm; inline-size: 59.0mm; block-size: 59.2mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 141.7mm; inset-block-start: 24.3mm; inline-size: 58.0mm; block-size: 59.6mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 23.7mm; inset-block-start: 83.7mm; inline-size: 58.6mm; block-size: 59.6mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 141.1mm; inset-block-start: 84.1mm; inline-size: 59.0mm; block-size: 59.4mm; font-size: 15.3pt"></div>
<header class="box" style="inset-inline-start: 1.9mm; inset-block-start: 85.2mm; inline-size: 3.2mm; block-size: 109.2mm; font-size: 40.0pt">{{ slot_0 }}</header><h1 class="box" style="inset-inline-start: 91.6mm; inset-block-start: 96.2mm; inline-size: 43.6mm; block-size: 29.7mm; font-size: 28.1pt">{{ slot_1 }}</h1>
<div class="box ph" style="inset-inline-start: 23.5mm; inset-block-start: 143.7mm; inline-size: 58.6mm; block-size: 60.2mm; font-size: 15.5pt"></div>
<div class="box ph" style="inset-inline-start: 82.1mm; inset-block-start: 143.3mm; inline-size: 59.0mm; block-size: 60.6mm; font-size: 15.6pt"></div>
<div class="box ph" style="inset-inline-start: 141.3mm; inset-block-start: 143.9mm; inline-size: 59.2mm; block-size: 59.6mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 82.2mm; inset-block-start: 224.4mm; inline-size: 58.7mm; block-size: 26.9mm; font-size: 15.2pt"></div>
</div></body>
</html>
