    padding: 10px;
    color: #fff;
    text-align: center;
}

header h1 {
    margin: 0;
}

header form input {
    margin: 10px 0;
    padding: 5px;
}

nav {
    background-color: #ddd;
    padding: 10px;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline-block;
    margin: 0 10px;
}

main {
    padding: 20px;
}

main div {
    margin-bottom: 20px;
}

.img-placeholder {
    background-color: #aaa;
    height: 200px;
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
