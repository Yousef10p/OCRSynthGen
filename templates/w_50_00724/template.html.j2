}

.logo, .search-bar, .btn-appointment {
    background-color: #d3d3d3;
    color: #000;
    padding: 10px;
    height: 20px;
}

.btn-appointment {
    cursor: pointer;
}

.section {
    margin: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
