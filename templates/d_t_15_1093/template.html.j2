<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 135.2mm; inline-size: 83.2mm; block-size: 27.9mm; font-size: 9.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 143.0mm; inline-size: 85.0mm; block-size: 46.7mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 168.6mm; inline-size: 84.7mm; block-size: 29.4mm; font-size: 11.9pt">{{ slot_4 }}</p>
