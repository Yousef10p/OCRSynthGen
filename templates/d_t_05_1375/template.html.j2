<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 22.6mm; inline-size: 55.0mm; block-size: 48.6mm; font-size: 13.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 85.4mm; inset-block-start: 22.6mm; inline-size: 55.3mm; block-size: 73.7mm; font-size: 13.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 146.2mm; inset-block-start: 22.6mm; inline-size: 54.9mm; block-size: 48.6mm; font-size: 13.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 146.2mm; inset-block-start: 72.8mm; inline-size: 55.2mm; block-size: 53.7mm; font-size: 13.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 24.5mm; inset-block-start: 77.3mm; inline-size: 48.3mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 87.8mm; inline-size: 55.3mm; block-size: 38.6mm; font-size: 13.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 85.4mm; inset-block-start: 97.9mm; inline-size: 53.7mm; block-size: 28.6mm; font-size: 13.5pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 16.7mm; inset-block-start: 141.2mm; inline-size: 73.3mm; block-size: 130.8mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 121.8mm; inset-block-start: 142.0mm; inline-size: 79.5mm; block-size: 11.9mm; font-size: 16.8pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 97.2mm; inset-block-start: 217.9mm; inline-size: 25.7mm; block-size: 10.2mm; font-size: 9.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 150.0mm; inset-block-start: 260.7mm; inline-size: 51.2mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_9 }}</footer>
</div></body>
</html>
