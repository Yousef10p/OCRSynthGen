<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div id="center-column">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<div class="recipe">{{ slot_7 }}</div>
<div class="recipe">{{ slot_8 }}</div>
<div class="recipe">{{ slot_9 }}</div>
</div>
<div class="clearfix"></div>
</div>
<div id="footer">
