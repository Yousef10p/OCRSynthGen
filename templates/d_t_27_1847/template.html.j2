<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 7.3mm; inline-size: 94.7mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 12.2mm; inline-size: 44.3mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 20.9mm; inline-size: 76.9mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 29.0mm; inline-size: 196.3mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 32.3mm; inline-size: 198.0mm; block-size: 16.1mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 52.4mm; inline-size: 199.4mm; block-size: 32.3mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 88.8mm; inline-size: 199.0mm; block-size: 22.6mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 115.4mm; inline-size: 196.8mm; block-size: 16.1mm; font-size: 13.0pt">{{ slot_7 }}</p>
