<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 101.1mm; inset-block-start: 25.2mm; inline-size: 14.6mm; block-size: 5.5mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 31.2mm; inline-size: 148.0mm; block-size: 8.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 44.7mm; inline-size: 24.0mm; block-size: 5.5mm; font-size: 12.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 55.5mm; inline-size: 165.2mm; block-size: 47.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 109.1mm; inline-size: 164.3mm; block-size: 42.8mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 157.8mm; inline-size: 163.7mm; block-size: 42.8mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 206.4mm; inline-size: 164.9mm; block-size: 42.8mm; font-size: 12.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 85.6mm; inset-block-start: 263.4mm; inline-size: 39.3mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 186.3mm; inset-block-start: 263.6mm; inline-size: 4.2mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
