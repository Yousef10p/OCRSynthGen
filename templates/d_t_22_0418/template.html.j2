<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 141.3mm; inset-block-start: 13.8mm; inline-size: 33.2mm; block-size: 5.0mm; font-size: 14.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.5mm; inset-block-start: 25.9mm; inline-size: 141.5mm; block-size: 31.9mm; font-size: 18.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 47.5mm; inset-block-start: 61.3mm; inline-size: 112.2mm; block-size: 16.5mm; font-size: 15.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 34.5mm; inset-block-start: 83.1mm; inline-size: 141.5mm; block-size: 24.9mm; font-size: 17.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 44.8mm; inset-block-start: 111.6mm; inline-size: 118.3mm; block-size: 57.2mm; font-size: 16.2pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 34.7mm; inset-block-start: 171.4mm; inline-size: 52.2mm; block-size: 5.9mm; font-size: 16.8pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 34.5mm; inset-block-start: 180.7mm; inline-size: 141.8mm; block-size: 18.3mm; font-size: 17.3pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 43.8mm; inset-block-start: 202.1mm; inline-size: 132.5mm; block-size: 31.5mm; font-size: 17.8pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.9mm; inset-block-start: 236.9mm; inline-size: 132.5mm; block-size: 31.8mm; font-size: 18.0pt"><li>{{ slot_8 }}</li></ul>
</div></body>
</html>
