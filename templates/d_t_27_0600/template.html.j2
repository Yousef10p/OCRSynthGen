<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 48.3mm; inset-block-start: 25.2mm; inline-size: 33.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 30.5mm; inline-size: 82.1mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 36.5mm; inline-size: 89.7mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 42.5mm; inline-size: 140.7mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 52.7mm; inline-size: 96.4mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 58.7mm; inline-size: 103.9mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 64.7mm; inline-size: 98.8mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 70.7mm; inline-size: 108.0mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 76.7mm; inline-size: 92.3mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_8 }}</li></ul>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 84.5mm; inline-size: 138.4mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 48.2mm; inset-block-start: 97.4mm; inline-size: 142.1mm; block-size: 127.0mm; font-size: 15.0pt"></div>
