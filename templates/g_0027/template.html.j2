<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.6; --align: start; --page-width: 148mm; --page-height: 210mm; --page-margin: 17mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span></header><h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_1 }}</h1>
<main style="display: grid; column-gap: 7mm; grid-template-columns: 2.4fr 1fr"><div>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 0.6em 0.4em">{{ slot_2 }}</h2>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 44mm; margin-inline: auto; inline-size: 50%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_3 }}</figcaption></figure><ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_4 }}<ol style="list-style-type: decimal; margin-block: 0.3em; padding-inline-start: 1.8em">
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ol>
</li>
<li>{{ slot_7 }}</li>
</ol>
</div>
<aside style="background: transparent; padding: 0.6em; border-inline-start: none"><h3>{{ slot_8 }}</h3>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_9 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_10 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_11 }}</p>
<p style="font-size: 0.9em; margin-block: 0 0.6em">{{ slot_12 }}</p>
<ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 1.8em">
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
<li>{{ slot_16 }}</li>
</ol></aside><div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
