    color: white;
    padding: 1em;
    text-align: center;
}

.property-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    grid-gap: 1em;
    margin: 1em;
}

.property {
    border: 1px solid #000;
