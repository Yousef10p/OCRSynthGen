<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


header {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    background-color: #333;
    color: #fff;
    padding: 10px;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline-block;
    margin-left: 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}


#banner {
    background-color: #ccc;
    text-align: center;
    padding: 100px 0;
}

#banner h1 {
    font-size: 3em;
    margin: 20px 0;
}

#banner button {
    padding: 10px 20px;
    background-color: #007BFF;
    color: #fff;
    border: none;
    cursor: pointer;
}

#banner button:hover {
    background-color: #0056b3;
}


main {
    margin-top: 120px;
}

main section {
    padding: 20px;
}

main section h2 {
    font-size: 2em;
    margin-bottom: 10px;
}

main section p {
    margin-bottom: 20px;
}

main section form {
    display: grid;
    gap: 10px;
}

main section form input, main section form textarea {
    padding: 10px;
}

main section form button {
    padding: 10px 20px;
    background-color: #007BFF;
    color: #fff;
    border: none;
    cursor: pointer;
}

main section form button:hover {
    background-color: #0056b3;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
