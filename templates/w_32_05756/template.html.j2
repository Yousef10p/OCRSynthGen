    top: 0;
    right: 0;
    width: 100%;
    height: 100vh;
}

header .slider .slide {
    width: 100%;
    height: 100vh;
}

h1, h2, p {
    padding: 10px;
}

footer {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
