    background-color: #0000ff;
    color: #ffffff;
}
header {
    background-color: #ff0000;
    text-align: center;
    padding: 20px;
}
nav ul {
    list-style-type: none;
}
nav ul li {
    display: inline;
    margin: 0 10px;
}
nav ul li a {
    text-decoration: none;
    color: #ffffff;
}
h1, h2, h3 {
    color: #ffff00;
}
.player, .schedule {
    border: 1px solid #ffffff;
    margin: 20px;
    padding: 20px;
}
.placeholder {
    background-color: #ffffff;
    width: 200px;
    height: 200px;
    display: block;
    margin: auto;
}
footer {
    background-color: #ff0000;
    text-align: center;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
