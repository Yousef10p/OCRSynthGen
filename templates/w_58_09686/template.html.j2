    padding: 20px;
}

.blog-post .blog-image {
    width: 50%;
    height: 200px;
}

.cta {
    background-color: green;
    width: 100%;
    text-align: center;
}

button {
    background-color: yellow;
    border: none;
    padding: 10px 20px;
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
