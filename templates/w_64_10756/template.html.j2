<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  color: white;
  background-color: blue;
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: red;
  padding: 20px;
}
.logo {
  font-size: 24px;
  font-weight: bold;
}
nav ul {
  display: flex;
  list-style-type: none;
}
nav ul li {
  margin: 0 15px;
}
.banner {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}
.banner h1 {
  font-size: 36px;
}
.banner button {
  background-color: white;
  color: red;
  border: none;
  padding: 15px 30px;
  margin-top: 30px;
  cursor: pointer;
}
.content {
  margin: 50px;
  text-align: center;
}
.contact form {
  display: grid;
  grid-gap: 20px;
  margin-top: 50px;
}
.contact input, .contact textarea {
  padding: 10px;
  border: none;
}
footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: red;
  color: white;
  padding: 20px;
}
.social-icons a {
  color: white;
  margin: 0 15px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
