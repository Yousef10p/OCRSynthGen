<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 140.6mm; inset-block-start: 2.3mm; inline-size: 69.2mm; block-size: 34.8mm; font-size: 14.1pt"></div>
<div class="box ph" style="inset-inline-start: 14.7mm; inset-block-start: 17.6mm; inline-size: 41.6mm; block-size: 19.7mm; font-size: 14.0pt"></div>
<p class="box" style="inset-inline-start: 44.5mm; inset-block-start: 56.3mm; inline-size: 141.4mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 82.1mm; inline-size: 101.6mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 90.7mm; inline-size: 160.5mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 112.1mm; inline-size: 160.4mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 129.2mm; inline-size: 160.3mm; block-size: 30.0mm; font-size: 10.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 163.5mm; inline-size: 27.2mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 167.9mm; inline-size: 160.4mm; block-size: 34.2mm; font-size: 10.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 208.5mm; inline-size: 90.4mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_7 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 217.0mm; inline-size: 109.5mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 221.3mm; inline-size: 160.5mm; block-size: 12.9mm; font-size: 10.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 238.4mm; inline-size: 160.5mm; block-size: 12.9mm; font-size: 10.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 264.8mm; inline-size: 138.2mm; block-size: 6.9mm; font-size: 8.0pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 200.4mm; inset-block-start: 282.3mm; inline-size: 5.3mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
