<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.6mm; inset-block-start: 16.8mm; inline-size: 174.3mm; block-size: 139.4mm; font-size: 8.2pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 158.3mm; inline-size: 69.9mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 13.7mm; inset-block-start: 166.9mm; inline-size: 85.2mm; block-size: 82.7mm; font-size: 13.0pt"></div>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 165.6mm; inline-size: 86.9mm; block-size: 18.3mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 188.1mm; inline-size: 86.7mm; block-size: 18.3mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.6mm; inset-block-start: 251.5mm; inline-size: 78.5mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.5mm; inline-size: 5.2mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_4 }}</footer>
</div></body>
</html>
