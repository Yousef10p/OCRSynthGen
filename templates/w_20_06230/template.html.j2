  padding: 0;
}
.menu li {
  float: right;
}
.menu li a {
  display: block;
  color: white;
  text-decoration: none;
  padding: 14px 16px;
}
.content {
  margin-right: 25%;
  margin-left: 25%;
  padding: 16px;
