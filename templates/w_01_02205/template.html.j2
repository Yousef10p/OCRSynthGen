<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

nav {
    position: absolute;
    top: 0;
    right: 0;
    background: #f9f9f9;
    width: 100%;
}

nav ul {
    list-style: none;
}

nav ul li {
    display: inline-block;
    margin-left: 10px;
}

nav ul li a {
    text-decoration: none;
    color: #333;
}

.slider {
    height: calc(100vh - 50px);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.slider .slide {
    width: calc(100% / 3);
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #f9f9f9;
}

section {
    margin-top: calc(100vh - 50px);
    padding: 20px;
}

section article {
    margin-bottom: 20px;
}

section article h2 {
    margin-bottom: 10px;
}

.read-more {
    display: block;
    text-align: left;
    margin-top: 10px;
    text-decoration: none;
    color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<div class="slider">
<div class="slide">{{ slot_3 }}</div>
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
</div>
<section>
<article>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<a class="read-more">{{ slot_8 }}</a>
</article>
<article>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<a class="read-more">{{ slot_11 }}</a>
</article>
<article>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<a class="read-more">{{ slot_14 }}</a>
</article>
</section>
</body>
</html>