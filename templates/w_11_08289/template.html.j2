.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  margin: 0px;
  padding: 0px;
  font-family: var(--font-body);
}

a {
  text-decoration: none;
  color: black;
}

header, footer {
  background-color: lightgrey;
  padding: 10px;
  display: flex;
  justify-content: space-around;
}

main {
  margin: 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 20px;
}

section {
  border: 1px solid black;
  padding: 10px;
  display: flex;
  flex-direction: column;
}

h2 {
  margin-bottom: 10px;
}

p {
  margin-bottom: 10px;
}

.image-placeholder {
  width: 100%;
  height: 100px;
  background-color: lightgrey;
  margin-top: auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
