<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 16.0mm; inline-size: 103.8mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 23.9mm; inline-size: 178.7mm; block-size: 19.9mm; font-size: 11.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 47.7mm; inline-size: 179.2mm; block-size: 23.8mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 75.5mm; inline-size: 179.0mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 95.4mm; inline-size: 179.4mm; block-size: 15.9mm; font-size: 11.2pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 137.5mm; inset-block-start: 122.1mm; inline-size: 52.2mm; block-size: 14.2mm; font-size: 13.4pt"></div>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 127.1mm; inline-size: 29.0mm; block-size: 11.9mm; font-size: 11.3pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 155.4mm; inset-block-start: 262.0mm; inline-size: 42.6mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_6 }}</footer>
</div></body>
</html>
