<h2 class="box" style="inset-inline-start: 22.8mm; inset-block-start: 40.2mm; inline-size: 18.5mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 22.8mm; inset-block-start: 43.6mm; inline-size: 55.2mm; block-size: 6.5mm; font-size: 6.2pt">{{ slot_5 }}</p>
