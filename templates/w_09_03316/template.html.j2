}
#top-products li {
	width: 200px;
	margin-bottom: 20px;
	border: 1px solid #CCC;
	padding: 20px;
	text-align: center;
}
#top-products li img {
	width: 100px;
	height: 100px;
	background-color: #CCC;
}
footer {
	width: 100%;
	text-align: center;
	padding: 20px;
