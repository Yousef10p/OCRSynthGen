}
footer label {
	display: block;
	margin-bottom: 10px;
}
footer input[type="text"], footer textarea {
	width: 100%;
	margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
