<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 27.6mm; inset-block-start: 34.0mm; inline-size: 59.5mm; block-size: 16.3mm; font-size: 15.4pt"></div>
<h1 class="box" style="inset-inline-start: 80.4mm; inset-block-start: 73.9mm; inline-size: 44.1mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_0 }}</h1>
<h1 class="box" style="inset-inline-start: 76.0mm; inset-block-start: 87.6mm; inline-size: 54.8mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_1 }}</h1>
<h1 class="box" style="inset-inline-start: 36.7mm; inset-block-start: 101.3mm; inline-size: 133.3mm; block-size: 22.6mm; font-size: 16.0pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 91.7mm; inset-block-start: 128.5mm; inline-size: 21.5mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_3 }}</h1>
<h1 class="box" style="inset-inline-start: 54.7mm; inset-block-start: 151.3mm; inline-size: 97.4mm; block-size: 13.7mm; font-size: 16.0pt">{{ slot_4 }}</h1>
<p class="box" style="inset-inline-start: 43.9mm; inset-block-start: 197.5mm; inline-size: 117.3mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 38.3mm; inset-block-start: 208.9mm; inline-size: 130.2mm; block-size: 14.7mm; font-size: 16.0pt">{{ slot_6 }}</p>
</div></body>
</html>
