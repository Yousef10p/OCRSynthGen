<div class="box ph" style="inset-inline-start: 84.7mm; inset-block-start: 57.5mm; inline-size: 47.2mm; block-size: 44.6mm; font-size: 15.8pt"></div>
<p class="box" style="inset-inline-start: 80.4mm; inset-block-start: 109.9mm; inline-size: 26.8mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 82.4mm; inset-block-start: 116.5mm; inline-size: 52.9mm; block-size: 56.8mm; font-size: 14.6pt"></div>
