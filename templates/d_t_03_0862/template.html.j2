<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 355.6mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 44.2mm; inline-size: 237.3mm; block-size: 127.3mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 243.0mm; inset-block-start: 63.8mm; inline-size: 44.5mm; block-size: 10.6mm; font-size: 10.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 243.0mm; inset-block-start: 78.3mm; inline-size: 43.2mm; block-size: 6.1mm; font-size: 8.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 293.4mm; inset-block-start: 78.4mm; inline-size: 45.0mm; block-size: 23.8mm; font-size: 9.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 243.0mm; inset-block-start: 85.5mm; inline-size: 45.0mm; block-size: 48.6mm; font-size: 9.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 293.4mm; inset-block-start: 106.8mm; inline-size: 45.0mm; block-size: 9.5mm; font-size: 9.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 293.4mm; inset-block-start: 121.0mm; inline-size: 45.0mm; block-size: 23.8mm; font-size: 9.6pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 344.7mm; inset-block-start: 122.1mm; inline-size: 4.0mm; block-size: 30.8mm; font-size: 40.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 243.0mm; inset-block-start: 138.8mm; inline-size: 44.5mm; block-size: 6.0mm; font-size: 8.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 243.0mm; inset-block-start: 149.5mm; inline-size: 45.0mm; block-size: 6.0mm; font-size: 8.5pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 293.4mm; inset-block-start: 149.5mm; inline-size: 44.4mm; block-size: 6.0mm; font-size: 8.5pt">{{ slot_9 }}</p>
</div></body>
</html>
