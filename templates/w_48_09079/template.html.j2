<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: var(--font-body);
}


header {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100px;
    background-color: #f7f7f7;
}

#logo {
    margin-left: 50px;
    font-size: 2em;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin: 0 20px;
}


#main {
    display: flex;
    justify-content: space-between;
}

#featured, #calculator {
    width: 48%;
    padding: 20px;
}

.product, #calculator {
    border: 1px solid #ccc;
    margin-bottom: 20px;
    padding: 20px;
}


aside {
    width: 48%;
    padding: 20px;
    background-color: #f0f0f0;
}

ul {
    padding: 0;
}

ul li {
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div id="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<div id="main">
<section id="featured">
<h1>{{ slot_5 }}</h1>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>

</section>
<aside>
<h2>{{ slot_8 }}</h2>
<ul>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
<h2>{{ slot_11 }}</h2>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
</ul>
<div id="calculator">
<h2>{{ slot_14 }}</h2>

</div>
</aside>
</div>
</body>
</html>