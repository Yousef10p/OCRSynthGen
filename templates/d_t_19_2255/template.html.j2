<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 36.1mm; inline-size: 167.0mm; block-size: 30.4mm; font-size: 22.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 68.8mm; inline-size: 58.2mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 81.0mm; inline-size: 171.0mm; block-size: 30.4mm; font-size: 22.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 113.7mm; inline-size: 43.3mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 125.9mm; inline-size: 170.9mm; block-size: 30.4mm; font-size: 22.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 162.7mm; inline-size: 160.8mm; block-size: 46.7mm; font-size: 22.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 211.7mm; inline-size: 43.3mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 130.5mm; inset-block-start: 269.8mm; inline-size: 60.7mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_7 }}</footer>
</div></body>
</html>
