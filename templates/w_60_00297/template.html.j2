<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}


.header-area {
    background-color: #333;
    color: #fff;
}
.header-area nav ul {
    display: flex;
    justify-content: space-between;
    list-style: none;
    padding: 0;
}
.header-area nav ul li a {
    color: #fff;
    text-decoration: none;
    padding: 1em;
}


.search-area form {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}
.search-area form input[type="text"], 
.search-area form input[type="number"] {
    width: 100%;
    padding: 1em;
    margin-bottom: 1em;
    border-radius: 5px;
    border: none;
}
.search-area form button {
    padding: 1em;
    background-color: #333;
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}


.carousel-area img {
    display: block;
    width: 100%;
    height: 400px;
    object-fit: cover;
}


.sidebar-area {
    width: 30%;
    float: left;
    margin-top: 2em;
    background-color: #f1f1f1;
    padding: 2em;
}
.sidebar-area ul {
    list-style: none;
    padding: 0;
}
.sidebar-area ul li a {
    display: block;
    color: #333;
    text-decoration: none;
    padding: 1em;
}


footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 1em 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
