<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 15.7mm; inline-size: 45.3mm; block-size: 20.5mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 43.3mm; inline-size: 180.7mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 65.9mm; inline-size: 179.7mm; block-size: 26.7mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 97.5mm; inline-size: 180.7mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 124.6mm; inline-size: 176.5mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 142.6mm; inline-size: 176.7mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 156.1mm; inline-size: 163.6mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 169.7mm; inline-size: 125.7mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 27.8mm; inset-block-start: 214.9mm; inline-size: 95.9mm; block-size: 16.1mm; font-size: 15.2pt"></div>
<footer class="box" style="inset-inline-start: 199.8mm; inset-block-start: 262.8mm; inline-size: 3.4mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
