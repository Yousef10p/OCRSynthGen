    background-color: #bbb;
}

form {
    display: flex;
    flex-direction: column;
    width: 80%;
    margin: 40px;
}

input,
textarea,
button {
    margin: 10px 0;
    padding: 10px;
    border: none;
    border-radius: 5px;
}

button {
    background-color: #00f;
    color: #fff;
    cursor: pointer;
}

footer {
    text-align: center;
    padding: 20px;
    background-color: #00f;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
