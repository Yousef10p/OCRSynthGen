    margin: 50px;
}

.product {
    border: 1px solid black;
    padding: 10px;
    margin: 10px;
    text-align: center;
}

.product-image {
    height: 200px;
    width: 200px;
    background-color: grey;
    margin: auto;
}

footer {
    background-color: black;
    color: white;
    text-align: center;
    padding: 20px 0;
}

footer ul {
    list-style-type: none;
}

footer li {
    display: inline;
    margin: 0 10px;
}

footer a {
    color: white;
    text-decoration: none;
}

form {
    margin: 10px 0;
}

form label {
    margin-left: 10px;
}

form button {
    padding: 5px;
    background-color: white;
    color: black;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
