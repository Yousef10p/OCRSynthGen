body {
    font-family: var(--font-body);
}

header {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    background: #fff;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

nav > ul {
    list-style-type: none;
    padding: 0;
}

nav > ul > li {
    display: inline-block;
    margin: 0 10px;
}

nav > ul > li > a {
    text-decoration: none;
    color: #000;
}

section {
    height: 100vh;
    padding-top: 70px;
}

.slider {
    height: 50%;
}

.slide {
    height: 100%;
    width: 100%;
    background: #ddd;
    color: #000;
    text-align: center;
    line-height: 100vh;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    text-align: center;
    background: #fff;
    color: #000;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
