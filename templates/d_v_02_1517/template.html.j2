<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 72.6mm; inset-block-start: 17.0mm; inline-size: 4.1mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 218.3mm; inset-block-start: 17.3mm; inline-size: 3.8mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 33.1mm; inset-block-start: 26.8mm; inline-size: 83.2mm; block-size: 28.6mm; font-size: 11.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 179.4mm; inset-block-start: 27.0mm; inline-size: 82.7mm; block-size: 65.9mm; font-size: 11.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 58.9mm; inline-size: 83.0mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 33.5mm; inset-block-start: 78.2mm; inline-size: 82.9mm; block-size: 30.3mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 179.4mm; inset-block-start: 96.5mm; inline-size: 82.9mm; block-size: 45.3mm; font-size: 11.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 33.8mm; inset-block-start: 111.6mm; inline-size: 83.0mm; block-size: 16.0mm; font-size: 11.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 132.1mm; inline-size: 83.4mm; block-size: 62.7mm; font-size: 11.9pt">{{ slot_8 }}</p>
