}

form {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

form input, form textarea {
  margin-bottom: 10px;
  padding: 10px;
}

form input[type="submit"] {
  cursor: pointer;
  background-color: #333;
  color: #fff;
}

footer {
  position: fixed;
  bottom: 0;
  width: 100%;
  background-color: #333;
  color: #fff;
  text-align: center;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
