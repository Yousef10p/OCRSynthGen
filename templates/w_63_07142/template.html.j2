<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.header {
    position: sticky;
    top: 0;
    background: #333;
    color: #fff;
    padding: 20px;
}

.navbar {
    display: flex;
    justify-content: space-around;
    list-style-type: none;
    padding: 0;
}

.slider {
    width: 100%;
    overflow: hidden;
}

.slide {
    float: right;
    width: 100%;
}

.fakeimg {
    background: #aaa;
    width: 100%;
    height: 200px;
}

.catalog {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
}

.item {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<nav>
<ul class="navbar">
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</div>
<div class="slider">
<div class="slide"><div class="fakeimg">{{ slot_4 }}</div><p>{{ slot_5 }}</p></div>
<div class="slide"><div class="fakeimg">{{ slot_6 }}</div><p>{{ slot_7 }}</p></div>
<div class="slide"><div class="fakeimg">{{ slot_8 }}</div><p>{{ slot_9 }}</p></div>
</div>
<div class="catalog">
<div class="item"><div class="fakeimg">{{ slot_10 }}</div><p>{{ slot_11 }}</p></div>
<div class="item"><div class="fakeimg">{{ slot_12 }}</div><p>{{ slot_13 }}</p></div>
<div class="item"><div class="fakeimg">{{ slot_14 }}</div><p>{{ slot_15 }}</p></div>
</div>
</body>
</html>