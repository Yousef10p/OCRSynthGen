<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 197.3mm; inset-block-start: 8.6mm; inline-size: 3.6mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 25.6mm; inset-block-start: 27.6mm; inline-size: 77.7mm; block-size: 41.3mm; font-size: 11.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 110.9mm; inset-block-start: 26.6mm; inline-size: 31.3mm; block-size: 4.4mm; font-size: 12.4pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 110.9mm; inset-block-start: 31.8mm; inline-size: 80.0mm; block-size: 20.1mm; font-size: 11.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 110.9mm; inset-block-start: 57.1mm; inline-size: 79.1mm; block-size: 24.4mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.6mm; inset-block-start: 74.0mm; inline-size: 79.6mm; block-size: 32.8mm; font-size: 11.6pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 99.8mm; inset-block-start: 268.8mm; inline-size: 16.3mm; block-size: 4.3mm; font-size: 12.1pt"></div>
<div class="box ph" style="inset-inline-start: 178.1mm; inset-block-start: 269.1mm; inline-size: 12.3mm; block-size: 4.4mm; font-size: 12.4pt"></div>
</div></body>
</html>
