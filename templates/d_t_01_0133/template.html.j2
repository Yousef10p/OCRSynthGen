<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 25.1mm; inline-size: 43.3mm; block-size: 4.2mm; font-size: 11.9pt">{{ slot_0 }}</h2>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 50.1mm; inline-size: 36.8mm; block-size: 2.7mm; font-size: 7.6pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 55.7mm; inline-size: 154.4mm; block-size: 2.7mm; font-size: 7.6pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 61.2mm; inline-size: 149.3mm; block-size: 6.7mm; font-size: 9.5pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 70.8mm; inline-size: 88.3mm; block-size: 2.7mm; font-size: 7.6pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 76.4mm; inline-size: 142.9mm; block-size: 2.7mm; font-size: 7.6pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 82.0mm; inline-size: 83.8mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 18.9mm; inset-block-start: 96.2mm; inline-size: 28.0mm; block-size: 14.8mm; font-size: 14.0pt"></div>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 115.3mm; inline-size: 12.3mm; block-size: 6.7mm; font-size: 9.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 130.5mm; inline-size: 25.4mm; block-size: 6.7mm; font-size: 9.5pt">{{ slot_8 }}</p>
<header class="box" style="inset-inline-start: 5.0mm; inset-block-start: 215.2mm; inline-size: 5.5mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_9 }}</header><footer class="box" style="inset-inline-start: 20.0mm; inset-block-start: 288.2mm; inline-size: 45.4mm; block-size: 1.9mm; font-size: 5.4pt">{{ slot_10 }}</footer>
</div></body>
</html>
