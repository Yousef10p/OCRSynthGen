<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 182.9mm; inline-size: 165.0mm; block-size: 14.2mm; font-size: 13.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 202.2mm; inline-size: 164.9mm; block-size: 23.9mm; font-size: 13.5pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 26.9mm; inset-block-start: 235.6mm; inline-size: 51.4mm; block-size: 9.4mm; font-size: 13.3pt"></div>
