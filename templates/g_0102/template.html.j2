<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: start; --page-width: 210mm; --page-height: 297mm; --page-margin: 21mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 2.2); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_1 }}</p>
<main><h3 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 1em 0.4em">{{ slot_2 }}</h3>
<h3 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 0.6em 0.4em">{{ slot_3 }}</h3>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: var(--align); font-size: 1.05em">{{ slot_4 }}</p>
<ol style="list-style-type: arabic-indic; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}<ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ol>
</li>
<li>{{ slot_11 }}</li>
</ol>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_12 }}</blockquote>
<aside style="border: 1px dashed #444; background: transparent; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 6px; break-inside: avoid"><p style="margin-block: 0.2em">{{ slot_13 }}</p>
<p style="margin-block: 0.2em">{{ slot_14 }}</p></aside></main>
</div></body>
</html>
