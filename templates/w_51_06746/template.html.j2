    margin: 0;
}

nav {
    margin: 10px 0;
}

nav a {
    margin: 0 10px;
    color: #000;
    text-decoration: none;
}

#grid {
    display: grid;
    grid-template-columns: auto auto;
    gap: 20px;
    padding: 10px;
}

.prop {
    border: 1px solid #000;
    padding: 10px;
    text-align: center;
}

.prop .image {
    background-color: #000;
