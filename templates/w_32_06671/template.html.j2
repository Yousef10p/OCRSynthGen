<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</div>
<div class="image-container ph"></div>
<div class="music-genres">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</div>
<div class="action">
