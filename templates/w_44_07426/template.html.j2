}

#blog {
    margin: 2em;
}

.blog-post {
    padding: 1em;
    margin: 1em 0;
    border: 1px solid #000;
}


.product:hover {
    background-color: #f0f0f0;
}

.product-button:hover {
    background-color: #4CAF50;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
