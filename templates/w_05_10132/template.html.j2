<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}

nav li {
    float: right;
}

nav li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

nav li a:hover {
    background-color: #111;
}

.carousel {
    height: 200px;
    display: flex;
    justify-content: space-between;
}

.carousel-item {
    width: 200px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.section {
    display: flex;
    justify-content: space-between;
}

.article, .topic {
    width: 50%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div class="carousel">
<div class="carousel-item" style="background: red;">{{ slot_5 }}</div>
<div class="carousel-item" style="background: green;">{{ slot_6 }}</div>
<div class="carousel-item" style="background: blue;">{{ slot_7 }}</div>
</div>
<div class="section">
<div class="article">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="article">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
</div>
<div class="section">
<div class="topic">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
<div class="topic">
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</div>
</div>
</body>
</html>