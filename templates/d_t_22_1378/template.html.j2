<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 45.0mm; inset-block-start: 25.1mm; inline-size: 144.8mm; block-size: 12.1mm; font-size: 11.4pt"><li>{{ slot_0 }}</li></ul>
<div class="box ph" style="inset-inline-start: 60.3mm; inset-block-start: 42.0mm; inline-size: 95.1mm; block-size: 53.9mm; font-size: 21.8pt"></div>
<p class="box" style="inset-inline-start: 119.1mm; inset-block-start: 99.9mm; inline-size: 10.2mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 32.5mm; inset-block-start: 108.1mm; inline-size: 51.1mm; block-size: 3.9mm; font-size: 11.2pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 45.0mm; inset-block-start: 116.2mm; inline-size: 147.0mm; block-size: 24.2mm; font-size: 11.4pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 45.0mm; inset-block-start: 144.6mm; inline-size: 113.4mm; block-size: 3.9mm; font-size: 11.2pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 45.0mm; inset-block-start: 152.7mm; inline-size: 146.1mm; block-size: 8.0mm; font-size: 11.4pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 45.0mm; inset-block-start: 164.8mm; inline-size: 147.0mm; block-size: 8.0mm; font-size: 11.4pt"><li>{{ slot_6 }}</li></ul>
<footer class="box" style="inset-inline-start: 101.9mm; inset-block-start: 270.3mm; inline-size: 7.3mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
