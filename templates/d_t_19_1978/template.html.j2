<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 18.7mm; inset-block-start: 10.8mm; inline-size: 89.3mm; block-size: 13.6mm; font-size: 19.3pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 29.1mm; inline-size: 26.2mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 94.1mm; inset-block-start: 32.6mm; inline-size: 28.6mm; block-size: 21.4mm; font-size: 15.2pt"></div>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 35.3mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 41.5mm; inline-size: 60.1mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 93.7mm; inset-block-start: 66.6mm; inline-size: 26.8mm; block-size: 24.2mm; font-size: 13.7pt"></div>
<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 69.6mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 75.8mm; inline-size: 64.5mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 93.5mm; inset-block-start: 103.8mm; inline-size: 28.3mm; block-size: 24.6mm; font-size: 13.9pt"></div>
<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 107.4mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 113.6mm; inline-size: 65.0mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 18.8mm; inset-block-start: 130.9mm; inline-size: 34.3mm; block-size: 14.8mm; font-size: 14.0pt"></div>
<footer class="box" style="inset-inline-start: 130.5mm; inset-block-start: 198.0mm; inline-size: 3.1mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
