<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 143.8mm; inset-block-start: 11.8mm; inline-size: 58.2mm; block-size: 16.7mm; font-size: 15.8pt"></div>
<h1 class="box" style="inset-inline-start: 15.8mm; inset-block-start: 38.9mm; inline-size: 167.5mm; block-size: 46.2mm; font-size: 40.0pt">{{ slot_0 }}</h1>
<div class="box ph" style="inset-inline-start: 89.2mm; inset-block-start: 104.7mm; inline-size: 122.2mm; block-size: 118.5mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 106.5mm; inline-size: 18.8mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 113.9mm; inline-size: 44.3mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 121.3mm; inline-size: 36.1mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 128.7mm; inline-size: 37.9mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 136.1mm; inline-size: 19.0mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 143.6mm; inline-size: 17.7mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 0.8mm; inset-block-start: 203.2mm; inline-size: 82.7mm; block-size: 17.5mm; font-size: 16.5pt"></div>
<div class="box ph" style="inset-inline-start: 1.2mm; inset-block-start: 223.6mm; inline-size: 82.3mm; block-size: 17.5mm; font-size: 16.5pt"></div>
<p class="box" style="inset-inline-start: 145.9mm; inset-block-start: 229.8mm; inline-size: 55.8mm; block-size: 10.0mm; font-size: 14.1pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 15.1mm; inset-block-start: 257.8mm; inline-size: 31.4mm; block-size: 13.8mm; font-size: 13.1pt"></div>
<div class="box ph" style="inset-inline-start: 162.1mm; inset-block-start: 260.3mm; inline-size: 40.7mm; block-size: 11.0mm; font-size: 31.2pt"></div>
</div></body>
</html>
