<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 32.2mm; inset-block-start: 43.9mm; inline-size: 149.7mm; block-size: 77.7mm; font-size: 20.0pt"></div>
<p class="box" style="inset-inline-start: 32.2mm; inset-block-start: 123.7mm; inline-size: 60.8mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 126.9mm; inline-size: 146.8mm; block-size: 5.4mm; font-size: 7.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 133.2mm; inline-size: 61.9mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 144.5mm; inline-size: 78.6mm; block-size: 30.7mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 112.4mm; inset-block-start: 144.5mm; inline-size: 78.6mm; block-size: 22.6mm; font-size: 10.7pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 118.3mm; inset-block-start: 184.8mm; inline-size: 82.7mm; block-size: 74.7mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 199.9mm; inline-size: 86.4mm; block-size: 15.4mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 216.8mm; inline-size: 86.6mm; block-size: 15.4mm; font-size: 10.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 72.6mm; inset-block-start: 247.4mm; inline-size: 37.5mm; block-size: 8.9mm; font-size: 8.4pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 179.5mm; inset-block-start: 269.7mm; inline-size: 20.8mm; block-size: 5.0mm; font-size: 14.1pt">{{ slot_8 }}</footer>
</div></body>
</html>
