<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 24.6mm; inset-block-start: 24.6mm; inline-size: 50.6mm; block-size: 36.0mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 79.8mm; inset-block-start: 24.1mm; inline-size: 50.3mm; block-size: 36.0mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 67.4mm; inline-size: 24.1mm; block-size: 11.4mm; font-size: 10.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 80.4mm; inset-block-start: 67.4mm; inline-size: 33.9mm; block-size: 11.4mm; font-size: 10.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 81.6mm; inline-size: 46.5mm; block-size: 46.8mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 80.4mm; inset-block-start: 81.6mm; inline-size: 48.0mm; block-size: 33.5mm; font-size: 11.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 24.6mm; inset-block-start: 134.7mm; inline-size: 50.8mm; block-size: 35.5mm; font-size: 14.4pt"></div>
<div class="box ph" style="inset-inline-start: 79.6mm; inset-block-start: 134.7mm; inline-size: 50.6mm; block-size: 35.7mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 177.3mm; inline-size: 36.4mm; block-size: 7.0mm; font-size: 9.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 80.4mm; inset-block-start: 177.3mm; inline-size: 28.7mm; block-size: 11.4mm; font-size: 10.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 187.2mm; inline-size: 48.9mm; block-size: 46.8mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 80.4mm; inset-block-start: 191.6mm; inline-size: 47.8mm; block-size: 33.5mm; font-size: 11.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 25.8mm; inset-block-start: 287.5mm; inline-size: 1.1mm; block-size: 2.0mm; font-size: 5.8pt">{{ slot_8 }}</footer>
</div></body>
</html>
