<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 15.6mm; inset-block-start: 17.6mm; inline-size: 179.2mm; block-size: 8.9mm; font-size: 12.6pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 122.4mm; inset-block-start: 37.5mm; inline-size: 68.1mm; block-size: 24.7mm; font-size: 17.5pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 23.5mm; inset-block-start: 38.7mm; inline-size: 58.1mm; block-size: 25.0mm; font-size: 14.2pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.1mm; inset-block-start: 98.7mm; inline-size: 52.6mm; block-size: 13.6mm; font-size: 12.9pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 124.0mm; inset-block-start: 97.5mm; inline-size: 58.1mm; block-size: 20.5mm; font-size: 14.5pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 15.2mm; inset-block-start: 152.5mm; inline-size: 93.5mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 160.9mm; inline-size: 129.4mm; block-size: 19.7mm; font-size: 11.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 207.8mm; inset-block-start: 270.0mm; inline-size: 2.8mm; block-size: 1.9mm; font-size: 5.4pt">{{ slot_7 }}</footer>
</div></body>
</html>
