}

main {
    margin: auto;
    max-width: 1200px;
    padding: 20px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    grid-gap: 20px;
    margin-bottom: 20px;
}

.grid-item {
    background-color: #ddd;
    padding: 20px;
