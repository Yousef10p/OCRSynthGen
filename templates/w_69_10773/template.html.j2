    background-color: #fff;
    color: #000;
    *zoom: 1;
}


header nav ul {
    display: flex;
    justify-content: space-between;
}

header nav ul li {
    background-color: #000;
    color: #fff;
}

header nav img {
    position: absolute;
    top: 0;
    left: 0;
}

header img {
    width: 100%;
    background-color: #000;
}


#content article {
    background-color: #000;
    color: #fff;
    width: 100%;
}


#page-footer article {
    background-color: #000;
    color: #fff;
}

#page-footer form input[type="submit"] {
    background-color: #000;
    color: #fff;
}

#page-footer form label {
    position: absolute;
    clip: rect(1px, 1px, 1px, 1px);
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
    width: 1px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
