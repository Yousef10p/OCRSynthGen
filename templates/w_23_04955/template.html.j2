<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
  height: 100%;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-family: var(--font-body);
}
header {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}
nav ul {
  display: flex;
  list-style-type: none;
}
nav ul li {
  margin: 0 1em;
}
.logo {
  margin: 0 3em;
  font-weight: bold;
}
#content {
  width: 100%;
  display: flex;
  justify-content: space-around;
}
.category, .featured, .feature {
  width: 40%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.product, .feature .product {
  background-color: #ddd;
  height: 200px;
  width: 80%;
  margin: 2em 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
