    cursor: pointer;
}

#gallery, #portfolio, #blog {
    margin: 20px 0;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.grid-item {
    height: 200px;
    background-color: #807160;
}


#social-links {
    text-align: center;
}

#social-links a {
