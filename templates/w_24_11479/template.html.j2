}

header, main, footer {
    padding: 20px 0;
}

.hero {
    background-color: #EFEAE2;
    text-align: center;
}

.hero h1 {
    color: #663F2F;
}

button {
    background-color: #663F2F;
    color: white;
    padding: 10px 20px;
