<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 73.1mm; inline-size: 6.3mm; block-size: 114.2mm; font-size: 20.0pt">{{ slot_5 }}</header><h2 class="box" style="inset-inline-start: 98.6mm; inset-block-start: 80.2mm; inline-size: 20.3mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</h2>
