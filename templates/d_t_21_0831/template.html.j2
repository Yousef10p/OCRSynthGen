<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 17.8mm; inset-block-start: 27.5mm; inline-size: 108.9mm; block-size: 7.4mm; font-size: 16.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 17.8mm; inset-block-start: 39.8mm; inline-size: 58.4mm; block-size: 3.9mm; font-size: 17.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 43.1mm; inline-size: 180.8mm; block-size: 10.4mm; font-size: 9.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 54.6mm; inline-size: 173.9mm; block-size: 11.4mm; font-size: 9.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 17.8mm; inset-block-start: 70.3mm; inline-size: 62.1mm; block-size: 4.2mm; font-size: 19.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 74.5mm; inline-size: 78.8mm; block-size: 11.6mm; font-size: 10.6pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 18.4mm; inset-block-start: 87.0mm; inline-size: 124.2mm; block-size: 149.8mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 238.9mm; inline-size: 178.2mm; block-size: 11.4mm; font-size: 9.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 105.3mm; inset-block-start: 261.1mm; inline-size: 5.4mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
