<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 38.6mm; inset-block-start: 25.9mm; inline-size: 135.7mm; block-size: 48.6mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 80.1mm; inline-size: 70.6mm; block-size: 6.0mm; font-size: 12.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 90.5mm; inline-size: 152.1mm; block-size: 22.0mm; font-size: 12.6pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 31.9mm; inset-block-start: 116.1mm; inline-size: 56.1mm; block-size: 8.0mm; font-size: 18.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 125.7mm; inline-size: 152.1mm; block-size: 32.6mm; font-size: 12.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 160.1mm; inline-size: 152.1mm; block-size: 43.7mm; font-size: 12.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 209.6mm; inline-size: 54.3mm; block-size: 6.0mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 220.1mm; inline-size: 44.9mm; block-size: 29.5mm; font-size: 10.2pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 92.9mm; inset-block-start: 240.9mm; inline-size: 3.7mm; block-size: 4.0mm; font-size: 11.3pt"></div>
<footer class="box" style="inset-inline-start: 160.4mm; inset-block-start: 257.7mm; inline-size: 23.6mm; block-size: 4.6mm; font-size: 10.8pt">{{ slot_7 }}</footer>
</div></body>
</html>
