<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 33.0mm; inline-size: 152.4mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 49.9mm; inline-size: 152.4mm; block-size: 88.1mm; font-size: 12.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 31.8mm; inset-block-start: 150.0mm; inline-size: 131.7mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 161.8mm; inline-size: 152.4mm; block-size: 29.0mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 75.3mm; inset-block-start: 192.7mm; inline-size: 108.8mm; block-size: 9.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 207.5mm; inline-size: 152.4mm; block-size: 20.8mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 233.0mm; inline-size: 152.4mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 251.1mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
