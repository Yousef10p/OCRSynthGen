<div class="box ph" style="inset-inline-start: 26.0mm; inset-block-start: 111.1mm; inline-size: 86.6mm; block-size: 39.7mm; font-size: 16.1pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 152.9mm; inline-size: 27.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 26.4mm; inset-block-start: 159.1mm; inline-size: 85.8mm; block-size: 42.7mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 204.3mm; inline-size: 27.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 212.2mm; inline-size: 68.4mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_4 }}</h2>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 219.4mm; inline-size: 83.2mm; block-size: 17.7mm; font-size: 12.5pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 226.1mm; inline-size: 27.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 232.8mm; inline-size: 83.2mm; block-size: 17.7mm; font-size: 12.5pt"><li>{{ slot_7 }}</li></ul>
