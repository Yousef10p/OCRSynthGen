<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 14.8mm; inset-block-start: 32.6mm; inline-size: 144.7mm; block-size: 77.0mm; font-size: 8.5pt"></div>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 118.9mm; inline-size: 139.1mm; block-size: 14.1mm; font-size: 10.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 95.2mm; inset-block-start: 137.5mm; inline-size: 88.3mm; block-size: 9.9mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 151.8mm; inline-size: 151.1mm; block-size: 44.1mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 101.1mm; inset-block-start: 197.4mm; inline-size: 82.5mm; block-size: 13.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 211.8mm; inline-size: 91.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 90.2mm; inset-block-start: 217.4mm; inline-size: 93.4mm; block-size: 15.6mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 103.8mm; inset-block-start: 236.5mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</footer>
</div></body>
</html>
