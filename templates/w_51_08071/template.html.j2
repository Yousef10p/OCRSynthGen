<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

.header, .navigation, .footer {
    background-color: #212121;
    color: white;
    padding: 20px;
}

.header {
    text-align: center;
    position: relative;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

.tagline {
    font-size: 16px;
    margin-top: 10px;
}

.hero-image {
    width: 100%;
    height: 400px;
    background-color: #ccc;
}

.navigation a {
    color: white;
    margin-left: 10px;
    text-decoration: none;
}

.content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 10px;
}

.menu, .gallery, .events {
    background-color: #fff;
    padding: 20px;
    color: black;
}

.footer {
    padding: 20px;
    margin-top: 20px;
}

.social-media a {
    color: white;
    text-decoration: none;
    margin-left: 10px;
}

.newsletter input {
    padding: 5px;
    margin-top: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">{{ slot_0 }}</div>
<div class="tagline">{{ slot_1 }}</div>
</div>
<div class="hero-image ph"></div>
<div class="navigation">
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
</div>
<div class="content">
<div class="menu" id="menu">{{ slot_5 }}</div>
<div class="gallery" id="gallery">{{ slot_6 }}</div>
<div class="events" id="events">{{ slot_7 }}</div>
</div>
<div class="footer">
<div class="social-media"><a>{{ slot_8 }}</a> {{ slot_9 }} <a>{{ slot_10 }}</a> {{ slot_11 }} <a>{{ slot_12 }}</a></div>
<div class="newsletter">{{ slot_13 }} <span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_14 }}</span></div>
</div>
</body>
</html>