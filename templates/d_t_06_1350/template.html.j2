<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.5mm; inset-block-start: 14.1mm; inline-size: 64.8mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 24.8mm; inline-size: 164.9mm; block-size: 14.6mm; font-size: 13.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 44.8mm; inline-size: 165.0mm; block-size: 19.6mm; font-size: 13.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 69.7mm; inline-size: 152.8mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 79.1mm; inline-size: 85.6mm; block-size: 110.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 117.3mm; inset-block-start: 91.1mm; inline-size: 67.4mm; block-size: 12.0mm; font-size: 11.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 117.3mm; inset-block-start: 108.4mm; inline-size: 67.2mm; block-size: 8.1mm; font-size: 11.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 193.9mm; inline-size: 165.1mm; block-size: 34.6mm; font-size: 14.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 233.9mm; inline-size: 164.8mm; block-size: 19.6mm; font-size: 13.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 18.5mm; inset-block-start: 261.3mm; inline-size: 48.8mm; block-size: 10.0mm; font-size: 14.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
