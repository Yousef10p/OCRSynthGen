<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 39.4mm; inline-size: 108.2mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 30.0mm; inset-block-start: 59.9mm; inline-size: 16.2mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 60.8mm; inset-block-start: 70.6mm; inline-size: 119.2mm; block-size: 12.4mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 88.7mm; inline-size: 150.0mm; block-size: 19.3mm; font-size: 10.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 119.6mm; inline-size: 150.0mm; block-size: 42.5mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 173.7mm; inline-size: 150.0mm; block-size: 19.3mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 74.2mm; inset-block-start: 200.0mm; inline-size: 105.8mm; block-size: 13.1mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 219.5mm; inline-size: 150.0mm; block-size: 43.3mm; font-size: 10.9pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 271.1mm; inline-size: 1.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
