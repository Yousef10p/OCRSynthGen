<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}
body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    background-color: #f7f7f7;
    color: #333;
}
header, nav, section, footer {
    margin: 20px 0;
    padding: 20px;
    background-color: #fff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.3);
    border-radius: 5px;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin: 0 10px;
}

nav ul li a {
    text-decoration: none;
    color: #333;
}

h1, h2 {
    text-align: center;
}

p {
    margin: 20px 0;
    line-height: 1.5;
}

.invest-now-button {
    padding: 10px 20px;
    background-color: #007bff;
    color: #fff;
    border: none;
    border-radius: 5px;
    transition: all 0.2s;
}

.invest-now-button:hover {
    background-color: #0056b3;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<a class="invest-now-button">{{ slot_7 }}</a>
</header>
<section>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</section>
<section>
<h2>{{ slot_10 }}</h2>
<ul>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
</ul>
</section>
<footer>
<p>{{ slot_16 }}</p>
</footer>
</body>
</html>