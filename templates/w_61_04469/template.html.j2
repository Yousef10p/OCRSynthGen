<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html, * {
    margin: 0;
    padding: 0;
}

header {
    align-items: center;
    background-color: white;
    display: flex;
    height: 100px;
    justify-content: center;
    width: 100%;
}

#logo {
    background-color: darkblue;
    color: white;
    font-size: 24px;
    padding: 20px;
    text-align: center;
}

nav {
    background-color: lightgray;
    margin-top: 20px;
    padding: 10px 0;
}

nav ul {
    display: flex;
    justify-content: space-around;
    list-style-type: none;
}

nav ul li a {
    color: black;
    text-decoration: none;
}

#feedback-form {
    margin: 20px 0;
}

#feedback-form label {
    display: block;
    margin: 10px 0;
}

#feedback-form input[type="text"], #feedback-form textarea {
    width: 100%;
}

#feedback-form input[type="submit"] {
    float: left;
}

footer {
    margin-top: 20px;
    padding: 10px 0;
}

#social-media {
    display: flex;
    justify-content: space-around;
}

#search-bar {
    display: flex;
    margin-top: 20px;
}

#search-bar input[type="text"] {
    width: 80%;
}

#search-bar input[type="submit"] {
    width: 20%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
