* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 1rem;
    background-color: #f1f1f1;
}

header h1 {
    font-size: 2rem;
}

header nav a {
    margin-left: 1rem;
    text-decoration: none;
    color: #000;
}

main {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    padding: 1rem;
}

main section {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #f9f9f9;
}

main section h2 {
    margin-bottom: 1rem;
}

main section p {
    margin-bottom: 1rem;
}

footer {
    width: 100%;
    padding: 1rem;
    background-color: #f1f1f1;
    text-align: center;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
