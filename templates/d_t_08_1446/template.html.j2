<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 77.2mm; inline-size: 160.0mm; block-size: 10.2mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 81.9mm; inset-block-start: 93.9mm; inline-size: 46.1mm; block-size: 11.2mm; font-size: 8.5pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 110.9mm; inline-size: 160.0mm; block-size: 10.9mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 127.5mm; inline-size: 159.9mm; block-size: 3.3mm; font-size: 10.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 80.6mm; inset-block-start: 137.0mm; inline-size: 48.9mm; block-size: 12.8mm; font-size: 7.0pt"></div>
