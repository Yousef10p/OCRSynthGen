<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #9e9e9e;
}

#logo {
    position: absolute;
    top: 0;
    right: 50%;
    transform: translateX(50%);
    background-color: #4caf50;
    color: white;
    padding: 10px;
    text-align: center;
}

#menu {
    position: absolute;
    top: 0;
    left: 0;
    background-color: #f44336;
    color: white;
    padding: 10px;
}

#main-content {
    margin: 50px;
    text-align: center;
    color: #3f51b5;
}

.game-container {
    display: flex;
    justify-content: space-around;
    margin: 20px;
}

.game-box {
    background-color: #2196f3;
    color: white;
    width: 30%;
    text-align: center;
    padding: 20px;
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="logo">{{ slot_0 }}</div>
<div id="menu">
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
</div>
<div id="main-content">
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
</div>
<div class="game-container">
<div class="game-box">{{ slot_10 }}</div>
<div class="game-box">{{ slot_11 }}</div>
<div class="game-box">{{ slot_12 }}</div>
<div class="game-box">{{ slot_13 }}</div>
<div class="game-box">{{ slot_14 }}</div>
<div class="game-box">{{ slot_15 }}</div>
</div>
</body>
</html>