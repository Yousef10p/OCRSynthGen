<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

#header {
  text-align: center;
  padding: 50px;
  background: #000;
  color: #fff;
}

#countdown {
  font-size: 2em;
}

#content {
  margin: 0 auto;
  width: 50%;
  text-align: center;
  padding: 50px;
}

#lineup-heading, #schedule-heading, #ticket-heading {
  font-size: 2em;
  margin: 20px 0;
}

#lineup, #schedule, #ticket-info {
  list-style-type: none;
  margin: 0;
  padding: 0;
}

#lineup li, #schedule li, #ticket-info {
  margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<h1>{{ slot_0 }}</h1>
<h2 id="countdown">
<span id="days"></span>{{ slot_1 }} 
        <span id="hours"></span>{{ slot_2 }} 
        <span id="minutes"></span>{{ slot_3 }} 
        <span id="seconds"></span>{{ slot_4 }}
      </h2>
</div>
<div id="content">
<p id="lineup-heading">{{ slot_5 }}</p>
<ul id="lineup">
<li id="band1">{{ slot_6 }}</li>
<li id="band2">{{ slot_7 }}</li>
<li id="band3">{{ slot_8 }}</li>
</ul>
<p id="schedule-heading">{{ slot_9 }}</p>
<ul id="schedule">
<li id="day1">{{ slot_10 }}</li>
<li id="day2">{{ slot_11 }}</li>
<li id="day3">{{ slot_12 }}</li>
</ul>
<p id="ticket-heading">{{ slot_13 }}</p>
<p id="ticket-info">{{ slot_14 }}</p>
</div>
</body>
</html>