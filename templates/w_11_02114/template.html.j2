}
.service {
  border: 1px solid #ddd;
  padding: 1em;
  border-radius: 5px;
}


.cta {
  padding: 5em 0;
  text-align: center;
  background-color: #007bff;
  color: #fff;
}
.cta h2 {
  font-size: 2em;
}
.cta a {
  margin-top: 2em;
  background-color: #fff;
  color: #007bff;
}


footer {
  text-align: center;
  padding: 2em 0;
  background-color: #f8f9fa;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
