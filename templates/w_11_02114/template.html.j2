}
.navbar a {
  color: #333;
  text-decoration: none;
}
.navbar ul {
  display: flex;
  list-style: none;
  padding: 0;
  margin: 0;
}
.navbar ul li {
  margin-right: 1.5em;
}


.hero {
  background-color: #f1f1f1;
  text-align: center;
