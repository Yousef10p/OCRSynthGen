    background-color: lightgray;
    padding: 10px;
}

.logo {
    width: 100px;
    height: 100px;
    background-color: gray;
}

nav ul {
    display: flex;
    gap: 20px;
}

main {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    padding: 20px;
}

main section {
    border: 1px solid gray;
    padding: 20px;
}

footer {
    background-color: darkgray;
    color: white;
    text-align: center;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
