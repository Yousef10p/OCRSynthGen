<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 126.9mm; inline-size: 172.3mm; block-size: 13.7mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 145.0mm; inline-size: 170.7mm; block-size: 18.7mm; font-size: 13.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 168.1mm; inline-size: 170.8mm; block-size: 8.8mm; font-size: 12.4pt">{{ slot_6 }}</p>
