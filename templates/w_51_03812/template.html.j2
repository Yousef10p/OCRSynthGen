<p>{{ slot_1 }}</p>
<p>{{ slot_2 }}</p>
<p>{{ slot_3 }}</p>
<p>{{ slot_4 }}</p>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</div>
<div id="content">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</div>
<div id="sidebar">
<h3>{{ slot_12 }}</h3>
<ol>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
</ol>
<h3>{{ slot_16 }}</h3>
<p>{{ slot_17 }}</p>
<p>{{ slot_18 }}</p>
<p>{{ slot_19 }}</p>
</div>
</div>
</body>
</html>