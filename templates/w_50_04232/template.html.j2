    margin: 0 10px;
}


header {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    background-color: #000;
    color: #fff;
    padding: 20px;
}
#logo, #footer-logo {
    width: 100px;
    height: 100px;
    background-color: #fff;
}


main {
    padding: 20px;
}
section {
    margin-bottom: 20px;
}
article {
    margin-bottom: 10px;
}
.product-image {
    width: 200px;
    height: 200px;
    background-color: #000;
}


footer {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    background-color: #000;
    color: #fff;
    padding: 20px;
}
footer nav ul {
    flex-direction: column;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
