  font-family: var(--font-body);
}

header {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  padding: 10px 0;
  background-color: rgba(0,0,0,0.5);
  color: white;
}

nav ul {
  list-style: none;
  text-align: center;
}

