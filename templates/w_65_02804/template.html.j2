  display: inline;
  margin: 0 15px;
}

nav ul li a {
  text-decoration: none;
  color: white;
}

.hero {
  position: relative;
  height: 100vh;
  background-image: none;
  background-size: cover;
  text-align: center;
  padding-top: 200px;
}

.hero-content {
  position: absolute;
  top: 50%;
  right: 50%;
  transform: translate(50%, -50%);
  width: 80%;
}

.hero-content h1 {
  font-size: 3em;
}

.cta {
  margin-top: 20px;
  padding: 10px 20px;
  background-color: white;
  border: none;
  cursor: pointer;
}

.about, .services, .portfolio, .contact-us {
  padding: 50px;
  line-height: 1.6em;
}

.about, .services, .portfolio {
  max-width: 800px;
  margin: 0 auto;
}

.portfolio-item, .form {
  margin: 20px;
}

input, textarea {
  display: block;
  margin: 10px 0;
  width: 100%;
}

button {
  padding: 10px 20px;
  background-color: blue;
  color: white;
  border: none;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
