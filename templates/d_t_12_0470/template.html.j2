<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 14.9mm; inset-block-start: 23.9mm; inline-size: 3.3mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 161.0mm; inset-block-start: 23.9mm; inline-size: 31.7mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 106.9mm; inset-block-start: 32.8mm; inline-size: 90.9mm; block-size: 61.6mm; font-size: 25.0pt"></div>
<p class="box" style="inset-inline-start: 14.9mm; inset-block-start: 33.5mm; inline-size: 85.5mm; block-size: 70.6mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 107.2mm; inset-block-start: 102.5mm; inline-size: 85.5mm; block-size: 41.5mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 14.9mm; inset-block-start: 114.1mm; inline-size: 85.5mm; block-size: 79.0mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 107.2mm; inset-block-start: 153.0mm; inline-size: 85.5mm; block-size: 11.6mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 107.2mm; inset-block-start: 170.4mm; inline-size: 85.5mm; block-size: 20.0mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 14.9mm; inset-block-start: 203.2mm; inline-size: 86.1mm; block-size: 70.6mm; font-size: 10.0pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 139.5mm; inset-block-start: 201.8mm; inline-size: 53.2mm; block-size: 11.1mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 107.2mm; inset-block-start: 220.0mm; inline-size: 85.5mm; block-size: 53.7mm; font-size: 10.0pt">{{ slot_8 }}</p>
</div></body>
</html>
