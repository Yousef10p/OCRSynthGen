<p class="box" style="inset-inline-start: 100.4mm; inset-block-start: 92.6mm; inline-size: 28.7mm; block-size: 5.6mm; font-size: 15.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 149.3mm; inset-block-start: 92.6mm; inline-size: 32.4mm; block-size: 5.6mm; font-size: 15.7pt">{{ slot_3 }}</p>
