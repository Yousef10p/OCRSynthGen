body {
    font-family: var(--font-body);
}

header {
    background-color: #f4f4f4;
    padding: 10px;
}

nav ul {
    list-style: none;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

.slider {
    width: 100%;
    height: 300px;
    display: flex;
    justify-content: space-around;
    background-color: #ddd;
}

.slide {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 23%;
    height: 200px;
    background-color: #999;
    color: #fff;
    text-align: center;
}

aside {
    width: 25%;
    float: left;
    background-color: #f4f4f4;
    padding: 10px;
}

footer {
    clear: both;
    text-align: center;
    padding: 10px;
    background-color: #f4f4f4;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
