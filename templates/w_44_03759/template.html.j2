    right: 0;
    width: 100%;
    background: #333;
    color: #fff;
}
nav ul {
    list-style-type: none;
    margin: 0;
    padding: 10px;
}
nav ul li {
    display: inline;
    margin-left: 20px;
}
#fullscreen-slider {
    height: 100vh;
}
#fullscreen-slider .slide {
    width: 100%;
    height: 100%;
    background: #666;
}
#left-sidebar, #right-sidebar {
    float: right;
    width: 30%;
    height: 100vh;
    background: #999;
}
#right-sidebar .portfolio {
    width: 40%;
    height: 50px;
    background: #ccc;
}
footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    background: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
