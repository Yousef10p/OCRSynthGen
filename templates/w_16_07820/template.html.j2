<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
  height: 100%;
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

header, main, footer {
  padding: 20px;
  box-sizing: border-box;
}

header {
  background-image: none;
  background-size: cover;
  background-position: center;
  height: 300px;
}

nav {
  background: #f4f4f4;
  width: 100%;
}

nav ul {
  list-style-type: none;
  padding: 0;
  display: flex;
  justify-content: space-around;
}

nav ul li a {
  color: #333;
  text-decoration: none;
}

main {
  display: flex;
  justify-content: space-around;
}

main section {
  flex-grow: 1;
}

aside {
  background: beige;
  margin: 0 10px;
}

footer {
  background: #333;
  color: #fff;
  text-align: center;
  width: 100%;
  position: absolute;
  bottom: 0;
}

footer p {
  margin: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
</header>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<main>
<section id="investment">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</section>
<section id="wealth">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</section>
<section id="accounts">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</section>
<section id="loans">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</section>
<aside>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</aside>
</main>
<footer>
<h3>{{ slot_15 }}</h3>
<p>{{ slot_16 }}</p>
<p>{{ slot_17 }}</p>
</footer>
</body>
</html>