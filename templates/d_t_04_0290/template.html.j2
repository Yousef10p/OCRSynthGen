<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.9mm; inset-block-start: 22.2mm; inline-size: 39.5mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 28.1mm; inline-size: 61.9mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 22.2mm; inset-block-start: 34.4mm; inline-size: 173.2mm; block-size: 17.0mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.2mm; inset-block-start: 53.5mm; inline-size: 174.9mm; block-size: 12.7mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.2mm; inset-block-start: 68.3mm; inline-size: 176.1mm; block-size: 8.5mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 15.9mm; inset-block-start: 79.8mm; inline-size: 68.1mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 15.9mm; inset-block-start: 85.6mm; inline-size: 184.5mm; block-size: 25.4mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 15.9mm; inset-block-start: 113.2mm; inline-size: 184.5mm; block-size: 29.7mm; font-size: 10.0pt">{{ slot_7 }}</p>
