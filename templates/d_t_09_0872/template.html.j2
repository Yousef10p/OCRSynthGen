<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 31.3mm; inline-size: 160.6mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 67.7mm; inset-block-start: 42.6mm; inline-size: 122.3mm; block-size: 11.1mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 67.7mm; inset-block-start: 56.7mm; inline-size: 122.3mm; block-size: 11.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 76.5mm; inline-size: 51.1mm; block-size: 4.3mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 85.5mm; inline-size: 170.0mm; block-size: 20.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 110.8mm; inline-size: 170.0mm; block-size: 54.3mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 169.8mm; inline-size: 170.0mm; block-size: 45.9mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 220.4mm; inline-size: 135.7mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 238.3mm; inline-size: 116.4mm; block-size: 5.4mm; font-size: 17.2pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 252.2mm; inline-size: 170.0mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 104.0mm; inset-block-start: 274.6mm; inline-size: 2.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
