<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 0.8mm; inline-size: 119.4mm; block-size: 5.4mm; font-size: 15.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 7.5mm; inline-size: 76.5mm; block-size: 31.0mm; font-size: 11.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 86.3mm; inset-block-start: 7.8mm; inline-size: 55.8mm; block-size: 81.4mm; font-size: 15.4pt"></div>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 40.6mm; inline-size: 50.8mm; block-size: 5.4mm; font-size: 15.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 47.1mm; inline-size: 76.7mm; block-size: 31.0mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 78.6mm; inline-size: 76.5mm; block-size: 12.0mm; font-size: 8.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 90.3mm; inline-size: 123.5mm; block-size: 8.4mm; font-size: 8.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 4.7mm; inset-block-start: 100.6mm; inline-size: 63.3mm; block-size: 5.9mm; font-size: 16.6pt">{{ slot_6 }}</h2>
<div class="box ph" style="inset-inline-start: 5.1mm; inset-block-start: 107.1mm; inline-size: 137.1mm; block-size: 70.0mm; font-size: 15.3pt"></div>
</div></body>
</html>
