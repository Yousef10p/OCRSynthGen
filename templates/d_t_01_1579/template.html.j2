<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 33.6mm; inset-block-start: 17.0mm; inline-size: 32.9mm; block-size: 13.7mm; font-size: 12.9pt"></div>
<h2 class="box" style="inset-inline-start: 33.9mm; inset-block-start: 40.4mm; inline-size: 38.5mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 44.9mm; inline-size: 146.7mm; block-size: 18.2mm; font-size: 12.9pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 33.9mm; inset-block-start: 69.7mm; inline-size: 38.2mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 74.2mm; inline-size: 132.4mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 79.1mm; inline-size: 147.2mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 84.0mm; inline-size: 134.2mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 89.0mm; inline-size: 142.6mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_6 }}</p>
