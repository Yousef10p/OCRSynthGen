<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 146.9mm; inline-size: 133.5mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 152.8mm; inline-size: 88.2mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 158.9mm; inline-size: 40.3mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 164.8mm; inline-size: 114.7mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 53.3mm; inset-block-start: 173.6mm; inline-size: 134.6mm; block-size: 38.3mm; font-size: 15.5pt"></div>
