  border: none;
  color: white;
  text-align: center;
  display: inline-block;
  font-size: 16px;
  margin: 4px 2px;
  cursor: pointer;
}
.about-us, 
.testimonials {
  margin: 20px;
}
.contact-us {
  background-color: #f3f3f3;
  padding: 20px;
