<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	font-family: var(--font-body);
	margin: 0;
	padding: 0;
	background-color: #f0f0f0;
}


.left-nav {
	position: absolute;
	top: 0;
	bottom: 0;
	width: 200px;
	padding: 25px;
	background-color: #333;
}
.left-nav ul {
	list-style-type: none;
	padding: 0;
}
.left-nav ul li a {
	display: block;
	color: #fff;
	padding: 10px;
	text-decoration: none;
}


.product-grid {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-around;
	margin: 0 auto;
	width: 80%;
}
.product {
	width: calc(33% - 20px);
	background-color: #fff;
	margin: 10px;
	padding: 20px;
	text-align: center;
}
.product-image {
	height: 200px;
	background-color: #bada55; 
	margin-bottom: 10px;
}
p {
	margin: 0;
	font-size: .9em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

<div class="left-nav">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>

<div class="product-grid">
<div class="product">
<div class="product-image">{{ slot_5 }}</div>
<p>{{ slot_6 }}</p>
</div>
<div class="product">
<div class="product-image">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</div>
<div class="product">
<div class="product-image">{{ slot_9 }}</div>
<p>{{ slot_10 }}</p>
</div>
<div class="product">
<div class="product-image">{{ slot_11 }}</div>
<p>{{ slot_12 }}</p>
</div>
<div class="product">
<div class="product-image">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
</div>
<div class="product">
<div class="product-image">{{ slot_15 }}</div>
<p>{{ slot_16 }}</p>
</div>
</div>
</body>
</html>