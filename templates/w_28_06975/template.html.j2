<div id="carousel">
<div class="event"><p>{{ slot_3 }}</p><div class="img ph"></div></div>
<div class="event"><p>{{ slot_4 }}</p><div class="img ph"></div></div>
<div class="event"><p>{{ slot_5 }}</p><div class="img ph"></div></div>
</div>
<div id="teams">
<div class="team"><p>{{ slot_6 }}</p><div class="img ph"></div></div>
<div class="team"><p>{{ slot_7 }}</p><div class="img ph"></div></div>
<div class="team"><p>{{ slot_8 }}</p><div class="img ph"></div></div>
</div>
<footer>
<div><a>{{ slot_9 }}</a><a>{{ slot_10 }}</a><a>{{ slot_11 }}</a></div>
<div><p>{{ slot_12 }}</p><p>{{ slot_13 }}</p></div>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_14 }}</span>
</footer>
</body>
</html>