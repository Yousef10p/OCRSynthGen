<div class="course"><div class="placeholder ph"></div>{{ slot_4 }}</div>
<div class="course"><div class="placeholder ph"></div>{{ slot_5 }}</div>
<div class="course"><div class="placeholder ph"></div>{{ slot_6 }}</div>
</section>
<section id="programs">
<h2>{{ slot_7 }}</h2>
<div class="program"><div class="placeholder ph"></div>{{ slot_8 }}</div>
