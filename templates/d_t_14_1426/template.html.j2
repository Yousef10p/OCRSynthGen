<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 275.5mm; inline-size: 101.8mm; block-size: 7.9mm; font-size: 8.0pt">{{ slot_13 }}</footer><footer class="box" style="inset-inline-start: 165.1mm; inset-block-start: 280.0mm; inline-size: 16.5mm; block-size: 3.4mm; font-size: 8.0pt">{{ slot_14 }}</footer>
