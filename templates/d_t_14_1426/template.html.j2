<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 107.7mm; inline-size: 162.9mm; block-size: 12.7mm; font-size: 9.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 125.3mm; inline-size: 53.9mm; block-size: 3.8mm; font-size: 9.0pt">{{ slot_5 }}</p>
