    padding: 0.5em;
    border: 1px solid lightgray;
}

#contact form input[type="submit"] {
    background-color: green;
    color: white;
    border: none;
    padding: 0.5em;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
