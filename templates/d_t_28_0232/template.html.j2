<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 5.1mm; inset-block-start: 3.6mm; inline-size: 20.1mm; block-size: 2.6mm; font-size: 11.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 5.5mm; inset-block-start: 11.1mm; inline-size: 23.3mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 22.1mm; inline-size: 199.4mm; block-size: 12.8mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 38.4mm; inline-size: 199.4mm; block-size: 12.8mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 54.7mm; inline-size: 199.4mm; block-size: 9.6mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 67.7mm; inline-size: 199.4mm; block-size: 12.8mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 83.9mm; inline-size: 199.4mm; block-size: 22.6mm; font-size: 13.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 165.2mm; inset-block-start: 115.2mm; inline-size: 39.3mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
