<div class="box ph" style="inset-inline-start: 66.9mm; inset-block-start: 47.1mm; inline-size: 97.9mm; block-size: 93.4mm; font-size: 37.8pt"></div>
<h2 class="box" style="inset-inline-start: 109.4mm; inset-block-start: 157.1mm; inline-size: 9.8mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 64.8mm; inset-block-start: 165.6mm; inline-size: 107.4mm; block-size: 19.5mm; font-size: 11.1pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 194.5mm; inline-size: 153.2mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_6 }}</li></ul>
