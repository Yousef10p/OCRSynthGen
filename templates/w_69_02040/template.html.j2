<p>{{ slot_7 }}</p>
<p>{{ slot_8 }}</p>

<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>

<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>

<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>

</section>
</main>
<footer>
<p>{{ slot_14 }}<br>{{ slot_15 }}</p>
</footer>
</body>
</html>