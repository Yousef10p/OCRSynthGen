  font-family: var(--font-body);
}

header {
  background-color: #333;
  color: white;
  padding: 10px;
  position: sticky;
  top: 0;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin-left: 10px;
}

nav ul li a {
  color: white;
  text-decoration: none;
}

.hero {
  background-color: #333;
  color: white;
  padding: 100px 0;
  text-align: center;
}

section {
  padding: 50px;
  min-height: 100vh;
}

#schedule {
  background-color: #eee;
}

#lineup {
  background-color: #ddd;
}

#tickets {
  background-color: #ccc;
}

#accommodations {
