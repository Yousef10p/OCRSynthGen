<div class="box ph" style="inset-inline-start: 88.9mm; inset-block-start: 110.6mm; inline-size: 101.5mm; block-size: 5.4mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 125.4mm; inline-size: 105.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</p>
