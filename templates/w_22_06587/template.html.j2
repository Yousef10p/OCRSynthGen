}

main {
  display: flex;
}

main .collection {
  width: 70%;
}

main .collection .item {
  display: flex;
  margin: 20px 0;
}

main .collection .item .image {
  width: 100px;
  height: 100px;
  background-color: #ddd;
  margin-left: 20px;
}

aside {
  width: 30%;
  background-color: #f0f0f0;
  padding: 20px;
}

footer form input {
  margin: 10px 0;
}


@media (max-width: 600px) {
  header, main, aside, footer {
    flex-direction: column;
  }

  header input, footer form {
    margin-top: 10px;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
