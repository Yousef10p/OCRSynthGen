}

nav a {
    color: #666;
    text-decoration: none;
}

main {
    max-width: 800px;
    margin-top: 60px;
    padding: 10px;
}

section {
    margin: 20px 0;
}

.service, .testimonial {
    display: flex;
    align-items: center;
    gap: 20px;
}

.service > div, .testimonial > div {
    height: 100px;
    width: 100px;
}

.cta {
    display: block;
    margin: 20px 0;
    padding: 10px 20px;
    background-color: #ff6600;
    color: white;
    text-align: center;
    text-decoration: none;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    text-align: center;
    background-color: white;
    color: black;
    padding: 1rem;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
