<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 47.2mm; inset-block-start: 34.9mm; inline-size: 121.3mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 47.2mm; inset-block-start: 44.8mm; inline-size: 90.6mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 47.2mm; inset-block-start: 59.5mm; inline-size: 79.9mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 47.2mm; inset-block-start: 71.1mm; inline-size: 121.3mm; block-size: 66.4mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 47.2mm; inset-block-start: 141.4mm; inline-size: 121.3mm; block-size: 59.4mm; font-size: 10.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 47.2mm; inset-block-start: 212.4mm; inline-size: 75.8mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 47.2mm; inset-block-start: 224.0mm; inline-size: 121.3mm; block-size: 10.2mm; font-size: 10.0pt">{{ slot_6 }}</p>
</div></body>
</html>
