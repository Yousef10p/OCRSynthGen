}
#contact form {
    display: flex;
    flex-direction: column;
}
#contact form input,
#contact form textarea {
    margin-bottom: 10px;
}
footer {
    display: flex;
    justify-content: space-around;
    padding: 20px;
    background-color: #eee;
}
.menu, .social {
    list-style: none;
}
p {
    margin-top: 20px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
