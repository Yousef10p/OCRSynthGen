<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 45.3mm; inset-block-start: 15.3mm; inline-size: 127.1mm; block-size: 166.0mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 38.7mm; inset-block-start: 183.0mm; inline-size: 138.1mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 190.8mm; inline-size: 189.7mm; block-size: 11.8mm; font-size: 11.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 206.8mm; inline-size: 111.7mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 19.3mm; inset-block-start: 214.8mm; inline-size: 154.9mm; block-size: 11.8mm; font-size: 11.2pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 19.3mm; inset-block-start: 230.8mm; inline-size: 146.3mm; block-size: 7.9mm; font-size: 11.1pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 19.3mm; inset-block-start: 242.9mm; inline-size: 147.3mm; block-size: 15.8mm; font-size: 11.2pt"><li>{{ slot_5 }}</li></ul>
<footer class="box" style="inset-inline-start: 103.2mm; inset-block-start: 267.9mm; inline-size: 8.0mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
