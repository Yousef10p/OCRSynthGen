<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<section class="hero">
<h1>{{ slot_5 }}</h1>
</section>
<section class="services">
<div class="service">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<button>{{ slot_8 }}</button>
</div>
<div class="service">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<button>{{ slot_11 }}</button>
</div>
<div class="service">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<button>{{ slot_14 }}</button>
</div>
</section>
</body>
</html>