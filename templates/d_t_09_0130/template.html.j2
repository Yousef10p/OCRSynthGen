<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 28.1mm; inset-block-start: 38.4mm; inline-size: 158.6mm; block-size: 15.9mm; font-size: 24.8pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 35.3mm; inset-block-start: 65.2mm; inline-size: 144.1mm; block-size: 13.8mm; font-size: 10.0pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 71.5mm; inline-size: 6.3mm; block-size: 131.3mm; font-size: 20.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 76.8mm; inset-block-start: 90.1mm; inline-size: 61.1mm; block-size: 3.7mm; font-size: 8.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 63.8mm; inset-block-start: 95.2mm; inline-size: 87.1mm; block-size: 3.7mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 42.7mm; inset-block-start: 100.3mm; inline-size: 129.4mm; block-size: 3.7mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 47.0mm; inset-block-start: 105.4mm; inline-size: 120.9mm; block-size: 3.7mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 95.0mm; inset-block-start: 120.5mm; inline-size: 24.8mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 203.9mm; inline-size: 100.7mm; block-size: 44.5mm; font-size: 12.0pt">{{ slot_8 }}</p>
</div></body>
</html>
