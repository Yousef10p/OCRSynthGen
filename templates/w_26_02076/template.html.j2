<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

h1, h2 {
    text-align: center;
}


.menu {
    width: 100%;
    background-color: #f8f8f8;
    list-style-type: none;
    margin: 0;
    padding: 0;
    position: relative;
}

.menu li {
    display: inline-block;
}

.menu li a {
    display: block;
    padding: 10px 20px;
}

.menu a {
    text-decoration: none;
    color: black;
}

.sub-menu {
    position: absolute;
    display: none;
}

.menu li:hover .sub-menu {
    display: block;
}

.menu .sub-menu {
    margin-top: 10px;
}

.menu .sub-menu li {
    display: block;
}

.content {
    margin: 20px;
    padding: 20px;
    border: 1px solid #f1f1f1;
    border-radius: 5px;
}

.box {
    height: 100px;
    width: 100px;
    background-color: #ff0000;
    margin: 20px auto;
}

form {
    margin: 20px;
    padding: 20px;
    border: 1px solid #f1f1f1;
    border-radius: 5px;
    text-align: center;
}

input[type="email"] {
    padding: 10px;
    width: 80%;
    margin-bottom: 20px;
}

input[type="submit"] {
    padding: 10px 20px;
    background-color: #008CBA;
    border: none;
    color: white;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

<h1>{{ slot_0 }}</h1>

<div class="menu">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a>
<ul class="sub-menu">
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</li>
<li><a>{{ slot_5 }}</a>
<ul class="sub-menu">
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</div>

<div class="content">
<h2>{{ slot_9 }}</h2>
<div class="box"></div>
<p>{{ slot_10 }}</p>
</div>
<div class="content">
<h2>{{ slot_11 }}</h2>
<div class="box"></div>
<p>{{ slot_12 }}</p>
</div>

<form>
<h2>{{ slot_13 }}</h2>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_14 }}</span>
<span class="">{{ slot_15 }}</span>
</form>
</body>
</html>