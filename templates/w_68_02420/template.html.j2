<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    color: #1c1c1c;
    margin: 0;
    padding: 0;
    background-color: #ff4500;
}


.hero-section {
    position: relative;
    height: 100vh;
    background-image: none;
    background-size: cover;
    background-position: center;
}


.navbar {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.8);
}

.nav-menu {
    display: flex;
    justify-content: space-around;
    list-style-type: none;
    margin: 0;
    padding: 1em 0;
}


.nav-menu li a {
    color: #1c1c1c;
    text-decoration: none;
    transition: color 0.3s ease;
}

.nav-menu li a:hover {
    color: #ff4500;
}


.search-section {
    text-align: center;
    padding: 2em 0;
}

.search-form input {
    padding: 1em;
    border: none;
    border-radius: 2em;
    font-size: 1em;
    margin: 1em 0;
}


.property-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1em;
}


.property-grid div {
    background-color: #1c1c1c;
    height: 200px;
}


.feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1em;
}

.feature-grid div {
    background-color: #1c1c1c;
    height: 200px;
}


.footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: center;
    padding: 1em;
    background-color: rgba(255, 255, 255, 0.8);
    color: #1c1c1c;
}

.social-media-links a {
    color: #ff4500;
    margin: 0 0.5em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
