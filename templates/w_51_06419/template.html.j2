<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</section>
<section class="content-boxes">
<div class="content-box">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="image-placeholder">{{ slot_10 }}</div>
</div>
