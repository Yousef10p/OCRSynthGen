}

.restaurant {
    display: inline-block;
    margin: 20px;
    padding: 20px;
    background-color: #f8f8f8;
    border-radius: 5px;
    text-align: center;
}

.restaurant-img {
    height: 100px;
    width: 100px;
    margin: 0 auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
