<ul class="box" style="inset-inline-start: 31.6mm; inset-block-start: 92.2mm; inline-size: 155.8mm; block-size: 21.1mm; font-size: 12.0pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 71.4mm; inset-block-start: 118.9mm; inline-size: 79.8mm; block-size: 13.0mm; font-size: 12.0pt"></div>
