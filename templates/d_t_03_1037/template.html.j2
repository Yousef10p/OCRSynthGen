<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 111.9mm; inset-block-start: 0.0mm; inline-size: 72.7mm; block-size: 38.2mm; font-size: 15.5pt"></div>
<div class="box ph" style="inset-inline-start: 41.7mm; inset-block-start: 58.3mm; inline-size: 31.6mm; block-size: 91.6mm; font-size: 28.8pt"></div>
<h2 class="box" style="inset-inline-start: 112.2mm; inset-block-start: 63.0mm; inline-size: 62.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 69.4mm; inline-size: 90.3mm; block-size: 16.8mm; font-size: 15.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 88.5mm; inline-size: 89.9mm; block-size: 42.2mm; font-size: 17.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 132.9mm; inline-size: 89.4mm; block-size: 54.9mm; font-size: 17.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 182.4mm; inline-size: 41.1mm; block-size: 79.5mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 190.1mm; inline-size: 89.9mm; block-size: 35.9mm; font-size: 17.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 84.0mm; inset-block-start: 232.2mm; inline-size: 104.9mm; block-size: 15.2mm; font-size: 21.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 168.8mm; inset-block-start: 266.3mm; inline-size: 34.2mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
