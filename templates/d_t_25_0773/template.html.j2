<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 74.3mm; inset-block-start: 16.2mm; inline-size: 67.9mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 99.9mm; inset-block-start: 24.6mm; inline-size: 16.5mm; block-size: 7.4mm; font-size: 23.4pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 79.6mm; inset-block-start: 37.7mm; inline-size: 57.4mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 81.4mm; inset-block-start: 44.9mm; inline-size: 53.3mm; block-size: 3.1mm; font-size: 9.9pt">{{ slot_3 }}</h2>
<div class="box ph" style="inset-inline-start: 21.9mm; inset-block-start: 51.3mm; inline-size: 175.0mm; block-size: 231.4mm; font-size: 14.9pt"></div>
<footer class="box" style="inset-inline-start: 22.1mm; inset-block-start: 285.6mm; inline-size: 60.1mm; block-size: 2.7mm; font-size: 8.6pt">{{ slot_4 }}</footer>
</div></body>
</html>
