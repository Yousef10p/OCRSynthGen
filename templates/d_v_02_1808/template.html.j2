<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 105.4mm; inset-block-start: 14.1mm; inline-size: 4.8mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 64.9mm; inset-block-start: 27.1mm; inline-size: 86.2mm; block-size: 11.0mm; font-size: 15.6pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 95.9mm; inset-block-start: 45.9mm; inline-size: 24.3mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 58.1mm; inline-size: 164.2mm; block-size: 11.2mm; font-size: 15.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 70.7mm; inline-size: 164.4mm; block-size: 55.0mm; font-size: 17.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 220.7mm; inline-size: 164.2mm; block-size: 11.5mm; font-size: 8.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 236.1mm; inline-size: 164.3mm; block-size: 11.2mm; font-size: 10.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 248.1mm; inline-size: 164.5mm; block-size: 14.2mm; font-size: 10.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 263.1mm; inline-size: 164.3mm; block-size: 10.5mm; font-size: 9.9pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 274.4mm; inline-size: 164.3mm; block-size: 10.4mm; font-size: 9.8pt">{{ slot_9 }}</p>
</div></body>
</html>
