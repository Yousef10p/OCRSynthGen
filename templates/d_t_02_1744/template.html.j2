<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.5mm; inset-block-start: 16.1mm; inline-size: 54.1mm; block-size: 14.4mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 226.6mm; inline-size: 88.1mm; block-size: 20.2mm; font-size: 11.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 226.6mm; inline-size: 88.3mm; block-size: 11.8mm; font-size: 11.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 239.3mm; inline-size: 84.7mm; block-size: 7.5mm; font-size: 10.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 247.7mm; inline-size: 84.3mm; block-size: 11.8mm; font-size: 11.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 139.3mm; inset-block-start: 250.3mm; inline-size: 58.8mm; block-size: 9.1mm; font-size: 8.6pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 201.2mm; inset-block-start: 268.3mm; inline-size: 1.5mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_6 }}</footer>
</div></body>
</html>
