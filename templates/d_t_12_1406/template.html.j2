<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 220.0mm; inline-size: 89.9mm; block-size: 26.7mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 14.9mm; inset-block-start: 234.1mm; inline-size: 65.0mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</h2>
