}

header {
    width: 100%;
    background-color: #f8f8f8;
    text-align: center;
}

header nav ul {
    list-style-type: none;
    padding: 1em;
}

header nav ul li {
    display: inline-block;
    margin: 0 1em;
}

header img {
    height: 50px;
    margin: 1em;
}

main {
    display: flex;
    flex-direction: row;
}

section {
    flex-grow: 1;
    padding: 1em;
    text-align: center;
}

aside {
    background-color: #f8f8f8;
    width: 15%;
    padding: 1em;
    text-align: center;
}

form {
    display: flex;
    flex-direction: column;
}

form label {
    margin-bottom: 1em;
}

form input[type="submit"] {
    width: 100px;
    align-self: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
