<p class="box" style="inset-inline-start: 125.5mm; inset-block-start: 51.0mm; inline-size: 40.6mm; block-size: 3.3mm; font-size: 5.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 125.0mm; inset-block-start: 57.1mm; inline-size: 58.2mm; block-size: 45.5mm; font-size: 16.1pt"></div>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 98.9mm; inline-size: 86.4mm; block-size: 40.8mm; font-size: 12.9pt">{{ slot_4 }}</p>
