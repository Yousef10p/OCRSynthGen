<h2 class="box" style="inset-inline-start: 27.2mm; inset-block-start: 95.9mm; inline-size: 42.1mm; block-size: 5.0mm; font-size: 7.1pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 27.2mm; inset-block-start: 100.6mm; inline-size: 151.6mm; block-size: 16.9mm; font-size: 9.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 27.2mm; inset-block-start: 119.5mm; inline-size: 151.6mm; block-size: 29.2mm; font-size: 11.8pt">{{ slot_6 }}</p>
