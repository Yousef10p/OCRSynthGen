<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 91.1mm; inset-block-start: 31.6mm; inline-size: 104.4mm; block-size: 15.3mm; font-size: 14.4pt"></div>
<h2 class="box" style="inset-inline-start: 23.9mm; inset-block-start: 76.6mm; inline-size: 145.8mm; block-size: 6.4mm; font-size: 18.3pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 23.2mm; inset-block-start: 92.3mm; inline-size: 41.6mm; block-size: 42.1mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 70.4mm; inset-block-start: 95.0mm; inline-size: 126.7mm; block-size: 10.9mm; font-size: 15.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 70.4mm; inset-block-start: 114.4mm; inline-size: 126.3mm; block-size: 49.6mm; font-size: 17.6pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 23.6mm; inset-block-start: 141.8mm; inline-size: 41.0mm; block-size: 41.4mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 70.4mm; inset-block-start: 173.2mm; inline-size: 125.7mm; block-size: 55.5mm; font-size: 17.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 189.1mm; inline-size: 39.8mm; block-size: 20.7mm; font-size: 14.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 218.2mm; inline-size: 39.4mm; block-size: 32.3mm; font-size: 15.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 70.4mm; inset-block-start: 237.8mm; inline-size: 125.7mm; block-size: 16.7mm; font-size: 15.8pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 110.1mm; inset-block-start: 265.3mm; inline-size: 1.5mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_7 }}</footer>
</div></body>
</html>
