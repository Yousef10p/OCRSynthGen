<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 93.3mm; inline-size: 134.9mm; block-size: 29.5mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 68.3mm; inset-block-start: 129.8mm; inline-size: 110.1mm; block-size: 14.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 149.3mm; inline-size: 135.0mm; block-size: 21.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 73.7mm; inset-block-start: 177.5mm; inline-size: 104.8mm; block-size: 13.9mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 84.5mm; inset-block-start: 189.3mm; inline-size: 94.0mm; block-size: 13.9mm; font-size: 12.0pt"></div>
