<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	margin: 0;
	font-family: var(--font-body);
}

.navbar {
	background-color: #333;
	overflow: hidden;
}

.navbar a {
	float: right;
	display: block;
	color: #fff;
	text-align: center;
	padding: 14px 16px;
	text-decoration: none;
}

.dropdown {
	float: right;
	overflow: hidden;
}

.dropdown-content {
	display: none;
	position: absolute;
	background-color: #444;
	min-width: 160px;
	box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
	z-index: 1;
}

.dropdown-content a {
	float: none;
	color: black;
	padding: 12px 16px;
	text-decoration: none;
	display: block;
	text-align: right;
}

.hero-image {
	width: 100%;
	height: 300px;
	background-color: #f0f0f0;
	display: flex;
	align-items: center;
	justify-content: center;
}

.content {
	padding: 0 20px;
}

.content h2 {
	border-bottom: 1px solid #ccc;
	padding-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navbar">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li class="dropdown">
<a class="dropbtn">{{ slot_3 }}</a>
<div class="dropdown-content">
<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
<a>{{ slot_6 }}</a>
</div>
</li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</div>
<div class="hero-image">
<h1>{{ slot_8 }}</h1>
</div>
<div class="content">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>