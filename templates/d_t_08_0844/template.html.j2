<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 26.4mm; inline-size: 162.0mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 68.5mm; inset-block-start: 36.2mm; inline-size: 121.9mm; block-size: 33.7mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 71.2mm; inline-size: 165.1mm; block-size: 11.0mm; font-size: 10.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 79.7mm; inset-block-start: 88.5mm; inline-size: 110.7mm; block-size: 14.6mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 117.7mm; inline-size: 165.1mm; block-size: 46.9mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 69.8mm; inset-block-start: 171.0mm; inline-size: 120.6mm; block-size: 11.9mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 190.5mm; inline-size: 165.1mm; block-size: 28.2mm; font-size: 10.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 65.1mm; inset-block-start: 227.2mm; inline-size: 125.3mm; block-size: 26.8mm; font-size: 10.9pt"></div>
<footer class="box" style="inset-inline-start: 106.0mm; inset-block-start: 261.7mm; inline-size: 3.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</footer>
</div></body>
</html>
