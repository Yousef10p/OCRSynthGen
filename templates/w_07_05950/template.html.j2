<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	margin: 0;
	padding: 0;
	font-family: var(--font-body);
	color: #333;
	text-align: center;
}

header {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: 100vh;
	background: linear-gradient(to left, #333, #999);
	color: #fff;
}

header img {
	width: 100px;
	height: 100px;
	border-radius: 50px;
}

nav ul {
	list-style-type: none;
	padding: 0;
}

nav ul li {
	display: inline;
	margin: 0 1em;
}

nav ul li a {
	text-decoration: none;
	color: #fff;
}

.cta {
	display: block;
	margin: 2em 0;
	padding: 0.5em 1em;
	background: #fff;
	color: #333;
	border-radius: 5px;
	text-decoration: none;
}

main {
	padding: 2em;
}

main h1, main h2 {
	margin-bottom: 0.5em;
}

.promo {
	display: flex;
	align-items: center;
	justify-content: space-around;
}

.placeholder {
	width: 200px;
	height: 200px;
	background: #ddd;
	margin: 1em;
}

footer {
	position: absolute;
	bottom: 0;
	width: 100%;
	height: 50px;
	background: #333;
	color: #fff;
	display: flex;
	align-items: center;
	justify-content: center;
}

footer span {
	font-size: 0.8em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<a class="cta">{{ slot_4 }}</a>
</header>
<main>
<section>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
</section>
<section>
<h2>{{ slot_7 }}</h2>
<div class="promo">
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
<div class="placeholder">{{ slot_10 }}</div>
</div>
<div class="promo">
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
<div class="placeholder">{{ slot_13 }}</div>
</div>
</section>
</main>
<footer>
<span>{{ slot_14 }}</span>
</footer>
</body>
</html>