<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 118.2mm; inline-size: 159.7mm; block-size: 28.6mm; font-size: 11.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 149.9mm; inline-size: 156.8mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 160.5mm; inline-size: 153.5mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 171.1mm; inline-size: 160.0mm; block-size: 24.4mm; font-size: 11.5pt">{{ slot_7 }}</p>
