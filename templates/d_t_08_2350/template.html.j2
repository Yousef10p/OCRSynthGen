<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 26.1mm; inline-size: 4.2mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 80.6mm; inset-block-start: 34.9mm; inline-size: 48.8mm; block-size: 96.5mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 138.9mm; inline-size: 8.0mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 44.2mm; inset-block-start: 147.4mm; inline-size: 121.6mm; block-size: 18.1mm; font-size: 7.0pt"></div>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 173.6mm; inline-size: 6.8mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 85.4mm; inset-block-start: 182.4mm; inline-size: 43.0mm; block-size: 13.5mm; font-size: 10.0pt"></div>
<div class="box ph" style="inset-inline-start: 81.6mm; inset-block-start: 200.4mm; inline-size: 39.9mm; block-size: 4.6mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 213.2mm; inline-size: 92.2mm; block-size: 4.1mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 78.4mm; inset-block-start: 223.8mm; inline-size: 53.2mm; block-size: 30.4mm; font-size: 10.0pt"></div>
<footer class="box" style="inset-inline-start: 103.2mm; inset-block-start: 280.1mm; inline-size: 3.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_4 }}</footer>
</div></body>
</html>
