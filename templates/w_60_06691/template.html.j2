<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    padding:0;
    margin:0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

.menu-wrap {
    background:rgba(255,255,255,0.2);
    box-shadow:0px 0px 10px rgba(0,0,0,0.1);
    position: absolute;
    top:0;
    right:0;
    z-index:1000;
    width:100%;
    height:60px;
}

.menu {
    width:80%;
    max-width:1000px;
    text-align:center;
    margin:0 auto;
}

.menu ul {
    padding:20px 0;
    list-style:none;
}

.menu ul li {
    display:inline-block;
}

.menu ul li a {
    display:block;
    padding: 20px;
    color:#008C8D;
    transition:all 0.5s ease;
}

.menu ul li a span {
    padding-right:10px;
}

.menu ul li a:hover {
   background: #008C8D;
   color: #fff;
}

.menu ul ul {
     position:absolute;
     display:none;
     background:#ffffff;
     width:200px;
    box-shadow:0px 0px 10px rgba(0,0,0,0.1);
    z-index:1000;
}

.menu ul ul li {
    width:100%;
    display:block;
    text-align:center;
}

.menu ul ul li a {
   display:block;
   padding:10px 20px;
   color:#555;
}

.menu ul li:hover ul {
    display:block;
    margin-top:10px;
}

.arrow {
    font-size:8px;
    display:inline-block;
    transform:rotate(-90deg);
    color:#008C8D;
}

.mainContainer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    margin-top: 100px;
}

.card {
    width: 300px;
    height: 300px;
    margin-bottom: 20px;
    text-align: center;
    box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
}

.card img {
    width: 100%;
    height: 200px;
    background-color: #000;
}

.card p {
    padding: 20px;
    text-align: right;
    font-style: italic;
    color: #555;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu-wrap">
<nav class="menu">
<ul class="clearfix">
<li><a>{{ slot_0 }}<span class="arrow">{{ slot_1 }}</span></a></li>
<li><span>{{ slot_2 }}<span class="arrow">{{ slot_3 }}</span></span>
