  padding: 50px 0;
  text-align: center;
}

#donation h2 {
  font-size: 30px;
}

#donation form {
  margin: auto;
  width: 500px;
  display: flex;
  flex-direction: column;
}

#donation form label {
  margin-top: 20px;
  font-size: 20px;
}

#donation form input[type=text], #donation form input[type=email], #donation form input[type=number] {
  padding: 10px;
  font-size: 20px;
}

#donation form input[type=submit] {
  background-color: #6600ff;
  border: none;
  color: #ffffff;
  padding: 10px 20px;
  font-size: 20px;
  margin-top: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
