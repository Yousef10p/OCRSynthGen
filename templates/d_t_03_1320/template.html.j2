<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 30.6mm; inset-block-start: 47.1mm; inline-size: 34.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 120.2mm; inset-block-start: 46.7mm; inline-size: 50.0mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 30.6mm; inset-block-start: 51.7mm; inline-size: 54.2mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 120.2mm; inset-block-start: 51.3mm; inline-size: 63.3mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 120.2mm; inset-block-start: 60.3mm; inline-size: 80.4mm; block-size: 38.4mm; font-size: 13.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 30.6mm; inset-block-start: 65.3mm; inline-size: 80.4mm; block-size: 53.5mm; font-size: 13.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 120.2mm; inset-block-start: 100.6mm; inline-size: 80.4mm; block-size: 43.4mm; font-size: 13.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 30.6mm; inset-block-start: 120.8mm; inline-size: 80.3mm; block-size: 23.3mm; font-size: 13.2pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 0.4mm; inset-block-start: 149.4mm; inline-size: 180.5mm; block-size: 110.4mm; font-size: 14.9pt"></div>
<div class="box ph" style="inset-inline-start: 182.9mm; inset-block-start: 149.4mm; inline-size: 32.3mm; block-size: 110.6mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 15.5mm; inset-block-start: 260.5mm; inline-size: 84.2mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 10.1mm; inset-block-start: 270.0mm; inline-size: 2.7mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_9 }}</footer>
</div></body>
</html>
