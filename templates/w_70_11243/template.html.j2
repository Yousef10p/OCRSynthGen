<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-body);
}
header, footer {
    background-color: #F5F5F5;
    padding: 20px;
}
header .logo {
    font-size: 2em;
    color: #333;
}
header .main-nav, .side-nav {
    padding: 10px 0;
}
header .main-nav ul, .side-nav ul {
    display: flex;
    justify-content: space-around;
}
.body-content {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #F5F5F5;
}
.body-content .colored-rectangle {
    background-color: #BEBEBE;
    width: 70%;
    height: 400px;
    border-radius: 5px;
}
footer .info {
    margin: 10px 0;
}
footer .links a {
    margin-left: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo">{{ slot_0 }}</div>
<nav class="main-nav">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<nav class="side-nav">
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
</nav>
</header>
<div class="body-content">
<div class="colored-rectangle"></div>
</div>
<footer>
<div class="info">{{ slot_11 }}</div>
<div class="links">
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</div>
</footer>
</body>
</html>