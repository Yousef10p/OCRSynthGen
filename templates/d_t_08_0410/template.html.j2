<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 194.8mm; inset-block-start: 16.3mm; inline-size: 3.5mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 25.7mm; inline-size: 26.4mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 118.3mm; inset-block-start: 25.7mm; inline-size: 23.1mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 19.0mm; inset-block-start: 34.1mm; inline-size: 86.5mm; block-size: 31.7mm; font-size: 9.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 111.8mm; inset-block-start: 34.9mm; inline-size: 85.6mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 111.8mm; inset-block-start: 44.2mm; inline-size: 86.4mm; block-size: 12.4mm; font-size: 9.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 19.0mm; inset-block-start: 71.8mm; inline-size: 86.5mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_6 }}</li></ul>
</div></body>
</html>
