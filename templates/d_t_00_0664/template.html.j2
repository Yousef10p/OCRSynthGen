<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 142.5mm; inset-block-start: 1.4mm; inline-size: 32.4mm; block-size: 32.4mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 7.7mm; inline-size: 27.4mm; block-size: 6.9mm; font-size: 9.8pt">{{ slot_0 }}</p>
<header class="box" style="inset-inline-start: 185.3mm; inset-block-start: 8.0mm; inline-size: 11.5mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 40.1mm; inline-size: 89.0mm; block-size: 106.2mm; font-size: 13.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 39.7mm; inline-size: 88.9mm; block-size: 22.7mm; font-size: 12.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 64.4mm; inline-size: 88.9mm; block-size: 37.5mm; font-size: 13.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 103.9mm; inline-size: 89.1mm; block-size: 42.5mm; font-size: 13.4pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 152.4mm; inline-size: 66.2mm; block-size: 9.4mm; font-size: 13.4pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 92.1mm; inset-block-start: 152.4mm; inline-size: 103.5mm; block-size: 23.8mm; font-size: 9.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 79.9mm; inset-block-start: 158.9mm; inline-size: 6.7mm; block-size: 1.7mm; font-size: 5.0pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 12.3mm; inset-block-start: 181.1mm; inline-size: 184.7mm; block-size: 84.2mm; font-size: 14.9pt"></div>
</div></body>
</html>
