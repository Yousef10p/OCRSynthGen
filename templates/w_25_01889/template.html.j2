</div>
<div class="grid-item">
<h2>{{ slot_5 }}</h2>
<div class="rectangle"></div>
<p>{{ slot_6 }}</p>
</div>

</div>
<div id="footer">
<a>{{ slot_7 }}</a>
<a>{{ slot_8 }}</a>
<a>{{ slot_9 }}</a>
<form>
