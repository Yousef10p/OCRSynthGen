<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    height: 100%;
    width: 100%;
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    color: white;
}

body {
    flex-direction: row;
}

nav, .colLeft {
    width: 300px;
    background-color: rgba(0,0,255,0.7);
}

.colRight {
    flex-grow: 1;
    background-color: rgba(192,192,192,0.7);
}

input[type=text] {
    width: 90%;
    padding: 12px 20px;
    margin: 8px 0;
    display: inline-block;
    border: 1px solid #ccc;
    border-radius: 4px;
}

nav ul {
    list-style-type: none;
    padding-right: 0;
}

.colLeft h2 {
    text-align: center;
}

.colLeft p {
    margin: 15px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<h2>{{ slot_1 }}</h2>
<ul>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
<h2>{{ slot_5 }}</h2>
<ul>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
</ul>
</nav>
<section>
<div class="colLeft">
<h1>{{ slot_9 }}</h1>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</div>
<div class="colRight"></div>
</section>
</body>
</html>