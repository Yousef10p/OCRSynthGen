}

footer {
    background-color: #ccc;
    padding: 20px;
    text-align: center;
}

#contact-us {
    margin-top: 50px;
}

#contact-us form input[type="text"] {
    display: block;
    width: 100%;
    margin-bottom: 20px;
    padding: 10px;
}

#contact-us form textarea {
    display: block;
    width: 100%;
    height: 100px;
    margin-bottom: 20px;
    padding: 10px;
}

#contact-us form input[type="submit"] {
    display: block;
    width: 100%;
    padding: 10px;
    background-color: #f00;
    color: #fff;
    border: none;
    border-radius: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
