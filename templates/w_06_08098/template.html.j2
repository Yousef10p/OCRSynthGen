}

h2, h3 {
    margin-bottom: 20px;
}

.button {
    background-color: #f00;
    color: #fff;
    padding: 10px 20px;
    border-radius: 5px;
}

main {
    display: flex;
    justify-content: space-around;
    margin: 50px 0;
}

.column {
    width: 30%;
    text-align: center;
}

.placeholder {
    background-color: #ddd;
