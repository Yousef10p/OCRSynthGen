<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.4mm; inset-block-start: 7.9mm; inline-size: 215.2mm; block-size: 7.2mm; font-size: 20.3pt"></div>
<h2 class="box" style="inset-inline-start: 25.8mm; inset-block-start: 38.5mm; inline-size: 154.3mm; block-size: 7.3mm; font-size: 20.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 80.0mm; inset-block-start: 56.7mm; inline-size: 106.9mm; block-size: 15.5mm; font-size: 14.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 80.0mm; inset-block-start: 73.7mm; inline-size: 106.6mm; block-size: 32.5mm; font-size: 15.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 80.0mm; inset-block-start: 107.5mm; inline-size: 110.5mm; block-size: 43.8mm; font-size: 15.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 80.0mm; inset-block-start: 152.7mm; inline-size: 109.2mm; block-size: 26.8mm; font-size: 15.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 80.0mm; inset-block-start: 180.9mm; inline-size: 110.2mm; block-size: 21.2mm; font-size: 15.0pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 9.9mm; inset-block-start: 197.8mm; inline-size: 4.2mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 80.0mm; inset-block-start: 203.5mm; inline-size: 104.1mm; block-size: 32.5mm; font-size: 15.3pt">{{ slot_7 }}</p>
</div></body>
</html>
