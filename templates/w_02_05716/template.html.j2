<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: #000000;
    background-color: #FFFFFF;
}

header {
    position: sticky;
    top: 0;
    width: 100%;
    background-color: #FFFFFF;
    padding: 20px 0;
    z-index: 100;
}

header #logo {
    position: absolute;
    right: 45%;
    font-size: 22px;
}

header nav {
    position: absolute;
    left: 0;
    top: 25px;
}

header nav ul {
    list-style: none;
}

header nav ul li {
    display: inline;
    margin-left: 20px;
}

header nav ul li a {
    color: #000000;
    text-decoration: none;
}

#image-slider {
    height: 500px;
    background-color: #000000;
    margin-bottom: 50px;
}

#content {
    width: 70%;
    margin: 0 auto;
    line-height: 1.6em;
}

h2 {
    border-bottom: 2px solid #000000;
    padding-bottom: 10px;
}

footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    text-align: center;
    padding: 20px 0;
    background-color: #FFFFFF;
}

.media-icon {
    display: inline-block;
    margin: 0 10px;
    width: 30px;
    height: 30px;
    border: 1px solid #000000;
    text-align: center;
    line-height: 30px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
