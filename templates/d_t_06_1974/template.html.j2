<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 10.0mm; inset-block-start: 6.5mm; inline-size: 3.9mm; block-size: 7.1mm; font-size: 20.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 18.2mm; inset-block-start: 9.6mm; inline-size: 55.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 10.0mm; inset-block-start: 24.5mm; inline-size: 86.5mm; block-size: 27.0mm; font-size: 12.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 106.3mm; inset-block-start: 24.5mm; inline-size: 83.6mm; block-size: 21.6mm; font-size: 12.2pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 106.3mm; inset-block-start: 49.4mm; inline-size: 30.2mm; block-size: 4.2mm; font-size: 11.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 10.0mm; inset-block-start: 54.3mm; inline-size: 88.1mm; block-size: 45.5mm; font-size: 12.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 106.3mm; inset-block-start: 54.1mm; inline-size: 88.1mm; block-size: 34.9mm; font-size: 12.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 106.3mm; inset-block-start: 91.6mm; inline-size: 86.0mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 9.8mm; inset-block-start: 103.6mm; inline-size: 76.8mm; block-size: 93.1mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 87.4mm; inset-block-start: 103.8mm; inline-size: 107.5mm; block-size: 92.5mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 9.5mm; inset-block-start: 197.2mm; inline-size: 116.7mm; block-size: 87.3mm; font-size: 15.5pt"></div>
<div class="box ph" style="inset-inline-start: 126.7mm; inset-block-start: 197.2mm; inline-size: 68.0mm; block-size: 87.7mm; font-size: 14.6pt"></div>
</div></body>
</html>
