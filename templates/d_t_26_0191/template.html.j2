<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 54.4mm; inline-size: 119.2mm; block-size: 7.3mm; font-size: 10.3pt"><li>{{ slot_0 }}</li></ul>
<div class="box ph" style="inset-inline-start: 56.4mm; inset-block-start: 67.9mm; inline-size: 70.7mm; block-size: 45.9mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 115.3mm; inline-size: 64.5mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 122.8mm; inline-size: 121.2mm; block-size: 7.3mm; font-size: 10.3pt"><li>{{ slot_2 }}</li></ul>
<div class="box ph" style="inset-inline-start: 56.3mm; inset-block-start: 136.3mm; inline-size: 93.3mm; block-size: 63.1mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 200.9mm; inline-size: 51.1mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 208.5mm; inline-size: 118.5mm; block-size: 7.3mm; font-size: 10.3pt"><li>{{ slot_4 }}</li></ul>
<footer class="box" style="inset-inline-start: 122.5mm; inset-block-start: 248.2mm; inline-size: 55.7mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
