<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 21.1mm; inset-block-start: 20.8mm; inline-size: 34.5mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.7mm; inset-block-start: 26.7mm; inline-size: 60.8mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.7mm; inset-block-start: 32.1mm; inline-size: 58.2mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_2 }}</p>
<h1 class="box" style="inset-inline-start: 162.7mm; inset-block-start: 37.2mm; inline-size: 70.4mm; block-size: 14.5mm; font-size: 16.8pt">{{ slot_3 }}</h1>
<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 38.1mm; inline-size: 11.8mm; block-size: 11.8mm; font-size: 16.7pt"></div>
<h2 class="box" style="inset-inline-start: 21.1mm; inset-block-start: 50.5mm; inline-size: 23.9mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 21.1mm; inset-block-start: 55.4mm; inline-size: 109.5mm; block-size: 17.0mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.7mm; inset-block-start: 74.0mm; inline-size: 55.0mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 79.5mm; inline-size: 12.0mm; block-size: 12.7mm; font-size: 18.0pt"></div>
<p class="box" style="inset-inline-start: 21.1mm; inset-block-start: 163.1mm; inline-size: 36.9mm; block-size: 12.8mm; font-size: 10.0pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 20.7mm; inset-block-start: 176.0mm; inline-size: 35.6mm; block-size: 11.1mm; font-size: 40.0pt"></div>
</div></body>
</html>
