<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 24.2mm; inset-block-start: 15.2mm; inline-size: 35.6mm; block-size: 8.3mm; font-size: 9.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 49.4mm; inset-block-start: 25.9mm; inline-size: 131.8mm; block-size: 54.4mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 49.7mm; inset-block-start: 80.6mm; inline-size: 130.9mm; block-size: 29.8mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 123.5mm; inset-block-start: 111.2mm; inline-size: 52.3mm; block-size: 3.9mm; font-size: 9.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 54.1mm; inset-block-start: 115.8mm; inline-size: 62.6mm; block-size: 14.2mm; font-size: 11.9pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 113.3mm; inset-block-start: 261.5mm; inline-size: 3.6mm; block-size: 3.9mm; font-size: 9.9pt">{{ slot_5 }}</footer>
</div></body>
</html>
