    -webkit-overflow-scrolling: touch;
    margin-bottom: 20px;
}

#slider .slides section {
    scroll-snap-align: start;
    flex-shrink: 0;
    width: 100%;
}

#articles-section article {
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
