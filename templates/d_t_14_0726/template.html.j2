<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 25.1mm; inset-block-start: 12.3mm; inline-size: 58.7mm; block-size: 15.4mm; font-size: 14.5pt"></div>
<header class="box" style="inset-inline-start: 92.9mm; inset-block-start: 12.5mm; inline-size: 93.7mm; block-size: 17.8mm; font-size: 10.0pt">{{ slot_0 }}</header><h1 class="box" style="inset-inline-start: 78.5mm; inset-block-start: 73.1mm; inline-size: 54.8mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_1 }}</h1>
<h1 class="box" style="inset-inline-start: 59.9mm; inset-block-start: 86.8mm; inline-size: 92.0mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 29.6mm; inset-block-start: 102.7mm; inline-size: 152.7mm; block-size: 20.5mm; font-size: 16.0pt">{{ slot_3 }}</h1>
<h1 class="box" style="inset-inline-start: 94.2mm; inset-block-start: 125.4mm; inline-size: 21.5mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_4 }}</h1>
<h1 class="box" style="inset-inline-start: 57.2mm; inset-block-start: 141.2mm; inline-size: 97.4mm; block-size: 13.7mm; font-size: 16.0pt">{{ slot_5 }}</h1>
<p class="box" style="inset-inline-start: 58.1mm; inset-block-start: 180.7mm; inline-size: 95.8mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 46.9mm; inset-block-start: 198.7mm; inline-size: 118.1mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 28.9mm; inset-block-start: 212.4mm; inline-size: 154.1mm; block-size: 13.7mm; font-size: 16.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 58.3mm; inset-block-start: 279.7mm; inline-size: 94.2mm; block-size: 2.8mm; font-size: 6.5pt">{{ slot_9 }}</p>
</div></body>
</html>
