    background-color: #f8f8f8;
}

nav ul {
    width: 100%;
    padding: 20px 0;
}

nav a {
    text-decoration: none;
    color: #000;
}

section {
    width: 100%;
    height: 500px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 50px;
    margin-bottom: 50px;
    background-color: #f8f8f8;
}

form {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

form label {
    margin-bottom: 10px;
}

form input, form textarea {
    margin-bottom: 20px;
}

form input[type="submit"] {
    cursor: pointer;
    padding: 10px 20px;
    background-color: #000;
    color: #fff;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
