<li><a>{{ slot_1 }}</a></li>
<li class="sign-up"><a>{{ slot_2 }}</a></li>
<li class="faq"><a>{{ slot_3 }}</a></li>
<li class="contact"><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<section class="banner">
<div class="slide current">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
<div class="slide">{{ slot_7 }}</div>
</section>
<section id="courses">{{ slot_8 }}</section>
<section id="programs">{{ slot_9 }}</section>
<section id="sign-up">{{ slot_10 }}</section>
<section id="faq">{{ slot_11 }}</section>
<section id="contact">{{ slot_12 }}</section>
<footer>
<p>{{ slot_13 }}</p>
</footer>
<a class="contact-us">{{ slot_14 }}</a>

</body>
</html>