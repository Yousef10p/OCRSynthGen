}

form button[type="submit"] {
    display: block;
    margin: 1em auto;
    padding: 0.5em 1em;
    border: none;
    background: #333;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
