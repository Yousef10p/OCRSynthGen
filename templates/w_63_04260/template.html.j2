}

.parallax {
    background: none no-repeat center;
    background-size: cover;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #fff;
    text-shadow: -2px 2px 4px rgba(0,0,0,0.5);
}

#properties, #about-us, #contact-us {
