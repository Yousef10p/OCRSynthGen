<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 261.2mm; inset-block-start: 6.7mm; inline-size: 10.0mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 24.2mm; inline-size: 142.3mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 18.3mm; inset-block-start: 28.1mm; inline-size: 264.9mm; block-size: 29.3mm; font-size: 10.4pt"></div>
<h2 class="box" style="inset-inline-start: 53.0mm; inset-block-start: 66.4mm; inline-size: 55.8mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 17.8mm; inset-block-start: 74.9mm; inline-size: 257.9mm; block-size: 109.9mm; font-size: 9.7pt"></div>
<footer class="box" style="inset-inline-start: 20.0mm; inset-block-start: 188.7mm; inline-size: 31.5mm; block-size: 6.8mm; font-size: 9.6pt">{{ slot_3 }}</footer><footer class="box" style="inset-inline-start: 274.9mm; inset-block-start: 188.8mm; inline-size: 2.1mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_4 }}</footer>
</div></body>
</html>
