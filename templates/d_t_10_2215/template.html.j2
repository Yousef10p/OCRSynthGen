<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 31.0mm; inset-block-start: 28.4mm; inline-size: 148.9mm; block-size: 14.0mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 74.4mm; inset-block-start: 49.7mm; inline-size: 61.8mm; block-size: 4.6mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 57.9mm; inline-size: 141.6mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 96.0mm; inset-block-start: 66.4mm; inline-size: 18.9mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_3 }}</h2>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 68.6mm; inline-size: 6.3mm; block-size: 120.5mm; font-size: 20.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 75.0mm; inline-size: 160.0mm; block-size: 26.8mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 110.1mm; inline-size: 69.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 250.9mm; inline-size: 39.6mm; block-size: 3.9mm; font-size: 8.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 26.3mm; inset-block-start: 255.4mm; inline-size: 38.7mm; block-size: 3.9mm; font-size: 8.5pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 102.3mm; inset-block-start: 265.8mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
