<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 24.2mm; inset-block-start: 27.3mm; inline-size: 48.0mm; block-size: 9.9mm; font-size: 28.2pt"></div>
<h2 class="box" style="inset-inline-start: 36.0mm; inset-block-start: 50.7mm; inline-size: 14.7mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 57.2mm; inline-size: 148.1mm; block-size: 15.8mm; font-size: 11.2pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 36.0mm; inset-block-start: 78.2mm; inline-size: 37.0mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 84.7mm; inline-size: 157.4mm; block-size: 37.0mm; font-size: 11.6pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 114.2mm; inset-block-start: 133.9mm; inline-size: 58.8mm; block-size: 13.4mm; font-size: 38.0pt"></div>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 135.5mm; inline-size: 28.3mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 148.9mm; inline-size: 19.4mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 148.9mm; inline-size: 34.6mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 13.4mm; inset-block-start: 270.5mm; inline-size: 49.7mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
