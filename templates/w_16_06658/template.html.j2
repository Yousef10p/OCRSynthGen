    align-items: center;
    padding: 10px;
    background-color: #f8f8f8;
}

.nav a {
    margin-left: 20px;
    text-decoration: none;
    color: #333;
}

.search-bar {
    width: 200px;
    height: 30px;
    margin-left: 20px;
}

.filter-container {
    display: flex;
    justify-content: space-between;
    margin: 20px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 10px;
}

.filter {
    border: 1px solid #ccc;
    padding: 5px;
    margin-left: 10px;
}

.destinations {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
    padding: 20px;
}

.placeholder {
    width: 100%;
    height: 100px;
    background-color: #ddd;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
