<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    background-color: #f4f4f4;
    text-align: center;
    padding: 10px;
    margin-bottom: 20px;
}

.banner {
    background-color: #ccc;
    height: 300px;
    text-align: center;
    padding-top: 120px;
    font-size: 2em;
}

.content {
    display: flex;
    justify-content: space-between;
    margin: 20px;
}

.sidebar {
    width: 20%;
    background-color: #f4f4f4;
    padding: 20px;
}

.sidebar ul {
    list-style: none;
    padding: 0;
}

.sidebar ul li a {
    text-decoration: none;
    color: #333;
}

main {
    width: 75%;
    background-color: #fff;
    padding: 20px;
}


.sidebar ul li a:before {
    content: "";
    display: inline-block;
    width: 100px;
    height: 100px;
    margin-left: 10px;
    background-color: #ccc;
    vertical-align: middle;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="banner">{{ slot_0 }}</div>
</header>
<div class="content">
<div class="sidebar">
<h2>{{ slot_1 }}</h2>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
<h2>{{ slot_5 }}</h2>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
<h2>{{ slot_9 }}</h2>
<ul>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
</ul>
<h2>{{ slot_12 }}</h2>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</div>
<main>
</main>
</div>
</body>
</html>