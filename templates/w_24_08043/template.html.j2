<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

.slider {
    height: 100vh;
    display: flex;
}

.slide {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.slide:nth-child(1) {
    background-color: pink;
}

.slide:nth-child(2) {
    background-color: purple;
}

.slide:nth-child(3) {
    background-color: black;
}

.sidebar {
    width: 200px;
    height: 100vh;
    position: absolute;
    top: 0;
    left: 0;
    background-color: black;
    color: white;
    padding: 20px;
}

.sidebar ul {
    list-style-type: none;
    padding: 0;
}

.sidebar ul li {
    margin-bottom: 10px;
}

.product-descriptions {
    width: calc(100% - 200px);
    margin-right: 200px;
    padding: 20px;
}

.product {
    margin-bottom: 20px;
}

.product h2 {
    color: black;
}

.product p:last-child {
    color: grey;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="slider">
<div class="slide">{{ slot_0 }}</div>
<div class="slide">{{ slot_1 }}</div>
<div class="slide">{{ slot_2 }}</div>
</div>
<div class="sidebar">
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</div>
<div class="product-descriptions">
<div class="product">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
</div>
<div class="product">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
</div>
<div class="product">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
</div>
</div>
</body>
</html>