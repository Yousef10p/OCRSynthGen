<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 21.1mm; inset-block-start: 13.0mm; inline-size: 43.1mm; block-size: 31.0mm; font-size: 14.7pt"></div>
<h2 class="box" style="inset-inline-start: 68.3mm; inset-block-start: 12.7mm; inline-size: 18.3mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 68.3mm; inset-block-start: 17.3mm; inline-size: 113.7mm; block-size: 27.1mm; font-size: 9.6pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 21.2mm; inset-block-start: 76.2mm; inline-size: 44.1mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 86.1mm; inline-size: 160.9mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 100.9mm; inline-size: 160.9mm; block-size: 33.1mm; font-size: 13.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 135.5mm; inline-size: 160.9mm; block-size: 28.2mm; font-size: 13.3pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 21.2mm; inset-block-start: 170.0mm; inline-size: 60.6mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 175.0mm; inline-size: 160.9mm; block-size: 47.9mm; font-size: 13.6pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 21.2mm; inset-block-start: 229.3mm; inline-size: 21.0mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 234.2mm; inline-size: 160.9mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 21.2mm; inset-block-start: 264.6mm; inline-size: 2.7mm; block-size: 2.7mm; font-size: 7.5pt">{{ slot_10 }}</footer>
</div></body>
</html>
