<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 65.4mm; inset-block-start: 33.0mm; inline-size: 35.1mm; block-size: 13.9mm; font-size: 19.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 49.2mm; inline-size: 71.9mm; block-size: 13.9mm; font-size: 19.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 33.3mm; inset-block-start: 65.5mm; inline-size: 67.2mm; block-size: 13.9mm; font-size: 19.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 29.0mm; inset-block-start: 81.7mm; inline-size: 72.3mm; block-size: 23.7mm; font-size: 16.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 122.5mm; inset-block-start: 101.3mm; inline-size: 57.4mm; block-size: 44.8mm; font-size: 31.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 107.8mm; inline-size: 74.3mm; block-size: 18.8mm; font-size: 17.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 23.4mm; inset-block-start: 128.3mm; inline-size: 78.6mm; block-size: 18.8mm; font-size: 17.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 22.1mm; inset-block-start: 149.4mm; inline-size: 79.9mm; block-size: 18.8mm; font-size: 17.8pt">{{ slot_7 }}</p>
