}

#logo {
    font-size: 25px;
    color: #FFFFFF;
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
}

nav ul li a {
    color: #FFFFFF;
    text-decoration: none;
}

main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
}

.rectangle {
    width: 100px;
    height: 100px;
    background-color: #2F4C58;
