        {{ slot_5 }} <div class="slide" style="background-color: #00ccff;"></div>
    {{ slot_6 }} </div>
    {{ slot_7 }} <div id="menu">
        {{ slot_8 }} <ul>
            {{ slot_9 }} <li><a>{{ slot_10 }}</a></li>
            {{ slot_11 }} <li><a>{{ slot_12 }}</a></li>
            {{ slot_13 }} <li><a>{{ slot_14 }}</a></li>
        {{ slot_15 }} </ul>
    {{ slot_16 }} </div>
