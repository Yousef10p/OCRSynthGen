<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 58.0mm; inline-size: 134.7mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 44.5mm; inset-block-start: 65.0mm; inline-size: 154.3mm; block-size: 58.3mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.5mm; inset-block-start: 126.4mm; inline-size: 153.6mm; block-size: 38.6mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 168.1mm; inline-size: 40.6mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 44.5mm; inset-block-start: 174.3mm; inline-size: 154.3mm; block-size: 8.7mm; font-size: 10.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 31.8mm; inset-block-start: 186.7mm; inline-size: 29.6mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 193.8mm; inline-size: 160.1mm; block-size: 58.3mm; font-size: 10.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 109.2mm; inset-block-start: 265.3mm; inline-size: 4.9mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
