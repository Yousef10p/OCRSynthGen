}

.testimonials {
    width: 65%;
}

.footer {
    display: flex;
    justify-content: space-around;
    margin-top: 20px;
}

.footer div {
    border-right: 1px solid #C0C0C0;
    padding-right: 10px;
}

.footer div:first-child {
    border-right: none;
}

ul {
    padding: 0;
}

li {
    list-style-type: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
