}
.grid-item {
    border: 1px solid #000;
    padding: 20px;
}
.img {
    height: 100px;
    background: #ccc;
}
.social-links {
    display: flex;
    justify-content: space-between;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
