<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 14.9mm; inline-size: 121.7mm; block-size: 7.5mm; font-size: 21.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 33.0mm; inline-size: 184.5mm; block-size: 47.4mm; font-size: 19.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 10.6mm; inset-block-start: 88.5mm; inline-size: 91.0mm; block-size: 36.0mm; font-size: 11.3pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 110.1mm; inset-block-start: 89.5mm; inline-size: 88.9mm; block-size: 12.2mm; font-size: 11.5pt"><li>{{ slot_3 }}</li></ul>
<div class="box ph" style="inset-inline-start: 110.0mm; inset-block-start: 109.6mm; inline-size: 88.3mm; block-size: 122.8mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 126.1mm; inline-size: 88.9mm; block-size: 30.5mm; font-size: 12.4pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 161.3mm; inline-size: 46.7mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 166.0mm; inline-size: 88.9mm; block-size: 39.7mm; font-size: 12.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 207.3mm; inline-size: 88.9mm; block-size: 39.7mm; font-size: 12.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 237.1mm; inline-size: 87.4mm; block-size: 23.7mm; font-size: 9.6pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 248.6mm; inline-size: 88.8mm; block-size: 12.2mm; font-size: 11.5pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 8.5mm; inset-block-start: 269.6mm; inline-size: 3.4mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
