<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
   font-family: var(--font-body);
}

header {
   background-color: #f0f0f0;
   padding: 20px;
   text-align: center;
}

nav ul {
   list-style-type: none;
   padding: 0;
}

.menu-item {
   background-color: #eee;
   border: 1px solid #ddd;
   border-radius: 5px;
   padding: 10px;
   margin-bottom: 10px;
   overflow: hidden;
   transition: all 0.3s ease-in-out;
}

.menu-item:hover {
   
   h2, p, .rating {
       display: block;
   }

   .menu-image {
       display: none;
   }
}

.menu-image, .rating {
   display: none;
}

.menu-image {
   
   width: 100px;
   height: 100px;
   background-color: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<nav>
<ul>
<li class="menu-item">
<h2>{{ slot_1 }}</h2>
<p>{{ slot_2 }}</p>
<div class="rating"><span>{{ slot_3 }}</span>{{ slot_4 }}</div>
<div class="menu-image">{{ slot_5 }}</div>
</li>
<li class="menu-item">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="rating"><span>{{ slot_8 }}</span>{{ slot_9 }}</div>
<div class="menu-image">{{ slot_10 }}</div>
</li>
<li class="menu-item">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<div class="rating"><span>{{ slot_13 }}</span>{{ slot_14 }}</div>
<div class="menu-image">{{ slot_15 }}</div>
</li>
</ul>
</nav>
</header>
</body>
</html>