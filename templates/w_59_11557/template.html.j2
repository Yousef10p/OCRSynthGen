<p class="green-text">{{ slot_10 }}</p>
</main>
<aside id="weather">
<h2>{{ slot_11 }}</h2>
<p class="red-text">{{ slot_12 }}</p>
<div class="weather-green">{{ slot_13 }}</div>
</aside>
<section id="reviews">
<h2>{{ slot_14 }}</h2>
<div class="review-red">{{ slot_15 }}</div>
<p class="blue-text">{{ slot_16 }}</p>
