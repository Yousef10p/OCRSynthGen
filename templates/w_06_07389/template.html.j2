.ph { background: #d0d0d0; }

html, body {
    margin: 0;
    padding: 0;
}

#videoWrap {
    position: fixed;
    top: 0; 
    width: 100%; 
    height: 100vh;
    overflow: hidden;
}

#bgVideo {
    width: 100%; 
    height: 100vh;
    object-fit: cover;
}

#content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
}


#navMenu {
    display: flex;
    justify-content: space-around;
}

#navMenu ul {
    list-style-type: none;
    padding: 0;
}

#navMenu li {
    display: inline;
    margin: 0 10px;
}


#socialProof {
    color: white;
}


#sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    grid-gap: 20px;
}

.section {
    background-color: white;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
