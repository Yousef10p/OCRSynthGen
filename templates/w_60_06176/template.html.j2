<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	font-family: var(--font-body);
	background-color: aquamarine;
}

header {
	background-color: darkolivegreen;
	color: white;
	padding: 20px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

h1 {
	font-size: 2em;
}

nav ul {
	display: flex;
	list-style: none;
}

nav ul li {
	margin-left: 20px;
}

nav ul li a {
	color: white;
	text-decoration: none;
}

.item-img {
	width: 200px;
	height: 200px;
	background-color: gray;
}

.item h3,
.item p {
	margin: 10px 0;
}

.add-to-cart {
	background-color: blue;
	color: white;
	border: none;
	padding: 10px 20px;
	cursor: pointer;
}

.add-to-cart:hover {
	background-color: darkblue;
}

.cart {
	display: flex;
	align-items: center;
}

.cart-count,
.cart-total {
	margin-left: 10px;
}

footer {
	background-color: black;
	color: white;
	padding: 20px;
	text-align: center;
	position: fixed;
	bottom: 0;
	width: 100%;
}

.scroll-up {
	position: fixed;
	bottom: 20px;
	left: 20px;
	background-color: red;
	color: white;
	border: none;
	padding: 10px;
	cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
