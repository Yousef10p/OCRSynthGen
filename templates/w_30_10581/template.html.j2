	color: #f2f2f2;
}

nav ul {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	justify-content: space-around;
}

nav a {
	display: block;
	padding: 1em;
	text-decoration: none;
	color: #f2f2f2;
}

nav a:hover {
	background-color: #f2f2f2;
	color: #333;
}

.carousel, .featured-articles, .author-profiles, .book-listings, .blog {
	margin: 0 auto;
	max-width: 960px;
	padding: 1em;
}

.carousel div, .featured-articles article, .author-profiles .author-profile, .book-listings .book-listing, .blog article {
	background-color: #fff;
	padding: 1em;
	margin: 1em 0;
}


img[src="placeholder.png"] {
	background-color: #ccc;
	width: 100%;
	height: 300px;
	display: block;
	border: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
