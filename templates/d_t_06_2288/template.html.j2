<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 148.5mm; inset-block-start: 6.8mm; inline-size: 43.3mm; block-size: 5.1mm; font-size: 14.5pt"></div>
<header class="box" style="inset-inline-start: 197.7mm; inset-block-start: 7.6mm; inline-size: 3.8mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 19.5mm; inset-block-start: 75.1mm; inline-size: 49.9mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 113.7mm; inset-block-start: 75.1mm; inline-size: 75.5mm; block-size: 14.7mm; font-size: 13.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 19.5mm; inset-block-start: 104.7mm; inline-size: 79.5mm; block-size: 13.9mm; font-size: 9.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 113.7mm; inset-block-start: 104.7mm; inline-size: 81.2mm; block-size: 20.9mm; font-size: 9.9pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 19.5mm; inset-block-start: 122.3mm; inline-size: 85.9mm; block-size: 13.9mm; font-size: 9.8pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 113.7mm; inset-block-start: 129.4mm; inline-size: 83.7mm; block-size: 10.3mm; font-size: 9.8pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 19.5mm; inset-block-start: 140.0mm; inline-size: 80.0mm; block-size: 6.8mm; font-size: 9.6pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 113.7mm; inset-block-start: 143.5mm; inline-size: 81.9mm; block-size: 24.4mm; font-size: 9.9pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 19.5mm; inset-block-start: 150.5mm; inline-size: 81.8mm; block-size: 10.3mm; font-size: 9.8pt"><li>{{ slot_9 }}</li></ul>
<p class="box" style="inset-inline-start: 19.5mm; inset-block-start: 164.6mm; inline-size: 85.5mm; block-size: 10.3mm; font-size: 9.8pt">{{ slot_10 }}</p>
<div class="box ph" style="inset-inline-start: 19.3mm; inset-block-start: 216.1mm; inline-size: 86.1mm; block-size: 50.1mm; font-size: 15.8pt"></div>
<div class="box ph" style="inset-inline-start: 113.2mm; inset-block-start: 216.1mm; inline-size: 86.4mm; block-size: 50.5mm; font-size: 14.3pt"></div>
</div></body>
</html>
