<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.2mm; inset-block-start: 17.5mm; inline-size: 26.8mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 137.0mm; inset-block-start: 17.5mm; inline-size: 52.8mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 36.2mm; inset-block-start: 71.5mm; inline-size: 144.1mm; block-size: 38.3mm; font-size: 18.1pt"></div>
<p class="box" style="inset-inline-start: 89.5mm; inset-block-start: 119.0mm; inline-size: 33.2mm; block-size: 16.6mm; font-size: 23.5pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 31.1mm; inset-block-start: 181.0mm; inline-size: 147.8mm; block-size: 42.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 87.8mm; inset-block-start: 230.9mm; inline-size: 33.0mm; block-size: 16.3mm; font-size: 23.2pt">{{ slot_3 }}</p>
</div></body>
</html>
