<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 10.1mm; inset-block-start: 72.7mm; inline-size: 27.9mm; block-size: 37.6mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 41.4mm; inset-block-start: 74.0mm; inline-size: 63.1mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 41.4mm; inset-block-start: 82.0mm; inline-size: 51.3mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 10.8mm; inset-block-start: 135.4mm; inline-size: 143.6mm; block-size: 5.5mm; font-size: 15.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 10.8mm; inset-block-start: 147.4mm; inline-size: 79.5mm; block-size: 23.6mm; font-size: 13.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 102.6mm; inset-block-start: 147.4mm; inline-size: 77.6mm; block-size: 8.8mm; font-size: 12.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 102.6mm; inset-block-start: 162.2mm; inline-size: 83.5mm; block-size: 33.5mm; font-size: 13.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 10.8mm; inset-block-start: 177.0mm; inline-size: 83.9mm; block-size: 33.5mm; font-size: 13.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 102.6mm; inset-block-start: 201.7mm; inline-size: 83.4mm; block-size: 33.5mm; font-size: 13.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 10.8mm; inset-block-start: 216.5mm; inline-size: 83.9mm; block-size: 38.4mm; font-size: 13.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 10.8mm; inset-block-start: 283.9mm; inline-size: 2.8mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_9 }}</footer><footer class="box" style="inset-inline-start: 85.5mm; inset-block-start: 283.5mm; inline-size: 101.1mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_10 }}</footer>
</div></body>
</html>
