.ph { background: #d0d0d0; }

* { box-sizing: border-box; } 
body { margin: 0; padding: 0; background: #222; color: #ccc; font-family: var(--font-body); } .header { display: flex; justify-content: center; align-items: center; flex-direction: column; width: 100%; height: 100vh; text-align: center; background: black; } 
