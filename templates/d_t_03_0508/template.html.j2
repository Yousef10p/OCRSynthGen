<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.1mm; inset-block-start: 0.0mm; inline-size: 58.8mm; block-size: 80.1mm; font-size: 15.1pt"></div>
<h2 class="box" style="inset-inline-start: 79.0mm; inset-block-start: 48.7mm; inline-size: 48.1mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 79.0mm; inset-block-start: 56.6mm; inline-size: 96.4mm; block-size: 2.1mm; font-size: 5.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 78.9mm; inset-block-start: 86.2mm; inline-size: 108.8mm; block-size: 13.2mm; font-size: 12.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 78.9mm; inset-block-start: 105.9mm; inline-size: 114.9mm; block-size: 33.0mm; font-size: 13.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 78.9mm; inset-block-start: 145.4mm; inline-size: 110.5mm; block-size: 33.0mm; font-size: 13.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 184.8mm; inline-size: 95.6mm; block-size: 36.1mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 99.9mm; inset-block-start: 184.9mm; inline-size: 94.0mm; block-size: 37.9mm; font-size: 13.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 78.9mm; inset-block-start: 224.4mm; inline-size: 109.2mm; block-size: 23.1mm; font-size: 13.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 6.9mm; inset-block-start: 225.9mm; inline-size: 48.7mm; block-size: 2.1mm; font-size: 5.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 9.2mm; inset-block-start: 267.7mm; inline-size: 1.5mm; block-size: 1.9mm; font-size: 5.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
