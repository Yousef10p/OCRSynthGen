<div class="box ph" style="inset-inline-start: 19.3mm; inset-block-start: 145.9mm; inline-size: 59.3mm; block-size: 55.5mm; font-size: 22.5pt"></div>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 177.9mm; inline-size: 98.2mm; block-size: 9.4mm; font-size: 13.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 189.2mm; inline-size: 99.5mm; block-size: 32.0mm; font-size: 15.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 211.8mm; inline-size: 37.4mm; block-size: 7.8mm; font-size: 11.1pt">{{ slot_6 }}</p>
