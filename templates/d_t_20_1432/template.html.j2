<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 18.7mm; inline-size: 31.5mm; block-size: 5.6mm; font-size: 5.2pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 23.9mm; inline-size: 78.8mm; block-size: 20.0mm; font-size: 9.5pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 107.1mm; inset-block-start: 24.1mm; inline-size: 19.5mm; block-size: 12.0mm; font-size: 6.8pt">{{ slot_6 }}</h2>
