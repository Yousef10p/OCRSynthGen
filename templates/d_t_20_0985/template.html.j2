<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 116.8mm; inset-block-start: 13.6mm; inline-size: 57.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 26.7mm; inline-size: 119.4mm; block-size: 83.9mm; font-size: 18.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 34.1mm; inset-block-start: 116.9mm; inline-size: 41.1mm; block-size: 5.4mm; font-size: 15.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 54.9mm; inset-block-start: 128.8mm; inline-size: 71.3mm; block-size: 55.2mm; font-size: 15.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 34.2mm; inset-block-start: 195.3mm; inline-size: 41.3mm; block-size: 6.1mm; font-size: 17.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 204.8mm; inline-size: 141.9mm; block-size: 38.2mm; font-size: 18.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 246.9mm; inline-size: 140.7mm; block-size: 21.6mm; font-size: 15.3pt">{{ slot_6 }}</p>
</div></body>
</html>
