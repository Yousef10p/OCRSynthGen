<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 115.8mm; inline-size: 86.5mm; block-size: 100.5mm; font-size: 10.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 219.2mm; inline-size: 86.5mm; block-size: 58.3mm; font-size: 10.0pt">{{ slot_10 }}</p>
</div></body>
</html>
