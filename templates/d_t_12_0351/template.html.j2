<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 21.0mm; inset-block-start: 40.4mm; inline-size: 175.2mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 98.6mm; inset-block-start: 49.3mm; inline-size: 20.0mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 54.5mm; inline-size: 6.4mm; block-size: 153.6mm; font-size: 20.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 23.2mm; inset-block-start: 53.4mm; inline-size: 170.9mm; block-size: 2.9mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 101.2mm; inset-block-start: 61.6mm; inline-size: 15.0mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.5mm; inset-block-start: 65.7mm; inline-size: 154.3mm; block-size: 2.9mm; font-size: 9.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 88.4mm; inset-block-start: 69.3mm; inline-size: 40.5mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 75.4mm; inline-size: 140.6mm; block-size: 32.7mm; font-size: 9.0pt">{{ slot_7 }}</p>
