<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 43.4mm; inset-block-start: 10.5mm; inline-size: 77.2mm; block-size: 5.5mm; font-size: 7.7pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 11.6mm; inset-block-start: 16.3mm; inline-size: 29.0mm; block-size: 39.0mm; font-size: 15.8pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 15.5mm; inline-size: 89.9mm; block-size: 33.2mm; font-size: 10.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 51.4mm; inline-size: 88.1mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 66.8mm; inline-size: 88.0mm; block-size: 29.2mm; font-size: 11.8pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 19.2mm; inset-block-start: 99.3mm; inline-size: 12.7mm; block-size: 18.7mm; font-size: 13.3pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 98.7mm; inline-size: 83.4mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 114.2mm; inline-size: 84.1mm; block-size: 20.9mm; font-size: 11.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 20.1mm; inset-block-start: 123.7mm; inline-size: 12.7mm; block-size: 40.4mm; font-size: 14.3pt"></div>
<footer class="box" style="inset-inline-start: 12.2mm; inset-block-start: 200.4mm; inline-size: 79.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_6 }}</footer>
</div></body>
</html>
