<p>{{ slot_6 }}</p>
<div class="image-placeholder blue ph"></div>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="image-placeholder green ph"></div>
</div>
<footer>
<h3>{{ slot_9 }}</h3>
<ul>
