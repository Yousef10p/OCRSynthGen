<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 100.6mm; inset-block-start: 29.8mm; inline-size: 15.2mm; block-size: 3.8mm; font-size: 11.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 36.4mm; inset-block-start: 37.0mm; inline-size: 34.8mm; block-size: 3.8mm; font-size: 11.6pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 36.7mm; inset-block-start: 44.0mm; inline-size: 143.4mm; block-size: 18.4mm; font-size: 11.6pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 49.1mm; inset-block-start: 65.9mm; inline-size: 131.1mm; block-size: 33.0mm; font-size: 11.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 49.2mm; inset-block-start: 102.4mm; inline-size: 131.0mm; block-size: 25.7mm; font-size: 11.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 49.2mm; inset-block-start: 131.6mm; inline-size: 131.2mm; block-size: 18.4mm; font-size: 11.6pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 36.4mm; inset-block-start: 153.5mm; inline-size: 144.0mm; block-size: 40.3mm; font-size: 11.6pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 36.5mm; inset-block-start: 197.3mm; inline-size: 143.7mm; block-size: 47.6mm; font-size: 11.6pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 36.4mm; inset-block-start: 248.4mm; inline-size: 143.8mm; block-size: 11.1mm; font-size: 11.6pt"><li>{{ slot_8 }}</li></ul>
</div></body>
</html>
