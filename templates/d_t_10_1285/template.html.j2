<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 70.1mm; inline-size: 6.3mm; block-size: 118.9mm; font-size: 20.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 84.6mm; inset-block-start: 75.7mm; inline-size: 46.1mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 88.9mm; inset-block-start: 83.5mm; inline-size: 37.6mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 91.2mm; inline-size: 45.4mm; block-size: 3.8mm; font-size: 8.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 69.5mm; inset-block-start: 98.9mm; inline-size: 76.4mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 98.2mm; inset-block-start: 127.9mm; inline-size: 18.9mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_8 }}</h2>
