* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
}
header {
    background-color: #000;
    color: #fff;
    padding: 10px 0;
    position: relative;
}
nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
}
