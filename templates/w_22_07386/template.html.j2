}
#about {
    padding: 20px;
    text-align: center;
}
#testimonials {
    padding: 20px;
    display: flex;
    justify-content: space-between;
}
#testimonials .testimonial {
    flex: 1;
    text-align: center;
}
#testimonials .testimonial img {
    height: 100px;
    width: 100px;
    display: block;
    margin: 0 auto 15px;
    background-color: #f1f1f1;
}
footer {
    background-color: #000;
    color: #fff;
    text-align: center;
    padding: 10px 0;
    position: absolute;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
