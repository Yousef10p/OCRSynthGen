<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 123.6mm; inline-size: 96.7mm; block-size: 3.3mm; font-size: 9.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 132.1mm; inline-size: 149.0mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_5 }}</li></ul>
