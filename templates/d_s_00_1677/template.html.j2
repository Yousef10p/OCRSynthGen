<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 160.2mm; inline-size: 58.6mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 75.4mm; inset-block-start: 171.4mm; inline-size: 59.2mm; block-size: 7.0mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 182.3mm; inline-size: 159.2mm; block-size: 20.3mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 75.6mm; inset-block-start: 206.2mm; inline-size: 109.0mm; block-size: 7.0mm; font-size: 10.9pt"></div>
