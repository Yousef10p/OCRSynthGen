<ul class="box" style="inset-inline-start: 27.7mm; inset-block-start: 145.9mm; inline-size: 34.6mm; block-size: 5.9mm; font-size: 16.7pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 27.7mm; inset-block-start: 154.2mm; inline-size: 30.9mm; block-size: 5.9mm; font-size: 16.7pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 27.7mm; inset-block-start: 162.4mm; inline-size: 38.1mm; block-size: 5.9mm; font-size: 16.7pt"><li>{{ slot_6 }}</li></ul>
