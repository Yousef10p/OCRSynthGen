<p class="box" style="inset-inline-start: 22.6mm; inset-block-start: 120.7mm; inline-size: 87.2mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 116.5mm; inset-block-start: 120.7mm; inline-size: 86.2mm; block-size: 17.5mm; font-size: 12.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.6mm; inset-block-start: 125.5mm; inline-size: 87.4mm; block-size: 31.8mm; font-size: 12.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 116.5mm; inset-block-start: 139.8mm; inline-size: 87.4mm; block-size: 41.3mm; font-size: 13.0pt">{{ slot_5 }}</p>
