<p class="box" style="inset-inline-start: 143.1mm; inset-block-start: 82.4mm; inline-size: 60.9mm; block-size: 139.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 141.7mm; inline-size: 60.8mm; block-size: 118.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 79.2mm; inset-block-start: 200.9mm; inline-size: 60.9mm; block-size: 58.9mm; font-size: 11.9pt">{{ slot_6 }}</p>
