<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


#header {
    background-color: darkgray;
    color: white;
    padding: 10px;
}

#header a {
    color: white;
    text-decoration: none;
    padding: 5px;
}


#left-column {
    width: 50%;
    float: right;
}

.game-trailer, .game-description {
    margin: 10px;
    padding: 10px;
    background-color: lightgray;
}


#right-column {
    width: 50%;
    float: left;
}

.player-review, .player-rating {
    margin: 10px;
    padding: 10px;
    background-color: lightgray;
}


#footer {
    background-color: darkgray;
    color: white;
    clear: both;
    padding: 10px;
}

#footer a {
    color: white;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</div>
<div id="content">
<div id="left-column">
<div class="game">
<div class="game-trailer">{{ slot_5 }}</div>
<div class="game-description">{{ slot_6 }}</div>
</div>
</div>
<div id="right-column">
<div class="player-review">{{ slot_7 }}</div>
<div class="player-rating">{{ slot_8 }}</div>
</div>
</div>
<div id="footer">
<p>{{ slot_9 }} <a>{{ slot_10 }}</a> {{ slot_11 }} <a>{{ slot_12 }}</a> {{ slot_13 }} <a>{{ slot_14 }}</a></p>
<p>{{ slot_15 }} <a>{{ slot_16 }}</a></p>
</div>
</body>
</html>