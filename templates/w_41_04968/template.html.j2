.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    display: flex;
    padding: 20px;
    font-family: var(--font-body);
}

#left-column, #right-column {
    display: flex;
    flex-direction: column;
    flex: 1;
}

#left-column {
    margin-left: 20px;
}

.case-study, .testimonial {
    border: 1px solid #ccc;
    padding: 10px;
    margin-bottom: 20px;
}

h2 {
    text-align: center;
}

#right-column {
    ul {
        list-style-type: none;
        padding: 0;
    }

    li {
        background-color: #f2f2f2;
        padding: 10px;
        margin-bottom: 5px;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
