<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.4mm; inset-block-start: 16.0mm; inline-size: 176.2mm; block-size: 75.6mm; font-size: 23.8pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 94.1mm; inline-size: 104.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 103.0mm; inline-size: 37.8mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 103.3mm; inline-size: 86.9mm; block-size: 26.7mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 109.9mm; inline-size: 87.3mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 132.5mm; inline-size: 86.7mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 133.8mm; inline-size: 60.3mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 140.7mm; inline-size: 86.9mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 13.4mm; inset-block-start: 153.3mm; inline-size: 176.0mm; block-size: 97.7mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 253.6mm; inline-size: 83.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 8.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
