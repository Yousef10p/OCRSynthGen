<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 27.3mm; inset-block-start: 18.5mm; inline-size: 32.7mm; block-size: 5.5mm; font-size: 15.7pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 71.4mm; inset-block-start: 19.9mm; inline-size: 23.5mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 105.6mm; inset-block-start: 19.9mm; inline-size: 22.6mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_2 }}</header><header class="box" style="inset-inline-start: 148.2mm; inset-block-start: 19.4mm; inline-size: 38.1mm; block-size: 4.4mm; font-size: 12.4pt">{{ slot_3 }}</header><div class="box ph" style="inset-inline-start: 33.4mm; inset-block-start: 83.1mm; inline-size: 146.2mm; block-size: 22.4mm; font-size: 15.9pt"></div>
<p class="box" style="inset-inline-start: 95.2mm; inset-block-start: 107.8mm; inline-size: 14.2mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 32.2mm; inset-block-start: 115.7mm; inline-size: 148.7mm; block-size: 22.8mm; font-size: 16.2pt"></div>
<p class="box" style="inset-inline-start: 95.2mm; inset-block-start: 141.3mm; inline-size: 14.1mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 32.2mm; inset-block-start: 147.8mm; inline-size: 149.9mm; block-size: 53.4mm; font-size: 13.7pt"></div>
