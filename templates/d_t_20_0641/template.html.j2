<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 153.7mm; inset-block-start: 13.7mm; inline-size: 21.5mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 35.2mm; inset-block-start: 24.4mm; inline-size: 11.2mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 38.3mm; inset-block-start: 32.7mm; inline-size: 132.4mm; block-size: 103.8mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 139.3mm; inline-size: 8.1mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 38.3mm; inset-block-start: 146.5mm; inline-size: 133.4mm; block-size: 26.2mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 34.3mm; inset-block-start: 198.9mm; inline-size: 30.3mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 38.4mm; inset-block-start: 211.7mm; inline-size: 133.9mm; block-size: 35.3mm; font-size: 14.3pt"></div>
</div></body>
</html>
