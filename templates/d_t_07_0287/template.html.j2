<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.0mm; inline-size: 210.0mm; block-size: 127.6mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 130.2mm; inline-size: 120.0mm; block-size: 6.1mm; font-size: 8.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 145.0mm; inline-size: 50.8mm; block-size: 26.6mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 73.3mm; inset-block-start: 145.0mm; inline-size: 55.1mm; block-size: 62.6mm; font-size: 12.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 133.0mm; inset-block-start: 147.4mm; inline-size: 47.4mm; block-size: 10.2mm; font-size: 9.6pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 131.3mm; inset-block-start: 165.3mm; inline-size: 48.6mm; block-size: 61.8mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 176.1mm; inline-size: 53.9mm; block-size: 101.6mm; font-size: 13.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 73.3mm; inset-block-start: 213.0mm; inline-size: 40.3mm; block-size: 7.7mm; font-size: 10.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 73.3mm; inset-block-start: 222.7mm; inline-size: 52.3mm; block-size: 55.0mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 131.7mm; inset-block-start: 234.0mm; inline-size: 53.6mm; block-size: 43.7mm; font-size: 13.8pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 8.0mm; inset-block-start: 285.2mm; inline-size: 3.3mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
