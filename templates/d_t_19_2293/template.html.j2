<div class="box ph" style="inset-inline-start: 17.3mm; inset-block-start: 72.3mm; inline-size: 21.1mm; block-size: 59.6mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 44.1mm; inset-block-start: 72.3mm; inline-size: 40.6mm; block-size: 59.7mm; font-size: 40.0pt"></div>
