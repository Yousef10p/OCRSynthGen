<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 29.1mm; inset-block-start: 33.5mm; inline-size: 82.9mm; block-size: 58.3mm; font-size: 13.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 121.2mm; inset-block-start: 33.7mm; inline-size: 82.8mm; block-size: 13.9mm; font-size: 13.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 121.2mm; inset-block-start: 52.3mm; inline-size: 82.8mm; block-size: 13.9mm; font-size: 13.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 121.2mm; inset-block-start: 71.0mm; inline-size: 82.8mm; block-size: 23.7mm; font-size: 13.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 29.1mm; inset-block-start: 96.0mm; inline-size: 82.9mm; block-size: 43.5mm; font-size: 13.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 121.2mm; inset-block-start: 99.2mm; inline-size: 82.8mm; block-size: 53.4mm; font-size: 13.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 29.1mm; inset-block-start: 143.6mm; inline-size: 82.8mm; block-size: 8.9mm; font-size: 12.6pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 28.4mm; inset-block-start: 168.3mm; inline-size: 175.3mm; block-size: 69.5mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 32.2mm; inset-block-start: 239.8mm; inline-size: 68.5mm; block-size: 6.2mm; font-size: 8.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 145.1mm; inset-block-start: 239.9mm; inline-size: 53.6mm; block-size: 6.2mm; font-size: 8.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 151.4mm; inset-block-start: 263.7mm; inline-size: 50.6mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
