<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 139.1mm; inset-block-start: 13.4mm; inline-size: 35.3mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 26.9mm; inline-size: 142.0mm; block-size: 18.8mm; font-size: 17.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 34.5mm; inset-block-start: 55.6mm; inline-size: 30.7mm; block-size: 7.1mm; font-size: 20.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 67.2mm; inline-size: 141.6mm; block-size: 11.9mm; font-size: 16.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 79.9mm; inline-size: 142.1mm; block-size: 51.1mm; font-size: 18.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 132.1mm; inline-size: 141.8mm; block-size: 18.6mm; font-size: 17.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 41.7mm; inset-block-start: 154.6mm; inline-size: 111.6mm; block-size: 26.7mm; font-size: 18.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 33.8mm; inset-block-start: 186.4mm; inline-size: 81.7mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 46.7mm; inset-block-start: 196.2mm; inline-size: 96.5mm; block-size: 72.2mm; font-size: 14.6pt">{{ slot_8 }}</p>
</div></body>
</html>
