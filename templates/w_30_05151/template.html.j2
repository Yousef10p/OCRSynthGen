    display: flex;
}

header nav ul li {
    margin: 0 10px;
    list-style: none;
}

header nav ul li a {
    color: black;
    text-decoration: none;
    font-weight: bold;
}

.slogan {
    color: white;
    background: rgba(0,0,0,0.5);
    padding: 20px;
