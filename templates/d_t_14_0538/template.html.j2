<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 21.0mm; inline-size: 18.7mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 24.7mm; inset-block-start: 25.6mm; inline-size: 248.2mm; block-size: 18.3mm; font-size: 12.9pt"></div>
<p class="box" style="inset-inline-start: 29.5mm; inset-block-start: 48.4mm; inline-size: 6.3mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 24.9mm; inset-block-start: 52.7mm; inline-size: 247.7mm; block-size: 19.4mm; font-size: 13.8pt"></div>
<p class="box" style="inset-inline-start: 33.2mm; inset-block-start: 79.6mm; inline-size: 10.5mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 24.9mm; inset-block-start: 84.0mm; inline-size: 247.9mm; block-size: 18.6mm; font-size: 13.2pt"></div>
<p class="box" style="inset-inline-start: 29.5mm; inset-block-start: 107.0mm; inline-size: 6.3mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 24.7mm; inset-block-start: 111.5mm; inline-size: 248.2mm; block-size: 19.9mm; font-size: 14.1pt"></div>
<h2 class="box" style="inset-inline-start: 39.4mm; inset-block-start: 141.9mm; inline-size: 107.7mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 33.2mm; inset-block-start: 156.1mm; inline-size: 10.5mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 24.4mm; inset-block-start: 160.4mm; inline-size: 248.2mm; block-size: 20.9mm; font-size: 14.8pt"></div>
<footer class="box" style="inset-inline-start: 252.4mm; inset-block-start: 190.2mm; inline-size: 19.6mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
