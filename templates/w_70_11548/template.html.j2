}

#logo {
    text-align: center;
    margin: 0 auto;
}

nav ul {
    list-style: none;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}


main {
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.products {
    display: flex;
    justify-content: space-around;
    width: 100%;
}

.product {
    width: 30%;
    margin: 0 1.5%;
    text-align: center;
}

.product .image {
    height: 200px;
    width: 100%;
    background-color: #ddd;
}

footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
