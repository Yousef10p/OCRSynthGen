  justify-content: center;
  padding: 10px;
  background-color: lightgray;
  color: black;
}

main {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20px;
}

h2 {
  margin: 20px 0;
}

form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
}

label {
  font-weight: bold;
}

button {
  padding: 10px 20px;
}

#product-section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 20px;
}

.product {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10px;
  border: 1px solid lightgray;
