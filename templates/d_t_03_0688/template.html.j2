<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 36.6mm; inline-size: 95.2mm; block-size: 13.4mm; font-size: 19.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 75.4mm; inline-size: 216.1mm; block-size: 78.0mm; font-size: 14.7pt"></div>
<h2 class="box" style="inset-inline-start: 68.2mm; inset-block-start: 189.8mm; inline-size: 4.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 60.2mm; inset-block-start: 193.6mm; inline-size: 69.5mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 197.7mm; inline-size: 84.1mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 54.3mm; inset-block-start: 203.8mm; inline-size: 4.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 46.5mm; inset-block-start: 207.6mm; inline-size: 38.4mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 42.3mm; inset-block-start: 211.7mm; inline-size: 47.4mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 38.2mm; inset-block-start: 215.9mm; inline-size: 60.6mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_7 }}</p>
