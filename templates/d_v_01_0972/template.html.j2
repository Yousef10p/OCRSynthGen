<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.1mm; inset-block-start: 15.6mm; inline-size: 86.7mm; block-size: 149.8mm; font-size: 28.3pt"></div>
<div class="box ph" style="inset-inline-start: 116.2mm; inset-block-start: 16.2mm; inline-size: 86.1mm; block-size: 145.6mm; font-size: 29.5pt"></div>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 164.5mm; inline-size: 43.2mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 167.8mm; inline-size: 43.0mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 116.2mm; inset-block-start: 172.3mm; inline-size: 86.3mm; block-size: 62.5mm; font-size: 25.3pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 177.2mm; inline-size: 83.9mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 190.3mm; inline-size: 29.7mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 195.4mm; inline-size: 89.0mm; block-size: 40.2mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 116.5mm; inset-block-start: 237.6mm; inline-size: 35.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 240.1mm; inline-size: 29.5mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 245.2mm; inline-size: 85.5mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 192.9mm; inset-block-start: 262.8mm; inline-size: 10.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
