<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.2mm; inset-block-start: 17.5mm; inline-size: 26.8mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 150.3mm; inset-block-start: 17.5mm; inline-size: 39.5mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 79.3mm; inset-block-start: 32.9mm; inline-size: 35.9mm; block-size: 36.7mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 97.2mm; inset-block-start: 78.6mm; inline-size: 5.2mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 93.6mm; inline-size: 159.3mm; block-size: 13.5mm; font-size: 19.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 109.3mm; inline-size: 160.8mm; block-size: 28.0mm; font-size: 19.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.8mm; inset-block-start: 140.2mm; inline-size: 160.2mm; block-size: 12.8mm; font-size: 18.1pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 29.9mm; inset-block-start: 163.6mm; inline-size: 14.8mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 171.1mm; inline-size: 160.9mm; block-size: 28.0mm; font-size: 19.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 201.8mm; inline-size: 160.9mm; block-size: 36.1mm; font-size: 20.4pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 240.7mm; inline-size: 158.0mm; block-size: 12.5mm; font-size: 17.8pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 28.5mm; inset-block-start: 255.6mm; inline-size: 150.0mm; block-size: 13.8mm; font-size: 19.6pt">{{ slot_10 }}</p>
</div></body>
</html>
