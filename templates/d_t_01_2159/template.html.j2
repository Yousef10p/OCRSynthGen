<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.4mm; inset-block-start: 33.7mm; inline-size: 22.1mm; block-size: 6.7mm; font-size: 19.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 51.2mm; inline-size: 106.5mm; block-size: 49.4mm; font-size: 11.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 134.0mm; inset-block-start: 51.9mm; inline-size: 35.6mm; block-size: 2.5mm; font-size: 7.0pt">{{ slot_2 }}</h2>
<ul class="box" style="inset-inline-start: 134.0mm; inset-block-start: 57.2mm; inline-size: 53.2mm; block-size: 32.3mm; font-size: 11.4pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 134.0mm; inset-block-start: 92.0mm; inline-size: 46.4mm; block-size: 15.3mm; font-size: 10.9pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 134.0mm; inset-block-start: 110.0mm; inline-size: 52.3mm; block-size: 28.0mm; font-size: 11.4pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 23.2mm; inset-block-start: 112.1mm; inline-size: 99.2mm; block-size: 138.3mm; font-size: 15.1pt"></div>
<ul class="box" style="inset-inline-start: 134.0mm; inset-block-start: 140.6mm; inline-size: 53.9mm; block-size: 19.6mm; font-size: 11.1pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 134.0mm; inset-block-start: 162.8mm; inline-size: 52.0mm; block-size: 36.5mm; font-size: 11.5pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 134.0mm; inset-block-start: 201.9mm; inline-size: 53.7mm; block-size: 28.0mm; font-size: 11.4pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 134.0mm; inset-block-start: 232.6mm; inline-size: 51.1mm; block-size: 19.6mm; font-size: 11.1pt"><li>{{ slot_9 }}</li></ul>
<footer class="box" style="inset-inline-start: 14.7mm; inset-block-start: 268.8mm; inline-size: 44.7mm; block-size: 3.4mm; font-size: 9.5pt">{{ slot_10 }}</footer>
</div></body>
</html>
