<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 21.0mm; inline-size: 156.2mm; block-size: 10.6mm; font-size: 15.0pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 32.8mm; inline-size: 172.6mm; block-size: 20.4mm; font-size: 14.4pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 54.4mm; inline-size: 171.8mm; block-size: 30.1mm; font-size: 14.2pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 85.7mm; inline-size: 171.9mm; block-size: 25.2mm; font-size: 14.3pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 112.2mm; inline-size: 156.4mm; block-size: 15.4mm; font-size: 14.6pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 128.9mm; inline-size: 172.1mm; block-size: 44.7mm; font-size: 14.1pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 191.5mm; inline-size: 172.7mm; block-size: 25.2mm; font-size: 14.3pt"><li>{{ slot_6 }}</li></ul>
<h2 class="box" style="inset-inline-start: 30.0mm; inset-block-start: 218.0mm; inline-size: 160.8mm; block-size: 10.4mm; font-size: 14.8pt">{{ slot_7 }}</h2>
