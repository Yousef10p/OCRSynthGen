    display: flex;
    justify-content: center;
}

.row {
    display: flex;
}

.column {
    margin: 10px;
}


footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    background-color: #f8f8f8;
    padding: 10px;
    text-align: center;
}

footer ul {
    list-style-type: none;
}

footer li {
    display: inline;
    margin-left: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
