<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 48.2mm; inset-block-start: 28.6mm; inline-size: 122.1mm; block-size: 116.2mm; font-size: 15.0pt"></div>
<h2 class="box" style="inset-inline-start: 174.0mm; inset-block-start: 60.4mm; inline-size: 26.8mm; block-size: 6.9mm; font-size: 9.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 174.0mm; inset-block-start: 69.9mm; inline-size: 28.0mm; block-size: 45.4mm; font-size: 10.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 80.2mm; inset-block-start: 168.4mm; inline-size: 57.1mm; block-size: 47.1mm; font-size: 12.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 142.8mm; inset-block-start: 168.4mm; inline-size: 55.6mm; block-size: 11.8mm; font-size: 11.2pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 21.1mm; inset-block-start: 171.2mm; inline-size: 52.1mm; block-size: 54.8mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 142.8mm; inset-block-start: 181.6mm; inline-size: 57.5mm; block-size: 38.3mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 80.2mm; inset-block-start: 216.9mm; inline-size: 58.1mm; block-size: 38.3mm; font-size: 12.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 228.5mm; inline-size: 52.0mm; block-size: 22.1mm; font-size: 10.4pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 17.6mm; inset-block-start: 261.1mm; inline-size: 23.5mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 199.1mm; inset-block-start: 261.1mm; inline-size: 2.0mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_8 }}</footer>
</div></body>
</html>
