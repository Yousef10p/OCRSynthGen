<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 18.2mm; inset-block-start: 10.8mm; inline-size: 98.9mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 18.9mm; inline-size: 80.3mm; block-size: 8.4mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 30.6mm; inline-size: 182.8mm; block-size: 25.5mm; font-size: 12.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 59.6mm; inline-size: 182.6mm; block-size: 25.5mm; font-size: 12.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 88.5mm; inline-size: 182.8mm; block-size: 42.6mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 134.5mm; inline-size: 183.2mm; block-size: 16.9mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 154.8mm; inline-size: 182.0mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 170.9mm; inline-size: 174.7mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 200.6mm; inline-size: 32.8mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 167.0mm; inset-block-start: 269.4mm; inline-size: 33.8mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_9 }}</footer>
</div></body>
</html>
