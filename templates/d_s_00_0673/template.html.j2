<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 82.7mm; inset-block-start: 98.9mm; inline-size: 74.3mm; block-size: 13.9mm; font-size: 13.2pt"></div>
<h2 class="box" style="inset-inline-start: 50.1mm; inset-block-start: 110.3mm; inline-size: 30.2mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 60.1mm; inset-block-start: 130.2mm; inline-size: 117.6mm; block-size: 27.5mm; font-size: 13.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 59.2mm; inset-block-start: 184.9mm; inline-size: 86.2mm; block-size: 30.4mm; font-size: 14.4pt"></div>
<header class="box" style="inset-inline-start: 2.6mm; inset-block-start: 195.6mm; inline-size: 2.0mm; block-size: 16.4mm; font-size: 40.0pt">{{ slot_2 }}</header><div class="box ph" style="inset-inline-start: 130.6mm; inset-block-start: 228.8mm; inline-size: 58.6mm; block-size: 68.2mm; font-size: 14.9pt"></div>
<footer class="box" style="inset-inline-start: 10.5mm; inset-block-start: 287.3mm; inline-size: 34.8mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_3 }}</footer>
</div></body>
</html>
