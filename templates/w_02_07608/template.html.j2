}

p {
    margin: 0 0 50px;
    font-size: 18px;
    text-align: center;
}

.services-container, .caseStudy-container, .testimonials-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
