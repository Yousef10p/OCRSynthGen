<div class="product-image ph"></div>
<p>{{ slot_7 }}</p>
</div>
</div>
<div class="sidebar-left">
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>
<div class="sidebar-right">
