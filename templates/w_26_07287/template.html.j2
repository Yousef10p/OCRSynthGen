<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
</div>
<div class="main-content">
<h2>{{ slot_5 }}</h2>
<div class="product">
<div class="product-image ph"></div>
<p>{{ slot_6 }}</p>
</div>
