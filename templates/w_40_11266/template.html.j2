</ul>
</nav>
</header>
<div class="slider">
<div class="slide"><div class="slide-img ph"></div></div>
<div class="slide"><div class="slide-img ph"></div></div>
<div class="slide"><div class="slide-img ph"></div></div>
</div>
<main>
<section>
