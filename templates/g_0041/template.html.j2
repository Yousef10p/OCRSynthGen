<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.6; --align: start; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 1.8); text-align: center; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main><p style="margin-block: 0 0.4em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_1 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.3); text-align: center; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_2 }}</h2>
<h3 style="font-size: calc(var(--base-size) * 1.3); text-align: end; margin-block: 0.6em 0.4em">{{ slot_3 }}</h3>
<table style="border-collapse: collapse; inline-size: 100%; margin-block: 0.6em; font-size: 0.85em; break-inside: avoid">
<thead><tr>
<th style="border: 1px solid #000; padding: 0.2em 0.3em; text-align: start; background: #e8e8e8; font-weight: bold">{{ slot_4 }}</th>
<th style="border: 1px solid #000; padding: 0.2em 0.3em; text-align: start; background: #e8e8e8; font-weight: bold">{{ slot_5 }}</th>
</tr></thead>
<tbody>
<tr>
<td style="border: 1px solid #000; padding: 0.2em 0.3em; text-align: start">{{ slot_6 }}</td>
<td style="border: 1px solid #000; padding: 0.2em 0.3em; text-align: start">{{ slot_7 }}</td>
</tr>
<tr>
<td style="border: 1px solid #000; padding: 0.2em 0.3em; text-align: start">{{ slot_8 }}</td>
<td style="border: 1px solid #000; padding: 0.2em 0.3em; text-align: start">{{ slot_9 }}</td>
</tr>
<tr>
<td style="border: 1px solid #000; padding: 0.2em 0.3em; text-align: start">{{ slot_10 }}</td>
<td style="border: 1px solid #000; padding: 0.2em 0.3em; text-align: start">{{ slot_11 }}</td>
</tr>
</tbody>
</table></main>
</div></body>
</html>
