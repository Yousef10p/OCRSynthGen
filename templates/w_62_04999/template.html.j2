<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}


.navbar {
  position: fixed;
  top: 0;
  width: 100%;
  text-align: left;
}
.navbar ul {
  list-style-type: none;
}
.navbar ul li {
  display: inline;
  margin: 0 1em;
}


.hero {
  height: 50vh;
  background-color: lightgray;
  text-align: center;
  padding-top: 15vh;
}
.hero-button {
  display: inline-block;
  margin-top: 2em;
  padding: 1em 2em;
  background-color: blue;
  color: white;
  text-decoration: none;
}


.services {
  margin: 10vh 0;
  padding: 2em;
}
.service {
  margin: 2em 0;
}
.call-to-action {
  margin: 5em 0;
  padding: 2em;
  background-color: lightgray;
  text-align: center;
}
.cta-button {
  display: inline-block;
  margin-top: 2em;
  padding: 1em 2em;
  background-color: green;
  color: white;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navbar">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="hero">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<div class="hero-button">{{ slot_6 }}</div>
</div>
<div class="services">
<h2>{{ slot_7 }}</h2>
<div class="service">
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
</div>
<div class="service">
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>
<div class="call-to-action">
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<div class="cta-button">{{ slot_14 }}</div>
</div>
</div>
</body>
</html>