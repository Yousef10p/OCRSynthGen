<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 76.9mm; inline-size: 165.1mm; block-size: 17.2mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 100.7mm; inline-size: 165.1mm; block-size: 10.3mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 117.9mm; inline-size: 165.1mm; block-size: 38.3mm; font-size: 10.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 81.9mm; inset-block-start: 165.8mm; inline-size: 108.6mm; block-size: 14.8mm; font-size: 10.0pt"></div>
