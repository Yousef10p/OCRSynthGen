<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

#menu ul {
    list-style-type: none;
    overflow: hidden;
    background-color: #333;
    margin: 0;
    padding: 0;
}

#menu li {
    float: right;
}

#menu li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

.parallax {
    background-image: none;
    height: 500px;
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

.row {
    display: flex;
}

.column {
    flex: 33.33%;
    padding: 5px;
}

.column .image {
    background-color: grey;
    width: 100%;
    margin-bottom: 15px;
    height: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    text-align: center;
}

.column p {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</div>
<div class="parallax"></div>
<div class="row">
<div class="column">
<div class="image">{{ slot_3 }}</div>
<p>{{ slot_4 }}</p>
</div>
<div class="column">
<div class="image">{{ slot_5 }}</div>
<p>{{ slot_6 }}</p>
</div>
<div class="column">
<div class="image">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</div>
</div>
<div class="row">
<div class="column">
<div class="image">{{ slot_9 }}</div>
<p>{{ slot_10 }}</p>
</div>
<div class="column">
<div class="image">{{ slot_11 }}</div>
<p>{{ slot_12 }}</p>
</div>
<div class="column">
<div class="image">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>