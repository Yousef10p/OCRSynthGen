<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 32.1mm; inset-block-start: 15.0mm; inline-size: 104.2mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 31.7mm; inline-size: 146.1mm; block-size: 22.5mm; font-size: 12.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 61.4mm; inline-size: 146.1mm; block-size: 27.4mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 96.0mm; inline-size: 146.1mm; block-size: 37.3mm; font-size: 13.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 140.4mm; inline-size: 146.1mm; block-size: 32.4mm; font-size: 13.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 179.9mm; inline-size: 146.1mm; block-size: 22.5mm; font-size: 12.7pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 15.4mm; inset-block-start: 197.4mm; inline-size: 2.7mm; block-size: 59.5mm; font-size: 40.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 209.6mm; inline-size: 146.1mm; block-size: 22.5mm; font-size: 12.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 239.2mm; inline-size: 147.1mm; block-size: 17.5mm; font-size: 12.4pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 10.0mm; inset-block-start: 261.7mm; inline-size: 10.8mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
