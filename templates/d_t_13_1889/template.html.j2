<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 19.6mm; inset-block-start: 7.4mm; inline-size: 38.7mm; block-size: 19.6mm; font-size: 13.9pt"></div>
<header class="box" style="inset-inline-start: 229.6mm; inset-block-start: 8.3mm; inline-size: 53.5mm; block-size: 2.9mm; font-size: 9.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 62.0mm; inset-block-start: 9.4mm; inline-size: 70.8mm; block-size: 17.7mm; font-size: 10.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 101.5mm; inset-block-start: 38.4mm; inline-size: 95.0mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 65.0mm; inset-block-start: 45.8mm; inline-size: 166.8mm; block-size: 150.0mm; font-size: 15.2pt"></div>
<footer class="box" style="inset-inline-start: 70.0mm; inset-block-start: 198.4mm; inline-size: 67.5mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_3 }}</footer><footer class="box" style="inset-inline-start: 253.0mm; inset-block-start: 198.4mm; inline-size: 11.1mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 18.6mm; inset-block-start: 200.1mm; inline-size: 42.0mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 72.5mm; inset-block-start: 202.4mm; inline-size: 36.3mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 156.6mm; inset-block-start: 202.4mm; inline-size: 15.2mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 194.5mm; inset-block-start: 202.4mm; inline-size: 21.3mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 251.3mm; inset-block-start: 202.4mm; inline-size: 18.2mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
