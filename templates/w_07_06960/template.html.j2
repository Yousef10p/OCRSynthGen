<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

body {
    display: grid;
    grid-template-columns: 25% 50% 25%;
    background-color: #f5f5f5;
}

.header {
    background-color: #FF8E3C;
    grid-column: 1 / 4;
    text-align: center;
    color: #FFFFFF;
}

.logo {
    background-color: #A45C18;
    padding: 10px 0;
}

.main-image {
    background-color: #A45C18;
    grid-column: 1 / 4;
    text-align: center;
    padding: 50px 0;
}

.nav-menu {
    background-color: #563C1D;
    padding: 10px;
}

.content {
    background-color: #FFFFFF;
    padding: 50px;
    grid-column: 2 / 3;
}

.content h1,
.content p {
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header class="header">
<div class="logo">
<p>{{ slot_0 }}</p>
</div>
<div class="main-image">
<p>{{ slot_1 }}</p>
</div>
<nav class="nav-menu">
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
</header>
<main class="content">
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
<h1>{{ slot_11 }}</h1>
<p>{{ slot_12 }}</p>
<h1>{{ slot_13 }}</h1>
<p>{{ slot_14 }}</p>
</main>
</body>
</html>