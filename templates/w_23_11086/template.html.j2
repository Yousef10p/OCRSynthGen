<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    font-family: var(--font-body);
}

.main {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 80%;
    height: 80%;
}

.left-column, .right-column {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 50%;
    height: 100%;
    padding: 10px;
}

.left-column {
    background-color: #f2f2f2;
    border-left: 1px solid #ccc;
    text-align: center;
}

.right-column {
    text-align: center;
}

h1 {
    margin: 0 0 10px 0;
}

table {
    width: 100%;
    text-align: center;
}

table th, table td {
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="main">
<div class="left-column">
<h1>{{ slot_0 }}</h1>
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ul>
<h1>{{ slot_4 }}</h1>
<ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</div>
<div class="right-column">
<h1>{{ slot_8 }}</h1>
<table>
<tr>
<th>{{ slot_9 }}</th>
<th>{{ slot_10 }}</th>
<th>{{ slot_11 }}</th>
</tr>
<tr>
<td>{{ slot_12 }}</td>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
</tr>
<tr>
<td>{{ slot_15 }}</td>
<td>{{ slot_16 }}</td>
<td>{{ slot_17 }}</td>
</tr>
<tr>
<td>{{ slot_18 }}</td>
<td>{{ slot_19 }}</td>
<td>{{ slot_20 }}</td>
</tr>
</table>
</div>
</div>
</body>
</html>