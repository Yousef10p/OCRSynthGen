<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 22.8mm; inset-block-start: 10.8mm; inline-size: 7.7mm; block-size: 4.1mm; font-size: 11.8pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 182.2mm; inset-block-start: 10.8mm; inline-size: 10.8mm; block-size: 4.1mm; font-size: 11.8pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 55.6mm; inset-block-start: 25.3mm; inline-size: 104.8mm; block-size: 11.6mm; font-size: 11.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 32.5mm; inset-block-start: 40.2mm; inline-size: 150.8mm; block-size: 86.4mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 68.4mm; inset-block-start: 135.5mm; inline-size: 79.1mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 33.3mm; inset-block-start: 147.9mm; inline-size: 148.5mm; block-size: 91.8mm; font-size: 15.3pt"></div>
<footer class="box" style="inset-inline-start: 22.8mm; inset-block-start: 264.8mm; inline-size: 8.9mm; block-size: 4.1mm; font-size: 11.8pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 155.3mm; inset-block-start: 264.1mm; inline-size: 36.6mm; block-size: 4.1mm; font-size: 11.8pt">{{ slot_5 }}</footer>
</div></body>
</html>
