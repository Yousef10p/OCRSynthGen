<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    color: white;
    background-color: black;
}
.nav {
    position: fixed;
    right: 0;
    top: 0;
    width: 100%;
    background-color: #333;
    margin: 0;
    padding: 0;
}
.nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
}
.nav li {
    display: inline-block;
    padding: 10px;
}
.nav li a {
    color: white;
    text-decoration: none;
}
#content {
    margin-top: 60px;
    padding: 20px;
}
.music-item, .event-item, .merch-item{
    background-color:white;
    color:black;
    margin: 10px 0;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="nav">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</div>
<div id="content">
<h1>{{ slot_3 }}</h1>
<div id="playlist">
<div class="music-item">{{ slot_4 }}</div>
<div class="music-item">{{ slot_5 }}</div>
<div class="music-item">{{ slot_6 }}</div>
</div>
<div id="tour">
<h2>{{ slot_7 }}</h2>
<div class="event-item">{{ slot_8 }}</div>
<div class="event-item">{{ slot_9 }}</div>
<div class="event-item">{{ slot_10 }}</div>
</div>
<div id="merch">
<h2>{{ slot_11 }}</h2>
<div class="merch-item">{{ slot_12 }}</div>
<div class="merch-item">{{ slot_13 }}</div>
<div class="merch-item">{{ slot_14 }}</div>
</div>
</div>
</body>
</html>