<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

header {
  width: 100%;
  height: 80vh;
  background: #333 none no-repeat center center/cover;
  color: #fff;
  text-align: center;
  padding-top: 180px;
}

nav {
  float: left;
}

nav ul {
  list-style: none;
}

nav ul li {
  display: inline-block;
  margin: 13px 20px;
}

.header-text {
  text-align: center;
  color: #fff;
  margin: auto;
}

.header-text h1 {
  font-size: 30px;
}

.header-text p {
  margin: 18px;
  font-size: 18px;
}

#Portfolio {
  height: 100vh;
  background: #f4f4f4;
  text-align: center;
  padding: 20px;
}

.portfolio-gallery img {
  width: 25%;
  margin: 20px;
}

#Contact {
  height: 80vh;
  background: #ccc;
  text-align: center;
  padding: 20px;
}

form {
  text-align: center;
}

form label {
  display: block;
  margin-top: 20px;
}

form input,
form textarea {
  width: 50%;
  margin-bottom: 20px;
  height: 50px;
  border: 1px solid #333;
}

form input[type='submit'] {
  width: 200px;
}


.placeholder-image {
  width: 80px;
  height: 80px;
  display: inline-block;
  background-color: red;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
