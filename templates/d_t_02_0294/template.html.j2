<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.1mm; inset-block-start: 13.4mm; inline-size: 153.1mm; block-size: 5.6mm; font-size: 15.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 33.1mm; inset-block-start: 36.5mm; inline-size: 118.9mm; block-size: 20.5mm; font-size: 14.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 77.4mm; inset-block-start: 64.0mm; inline-size: 57.3mm; block-size: 49.8mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 142.9mm; inset-block-start: 64.0mm; inline-size: 60.8mm; block-size: 48.6mm; font-size: 12.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 142.9mm; inset-block-start: 116.6mm; inline-size: 61.1mm; block-size: 41.3mm; font-size: 11.7pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 77.4mm; inset-block-start: 119.1mm; inline-size: 34.0mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 77.4mm; inset-block-start: 125.8mm; inline-size: 56.2mm; block-size: 28.6mm; font-size: 11.6pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 36.9mm; inset-block-start: 164.0mm; inline-size: 94.7mm; block-size: 88.4mm; font-size: 15.7pt"></div>
<p class="box" style="inset-inline-start: 147.2mm; inset-block-start: 186.2mm; inline-size: 51.9mm; block-size: 29.7mm; font-size: 9.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 37.2mm; inset-block-start: 254.9mm; inline-size: 85.9mm; block-size: 6.0mm; font-size: 8.5pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 12.6mm; inset-block-start: 266.2mm; inline-size: 1.7mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
