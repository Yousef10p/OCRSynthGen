<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
<h3>{{ slot_4 }}</h3>
<ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</div>
<div id="right-column">
<h3>{{ slot_8 }}</h3>
<ul>
