}

nav ul li a {
  color: #dfe6e9;
  text-decoration: none;
}

.hero, .products {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.product {
  width: 30%;
  margin: 10px;
  box-sizing: border-box;
}

.icon {
  width: 100%;
  padding-bottom: 100%;
  display: block;
