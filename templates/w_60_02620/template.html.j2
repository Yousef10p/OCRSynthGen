}

.price {
  color: #00b894;
  font-size: 2em;
}

footer {
  background-color: #2d3436;
  color: #dfe6e9;
  position: fixed;
  width: 100%;
  bottom: 0;
  text-align: center;
}

@media (max-width: 600px) {
  section {
    width: 100%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
