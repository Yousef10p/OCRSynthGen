  color: white;
  padding: 10px;
}

nav ul {
  list-style-type: none;
}

nav ul li {
  display: inline;
  margin-left: 10px;
}

nav ul li a {
  text-decoration: none;
  color: white;
}

main h2 {
  text-align: center;
  color: #4b0082;
}

figure {
  display: flex;
  justify-content: space-between;
