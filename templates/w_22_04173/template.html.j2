  background-color: #ddd;
  display: flex;
  justify-content: center;
  align-items: center;
}

.center-section,
footer {
  display: flex;
  justify-content: space-between;
}

.categories,
.tags,
.social-media,
.newsletter {
  width: 30%;
}

footer div {
  margin-left: 20px;
}

footer div:last-child {
  margin-left: 0;
}

ul {
  padding: 0;
  list-style: none;
}

ul li {
  margin: 10px 0;
}

input[type="email"] {
  display: block;
  margin: 10px 0;
  padding: 5px;
}

button {
  display: block;
  padding: 5px 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
