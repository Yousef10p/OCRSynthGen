  margin: 20px;
}

.hero-header {
  background-color: #f90;
  display: flex;
  justify-content: center;
  align-items: center;
}

.slideshow {
  width: 100%;
  display: flex;
  justify-content: space-between;
}

.featured-post {
  width: 30%;
