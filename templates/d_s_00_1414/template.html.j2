<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.1mm; inset-block-start: 5.9mm; inline-size: 215.4mm; block-size: 135.0mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 16.4mm; inset-block-start: 157.6mm; inline-size: 55.1mm; block-size: 23.0mm; font-size: 13.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 87.1mm; inset-block-start: 157.6mm; inline-size: 64.9mm; block-size: 98.0mm; font-size: 13.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 170.9mm; inset-block-start: 180.2mm; inline-size: 31.6mm; block-size: 23.4mm; font-size: 16.6pt"></div>
<p class="box" style="inset-inline-start: 16.4mm; inset-block-start: 187.6mm; inline-size: 64.7mm; block-size: 38.0mm; font-size: 13.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 161.9mm; inset-block-start: 205.5mm; inline-size: 47.3mm; block-size: 23.8mm; font-size: 13.5pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 16.4mm; inset-block-start: 234.6mm; inline-size: 51.9mm; block-size: 5.9mm; font-size: 8.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 16.4mm; inset-block-start: 242.5mm; inline-size: 61.4mm; block-size: 13.0mm; font-size: 12.3pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 204.7mm; inset-block-start: 268.4mm; inline-size: 1.2mm; block-size: 1.8mm; font-size: 5.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
