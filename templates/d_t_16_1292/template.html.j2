<h2 class="box" style="inset-inline-start: 114.3mm; inset-block-start: 99.4mm; inline-size: 29.3mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 102.9mm; inline-size: 83.3mm; block-size: 46.7mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 103.7mm; inline-size: 84.9mm; block-size: 29.4mm; font-size: 11.9pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 114.3mm; inset-block-start: 137.9mm; inline-size: 34.5mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_7 }}</h2>
