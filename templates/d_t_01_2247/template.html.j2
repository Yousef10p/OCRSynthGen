<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 5.9mm; inline-size: 296.7mm; block-size: 170.6mm; font-size: 15.1pt"></div>
<h2 class="box" style="inset-inline-start: 115.5mm; inset-block-start: 188.5mm; inline-size: 40.5mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 11.7mm; inset-block-start: 188.6mm; inline-size: 1.3mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 44.4mm; inset-block-start: 189.0mm; inline-size: 17.8mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 68.8mm; inset-block-start: 188.9mm; inline-size: 40.1mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 162.7mm; inset-block-start: 188.9mm; inline-size: 38.5mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 207.9mm; inset-block-start: 188.9mm; inline-size: 35.8mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_5 }}</h2>
</div></body>
</html>
