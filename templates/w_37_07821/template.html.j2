body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 20px;
    background: #333;
    color: #fff;
}

.logo {
    font-size: 2em;
}

nav ul {
    display: flex;
