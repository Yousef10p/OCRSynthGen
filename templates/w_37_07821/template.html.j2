    width: 50%;
    padding: 15px;
}

.product-image {
    margin: 10px auto;
    height: 100px;
    width: 100px;
    background: red;
}

.product-title {
    font-size: 1em;
}

.product-description {
    text-align: justify;
    font-size: 0.8em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
