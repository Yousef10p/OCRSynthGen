body, html {
    height: 100%;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: var(--font-body);
    background-color: #F2F2F2;
    color: #333;
}
.wrapper {
    max-width: 800px;
    padding: 20px;
}
.featured-product {
    text-align: center;
