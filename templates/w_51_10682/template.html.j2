<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
	margin: 0;
	padding: 0;
	font-family: var(--font-body);
}

body {
	overflow: hidden;
	position: relative;
	background: none no-repeat center center fixed; 
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    background-size: cover;
}

nav {
	width: 100%;
	height: 50px;
	background-color: rgba(0, 0, 0, 0.5);
	position: absolute;
	top: 0;
	right: 0;
}

nav ul {
	margin: 0;
	padding: 0;
	list-style: none;
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
}

nav li {
	margin: 0 10px;
}

nav a {
	color: white;
	text-decoration: none;
}

#banner {
	color: white;
	text-align: center;
	position: absolute;
	top: 50%;
	right: 50%;
	transform: translate(50%, -50%);
}

#about, #services, #contact {
	color: white;
	position: absolute;
	bottom: 0;
	padding: 20px;
	width: 100%;
	box-sizing: border-box;
	opacity: 0.7;
	background-color: rgba(0, 0, 0, 0.7);
}

@media (min-width: 768px) {
	#about, #services, #contact {
		width: 50%;
		height: 100vh;
		float: right;
	}
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
