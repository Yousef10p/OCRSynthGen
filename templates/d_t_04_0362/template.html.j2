<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 109.5mm; inset-block-start: 15.4mm; inline-size: 106.1mm; block-size: 107.5mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 43.2mm; inline-size: 84.6mm; block-size: 32.4mm; font-size: 15.3pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 82.7mm; inline-size: 30.7mm; block-size: 4.2mm; font-size: 11.8pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 88.4mm; inline-size: 83.2mm; block-size: 38.1mm; font-size: 15.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 127.9mm; inline-size: 86.9mm; block-size: 21.1mm; font-size: 15.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 117.6mm; inset-block-start: 127.5mm; inline-size: 64.0mm; block-size: 16.6mm; font-size: 15.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 156.1mm; inline-size: 84.5mm; block-size: 4.2mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 113.9mm; inset-block-start: 156.8mm; inline-size: 88.1mm; block-size: 54.7mm; font-size: 25.9pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 16.8mm; inset-block-start: 164.2mm; inline-size: 61.5mm; block-size: 18.3mm; font-size: 17.3pt"></div>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 184.3mm; inline-size: 58.7mm; block-size: 15.5mm; font-size: 14.6pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 168.4mm; inset-block-start: 270.7mm; inline-size: 33.3mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_8 }}</footer>
</div></body>
</html>
