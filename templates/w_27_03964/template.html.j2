<p>{{ slot_9 }}</p>
<div id="course-block">

<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</div>
</div>
<div id="footer">
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>