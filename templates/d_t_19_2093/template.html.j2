<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 34.6mm; inset-block-start: 13.9mm; inline-size: 46.4mm; block-size: 5.0mm; font-size: 14.0pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 32.6mm; inset-block-start: 24.6mm; inline-size: 145.9mm; block-size: 49.3mm; font-size: 28.0pt"></div>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 77.3mm; inline-size: 97.0mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 34.3mm; inset-block-start: 88.3mm; inline-size: 141.4mm; block-size: 57.4mm; font-size: 18.1pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 34.3mm; inset-block-start: 155.1mm; inline-size: 47.7mm; block-size: 5.6mm; font-size: 15.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 164.0mm; inline-size: 141.2mm; block-size: 50.9mm; font-size: 18.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.7mm; inset-block-start: 215.7mm; inline-size: 141.1mm; block-size: 12.2mm; font-size: 17.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 47.5mm; inset-block-start: 231.2mm; inline-size: 65.4mm; block-size: 4.7mm; font-size: 13.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 34.7mm; inset-block-start: 241.2mm; inline-size: 140.9mm; block-size: 12.2mm; font-size: 17.3pt">{{ slot_7 }}</p>
</div></body>
</html>
