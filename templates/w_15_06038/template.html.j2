<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
}

nav {
    background-color: #333;
    color: white;
    width: 20%;
    height: 100vh;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav a {
    color: white;
    text-decoration: none;
    display: block;
    padding: 1em;
}

.feature {
    width: 30%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.feature h1 {
    font-size: 2em;
}

.feature p {
    text-align: center;
}

.events, .purchases {
    width: 50%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.event, .ticket {
    width: 10em;
    height: 3em;
    background-color: #bbb;
    margin: 1em;
    display: flex;
    justify-content: center;
    align-items: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div class="feature">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</div>
<div class="events">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="event">{{ slot_8 }}</div>
<div class="event">{{ slot_9 }}</div>
<div class="event">{{ slot_10 }}</div>
</div>
<div class="purchases">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<div class="ticket">{{ slot_13 }}</div>
<div class="ticket">{{ slot_14 }}</div>
<div class="ticket">{{ slot_15 }}</div>
</div>
</body>
</html>