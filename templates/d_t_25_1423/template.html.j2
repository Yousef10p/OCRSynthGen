<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 35.7mm; inset-block-start: 39.4mm; inline-size: 41.7mm; block-size: 3.7mm; font-size: 11.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 35.8mm; inset-block-start: 52.8mm; inline-size: 138.0mm; block-size: 10.3mm; font-size: 11.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 47.9mm; inset-block-start: 66.1mm; inline-size: 70.6mm; block-size: 3.5mm; font-size: 11.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 47.7mm; inset-block-start: 72.9mm; inline-size: 36.0mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 79.5mm; inline-size: 139.1mm; block-size: 10.1mm; font-size: 11.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 35.7mm; inset-block-start: 92.8mm; inline-size: 138.9mm; block-size: 16.8mm; font-size: 11.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 35.8mm; inset-block-start: 112.5mm; inline-size: 139.3mm; block-size: 10.3mm; font-size: 11.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 35.7mm; inset-block-start: 132.5mm; inline-size: 138.7mm; block-size: 10.3mm; font-size: 11.8pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 46.4mm; inset-block-start: 145.8mm; inline-size: 102.6mm; block-size: 37.1mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 35.7mm; inset-block-start: 191.8mm; inline-size: 139.3mm; block-size: 37.0mm; font-size: 11.8pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 35.7mm; inset-block-start: 238.4mm; inline-size: 139.1mm; block-size: 16.9mm; font-size: 11.8pt">{{ slot_9 }}</p>
</div></body>
</html>
