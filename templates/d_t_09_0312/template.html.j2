<h2 class="box" style="inset-inline-start: 36.3mm; inset-block-start: 89.2mm; inline-size: 14.8mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 98.5mm; inline-size: 137.1mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 92.2mm; inset-block-start: 123.1mm; inline-size: 81.2mm; block-size: 7.9mm; font-size: 12.0pt"></div>
