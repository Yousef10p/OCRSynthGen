<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 105.9mm; inset-block-start: 10.9mm; inline-size: 2.0mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 20.9mm; inset-block-start: 20.8mm; inline-size: 172.0mm; block-size: 22.4mm; font-size: 21.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 30.9mm; inset-block-start: 46.1mm; inline-size: 125.2mm; block-size: 5.0mm; font-size: 14.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 21.1mm; inset-block-start: 53.9mm; inline-size: 171.9mm; block-size: 13.9mm; font-size: 19.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.1mm; inset-block-start: 71.1mm; inline-size: 116.9mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 78.9mm; inline-size: 172.1mm; block-size: 79.1mm; font-size: 22.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 160.9mm; inline-size: 172.1mm; block-size: 79.0mm; font-size: 22.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 242.7mm; inline-size: 171.8mm; block-size: 37.8mm; font-size: 21.4pt">{{ slot_7 }}</p>
</div></body>
</html>
