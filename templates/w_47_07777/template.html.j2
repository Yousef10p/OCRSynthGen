<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

header {
    background-color: #333;
    color: white;
    width: 100%;
    padding: 10px 0;
    margin-bottom: 20px;
}

header h1 {
    text-align: center;
}

header form {
    display: flex;
    justify-content: center;
    margin-top: 10px;
}

header form input[type="text"] {
    padding: 5px;
    font-size: 16px;
}

header form input[type="submit"] {
    padding: 5px 10px;
    background-color: white;
    color: #333;
    font-size: 16px;
    border: none;
    cursor: pointer;
}

.quick-links {
    margin-bottom: 20px;
}

.quick-links ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    gap: 15px;
}

.service {
    width: 80%;
    margin-bottom: 30px;
}

.service-image {
    height: 200px;
    margin-bottom: 10px;
}

.service p {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
<span class="">{{ slot_2 }}</span>
</form>
</header>
<div class="quick-links">
<h2>{{ slot_3 }}</h2>
<ul>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</div>
<div class="service" id="finances">
<h2>{{ slot_8 }}</h2>
<div class="service-image ph"></div>
<p>{{ slot_9 }}</p>
</div>

<div class="service" id="insurance">
<h2>{{ slot_10 }}</h2>
<div class="service-image ph"></div>
<p>{{ slot_11 }}</p>
</div>
<div class="service" id="tax">
<h2>{{ slot_12 }}</h2>
<div class="service-image ph"></div>
<p>{{ slot_13 }}</p>
</div>
<div class="service" id="banking">
<h2>{{ slot_14 }}</h2>
<div class="service-image ph"></div>
<p>{{ slot_15 }}</p>
</div>
</body>
</html>