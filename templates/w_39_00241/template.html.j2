}

footer .social-media-icons div {
    width: 20px; 
    height: 20px; 
    background-color: #ffa500; 
    display: inline-block;
    margin-left: 5px;
}

footer .contact-details a { color: #000000; text-decoration: none; }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
