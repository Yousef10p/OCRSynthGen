<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 25.4mm; inline-size: 124.3mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 24.6mm; inset-block-start: 33.0mm; inline-size: 107.9mm; block-size: 95.1mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 128.4mm; inline-size: 154.6mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 136.4mm; inline-size: 158.1mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 152.4mm; inline-size: 90.6mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 161.2mm; inline-size: 164.2mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 263.1mm; inline-size: 88.6mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 188.8mm; inset-block-start: 263.1mm; inline-size: 1.8mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
