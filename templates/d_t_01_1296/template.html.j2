<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 53.9mm; inset-block-start: 25.8mm; inline-size: 36.7mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 53.2mm; inset-block-start: 29.4mm; inline-size: 107.3mm; block-size: 50.2mm; font-size: 8.9pt"></div>
<p class="box" style="inset-inline-start: 34.9mm; inset-block-start: 101.9mm; inline-size: 68.8mm; block-size: 77.1mm; font-size: 16.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 101.9mm; inline-size: 69.1mm; block-size: 63.2mm; font-size: 16.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 169.8mm; inline-size: 68.2mm; block-size: 57.2mm; font-size: 16.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 34.9mm; inset-block-start: 183.7mm; inline-size: 69.1mm; block-size: 63.2mm; font-size: 16.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 231.7mm; inline-size: 68.7mm; block-size: 27.2mm; font-size: 15.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.9mm; inset-block-start: 251.6mm; inline-size: 69.2mm; block-size: 9.2mm; font-size: 13.1pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 203.1mm; inset-block-start: 255.8mm; inline-size: 1.3mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
