<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

a {
    text-decoration: none;
    color: #000;
}

nav {
    float: right;
    width: 15%;
    height: 100vh;
    background-color: #f0f0f0;
    padding: 20px;
}

.productImage {
    float: right;
    width: 60%;
    height: 300px;
    background-color: #a0a0a0;
}

.productInfo {
    float: right;
    width: 30%;
    height: 300px;
    background-color: #b0b0b0;
    padding: 20px;
}

.reviewSection {
    float: right;
    width: 75%;
    height: 200px;
    background-color: #c0c0c0;
    padding: 20px;
}

footer {
    clear: both;
    width: 100%;
    background-color: #000;
    color: #fff;
    text-align: center;
    padding: 10px 0;
}

footer a {
    margin-right: 10px;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<div class="main">
<div class="productImage ph"></div>
<div class="productInfo">
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
</div>
</div>
<div class="reviewSection">
<p>{{ slot_8 }}</p>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
</ul>
</div>
<footer>
<div>
<p>{{ slot_14 }}</p>
<a>{{ slot_15 }}</a>
<a>{{ slot_16 }}</a>
</div>
</footer>

</body>
</html>