<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 138.4mm; inset-block-start: 0.6mm; inline-size: 71.4mm; block-size: 38.3mm; font-size: 15.5pt"></div>
<div class="box ph" style="inset-inline-start: 8.7mm; inset-block-start: 14.5mm; inline-size: 54.1mm; block-size: 25.3mm; font-size: 14.4pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 56.3mm; inline-size: 159.4mm; block-size: 10.3mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 76.3mm; inline-size: 35.6mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 84.8mm; inline-size: 160.5mm; block-size: 34.3mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 119.1mm; inline-size: 160.4mm; block-size: 47.1mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 170.6mm; inline-size: 160.5mm; block-size: 12.8mm; font-size: 10.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 192.0mm; inline-size: 33.2mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 200.6mm; inline-size: 160.3mm; block-size: 8.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 213.4mm; inline-size: 160.5mm; block-size: 25.7mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 259.6mm; inline-size: 106.3mm; block-size: 8.0mm; font-size: 10.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 267.7mm; inline-size: 124.5mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 201.4mm; inset-block-start: 282.3mm; inline-size: 3.2mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
