.slider {
    width: 100%;
    height: 400px;
}

.sidebar {
    width: 20%;
    height: 300px;
    position: absolute;
    left: 0;
    top: 0;
    padding: 20px;
    background-color: #f1f1f1;
}

.mySlides {
    display: none;
}

.numbertext {
    color: #f2f2f2;
