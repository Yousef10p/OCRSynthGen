<p class="box" style="inset-inline-start: 8.1mm; inset-block-start: 86.3mm; inline-size: 47.8mm; block-size: 18.5mm; font-size: 8.8pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 7.6mm; inset-block-start: 108.2mm; inline-size: 49.5mm; block-size: 57.6mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 183.3mm; inset-block-start: 110.0mm; inline-size: 64.5mm; block-size: 46.9mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 58.7mm; inset-block-start: 116.8mm; inline-size: 6.2mm; block-size: 7.9mm; font-size: 11.1pt">{{ slot_3 }}</p>
