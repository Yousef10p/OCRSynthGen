<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f8f9fa;
    padding: 10px 20px;
    border-bottom: 1px solid #dee2e6;
}

header nav ul {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
}

header nav ul li {
    margin-left: 10px;
}

header form {
    display: flex;
}

header form input {
    padding: 5px;
    border: 1px solid #ced4da;
}

.cta {
    background-color: #f8f9fa;
    padding: 20px;
    font-size: 20px;
    text-align: center;
}

.cta button {
    margin-top: 20px;
    padding: 10px 20px;
    background-color: #007bff;
    color: #fff;
    border: none;
}

footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #222;
    color: #f8f9fa;
    padding: 20px;
}

footer .logo {
    font-size: 20px;
    margin-bottom: 20px;
}

footer ul {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
}

footer li {
    margin-left: 10px;
}

footer .social-icons span {
    margin-left: 10px;
    border: 1px solid #f8f9fa;
    padding: 5px 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
