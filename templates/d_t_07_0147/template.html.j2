<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 55.0mm; inline-size: 131.0mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 60.0mm; inline-size: 133.0mm; block-size: 3.5mm; font-size: 10.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 76.9mm; inline-size: 161.1mm; block-size: 10.6mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 89.6mm; inline-size: 159.8mm; block-size: 7.1mm; font-size: 6.7pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 96.5mm; inline-size: 168.6mm; block-size: 10.7mm; font-size: 6.1pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 107.1mm; inline-size: 159.5mm; block-size: 10.7mm; font-size: 7.6pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 76.7mm; inset-block-start: 124.9mm; inline-size: 58.2mm; block-size: 3.5mm; font-size: 10.1pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 193.7mm; inset-block-start: 283.0mm; inline-size: 7.8mm; block-size: 6.6mm; font-size: 18.7pt">{{ slot_7 }}</footer>
</div></body>
</html>
