<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 18.6mm; inset-block-start: 16.5mm; inline-size: 54.5mm; block-size: 17.2mm; font-size: 16.3pt"></div>
<h1 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 47.1mm; inline-size: 105.7mm; block-size: 6.3mm; font-size: 16.0pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 58.0mm; inline-size: 167.9mm; block-size: 8.2mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 70.7mm; inline-size: 171.1mm; block-size: 12.4mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 88.2mm; inline-size: 169.4mm; block-size: 16.6mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 109.7mm; inline-size: 103.4mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 119.0mm; inline-size: 161.4mm; block-size: 8.2mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 131.7mm; inline-size: 172.1mm; block-size: 20.9mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 157.1mm; inline-size: 172.1mm; block-size: 29.3mm; font-size: 10.0pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 190.7mm; inline-size: 64.8mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 200.1mm; inline-size: 165.1mm; block-size: 8.2mm; font-size: 10.0pt">{{ slot_9 }}</p>
<ul class="box" style="inset-inline-start: 19.1mm; inset-block-start: 212.6mm; inline-size: 155.2mm; block-size: 12.7mm; font-size: 10.0pt"><li>{{ slot_10 }}</li></ul>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 257.8mm; inline-size: 91.5mm; block-size: 3.1mm; font-size: 5.0pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 19.1mm; inset-block-start: 275.5mm; inline-size: 18.3mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_12 }}</footer><footer class="box" style="inset-inline-start: 116.9mm; inset-block-start: 275.2mm; inline-size: 61.3mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_13 }}</footer>
</div></body>
</html>
