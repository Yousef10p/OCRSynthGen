    text-decoration: none;
}

@media screen and (min-width: 768px) {
    .footer-left,
    .footer-right {
        display: inline-block;
        vertical-align: top;
        width: 50%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
