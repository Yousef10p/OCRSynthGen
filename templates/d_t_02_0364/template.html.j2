<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 31.8mm; inset-block-start: 18.3mm; inline-size: 157.2mm; block-size: 69.9mm; font-size: 19.8pt"></div>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 89.7mm; inline-size: 34.9mm; block-size: 4.8mm; font-size: 6.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 17.3mm; inset-block-start: 105.0mm; inline-size: 86.9mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 105.0mm; inline-size: 90.2mm; block-size: 77.2mm; font-size: 13.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 17.3mm; inset-block-start: 129.6mm; inline-size: 47.7mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 17.3mm; inset-block-start: 134.6mm; inline-size: 89.8mm; block-size: 12.9mm; font-size: 12.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 17.3mm; inset-block-start: 149.4mm; inline-size: 88.9mm; block-size: 22.8mm; font-size: 12.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 17.3mm; inset-block-start: 174.1mm; inline-size: 90.1mm; block-size: 82.1mm; font-size: 13.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 184.0mm; inline-size: 90.6mm; block-size: 37.6mm; font-size: 13.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 120.6mm; inset-block-start: 223.5mm; inline-size: 55.9mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 112.2mm; inset-block-start: 234.2mm; inline-size: 65.6mm; block-size: 9.3mm; font-size: 13.2pt"></div>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 248.2mm; inline-size: 24.4mm; block-size: 8.0mm; font-size: 11.4pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 109.4mm; inset-block-start: 264.4mm; inline-size: 1.3mm; block-size: 2.7mm; font-size: 7.5pt">{{ slot_10 }}</footer><footer class="box" style="inset-inline-start: 106.4mm; inset-block-start: 268.1mm; inline-size: 7.4mm; block-size: 2.0mm; font-size: 5.6pt">{{ slot_11 }}</footer>
</div></body>
</html>
