<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.0mm; inset-block-start: 20.5mm; inline-size: 62.0mm; block-size: 15.7mm; font-size: 14.8pt"></div>
<h1 class="box" style="inset-inline-start: 26.2mm; inset-block-start: 37.9mm; inline-size: 61.6mm; block-size: 7.2mm; font-size: 20.4pt">{{ slot_0 }}</h1>
<div class="box ph" style="inset-inline-start: 136.7mm; inset-block-start: 43.1mm; inline-size: 53.7mm; block-size: 65.8mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 116.2mm; inset-block-start: 54.3mm; inline-size: 19.7mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 25.8mm; inset-block-start: 79.8mm; inline-size: 54.0mm; block-size: 65.8mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 81.8mm; inset-block-start: 116.1mm; inline-size: 18.7mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_2 }}</p>
<h1 class="box" style="inset-inline-start: 125.1mm; inset-block-start: 146.3mm; inline-size: 76.4mm; block-size: 17.4mm; font-size: 24.7pt">{{ slot_3 }}</h1>
<div class="box ph" style="inset-inline-start: 25.8mm; inset-block-start: 165.2mm; inline-size: 54.0mm; block-size: 65.1mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 81.8mm; inset-block-start: 175.7mm; inline-size: 36.0mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 136.7mm; inset-block-start: 201.6mm; inline-size: 53.7mm; block-size: 65.1mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 91.9mm; inset-block-start: 238.3mm; inline-size: 44.0mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_5 }}</p>
</div></body>
</html>
