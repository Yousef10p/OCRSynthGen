    color: white;
    padding: 20px;
    text-align: center;
}
nav {
    margin-top: 20px;
}
nav a {
    margin: 0 10px;
    color: white;
    text-decoration: none;
}
main {
    padding: 20px;
}
section {
    display: flex;
}
#content {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
}
#content form {
    display: grid;
    grid-template-areas:
        "title title"
        "content content"
        "submit submit";
}
#content input[type="text"] {
    grid-area: title;
}
#content textarea {
    grid-area: content;
}
#content button[type="submit"] {
    grid-area: submit;
}
#casestudies .study {
    margin-bottom: 20px;
    padding: 20px;
    background: linear-gradient(to bottom, #F2F2F2, #BDBDBD);
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
