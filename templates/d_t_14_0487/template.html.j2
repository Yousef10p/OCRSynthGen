<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 24.8mm; inset-block-start: 9.3mm; inline-size: 26.6mm; block-size: 16.7mm; font-size: 15.8pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 41.0mm; inline-size: 63.4mm; block-size: 8.1mm; font-size: 22.9pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 27.4mm; inset-block-start: 62.1mm; inline-size: 32.9mm; block-size: 5.0mm; font-size: 14.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 75.0mm; inline-size: 90.2mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 94.9mm; inline-size: 160.2mm; block-size: 17.0mm; font-size: 16.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 123.5mm; inline-size: 160.5mm; block-size: 19.1mm; font-size: 18.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 154.1mm; inline-size: 24.7mm; block-size: 5.0mm; font-size: 14.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 162.4mm; inline-size: 160.1mm; block-size: 10.9mm; font-size: 15.4pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 31.7mm; inset-block-start: 176.8mm; inline-size: 153.8mm; block-size: 10.9mm; font-size: 15.5pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.7mm; inset-block-start: 191.4mm; inline-size: 116.4mm; block-size: 4.8mm; font-size: 13.6pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.7mm; inset-block-start: 199.8mm; inline-size: 149.7mm; block-size: 4.8mm; font-size: 13.6pt"><li>{{ slot_9 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 216.3mm; inline-size: 160.1mm; block-size: 10.9mm; font-size: 15.4pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 60.3mm; inset-block-start: 275.0mm; inline-size: 86.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_11 }}</footer><footer class="box" style="inset-inline-start: 181.0mm; inset-block-start: 275.5mm; inline-size: 4.4mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_12 }}</footer>
</div></body>
</html>
