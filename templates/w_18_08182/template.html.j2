   padding: 10px;
   display: flex;
   justify-content: space-between;
   align-items: center;
}

.logo {
   font-size: 20px;
}

.nav ul {
   list-style: none;
   display: flex;
   margin: 0;
   padding: 0;
}

.nav ul li {
   margin-right: 10px;
}

.search-bar input {
   padding: 5px;
   border-radius: 5px;
   border: 1px solid #ddd;
}

.main-content {
   display: flex;
   justify-content: space-between;
   padding: 10px;
}

.service, .blog-post {
   border: 1px solid #ddd;
   padding: 20px;
   margin-bottom: 20px;
   width: 45%;
}

.service {
   background-color: #f0f0f0;
}

.blog-post {
   background-color: #e0e0e0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
