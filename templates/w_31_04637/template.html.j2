<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}


.nav {
    background-color: #333;
    overflow: hidden;
}
.nav a {
    text-decoration: none;
    color: white;
    padding: 14px 16px;
    float: right;
}


.heroImage {
    width: 100%;
    height: 500px;
    background-color: lightblue;
}


.cta {
    text-align: center;
    margin-top: 50px;
}
.cta-button {
    background-color: #008CBA;
    color: white;
    padding: 15px 32px;
    text-decoration: none;
}


.sidebar {
    float: left;
    width: 20%;
    background-color: #f2f2f2;
    padding: 20px;
}
.sidebar h3 {
    margin-bottom: 10px;
}
.sidebar ul, .sidebar p {
    margin: 0;
    padding: 0;
}
.sidebar li {
    list-style: none;
    margin-bottom: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="nav">
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
</div>
<div class="heroImage ph"></div>
<div class="cta">
<a class="cta-button">{{ slot_6 }}</a>
</div>
<div class="sidebar">
<h3>{{ slot_7 }}</h3>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>