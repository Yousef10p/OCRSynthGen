    text-align: center;
    color: #555;
}

.table-of-contents {
    clear: both;
    margin-top: 20px;
    text-align: center;
}


.sidebar ul {
    list-style-type: none;
    padding: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
