<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 60.2mm; inline-size: 27.0mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 65.9mm; inline-size: 86.5mm; block-size: 81.0mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 140.4mm; inline-size: 59.4mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_5 }}</p>
