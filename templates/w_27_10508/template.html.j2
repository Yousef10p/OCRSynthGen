<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

a {
    text-decoration: none;
    color: #000;
}

#nav {
    position: absolute;
    top: 0;
    left: 0;
    padding: 20px;
}

#nav ul {
    list-style: none;
}

#nav ul li {
    display: inline;
    margin-left: 10px;
}

#hero {
    position: relative;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

#hero h1 {
    font-size: 40px;
    color: #fff;
    background-color: rgba(0,0,0,0.5);
    padding: 20px;
}

button {
    font-size: 20px;
    padding: 10px 20px;
    margin-top: 20px;
    background-color: #000;
    color: #fff;
    border: none;
    cursor: pointer;
}

#footer {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 100%;
    text-align: center;
}

#footer form {
    margin: 20px 0;
}

#footer form input[type="text"],
#footer form input[type="email"],
#footer form textarea,
#footer form input[type="submit"] {
    width: 300px;
    padding: 10px;
    margin: 10px 0;
    display: block;
}

#footer form input[type="submit"] {
    background-color: #000;
    color: #fff;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="nav">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div id="hero">
<h1>{{ slot_4 }}</h1>
<button>{{ slot_5 }}</button>
</div>
<div id="footer">
<p>{{ slot_6 }}
            <a>{{ slot_7 }}</a> {{ slot_8 }}
            <a>{{ slot_9 }}</a> {{ slot_10 }}
            <a>{{ slot_11 }}</a>
</p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_12 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_14 }}</span>
<span class="">{{ slot_15 }}</span>
</form>
</div>
</body>
</html>