<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 54.4mm; inline-size: 122.1mm; block-size: 11.4mm; font-size: 10.8pt"><li>{{ slot_0 }}</li></ul>
<div class="box ph" style="inset-inline-start: 60.7mm; inset-block-start: 70.8mm; inline-size: 117.7mm; block-size: 109.9mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 61.3mm; inset-block-start: 181.7mm; inline-size: 89.9mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 190.6mm; inline-size: 121.5mm; block-size: 7.3mm; font-size: 10.3pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 200.5mm; inline-size: 74.3mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 61.6mm; inset-block-start: 206.4mm; inline-size: 26.9mm; block-size: 3.0mm; font-size: 8.5pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 61.6mm; inset-block-start: 210.5mm; inline-size: 23.5mm; block-size: 3.0mm; font-size: 8.5pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 61.6mm; inset-block-start: 214.7mm; inline-size: 20.1mm; block-size: 3.0mm; font-size: 8.5pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 61.6mm; inset-block-start: 218.8mm; inline-size: 14.9mm; block-size: 3.0mm; font-size: 8.5pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 31.6mm; inset-block-start: 248.2mm; inline-size: 112.2mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
