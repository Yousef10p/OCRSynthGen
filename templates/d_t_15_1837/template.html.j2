<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 202.9mm; inline-size: 81.0mm; block-size: 4.3mm; font-size: 12.3pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 204.1mm; inline-size: 86.9mm; block-size: 54.0mm; font-size: 12.7pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 209.0mm; inline-size: 60.3mm; block-size: 4.3mm; font-size: 12.3pt"><li>{{ slot_5 }}</li></ul>
