<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 94.1mm; inset-block-start: 15.5mm; inline-size: 26.9mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 51.3mm; inset-block-start: 26.7mm; inline-size: 26.2mm; block-size: 6.2mm; font-size: 17.5pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 93.4mm; inset-block-start: 26.8mm; inline-size: 71.5mm; block-size: 56.1mm; font-size: 31.8pt"></div>
<p class="box" style="inset-inline-start: 51.1mm; inset-block-start: 88.8mm; inline-size: 26.5mm; block-size: 6.1mm; font-size: 17.3pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 92.9mm; inset-block-start: 88.9mm; inline-size: 71.5mm; block-size: 56.3mm; font-size: 14.5pt"></div>
<div class="box ph" style="inset-inline-start: 92.5mm; inset-block-start: 147.1mm; inline-size: 71.9mm; block-size: 51.7mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 50.8mm; inset-block-start: 203.5mm; inline-size: 26.8mm; block-size: 6.0mm; font-size: 17.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 83.4mm; inset-block-start: 204.7mm; inline-size: 80.8mm; block-size: 52.2mm; font-size: 40.0pt"></div>
<footer class="box" style="inset-inline-start: 105.8mm; inset-block-start: 283.1mm; inline-size: 3.4mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_4 }}</footer>
</div></body>
</html>
