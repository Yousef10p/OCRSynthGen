<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
  height: 100%;
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

.header {
  background: #f8f8f8;
  padding: 10px;
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
}

.main-content {
  margin-top: 60px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  grid-gap: 10px;
  padding: 10px;
}

.post {
  background: #f8f8f8;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.post h2 {
  margin: 0;
}


nav ul {
  list-style-type: none;
  padding: 0;
  display: flex;
}

nav ul li {
  margin-left: 10px;
  position: relative;
}

nav ul li:last-child {
  margin-left: 0;
}

nav ul li a {
  text-decoration: none;
  color: #000;
}

nav ul li ul {
  position: absolute;
  top: 100%;
  right: 0;
  width: 200px;
  background: #f8f8f8;
  display: none;
}

nav ul li:hover ul {
  display: block;
}

nav ul li ul li {
  display: block;
  margin: 0;
}


input[type="text"] {
  margin-top: 10px;
  padding: 5px;
  border: 1px solid #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
</div>
<div class="main-content">
<div class="post">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</div>
<div class="post">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
<div class="post">
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
<div class="post">
<h2>{{ slot_17 }}</h2>
<p>{{ slot_18 }}</p>
</div>
</div>
</body>
</html>