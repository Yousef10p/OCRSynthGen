body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

ul {
    list-style-type: none;
}

a {
    text-decoration: none;
}


nav {
    display: flex;
    justify-content: center;
    background-color: #F5F5F5;
    color: #333;
    height: 50px;
    align-items: center;
}

nav ul li {
    margin-left: 20px;
}

nav ul li:last-child {
    margin-left: 0;
}


section {
    margin: 20px;
}

.product {
    background-color: #333; 
    height: 200px; 
    width: 200px; 
    color: #fff; 
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: 10px;
}

.product:hover {
    opacity: 0.8; 
    cursor: pointer;
}


article {
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
