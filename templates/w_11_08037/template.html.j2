</ul>
<h2>{{ slot_4 }}</h2>
<div class="img-placeholder ph"></div>
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</div>
<div id="right-column">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<ul id="social-media">
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</div>
</body>
</html>