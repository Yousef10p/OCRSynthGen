}

.cta-container a {
    margin-top: 30px;
}

footer {
    background-color: #f8f9fa;
    color: #000;
    padding: 50px 0;
    text-align: center;
}

footer .contact {
    margin-bottom: 20px;
}

footer .contact p {
    margin: 10px 0;
    font-size: 18px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
