<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 35mm; margin-inline: auto; inline-size: 100%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_2 }}</figcaption></figure><ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}<ol style="list-style-type: arabic-indic; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
</ul>
</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ol>
</li>
</ul>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em"><p style="margin-block: 0.15em">{{ slot_15 }}</p></div></main>
</div></body>
</html>
