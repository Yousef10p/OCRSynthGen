    padding: 10px;
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 10;
}

nav ul {
    margin: 0;
    padding: 0;
    list-style-type: none;
}

nav ul li {
    display: inline-block;
    position: relative;
}

nav ul li a {
    display: block;
    padding: 10px;
    color: #333;
    text-decoration: none;
}

nav ul li a:hover {
    background-color: #ddd;
}

nav ul ul {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
}

nav ul li:hover > ul {
    display: block;
}

.content-section {
    padding: 20px;
    margin: 20px;
}

.hero-image {
    background-color: #343a40;
    color: white;
    padding: 100px 20px;
