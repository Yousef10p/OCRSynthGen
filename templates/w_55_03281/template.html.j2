}

footer {
    background-color: #f8f9fa;
    padding: 10px;
    text-align: center;
}

.hero-image, .hero-image:before {
    background: rgba(0,0,0,0.1);
    content: "";
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
