<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 32.9mm; inset-block-start: 44.2mm; inline-size: 110.7mm; block-size: 23.0mm; font-size: 32.6pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 107.0mm; inset-block-start: 75.0mm; inline-size: 103.0mm; block-size: 103.4mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 32.9mm; inset-block-start: 114.2mm; inline-size: 66.2mm; block-size: 52.6mm; font-size: 18.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 32.8mm; inset-block-start: 191.2mm; inline-size: 130.9mm; block-size: 15.2mm; font-size: 14.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 32.7mm; inset-block-start: 210.1mm; inline-size: 140.1mm; block-size: 26.9mm; font-size: 15.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 32.3mm; inset-block-start: 240.6mm; inline-size: 145.8mm; block-size: 26.9mm; font-size: 15.2pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 12.0mm; inset-block-start: 279.6mm; inline-size: 70.0mm; block-size: 7.2mm; font-size: 20.4pt">{{ slot_5 }}</footer>
</div></body>
</html>
