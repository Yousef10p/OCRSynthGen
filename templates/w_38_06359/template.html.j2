.hero-banner:before, .sidebar:before, .pricing:before, .services:before, .footer:before {
    content: "";
    height: 100px;
    display: block;
    background-color: #ffa07a;   
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
