</header>
<div class="slider">
<div class="slide" style="background-color:red;">{{ slot_4 }}</div>
<div class="slide" style="background-color:blue;">{{ slot_5 }}</div>
<div class="slide" style="background-color:green;">{{ slot_6 }}</div>
</div>
<div id="about">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div id="shop">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
<div id="contact">
