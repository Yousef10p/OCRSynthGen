<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 144.5mm; inset-block-start: 13.9mm; inline-size: 30.5mm; block-size: 4.9mm; font-size: 13.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.5mm; inset-block-start: 25.7mm; inline-size: 53.7mm; block-size: 79.3mm; font-size: 18.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 110.4mm; inline-size: 142.2mm; block-size: 31.8mm; font-size: 18.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 47.4mm; inset-block-start: 145.6mm; inline-size: 126.9mm; block-size: 15.9mm; font-size: 15.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 166.9mm; inline-size: 76.0mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 47.3mm; inset-block-start: 175.6mm; inline-size: 91.9mm; block-size: 15.8mm; font-size: 15.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 34.5mm; inset-block-start: 202.1mm; inline-size: 48.1mm; block-size: 5.9mm; font-size: 16.8pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 34.5mm; inset-block-start: 211.3mm; inline-size: 141.7mm; block-size: 25.0mm; font-size: 17.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 237.1mm; inline-size: 141.6mm; block-size: 32.1mm; font-size: 18.2pt">{{ slot_8 }}</p>
</div></body>
</html>
