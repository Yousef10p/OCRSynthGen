<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    background-color: #00008B; 
    color: white;
    font-family: var(--font-body);
}

#banner-rotator {
    height: 80px;
    background-color: #000000; 
    color: #ff0000; 
    overflow: hidden;
}

.banner {
    height: 80px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: bold;
    animation: slide 10s infinite;
}

@keyframes slide {
    0% { transform: translateY(0); }
    20% { transform: translateY(-100%); }
    40% { transform: translateY(-200%); }
    60% { transform: translateY(-300%); }
    80% { transform: translateY(-400%); }
    100% { transform: translateY(-400%); }
}

h2 {
    color: #ADD8E6; 
}

p {
    line-height: 1.6;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    border: 1px solid white;
    padding: 10px;
    text-align: right;
}

tr:nth-child(even) {
    background-color: #1E90FF; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="banner-rotator">
<div class="banner">{{ slot_0 }}</div>
<div class="banner">{{ slot_1 }}</div>
<div class="banner">{{ slot_2 }}</div>
</div>
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
<table>
<tr>
<th>{{ slot_5 }}</th>
<th>{{ slot_6 }}</th>
</tr>
<tr>
<td>{{ slot_7 }}</td>
<td>{{ slot_8 }}</td>
</tr>
<tr>
<td>{{ slot_9 }}</td>
<td>{{ slot_10 }}</td>
</tr>
<tr>
<td>{{ slot_11 }}</td>
<td>{{ slot_12 }}</td>
</tr>
</table>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
</body>
</html>