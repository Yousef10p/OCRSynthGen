<p>{{ slot_7 }}</p>
<a class="cta">{{ slot_8 }}</a>
<div class="timer">
<div class="days"><span id="days">{{ slot_9 }}</span> {{ slot_10 }}</div>
<div class="hours"><span id="hours">{{ slot_11 }}</span> {{ slot_12 }}</div>
<div class="minutes"><span id="minutes">{{ slot_13 }}</span> {{ slot_14 }}</div>
<div class="seconds"><span id="seconds">{{ slot_15 }}</span> {{ slot_16 }}</div>
</div>
