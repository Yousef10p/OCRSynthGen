<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 162.5mm; inset-block-start: 21.7mm; inline-size: 36.5mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 9.9mm; inset-block-start: 28.2mm; inline-size: 88.0mm; block-size: 77.5mm; font-size: 13.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 108.6mm; inset-block-start: 28.2mm; inline-size: 89.6mm; block-size: 170.6mm; font-size: 13.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 10.0mm; inset-block-start: 111.5mm; inline-size: 88.9mm; block-size: 43.2mm; font-size: 13.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 10.0mm; inset-block-start: 160.6mm; inline-size: 88.2mm; block-size: 52.9mm; font-size: 13.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 108.8mm; inset-block-start: 204.7mm; inline-size: 26.2mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 108.7mm; inset-block-start: 209.7mm; inline-size: 89.2mm; block-size: 23.5mm; font-size: 13.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 10.1mm; inset-block-start: 219.4mm; inline-size: 88.4mm; block-size: 13.8mm; font-size: 13.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 172.9mm; inset-block-start: 280.6mm; inline-size: 21.2mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
