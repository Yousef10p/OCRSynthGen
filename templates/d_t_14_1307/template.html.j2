<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 140.5mm; inset-block-start: 2.3mm; inline-size: 69.3mm; block-size: 34.8mm; font-size: 14.1pt"></div>
<div class="box ph" style="inset-inline-start: 14.7mm; inset-block-start: 17.4mm; inline-size: 41.6mm; block-size: 19.8mm; font-size: 14.0pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 56.3mm; inline-size: 38.5mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 64.9mm; inline-size: 93.3mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 73.5mm; inline-size: 28.4mm; block-size: 12.9mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 90.7mm; inline-size: 160.3mm; block-size: 8.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 103.5mm; inline-size: 89.0mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 107.8mm; inline-size: 160.4mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 129.2mm; inline-size: 160.4mm; block-size: 42.9mm; font-size: 10.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 180.7mm; inline-size: 139.1mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 189.3mm; inline-size: 160.4mm; block-size: 34.3mm; font-size: 10.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 227.8mm; inline-size: 160.3mm; block-size: 8.6mm; font-size: 10.0pt">{{ slot_9 }}</p>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 240.7mm; inline-size: 147.7mm; block-size: 12.9mm; font-size: 10.0pt"><li>{{ slot_10 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 253.6mm; inline-size: 147.7mm; block-size: 17.1mm; font-size: 10.0pt"><li>{{ slot_11 }}</li></ul>
<footer class="box" style="inset-inline-start: 200.4mm; inset-block-start: 282.3mm; inline-size: 5.3mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
