<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 73.5mm; inset-block-start: 37.6mm; inline-size: 63.0mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_0 }}</p>
<h1 class="box" style="inset-inline-start: 20.7mm; inset-block-start: 50.7mm; inline-size: 168.6mm; block-size: 21.1mm; font-size: 20.7pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 25.7mm; inset-block-start: 96.6mm; inline-size: 158.4mm; block-size: 5.3mm; font-size: 12.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 37.1mm; inset-block-start: 116.2mm; inline-size: 135.9mm; block-size: 10.0mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 79.9mm; inset-block-start: 148.8mm; inline-size: 39.5mm; block-size: 2.8mm; font-size: 7.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 95.5mm; inset-block-start: 155.3mm; inline-size: 34.6mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 282.4mm; inline-size: 1.8mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
