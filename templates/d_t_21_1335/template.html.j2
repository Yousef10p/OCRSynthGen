<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 60.9mm; inset-block-start: 7.0mm; inline-size: 26.2mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 17.6mm; inset-block-start: 15.1mm; inline-size: 7.1mm; block-size: 4.0mm; font-size: 5.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 17.6mm; inset-block-start: 19.2mm; inline-size: 114.4mm; block-size: 26.7mm; font-size: 9.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 17.6mm; inset-block-start: 49.9mm; inline-size: 113.4mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 64.7mm; inset-block-start: 61.0mm; inline-size: 18.6mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 64.6mm; inset-block-start: 68.7mm; inline-size: 18.9mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 17.6mm; inset-block-start: 76.7mm; inline-size: 92.0mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 24.6mm; inset-block-start: 84.3mm; inline-size: 107.0mm; block-size: 22.9mm; font-size: 10.8pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.3mm; inset-block-start: 111.2mm; inline-size: 107.4mm; block-size: 26.7mm; font-size: 10.8pt"><li>{{ slot_8 }}</li></ul>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 141.8mm; inline-size: 103.9mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_9 }}</p>
<ul class="box" style="inset-inline-start: 24.7mm; inset-block-start: 153.3mm; inline-size: 106.9mm; block-size: 19.1mm; font-size: 10.8pt"><li>{{ slot_10 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.3mm; inset-block-start: 176.3mm; inline-size: 107.5mm; block-size: 19.1mm; font-size: 10.8pt"><li>{{ slot_11 }}</li></ul>
<footer class="box" style="inset-inline-start: 74.7mm; inset-block-start: 196.7mm; inline-size: 4.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
