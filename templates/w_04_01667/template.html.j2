</ul>
</nav>
<div id="slider">
<div class="slide"><div class="placeholder ph"></div><p>{{ slot_5 }}</p></div>
<div class="slide"><div class="placeholder ph"></div><p>{{ slot_6 }}</p></div>
<div class="slide"><div class="placeholder ph"></div><p>{{ slot_7 }}</p></div>
</div>
</header>
<section id="services">
