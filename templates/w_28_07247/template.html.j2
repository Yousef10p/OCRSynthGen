<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

nav {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #333;
    color: white;
}

nav ul {
    display: flex;
    list-style-type: none;
    padding: 0;
}

nav li {
    padding: 20px;
}

nav a {
    color: white;
    text-decoration: none;
}

button {
    background-color: red;
    color: white;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    float: left;
    margin-left: 20px;
}

h1 {
    margin: 0;
}

p {
    color: grey;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navbar">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><button>{{ slot_6 }}</button></li>
</ul>
</nav>
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
<h1>{{ slot_11 }}</h1>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>

<div style="width: 100px; height: 100px; background: red;"></div>
<div style="width: 100px; height: 100px; background: blue;"></div>
<div style="width: 100px; height: 100px; background: green;"></div>
</div>
</body>
</html>