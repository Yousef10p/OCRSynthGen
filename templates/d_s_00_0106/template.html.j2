<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 40.2mm; inset-block-start: 20.0mm; inline-size: 52.3mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 40.6mm; inset-block-start: 40.3mm; inline-size: 139.3mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 40.6mm; inset-block-start: 58.5mm; inline-size: 139.2mm; block-size: 15.6mm; font-size: 14.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 40.6mm; inset-block-start: 82.8mm; inline-size: 139.3mm; block-size: 21.6mm; font-size: 15.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 40.6mm; inset-block-start: 113.2mm; inline-size: 139.3mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 40.6mm; inset-block-start: 131.4mm; inline-size: 139.3mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 40.6mm; inset-block-start: 149.6mm; inline-size: 139.3mm; block-size: 27.7mm; font-size: 15.7pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 20.5mm; inset-block-start: 186.0mm; inline-size: 159.3mm; block-size: 15.6mm; font-size: 14.7pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.5mm; inset-block-start: 210.2mm; inline-size: 160.3mm; block-size: 9.5mm; font-size: 13.5pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.5mm; inset-block-start: 228.4mm; inline-size: 159.3mm; block-size: 9.5mm; font-size: 13.5pt"><li>{{ slot_9 }}</li></ul>
<p class="box" style="inset-inline-start: 40.6mm; inset-block-start: 246.6mm; inline-size: 139.3mm; block-size: 15.6mm; font-size: 14.7pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 40.6mm; inset-block-start: 270.9mm; inline-size: 139.3mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 23.1mm; inset-block-start: 271.9mm; inline-size: 4.1mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_12 }}</footer><div class="box ph" style="inset-inline-start: 8.5mm; inset-block-start: 275.1mm; inline-size: 21.0mm; block-size: 17.6mm; font-size: 40.0pt"></div>
</div></body>
</html>
