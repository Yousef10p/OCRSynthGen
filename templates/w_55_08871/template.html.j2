<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: var(--font-body);
}

.grid-container {
    display: grid;
    grid-template-columns: 50% 50%;
    grid-template-rows: auto;
    grid-gap: 10px;
    height: 100%;
    padding: 10px;
}

.grid-item {
    background-color: #4aaaa5;
    color: #ffffff;
    padding: 20px;
    font-size: 20px;
}

.menu-item {
    display: grid;
    grid-template-columns: 50% 50%;
    grid-template-rows: auto;
    grid-gap: 10px;
}

.menu-item-img {
    height: 100px;
    width: 100px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="grid-container">
<div class="grid-item" id="header">
<h1>{{ slot_0 }}</h1>
</div>
<div class="grid-item" id="booking-form">
<h2>{{ slot_1 }}</h2>
<form>
<label>{{ slot_2 }}</label><br>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span><br>
<label>{{ slot_4 }}</label><br>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span><br>
<label>{{ slot_6 }}</label><br>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span><br>
<label>{{ slot_8 }}</label><br>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span><br>
<span class="">{{ slot_10 }}</span>
</form>
</div>
<div class="grid-item" id="menu-grid">
<div class="menu-item">
<h3>{{ slot_11 }}</h3>
<div class="menu-item-img ph"></div>
<p>{{ slot_12 }}</p>
</div>
<div class="menu-item">
<h3>{{ slot_13 }}</h3>
<div class="menu-item-img ph"></div>
<p>{{ slot_14 }}</p>
</div>

</div>
</div>
</body>
</html>