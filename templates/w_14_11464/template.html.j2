<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  color: #333;
  background-color: #f4f4f4;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  grid-gap: 20px;
  justify-content: center;
  align-content: center;
  height: 100vh;
}

header {
  grid-column: 1 / -1;
}

header,
footer {
  background: linear-gradient(-45deg, blue, purple);
  color:white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.6rem 2rem;
}

h1,
h2 {
  color: white;
  text-decoration: underline;
}

nav ul {
  list-style: none;
  display: flex;
}

nav li a {
  color: white;
  text-decoration: none;
  padding: 0 0.6rem;
  transition: all 0.3s ease-in;
}

section {
  margin: 1rem 0;
  padding: 1rem;
}

form {
  display: flex;
  flex-direction: column;
  width: 50%;
  margin: 0 auto;
}

input,
textarea,
button {
  margin: 1rem 0;
  padding: 0.6rem;
  border: none;
  border-radius: 5px;
}

button {
  background: linear-gradient(-45deg, blue, purple);
  color: white;
  cursor: pointer;
  transition: all 0.3s ease-in;
}

button:hover {
  transform: scale(1.05);
}

.product, .service, .about {
  height: 200px;
  margin: 10px;
  border-radius: 5px;
  background-color: #999;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
