<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 69.8mm; inset-block-start: 23.1mm; inline-size: 8.3mm; block-size: 6.6mm; font-size: 18.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 48.9mm; inset-block-start: 39.5mm; inline-size: 50.1mm; block-size: 7.5mm; font-size: 21.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 64.3mm; inline-size: 90.8mm; block-size: 54.4mm; font-size: 14.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 28.6mm; inset-block-start: 128.9mm; inline-size: 22.4mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 133.9mm; inline-size: 90.9mm; block-size: 28.8mm; font-size: 13.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 28.6mm; inset-block-start: 169.9mm; inline-size: 25.9mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 174.8mm; inline-size: 90.8mm; block-size: 13.5mm; font-size: 12.7pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 72.3mm; inset-block-start: 195.7mm; inline-size: 4.6mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
