<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    line-height: 1.5;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f8f9fa;
    padding: 10px;
}

nav input {
    margin-left: 10px;
}

main {
    margin: 20px;
}

main p {
    margin-bottom: 20px;
}

main div {
    margin-bottom: 20px;
}

.testimonial, .insurance, .scores, .blog-link {
    border: 1px solid #ced4da;
    padding: 10px;
}

footer {
    background-color: #f8f9fa;
    text-align: center;
    padding: 10px;
    position: fixed;
    width: 100%;
    bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<span>{{ slot_0 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</nav>
<main>
<p>{{ slot_2 }}</p>
<div class="testimonial">
<h2>{{ slot_3 }}</h2>
<div class="testi-text">{{ slot_4 }}</div>
</div>
<div class="insurance">
<h2>{{ slot_5 }}</h2>
<ul>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
</ul>
</div>
<div class="scores">
<h2>{{ slot_9 }}</h2>
<div class="score-text">{{ slot_10 }}</div>
</div>
<div class="blog-link">
<h2>{{ slot_11 }}</h2>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</div>
</main>
<footer>
<span>{{ slot_15 }}</span>
</footer>
</body>
</html>