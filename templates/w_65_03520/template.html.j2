  padding: 20px;
}

.product {
  display: flex;
  flex-direction: column;
  border: 1px solid #333;
  padding: 20px;
}

.img-placeholder {
  background-color: #eee;
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
}

.hero-text {
  font-size: 60px;
  font-weight: bold;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
