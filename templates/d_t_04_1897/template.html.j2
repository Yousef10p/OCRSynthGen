<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.7mm; inset-block-start: 0.0mm; inline-size: 214.4mm; block-size: 71.2mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 20.2mm; inset-block-start: 80.0mm; inline-size: 148.6mm; block-size: 17.3mm; font-size: 24.5pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 101.6mm; inline-size: 175.8mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 121.7mm; inline-size: 175.0mm; block-size: 27.1mm; font-size: 12.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 151.3mm; inline-size: 80.2mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 20.2mm; inset-block-start: 162.5mm; inline-size: 122.2mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 170.2mm; inline-size: 175.4mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 190.3mm; inline-size: 176.2mm; block-size: 36.1mm; font-size: 12.8pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 20.2mm; inset-block-start: 233.0mm; inline-size: 110.3mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 240.7mm; inline-size: 174.6mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 268.5mm; inline-size: 139.9mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 199.7mm; inset-block-start: 268.4mm; inline-size: 3.7mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_10 }}</footer>
</div></body>
</html>
