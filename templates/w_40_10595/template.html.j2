	color: #fff;
}
nav ul li {
	padding: 10px;
}
nav ul li a {
	color: #fff;
	text-decoration: none;
}
nav form input {
	margin: 10px;
	padding: 5px;
	border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
