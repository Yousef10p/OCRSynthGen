<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 28.9mm; inline-size: 26.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 56.0mm; inline-size: 19.5mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 83.2mm; inline-size: 29.5mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 110.4mm; inline-size: 27.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 89.5mm; inset-block-start: 121.0mm; inline-size: 43.6mm; block-size: 43.8mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 137.5mm; inline-size: 27.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 141.0mm; inset-block-start: 208.2mm; inline-size: 45.1mm; block-size: 23.8mm; font-size: 16.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 145.4mm; inset-block-start: 247.5mm; inline-size: 41.0mm; block-size: 11.4mm; font-size: 16.2pt"></div>
</div></body>
</html>
