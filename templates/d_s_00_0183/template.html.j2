<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 21.6mm; inline-size: 130.6mm; block-size: 50.6mm; font-size: 40.0pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 12.0mm; inset-block-start: 80.8mm; inline-size: 186.1mm; block-size: 46.6mm; font-size: 26.4pt"><li>{{ slot_1 }}</li></ul>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 140.9mm; inline-size: 215.7mm; block-size: 52.8mm; font-size: 15.0pt"></div>
<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 205.3mm; inline-size: 61.0mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 211.5mm; inline-size: 179.8mm; block-size: 19.8mm; font-size: 14.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 70.0mm; inset-block-start: 249.0mm; inline-size: 20.1mm; block-size: 11.3mm; font-size: 16.1pt"></div>
<div class="box ph" style="inset-inline-start: 122.6mm; inset-block-start: 249.2mm; inline-size: 26.9mm; block-size: 10.0mm; font-size: 14.1pt"></div>
<div class="box ph" style="inset-inline-start: 178.8mm; inset-block-start: 249.0mm; inline-size: 21.3mm; block-size: 10.3mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 16.1mm; inset-block-start: 249.9mm; inline-size: 25.2mm; block-size: 9.0mm; font-size: 12.7pt"></div>
<footer class="box" style="inset-inline-start: 16.9mm; inset-block-start: 271.1mm; inline-size: 34.4mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_4 }}</footer>
</div></body>
</html>
