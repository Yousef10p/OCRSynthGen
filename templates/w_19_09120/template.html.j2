.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

header {
    width: 100%;
    background-color: #f0f0f0;
    text-align: center;
    padding: 50px 0;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

nav ul li {
    list-style-type: none;
}

#mission-values p {
    width: 50%;
    margin: 0 auto;
}

#testimonials .testimonial {
    display: flex;
    justify-content: space-between;
}

button {
    background-color: #007BFF;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

div[id$="-color"] {
    width: 100px;
    height: 100px;
    background-color: #f0f0f0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
