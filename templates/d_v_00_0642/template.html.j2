<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 23.5mm; inset-block-start: 19.3mm; inline-size: 173.3mm; block-size: 46.2mm; font-size: 32.8pt">{{ slot_0 }}</h2>
<ul class="box" style="inset-inline-start: 28.2mm; inset-block-start: 147.2mm; inline-size: 75.4mm; block-size: 13.4mm; font-size: 12.6pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 147.3mm; inline-size: 84.0mm; block-size: 27.6mm; font-size: 13.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 166.3mm; inline-size: 83.8mm; block-size: 56.2mm; font-size: 13.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 180.6mm; inline-size: 83.9mm; block-size: 70.5mm; font-size: 13.3pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 23.5mm; inset-block-start: 228.2mm; inline-size: 61.5mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 233.0mm; inline-size: 82.8mm; block-size: 22.9mm; font-size: 13.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 197.9mm; inset-block-start: 283.9mm; inline-size: 1.4mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
