<ul class="box" style="inset-inline-start: 30.7mm; inset-block-start: 79.1mm; inline-size: 76.2mm; block-size: 9.1mm; font-size: 8.6pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.7mm; inset-block-start: 87.5mm; inline-size: 79.0mm; block-size: 12.9mm; font-size: 7.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.7mm; inset-block-start: 99.9mm; inline-size: 77.9mm; block-size: 12.9mm; font-size: 7.3pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.7mm; inset-block-start: 112.2mm; inline-size: 66.0mm; block-size: 9.1mm; font-size: 8.6pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 26.5mm; inset-block-start: 123.9mm; inline-size: 83.5mm; block-size: 14.3mm; font-size: 13.5pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 115.4mm; inset-block-start: 124.0mm; inline-size: 22.0mm; block-size: 6.2mm; font-size: 17.6pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 131.7mm; inline-size: 83.5mm; block-size: 18.9mm; font-size: 13.4pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 26.5mm; inset-block-start: 140.9mm; inline-size: 83.5mm; block-size: 9.7mm; font-size: 13.7pt">{{ slot_10 }}</p>
<div class="box ph" style="inset-inline-start: 26.1mm; inset-block-start: 153.3mm; inline-size: 172.0mm; block-size: 102.6mm; font-size: 15.3pt"></div>
