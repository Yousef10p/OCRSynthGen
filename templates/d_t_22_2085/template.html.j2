<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 60.2mm; inset-block-start: 12.9mm; inline-size: 27.1mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 11.8mm; inset-block-start: 14.4mm; inline-size: 43.9mm; block-size: 53.2mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 60.2mm; inset-block-start: 20.6mm; inline-size: 71.5mm; block-size: 46.4mm; font-size: 13.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 12.5mm; inset-block-start: 70.0mm; inline-size: 119.7mm; block-size: 27.9mm; font-size: 13.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 12.5mm; inset-block-start: 100.9mm; inline-size: 117.7mm; block-size: 23.3mm; font-size: 13.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 12.5mm; inset-block-start: 127.1mm; inline-size: 118.3mm; block-size: 27.9mm; font-size: 13.2pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 12.6mm; inset-block-start: 157.7mm; inline-size: 46.9mm; block-size: 13.7mm; font-size: 12.9pt"></div>
<p class="box" style="inset-inline-start: 12.5mm; inset-block-start: 173.5mm; inline-size: 91.1mm; block-size: 14.0mm; font-size: 13.2pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 12.2mm; inset-block-start: 200.4mm; inline-size: 78.3mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_6 }}</footer>
</div></body>
</html>
