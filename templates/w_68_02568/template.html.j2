<label>{{ slot_5 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_6 }}</span>
<label>{{ slot_7 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_8 }}</span>
<button>{{ slot_9 }}</button>
</form>
</div>
<div class="result">
<h2>{{ slot_10 }}</h2>
<table>
<thead>
<tr>
