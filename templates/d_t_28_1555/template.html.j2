<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 40.1mm; inset-block-start: 10.7mm; inline-size: 129.5mm; block-size: 7.0mm; font-size: 15.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 6.1mm; inset-block-start: 24.4mm; inline-size: 64.1mm; block-size: 7.0mm; font-size: 15.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 6.1mm; inset-block-start: 34.8mm; inline-size: 198.4mm; block-size: 24.3mm; font-size: 15.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 6.1mm; inset-block-start: 62.4mm; inline-size: 198.4mm; block-size: 7.0mm; font-size: 15.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 6.1mm; inset-block-start: 72.8mm; inline-size: 50.4mm; block-size: 3.5mm; font-size: 15.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 6.1mm; inset-block-start: 79.7mm; inline-size: 28.8mm; block-size: 7.0mm; font-size: 15.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 101.8mm; inset-block-start: 94.1mm; inline-size: 6.1mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
