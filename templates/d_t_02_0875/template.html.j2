<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 40.5mm; inset-block-start: 24.0mm; inline-size: 87.7mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 41.8mm; inline-size: 54.2mm; block-size: 6.8mm; font-size: 9.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 53.4mm; inline-size: 144.9mm; block-size: 18.5mm; font-size: 10.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 76.7mm; inline-size: 145.1mm; block-size: 22.3mm; font-size: 10.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 103.9mm; inline-size: 145.1mm; block-size: 14.6mm; font-size: 10.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 123.3mm; inline-size: 136.8mm; block-size: 6.8mm; font-size: 9.7pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 126.8mm; inset-block-start: 132.1mm; inline-size: 58.7mm; block-size: 15.6mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 142.7mm; inline-size: 53.5mm; block-size: 14.6mm; font-size: 10.3pt">{{ slot_6 }}</p>
</div></body>
</html>
