<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 54.5mm; inset-block-start: 13.9mm; inline-size: 96.5mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 26.1mm; inline-size: 170.9mm; block-size: 24.8mm; font-size: 23.4pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 4.9mm; inset-block-start: 36.1mm; inline-size: 2.6mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 61.8mm; inline-size: 167.7mm; block-size: 9.4mm; font-size: 13.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 73.1mm; inline-size: 166.8mm; block-size: 20.7mm; font-size: 14.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 95.7mm; inline-size: 168.4mm; block-size: 26.3mm; font-size: 14.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 17.9mm; inset-block-start: 128.8mm; inline-size: 168.4mm; block-size: 124.0mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 255.7mm; inline-size: 163.0mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 259.9mm; inline-size: 167.0mm; block-size: 7.2mm; font-size: 10.2pt">{{ slot_7 }}</p>
</div></body>
</html>
