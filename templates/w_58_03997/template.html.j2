  padding: 0;
  font-family: var(--font-body);
  scroll-behavior: smooth;
}
nav ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: space-around;
}
nav ul li a {
  display: inline-block;
  padding: 1em;
  color: #fff;
  text-decoration: none;
}
nav ul li a:hover {
  background-color: #555;
}

article {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
footer {
  background-color: #333;
  color: #fff;
  padding: 20px 0;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
