<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: #333;
}

header {
    background-color: #333;
    color: #fff;
    padding: 20px;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin-left: 10px;
}

nav form input {
    border: none;
    padding: 5px;
    border-radius: 5px;
}

.hero {
    background-color: #eee;
    padding: 20px;
    text-align: center;
}

.playback-widget {
    background-color: #333;
    color: #fff;
    padding: 20px;
    margin-bottom: 20px;
}

.channels, .playlists {
    background-color: #ddd;
    padding: 20px;
    margin-bottom: 20px;
}

footer {
    background-color: #333;
    color: #fff;
    padding: 10px;
    text-align: center;
}

footer a {
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</form>
</nav>
</header>
<main>
<section class="hero">
<div class="playback-widget"></div>
</section>
<section class="channels"></section>
<section class="playlists"></section>
</main>
<footer>
<p>{{ slot_5 }} <a>{{ slot_6 }}</a>{{ slot_7 }} <a>{{ slot_8 }}</a>{{ slot_9 }} <a>{{ slot_10 }}</a></p>
<p>{{ slot_11 }} <a>{{ slot_12 }}</a>{{ slot_13 }} <a>{{ slot_14 }}</a></p>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>