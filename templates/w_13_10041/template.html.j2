<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

h1, h2 {
    text-align: center;
    color: #2c2c54;
}

p {
    font-size: 1.5em;
    padding: 1em;
}

#hero-section {
    background-color: #f8f9fa;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#menu {
    position: fixed;
    top: 0;
    width: 100%;
    background: #343a40;
    color: white;
}

#menu ul {
    list-style-type: none;
    margin: 0;
    padding: 1em 0;
    display: flex;
    justify-content: center;
}

#menu li {
    margin: 0 1em;
}

#menu a {
    color: white;
    text-decoration: none;
    transition: color 0.2s ease-in-out;
}

#menu a:hover {
    color: #f8f9fa;
}

.video {
    background: #007bff; 
    height: 180px;
    width: 320px;
    margin: auto;
    animation: slide-in 2s ease-in-out infinite;
}

.color-box {
    background: #6c757d; 
    height: 180px;
    width: 320px;
    margin: auto;
    animation: fade-in 2s ease-in-out infinite;
}

@keyframes slide-in {
    0% { transform: translateX(100%); }
    100% { transform: translateX(0); }
}

@keyframes fade-in {
    0% { opacity: 0; }
    100% { opacity: 1; }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
