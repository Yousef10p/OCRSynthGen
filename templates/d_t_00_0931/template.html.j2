<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 69.7mm; inset-block-start: 22.3mm; inline-size: 80.7mm; block-size: 2.3mm; font-size: 6.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 92.6mm; inset-block-start: 27.2mm; inline-size: 32.0mm; block-size: 2.1mm; font-size: 5.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 33.5mm; inset-block-start: 50.0mm; inline-size: 152.1mm; block-size: 210.8mm; font-size: 13.0pt"></div>
<footer class="box" style="inset-inline-start: 101.1mm; inset-block-start: 278.0mm; inline-size: 15.1mm; block-size: 1.5mm; font-size: 5.0pt">{{ slot_2 }}</footer><div class="box ph" style="inset-inline-start: 103.0mm; inset-block-start: 280.1mm; inline-size: 11.1mm; block-size: 6.4mm; font-size: 18.0pt"></div>
<footer class="box" style="inset-inline-start: 72.3mm; inset-block-start: 285.2mm; inline-size: 28.5mm; block-size: 1.5mm; font-size: 5.0pt">{{ slot_3 }}</footer><footer class="box" style="inset-inline-start: 117.3mm; inset-block-start: 285.2mm; inline-size: 23.6mm; block-size: 1.5mm; font-size: 5.0pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 107.0mm; inset-block-start: 287.3mm; inline-size: 3.2mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
