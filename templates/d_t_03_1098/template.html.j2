<p class="box" style="inset-inline-start: 23.6mm; inset-block-start: 75.4mm; inline-size: 72.6mm; block-size: 15.7mm; font-size: 8.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 101.0mm; inset-block-start: 80.0mm; inline-size: 95.9mm; block-size: 55.2mm; font-size: 15.7pt"></div>
<p class="box" style="inset-inline-start: 23.6mm; inset-block-start: 92.6mm; inline-size: 73.1mm; block-size: 15.7mm; font-size: 8.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 137.1mm; inline-size: 43.7mm; block-size: 2.5mm; font-size: 7.0pt">{{ slot_5 }}</p>
