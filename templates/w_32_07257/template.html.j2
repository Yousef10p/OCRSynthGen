	align-items: center;
	padding: 20px;
	background-color: #f8f8f8;
}

header img {
	height: 50px;
}

header nav ul {
	display: flex;
	list-style: none;
}

header nav ul li {
	margin: 0 10px;
}

#slider {
	height: 300px;
	background-color: #ff0000;
}

#content {
	display: flex;
}

#content aside {
	width: 20%;
	padding: 20px;
	background-color: #f0f0f0;
}

footer {
	display: flex;
	justify-content: space-between;
	padding: 20px;
	background-color: #000000;
	color: #ffffff;
}

footer #social-media ul,
footer #contact ul {
	list-style: none;
	padding: 0;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
