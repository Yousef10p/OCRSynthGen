<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 108.9mm; inset-block-start: 22.6mm; inline-size: 3.8mm; block-size: 4.2mm; font-size: 11.9pt"></div>
<p class="box" style="inset-inline-start: 46.3mm; inset-block-start: 23.2mm; inline-size: 55.6mm; block-size: 12.2mm; font-size: 10.2pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 31.3mm; inset-block-start: 40.5mm; inline-size: 4.4mm; block-size: 4.7mm; font-size: 13.2pt"></div>
<p class="box" style="inset-inline-start: 39.5mm; inset-block-start: 39.8mm; inline-size: 75.0mm; block-size: 6.0mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 49.3mm; inline-size: 152.1mm; block-size: 21.9mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 73.1mm; inline-size: 152.1mm; block-size: 32.6mm; font-size: 12.6pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 31.9mm; inset-block-start: 109.3mm; inline-size: 37.3mm; block-size: 8.0mm; font-size: 18.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 118.9mm; inline-size: 152.1mm; block-size: 37.9mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 158.7mm; inline-size: 152.1mm; block-size: 27.3mm; font-size: 12.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 187.9mm; inline-size: 152.1mm; block-size: 39.2mm; font-size: 12.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 244.4mm; inline-size: 102.6mm; block-size: 4.6mm; font-size: 9.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 31.9mm; inset-block-start: 257.7mm; inline-size: 51.5mm; block-size: 4.6mm; font-size: 10.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
