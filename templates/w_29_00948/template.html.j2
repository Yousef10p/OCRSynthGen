<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.hero img {
    width: 100px;
    height: 100px;
    border: 1px solid #000;
    background-color: #ddd;
}

nav ul {
    display: flex;
    justify-content: space-around;
    width: 100%;
}

.financial-tools, .financial-resources {
    display: flex;
    justify-content: space-around;
}

.tool-card, .resource-card {
    width: 200px;
    height: 200px;
    border: 1px solid #000;
    background-color: #ddd;
    text-align: center;
    line-height: 200px;
}

footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

footer p {
    margin-left: 10px;
}

.social-media img {
    width: 30px;
    height: 30px;
    border: 1px solid #000;
    background-color: #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="hero">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h1>{{ slot_0 }}</h1>
</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<div class="main-content">
<div class="financial-tools">
<h2>{{ slot_6 }}</h2>
<a><div class="tool-card">{{ slot_7 }}</div></a>
<a><div class="tool-card">{{ slot_8 }}</div></a>
<a><div class="tool-card">{{ slot_9 }}</div></a>
</div>
<div class="financial-resources">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<a><div class="resource-card">{{ slot_12 }}</div></a>
<a><div class="resource-card">{{ slot_13 }}</div></a>
<a><div class="resource-card">{{ slot_14 }}</div></a>
</div>
</div>
<footer>
