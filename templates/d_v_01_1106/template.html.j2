<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 120.4mm; inline-size: 89.1mm; block-size: 26.7mm; font-size: 12.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 151.6mm; inline-size: 23.9mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_5 }}</h2>
