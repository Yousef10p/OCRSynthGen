<p class="box" style="inset-inline-start: 96.8mm; inset-block-start: 71.6mm; inline-size: 22.7mm; block-size: 7.8mm; font-size: 22.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 38.9mm; inset-block-start: 83.4mm; inline-size: 138.6mm; block-size: 14.7mm; font-size: 20.9pt">{{ slot_5 }}</p>
