<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 3.0mm; inset-block-start: 0.0mm; inline-size: 209.7mm; block-size: 52.1mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 56.3mm; inline-size: 76.6mm; block-size: 17.5mm; font-size: 12.4pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 113.1mm; inset-block-start: 56.3mm; inline-size: 77.2mm; block-size: 27.0mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 77.4mm; inline-size: 79.9mm; block-size: 27.0mm; font-size: 12.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 113.1mm; inset-block-start: 86.9mm; inline-size: 79.1mm; block-size: 27.0mm; font-size: 12.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 29.9mm; inset-block-start: 110.0mm; inline-size: 42.9mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_4 }}</h2>
<div class="box ph" style="inset-inline-start: 29.7mm; inset-block-start: 120.4mm; inline-size: 65.3mm; block-size: 26.7mm; font-size: 18.9pt"></div>
<div class="box ph" style="inset-inline-start: 113.8mm; inset-block-start: 130.9mm; inline-size: 75.4mm; block-size: 58.0mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 155.6mm; inline-size: 80.5mm; block-size: 69.9mm; font-size: 13.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 114.0mm; inset-block-start: 194.6mm; inline-size: 76.1mm; block-size: 46.1mm; font-size: 13.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 229.1mm; inline-size: 80.1mm; block-size: 17.5mm; font-size: 12.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 30.5mm; inset-block-start: 257.5mm; inline-size: 10.8mm; block-size: 12.0mm; font-size: 11.3pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 17.5mm; inset-block-start: 270.2mm; inline-size: 3.5mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_9 }}</footer>
</div></body>
</html>
