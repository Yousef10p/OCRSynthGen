    margin-left: 5%;
}
.hotel-image {
    background-color: #999;
    width: 100%;
    height: 200px;
}
.book-now {
    background-color: #f00;
    color: #fff;
    padding: 10px;
    display: inline-block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
