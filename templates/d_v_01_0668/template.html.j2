<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 22.8mm; inset-block-start: 24.5mm; inline-size: 27.3mm; block-size: 23.2mm; font-size: 16.5pt"></div>
<p class="box" style="inset-inline-start: 53.9mm; inset-block-start: 42.1mm; inline-size: 58.9mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 53.9mm; inset-block-start: 49.4mm; inline-size: 35.4mm; block-size: 5.5mm; font-size: 15.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 139.3mm; inset-block-start: 90.6mm; inline-size: 41.6mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_2 }}</p>
<h1 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 114.4mm; inline-size: 75.6mm; block-size: 5.9mm; font-size: 16.6pt">{{ slot_3 }}</h1>
<h2 class="box" style="inset-inline-start: 44.0mm; inset-block-start: 126.7mm; inline-size: 143.0mm; block-size: 15.6mm; font-size: 14.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 165.7mm; inline-size: 35.3mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 178.0mm; inline-size: 159.9mm; block-size: 10.6mm; font-size: 15.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 192.7mm; inline-size: 161.6mm; block-size: 20.3mm; font-size: 14.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 32.5mm; inset-block-start: 217.2mm; inline-size: 116.4mm; block-size: 5.9mm; font-size: 16.6pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 227.1mm; inline-size: 161.3mm; block-size: 10.6mm; font-size: 15.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 242.0mm; inline-size: 161.6mm; block-size: 10.6mm; font-size: 15.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 262.7mm; inline-size: 161.7mm; block-size: 12.9mm; font-size: 12.2pt">{{ slot_11 }}</p>
</div></body>
</html>
