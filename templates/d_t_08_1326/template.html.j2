<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 147.1mm; inline-size: 159.2mm; block-size: 25.0mm; font-size: 10.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 175.2mm; inline-size: 159.2mm; block-size: 46.1mm; font-size: 10.0pt">{{ slot_11 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 224.4mm; inline-size: 159.3mm; block-size: 46.1mm; font-size: 10.0pt">{{ slot_12 }}</p>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 279.1mm; inline-size: 1.8mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_13 }}</footer>
</div></body>
</html>
