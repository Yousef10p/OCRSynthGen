<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.2mm; inset-block-start: 18.5mm; inline-size: 45.6mm; block-size: 6.3mm; font-size: 17.7pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 27.7mm; inline-size: 49.0mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 67.8mm; inline-size: 111.2mm; block-size: 27.9mm; font-size: 11.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 21.7mm; inset-block-start: 100.7mm; inline-size: 49.0mm; block-size: 48.5mm; font-size: 13.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 74.5mm; inset-block-start: 100.7mm; inline-size: 54.7mm; block-size: 48.5mm; font-size: 12.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 154.3mm; inline-size: 111.2mm; block-size: 11.5mm; font-size: 10.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 18.2mm; inset-block-start: 174.4mm; inline-size: 51.8mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 183.1mm; inline-size: 111.2mm; block-size: 7.3mm; font-size: 10.4pt">{{ slot_7 }}</p>
</div></body>
</html>
