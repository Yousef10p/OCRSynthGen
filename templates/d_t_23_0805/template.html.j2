<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.2mm; inset-block-start: 17.5mm; inline-size: 26.8mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 152.3mm; inset-block-start: 17.5mm; inline-size: 37.6mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 31.2mm; inline-size: 153.0mm; block-size: 13.6mm; font-size: 19.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 23.0mm; inset-block-start: 47.1mm; inline-size: 154.6mm; block-size: 38.0mm; font-size: 21.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 23.0mm; inset-block-start: 87.3mm; inline-size: 154.7mm; block-size: 29.8mm; font-size: 21.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 119.2mm; inline-size: 154.7mm; block-size: 30.0mm; font-size: 21.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 23.2mm; inset-block-start: 150.5mm; inline-size: 154.7mm; block-size: 22.6mm; font-size: 21.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 23.3mm; inset-block-start: 175.3mm; inline-size: 154.7mm; block-size: 54.2mm; font-size: 21.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 231.7mm; inline-size: 154.6mm; block-size: 14.0mm; font-size: 19.8pt">{{ slot_8 }}</p>
