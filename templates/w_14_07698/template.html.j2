<p>{{ slot_7 }}</p>
<div class="promotion" id="promotion-1">{{ slot_8 }}</div>
<div class="promotion" id="promotion-2">{{ slot_9 }}</div>
</div>
<div id="new-arrivals">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<div class="new-arrival" id="new-arrival-1">{{ slot_12 }}</div>
<div class="new-arrival" id="new-arrival-2">{{ slot_13 }}</div>
</div>
<footer>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
<a>{{ slot_16 }}</a>
<a>{{ slot_17 }}</a>
<a>{{ slot_18 }}</a>
</footer>
</body>
</html>