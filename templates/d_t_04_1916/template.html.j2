<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 34.6mm; inset-block-start: 27.2mm; inline-size: 118.3mm; block-size: 3.2mm; font-size: 9.2pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 34.6mm; inset-block-start: 33.5mm; inline-size: 153.8mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 46.2mm; inline-size: 160.9mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 31.0mm; inset-block-start: 65.3mm; inline-size: 14.3mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 71.6mm; inline-size: 160.9mm; block-size: 75.2mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 152.0mm; inline-size: 160.9mm; block-size: 32.9mm; font-size: 11.6pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 27.5mm; inset-block-start: 192.3mm; inline-size: 69.3mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 198.6mm; inline-size: 160.9mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 81.4mm; inset-block-start: 262.2mm; inline-size: 53.1mm; block-size: 6.0mm; font-size: 8.5pt">{{ slot_8 }}</footer>
</div></body>
</html>
