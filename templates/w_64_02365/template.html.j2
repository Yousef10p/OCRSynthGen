<header>
<h1>{{ slot_0 }}</h1>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_2 }}</span>
<button>{{ slot_3 }}</button>
</form>
</header>
<main>
<article>
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<div class="placeholder ph"></div>
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
</article>
<article>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="placeholder ph"></div>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</article>
<article>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="placeholder ph"></div>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
</article>
</main>
</body>
</html>