    padding: 50px;
    color: white;
    background-color: #444;
}

.hero-header, .artist-image, .event-image, .hero-image {
    margin: 20px 0;
    height: 300px;
    background-color: #666;
}

main div {
    margin-bottom: 50px;
}

form {
    display: flex;
    flex-direction: column;
}

form input, form textarea, form button {
    margin-bottom: 20px;
    padding: 10px;
    font-size: 1em;
}

form button {
    background-color: #222;
    color: white;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
