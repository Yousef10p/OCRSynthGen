.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
}

header {
  background-color: lightblue;
  height: 100px;
}

#main-content {
  display: flex;
}

aside {
  width: 200px;
}

main {
  flex-grow: 1;
}

footer {
  position: fixed;
  bottom: 0;
  width: 100%;
  background-color: lightblue;
  height: 50px;
  line-height: 50px;
  text-align: center;
}


footer h3 {
  font-size: 0;
}

footer h3::before {
  content: "";
  font-size: 1rem;
}


.colored-rectangle {
  width: 100%;
  height: 150px;
  background-color: red;
}

@media screen and (max-width: 600px) {
  #main-content {
    flex-direction: column;
  }

  aside {
    width: 100%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
