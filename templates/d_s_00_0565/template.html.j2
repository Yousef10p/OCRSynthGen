<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 120.5mm; inline-size: 215.8mm; block-size: 44.0mm; font-size: 15.6pt"></div>
<div class="box ph" style="inset-inline-start: 15.6mm; inset-block-start: 226.8mm; inline-size: 35.6mm; block-size: 23.5mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 97.0mm; inset-block-start: 235.6mm; inline-size: 37.5mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 152.0mm; inset-block-start: 235.6mm; inline-size: 36.7mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 97.0mm; inset-block-start: 240.6mm; inline-size: 46.8mm; block-size: 23.0mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 152.0mm; inset-block-start: 240.6mm; inline-size: 34.3mm; block-size: 23.0mm; font-size: 13.0pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 16.8mm; inset-block-start: 273.2mm; inline-size: 121.8mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 152.2mm; inset-block-start: 272.8mm; inline-size: 45.8mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_5 }}</footer>
</div></body>
</html>
