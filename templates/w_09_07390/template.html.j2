  margin: 0;
  padding: 0;
}

main {
  width: 80%;
  margin: auto;
  position: relative;
  min-height: 100vh;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}

h1 {
  grid-column: 1 / span 2;
  text-align: center;
  font-size: 3em;
}

section {
  border: 1px solid #ddd;
  padding: 20px;
  margin: 20px;
  color: blue;
}

footer {
  background-color: #ddd;
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 2.5rem;
  color: green;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
