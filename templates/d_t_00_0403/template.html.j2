<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 40.5mm; inset-block-start: 56.4mm; inline-size: 35.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 60.5mm; inline-size: 133.3mm; block-size: 6.5mm; font-size: 9.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 71.8mm; inline-size: 139.8mm; block-size: 6.5mm; font-size: 9.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 83.1mm; inline-size: 139.0mm; block-size: 14.0mm; font-size: 9.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 102.0mm; inline-size: 138.6mm; block-size: 14.0mm; font-size: 9.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 120.8mm; inline-size: 86.8mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 40.5mm; inset-block-start: 132.9mm; inline-size: 44.8mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_6 }}</h2>
<h2 class="box" style="inset-inline-start: 40.5mm; inset-block-start: 137.0mm; inline-size: 42.4mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 141.8mm; inline-size: 138.1mm; block-size: 10.2mm; font-size: 9.7pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 40.5mm; inset-block-start: 156.9mm; inline-size: 41.9mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 40.5mm; inset-block-start: 161.7mm; inline-size: 136.5mm; block-size: 10.2mm; font-size: 9.7pt">{{ slot_10 }}</p>
</div></body>
</html>
