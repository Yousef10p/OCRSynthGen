<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    font-family: var(--font-body);
    color: white;
    background-color: #333;
}


#nav {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    height: 50px;
    background-color: #666;
    padding: 0 10px;
}
#nav ul {
    display: flex;
    justify-content: center;
    height: 100%;
    list-style: none;
}
#nav ul li {
    margin: 0 10px;
    line-height: 50px;
}
#nav ul li a {
    color: white;
    text-decoration: none;
}


#slider .slide {
    width: 100%;
    height: 250px;
    background-color: #999;
    text-align: center;
    line-height: 250px;
    font-size: 20px;
}


#content {
    padding: 20px 10px;
    text-align: center;
}
#content .product,
#content .blog {
    margin: 10px 0;
    padding: 50px;
    background-color: #666;
}


#footer {
    position: fixed;
    bottom: 0;
    right: 0;
    left: 0;
    height: 50px;
    background-color: #666;
    text-align: center;
    padding: 0 10px;
}
#footer ul {
    display: flex;
    justify-content: center;
    list-style: none;
    height: 100%;
}
#footer ul li {
    margin: 0 10px;
    line-height: 50px;
}
#footer ul li a {
    color: white;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="nav">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div id="slider">
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
</div>
<div id="content">
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
<div class="product">{{ slot_9 }}</div>
<div class="blog">{{ slot_10 }}</div>
<div class="blog">{{ slot_11 }}</div>
</div>
<div id="footer">
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</div>
</body>
</html>