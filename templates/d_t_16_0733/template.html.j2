<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 65.2mm; inset-block-start: 50.8mm; inline-size: 97.8mm; block-size: 46.7mm; font-size: 11.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 65.4mm; inset-block-start: 102.2mm; inline-size: 41.6mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 65.0mm; inset-block-start: 107.0mm; inline-size: 96.2mm; block-size: 19.0mm; font-size: 10.8pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 114.3mm; inset-block-start: 126.9mm; inline-size: 50.9mm; block-size: 54.5mm; font-size: 17.2pt"></div>
<h2 class="box" style="inset-inline-start: 65.1mm; inset-block-start: 130.8mm; inline-size: 41.1mm; block-size: 8.3mm; font-size: 11.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 65.0mm; inset-block-start: 140.4mm; inline-size: 47.8mm; block-size: 42.6mm; font-size: 11.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 65.1mm; inset-block-start: 187.7mm; inline-size: 41.4mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 64.9mm; inset-block-start: 192.4mm; inline-size: 96.9mm; block-size: 19.2mm; font-size: 10.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 64.9mm; inset-block-start: 216.3mm; inline-size: 97.9mm; block-size: 7.1mm; font-size: 10.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 113.5mm; inset-block-start: 227.9mm; inline-size: 2.7mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
