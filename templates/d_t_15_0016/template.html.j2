<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.5mm; inset-block-start: 15.4mm; inline-size: 85.8mm; block-size: 106.0mm; font-size: 27.3pt"></div>
<div class="box ph" style="inset-inline-start: 116.2mm; inset-block-start: 15.4mm; inline-size: 86.1mm; block-size: 62.4mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 80.4mm; inline-size: 30.1mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 90.0mm; inline-size: 86.9mm; block-size: 66.4mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 124.2mm; inline-size: 49.0mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 133.7mm; inline-size: 86.9mm; block-size: 12.3mm; font-size: 11.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 151.8mm; inline-size: 87.0mm; block-size: 43.9mm; font-size: 12.4pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 161.4mm; inline-size: 35.4mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 168.0mm; inline-size: 87.0mm; block-size: 34.8mm; font-size: 12.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 201.4mm; inline-size: 86.9mm; block-size: 16.8mm; font-size: 11.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 208.6mm; inline-size: 89.2mm; block-size: 30.3mm; font-size: 12.3pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 224.0mm; inline-size: 89.6mm; block-size: 30.3mm; font-size: 12.3pt">{{ slot_9 }}</p>
