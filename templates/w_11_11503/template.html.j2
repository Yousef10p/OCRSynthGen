<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: #fff;
}
.header {
    background: #004d99;
    padding: 10px;
    text-align: center;
}
.logo {
    background: #fff;
    height: 60px;
    width: 200px;
    display: inline-block;
}
nav ul {
    list-style: none;
}
nav ul li {
    display: inline;
    margin: 0 10px;
}
nav ul li a {
    color: #fff;
    text-decoration: none;
}
.sidebar {
    background: #003b73;
    width: 20%;
    float: right;
    padding: 10px;
}
.main {
    background: #00264d;
    width: 80%;
    float: left;
    padding: 10px;
}
.footer {
    background: #001326;
    clear: both;
    padding: 10px;
}
h1, h2 {
    color: #ff8c00;
}
p {
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</div>
<div class="sidebar">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="main">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
</div>
<div class="footer">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>