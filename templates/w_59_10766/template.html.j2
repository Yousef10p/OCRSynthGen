    display: inline;
    margin: 0 10px;
}

header nav ul li a {
    color: #fff;
    text-decoration: none;
}


main {
    padding: 80px 20px;
}

main section {
    margin: 20px 0;
}

main section h1 {
    font-size: 2em;
}

.image-placeholder {
    width: 100%;
    height: 200px;
    background-color: #999;
}


footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    padding: 20px;
    background-color: #333;
    color: #fff;
}

footer ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
}

footer ul li {
    margin: 5px 0;
}

footer ul li a {
    color: #fff;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
