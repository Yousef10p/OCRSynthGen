<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 77.6mm; inset-block-start: 36.8mm; inline-size: 60.5mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 38.3mm; inset-block-start: 48.1mm; inline-size: 136.5mm; block-size: 10.1mm; font-size: 10.9pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 91.0mm; inset-block-start: 68.2mm; inline-size: 33.8mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 38.3mm; inset-block-start: 74.8mm; inline-size: 86.0mm; block-size: 3.5mm; font-size: 10.6pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 94.3mm; inset-block-start: 88.1mm; inline-size: 27.1mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 37.8mm; inset-block-start: 94.8mm; inline-size: 138.8mm; block-size: 30.2mm; font-size: 10.9pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 98.2mm; inset-block-start: 134.9mm; inline-size: 19.8mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 37.9mm; inset-block-start: 141.6mm; inline-size: 139.5mm; block-size: 83.6mm; font-size: 10.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 38.0mm; inset-block-start: 228.3mm; inline-size: 139.3mm; block-size: 30.3mm; font-size: 10.9pt">{{ slot_8 }}</p>
</div></body>
</html>
