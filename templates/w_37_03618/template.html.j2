.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: #333;
}

h1, h2, h3 {
    color: #666;
}

a {
    color: #0055aa;
