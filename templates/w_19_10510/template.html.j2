<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  background-color: pink;
  color: purple;
  font-family: var(--font-body);
}

nav ul {
  display: flex;
  justify-content: space-around;
  list-style: none;
  padding: 1em 0;
  border-bottom: 1px solid purple;
}

nav a {
  text-decoration: none;
  color: purple;
}

form {
  display: flex;
  justify-content: center;
  margin: 1em 0;
}

input[type="text"] {
  padding: 1em;
  border: 2px solid purple;
  border-left: none;
  width: 70%;
}

button {
  padding: 1em;
  border: 2px solid purple;
  background-color: purple;
  color: pink;
  border-right: none;
}

footer {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid purple;
  margin-top: 2em;
  padding: 1em 0;
}

footer ul {
  list-style: none;
  padding: 0;
}

footer a {
  text-decoration: none;
  color: purple;
}


img {
  width: 100px;
  height: 100px;
  background-color: purple;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>

<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<button>{{ slot_4 }}</button>
</form>

<section>
<div>

<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_5 }}</p>
</div>

</section>

<footer>
<p>{{ slot_6 }}</p>

<p><span>{{ slot_7 }}</span> {{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>