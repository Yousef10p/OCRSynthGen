}

.hero {
  background-color: #ccc;
  height: 200px;
  margin-bottom: 20px;
}

nav ul {
  display: flex;
  justify-content: space-between;
  list-style: none;
  padding: 0;
}

nav ul a {
  color: #000;
  text-decoration: none;
}

article h2, aside h2 {
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
