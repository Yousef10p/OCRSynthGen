<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    justify-content: space-between;
    padding: 20px;
    font-family: var(--font-body);
}

.left-column {
    width: 30%;
    position: fixed;
    top: 0;
    right: 0;
}

.search-bar {
    width: 100%;
    height: 30px;
} 

.categories li, .recent-arrivals li {
    list-style-type: none;
}

.right-column {
    width: 60%;
    margin-right: 32%;
}

.product-image {
    height: 200px;
    width: 100%;
    background-color: red;
    margin-bottom: 20px;
}

.product-description, .pricing-information, .payment-options {
    color: gray;
}

.footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    text-align: center;
    padding: 20px;
    background-color: lightgrey;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="left-column">
<span class="search-bar" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<h2>{{ slot_1 }}</h2>
<ul class="categories">
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
<h2>{{ slot_5 }}</h2>
<ul class="recent-arrivals">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</div>
<div class="right-column">
<div class="product-image ph"></div>
<h2>{{ slot_8 }}</h2>
<p class="product-description">{{ slot_9 }}</p>
<h2>{{ slot_10 }}</h2>
<p class="pricing-information">{{ slot_11 }}</p>
</div>
<div class="footer">
<h2>{{ slot_12 }}</h2>
<h2>{{ slot_13 }}</h2>
<p class="payment-options">{{ slot_14 }}</p>
</div>
</body>
</html>