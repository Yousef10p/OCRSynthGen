<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}
.slideshow {
  height: 200px;
  transition: right 2s;
  position: relative;
  right: 0;
  overflow: hidden;
}
.slide {
  height: 200px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3em;
  position: absolute;
}
.collection-grid {
  margin: 20px;
  display: grid;
  grid-template-columns: auto auto;
  grid-gap: 20px;
}
.item-img {
  height: 200px;
  width: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5em;
}
p {
  margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="slideshow">
<div class="slide" style="background-color: yellow;">
        {{ slot_0 }}
      </div>
<div class="slide" style="background-color: blue;">
        {{ slot_1 }}
      </div>
<div class="slide" style="background-color: red;">
        {{ slot_2 }}
      </div>
</div>
<div class="collection-grid">
<div class="item1">
<div class="item-img" style="background-color: pink;">
          {{ slot_3 }}
        </div>
<p>
          {{ slot_4 }}
        </p>
</div>
