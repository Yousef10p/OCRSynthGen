<p class="box" style="inset-inline-start: 29.3mm; inset-block-start: 93.2mm; inline-size: 44.2mm; block-size: 49.9mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 29.3mm; inset-block-start: 144.0mm; inline-size: 45.3mm; block-size: 32.9mm; font-size: 11.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 151.4mm; inline-size: 84.8mm; block-size: 8.9mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 161.2mm; inline-size: 88.7mm; block-size: 28.7mm; font-size: 13.6pt">{{ slot_6 }}</p>
