body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    height: 100vh;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
    "header"
    "main"
    "footer";
}

header {
    grid-area: header;
    background-color: #f9f9f9;
    padding: 1em;
    text-align: center;
}

main {
    grid-area: main;
    padding: 1em;
}

footer {
    grid-area: footer;
    background-color: #333;
    color: white;
    text-align: center;
    padding: 1em;
}

.header-image, .section-image, .footer-image {
    
    background-color: #ddd;
    margin: 1em 0;
    height: 5em;
    display: flex;
    justify-content: center;
    align-items: center;
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-between;
}

section {
    margin-bottom: 1em;
    border-bottom: 1px solid #ddd;
}

footer p {
    margin: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
