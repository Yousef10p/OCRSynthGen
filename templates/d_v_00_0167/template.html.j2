<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 147.3mm; inline-size: 81.9mm; block-size: 27.6mm; font-size: 13.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 147.3mm; inline-size: 81.9mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 161.5mm; inline-size: 83.9mm; block-size: 37.2mm; font-size: 13.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 180.6mm; inline-size: 83.7mm; block-size: 46.7mm; font-size: 13.2pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 114.3mm; inset-block-start: 208.8mm; inline-size: 52.5mm; block-size: 19.1mm; font-size: 13.5pt"></div>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 233.0mm; inline-size: 83.1mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 237.8mm; inline-size: 33.1mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 196.5mm; inset-block-start: 283.9mm; inline-size: 2.8mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
