}

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}

nav li {
    float: right;
}

nav li a, nav li ul {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

nav li ul {
    display: none;
    position: absolute;
    min-width: 100%;
    background-color: #f9f9f9;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
}

nav li ul li a {
    display: block;
    color: black;
}

header {
    background-color: #333;
    color: white;
    padding: 50px;
    text-align: center;
}

section {
    margin-bottom: 20px;
}

a {
    color: #333;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
