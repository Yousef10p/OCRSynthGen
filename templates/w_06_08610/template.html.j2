    align-items: center;
}

#product-pages, #collection-pages, #sale-pages {
    min-height: 300px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

.product, .collection, .sale-product {
    background-color: #ccc;
    padding: 20px;
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
