<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

body {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: #333;
}

header {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    background-color: #f4f4f4;
    padding: 10px 0;
    box-shadow: 0px 2px 24px 0px rgba(0,0,0,0.15);
}

nav ul {
    text-align: center;
    padding: 15px 0;
}

nav li {
    display: inline;
    margin: 0 15px;
}

nav a {
    text-decoration: none;
    color: #333;
    transition: color 0.3s ease;
}

nav a:hover {
    color: #666;
}

#banner {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3em;
    color: white;
    background-color: #333;
}

#destinations, #travel_packages {
    margin: 20px 0;
}

.col {
    
    height: 200px;
    width: 300px;
    margin: 15px;
    color: white;
    display: inline-block;
}

#contact {
    text-align: center;
    padding: 20px 0;
    font-size: 1.1em;
    color: #333;
    background-color: #f4f4f4;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    background-color: #f4f4f4;
    padding: 10px 0;
    text-align: center;
}

footer p {
    margin: 5px 0;
    font-size: 0.9em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
