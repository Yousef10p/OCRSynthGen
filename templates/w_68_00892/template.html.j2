body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

#nav {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 200px;
    background: #333;
    color: #fff;
    padding: 50px 20px 0 0;
}

#nav ul {
    list-style-type: none;
    padding: 0;
}

#nav ul li a {
    color: #fff;
    text-decoration: none;
}

#hero {
    height: 100vh;
    background-color: #f1f1f1;
    padding: 50px;
    margin-right: 200px;
}

#hero input {
    width: 100%;
    height: 30px;
    margin-bottom: 50px;
}

#listing {
    margin: 0 220px 0 0;
}

.hotel {
    float: right;
    width: 30%;
    margin: 0 1.66%;
    padding: 20px;
    background-color: #dfdfdf;
    border-radius: 5px;
    margin-bottom: 20px;
}

.hotel h2 {
    margin-top: 0;
}

.imgPlaceholder {
    width: 100%;
    height: 200px;
    background-color: #555;
    margin-bottom: 20px;
}

button {
    padding: 10px 20px;
    background-color: #0066cc;
    color: #fff;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
