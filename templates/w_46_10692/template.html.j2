}
#categories, #featured {
    width: 50%;
    padding: 1em;
}
#categories {
    background: #FF69B4;
}
#featured {
    background: #FF1493;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
