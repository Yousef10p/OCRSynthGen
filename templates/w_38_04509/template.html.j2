.ph { background: #d0d0d0; }

body, html { height: 100%; font-family: var(--font-body); margin: 0; padding: 0; }

.container { width: 100%; box-sizing: border-box; padding: 0 20px; }
header { background-color: #f0f0f0; padding: 10px 0; }
nav ul { list-style-type: none; padding: 0; }
