<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 31.3mm; inset-block-start: 14.9mm; inline-size: 46.7mm; block-size: 57.5mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 75.5mm; inline-size: 169.8mm; block-size: 9.6mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 90.1mm; inline-size: 163.2mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 31.8mm; inset-block-start: 95.1mm; inline-size: 49.6mm; block-size: 25.9mm; font-size: 12.0pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 131.4mm; inline-size: 24.1mm; block-size: 5.0mm; font-size: 14.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 138.4mm; inline-size: 173.5mm; block-size: 9.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 153.0mm; inline-size: 171.4mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 31.1mm; inset-block-start: 157.8mm; inline-size: 108.8mm; block-size: 32.9mm; font-size: 12.0pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 194.2mm; inline-size: 41.6mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 201.3mm; inline-size: 42.9mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 206.1mm; inline-size: 97.9mm; block-size: 4.7mm; font-size: 12.0pt"><li>{{ slot_7 }}</li></ul>
<div class="box ph" style="inset-inline-start: 31.1mm; inset-block-start: 220.6mm; inline-size: 67.1mm; block-size: 23.9mm; font-size: 13.6pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 249.5mm; inline-size: 62.8mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 198.3mm; inset-block-start: 259.5mm; inline-size: 6.2mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
