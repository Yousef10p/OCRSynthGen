<ul class="box" style="inset-inline-start: 64.6mm; inset-block-start: 118.1mm; inline-size: 51.0mm; block-size: 3.4mm; font-size: 9.7pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 64.6mm; inset-block-start: 124.3mm; inline-size: 107.4mm; block-size: 3.4mm; font-size: 9.7pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 64.6mm; inset-block-start: 132.2mm; inline-size: 126.3mm; block-size: 17.3mm; font-size: 12.2pt">{{ slot_6 }}</p>
