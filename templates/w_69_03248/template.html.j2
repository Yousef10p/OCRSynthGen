<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    font-size: 14px;
    margin: 0;
    padding: 0;
}

header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: lightgrey;
    min-height: 100vh;
}

#hero {
    height: 60vh;
    width: 100%;
    background-color: red;
}

#logo {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    height: 150px;
    width: 150px;
    background-color: blue;
}

nav {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: darkgrey;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

nav li {
    list-style-type: none;
}

main {
    margin: 10px;
}

footer {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: lightgrey;
    min-height: 100vh;
}

#footer-content {
    text-align: center;
}

#social-icons {
    display: flex;
    justify-content: space-around;
    width: 100%;
}

@media (max-width: 768px) {
    #logo, #hero {
        width: 100%;
    }
    main, footer {
        width: 90%;
    }
    nav, #footer-content, #social-icons {
        width: 100%;
    }
}

@media (max-width: 480px) {
    main, footer {
        width: 95%;
    }
    nav, #footer-content, #social-icons {
        width: 95%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
