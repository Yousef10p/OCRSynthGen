<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 85.7mm; inset-block-start: 8.5mm; inline-size: 46.9mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 102.1mm; inset-block-start: 30.0mm; inline-size: 39.7mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 34.0mm; inline-size: 87.1mm; block-size: 37.3mm; font-size: 9.6pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 18.2mm; inset-block-start: 125.9mm; inline-size: 177.9mm; block-size: 27.3mm; font-size: 40.0pt">{{ slot_3 }}</h2>
<div class="box ph" style="inset-inline-start: 24.1mm; inset-block-start: 157.2mm; inline-size: 40.8mm; block-size: 60.4mm; font-size: 15.6pt"></div>
<h2 class="box" style="inset-inline-start: 80.5mm; inset-block-start: 157.6mm; inline-size: 40.5mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 80.5mm; inset-block-start: 161.6mm; inline-size: 82.5mm; block-size: 37.3mm; font-size: 10.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 218.5mm; inline-size: 40.2mm; block-size: 37.5mm; font-size: 10.6pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 200.4mm; inset-block-start: 271.2mm; inline-size: 3.4mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_7 }}</footer>
</div></body>
</html>
