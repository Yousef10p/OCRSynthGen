<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.2mm; inset-block-start: 29.2mm; inline-size: 120.5mm; block-size: 3.5mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 75.3mm; inline-size: 22.0mm; block-size: 3.5mm; font-size: 11.1pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 87.2mm; inline-size: 42.3mm; block-size: 3.1mm; font-size: 9.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 102.3mm; inline-size: 152.5mm; block-size: 42.4mm; font-size: 11.2pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 156.7mm; inline-size: 49.4mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 172.1mm; inline-size: 160.5mm; block-size: 50.1mm; font-size: 11.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 234.2mm; inline-size: 160.2mm; block-size: 11.4mm; font-size: 11.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.3mm; inset-block-start: 258.2mm; inline-size: 160.2mm; block-size: 10.6mm; font-size: 8.6pt">{{ slot_7 }}</p>
</div></body>
</html>
