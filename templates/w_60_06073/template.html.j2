<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background-color: #f4f4f4;
  line-height: 1.6em;
}

.container {
  width: 80%;
  margin: auto;
  overflow: hidden;
}

.header {
  background: #333;
  color: white;
  padding-top: 20px;
  min-height: 70px;
  border-bottom: #e8491d 3px solid;
}

.header h1 {
  float: right;
  margin: 0;
  padding: 0;
}

.header nav ul {
  float: left;
  margin: 0;
  padding: 0;
}

.header nav ul li {
  display: inline;
  margin: 0 10px;
}

.content {
  display: flex;
  height: 70%;
}

.image {
  width: 70%;
  background: none no-repeat;
  background-position: center left;
  background-size: cover;
  float: right;
}

.image-rect {
  width: 100%;
  height: 300px;
  background: #333;
  float: right;
}

.info {
  margin-top: 10px;
}

.info h2, .info p {
  margin: 0;
}

.sidebar {
  float: left;
  width: 30%;
  background: #e8491d;
  padding: 10px;
  color: white;
}

.sidebar h2, .sidebar h3, .sidebar p {
  margin: 0;
}

.logo {
  height: 50px;
  width: 50px;
  background: #333;
  margin-bottom: 10px;
}

.main {
  width: 70%;
  float: right;
  padding: 0 25px;
}

.class-schedule, .blog-posts {
  margin-top: 10px;
}

.footer {
  background: #333;
  color: white;
  text-align: center;
  padding: 10px;
  margin-top: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
