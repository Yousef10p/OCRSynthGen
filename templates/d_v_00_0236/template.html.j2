<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 8.4mm; inset-block-start: 8.4mm; inline-size: 179.3mm; block-size: 197.7mm; font-size: 5.5pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 5.8mm; inset-block-start: 220.0mm; inline-size: 26.0mm; block-size: 25.7mm; font-size: 14.6pt"></div>
<h2 class="box" style="inset-inline-start: 8.4mm; inset-block-start: 249.0mm; inline-size: 14.3mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 8.4mm; inset-block-start: 251.9mm; inline-size: 26.8mm; block-size: 37.2mm; font-size: 8.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 69.2mm; inset-block-start: 252.0mm; inline-size: 26.8mm; block-size: 37.2mm; font-size: 8.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 160.3mm; inset-block-start: 254.9mm; inline-size: 25.5mm; block-size: 34.3mm; font-size: 8.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 99.5mm; inset-block-start: 257.8mm; inline-size: 26.6mm; block-size: 31.3mm; font-size: 8.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 129.9mm; inset-block-start: 260.7mm; inline-size: 26.8mm; block-size: 28.4mm; font-size: 8.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 38.8mm; inset-block-start: 266.5mm; inline-size: 26.8mm; block-size: 22.6mm; font-size: 8.0pt">{{ slot_7 }}</p>
</div></body>
</html>
