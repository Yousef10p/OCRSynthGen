<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="hero">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
</div>
<div class="content">
<div class="col">
<h3>{{ slot_6 }}</h3>
<p>{{ slot_7 }}</p>
</div>
