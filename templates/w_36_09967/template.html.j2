<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
</div>
<div class="col">
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>
</div>
<div class="testimonials">
<h2>{{ slot_12 }}</h2>
<div class="grid-container">
<div class="grid-item">{{ slot_13 }}</div>
<div class="grid-item">{{ slot_14 }}</div>
<div class="grid-item">{{ slot_15 }}</div>
<div class="grid-item">{{ slot_16 }}</div>
<div class="grid-item">{{ slot_17 }}</div>
