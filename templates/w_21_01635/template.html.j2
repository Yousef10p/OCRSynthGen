    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.logo {
    font-size: 2em;
}

nav ul {
    display: flex;
    list-style-type: none;
    padding: 0;
}

nav ul li {
    margin: 0 1em;
}

a {
    color: inherit;
    text-decoration: none;
}

main {
    display: grid;
}

main section {
    display: grid;
    gap: 1em;
}

.img {
    background-color: #999;
    height: 100px;
}

footer {
