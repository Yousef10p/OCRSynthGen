    color: #fff;
}

.contact-form form {
    display: grid;
    gap: 1em;
}

.contact-form input, .contact-form textarea, .contact-form button {
    padding: 0.5em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
