#services { background-color: #FF8700; }
#case-studies { background-color: #FF9E00; }
#blog { background-color: #FFB300; }
#testimonials { background-color: #FFBA00; }
#contact { background-color: #FFC900; }

footer { position: absolute; bottom: 0; right: 0; width: 100%; height: 50px; padding: 10px; background-color: #FF5733; color: #FFF; text-align: center; }
#footer-logo, #links { margin: 5px; }
#links a { margin: 0 10px; color: #FFF; text-decoration: none; }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
