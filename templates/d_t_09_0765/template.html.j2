<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 33.7mm; inset-block-start: 41.6mm; inline-size: 148.6mm; block-size: 15.3mm; font-size: 20.7pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 63.7mm; inline-size: 158.3mm; block-size: 5.3mm; font-size: 12.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 78.8mm; inset-block-start: 74.9mm; inline-size: 58.3mm; block-size: 4.5mm; font-size: 10.0pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 77.4mm; inline-size: 6.3mm; block-size: 121.9mm; font-size: 20.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 60.9mm; inset-block-start: 81.2mm; inline-size: 94.0mm; block-size: 4.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 35.7mm; inset-block-start: 100.9mm; inline-size: 144.5mm; block-size: 145.8mm; font-size: 10.9pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 106.9mm; inset-block-start: 261.6mm; inline-size: 2.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
