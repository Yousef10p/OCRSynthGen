<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 30.8mm; inset-block-start: 26.3mm; inline-size: 28.2mm; block-size: 3.5mm; font-size: 10.9pt"><li>{{ slot_0 }}</li></ul>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 38.1mm; inline-size: 150.0mm; block-size: 11.6mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 74.1mm; inset-block-start: 54.3mm; inline-size: 101.3mm; block-size: 15.9mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 71.4mm; inline-size: 150.0mm; block-size: 27.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 57.7mm; inset-block-start: 102.9mm; inline-size: 117.8mm; block-size: 17.2mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 104.2mm; inset-block-start: 127.5mm; inline-size: 59.2mm; block-size: 46.3mm; font-size: 7.6pt"></div>
<div class="box ph" style="inset-inline-start: 37.0mm; inset-block-start: 130.1mm; inline-size: 66.1mm; block-size: 40.2mm; font-size: 10.3pt"></div>
<p class="box" style="inset-inline-start: 68.2mm; inset-block-start: 178.3mm; inline-size: 4.5mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 131.5mm; inset-block-start: 178.3mm; inline-size: 4.7mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 192.0mm; inline-size: 150.0mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 209.3mm; inline-size: 49.9mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</p>
