}

#featured h2 {
    font-size: 24px;
    margin-bottom: 20px;
}

.listing {
    margin-bottom: 50px;
    display: flex;
}

.listing-img {
    width: 300px;
    height: 200px;
    background-color: grey;
    margin-left: 20px;
}

footer {
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    text-align: center;
    padding: 20px;
    position: fixed;
    width: 100%;
    bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
