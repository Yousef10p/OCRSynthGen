<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 88.4mm; inline-size: 90.4mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 97.0mm; inline-size: 57.0mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 103.1mm; inline-size: 160.4mm; block-size: 12.8mm; font-size: 10.0pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 120.2mm; inline-size: 154.1mm; block-size: 17.1mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 137.4mm; inline-size: 154.1mm; block-size: 25.7mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
