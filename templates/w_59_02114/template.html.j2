    width: 70%;
    height: 30px;
    padding: 0 5px;
}
#featured-music {
    background-color: #00ff00;
    color: #ffffff;
    padding: 20px;
}
#featured-albums {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
}
#featured-albums .album {
    width: 30%;
    height: 150px;
    margin: 10px 0;
    background-color: #ff00ff;
    line-height: 150px;
    text-align: center;
}
aside {
    background-color: #ffff00;
    padding: 20px;
}
#social-media {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
}
#social-media a {
    width: 40%;
    height: 50px;
    line-height: 50px;
    text-align: center;
    background-color: #00ffff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
