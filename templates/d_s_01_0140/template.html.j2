<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 101.5mm; inset-block-start: 13.9mm; inline-size: 95.3mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 22.0mm; inset-block-start: 26.8mm; inline-size: 256.7mm; block-size: 14.1mm; font-size: 13.4pt"></div>
<div class="box ph" style="inset-inline-start: 22.2mm; inset-block-start: 48.4mm; inline-size: 256.7mm; block-size: 103.8mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 22.4mm; inset-block-start: 155.7mm; inline-size: 149.1mm; block-size: 27.9mm; font-size: 26.3pt"></div>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 194.1mm; inline-size: 49.6mm; block-size: 7.7mm; font-size: 10.9pt">{{ slot_1 }}</footer><footer class="box" style="inset-inline-start: 253.2mm; inset-block-start: 193.6mm; inline-size: 14.7mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_2 }}</footer>
</div></body>
</html>
