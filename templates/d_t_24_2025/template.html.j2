<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 279.4mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 256.5mm; inset-block-start: 26.0mm; inline-size: 9.0mm; block-size: 34.2mm; font-size: 9.7pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 127.9mm; inset-block-start: 39.3mm; inline-size: 12.1mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 87.9mm; inset-block-start: 47.9mm; inline-size: 90.1mm; block-size: 122.4mm; font-size: 23.1pt"></div>
<header class="box" style="inset-inline-start: 255.8mm; inset-block-start: 71.8mm; inline-size: 4.5mm; block-size: 22.7mm; font-size: 9.2pt">{{ slot_2 }}</header><header class="box" style="inset-inline-start: 256.6mm; inset-block-start: 105.7mm; inline-size: 3.7mm; block-size: 24.0mm; font-size: 8.5pt">{{ slot_3 }}</header><header class="box" style="inset-inline-start: 255.8mm; inset-block-start: 150.8mm; inline-size: 6.6mm; block-size: 37.9mm; font-size: 11.9pt">{{ slot_4 }}</header>
</div></body>
</html>
