<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

a {
    text-decoration: none;
}


.logo {
    width: 100px;
    height: 100px;
    background-color: black;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: lightgray;
}

header ul {
    display: flex;
    list-style: none;
}

header ul li {
    margin: 0 10px;
}

header ul li:hover {
    background-color: gray;
}

header ul ul {
    display: none;
    position: absolute;
    background-color: gray;
}

header ul li:hover > ul {
    display: block;
}

.hero {
    display: flex;
    background-color: lightgray;
    padding: 40px;
}

.hero-image {
    width: 50%;
    height: 200px;
    background-color: gray;
}

.hero-text {
    width: 50%;
    margin-right: 20px;
    padding: 10px;
    background-color: white;
}

.content {
    padding: 20px;
    color: black;
}

footer {
    display: flex;
    justify-content: space-between;
    padding: 20px;
    background-color: black;
    color: white;
}

@media (max-width: 960px) {
    .hero {
        flex-direction: column;
    }

    .hero-image {
        display: none;
    }

    .hero-text {
        width: 100%;
        margin-right: 0;
        margin-top: 20px;
    }

    header ul li {
        display: none;
    }

    header ul li:hover > ul {
        display: flex;
        position: relative;
    }

    header ul li:hover > ul li {
        width: 100%;
        text-align: center;
        padding: 10px 0;
    }

    footer {
        flex-direction: column;
    }

    footer a {
        margin: 10px 0;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
