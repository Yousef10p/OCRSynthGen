<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
</header>
<main>
<section class="hero">
<div class="hero-image ph"></div>
<div class="hero-text">
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
</div>
</section>
<section class="content">
