    background-color: #f0f0f0;
}
.right {
    background-color: #e0e0e0;
}
.video-container {
    flex: 2;
    padding: 20px;
    background-color: #d0d0d0;
}
.video, .testimonial {
    height: 200px;
    background-color: #c0c0c0;
}
.contact, .chatbot {
    margin-top: 20px;
    padding: 10px;
    background-color: #a0a0a0;
    border: none;
    cursor: pointer;
}
.blog-posts {
    list-style: none;
    padding: 0;
}
.blog-posts li {
    border-bottom: 1px solid #000;
    padding: 5px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
