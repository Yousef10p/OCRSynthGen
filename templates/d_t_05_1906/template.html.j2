<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 14.8mm; inset-block-start: 14.3mm; inline-size: 127.5mm; block-size: 6.1mm; font-size: 17.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 14.8mm; inset-block-start: 26.9mm; inline-size: 85.5mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 26.9mm; inline-size: 85.0mm; block-size: 15.3mm; font-size: 8.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 14.8mm; inset-block-start: 34.7mm; inline-size: 88.4mm; block-size: 135.6mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 42.4mm; inline-size: 85.4mm; block-size: 11.4mm; font-size: 6.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 54.1mm; inline-size: 88.3mm; block-size: 65.7mm; font-size: 9.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 120.0mm; inline-size: 87.9mm; block-size: 23.0mm; font-size: 9.3pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 108.0mm; inset-block-start: 153.5mm; inline-size: 72.9mm; block-size: 8.4mm; font-size: 11.9pt"></div>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 162.8mm; inline-size: 26.5mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 12.7mm; inset-block-start: 268.8mm; inline-size: 2.2mm; block-size: 2.4mm; font-size: 6.9pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 135.3mm; inset-block-start: 268.8mm; inline-size: 63.6mm; block-size: 2.4mm; font-size: 6.9pt">{{ slot_9 }}</footer>
</div></body>
</html>
