<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 124.8mm; inline-size: 164.5mm; block-size: 11.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 139.5mm; inline-size: 164.5mm; block-size: 48.5mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 191.2mm; inline-size: 164.5mm; block-size: 33.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 75.9mm; inset-block-start: 231.7mm; inline-size: 114.0mm; block-size: 5.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 243.9mm; inline-size: 43.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
