<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 34.4mm; inline-size: 138.0mm; block-size: 21.7mm; font-size: 12.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 59.9mm; inline-size: 142.0mm; block-size: 26.3mm; font-size: 12.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 89.9mm; inline-size: 142.1mm; block-size: 40.0mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 133.7mm; inline-size: 134.4mm; block-size: 49.2mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 186.7mm; inline-size: 130.6mm; block-size: 21.7mm; font-size: 12.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 212.2mm; inline-size: 133.3mm; block-size: 21.7mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 45.0mm; inset-block-start: 239.7mm; inline-size: 13.4mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 46.1mm; inset-block-start: 244.0mm; inline-size: 40.0mm; block-size: 11.2mm; font-size: 15.9pt"></div>
<p class="box" style="inset-inline-start: 45.0mm; inset-block-start: 256.9mm; inline-size: 51.3mm; block-size: 7.0mm; font-size: 9.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 208.6mm; inset-block-start: 267.6mm; inline-size: 1.7mm; block-size: 1.9mm; font-size: 5.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
