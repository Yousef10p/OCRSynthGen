<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 57.6mm; inset-block-start: 25.5mm; inline-size: 126.9mm; block-size: 60.6mm; font-size: 15.6pt"></div>
<p class="box" style="inset-inline-start: 56.9mm; inset-block-start: 91.0mm; inline-size: 95.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 57.0mm; inset-block-start: 98.3mm; inline-size: 129.8mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 41.2mm; inset-block-start: 111.0mm; inline-size: 109.2mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 57.0mm; inset-block-start: 117.3mm; inline-size: 126.4mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 57.0mm; inset-block-start: 128.9mm; inline-size: 25.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 57.0mm; inset-block-start: 133.2mm; inline-size: 117.4mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 57.0mm; inset-block-start: 142.7mm; inline-size: 100.2mm; block-size: 3.6mm; font-size: 10.1pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 57.0mm; inset-block-start: 147.9mm; inline-size: 93.1mm; block-size: 3.6mm; font-size: 10.1pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 57.0mm; inset-block-start: 153.2mm; inline-size: 132.7mm; block-size: 20.5mm; font-size: 11.6pt"><li>{{ slot_8 }}</li></ul>
<p class="box" style="inset-inline-start: 75.7mm; inset-block-start: 176.7mm; inline-size: 109.8mm; block-size: 76.1mm; font-size: 9.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 21.1mm; inset-block-start: 264.0mm; inline-size: 57.9mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_10 }}</footer>
</div></body>
</html>
