<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div class="image-container ph"></div>
<div class="columns">
<div class="col">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<a>{{ slot_9 }}</a>
</div>
<div class="col">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<a>{{ slot_12 }}</a>
</div>
<div class="col">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<a>{{ slot_15 }}</a>
</div>
</div>
</body>
</html>