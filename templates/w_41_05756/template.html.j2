<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

#header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #333;
    padding: 10px;
}

#logo {
    width: 50px;
    height: 50px;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin-left: 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

#bg {
    width: 100%;
    height: 300px;
    background-image: none;
    background-size: cover;
}

#content {
    text-align: center;
    padding: 20px;
}

input {
    margin: 20px 0;
    padding: 10px;
}

.song, .playlist {
    background-color: #ddd;
    margin-bottom: 10px;
    padding: 10px;
}

button {
    margin: 10px;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</div>
<div id="bg"></div>
<div id="content">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<h1>{{ slot_5 }}</h1>
<div class="song">{{ slot_6 }}</div>
<div class="song">{{ slot_7 }}</div>
<div class="song">{{ slot_8 }}</div>
<h1>{{ slot_9 }}</h1>
<div class="playlist">{{ slot_10 }}</div>
<div class="playlist">{{ slot_11 }}</div>
<div class="playlist">{{ slot_12 }}</div>
<button>{{ slot_13 }}</button>
<button>{{ slot_14 }}</button>
</div>
</body>
</html>