<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
	box-sizing: border-box;
}
body, html {
	margin: 0;
	padding: 0;
	background-color: #f4f4f4;
	font-family: var(--font-body);
}

header {
	background-color: #333;
	color: white;
	text-align: center;
	padding: 20px;
}

header h1 {
	margin: 0;
}

nav {
	background-color: #ddd;
}

nav > ul {
	list-style-type: none;
	padding: 0;
	display: flex;
	justify-content: space-around;
}
nav > ul > li > a {
	color: black;
	text-decoration: none;
	padding: 20px;
	display: block;
}

main {
	margin: 10px;
	display: flex;
	flex-wrap: wrap;
}

.product {
	width: calc(33.3% - 20px);
	background-color: white;
	box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
	margin: 10px;
	padding: 10px;
}

.product > .product-img {
	height: 200px;
	background-color: #4caf50;
	margin-bottom: 10px;
}

@media screen and (max-width: 768px) {
	.product {
		width: calc(50% - 20px);
	}
}

@media screen and (max-width: 480px) {
	.product {
		width: 100%;
	}
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<main>
<div class="product">
<p>{{ slot_6 }}</p>
<div class="product-img ph"></div>
<p>{{ slot_7 }}</p>
<p>{{ slot_8 }}</p>
</div>
<div class="product">
<p>{{ slot_9 }}</p>
<div class="product-img ph"></div>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</div>
<div class="product">
<p>{{ slot_12 }}</p>
<div class="product-img ph"></div>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</main>
</body>
</html>