}


.product-display {
    display: flex;
    justify-content: space-between;
}

.product-display div {
    text-align: center;
    border: 1px solid black;
}

.product-display div div {
    width: 200px;
    height: 200px;
    background-color: grey;
}


footer {
    margin-top: 50px;
    display: flex;
    justify-content: space-around;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
