<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 36.3mm; inset-block-start: 25.5mm; inline-size: 62.8mm; block-size: 46.0mm; font-size: 7.7pt"></div>
<div class="box ph" style="inset-inline-start: 99.7mm; inset-block-start: 25.5mm; inline-size: 65.8mm; block-size: 46.2mm; font-size: 7.9pt"></div>
<ul class="box" style="inset-inline-start: 65.1mm; inset-block-start: 76.4mm; inline-size: 4.5mm; block-size: 3.5mm; font-size: 10.0pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 130.0mm; inset-block-start: 76.4mm; inline-size: 4.7mm; block-size: 3.5mm; font-size: 10.0pt"><li>{{ slot_1 }}</li></ul>
<div class="box ph" style="inset-inline-start: 33.5mm; inset-block-start: 88.5mm; inline-size: 66.2mm; block-size: 46.6mm; font-size: 7.8pt"></div>
<div class="box ph" style="inset-inline-start: 100.5mm; inset-block-start: 88.5mm; inline-size: 67.2mm; block-size: 46.8mm; font-size: 8.1pt"></div>
<ul class="box" style="inset-inline-start: 64.2mm; inset-block-start: 139.8mm; inline-size: 4.3mm; block-size: 3.5mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 131.7mm; inset-block-start: 139.8mm; inline-size: 4.7mm; block-size: 3.5mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 148.9mm; inline-size: 150.0mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 30.8mm; inset-block-start: 169.0mm; inline-size: 37.6mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 180.9mm; inline-size: 150.0mm; block-size: 41.1mm; font-size: 12.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 96.3mm; inset-block-start: 229.8mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
