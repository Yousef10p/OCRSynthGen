<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</header>
<div class="parallax">
<section id="hero">
<h1>{{ slot_3 }}</h1>
<p>{{ slot_4 }}</p>
</section>
<section class="info" id="products">
<h2>{{ slot_5 }}</h2>
<div class="product">
<div class="img">{{ slot_6 }}</div>
<p>{{ slot_7 }}</p>
</div>
<div class="product">
<div class="img">{{ slot_8 }}</div>
<p>{{ slot_9 }}</p>
</div>
</section>
<section class="info" id="services">
<h2>{{ slot_10 }}</h2>
<div class="service">
<div class="img">{{ slot_11 }}</div>
<p>{{ slot_12 }}</p>
</div>
<div class="service">
<div class="img">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
</div>
</section>
</div>
</body>
</html>