<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 69.1mm; inset-block-start: 7.0mm; inline-size: 9.8mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 21.7mm; inset-block-start: 15.2mm; inline-size: 80.7mm; block-size: 96.6mm; font-size: 13.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 18.0mm; inset-block-start: 112.7mm; inline-size: 3.2mm; block-size: 5.6mm; font-size: 15.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 21.7mm; inset-block-start: 119.0mm; inline-size: 62.0mm; block-size: 28.3mm; font-size: 13.4pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 18.0mm; inset-block-start: 148.2mm; inline-size: 2.7mm; block-size: 5.6mm; font-size: 15.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 21.7mm; inset-block-start: 154.5mm; inline-size: 72.1mm; block-size: 38.1mm; font-size: 13.5pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 68.5mm; inset-block-start: 196.7mm; inline-size: 4.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
