<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.8mm; inset-block-start: 16.3mm; inline-size: 173.9mm; block-size: 144.5mm; font-size: 22.8pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 164.0mm; inline-size: 63.4mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 14.4mm; inset-block-start: 171.6mm; inline-size: 84.9mm; block-size: 34.0mm; font-size: 13.8pt"></div>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 171.1mm; inline-size: 83.4mm; block-size: 13.4mm; font-size: 12.6pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 186.3mm; inline-size: 83.5mm; block-size: 13.4mm; font-size: 12.6pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 103.4mm; inset-block-start: 205.0mm; inline-size: 88.0mm; block-size: 26.9mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 208.3mm; inline-size: 64.2mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 14.4mm; inset-block-start: 215.5mm; inline-size: 84.9mm; block-size: 33.9mm; font-size: 32.0pt"></div>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 236.1mm; inline-size: 41.0mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 242.9mm; inline-size: 86.8mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 252.0mm; inline-size: 45.3mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.7mm; inline-size: 7.4mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
