<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 99.1mm; inline-size: 155.2mm; block-size: 11.1mm; font-size: 11.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 113.9mm; inline-size: 158.0mm; block-size: 11.0mm; font-size: 11.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 38.2mm; inset-block-start: 135.6mm; inline-size: 101.2mm; block-size: 3.7mm; font-size: 11.0pt">{{ slot_6 }}</p>
