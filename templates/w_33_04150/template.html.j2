* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

body {
    display: flex;
    flex-direction: column;
    align-items: center;
}

header, main, aside, footer {
    width: 100%;
    padding: 20px;
    margin: 10px 0;
}

header {
    background-color: #f8f8f8;
    display: flex;
