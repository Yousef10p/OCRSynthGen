<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #F3DEDE;
    color: #561B8F;
}

nav {
    background-color: #F3DEDE;
    padding: 1em;
}

nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

nav ul li {
    display: inline;
    margin-left: 1em;
}

.carousel-wrapper {
    width: 80%;
    height: 200px;
    margin: 1em auto;
    border: 2px solid #F3DEDE;
    display: flex;
    align-items: center;
    justify-content: center;
}

.carousel-item {
    background-color: #F5DDED;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1em;
    flex: 1;
}

aside {
    position: absolute;
    left: 0;
    width: 20%;
    padding: 1em;
    background-color: #F3DEDE;
}

aside p, aside ul {
    margin: 0;
}

aside ul {
    padding-right: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li>{{ slot_0 }}</li>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ul>
</nav>
<div class="carousel-wrapper">
<div class="carousel">
<div class="carousel-item">{{ slot_4 }}</div>
<div class="carousel-item">{{ slot_5 }}</div>
<div class="carousel-item">{{ slot_6 }}</div>
</div>
</div>
<aside>
<h3>{{ slot_7 }}</h3>

<p>{{ slot_8 }}</p>
<ul>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
</ul>
<p>{{ slot_12 }}</p>
<ul>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
</ul>
</aside>
</body>
</html>