}

nav ul li a {
  color: #000;
  text-decoration: none;
}


aside {
  float: right;
  width: 20%;
  background-color: #f0f0f0;
  min-height: 500px;
}


.banner {
  text-align: center;
  background-color: #f0f0f0;
  padding: 100px 0;
}


.col {
  width: 60%;
  margin: 20px;
  background-color: #ccc;
  min-height: 200px;
}


footer {
  background-color: #333;
  color: #fff;
  clear: both;
  padding: 20px;
}

footer a {
  color: #fff;
  margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
