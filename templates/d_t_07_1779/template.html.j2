<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 44.1mm; inline-size: 158.7mm; block-size: 22.8mm; font-size: 16.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 19.2mm; inset-block-start: 74.1mm; inline-size: 160.5mm; block-size: 112.3mm; font-size: 18.7pt"></div>
<h2 class="box" style="inset-inline-start: 21.0mm; inset-block-start: 192.2mm; inline-size: 14.5mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 102.9mm; inset-block-start: 192.5mm; inline-size: 73.7mm; block-size: 25.1mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 196.9mm; inline-size: 75.2mm; block-size: 34.0mm; font-size: 12.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 102.9mm; inset-block-start: 223.3mm; inline-size: 18.0mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_6 }}</h2>
