    }
    .product-image, .sale-image, .location-image {
    background-color: #f00;
    height: 200px;
    width: 100%;
    margin-bottom: 10px;
    }
    .footer {
    background-color: #0f0;
    color: #fff;
    padding: 10px;
    text-align: center;
    clear: both;
    }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
