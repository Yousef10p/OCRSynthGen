<p class="box" style="inset-inline-start: 21.6mm; inset-block-start: 129.0mm; inline-size: 86.8mm; block-size: 16.4mm; font-size: 11.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 114.4mm; inset-block-start: 129.0mm; inline-size: 86.9mm; block-size: 25.6mm; font-size: 12.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 21.6mm; inset-block-start: 147.3mm; inline-size: 87.2mm; block-size: 43.9mm; font-size: 12.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 114.4mm; inset-block-start: 156.4mm; inline-size: 87.0mm; block-size: 39.3mm; font-size: 12.4pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 26.6mm; inset-block-start: 198.5mm; inline-size: 57.5mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 160.3mm; inset-block-start: 201.8mm; inline-size: 29.4mm; block-size: 14.0mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 21.6mm; inset-block-start: 206.8mm; inline-size: 87.6mm; block-size: 48.5mm; font-size: 12.5pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 197.5mm; inset-block-start: 266.9mm; inline-size: 3.7mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
