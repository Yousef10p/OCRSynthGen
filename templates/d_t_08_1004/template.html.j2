<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 44.4mm; inline-size: 137.0mm; block-size: 22.1mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 79.7mm; inset-block-start: 75.0mm; inline-size: 55.9mm; block-size: 9.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 92.1mm; inline-size: 77.5mm; block-size: 13.5mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 101.6mm; inline-size: 137.1mm; block-size: 46.4mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 73.7mm; inset-block-start: 158.3mm; inline-size: 67.9mm; block-size: 5.7mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 174.1mm; inline-size: 137.0mm; block-size: 30.0mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 207.8mm; inline-size: 135.9mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 216.2mm; inline-size: 148.7mm; block-size: 15.3mm; font-size: 12.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 105.6mm; inset-block-start: 244.5mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
