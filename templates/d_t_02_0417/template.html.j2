<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 71.6mm; inline-size: 72.2mm; block-size: 31.6mm; font-size: 12.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 109.6mm; inset-block-start: 71.6mm; inline-size: 72.3mm; block-size: 12.4mm; font-size: 11.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 109.6mm; inset-block-start: 91.1mm; inline-size: 72.3mm; block-size: 36.4mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 110.3mm; inline-size: 72.3mm; block-size: 65.2mm; font-size: 13.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 109.6mm; inset-block-start: 134.6mm; inline-size: 72.3mm; block-size: 36.4mm; font-size: 12.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 196.9mm; inline-size: 61.9mm; block-size: 2.3mm; font-size: 6.5pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 27.2mm; inset-block-start: 201.9mm; inline-size: 155.7mm; block-size: 30.8mm; font-size: 17.4pt"></div>
<footer class="box" style="inset-inline-start: 201.3mm; inset-block-start: 245.2mm; inline-size: 1.9mm; block-size: 1.5mm; font-size: 5.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
