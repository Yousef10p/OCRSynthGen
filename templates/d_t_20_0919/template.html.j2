<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 38.6mm; inset-block-start: 4.9mm; inline-size: 70.8mm; block-size: 5.6mm; font-size: 15.7pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 125.1mm; inset-block-start: 5.8mm; inline-size: 4.0mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 18.7mm; inset-block-start: 13.3mm; inline-size: 67.6mm; block-size: 6.7mm; font-size: 18.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 20.6mm; inline-size: 110.6mm; block-size: 27.7mm; font-size: 9.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 18.6mm; inset-block-start: 47.2mm; inline-size: 70.4mm; block-size: 5.6mm; font-size: 5.2pt">{{ slot_4 }}</h2>
<ul class="box" style="inset-inline-start: 18.5mm; inset-block-start: 52.4mm; inline-size: 45.0mm; block-size: 4.6mm; font-size: 5.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.7mm; inset-block-start: 56.2mm; inline-size: 101.6mm; block-size: 8.4mm; font-size: 6.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.7mm; inset-block-start: 64.0mm; inline-size: 53.0mm; block-size: 4.6mm; font-size: 5.0pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.6mm; inset-block-start: 67.8mm; inline-size: 42.6mm; block-size: 4.6mm; font-size: 5.0pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.6mm; inset-block-start: 71.7mm; inline-size: 49.7mm; block-size: 4.6mm; font-size: 5.0pt"><li>{{ slot_9 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.8mm; inset-block-start: 75.5mm; inline-size: 63.3mm; block-size: 4.6mm; font-size: 5.0pt"><li>{{ slot_10 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.7mm; inset-block-start: 79.4mm; inline-size: 42.5mm; block-size: 4.6mm; font-size: 6.5pt"><li>{{ slot_11 }}</li></ul>
<div class="box ph" style="inset-inline-start: 54.8mm; inset-block-start: 204.8mm; inline-size: 38.3mm; block-size: 4.1mm; font-size: 11.6pt"></div>
</div></body>
</html>
