<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}
a {
    color: white;
    text-decoration: none;
}
ul {
    list-style-type: none;
    padding: 0;
}


.hero {
    background-color: #F5A623;
    color: white;
    text-align: center;
    padding: 100px 0;
    font-size: 50px;
}


nav {
    background-color: #333;
    color: white;
}
nav ul {
    display: flex;
    justify-content: space-around;
    padding: 20px 0;
}
nav a {
    text-transform: uppercase;
}


section {
    padding: 50px 0;
    text-align: center;
}
.menu-item, .reservation-form, .location-map {
    background-color: #333;
    color: white;
    margin: 20px 0;
    padding: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<section id="menu">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<div class="menu-item">{{ slot_6 }}</div>
<div class="menu-item">{{ slot_7 }}</div>
<div class="menu-item">{{ slot_8 }}</div>
</section>
<section id="reservations">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
<div class="reservation-form">{{ slot_11 }}</div>
</section>
<section id="location">
<h1>{{ slot_12 }}</h1>
<p>{{ slot_13 }}</p>
<div class="location-map">{{ slot_14 }}</div>
</section>
</body>
</html>