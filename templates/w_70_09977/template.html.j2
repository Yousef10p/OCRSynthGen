<a>{{ slot_4 }}</a>
</div>
</li>
<li class="dropdown">
<a>{{ slot_5 }}</a>
<div class="dropdown-content">
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
</div>
</li>
<li class="dropdown">
<a>{{ slot_8 }}</a>
<div class="dropdown-content">
<a>{{ slot_9 }}</a>
<a>{{ slot_10 }}</a>
</div>
</li>
</ul>
</nav>
<main>
<section>
<p>{{ slot_11 }}</p>
<div class="image">{{ slot_12 }}</div>
</section>
<section>
