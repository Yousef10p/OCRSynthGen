<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background-color: #f4f4f4;
  color: #1e1e1e;
}


header {
  height: 70px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 50px;
}

.logo {
  font-size: 24px;
  font-weight: bold;
  color: #1e1e1e;
}

nav ul {
  display: flex;
  list-style: none;
}

nav ul a {
  margin: 0 10px;
  text-decoration: none;
  color: #1e1e1e;
}


.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500px;
}

.content h1 {
  font-size: 60px;
  color: #1e1e1e;
}

.content p {
  width: 50%;
  line-height: 1.6;
  margin-bottom: 20px;
}

.content .btn {
  padding: 10px 20px;
  background-color: #1e1e1e;
  color: #f4f4f4;
  text-decoration: none;
}


footer {
  height: 300px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

footer h2 {
  margin-bottom: 20px;
}

footer form input, footer textarea {
  width: 50%;
  padding: 10px;
  margin-bottom: 10px;
  color: #1e1e1e;
}

footer input[type="submit"] {
  padding: 10px 20px;
  background-color: #1e1e1e;
  color: #f4f4f4;
  border: none;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
