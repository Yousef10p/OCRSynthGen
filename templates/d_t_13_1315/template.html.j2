<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 14.7mm; inset-block-start: 17.4mm; inline-size: 41.8mm; block-size: 19.7mm; font-size: 14.0pt"></div>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 56.3mm; inline-size: 147.5mm; block-size: 11.6mm; font-size: 9.0pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 70.0mm; inline-size: 153.9mm; block-size: 15.4mm; font-size: 9.0pt"><li>{{ slot_1 }}</li></ul>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 93.6mm; inline-size: 22.9mm; block-size: 3.8mm; font-size: 9.0pt">{{ slot_2 }}</h2>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 99.5mm; inline-size: 154.0mm; block-size: 27.0mm; font-size: 9.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 128.6mm; inline-size: 153.9mm; block-size: 27.0mm; font-size: 9.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 157.8mm; inline-size: 154.0mm; block-size: 23.2mm; font-size: 9.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 183.1mm; inline-size: 154.0mm; block-size: 34.7mm; font-size: 9.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 219.9mm; inline-size: 154.0mm; block-size: 23.2mm; font-size: 9.0pt"><li>{{ slot_7 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 262.0mm; inline-size: 147.2mm; block-size: 6.3mm; font-size: 5.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 268.5mm; inline-size: 100.2mm; block-size: 3.1mm; font-size: 6.5pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 201.4mm; inset-block-start: 282.3mm; inline-size: 3.2mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
