<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 85.1mm; inset-block-start: 25.5mm; inline-size: 41.0mm; block-size: 4.1mm; font-size: 10.4pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 74.6mm; inset-block-start: 32.0mm; inline-size: 61.9mm; block-size: 4.1mm; font-size: 10.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 39.1mm; inline-size: 147.7mm; block-size: 42.5mm; font-size: 10.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 84.5mm; inline-size: 121.5mm; block-size: 4.1mm; font-size: 10.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 96.3mm; inline-size: 29.2mm; block-size: 3.4mm; font-size: 8.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 101.9mm; inline-size: 21.3mm; block-size: 3.1mm; font-size: 8.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 110.4mm; inline-size: 141.6mm; block-size: 7.1mm; font-size: 8.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 151.6mm; inset-block-start: 242.5mm; inline-size: 37.9mm; block-size: 31.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 32.0mm; inset-block-start: 250.3mm; inline-size: 9.7mm; block-size: 4.1mm; font-size: 10.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 32.0mm; inset-block-start: 262.0mm; inline-size: 20.7mm; block-size: 2.8mm; font-size: 7.2pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 32.0mm; inset-block-start: 269.9mm; inline-size: 39.9mm; block-size: 2.8mm; font-size: 7.2pt">{{ slot_9 }}</p>
</div></body>
</html>
