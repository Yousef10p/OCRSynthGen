<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 87.1mm; inset-block-start: 7.7mm; inline-size: 37.5mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 29.0mm; inline-size: 116.3mm; block-size: 9.7mm; font-size: 27.5pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 19.7mm; inset-block-start: 45.5mm; inline-size: 159.5mm; block-size: 129.0mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 180.1mm; inline-size: 158.0mm; block-size: 12.6mm; font-size: 17.8pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 198.7mm; inline-size: 41.1mm; block-size: 6.8mm; font-size: 9.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 205.5mm; inline-size: 152.7mm; block-size: 18.9mm; font-size: 10.7pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 224.1mm; inline-size: 31.1mm; block-size: 6.8mm; font-size: 6.4pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 230.9mm; inline-size: 158.5mm; block-size: 12.6mm; font-size: 8.9pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 243.1mm; inline-size: 46.4mm; block-size: 6.8mm; font-size: 6.4pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 250.0mm; inline-size: 161.3mm; block-size: 25.3mm; font-size: 14.3pt">{{ slot_8 }}</p>
</div></body>
</html>
