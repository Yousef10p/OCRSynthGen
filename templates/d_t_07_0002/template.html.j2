<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 20.1mm; inline-size: 123.6mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 28.6mm; inline-size: 166.3mm; block-size: 36.0mm; font-size: 11.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 69.4mm; inline-size: 166.5mm; block-size: 48.4mm; font-size: 11.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 122.8mm; inline-size: 165.9mm; block-size: 23.4mm; font-size: 11.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 151.0mm; inline-size: 166.4mm; block-size: 36.1mm; font-size: 11.4pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 192.1mm; inline-size: 25.0mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 199.7mm; inline-size: 164.0mm; block-size: 15.1mm; font-size: 10.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 219.7mm; inline-size: 164.3mm; block-size: 15.2mm; font-size: 10.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 239.8mm; inline-size: 158.3mm; block-size: 6.9mm; font-size: 9.7pt">{{ slot_8 }}</p>
</div></body>
</html>
