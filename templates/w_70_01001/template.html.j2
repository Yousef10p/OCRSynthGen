}

form {
    margin: 10px 0;
    padding: 20px;
    background-color: #eee;
}

form input, 
form textarea {
    display: block;
    margin: 10px 0;
    width: 100%;
    padding: 5px;
    box-sizing: border-box;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
