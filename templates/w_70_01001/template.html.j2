    text-align: center;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

.slider div {
    height: 300px;
    width: 100%;
    background-color: #f1f1f1;
}

section {
    margin: 10px 0;
    padding: 20px;
}

section p {
