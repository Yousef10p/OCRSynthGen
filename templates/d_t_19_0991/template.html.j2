<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 63.3mm; inset-block-start: 21.6mm; inline-size: 24.4mm; block-size: 11.1mm; font-size: 31.4pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 37.5mm; inset-block-start: 33.6mm; inline-size: 75.8mm; block-size: 29.0mm; font-size: 40.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 69.6mm; inline-size: 24.9mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_2 }}</h2>
<ul class="box" style="inset-inline-start: 22.5mm; inset-block-start: 75.4mm; inline-size: 31.8mm; block-size: 4.5mm; font-size: 12.7pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.5mm; inset-block-start: 80.5mm; inline-size: 27.1mm; block-size: 4.5mm; font-size: 12.7pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.5mm; inset-block-start: 85.7mm; inline-size: 67.5mm; block-size: 4.5mm; font-size: 12.7pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 95.0mm; inline-size: 93.1mm; block-size: 27.0mm; font-size: 15.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 125.1mm; inline-size: 43.0mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_7 }}</p>
<ul class="box" style="inset-inline-start: 38.8mm; inset-block-start: 132.7mm; inline-size: 86.2mm; block-size: 8.3mm; font-size: 11.7pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.8mm; inset-block-start: 142.1mm; inline-size: 88.2mm; block-size: 19.6mm; font-size: 11.1pt"><li>{{ slot_9 }}</li></ul>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 164.8mm; inline-size: 92.8mm; block-size: 19.6mm; font-size: 11.1pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 26.7mm; inset-block-start: 201.9mm; inline-size: 95.7mm; block-size: 7.2mm; font-size: 8.8pt">{{ slot_11 }}</footer>
</div></body>
</html>
