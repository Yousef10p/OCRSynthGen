<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 28.2mm; inset-block-start: 15.9mm; inline-size: 48.6mm; block-size: 19.1mm; font-size: 13.5pt"></div>
<header class="box" style="inset-inline-start: 127.5mm; inset-block-start: 35.0mm; inline-size: 66.6mm; block-size: 3.6mm; font-size: 9.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 34.4mm; inset-block-start: 46.8mm; inline-size: 83.2mm; block-size: 5.1mm; font-size: 13.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 52.7mm; inline-size: 170.7mm; block-size: 13.3mm; font-size: 11.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 68.2mm; inline-size: 164.4mm; block-size: 31.1mm; font-size: 11.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 103.8mm; inline-size: 164.4mm; block-size: 57.9mm; font-size: 11.0pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 34.4mm; inset-block-start: 170.3mm; inline-size: 123.9mm; block-size: 5.1mm; font-size: 13.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 176.4mm; inline-size: 170.7mm; block-size: 22.2mm; font-size: 11.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 200.8mm; inline-size: 170.7mm; block-size: 17.7mm; font-size: 11.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 220.8mm; inline-size: 170.7mm; block-size: 26.7mm; font-size: 11.0pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 34.4mm; inset-block-start: 256.0mm; inline-size: 48.0mm; block-size: 5.1mm; font-size: 13.0pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 262.1mm; inline-size: 170.7mm; block-size: 8.8mm; font-size: 11.0pt">{{ slot_10 }}</p>
<div class="box ph" style="inset-inline-start: 27.6mm; inset-block-start: 279.3mm; inline-size: 11.7mm; block-size: 7.4mm; font-size: 20.9pt"></div>
<footer class="box" style="inset-inline-start: 93.0mm; inset-block-start: 283.2mm; inline-size: 34.9mm; block-size: 3.6mm; font-size: 9.0pt">{{ slot_11 }}</footer><footer class="box" style="inset-inline-start: 177.5mm; inset-block-start: 283.2mm; inline-size: 18.5mm; block-size: 3.6mm; font-size: 9.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
