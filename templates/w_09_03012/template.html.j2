<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	display: flex;
	align-items: center;
	justify-content: center;
	height: 100vh;
	margin: 0;
	background-color: #F5F5F5;
	font-family: var(--font-body);
}

nav {
	background-color: #A62929;
	color: white;
	padding: 10px;
	position: absolute;
	top: 0;
	right: 0;
	left: 0;
}

nav a {
	color: white;
	margin-left: 10px;
	text-decoration: none;
}

.logo {
	background-color: #006666;
	width: 100px;
	height: 100px;
	margin-top: 100px;
	margin-bottom: 20px;
	position: absolute;
	right: 45%;
	transform: rotate(-45deg);
}

aside {
	background-color: #297769;
	color: white;
	padding: 10px;
	position: absolute;
	top: 100px;
	left: 0;
	width: 20%;
}

aside .product {
	margin-bottom: 10px;
}

main {
	text-align: justify;
	width: 60%;
	margin-top: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
</nav>
<div class="logo ph"></div>
<aside>
<ul>
<li class="product">{{ slot_5 }}</li>
<li class="product">{{ slot_6 }}</li>
<li class="product">{{ slot_7 }}</li>
<li class="product">{{ slot_8 }}</li>
<li class="product">{{ slot_9 }}</li>
</ul>
</aside>
<main>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</main>
</body>
</html>