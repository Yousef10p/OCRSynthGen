<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 34.7mm; inline-size: 76.7mm; block-size: 8.5mm; font-size: 24.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 54.2mm; inline-size: 109.8mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 59.3mm; inline-size: 153.3mm; block-size: 7.2mm; font-size: 10.1pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 67.8mm; inline-size: 156.4mm; block-size: 10.7mm; font-size: 10.1pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 84.7mm; inline-size: 31.7mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 89.7mm; inline-size: 129.6mm; block-size: 3.6mm; font-size: 10.3pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 94.8mm; inline-size: 152.4mm; block-size: 7.2mm; font-size: 10.1pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 108.1mm; inline-size: 93.0mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 24.9mm; inset-block-start: 118.5mm; inline-size: 31.8mm; block-size: 16.7mm; font-size: 15.8pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 136.2mm; inline-size: 48.2mm; block-size: 7.2mm; font-size: 10.2pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 149.6mm; inline-size: 61.3mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 203.2mm; inset-block-start: 289.8mm; inline-size: 3.5mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_10 }}</footer>
</div></body>
</html>
