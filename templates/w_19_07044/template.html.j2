<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</header>
<div class="slider">
<div class="slide" style="background:none;">{{ slot_6 }}</div>
<div class="slide" style="background:none;">{{ slot_7 }}</div>
<div class="slide" style="background:none;">{{ slot_8 }}</div>
<div class="slide" style="background:none;">{{ slot_9 }}</div>
</div>
<section id="about">
