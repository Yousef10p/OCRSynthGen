<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 239.8mm; inset-block-start: 23.1mm; inline-size: 36.8mm; block-size: 51.9mm; font-size: 21.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 27.8mm; inset-block-start: 34.8mm; inline-size: 75.5mm; block-size: 13.6mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 117.0mm; inset-block-start: 34.8mm; inline-size: 80.7mm; block-size: 65.1mm; font-size: 14.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 27.8mm; inset-block-start: 55.4mm; inline-size: 80.5mm; block-size: 39.3mm; font-size: 13.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 27.8mm; inset-block-start: 101.8mm; inline-size: 81.8mm; block-size: 44.5mm; font-size: 14.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 117.0mm; inset-block-start: 107.0mm; inline-size: 81.3mm; block-size: 29.0mm; font-size: 13.7pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 140.7mm; inset-block-start: 142.2mm; inline-size: 53.0mm; block-size: 12.4mm; font-size: 17.5pt"></div>
<p class="box" style="inset-inline-start: 27.8mm; inset-block-start: 153.4mm; inline-size: 74.3mm; block-size: 8.4mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 148.5mm; inset-block-start: 155.6mm; inline-size: 34.5mm; block-size: 6.0mm; font-size: 8.4pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 282.7mm; inset-block-start: 188.7mm; inline-size: 3.8mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_8 }}</footer>
</div></body>
</html>
