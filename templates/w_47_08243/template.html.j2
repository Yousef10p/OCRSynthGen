}


section {
    margin-bottom: 20px;
}


footer {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 20px;
}

footer ul {
    list-style: none;
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
}

footer li {
    margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
