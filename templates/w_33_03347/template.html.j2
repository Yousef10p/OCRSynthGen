}
.product p {
    margin-bottom: 10px;
    color: black;
}
.product a {
    text-decoration: none;
    color: black;
}
.newsletter {
    padding: 50px;
    text-align: center;
    background-color: gray;
    color: white;
}
.newsletter h2 {
    margin-bottom: 20px;
    color: white;
}
.newsletter input[type="submit"] {
    background-color: white;
    color: black;
}
form {
    margin-top: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
