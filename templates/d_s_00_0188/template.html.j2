<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 79.1mm; inset-block-start: 17.0mm; inline-size: 57.7mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 70.6mm; inset-block-start: 53.8mm; inline-size: 75.2mm; block-size: 75.1mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 62.1mm; inset-block-start: 130.2mm; inline-size: 92.9mm; block-size: 10.3mm; font-size: 14.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 150.4mm; inline-size: 175.5mm; block-size: 13.7mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 170.5mm; inline-size: 169.7mm; block-size: 8.4mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 185.3mm; inline-size: 175.6mm; block-size: 19.0mm; font-size: 13.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 210.8mm; inline-size: 176.0mm; block-size: 8.4mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 225.6mm; inline-size: 163.0mm; block-size: 13.7mm; font-size: 12.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 245.8mm; inline-size: 175.4mm; block-size: 13.7mm; font-size: 12.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 107.2mm; inset-block-start: 271.2mm; inline-size: 1.6mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
