<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 137.1mm; inline-size: 177.3mm; block-size: 31.5mm; font-size: 11.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 169.6mm; inline-size: 175.3mm; block-size: 7.2mm; font-size: 10.1pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 19.4mm; inset-block-start: 181.3mm; inline-size: 82.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 186.7mm; inline-size: 177.4mm; block-size: 19.3mm; font-size: 11.0pt">{{ slot_7 }}</p>
