<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</div>
<div class="image-slideshow">
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
</div>
<div id="classes-intro">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div id="schedule">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div id="signup-form">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<form>
<label>{{ slot_12 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
<label>{{ slot_14 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_15 }}</span>
<span class="">{{ slot_16 }}</span>
</form>
</div>
</body>
</html>