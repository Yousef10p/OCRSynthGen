  align-items: center;
  background-color: #f0f0f0;
}

.vr-img {
  width: 300px;
  height: 300px;
  background-color: #ddd;
}


#community {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f5f5f5;
}

.forum {
  width: 300px;
  height: 200px;
  background-color: #ddd;
}


#contact {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fafafa;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
