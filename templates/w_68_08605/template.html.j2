}
@keyframes loaded {
  0% {opacity: 1;}
  100% {opacity: 0;}
}
#loading-text {
  position: fixed;
  top: 50%;
  right: 50%;
  transform: translate(50%, -50%);
  font-size: 50px;
  animation: loaded 3s forwards;
}
#loaded-text {
  display: none;
  position: fixed;
  top: 50%;
  right: 50%;
  transform: translate(50%, -50%);
  font-size: 50px;
  animation: loaded 3s forwards;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
