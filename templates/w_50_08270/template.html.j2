}

header {
    background-color: #f0f0f0;
    padding: 20px;
    text-align: center;
}

nav ul {
    list-style-type: none;
    padding: 20px;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

.product {
    float: right;
    width: 50%;
    padding: 15px;
}

.product-img {
    height: 200px;
    background-color: #ddd;
    animation: fadeIn 2s;
}

@keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
}

#products:hover .product-img, #products:hover .product-img {
    background-color: #bbb;
}

#products:hover h3, #products:hover h3 {
    color: #444;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
