<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    font-family: var(--font-body);
    background-color: #f2f2f2;
    display: flex;
    flex-direction: column;
    align-items: center;
}
header {
    width: 100%;
    height: 50px;
    background-color: #333;
    color: white;
    display: flex;
    justify-content: center;
}
header nav ul {
    display: flex;
}
header nav ul li {
    list-style: none;
    margin: 0 1em;
    position: relative;
}
header nav ul li a {
    color: white;
    text-decoration: none;
}
header nav ul li:hover ul {
    display: block;
}
header nav ul li ul {
    display: none;
    position: absolute;
    background-color: #333;
    padding: 1em;
}
header nav ul li ul li {
    margin: 0.5em 0;
}
.container {
    padding: 1em;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}
.container h1, .container p {
    margin-bottom: 1em;
}
button {
    padding: 0.5em 1em;
    border: none;
    background-color: #333;
    color: white;
    cursor: pointer;
}
button:hover {
    background-color: #000;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
