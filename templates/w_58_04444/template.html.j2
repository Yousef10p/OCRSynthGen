  justify-content: center;
  height: 100vh;
  background: #eee;
}

nav ul {
  display: flex;
  list-style: none;
  gap: 1rem;
  margin: 0;
  padding: 1rem;
}

nav a {
  text-decoration: none;
  color: #333;
}

#lineup {
