<ul class="box" style="inset-inline-start: 36.2mm; inset-block-start: 101.2mm; inline-size: 76.8mm; block-size: 4.8mm; font-size: 13.7pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 112.9mm; inline-size: 164.3mm; block-size: 30.0mm; font-size: 17.0pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 95.9mm; inset-block-start: 150.6mm; inline-size: 24.0mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_5 }}</h2>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 163.0mm; inline-size: 164.2mm; block-size: 11.2mm; font-size: 15.8pt"><li>{{ slot_6 }}</li></ul>
