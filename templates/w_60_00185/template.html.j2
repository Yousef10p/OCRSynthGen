.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #f0f0f0;
    color: #333;
}

a {
    color: #333;
    text-decoration: none;
}


header {
    background-color: #ddd;
