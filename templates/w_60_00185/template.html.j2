    width: 100%;
    height: 200px;
    background-color: #888;
    border-radius: 10px;
    margin-bottom: 15px;
}

nav {
    display: flex;
    justify-content: space-around;
    padding: 20px 0;
}


#menu {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding: 20px 0;
}

.menu-item {
    padding: 10px;
    border: 1px solid #333;
    border-radius: 5px;
    margin-bottom: 10px;
}

.menu-item:hover {
    background-color: #ddd;
}


#reviews {
