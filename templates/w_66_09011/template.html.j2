}

input, textarea {
    border: 1px solid #ccc;
    padding: 0.5rem;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    left: 0;
    padding: 1rem;
    text-align: center;
    background-color: #f8f8f8;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
