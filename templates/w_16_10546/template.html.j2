<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #E5E5E5;
    color: #333;
}

header {
    background-color: #333;
    color: #fff;
    padding: 10px 0;
    text-align: center;
}

header h1 {
    margin: 0;
}

header nav ul {
    list-style-type: none;
    padding: 0;
}

header nav ul li {
    display: inline;
    margin: 0 10px;
}

header nav ul li a {
    color: #fff;
    text-decoration: none;
}

main {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
}

main section {
    margin-bottom: 20px;
}

main section h2 {
    color: #333;
}

main section p {
    line-height: 1.6;
}

main .hero {
    background-color: #ff9900;
    color: #fff;
    padding: 40px;
    text-align: center;
}

main .hero h2 {
    font-size: 36px;
}

main .feature {
    display: inline-block;
    width: 30%;
    vertical-align: top;
    margin-left: 5%;
    padding: 20px;
    background-color: #fff;
    box-shadow: -1px 2px 5px rgba(0,0,0,0.1);
}

main .feature h3 {
    color: #333;
}

main .feature p {
    color: #666;
}

main .promotions {
    background: #fff;
    padding: 20px;
    box-shadow: -1px 2px 5px rgba(0,0,0,0.1);
}

main .promotions p {
    font-weight: bold;
}

main .promotions-list {
    padding: 0 20px;
}

footer {
    background-color: #333;
    color: #fff;
    padding: 10px 0;
    text-align: center;
    position: fixed;
    width: 100%;
    bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
