}

#nav-links {
    display: flex;
    justify-content: space-around;
}

#nav-links li {
    list-style-type: none;
}

#nav-links a {
    color: #fff;
    text-decoration: none;
}

section {
    padding-top: 60px; 
    margin-bottom: 20px;
    padding-right: 10%;
