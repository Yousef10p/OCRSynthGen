}

#portfolio-items .item {
    display: inline-block;
    width: 30%;
    margin: 1%;
    vertical-align: top;
}

#portfolio-items .item .portfolio-image {
    height: 200px;
}

form {
    width: 60%;
    margin: 0 auto;
}

form label, form input, form textarea {
    display: block;
    margin-bottom: 10px;
}

form input, form textarea {
    width: 100%;
    padding: 8px;
    border: 1px solid #333;
}

form button {
    cursor: pointer;
    padding: 8px 16px;
    background-color: #333;
    color: #fff;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
