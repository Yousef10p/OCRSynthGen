<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 34.5mm; inset-block-start: 13.5mm; inline-size: 48.2mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 24.5mm; inline-size: 139.4mm; block-size: 45.6mm; font-size: 16.1pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 34.1mm; inset-block-start: 75.0mm; inline-size: 41.0mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 42.2mm; inset-block-start: 86.1mm; inline-size: 55.9mm; block-size: 21.7mm; font-size: 15.4pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 34.4mm; inset-block-start: 112.3mm; inline-size: 68.3mm; block-size: 6.2mm; font-size: 17.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 121.4mm; inline-size: 141.4mm; block-size: 31.6mm; font-size: 17.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.3mm; inset-block-start: 156.1mm; inline-size: 129.6mm; block-size: 112.1mm; font-size: 17.7pt">{{ slot_6 }}</p>
</div></body>
</html>
