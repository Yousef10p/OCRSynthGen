   text-align: center;
}
nav li {
   display: inline;
   margin: 0 10px;
}
nav a {
   text-decoration: none;
   color: black;
}
main {
   display: flex;
   flex-wrap: wrap;
   justify-content: space-around;
   margin: 20px;
}
section, article {
   width: 30%;
   padding: 10px;
   box-sizing: border-box;
}
.image {
   height: 200px;
   margin-bottom: 10px;
}
.donate {
   display: block;
   width: 100%;
   background-color: #f1f1f1;
   text-align: center;
   padding: 10px 0;
   text-decoration: none;
   color: black;
}
footer {
   background-color: #f1f1f1;
   text-align: center;
   padding: 10px;
   position: fixed;
   bottom: 0;
   width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
