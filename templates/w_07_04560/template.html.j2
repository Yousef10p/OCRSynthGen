<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

nav {
  position: fixed;
  top: 0;
  width: 100%;
  background: #f8f9fa;
  text-align: center;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin: 5px;
}

aside {
  float: right;
  width: 20%;
  background: #f8f9fa;
  padding: 15px;
  text-align: center;
}

#slider {
  width: 100%;
  height: 400px;
  background: #eee;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
}

#slider div {
  height: 100%;
  width: 33%;
  background: #ccc;
  margin: 2px;
}

.dishes, .promotions {
  text-align: right;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<aside>
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<p class="dishes">{{ slot_7 }}</p>
<p class="dishes">{{ slot_8 }}</p>
<p class="dishes">{{ slot_9 }}</p>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<p class="promotions">{{ slot_12 }}</p>
<p class="promotions">{{ slot_13 }}</p>
<p class="promotions">{{ slot_14 }}</p>
</aside>
<div id="slider">

</div>
</body>
</html>