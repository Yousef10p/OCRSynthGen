<header>
<div id="logo">{{ slot_0 }}</div>
<nav>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
</nav>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
</form>
</header>
<main>
<div class="product">
<div class="product-image">{{ slot_4 }}</div>
<div class="product-info">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</div>
</div>
<div class="product">
<div class="product-image">{{ slot_7 }}</div>
<div class="product-info">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
</div>
<a class="cta-button">{{ slot_10 }}</a>
</main>
<aside>
