    height: 100vh;
    object-fit: cover;
}

nav {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    background: rgba(0, 0, 0, 0.5);
    padding: 1em;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
