<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 5.1mm; inset-block-start: 6.2mm; inline-size: 35.1mm; block-size: 2.6mm; font-size: 11.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 17.6mm; inline-size: 199.4mm; block-size: 5.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 66.6mm; inset-block-start: 28.4mm; inline-size: 72.6mm; block-size: 60.3mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 76.7mm; inset-block-start: 94.2mm; inline-size: 31.6mm; block-size: 2.9mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 104.8mm; inset-block-start: 104.3mm; inline-size: 65.4mm; block-size: 47.6mm; font-size: 15.0pt"></div>
<div class="box ph" style="inset-inline-start: 35.5mm; inset-block-start: 106.3mm; inline-size: 65.3mm; block-size: 45.2mm; font-size: 14.2pt"></div>
<p class="box" style="inset-inline-start: 55.5mm; inset-block-start: 154.4mm; inline-size: 31.6mm; block-size: 2.9mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 119.7mm; inset-block-start: 154.4mm; inline-size: 31.6mm; block-size: 2.9mm; font-size: 12.0pt">{{ slot_4 }}</p>
</div></body>
</html>
