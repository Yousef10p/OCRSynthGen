<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 124.6mm; inline-size: 151.2mm; block-size: 21.6mm; font-size: 10.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 151.0mm; inline-size: 141.4mm; block-size: 6.5mm; font-size: 9.2pt">{{ slot_5 }}</p>
