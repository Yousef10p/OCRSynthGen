<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 65.5mm; inset-block-start: 7.0mm; inline-size: 17.0mm; block-size: 4.3mm; font-size: 6.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 57.3mm; inset-block-start: 11.0mm; inline-size: 33.4mm; block-size: 3.5mm; font-size: 5.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 16.4mm; inline-size: 91.5mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 24.2mm; inline-size: 78.9mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 32.3mm; inline-size: 107.8mm; block-size: 11.4mm; font-size: 10.8pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 47.4mm; inline-size: 75.5mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 55.4mm; inline-size: 107.1mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 66.7mm; inline-size: 87.8mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 74.7mm; inline-size: 107.8mm; block-size: 15.2mm; font-size: 10.8pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 93.6mm; inline-size: 50.4mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 101.6mm; inline-size: 107.3mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 113.1mm; inline-size: 107.7mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 74.7mm; inset-block-start: 196.7mm; inline-size: 4.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
