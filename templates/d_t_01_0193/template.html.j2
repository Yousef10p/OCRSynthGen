<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 12.2mm; inset-block-start: 4.9mm; inline-size: 191.5mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 10.3mm; inset-block-start: 16.8mm; inline-size: 9.4mm; block-size: 78.6mm; font-size: 40.0pt">{{ slot_1 }}</header><h1 class="box" style="inset-inline-start: 16.3mm; inset-block-start: 101.0mm; inline-size: 181.5mm; block-size: 68.9mm; font-size: 40.0pt">{{ slot_2 }}</h1>
<p class="box" style="inset-inline-start: 133.9mm; inset-block-start: 227.6mm; inline-size: 51.3mm; block-size: 12.4mm; font-size: 17.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 138.5mm; inset-block-start: 242.2mm; inline-size: 63.0mm; block-size: 12.4mm; font-size: 17.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 142.6mm; inset-block-start: 256.5mm; inline-size: 51.9mm; block-size: 12.6mm; font-size: 17.8pt">{{ slot_5 }}</p>
</div></body>
</html>
