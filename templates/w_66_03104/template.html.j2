    padding: 0;
    font-family: var(--font-body);
    color: #333;
}

header, footer {
    width: 100%;
    background: pink;
    color: white;
}

header {
    height: 60px;
}

nav {
    width: 200px;
    background: #eee;
    float: right;
}

section.feature {
    width: calc(100% - 200px);
    float: left;
    text-align: center;
}

footer p {
    margin: 5px 0;
}

.logo {
    width: 100px;
    height: 50px;
