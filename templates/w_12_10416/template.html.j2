<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
}

nav {
    background-color: #ddd;
    padding: 10px 0;
}

nav ul {
    list-style: none;
    text-align: center;
}

nav ul li {
    display: inline-block;
    margin: 0 10px;
}

nav ul li a {
    text-decoration: none;
    color: #333;
}

#video-background {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
}

#video-background video {
    position: absolute;
    top: 50%;
    right: 50%;
    min-width: 100%;
    min-height: 100%;
    transform: translate(50%, -50%);
    z-index: -1;
}

#service-content {
    display: flex;
    justify-content: space-between;
    padding: 20px;
}

.column {
    flex: 1;
    padding: 20px;
    text-align: center;
}

.image-placeholder {
    background-color: #ddd;
    height: 200px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

<header>
<h1>{{ slot_0 }}</h1>
</header>

<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>

<div class="ph" style="inline-size: 100%; block-size: 150px"></div>

<section id="service-content">
<div class="column">
<h2>{{ slot_6 }}</h2>

<div class="image-placeholder">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</div>
<div class="column">
<h2>{{ slot_9 }}</h2>

<div class="image-placeholder">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
</div>
<div class="column">
<h2>{{ slot_12 }}</h2>

<div class="image-placeholder">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
</div>
</section>
</body>
</html>