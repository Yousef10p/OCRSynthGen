<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 22.4mm; inset-block-start: 10.4mm; inline-size: 24.6mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 182.2mm; inset-block-start: 10.4mm; inline-size: 11.0mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 81.5mm; inset-block-start: 25.3mm; inline-size: 52.8mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 22.2mm; inset-block-start: 35.3mm; inline-size: 171.2mm; block-size: 135.1mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 22.8mm; inset-block-start: 180.7mm; inline-size: 80.9mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 179.7mm; inline-size: 81.0mm; block-size: 13.5mm; font-size: 12.8pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 22.8mm; inset-block-start: 191.7mm; inline-size: 84.0mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 197.3mm; inline-size: 81.0mm; block-size: 45.0mm; font-size: 12.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 22.8mm; inset-block-start: 201.7mm; inline-size: 81.1mm; block-size: 40.5mm; font-size: 12.7pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 22.8mm; inset-block-start: 264.8mm; inline-size: 10.6mm; block-size: 4.1mm; font-size: 11.8pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 173.7mm; inset-block-start: 264.1mm; inline-size: 18.2mm; block-size: 4.1mm; font-size: 11.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
