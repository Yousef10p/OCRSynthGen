<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.3mm; inset-block-start: 20.1mm; inline-size: 30.0mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 18.3mm; inset-block-start: 32.1mm; inline-size: 138.0mm; block-size: 20.2mm; font-size: 28.6pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 17.9mm; inset-block-start: 73.3mm; inline-size: 89.2mm; block-size: 89.9mm; font-size: 15.0pt"></div>
<div class="box ph" style="inset-inline-start: 108.5mm; inset-block-start: 73.4mm; inline-size: 89.9mm; block-size: 89.7mm; font-size: 15.0pt"></div>
<h2 class="box" style="inset-inline-start: 18.3mm; inset-block-start: 168.9mm; inline-size: 34.1mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 110.9mm; inset-block-start: 168.9mm; inline-size: 86.7mm; block-size: 12.9mm; font-size: 12.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.3mm; inset-block-start: 173.9mm; inline-size: 86.7mm; block-size: 42.9mm; font-size: 13.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 110.9mm; inset-block-start: 188.9mm; inline-size: 71.7mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_5 }}</h2>
