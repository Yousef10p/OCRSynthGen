  padding: 20px;
  text-align: center;
}

#footer .image {
  width: 100px;
  height: 100px;
  background-color: #551a8b;
  display: block;
  margin: 20px auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
