<div class="virtual-tour"><div class="rectangle"></div><p>{{ slot_7 }}</p></div>
<div class="virtual-tour"><div class="rectangle"></div><p>{{ slot_8 }}</p></div>
</div>
<div class="about">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
<div class="services">
