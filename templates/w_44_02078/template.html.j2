<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

header {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  background: #fff;
  padding: 10px 0;
  border-bottom: 1px solid #ccc;
}

.menu {
  list-style-type: none;
  margin: 0;
  padding: 0;
  text-align: center;
}

.menu li {
  display: inline-block;
  margin: 0 10px;
}

.menu li a {
  text-decoration: none;
  color: #333;
}

.fullscreen-image {
  height: 100vh;
  background-color: #eee;  
}

.content {
  height: 1000vh;  
}

footer {
  display: flex;
  background: #333;
  color: #fff;
  padding: 20px;
}

.footer-col {
  flex: 1;
  padding: 10px;
}

form input[type="submit"] {
  background: #ff6347;
  color: #fff;
  padding: 5px 10px;
  border: none;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<ul class="menu">
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</header>
<div class="fullscreen-image ph"></div>
<div class="content"></div>
<footer>
<div class="footer-col">
<h3>{{ slot_5 }}</h3>
<p>{{ slot_6 }}</p>
</div>
<div class="footer-col">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</div>
<div class="footer-col">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
</div>
<div class="footer-col">
<h3>{{ slot_13 }}</h3>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_14 }}</span>
<span class="">{{ slot_15 }}</span>
</form>
</div>
</footer>
</body>
</html>