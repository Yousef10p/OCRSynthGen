  margin: 20px 0;
}

.gallery-item {
  width: 33.33%;
  height: 200px;
  background: #ccc;
  margin-bottom: 10px;
}


.signup {
  margin: 20px 0;
}


.footer {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
