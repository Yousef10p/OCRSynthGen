<p>{{ slot_5 }}</p>
<div class="fashion-piece">{{ slot_6 }}</div>
<div class="fashion-piece">{{ slot_7 }}</div>
<div class="fashion-piece">{{ slot_8 }}</div>
<div class="accessory">{{ slot_9 }}</div>
<div class="accessory">{{ slot_10 }}</div>
<div class="accessory">{{ slot_11 }}</div>
</main>
<footer>
