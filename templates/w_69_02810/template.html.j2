nav ul li {
  display: inline;
  margin-left: 15px;
  transition: all 0.5s ease;
  text-transform: uppercase;
  position: relative;
}

nav ul li:hover {
  background-color: #f4f4f4;
  color: #333;
}

nav ul li ul {
  display: none;
  position: absolute;
  width: 100px;
}

nav ul li:hover > ul {
  display: block;
}

nav ul li ul li {
  display: block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
