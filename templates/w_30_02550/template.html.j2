<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: auto;
    padding: 20px;
    background-color: #f2f2f2;
}

.cta {
    padding: 10px;
    font-size: 20px;
    background-color: #cccccc;
    border: none;
    cursor: pointer;
}

.row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    width: 100%;
    padding: 20px;
}

.col {
    width: 45%;
    height: 400px;
    margin: 10px;
    padding: 20px;
    text-align: center;
    background-color: #f2f2f2;
}

.img-placeholder {
    width: 100%;
    height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<button class="cta">{{ slot_1 }}</button>
</header>
<div class="row">
<div class="col">
<p>{{ slot_2 }}</p>
<div class="img-placeholder ph"></div> 
<ul>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
<div class="col">
<p>{{ slot_6 }}</p>
<div class="img-placeholder ph"></div> 
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
</div>
<div class="col">
<p>{{ slot_10 }}</p>
<div class="img-placeholder ph"></div> 
<ul>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
</ul>
</div>
<div class="col">
<p>{{ slot_14 }}</p>
<div class="img-placeholder ph"></div> 
<ul>
