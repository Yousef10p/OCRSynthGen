    text-align: center;
}

#portfolio img {
    width: 100%;
    height: auto;
}

#services, #contact {
    padding: 20px 0;
}

#contact form {
    display: flex;
    flex-direction: column;
    max-width: 300px;
    margin: 0 auto;
}

#contact form label,
#contact form input,
#contact form textarea {
    margin-bottom: 15px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
