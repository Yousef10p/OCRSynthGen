<p class="box" style="inset-inline-start: 87.0mm; inset-block-start: 115.9mm; inline-size: 32.5mm; block-size: 7.7mm; font-size: 7.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 17.4mm; inset-block-start: 161.0mm; inline-size: 82.5mm; block-size: 14.3mm; font-size: 10.2pt">{{ slot_4 }}</p>
