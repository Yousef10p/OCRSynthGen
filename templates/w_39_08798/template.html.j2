}

.left-column {
  width: 50%;
  background-color: #0f0;
  padding: 20px;
}

.right-column {
  width: 50%;
  background-color: #00f;
  padding: 20px;
  color: #fff;
}

.placeholder {
  width: 100%;
  height: 100%;
  background-color: #000;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
