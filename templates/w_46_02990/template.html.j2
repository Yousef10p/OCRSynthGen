.cta {
    display: inline-block;
    background: #333;
    color: #fff;
    padding: 10px 20px;
    margin-top: 10px;
    border-radius: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
