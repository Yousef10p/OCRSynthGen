<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 14.1mm; inset-block-start: 15.9mm; inline-size: 68.0mm; block-size: 4.4mm; font-size: 12.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 14.1mm; inset-block-start: 44.6mm; inline-size: 90.0mm; block-size: 36.3mm; font-size: 12.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 14.1mm; inset-block-start: 82.7mm; inline-size: 90.0mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 94.5mm; inline-size: 41.5mm; block-size: 7.8mm; font-size: 11.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 14.3mm; inset-block-start: 104.7mm; inline-size: 89.6mm; block-size: 54.1mm; font-size: 14.0pt"></div>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 163.5mm; inline-size: 41.5mm; block-size: 7.8mm; font-size: 11.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 14.6mm; inset-block-start: 173.9mm; inline-size: 89.6mm; block-size: 58.8mm; font-size: 10.4pt"></div>
<footer class="box" style="inset-inline-start: 14.1mm; inset-block-start: 260.9mm; inline-size: 3.0mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 182.4mm; inset-block-start: 260.9mm; inline-size: 15.9mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_6 }}</footer>
</div></body>
</html>
