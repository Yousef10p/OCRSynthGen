}

.header nav ul {
    list-style: none;
    padding: 0;
}

.header nav ul li {
    display: inline;
    margin-left: 15px;
}


.search-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin: 20px;
}

.search-bar input {
    height: 30px;
    margin-left: 10px;
}

.filter label {
    margin-left: 5px;
}

.filter input {
    height: 20px;
}


.destinations {
    display: flex;
    justify-content: space-around;
    margin: 20px;
}

.destinations .slide {
    width: 30%;
    text-align: center;
}

.destinations .slide .image {
    background-color: #ccc;
    height: 200px;
    margin: 15px auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
