<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    color: #333;
    background-color: #f8f8f8;
}

header {
    position: relative;
    width: 100%;
    background-color: #f2811d;
    color: #fff;
    padding: 20px 0;
    text-align: center;
}

header h1 {
    font-size: 2.5em;
}

.hero-image {
    width: 100%;
    height: 300px;
    background-color: #f2811d;
}

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #f85f13;
}

nav li {
    float: right;
}

nav li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

main {
    margin: 20px;
}

h2 {
    font-size: 2em;
    margin: 20px 0;
}

p {
    font-size: 1.2em;
    line-height: 1.6;
}

#reservations {
    background-color: #f8f8f8;
    padding: 20px;
}

form {
    display: flex;
    flex-direction: column;
}

input[type="text"], input[type="date"], input[type="time"], input[type="number"] {
    margin: 10px 0;
    padding: 10px;
    border: none;
    background-color: #ddd;
}

input[type="submit"] {
    margin: 10px 0;
    padding: 10px;
    border: none;
    background-color: #f2811d;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
