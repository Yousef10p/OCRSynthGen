}


aside {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 30%;
    background-color: #f5f5f5;
    padding: 20px;
    text-align: left;
}


footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
