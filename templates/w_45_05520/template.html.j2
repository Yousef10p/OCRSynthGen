*{
  box-sizing: border-box;
}
body{
  margin: 0;
  font-family: var(--font-body);
}
#hero{
  background: none;
  background-size: cover;
  height: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  text-align: center;
  padding: 20px;
}
