  font-size: 1.2em;
  cursor: pointer;
}
#sidebar{
  background-color: #f8f8f8;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
#sidebar ul{
  list-style-type: none;
  padding: 20px 0;
}
#sidebar li{
  margin: 10px 0;
}
form{
  display: flex;
  flex-direction: column;
}
form input, form textarea{
  padding: 10px;
  margin-bottom: 20px;
  border: none;
}
form button{
  padding: 10px;
  border: none;
  background-color: rgb(255, 100, 0);
  color: white;
  font-size: 1em;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
