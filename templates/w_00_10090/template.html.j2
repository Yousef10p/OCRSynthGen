    display: flex;
    list-style: none;
}

nav a {
    margin-left: 1em;
    text-decoration: none;
    color: black;
}

section {
    background-color: white;
    flex-grow: 1;
}

footer {
    background-color: #f8f8f8;
    display: flex;
    justify-content: space-between;
}

.social a {
    margin-left: 1em;
    text-decoration: none;
    color: black;
}

.contact p, .newsletter form {
    margin: 0;
}

.newsletter form {
    display: flex;
}

.newsletter form input[type="email"] {
    margin-left: 1em;
}

.newsletter form button {
    background-color: black;
    color: white;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
