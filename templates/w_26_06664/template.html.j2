    color: #eee;
    padding: 10px 0;
    text-align: center;
}

nav ul {
    list-style-type: none;
}

nav ul li {
    display: inline;
    padding: 10px;
}

nav ul li a {
    color: #eee;
    text-decoration: none;
}

section {
    display: block;
    clear: both;
    margin: 20px 0;
    padding: 20px;
    border: 1px solid #222;
    border-radius: 5px;
    background-color: #fff;
}

button {
    background-color: #222;
    color: #fff;
    padding: 10px 15px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    margin-bottom: 10px;
}

footer {
    background: #222;
    color: #fff;
    text-align: center;
    padding: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
