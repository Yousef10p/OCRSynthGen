<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 6.4mm; inset-block-start: 89.4mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 89.4mm; inline-size: 151.3mm; block-size: 10.0mm; font-size: 28.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 121.2mm; inline-size: 38.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 130.8mm; inline-size: 159.1mm; block-size: 16.6mm; font-size: 15.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 58.0mm; inset-block-start: 149.9mm; inline-size: 126.6mm; block-size: 16.6mm; font-size: 15.7pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 152.8mm; inline-size: 51.4mm; block-size: 51.6mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 58.0mm; inset-block-start: 172.1mm; inline-size: 127.9mm; block-size: 42.0mm; font-size: 17.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.3mm; inset-block-start: 206.1mm; inline-size: 25.8mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 216.7mm; inline-size: 116.6mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 226.2mm; inline-size: 160.3mm; block-size: 54.8mm; font-size: 17.2pt">{{ slot_8 }}</p>
</div></body>
</html>
