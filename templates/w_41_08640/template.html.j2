    justify-content: center;
    align-items: center;
    color: white;
}
.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1em;
    list-style-type: none;
}
.grid li {
    height: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
