<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 70.0mm; inset-block-start: 12.3mm; inline-size: 133.7mm; block-size: 10.5mm; font-size: 14.8pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 39.9mm; inline-size: 77.7mm; block-size: 24.3mm; font-size: 11.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 106.4mm; inset-block-start: 39.9mm; inline-size: 77.8mm; block-size: 109.0mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 65.3mm; inline-size: 77.2mm; block-size: 54.0mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 120.3mm; inline-size: 77.6mm; block-size: 92.1mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 106.4mm; inset-block-start: 150.0mm; inline-size: 78.1mm; block-size: 70.9mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 213.5mm; inline-size: 72.8mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 198.1mm; inset-block-start: 257.5mm; inline-size: 4.7mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_7 }}</footer>
</div></body>
</html>
