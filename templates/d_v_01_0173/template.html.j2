<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 69.4mm; inline-size: 6.3mm; block-size: 122.9mm; font-size: 20.0pt">{{ slot_5 }}</header><p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 67.5mm; inline-size: 58.6mm; block-size: 2.6mm; font-size: 8.0pt">{{ slot_6 }}</p>
