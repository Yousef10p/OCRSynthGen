<div class="game">
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
<a class="purchase-tickets">{{ slot_10 }}</a>
</div>
<div class="game">
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
<a class="purchase-tickets">{{ slot_13 }}</a>
</div>
<div class="game">
<h3>{{ slot_14 }}</h3>
<p>{{ slot_15 }}</p>
<a class="purchase-tickets">{{ slot_16 }}</a>
</div>
<div class="game">
