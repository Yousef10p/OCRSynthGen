<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="blog">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div class="blog-image ph"></div>
<h1>{{ slot_8 }}</h1>
<p>{{ slot_9 }}</p>
<div class="blog-image ph"></div>
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
<div class="blog-image ph"></div>
</div>
<div class="footer">
<p>{{ slot_12 }}</p>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
<p>{{ slot_16 }}</p>
<p>{{ slot_17 }}</p>
</div>
</body>
</html>