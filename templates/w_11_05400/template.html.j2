<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
}

#slider {
    width: 70%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: row;
}

.slide {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    text-align: center;
    transition: all 0.5s ease;
}

#navigation {
    width: 30%;
    height: 100vh;
    overflow: auto;
    padding: 20px;
    box-sizing: border-box;
    background-color: #f0f0f0;
}

h3 {
    margin-bottom: 10px;
    text-transform: uppercase;
}

ul {
    list-style-type: none;
    padding: 0;
    margin: 30px 0;
}

li {
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="slider">
<div class="slide" style="background-color:red;">{{ slot_0 }}</div>
<div class="slide" style="background-color:blue;">{{ slot_1 }}</div>
<div class="slide" style="background-color:green;">{{ slot_2 }}</div>
</div>
<div id="navigation">
<h3>{{ slot_3 }}</h3>
<ul>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
<h3>{{ slot_7 }}</h3>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
<h3>{{ slot_11 }}</h3>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
<li>{{ slot_16 }}</li>
</ul>
</div>
</body>
</html>