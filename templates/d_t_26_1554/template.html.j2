<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 25.4mm; inline-size: 106.5mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 24.9mm; inset-block-start: 33.3mm; inline-size: 163.8mm; block-size: 54.9mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 88.1mm; inline-size: 70.5mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 100.1mm; inline-size: 52.9mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 108.9mm; inline-size: 164.4mm; block-size: 16.2mm; font-size: 11.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 129.1mm; inline-size: 156.5mm; block-size: 12.2mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 145.2mm; inline-size: 105.8mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 263.1mm; inline-size: 94.0mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 188.8mm; inset-block-start: 263.1mm; inline-size: 1.8mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
