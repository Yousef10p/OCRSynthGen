<h2 class="box" style="inset-inline-start: 41.5mm; inset-block-start: 211.5mm; inline-size: 66.3mm; block-size: 3.2mm; font-size: 5.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 41.5mm; inset-block-start: 215.0mm; inline-size: 113.4mm; block-size: 6.7mm; font-size: 6.3pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 41.5mm; inset-block-start: 224.0mm; inline-size: 90.5mm; block-size: 3.2mm; font-size: 5.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 41.5mm; inset-block-start: 227.5mm; inline-size: 117.7mm; block-size: 6.7mm; font-size: 6.3pt">{{ slot_6 }}</p>
