<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 90.9mm; inline-size: 177.7mm; block-size: 14.2mm; font-size: 10.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 106.4mm; inline-size: 180.5mm; block-size: 14.2mm; font-size: 10.1pt">{{ slot_6 }}</p>
