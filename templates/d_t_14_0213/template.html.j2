<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.8mm; inset-block-start: 13.6mm; inline-size: 57.2mm; block-size: 15.1mm; font-size: 14.3pt"></div>
<header class="box" style="inset-inline-start: 97.7mm; inset-block-start: 13.5mm; inline-size: 73.7mm; block-size: 14.8mm; font-size: 8.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 82.0mm; inset-block-start: 30.7mm; inline-size: 49.7mm; block-size: 3.4mm; font-size: 8.0pt">{{ slot_1 }}</header><ul class="box" style="inset-inline-start: 37.9mm; inset-block-start: 43.9mm; inline-size: 140.1mm; block-size: 12.9mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 37.9mm; inset-block-start: 61.0mm; inline-size: 149.8mm; block-size: 17.1mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 37.9mm; inset-block-start: 82.4mm; inline-size: 150.3mm; block-size: 8.6mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 37.9mm; inset-block-start: 95.2mm; inline-size: 148.0mm; block-size: 12.8mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 262.6mm; inline-size: 82.8mm; block-size: 4.3mm; font-size: 8.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 275.5mm; inline-size: 101.8mm; block-size: 7.9mm; font-size: 8.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 165.1mm; inset-block-start: 280.0mm; inline-size: 20.6mm; block-size: 3.4mm; font-size: 8.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
