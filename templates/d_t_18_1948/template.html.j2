<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 20.6mm; inline-size: 52.7mm; block-size: 19.2mm; font-size: 27.2pt">{{ slot_0 }}</p>
<h1 class="box" style="inset-inline-start: 34.2mm; inset-block-start: 55.5mm; inline-size: 102.2mm; block-size: 29.3mm; font-size: 40.0pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 92.1mm; inline-size: 51.4mm; block-size: 6.2mm; font-size: 17.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 33.8mm; inset-block-start: 106.5mm; inline-size: 67.2mm; block-size: 19.7mm; font-size: 18.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 135.3mm; inline-size: 30.1mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 34.5mm; inset-block-start: 221.9mm; inline-size: 15.7mm; block-size: 27.5mm; font-size: 15.6pt"></div>
<p class="box" style="inset-inline-start: 34.9mm; inset-block-start: 251.4mm; inline-size: 84.9mm; block-size: 17.1mm; font-size: 16.1pt">{{ slot_5 }}</p>
</div></body>
</html>
