<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 29.2mm; inset-block-start: 22.7mm; inline-size: 157.9mm; block-size: 17.8mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 30.0mm; inset-block-start: 53.7mm; inline-size: 46.6mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 67.4mm; inline-size: 116.8mm; block-size: 11.6mm; font-size: 16.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 81.1mm; inline-size: 155.9mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 92.7mm; inline-size: 13.1mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 99.6mm; inline-size: 155.9mm; block-size: 23.7mm; font-size: 13.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 27.4mm; inset-block-start: 132.0mm; inline-size: 170.5mm; block-size: 115.6mm; font-size: 21.8pt"></div>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 247.7mm; inline-size: 113.2mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 264.0mm; inline-size: 155.8mm; block-size: 13.0mm; font-size: 12.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 172.0mm; inset-block-start: 280.7mm; inline-size: 18.9mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
