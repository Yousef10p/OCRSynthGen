    list-style-type: none;
    padding: 0;
}

nav li {
    display: inline;
    margin-left: 10px;
}

nav a {
    color: #fff;
    text-decoration: none;
}


main {
    display: flex;
    margin: 20px;
}

main aside {
    background-color: #eee;
    flex: 1;
    margin-left: 20px;
    padding: 20px;
}

main section {
    flex: 3;
    padding: 20px;
}


footer {
    background-color: #333;
    color: #fff;
    padding: 10px;
    text-align: center;
}

footer a {
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
