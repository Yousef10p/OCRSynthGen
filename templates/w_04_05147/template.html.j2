<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    line-height: 1.6;
    margin: 0;
    padding: 0;
    background: #f4f4f4;
}


header {
    background: #333;
    color: #fff;
    padding: 10px 0;
    text-align: center;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}


.slideshow {
    display: flex;
    justify-content: center;
}

.slide {
    margin: 0 10px;
    width: 200px;
    height: 200px;
    background-color: gray;
}


.review {
    margin: 10px;
    padding: 10px;
    background: #fff;
    border: 1px solid #ddd;
}

.review blockquote {
    margin: 0;
    font-style: italic;
}

.review cite {
    font-size: 0.8em;
    font-weight: bold;
}


form {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    margin: 10px;
}

form label {
    grid-column: 1;
}

form input {
    grid-column: 2;
    padding: 5px;
    border: 1px solid #ddd;
}

form input[type="submit"] {
    grid-column: 1 / span 2;
    justify-self: center;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
