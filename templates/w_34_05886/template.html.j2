<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}
body {
	font-family: var(--font-body);
	background-color: #eee;
	color: #333;
}
header {
	background-color: #999;
	padding: 20px;
	text-align: center;
}
header ul {
	list-style: none;
}
header ul li {
	display: inline-block;
	position: relative;
}
header ul li a {
	display: block;
	padding: 10px 20px;
	text-decoration: none;
	color: #fff;
}
header ul li a:hover {
	background-color: #fff;
	color: #333;
}
header ul ul {
	display: none;
	position: absolute;
	top: 100%;
	right: 0;
	width: 200px;
}
header ul li:hover ul {
	display: block;
}
main {
	padding: 20px;
	display: flex;
	justify-content: center;
}
.item {
	margin: 20px;
	padding: 20px;
	text-align: justify;
	background-color: #fff;
	box-shadow: 0 0 10px rgba(0,0,0,0.15);
	flex-basis: 0;
	flex-grow: 1;
	text-transform: capitalize;
}
@keyframes animate-item {
	0%   {background-color: red;}
	25%  {background-color: yellow;}
	50%  {background-color: blue;}
	100% {background-color: green;}
}
.animate {
	animation: animate-item 2s infinite;
}
.item:before {
	content: "";
	display: block;
	width: 100px;
	height: 100px;
	background-color: #aaa;
	margin-bottom: 1em;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
