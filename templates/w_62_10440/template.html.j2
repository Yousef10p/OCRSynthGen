<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    background-color: #80c8c4;
    color: #333;
}

header {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background-color: #333;
}

header img {
    margin-left: auto;
}

header nav ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
}

header nav ul li a {
    color: #fff;
    text-decoration: none;
    padding: 10px;
}

main {
    padding: 20px;
    text-align: center;
}

.class-schedule {
    margin-bottom: 20px;
    text-align: right;
}

.book-now-btn {
    background-color: #263238;
    color: #fff;
    padding: 10px 20px;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<main>
<h1>{{ slot_4 }}</h1>
<div class="class-schedule">
<p>{{ slot_5 }}</p>
<ul>
<li><strong>{{ slot_6 }}</strong> {{ slot_7 }}</li>
<li><strong>{{ slot_8 }}</strong> {{ slot_9 }}</li>
<li><strong>{{ slot_10 }}</strong> {{ slot_11 }}</li>
<li><strong>{{ slot_12 }}</strong> {{ slot_13 }}</li>
<li><strong>{{ slot_14 }}</strong> {{ slot_15 }}</li>
<li><strong>{{ slot_16 }}</strong> {{ slot_17 }}</li>
<li><strong>{{ slot_18 }}</strong> {{ slot_19 }}</li>
</ul>
</div>
<button class="book-now-btn">{{ slot_20 }}</button>
</main>
</body>
</html>