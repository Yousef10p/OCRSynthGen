<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}
.container {
    display: flex;
    justify-content: space-between;
    padding: 20px;
}
.column {
    width: 100%;
}
#left-column {
    padding-left: 10px;
}
#right-column {
    padding-right: 10px;
}
h1 {
    font-size: 24px;
    margin-bottom: 10px;
}
input[type="text"] {
    width: 100%;
    padding: 10px;
    margin-bottom: 10px;
}
input[type="submit"] {
    background-color: blue;
    color: white;
    padding: 10px;
    border: none;
}
li {
    margin-bottom: 20px;
}
.price {
    font-weight: bold;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="column" id="left-column">
<h1>{{ slot_0 }}</h1>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_2 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<span class="">{{ slot_4 }}</span>
</form>
</div>
<div class="column" id="right-column">
<h1>{{ slot_5 }}</h1>
<ul>
<li>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<p class="price">{{ slot_8 }}</p>
</li>
<li>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<p class="price">{{ slot_11 }}</p>
</li>
<li>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<p class="price">{{ slot_14 }}</p>
</li>
</ul>
</div>
</div>
</body>
</html>