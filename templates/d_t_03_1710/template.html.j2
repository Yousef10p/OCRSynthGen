<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 82.8mm; inset-block-start: 16.4mm; inline-size: 35.4mm; block-size: 35.4mm; font-size: 14.3pt"></div>
<div class="box ph" style="inset-inline-start: 0.3mm; inset-block-start: 59.3mm; inline-size: 127.6mm; block-size: 80.3mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 128.1mm; inset-block-start: 78.4mm; inline-size: 51.8mm; block-size: 53.7mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 32.9mm; inset-block-start: 198.9mm; inline-size: 34.3mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 92.7mm; inset-block-start: 203.2mm; inline-size: 91.9mm; block-size: 67.8mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 32.9mm; inset-block-start: 212.6mm; inline-size: 27.8mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 32.9mm; inset-block-start: 226.4mm; inline-size: 42.8mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 32.9mm; inset-block-start: 240.2mm; inline-size: 37.6mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 32.9mm; inset-block-start: 254.0mm; inline-size: 56.0mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_4 }}</p>
<h1 class="box" style="inset-inline-start: 33.4mm; inset-block-start: 281.5mm; inline-size: 156.3mm; block-size: 5.5mm; font-size: 15.5pt">{{ slot_5 }}</h1>
</div></body>
</html>
