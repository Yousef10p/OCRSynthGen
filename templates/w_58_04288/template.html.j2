}

footer {
  margin-top: auto; 
  padding: 20px;
  text-align: center;
}

footer a {
  color: white; 
  margin: 0 10px; 
  text-decoration: none; 
}

footer a:hover {
  color: #6c757d;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
