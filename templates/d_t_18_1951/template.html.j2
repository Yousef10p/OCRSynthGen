<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.5mm; inset-block-start: 0.9mm; inline-size: 110.3mm; block-size: 10.5mm; font-size: 29.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 21.4mm; inline-size: 133.1mm; block-size: 18.5mm; font-size: 13.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 7.2mm; inset-block-start: 40.6mm; inline-size: 132.4mm; block-size: 35.3mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 82.1mm; inline-size: 133.0mm; block-size: 13.8mm; font-size: 13.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 14.7mm; inset-block-start: 103.4mm; inline-size: 119.4mm; block-size: 26.3mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 140.2mm; inline-size: 133.1mm; block-size: 13.8mm; font-size: 13.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 86.9mm; inset-block-start: 161.5mm; inline-size: 48.8mm; block-size: 34.3mm; font-size: 16.2pt"></div>
<div class="box ph" style="inset-inline-start: 8.0mm; inset-block-start: 164.5mm; inline-size: 68.9mm; block-size: 31.3mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 197.1mm; inline-size: 28.4mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 94.9mm; inset-block-start: 197.1mm; inline-size: 35.8mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_5 }}</p>
</div></body>
</html>
