<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 176.0mm; inline-size: 141.1mm; block-size: 15.6mm; font-size: 14.7pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 193.8mm; inline-size: 143.1mm; block-size: 31.1mm; font-size: 14.7pt"><li>{{ slot_9 }}</li></ul>
