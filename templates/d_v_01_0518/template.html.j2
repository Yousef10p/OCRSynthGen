<footer class="box" style="inset-inline-start: 31.6mm; inset-block-start: 259.7mm; inline-size: 12.1mm; block-size: 15.8mm; font-size: 22.3pt">{{ slot_11 }}</footer><div class="box ph" style="inset-inline-start: 111.1mm; inset-block-start: 261.4mm; inline-size: 11.2mm; block-size: 7.3mm; font-size: 20.7pt"></div>
<footer class="box" style="inset-inline-start: 159.2mm; inset-block-start: 265.4mm; inline-size: 20.1mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
