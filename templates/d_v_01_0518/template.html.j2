<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 72.6mm; inline-size: 147.6mm; block-size: 15.6mm; font-size: 14.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 97.3mm; inline-size: 30.7mm; block-size: 5.4mm; font-size: 15.3pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 104.9mm; inline-size: 135.2mm; block-size: 10.5mm; font-size: 14.8pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 117.6mm; inline-size: 140.2mm; block-size: 10.5mm; font-size: 14.8pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 130.3mm; inline-size: 141.6mm; block-size: 25.7mm; font-size: 14.6pt"><li>{{ slot_6 }}</li></ul>
