}

.logo {
    width: 100px;
    height: 50px;
    background-color: #333;
}

nav a {
    margin-left: 10px;
}

main {
    max-width: 800px;
    margin: 20px auto;
    padding: 20px;
    background-color: #fff;
    box-shadow: 0 0 10px #ccc;
}

.product {
    width: 100%;
    height: 200px;
    margin: 20px 0;
    background-color: #f0f0f0;
}

footer {
