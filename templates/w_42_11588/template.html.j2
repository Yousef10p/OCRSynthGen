    margin-left: 0;
}

header form input {
    margin-left: 10px;
}

main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    margin: 50px;
}

main article {
    width: 45%;
    padding: 20px;
    box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
    transition: 0.3s;
    margin-bottom: 30px;
}

main article:hover {
    box-shadow: 0 8px 16px 0 rgba(0, 0, 0, 0.2);
}

main article .article {
    height: 200px;
    width: 100%;
    background-color: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
