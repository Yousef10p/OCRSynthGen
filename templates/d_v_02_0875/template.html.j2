<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 52.9mm; inline-size: 94.1mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 29.2mm; inset-block-start: 61.7mm; inline-size: 95.9mm; block-size: 136.3mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 203.8mm; inline-size: 62.6mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 29.2mm; inset-block-start: 212.6mm; inline-size: 38.7mm; block-size: 7.2mm; font-size: 10.0pt">{{ slot_6 }}</p>
