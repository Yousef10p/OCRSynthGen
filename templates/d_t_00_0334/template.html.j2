<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 59.9mm; inline-size: 108.8mm; block-size: 21.7mm; font-size: 12.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 85.3mm; inline-size: 121.4mm; block-size: 58.4mm; font-size: 12.7pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 18.9mm; inset-block-start: 120.3mm; inline-size: 14.1mm; block-size: 14.0mm; font-size: 13.2pt"></div>
<p class="box" style="inset-inline-start: 9.4mm; inset-block-start: 143.5mm; inline-size: 33.4mm; block-size: 44.7mm; font-size: 21.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 147.5mm; inline-size: 121.4mm; block-size: 53.8mm; font-size: 12.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 205.1mm; inline-size: 116.4mm; block-size: 40.0mm; font-size: 12.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 248.9mm; inline-size: 110.3mm; block-size: 17.1mm; font-size: 12.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 6.1mm; inset-block-start: 266.9mm; inline-size: 1.7mm; block-size: 1.9mm; font-size: 5.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
