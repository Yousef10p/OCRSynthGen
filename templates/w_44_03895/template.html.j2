<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  font-family: var(--font-body);
}


#slider {
  flex: 3;
  display: flex;
  height: 100px;
  overflow: hidden;
  scroll-behavior: smooth;
}

.slide {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  margin: 5px;
  background-color: #f1f1f1;
  padding: 20px;
  text-align: center;
}

.red, .blue, .green {
  color: #FF0000;
  font-weight: bold;
  text-decoration: none;
}

.blue {
  color: #0000FF;
}

.green {
  color: #008000;
}


#sidebar {
  flex: 1;
  margin-right: 5px;
  padding: 20px;
  background-color: #f1f1f1;
}

#sidebar h2 {
  margin-bottom: 10px;
}

#sidebar ul {
  list-style-type: none;
  padding: 0;
}

#sidebar li {
  margin-bottom: 5px;
}

#sidebar a {
  color: #000000;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="slider">
<div class="slide">{{ slot_0 }} <span class="red">{{ slot_1 }}</span> {{ slot_2 }} <span class="blue">{{ slot_3 }}</span>{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }} <span class="green">{{ slot_6 }}</span>{{ slot_7 }}</div>
<div class="slide">{{ slot_8 }} <span class="blue">{{ slot_9 }}</span></div>
</div>
<div id="sidebar">
<h2>{{ slot_10 }}</h2>
<ul>
<li><span class="blue">{{ slot_11 }}</span></li>
<li><span class="green">{{ slot_12 }}</span></li>
<li><span class="red">{{ slot_13 }}</span></li>
</ul>
<h2>{{ slot_14 }}</h2>
<ul>
<li><a>{{ slot_15 }}</a></li>
<li><a>{{ slot_16 }}</a></li>
<li><a>{{ slot_17 }}</a></li>
</ul>
</div>
</body>
</html>