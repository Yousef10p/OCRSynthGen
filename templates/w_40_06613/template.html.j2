  list-style: none;
  justify-content:center;
}

nav ul li {
  margin: 0 10px;
}

nav ul li a {
  text-decoration: none;
  color: black;
}

nav ul li:hover a {
  color: #555;
}

.content {
  display: flex;
  justify-content: center;
  padding: 50px;
}

.product-features, .customer-reviews {
  margin: 0 50px;
}

.feature, .review {
