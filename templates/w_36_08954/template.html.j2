<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

:root {
 --bg-color: #f2645a;
 --text-color: #fff;
 --button-color: #c83228;
}

body {
 background-color: var(--bg-color);
 color: var(--text-color);
 font-family: var(--font-body);
 margin: 0;
 padding: 0;
}

header {
 display: flex;
 justify-content: space-between;
 align-items: center;
 padding: 20px;
}

header h1 {
 margin: 0;
}

nav ul {
 display: flex;
 list-style: none;
}

nav li {
 margin-left: 20px;
}

nav li:last-child {
 margin-left: 0;
}

nav a {
 color: var(--text-color);
 text-decoration: none;
}

form {
 display: flex;
}

#product-category {
 padding: 20px;
}

#product-grid {
 display: grid;
 grid-template-columns: repeat(3, 1fr);
 grid-gap: 20px;
}

.product {
 background-color: var(--text-color);
 color: var(--bg-color);
 padding: 20px;
 display: flex;
 flex-direction: column;
 align-items: center;
}

.product-image {
 width: 100%;
 height: 200px;
 background-color: #999;
}

form input[type="text"] {
 padding: 10px;
 border: none;
}

form button {
 background-color: var(--button-color);
 color: var(--text-color);
 padding: 10px 20px;
 border: none;
 cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
