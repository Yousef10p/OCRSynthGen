    color: #fff;
    text-decoration: none;
}

main {
    margin-top: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 50px 0;
}

.hero, .hero h1, .hero p {
    width: 100%;
    text-align: center;
    background: #4CAF50;
    color: #fff;
}

.imagery {
    width: 200px;
    height: 200px;
    background: #ddd;
