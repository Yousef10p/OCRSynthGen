}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    background: #4CAF50;
    padding: 10px 0;
    color: #fff;
    text-align: center;
}

footer a {
    color: #fff;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
