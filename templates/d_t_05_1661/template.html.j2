<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 22.0mm; inset-block-start: 20.4mm; inline-size: 34.8mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 27.9mm; inline-size: 155.6mm; block-size: 24.2mm; font-size: 13.7pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 60.9mm; inset-block-start: 53.9mm; inline-size: 81.0mm; block-size: 24.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 79.4mm; inline-size: 159.4mm; block-size: 29.2mm; font-size: 13.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 111.1mm; inline-size: 133.7mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 22.0mm; inset-block-start: 118.0mm; inline-size: 151.7mm; block-size: 9.4mm; font-size: 13.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.0mm; inset-block-start: 129.9mm; inline-size: 107.3mm; block-size: 4.5mm; font-size: 12.7pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.0mm; inset-block-start: 136.8mm; inline-size: 30.3mm; block-size: 4.5mm; font-size: 12.7pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.0mm; inset-block-start: 143.8mm; inline-size: 160.2mm; block-size: 9.4mm; font-size: 13.3pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.0mm; inset-block-start: 155.7mm; inline-size: 118.3mm; block-size: 4.5mm; font-size: 12.7pt"><li>{{ slot_8 }}</li></ul>
<div class="box ph" style="inset-inline-start: 40.8mm; inset-block-start: 165.7mm; inline-size: 123.8mm; block-size: 88.2mm; font-size: 13.9pt"></div>
<footer class="box" style="inset-inline-start: 22.0mm; inset-block-start: 261.1mm; inline-size: 38.9mm; block-size: 13.9mm; font-size: 19.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
