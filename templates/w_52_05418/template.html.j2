<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: #333;
}

nav {
    display: flex;
    justify-content: flex-end;
    padding: 20px;
    background-color: #333;
}

nav ul {
    list-style-type: none;
}

nav ul li {
    display: inline;
    margin-right: 20px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

header {
    padding: 100px;
    text-align: center;
    background-color: #eee;
}

header h1 {
    margin-bottom: 20px;
    font-size: 32px;
}

.cta {
    display: inline-block;
    padding: 10px 20px;
    margin-top: 20px;
    color: #fff;
    background-color: #333;
    text-decoration: none;
    border-radius: 3px;
}

#featured-games {
    padding: 50px;
    text-align: center;
}

#featured-games h2 {
    margin-bottom: 20px;
}

.game {
    display: inline-block;
    width: 25%;
    margin: 20px;
    padding: 20px;
    background-color: #ddd;
    transition: all 0.3s ease;
}

.game:hover {
    background-color: #ccc;
}

.social-media-widget a {
    margin-left: 10px;
}

footer {
    padding: 20px;
    text-align: center;
    background-color: #333;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<header>
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<a class="cta">{{ slot_6 }}</a>
</header>
<section id="featured-games">
<h2>{{ slot_7 }}</h2>
<div class="game">
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
</div>
<div class="game">
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>
<div class="game">
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
</div>
</section>
<footer>
<p>{{ slot_14 }}</p>
<div class="social-media-widget">
<a>{{ slot_15 }}</a>
<a>{{ slot_16 }}</a>
<a>{{ slot_17 }}</a>
<a>{{ slot_18 }}</a>
</div>
</footer>
</body>
</html>