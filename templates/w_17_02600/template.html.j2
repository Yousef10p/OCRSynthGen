<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body {
    font-family: var(--font-body);
    line-height:1.4;
    color:#c0c0c0;
    background-color:#f6f6f6;
}

nav ul {
    display: flex;
    justify-content:space-evenly;
    align-items:center;
    height:40px;
    background-color:#212a25;
    color:#c0c0c0;
}

nav ul li{
    list-style:none;
}

nav ul li a{
    color:#c0c0c0;
    text-decoration:none;
}

header {
    height:90vh;
    background-image:none;
    background-repeat:no-repeat;
    background-size:cover;
    color:#ffffff;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
}

header h1 {
    font-size:2.5em;
    letter-spacing:1px;
    margin-bottom:20px;
}

.btn-dark {
    padding:10px 20px;
    border:2px solid #ffffff;
    color:#ffffff;
    text-decoration:none;
}

footer ul {
    display:flex;
    justify-content:space-around;
    padding:20px;
    background-color:#212a25;
    color:#c0c0c0;
}

footer ul li{
    list-style:none;
}

footer ul li a{
    color:#c0c0c0;
    text-decoration:none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><div class="ph" style="inline-size: 100%; block-size: 150px"></div></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<header>
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<a class="btn-dark">{{ slot_6 }}</a>
</header>
<footer>
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
<ul>
<li><a>{{ slot_16 }}</a></li>
<li><a>{{ slot_17 }}</a></li>
<li><a>{{ slot_18 }}</a></li>
</ul>
</footer>
</body>
</html>