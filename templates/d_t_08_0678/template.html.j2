<div class="box ph" style="inset-inline-start: 72.0mm; inset-block-start: 131.7mm; inline-size: 115.9mm; block-size: 5.3mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 143.6mm; inline-size: 118.0mm; block-size: 4.8mm; font-size: 10.9pt">{{ slot_4 }}</p>
