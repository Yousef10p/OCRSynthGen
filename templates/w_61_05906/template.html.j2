<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<main>
<div class="hero">
<div class="hero-text">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<button>{{ slot_6 }}</button>
</div>
<div class="hero-image ph"></div>
</div>
<div class="grid-container">
<div class="grid-item">{{ slot_7 }}</div>
<div class="grid-item">{{ slot_8 }}</div>
<div class="grid-item">{{ slot_9 }}</div>

</div>
</main>
<footer>
<p>{{ slot_10 }}</p>
<ul>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</footer>
</body>
</html>