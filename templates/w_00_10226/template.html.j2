    flex-direction: column;
}

input, textarea, form button {
    margin-bottom: 10px;
    padding: 5px;
}

input[type="submit"] {
    cursor: pointer;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
