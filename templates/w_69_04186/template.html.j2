<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

.header {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px 0;
}

.menu-column {
    width: 20%;
    float: right;
    padding: 10px;
    background-color: #f0f0f0;
    min-height: 500px;
}

.menu-column h2 {
    margin-bottom: 15px;
}

.menu-column ul {
    list-style-type: none;
    padding: 0;
}

.menu-column li {
    margin-bottom: 5px;
}

.menu-column a {
    color: #333;
    text-decoration: none;
}

.content-column {
    width: 80%;
    float: right;
    padding: 10px;
    min-height: 500px;
}

.service {
    margin-bottom: 20px;
}

.service h2 {
    color: #333;
    margin-bottom: 10px;
}

.service p {
    color: #666;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
</div>
<div class="menu-column">
<h2>{{ slot_1 }}</h2>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</div>
<div class="content-column">
<div class="service">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="service">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
<div class="service">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</div>
<div class="service">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
<div class="service">
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
</div>
</body>
</html>