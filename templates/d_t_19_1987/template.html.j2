<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 11.7mm; inline-size: 56.4mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 24.7mm; inline-size: 67.2mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 120.9mm; inset-block-start: 26.0mm; inline-size: 8.5mm; block-size: 2.8mm; font-size: 8.1pt">{{ slot_2 }}</h2>
<ul class="box" style="inset-inline-start: 115.9mm; inset-block-start: 33.5mm; inline-size: 69.8mm; block-size: 7.4mm; font-size: 10.4pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 36.3mm; inline-size: 74.5mm; block-size: 11.6mm; font-size: 11.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 115.9mm; inset-block-start: 42.0mm; inline-size: 75.2mm; block-size: 28.5mm; font-size: 11.6pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 38.9mm; inset-block-start: 52.8mm; inline-size: 52.6mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 28.0mm; inset-block-start: 75.1mm; inline-size: 72.1mm; block-size: 153.9mm; font-size: 24.2pt"></div>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 270.2mm; inline-size: 3.9mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 1.1mm; inset-block-start: 274.9mm; inline-size: 74.4mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_8 }}</footer>
</div></body>
</html>
