}
.content {
    width: 70%;
    margin: 0 auto;
}
.post {
    border-bottom: 1px solid #f0f0f0;
    padding: 20px 0;
}
img {
    width: 100%;
    height: 100px; 
    display: block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
