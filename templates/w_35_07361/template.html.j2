}
.menu > li > ul {
    position: absolute;
    display: none;
    background: #f8f8f8;
    padding: 10px;
}
.menu > li:hover > ul {
    display: block;
}
.menu > li > ul > li {
    margin: 5px 0;
}
.sidebar {
    position: fixed;
    left: 0;
    width: 200px;
    background: #f0f0f0;
    padding: 20px;
}
.featured-post, .comment {
    margin-bottom: 10px;
}
.comment {
