<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 13.9mm; inset-block-start: 8.7mm; inline-size: 67.1mm; block-size: 2.0mm; font-size: 5.5pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 35.6mm; inset-block-start: 39.4mm; inline-size: 135.9mm; block-size: 6.3mm; font-size: 8.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 35.6mm; inset-block-start: 50.1mm; inline-size: 140.9mm; block-size: 20.1mm; font-size: 11.4pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 35.6mm; inset-block-start: 73.9mm; inline-size: 144.6mm; block-size: 2.9mm; font-size: 8.1pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 35.6mm; inset-block-start: 80.4mm; inline-size: 140.3mm; block-size: 6.6mm; font-size: 9.3pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 59.6mm; inset-block-start: 99.5mm; inline-size: 30.4mm; block-size: 3.4mm; font-size: 9.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 127.0mm; inset-block-start: 99.5mm; inline-size: 31.6mm; block-size: 3.4mm; font-size: 9.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 58.0mm; inset-block-start: 104.6mm; inline-size: 29.6mm; block-size: 10.3mm; font-size: 9.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 125.3mm; inset-block-start: 104.6mm; inline-size: 29.1mm; block-size: 10.3mm; font-size: 9.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 106.7mm; inset-block-start: 249.7mm; inline-size: 2.6mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_9 }}</footer>
</div></body>
</html>
