<div class="box ph" style="inset-inline-start: 25.5mm; inset-block-start: 84.0mm; inline-size: 110.4mm; block-size: 22.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 111.5mm; inline-size: 30.5mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 52.6mm; inset-block-start: 123.6mm; inline-size: 107.6mm; block-size: 12.7mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 136.8mm; inline-size: 162.1mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 64.3mm; inset-block-start: 155.0mm; inline-size: 84.3mm; block-size: 15.0mm; font-size: 12.0pt"></div>
