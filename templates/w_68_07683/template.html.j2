<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

.hero {
    position: relative;
    height: 60vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.hero-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1em;
}

.image-placeholder {
    width: 400px;
    height: 300px;
    background-color: lightgray;
}

.left-sidebar, .right-sidebar {
    position: absolute;
    top: 0;
    height: 100vh;
    width: 20%;
    padding: 2em;
    box-sizing: border-box;
}

.left-sidebar {
    right: 0;
}

.right-sidebar {
    left: 0;
}

.left-sidebar h2, .right-sidebar h2 {
    margin-bottom: 0.5em;
}

.left-sidebar ul, .right-sidebar p {
    margin-top: 0.5em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<div class="hero-demo">
<div class="image-placeholder ph"></div>
<p>{{ slot_0 }}</p>
</div>
</div>
<div class="left-sidebar">
<h2>{{ slot_1 }}</h2>
<ul>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
<h2>{{ slot_5 }}</h2>
<ul>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
</ul>
</div>
<div class="right-sidebar">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>