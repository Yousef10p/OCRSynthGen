<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 40.1mm; inset-block-start: 30.0mm; inline-size: 96.9mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 45.8mm; inline-size: 137.0mm; block-size: 54.0mm; font-size: 19.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 103.6mm; inline-size: 136.8mm; block-size: 10.7mm; font-size: 15.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 53.4mm; inset-block-start: 118.0mm; inline-size: 122.0mm; block-size: 17.9mm; font-size: 16.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 0.7mm; inset-block-start: 119.8mm; inline-size: 45.6mm; block-size: 36.9mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 53.4mm; inset-block-start: 139.7mm; inline-size: 122.0mm; block-size: 17.9mm; font-size: 16.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 161.4mm; inline-size: 137.2mm; block-size: 68.4mm; font-size: 19.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 233.6mm; inline-size: 135.3mm; block-size: 17.9mm; font-size: 16.9pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 86.0mm; inset-block-start: 263.2mm; inline-size: 43.8mm; block-size: 6.4mm; font-size: 18.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
