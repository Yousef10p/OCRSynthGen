<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: var(--font-body);
}


.hero {
  position: relative;
}
.hero img {
  width: 100%;
  height: 500px;
  object-fit: cover;
}
.logo {
  position: absolute;
  top: 50%;
  right: 50%;
  transform: translate(50%, -50%);
  width: 150px;
}
.logo img {
  width: 100%;
  height: auto;
}


.menu-container {
  display: flex;
  justify-content: center;
  margin: 20px 0;
}
.menu-column {
  flex: 1;
  padding: 20px;
  background-color: #f2f2f2;
  margin: 0 10px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}
ul {
  list-style-type: circle;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<div class="logo ph"></div>
<div class="menu-container">
<div class="menu-column">
<h2>{{ slot_0 }}</h2>
<p>{{ slot_1 }}</p>
<ul>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</div>
<div class="menu-column">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
</div>
<div class="menu-column">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</div>
</div>
</body>
</html>