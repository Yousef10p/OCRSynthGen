    display: flex;
}

form input {
    margin-left: 10px;
}

.cta {
    display: block;
    color: white;
    background-color: blue;
    padding: 10px 20px;
    text-decoration: none;
}

main {
    padding: 20px;
}

.listings {
    list-style-type: none;
    padding: 0;
}

footer ul {
    display: flex;
    justify-content: space-between;
    padding: 20px;
    background-color: #ddd;
}

footer a {
    color: blue;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
