<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 23.0mm; inset-block-start: 60.6mm; inline-size: 116.3mm; block-size: 20.5mm; font-size: 11.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 23.0mm; inset-block-start: 152.3mm; inline-size: 79.3mm; block-size: 44.2mm; font-size: 13.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 111.0mm; inset-block-start: 152.3mm; inline-size: 73.3mm; block-size: 13.6mm; font-size: 12.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 111.0mm; inset-block-start: 169.5mm; inline-size: 77.8mm; block-size: 39.1mm; font-size: 13.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 23.0mm; inset-block-start: 200.1mm; inline-size: 78.5mm; block-size: 64.6mm; font-size: 14.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 111.0mm; inset-block-start: 212.1mm; inline-size: 79.2mm; block-size: 28.9mm; font-size: 13.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 111.0mm; inset-block-start: 244.6mm; inline-size: 78.9mm; block-size: 13.6mm; font-size: 12.8pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 102.4mm; inset-block-start: 276.4mm; inline-size: 8.5mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_7 }}</footer>
</div></body>
</html>
