<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 116.5mm; inset-block-start: 20.0mm; inline-size: 54.6mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 40.3mm; inline-size: 139.3mm; block-size: 33.8mm; font-size: 15.9pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 170.1mm; inset-block-start: 40.7mm; inline-size: 20.6mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 82.8mm; inline-size: 139.3mm; block-size: 33.8mm; font-size: 15.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 125.3mm; inline-size: 139.2mm; block-size: 21.6mm; font-size: 15.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 155.6mm; inline-size: 139.3mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 173.8mm; inline-size: 131.0mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 168.6mm; inset-block-start: 174.1mm; inline-size: 22.0mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 179.9mm; inline-size: 140.2mm; block-size: 39.8mm; font-size: 16.1pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 228.4mm; inline-size: 139.3mm; block-size: 45.9mm; font-size: 16.3pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 185.9mm; inset-block-start: 271.8mm; inline-size: 1.6mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_10 }}</footer><div class="box ph" style="inset-inline-start: 180.9mm; inset-block-start: 276.2mm; inline-size: 18.8mm; block-size: 15.8mm; font-size: 40.0pt"></div>
</div></body>
</html>
