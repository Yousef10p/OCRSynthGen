<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
<div class="featured-products">
<h2>{{ slot_6 }}</h2>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</div>
<div class="promotions">
<h2>{{ slot_11 }}</h2>
<div class="promo">{{ slot_12 }}</div>
<div class="promo">{{ slot_13 }}</div>
</div>
<div class="slider">
<div class="slide">{{ slot_14 }}</div>
<div class="slide">{{ slot_15 }}</div>
<div class="slide">{{ slot_16 }}</div>
</div>
</div>
</body>
</html>