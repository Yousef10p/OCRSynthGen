<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 22.5mm; inset-block-start: 20.0mm; inline-size: 26.2mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 148.1mm; inset-block-start: 20.0mm; inline-size: 40.7mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 24.9mm; inset-block-start: 29.9mm; inline-size: 154.6mm; block-size: 28.9mm; font-size: 20.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 61.2mm; inline-size: 154.1mm; block-size: 12.8mm; font-size: 18.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 76.2mm; inline-size: 154.2mm; block-size: 28.4mm; font-size: 20.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.3mm; inset-block-start: 106.9mm; inline-size: 154.1mm; block-size: 66.2mm; font-size: 20.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 175.4mm; inline-size: 154.1mm; block-size: 28.0mm; font-size: 19.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 206.1mm; inline-size: 154.1mm; block-size: 43.5mm; font-size: 20.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.6mm; inset-block-start: 251.5mm; inline-size: 153.7mm; block-size: 21.5mm; font-size: 20.3pt">{{ slot_8 }}</p>
</div></body>
</html>
