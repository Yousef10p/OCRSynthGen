    color: #fff;
    margin: 0 10px;
    text-decoration: none;
}

.content {
    display: flex;
    margin-top: 20px;
}

.main {
    flex: 70%;
    padding: 0 20px;
}

.sidebar {
    flex: 30%;
    padding: 0 20px;
    background-color: #eee;
}

.widget {
    margin: 20px 0;
}

.widget ul {
    list-style: none;
    padding: 0;
}

.widget li {
    margin: 5px 0;
}

.footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
}

.social {
    background-color: #4267B2;
    color: #fff;
    padding: 10px 20px;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
