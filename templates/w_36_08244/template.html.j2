    padding: 20px;
}

nav ul {
    list-style-type: none;
}

nav ul li {
    display: inline;
    margin-left: 20px;
}

.hero {
    height: 400px;
    padding: 50px;
    background-color: #eee;
    text-align: center;
}

.hero button {
    margin-left: 10px;
}

button {
    background-color: blue;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
}

.outline {
    background-color: transparent;
    border: 1px solid blue;
    color: blue;
}

.service {
    width: 30%;
    float: right;
    text-align: center;
}

.service-img {
    width: 100%;
    height: 200px;
    background-color: #ddd;
}

.hero, .services, .about, .support {
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
