<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    background: #f2f2f2;
    font-family: var(--font-body);
}
.fullscreen-image {
    position:fixed; top:0px;right:0px;width:100%;height:100%;
    z-index:-1; 
    background: none no-repeat center center;
    background-size:cover;
}
.fixed-nav {
    position:fixed; top:0px; right:0px;
    background:blue;
    width:100%;
    padding:15px 0;
    color:#fff;
    text-align:center;
}
.fixed-nav ul {
    list-style:none;
    text-align:center;
    padding:0.5em 0;
}
.fixed-nav ul li {
    display:inline-block;
    margin:0 10px;
}
.fixed-nav a {
    color:#fff;
    text-decoration:none;
    font-size:1.3em;
    font-weight:800;
}
.content {
    margin:50px 10px;
}
.sidebar {
    float:left;
    background:#fff;
    width:25%;
    padding:20px;
    position:fixed;
    top:50px;
    left:0;
    bottom:0;
    overflow:auto;
}
.sidebar h4 {
    border-bottom:3px solid blue;
    padding-bottom:5px;
    margin-bottom:10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="fullscreen-image ph"></div>
<nav class="fixed-nav">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div class="content">
<h1>{{ slot_4 }}</h1>
<a><div style="background:red;color:#000;width:200px;height:100px;">{{ slot_5 }}</div></a>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="sidebar">
<h4>{{ slot_9 }}</h4>
<p>{{ slot_10 }}</p>
<h4>{{ slot_11 }}</h4>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</div>
</body>
</html>