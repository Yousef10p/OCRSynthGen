<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 143.9mm; inset-block-start: 12.3mm; inline-size: 57.2mm; block-size: 16.3mm; font-size: 15.4pt"></div>
<h1 class="box" style="inset-inline-start: 15.8mm; inset-block-start: 38.9mm; inline-size: 169.0mm; block-size: 30.3mm; font-size: 40.0pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 106.5mm; inline-size: 26.5mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 115.0mm; inline-size: 21.0mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 123.4mm; inline-size: 36.1mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 131.9mm; inline-size: 41.9mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 140.4mm; inline-size: 29.5mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 15.7mm; inset-block-start: 204.9mm; inline-size: 37.4mm; block-size: 12.7mm; font-size: 18.0pt"></div>
<div class="box ph" style="inset-inline-start: 15.4mm; inset-block-start: 227.6mm; inline-size: 37.5mm; block-size: 9.5mm; font-size: 13.4pt"></div>
<div class="box ph" style="inset-inline-start: 16.1mm; inset-block-start: 258.0mm; inline-size: 29.9mm; block-size: 13.1mm; font-size: 18.5pt"></div>
<div class="box ph" style="inset-inline-start: 162.0mm; inset-block-start: 261.2mm; inline-size: 40.8mm; block-size: 9.3mm; font-size: 26.4pt"></div>
</div></body>
</html>
