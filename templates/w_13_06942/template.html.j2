<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
}

.row::after {
    content: "";
    clear: both;
    display: table;
}

.column {
    width: 48%;
    padding: 15px;
    float: right;
}

.column.right {
    width: 50%;
}

.column.left {
    width: auto;
}

.image-placeholder {
    width: 100%;
    height: 150px;
    background-color: #ddd;
}

form {
    margin-top: 15px;
}

input[type="text"], textarea {
    width: 100%;
    padding: 10px;
    margin: 5px 0 10px 0;
}

input[type="submit"] {
    padding: 10px;
    background-color: #ddd;
    border: none;
    cursor: pointer;
}

.footer {
    position: fixed;
    right: 0;
    bottom: 0;
    width: 100%;
    background-color: #ddd;
    text-align: center;
}

.footer ul {
    list-style-type: none;
    padding: 15px;
}

.footer ul li {
    display: inline;
    padding: 0 15px;
}

.footer p {
    padding: 15px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="row">
<div class="column left">
<h2>{{ slot_0 }}</h2>
<p>{{ slot_1 }}</p>
</div>
<div class="column right">
<div class="financial-services">
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<div class="image-placeholder ph"></div>
</div>
<div class="contact-us">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_6 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_8 }}</span>
<span class="">{{ slot_9 }}</span>
</form>
</div>
</div>
</div>
<div class="footer">
<p>{{ slot_10 }}</p>
<ul>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
</ul>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>