<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background-color: #f4f4f4;
}
.menu {
  float: right;
  width: 200px;
  background-color: #f4f4f4;
  padding: 20px 0;
}
.menu ul {
  list-style: none;
  padding: 0;
}
.menu li a {
  display: block;
  padding: 10px;
  text-decoration: none;
  color: #333;
}
.featured {
  margin-right: 220px;
  padding: 20px;
}
.featured h1 {
  color: #333;
  margin-bottom: 20px;
}
.specials, .cuisine, .ambiance {
  margin-bottom: 40px;
}
.specials h3, .cuisine h3, .ambiance h3 {
  color: #333;
  margin-bottom: 10px;
}
.specials p, .cuisine p, .ambiance p {
  color: #666;
  margin-bottom: 20px;
}
.image {
  background-color: #999;
  height: 150px;
  margin-bottom: 20px;
  color: #fff;
  text-align: center;
  padding-top: 60px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu">
<h4>{{ slot_0 }}</h4>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="featured">
<h1>{{ slot_5 }}</h1>
<div class="specials">
<h3>{{ slot_6 }}</h3>
<p>{{ slot_7 }}</p>
<div class="image">{{ slot_8 }}</div>
</div>
<div class="cuisine">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<div class="image">{{ slot_11 }}</div>
</div>
<div class="ambiance">
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<div class="image">{{ slot_14 }}</div>
</div>
</div>
</body>
</html>