<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 102.9mm; inset-block-start: 22.6mm; inline-size: 93.8mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 51.2mm; inline-size: 145.4mm; block-size: 27.4mm; font-size: 11.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 81.7mm; inline-size: 145.4mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 95.9mm; inline-size: 145.4mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 110.2mm; inline-size: 145.4mm; block-size: 19.2mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 132.6mm; inline-size: 145.4mm; block-size: 15.2mm; font-size: 10.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 150.9mm; inline-size: 145.4mm; block-size: 35.5mm; font-size: 11.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 189.6mm; inline-size: 145.4mm; block-size: 63.9mm; font-size: 11.3pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 141.6mm; inset-block-start: 264.7mm; inline-size: 61.0mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_8 }}</footer>
</div></body>
</html>
