  padding: 1em 0;
}

.logo {
  background-color: blue;
  color: white;
  height: 50px;
  width: 100px;
}

.nav ul {
  display: flex;
  margin: 0;
  padding: 0;
  list-style: none;
}

.nav li {
  margin: 0 1em;
}

.search {
  margin: 1em;
}

.products, .reviews {
  margin: 1em;
}

.product-item, .review-item {
  height: 100px;
  width: 200px;
  margin: 1em 0;
  background-color: blue;
  color: white;
  text-align: center;
  line-height: 100px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
