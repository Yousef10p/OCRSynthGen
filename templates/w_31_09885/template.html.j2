<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  font-family: var(--font-body);
}

nav {
  background-color: #f2f2f2;
  width: 200px;
  padding: 10px;
}

nav input[type="text"] {
  width: 100%;
  padding: 10px;
  margin-bottom: 10px;
}

nav ul {
  list-style: none;
  padding: 0;
}

nav li a {
  color: #333;
  text-decoration: none;
}

section {
  flex-grow: 1;
  padding: 20px;
}

article {
  margin-bottom: 20px;
}

aside {
  background-color: #f2f2f2;
  width: 200px;
  padding: 10px;
}

aside ul {
  list-style: none;
  padding: 0;
}

aside li a {
  color: #333;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<h3>{{ slot_1 }}</h3>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<section>
<article>
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</article>
<article>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</article>
<article>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</article>
</section>
<aside>
<h3>{{ slot_11 }}</h3>
<ul>
