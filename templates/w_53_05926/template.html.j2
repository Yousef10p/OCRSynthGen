<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
}

nav {
    background: lightgray;
    position: fixed;
    width: 200px;
    height: 100%;
    padding: 20px;
}

nav ul {
    list-style-type: none;
    padding-right: 0;
}

nav ul li a {
    display: block;
    margin-bottom: 10px;
}

header {
    position: relative;
}

#map {
    width: calc(100% - 200px);
    height: 100vh;
    margin-right: 200px;
}

#destinations {
    margin-right: 200px;
    position: relative;
    padding: 20px;
}

article {
    border: solid 1px gray;
    margin-bottom: 20px;
    padding: 20px;
}

h2, p {
    margin: 0 0 10px 0;
}

.marker {
    width: 20px;
    height: 20px;
    background: red;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<main>
<div id="map">
<div class="marker" id="paris">{{ slot_4 }}</div>
<div class="marker" id="london">{{ slot_5 }}</div>
<div class="marker" id="newYork">{{ slot_6 }}</div>
<div class="marker" id="tokyo">{{ slot_7 }}</div>
</div>
<section id="destinations">
<article id="paris">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</article>
<article id="london">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</article>
<article id="newYork">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</article>
<article id="tokyo">
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</article>
</section>
</main>
</body>
</html>