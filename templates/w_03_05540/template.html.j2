}

.product article h3 {
    margin: 0;
    margin-left: 20px;
    font-size: 1.2em;
}

.product-image {
    background-color: #ddd;
    height: 100px;
    width: 100px;
}

footer {
    text-align: center;
    background-color: #f8f8f8;
    padding: 10px 0;
    position: absolute;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
