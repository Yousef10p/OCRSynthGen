<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 171.9mm; inset-block-start: 9.3mm; inline-size: 28.9mm; block-size: 11.6mm; font-size: 16.5pt"></div>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 29.4mm; inline-size: 205.5mm; block-size: 115.9mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 148.2mm; inline-size: 164.5mm; block-size: 6.1mm; font-size: 8.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 160.0mm; inline-size: 52.6mm; block-size: 32.8mm; font-size: 13.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 160.0mm; inline-size: 51.3mm; block-size: 12.9mm; font-size: 12.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 141.7mm; inset-block-start: 160.0mm; inline-size: 48.2mm; block-size: 26.1mm; font-size: 12.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 177.5mm; inline-size: 53.0mm; block-size: 45.8mm; font-size: 13.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 198.5mm; inline-size: 29.6mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 204.3mm; inline-size: 51.2mm; block-size: 28.1mm; font-size: 13.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 227.9mm; inline-size: 54.1mm; block-size: 49.9mm; font-size: 12.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 237.9mm; inline-size: 52.5mm; block-size: 22.0mm; font-size: 12.5pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 264.7mm; inline-size: 51.7mm; block-size: 13.0mm; font-size: 12.3pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 91.2mm; inset-block-start: 285.2mm; inline-size: 110.8mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_10 }}</footer>
</div></body>
</html>
