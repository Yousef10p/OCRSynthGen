<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.8mm; inset-block-start: 5.8mm; inline-size: 2.1mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 58.2mm; inset-block-start: 14.6mm; inline-size: 31.4mm; block-size: 25.2mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 48.2mm; inline-size: 41.2mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 55.4mm; inline-size: 111.8mm; block-size: 16.9mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 74.9mm; inline-size: 110.7mm; block-size: 12.8mm; font-size: 12.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 90.4mm; inline-size: 108.1mm; block-size: 16.9mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 109.9mm; inline-size: 111.7mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 121.3mm; inline-size: 13.0mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 17.1mm; inset-block-start: 129.6mm; inline-size: 39.5mm; block-size: 10.2mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 140.8mm; inline-size: 45.0mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_7 }}</p>
</div></body>
</html>
