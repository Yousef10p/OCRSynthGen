<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 73.2mm; inline-size: 80.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 38.5mm; inset-block-start: 83.0mm; inline-size: 126.0mm; block-size: 18.8mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 107.7mm; inline-size: 33.7mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 47.8mm; inset-block-start: 117.5mm; inline-size: 107.4mm; block-size: 10.0mm; font-size: 10.0pt"></div>
