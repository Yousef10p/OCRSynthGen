<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #333;
    color: #fff;
    padding: 10px;
}

.logo {
    font-size: 2em;
}

nav ul {
    list-style-type: none;
    display: flex;
}

nav ul li {
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

.split-screen {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
}

.split-screen > div {
    border: 1px solid #333;
    padding: 10px;
    margin: 10px;
}

a {
    color: #333;
    text-decoration: none;
}

footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
}


.scores, .player-profiles, .game-schedules {
    height: 400px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<section class="split-screen">
<div class="scores">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
</div>
<div class="player-profiles">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
</div>
<div class="game-schedules">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
</div>
</section>
<footer>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
<a>{{ slot_16 }}</a>
</footer>
</body>
</html>