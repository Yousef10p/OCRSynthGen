<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  background: #f4f4f4;
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background: #333;
  color: #fff;
}

.logo {
  height: 100px;
  width: 100px;
  background: linear-gradient(-45deg, blue, red);
}

.nav-bar ul {
  display: flex;
  list-style: none;
}

.nav-bar ul li{
  margin: 0 15px;
}

.nav-bar ul li a {
  text-decoration: none;
  color: #fff;
  text-transform: uppercase;
}

.destination, .package {
  height: 200px;
  width: 300px;
  background: linear-gradient(-45deg, yellow, green);
  margin: 20px;
}

.review {
  margin: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo ph" style="inline-size: 100%; block-size: 150px"></div> 
<nav class="nav-bar">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</div>
<div class="main-content">
<div class="destinations" id="destinations">
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>

<div class="destination" id="destination1">{{ slot_5 }}</div>
<div class="destination" id="destination2">{{ slot_6 }}</div>
<div class="destination" id="destination3">{{ slot_7 }}</div>
</div>
<div class="travel-packages" id="travel-packages">
<h2>{{ slot_8 }}</h2>
