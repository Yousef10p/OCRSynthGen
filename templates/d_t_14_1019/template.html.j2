<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 25.0mm; inset-block-start: 9.7mm; inline-size: 37.5mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 177.8mm; inset-block-start: 9.7mm; inline-size: 7.9mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 22.5mm; inset-block-start: 20.0mm; inline-size: 152.1mm; block-size: 165.0mm; font-size: 21.3pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 193.4mm; inline-size: 161.4mm; block-size: 10.6mm; font-size: 15.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 33.5mm; inset-block-start: 208.0mm; inline-size: 49.8mm; block-size: 6.9mm; font-size: 19.4pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 33.5mm; inset-block-start: 218.7mm; inline-size: 114.0mm; block-size: 5.9mm; font-size: 16.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 228.5mm; inline-size: 55.2mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 31.4mm; inset-block-start: 238.3mm; inline-size: 155.4mm; block-size: 10.6mm; font-size: 10.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.4mm; inset-block-start: 248.1mm; inline-size: 74.8mm; block-size: 5.7mm; font-size: 8.1pt"><li>{{ slot_7 }}</li></ul>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 267.1mm; inline-size: 90.7mm; block-size: 5.2mm; font-size: 14.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 102.9mm; inset-block-start: 281.7mm; inline-size: 5.3mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
