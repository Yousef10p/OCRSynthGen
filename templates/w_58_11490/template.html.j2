<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  display: grid;
  grid-template-areas:
    "header header header"
    "main-image menu"
    "about contact"
    "footer footer";
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto auto auto;
  grid-gap: 10px;
}

.header {
  grid-area: header;
  background: lightblue;
  padding: 10px;
}

.main-image {
  grid-area: main-image;
  background: lightgray;
  padding: 10px;
}

.menu {
  grid-area: menu;
  background: lightgreen;
  padding: 10px;
}

.menu-item {
  background: white;
  margin: 5px;
  padding: 5px;
}

.about {
  grid-area: about;
  background: lightpink;
  padding: 10px;
}

.contact {
  grid-area: contact;
  background: lightyellow;
  padding: 10px;
}

.footer {
  grid-area: footer;
  background: lightcoral;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="grid">
<div class="header">
<h1>{{ slot_0 }}</h1>
</div>
<div class="main-image">
<h2>{{ slot_1 }}</h2> 
</div>
<div class="menu">
<h1>{{ slot_2 }}</h1>
<div class="menu-item">{{ slot_3 }}</div>
<div class="menu-item">{{ slot_4 }}</div>
<div class="menu-item">{{ slot_5 }}</div>
<div class="menu-item">{{ slot_6 }}</div>
<div class="menu-item">{{ slot_7 }}</div>
<div class="menu-item">{{ slot_8 }}</div>
</div>
<div class="about">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
</div>
<div class="contact">
<h1>{{ slot_11 }}</h1>
<p>{{ slot_12 }}</p>
</div>
<div class="footer">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>