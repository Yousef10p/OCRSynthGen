.ph { background: #d0d0d0; }

*{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body{
  font-family: var(--font-body);
}

header, main, footer{
  max-width: 1024px;
  margin: auto;
  padding: 20px;
}

nav{
  display: flex;
  justify-content: space-around;
  margin-bottom: 20px;
}

header{
  text-align: center;
  margin-bottom: 20px;
}

form{
  display: grid;
  grid-template-columns: auto auto;
  gap: 10px;
  margin-bottom: 20px;
}

button{
  grid-column: span 2;
}

footer{
  position: fixed;
  bottom: 0;
  width: 100%;
  text-align: center;
  background-color: #f8f8f8;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
