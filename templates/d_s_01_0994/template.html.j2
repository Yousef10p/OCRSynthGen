<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 57.0mm; inset-block-start: 23.0mm; inline-size: 128.3mm; block-size: 12.0mm; font-size: 11.4pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 57.0mm; inset-block-start: 38.9mm; inline-size: 74.2mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 57.0mm; inset-block-start: 43.1mm; inline-size: 127.7mm; block-size: 16.2mm; font-size: 11.5pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 57.0mm; inset-block-start: 60.5mm; inline-size: 60.2mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 57.9mm; inset-block-start: 76.3mm; inline-size: 24.2mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 58.6mm; inset-block-start: 97.5mm; inline-size: 63.4mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 57.9mm; inset-block-start: 117.5mm; inline-size: 24.2mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 57.0mm; inset-block-start: 138.1mm; inline-size: 128.7mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 21.1mm; inset-block-start: 264.0mm; inline-size: 57.9mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_8 }}</footer>
</div></body>
</html>
