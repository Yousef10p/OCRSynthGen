}

section#slideshow h2 {
    text-align: center;
}

section#slideshow .slideshow-images {
    display: flex;
    justify-content: center;
}

section#slideshow .slideshow-images .slide {
    width: 50px;
    height: 50px;
    background-color: #999;
    margin: 10px;
}

section#slideshow .slideshow-controls {
    text-align: center;
}

section#slideshow .slideshow-controls button {
    margin: 0 10px;
}


footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
