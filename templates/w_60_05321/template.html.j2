}

nav ul {
    list-style-type: none;
    padding: 0;
    text-align: center;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}


main {
    display: flex;
    justify-content: space-between;
    padding: 20px;
}

section {
    width: 30%;
}

section#products {
    text-align: left;
}

section#slideshow {
