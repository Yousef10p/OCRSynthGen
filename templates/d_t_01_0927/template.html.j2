<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 155.2mm; inset-block-start: 64.4mm; inline-size: 43.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 3.2mm; inset-block-start: 69.5mm; inline-size: 203.0mm; block-size: 56.8mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 31.1mm; inset-block-start: 137.6mm; inline-size: 80.4mm; block-size: 26.6mm; font-size: 10.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 118.4mm; inset-block-start: 137.6mm; inline-size: 80.5mm; block-size: 38.6mm; font-size: 10.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.1mm; inset-block-start: 167.5mm; inline-size: 81.6mm; block-size: 46.5mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 118.4mm; inset-block-start: 179.5mm; inline-size: 80.4mm; block-size: 38.6mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.1mm; inset-block-start: 217.3mm; inline-size: 81.7mm; block-size: 46.5mm; font-size: 11.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 118.4mm; inset-block-start: 221.3mm; inline-size: 80.4mm; block-size: 34.6mm; font-size: 10.9pt">{{ slot_6 }}</p>
</div></body>
</html>
