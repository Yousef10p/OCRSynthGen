<h2 class="box" style="inset-inline-start: 114.2mm; inset-block-start: 118.5mm; inline-size: 80.4mm; block-size: 8.3mm; font-size: 11.8pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 128.5mm; inline-size: 83.4mm; block-size: 22.3mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 114.2mm; inset-block-start: 128.5mm; inline-size: 84.0mm; block-size: 72.4mm; font-size: 12.8pt">{{ slot_6 }}</p>
