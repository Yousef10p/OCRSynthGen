<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 14.7mm; inset-block-start: 21.5mm; inline-size: 42.2mm; block-size: 10.8mm; font-size: 15.3pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 75.6mm; inset-block-start: 22.1mm; inline-size: 41.3mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 136.4mm; inset-block-start: 22.6mm; inline-size: 55.8mm; block-size: 58.7mm; font-size: 13.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 75.6mm; inset-block-start: 32.6mm; inline-size: 53.7mm; block-size: 23.5mm; font-size: 13.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 75.6mm; inset-block-start: 57.7mm; inline-size: 55.4mm; block-size: 53.7mm; font-size: 13.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 136.4mm; inset-block-start: 82.8mm; inline-size: 54.8mm; block-size: 43.6mm; font-size: 13.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 75.6mm; inset-block-start: 112.9mm; inline-size: 53.7mm; block-size: 13.5mm; font-size: 12.8pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 14.7mm; inset-block-start: 141.8mm; inline-size: 137.7mm; block-size: 25.4mm; font-size: 24.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 14.7mm; inset-block-start: 169.9mm; inline-size: 146.2mm; block-size: 20.6mm; font-size: 14.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 14.7mm; inset-block-start: 260.7mm; inline-size: 51.2mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_9 }}</footer>
</div></body>
</html>
