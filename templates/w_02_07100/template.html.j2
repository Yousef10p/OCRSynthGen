<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="content">
<h1>{{ slot_6 }}</h1>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="product">{{ slot_9 }}</div>
<div class="product">{{ slot_10 }}</div>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<div class="service">{{ slot_13 }}</div>
<div class="service">{{ slot_14 }}</div>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<div class="support">{{ slot_17 }}</div>
<div class="support">{{ slot_18 }}</div>
<h2>{{ slot_19 }}</h2>
<p>{{ slot_20 }}</p>
<div class="testimonial">{{ slot_21 }}</div>
<div class="testimonial">{{ slot_22 }}</div>
</div>
</div>
<div class="footer">
<h2>{{ slot_23 }}</h2>
</div>
</body>
</html>