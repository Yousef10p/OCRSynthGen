    right: 0;
    width: 100%;
    background: #333;
    color: #fff;
}
nav ul {
    list-style-type: none;
    padding: 0;
}
nav ul li {
    display: inline;
    margin-left: 10px;
}
nav ul li a {
    color: #fff;
