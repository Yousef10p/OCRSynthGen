<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 27.6mm; inset-block-start: 22.1mm; inline-size: 68.6mm; block-size: 11.6mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 38.6mm; inline-size: 63.5mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 46.9mm; inline-size: 73.5mm; block-size: 36.2mm; font-size: 11.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 88.3mm; inline-size: 73.6mm; block-size: 44.5mm; font-size: 11.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 138.0mm; inline-size: 74.0mm; block-size: 32.0mm; font-size: 11.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 175.2mm; inline-size: 73.9mm; block-size: 48.6mm; font-size: 11.5pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 27.8mm; inset-block-start: 231.2mm; inline-size: 38.9mm; block-size: 5.3mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 240.1mm; inline-size: 19.2mm; block-size: 6.5mm; font-size: 9.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 106.2mm; inset-block-start: 261.9mm; inline-size: 3.5mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
