footer { background-color: #333; color: #fff; position: fixed; bottom: 0; width: 100%; padding: 10px; }
.footer-content { display: flex; justify-content: space-between; align-items: center; }
.social-link { color: green; text-decoration: none; margin-right: 10px; }

@media screen and (max-width: 600px) {
  header, main, footer { padding: 10px; }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
