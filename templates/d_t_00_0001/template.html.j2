<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.9mm; inset-block-start: 0.0mm; inline-size: 214.0mm; block-size: 71.4mm; font-size: 15.6pt"></div>
<p class="box" style="inset-inline-start: 51.0mm; inset-block-start: 94.2mm; inline-size: 66.3mm; block-size: 65.6mm; font-size: 15.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 123.6mm; inset-block-start: 94.2mm; inline-size: 66.2mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 123.6mm; inset-block-start: 108.6mm; inline-size: 65.4mm; block-size: 59.9mm; font-size: 15.4pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 102.7mm; inset-block-start: 165.8mm; inline-size: 15.6mm; block-size: 12.9mm; font-size: 18.3pt"></div>
<h2 class="box" style="inset-inline-start: 34.2mm; inset-block-start: 172.7mm; inline-size: 25.2mm; block-size: 5.1mm; font-size: 14.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 123.6mm; inset-block-start: 173.9mm; inline-size: 66.3mm; block-size: 76.8mm; font-size: 15.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 183.0mm; inline-size: 83.3mm; block-size: 54.6mm; font-size: 15.5pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 6.1mm; inset-block-start: 263.7mm; inline-size: 1.7mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
