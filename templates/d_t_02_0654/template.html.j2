<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 30.6mm; inset-block-start: 21.9mm; inline-size: 42.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.6mm; inset-block-start: 33.2mm; inline-size: 26.5mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.6mm; inset-block-start: 41.7mm; inline-size: 85.4mm; block-size: 55.2mm; font-size: 14.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 120.2mm; inset-block-start: 41.4mm; inline-size: 85.3mm; block-size: 34.4mm; font-size: 13.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 120.2mm; inset-block-start: 80.7mm; inline-size: 85.4mm; block-size: 55.2mm; font-size: 14.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.6mm; inset-block-start: 101.9mm; inline-size: 85.5mm; block-size: 60.5mm; font-size: 14.3pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 120.2mm; inset-block-start: 148.4mm; inline-size: 86.1mm; block-size: 13.7mm; font-size: 7.8pt"><li>{{ slot_6 }}</li></ul>
<div class="box ph" style="inset-inline-start: 29.9mm; inset-block-start: 181.7mm; inline-size: 170.6mm; block-size: 87.3mm; font-size: 40.0pt"></div>
<footer class="box" style="inset-inline-start: 10.1mm; inset-block-start: 270.0mm; inline-size: 2.7mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_7 }}</footer><p class="box" style="inset-inline-start: 30.3mm; inset-block-start: 270.0mm; inline-size: 21.6mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_8 }}</p>
</div></body>
</html>
