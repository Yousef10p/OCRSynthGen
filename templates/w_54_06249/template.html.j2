    margin: 20px 0;
}

.product-box, .blog-box {
    background-color: #f2e9e2;
    padding: 20px;
    border-radius: 5px;
}

h3 {
    color: #a78a4a;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
