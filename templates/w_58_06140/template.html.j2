}

.card-image {
  height: 200px;
  background-color: #FFF;
  margin-bottom: 10px;
}

footer {
  margin-top: 15px;
  text-align: center;
  background-color: #D3D3D3;
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 60px;
}

.logo {
  height: 30px;
  width: 30px;
  background-color: #FFF;
  margin: 15px auto;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
