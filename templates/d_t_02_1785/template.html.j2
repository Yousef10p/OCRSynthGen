<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 5.9mm; inline-size: 216.1mm; block-size: 121.3mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 63.5mm; inset-block-start: 132.5mm; inline-size: 133.5mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 63.5mm; inset-block-start: 139.6mm; inline-size: 125.4mm; block-size: 29.3mm; font-size: 16.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 64.0mm; inset-block-start: 171.1mm; inline-size: 62.2mm; block-size: 24.3mm; font-size: 11.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 131.6mm; inset-block-start: 171.1mm; inline-size: 62.5mm; block-size: 24.3mm; font-size: 11.5pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 199.9mm; inline-size: 215.9mm; block-size: 38.5mm; font-size: 15.6pt"></div>
<footer class="box" style="inset-inline-start: 12.6mm; inset-block-start: 257.5mm; inline-size: 2.3mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_4 }}</footer>
</div></body>
</html>
