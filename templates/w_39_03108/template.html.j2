  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

header, footer {
  background: #f5f5f5;
  padding: 20px;
  display: flex;
  justify-content: space-between;
}

nav ul {
  display: flex;
  list-style-type: none;
}

nav ul li {
  margin-left: 10px;
}

aside {
  background: #e0e0e0;
  width: 20%;
  padding: 20px;
}

main {
  padding: 20px;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

footer {
  margin-top: auto;
  justify-content: space-between;
}

footer div {
  display: flex;
  flex-direction: column;
}

footer a {
  margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
