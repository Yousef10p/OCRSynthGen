    background-color: #f8f9fa;
    padding: 1rem;
    box-shadow: 0px 2px 8px rgba(0,0,0,0.1);
}
.logo {
    font-size: 2rem;
    font-weight: 700;
}
nav ul {
    list-style: none;
}
nav ul li{
    display: inline;
    margin-left: 1rem;
}
nav ul ul {
    display: none;
    position: absolute;
    background-color: #f8f9fa;
}
nav ul li:hover > ul {
    display: block;
}
.hero {
    background-color: #f8f9fa;
