<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

.row {
    display: flex;
    flex-direction: row;
}

.left-column {
    background-color: lightgray;
    width: 30%;
    padding: 10px;
}

.right-column {
    width: 70%;
    padding: 10px;
}

.section {
    margin-bottom: 20px;
}

.schedule, .purchase {
    position: fixed;
    top: 0;
    left: 0;
    width: 30%;
    padding: 10px;
}

.schedule {
    background-color: lightblue;
}

.purchase {
    background-color: lightgreen;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="row">
<div class="left-column">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<h1>{{ slot_2 }}</h1>
<p>{{ slot_3 }}</p>
<h2>{{ slot_4 }}</h2>
<ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</div>
<div class="right-column">
<div class="section">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>

<div style="background-color: blue; height: 100px; width: 100px;"></div>
</div>
<div class="section">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
<div class="section">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
</div>
</div>
<div>
<p class="schedule">{{ slot_14 }}</p>
<p class="purchase">{{ slot_15 }}</p>
</div>
</body>
</html>