<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 104.2mm; inset-block-start: 14.4mm; inline-size: 4.1mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 26.0mm; inset-block-start: 26.6mm; inline-size: 160.5mm; block-size: 27.1mm; font-size: 25.6pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 39.0mm; inset-block-start: 60.5mm; inline-size: 27.8mm; block-size: 4.6mm; font-size: 13.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.5mm; inset-block-start: 72.0mm; inline-size: 101.1mm; block-size: 4.6mm; font-size: 13.0pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 25.7mm; inset-block-start: 83.3mm; inline-size: 160.7mm; block-size: 107.0mm; font-size: 30.3pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 38.4mm; inset-block-start: 197.0mm; inline-size: 115.4mm; block-size: 4.7mm; font-size: 13.2pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 25.6mm; inset-block-start: 208.4mm; inline-size: 160.7mm; block-size: 27.4mm; font-size: 25.9pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 38.3mm; inset-block-start: 242.5mm; inline-size: 93.9mm; block-size: 4.7mm; font-size: 13.4pt"><li>{{ slot_7 }}</li></ul>
</div></body>
</html>
