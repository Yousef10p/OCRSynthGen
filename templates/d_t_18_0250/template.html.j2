<p class="box" style="inset-inline-start: 106.8mm; inset-block-start: 107.9mm; inline-size: 4.8mm; block-size: 5.6mm; font-size: 10.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 79.9mm; inset-block-start: 120.3mm; inline-size: 58.7mm; block-size: 5.5mm; font-size: 10.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 46.9mm; inset-block-start: 151.5mm; inline-size: 17.2mm; block-size: 5.6mm; font-size: 10.0pt">{{ slot_6 }}</p>
