a {
    color: black;
    text-decoration: none;
}
main {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
    margin-top: 60px;
}
section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 10px;
    width: 30%;
    min-width: 300px;
    padding: 10px;
    background-color: lightgray;
}
h2 {
    text-align: center;
}
p, dl {
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
