<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 151.7mm; inset-block-start: 22.1mm; inline-size: 49.9mm; block-size: 60.5mm; font-size: 15.6pt"></div>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 120.9mm; inline-size: 86.1mm; block-size: 17.3mm; font-size: 12.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 120.7mm; inline-size: 86.7mm; block-size: 22.3mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 139.9mm; inline-size: 87.0mm; block-size: 36.4mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 144.5mm; inline-size: 87.4mm; block-size: 17.5mm; font-size: 12.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 163.6mm; inline-size: 87.2mm; block-size: 22.3mm; font-size: 12.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 177.9mm; inline-size: 86.0mm; block-size: 17.5mm; font-size: 12.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 197.1mm; inline-size: 86.5mm; block-size: 31.6mm; font-size: 12.8pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 116.2mm; inset-block-start: 196.3mm; inline-size: 49.4mm; block-size: 17.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 216.0mm; inline-size: 33.0mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 201.5mm; inset-block-start: 256.5mm; inline-size: 1.7mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
