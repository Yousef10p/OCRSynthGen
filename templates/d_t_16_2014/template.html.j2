<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.7mm; inset-block-start: 16.1mm; inline-size: 175.7mm; block-size: 79.6mm; font-size: 32.2pt"></div>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 98.3mm; inline-size: 76.3mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 104.4mm; inline-size: 36.8mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 104.5mm; inline-size: 86.9mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 111.2mm; inline-size: 84.0mm; block-size: 35.9mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 127.1mm; inline-size: 87.0mm; block-size: 49.5mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 151.8mm; inline-size: 84.1mm; block-size: 35.9mm; font-size: 12.7pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 180.3mm; inline-size: 44.5mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 187.2mm; inline-size: 86.9mm; block-size: 67.5mm; font-size: 12.8pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 26.6mm; inset-block-start: 190.1mm; inline-size: 85.9mm; block-size: 50.7mm; font-size: 14.4pt"></div>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 243.4mm; inline-size: 86.5mm; block-size: 12.6mm; font-size: 11.9pt">{{ slot_8 }}</p>
