<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.7mm; inset-block-start: 16.3mm; inline-size: 85.9mm; block-size: 95.4mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 116.4mm; inset-block-start: 16.8mm; inline-size: 85.8mm; block-size: 204.9mm; font-size: 30.6pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 115.0mm; inline-size: 86.4mm; block-size: 7.4mm; font-size: 10.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 127.9mm; inline-size: 86.5mm; block-size: 21.4mm; font-size: 12.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 154.9mm; inline-size: 86.6mm; block-size: 30.4mm; font-size: 12.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 191.0mm; inline-size: 87.0mm; block-size: 34.9mm; font-size: 12.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 226.0mm; inline-size: 72.2mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 231.4mm; inline-size: 42.7mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 233.5mm; inline-size: 86.6mm; block-size: 21.4mm; font-size: 12.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 236.3mm; inline-size: 87.0mm; block-size: 21.3mm; font-size: 12.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 194.9mm; inset-block-start: 263.6mm; inline-size: 7.2mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_8 }}</footer>
</div></body>
</html>
