}

.fixed-navbar {
    position: fixed;
    top: 0px;
    width: 100%;
    background-color: #f8f8f8;
}

.fixed-navbar ul {
    list-style-type: none;
    margin: 0px;
    padding: 0px;
    overflow: hidden;
}

.fixed-navbar li {
    float: right;
}

.fixed-navbar li a {
    display: block;
    color: #666;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

.fixed-navbar li a:hover {
    background-color: #ddd;
    color: black;
}

#feed, #share, #chat, #call {
    padding: 50px;
}

#profile, #share, #call {
    background-color: #f2f2f2;
}

#share {
    border-top: 1px solid #ccc;
    border-bottom: 1px solid #ccc;
}

#news-feed, #share-image, #profile-image, #name-rectangle, #video-call {
    height: 300px;
    width: 500px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
