<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

.row::after {
  content: "";
  clear: both;
  display: table;
}

.column {
  float: right;
  width: 33.33%;
  padding: 10px;
}

.product-image {
  display: inline-block;
  width: 20px;
  height: 20px;
  background-color: gray;
  margin-left: 20px;
  vertical-align: middle;
}

.left { background: cornflowerblue; }
.middle { background: coral; }
.right { background: yellow; }

@media screen and (max-width: 600px) {
  .column {
    width: 100%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="row">
<div class="column left">
<h2>{{ slot_0 }}</h2>
<p>
        {{ slot_1 }}
        </p><ul>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
<div class="column middle">
<h2>{{ slot_6 }}</h2>
<p>
        {{ slot_7 }}
        </p><ul>
<li><span class="product-image">{{ slot_8 }}</span> {{ slot_9 }}</li>
<li><span class="product-image">{{ slot_10 }}</span> {{ slot_11 }}</li>
<li><span class="product-image">{{ slot_12 }}</span> {{ slot_13 }}</li>
<li><span class="product-image">{{ slot_14 }}</span> {{ slot_15 }}</li>
</ul>
</div>
<div class="column right">
<h2>{{ slot_16 }}</h2>
<p>
        {{ slot_17 }}
        </p><ul>
<li>{{ slot_18 }}</li>
<li>{{ slot_19 }}</li>
<li>{{ slot_20 }}</li>
<li>{{ slot_21 }}</li>
</ul>
</div>
</div>
</body>
</html>