<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 34.8mm; inset-block-start: 30.6mm; inline-size: 148.0mm; block-size: 56.7mm; font-size: 11.0pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 30.9mm; inset-block-start: 88.8mm; inline-size: 151.8mm; block-size: 27.1mm; font-size: 11.0pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.9mm; inset-block-start: 117.4mm; inline-size: 152.9mm; block-size: 50.9mm; font-size: 11.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.9mm; inset-block-start: 169.9mm; inline-size: 151.8mm; block-size: 9.7mm; font-size: 11.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.9mm; inset-block-start: 181.0mm; inline-size: 151.3mm; block-size: 16.2mm; font-size: 11.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 27.0mm; inset-block-start: 198.8mm; inline-size: 155.8mm; block-size: 21.2mm; font-size: 11.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 27.0mm; inset-block-start: 221.5mm; inline-size: 157.9mm; block-size: 39.3mm; font-size: 11.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.9mm; inset-block-start: 262.4mm; inline-size: 151.8mm; block-size: 3.9mm; font-size: 11.0pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 102.8mm; inset-block-start: 274.9mm; inline-size: 5.4mm; block-size: 4.6mm; font-size: 11.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
