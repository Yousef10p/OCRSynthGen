<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 35.0mm; inset-block-start: 21.5mm; inline-size: 34.6mm; block-size: 9.6mm; font-size: 27.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 34.8mm; inset-block-start: 92.6mm; inline-size: 140.3mm; block-size: 12.3mm; font-size: 17.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 114.3mm; inline-size: 141.0mm; block-size: 12.2mm; font-size: 17.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 135.9mm; inline-size: 133.8mm; block-size: 5.8mm; font-size: 16.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 34.5mm; inset-block-start: 150.9mm; inline-size: 140.8mm; block-size: 12.3mm; font-size: 17.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 172.2mm; inline-size: 141.0mm; block-size: 12.2mm; font-size: 17.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 193.6mm; inline-size: 140.8mm; block-size: 12.4mm; font-size: 17.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 34.7mm; inset-block-start: 215.8mm; inline-size: 141.1mm; block-size: 12.2mm; font-size: 17.3pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 103.0mm; inset-block-start: 264.4mm; inline-size: 6.1mm; block-size: 4.9mm; font-size: 13.9pt">{{ slot_8 }}</footer>
</div></body>
</html>
