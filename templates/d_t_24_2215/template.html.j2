<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 279.4mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 256.5mm; inset-block-start: 26.0mm; inline-size: 9.0mm; block-size: 34.2mm; font-size: 9.7pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 33.5mm; inset-block-start: 37.6mm; inline-size: 196.0mm; block-size: 129.9mm; font-size: 12.3pt"></div>
<header class="box" style="inset-inline-start: 255.9mm; inset-block-start: 70.8mm; inline-size: 4.9mm; block-size: 22.3mm; font-size: 7.9pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 256.6mm; inset-block-start: 105.7mm; inline-size: 3.8mm; block-size: 21.8mm; font-size: 8.8pt">{{ slot_2 }}</header><header class="box" style="inset-inline-start: 255.7mm; inset-block-start: 148.3mm; inline-size: 6.7mm; block-size: 37.8mm; font-size: 10.7pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 126.7mm; inset-block-start: 170.4mm; inline-size: 20.7mm; block-size: 6.1mm; font-size: 17.3pt">{{ slot_4 }}</p>
</div></body>
</html>
