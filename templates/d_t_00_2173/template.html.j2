<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 0.0mm; inline-size: 215.7mm; block-size: 135.3mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 50.1mm; inset-block-start: 138.1mm; inline-size: 109.5mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 25.4mm; inset-block-start: 146.4mm; inline-size: 95.1mm; block-size: 39.9mm; font-size: 9.4pt"></div>
<p class="box" style="inset-inline-start: 128.9mm; inset-block-start: 146.1mm; inline-size: 48.1mm; block-size: 8.5mm; font-size: 12.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 128.9mm; inset-block-start: 160.0mm; inline-size: 53.3mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 191.1mm; inline-size: 75.1mm; block-size: 14.2mm; font-size: 13.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 193.8mm; inline-size: 74.9mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 210.6mm; inline-size: 74.4mm; block-size: 42.4mm; font-size: 15.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 230.2mm; inline-size: 72.1mm; block-size: 19.8mm; font-size: 14.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 25.6mm; inset-block-start: 272.7mm; inline-size: 60.9mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 180.6mm; inset-block-start: 273.1mm; inline-size: 3.2mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
