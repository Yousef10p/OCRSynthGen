<p class="box" style="inset-inline-start: 35.3mm; inset-block-start: 101.4mm; inline-size: 217.1mm; block-size: 30.4mm; font-size: 10.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 35.3mm; inset-block-start: 136.3mm; inline-size: 216.3mm; block-size: 14.8mm; font-size: 10.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 35.3mm; inset-block-start: 155.7mm; inline-size: 210.6mm; block-size: 14.8mm; font-size: 10.5pt">{{ slot_6 }}</p>
