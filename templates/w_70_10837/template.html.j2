}



.dropdown {
    position: relative;
}

.dropdown-content {
    display: none;
    position: absolute;
    background-color: #fff;
    width: 100%;
}

.dropdown:hover .dropdown-content {
    display: block;
}



body {
    font-family: var(--font-body);
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
