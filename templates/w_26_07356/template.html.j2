<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: row-reverse;
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    min-height: 100vh;
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    height: 10vh;
}

.header-colorful {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: linear-gradient(to right, red, orange, yellow, green, blue, indigo, violet);
}

.header-logo {
    font-size: 2rem;
    color: white;
}

.header-search {
    display: flex;
    justify-content: flex-end;
    padding: 1rem;
}

.header-search input[type="text"] {
    width: 50%;
}

aside {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
    position: fixed;
    left: 0;
    width: 20%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.1);
}

.doctor-finder {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background-color: #f0f0f0;
    border-radius: 1rem;
}

footer {
    display: flex;
    justify-content: space-around;
    align-items: center;
    position: fixed;
    bottom: 0;
    width: 100%;
    height: 5vh;
    background-color: #333;
    color: white;
}

a {
    color: white;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
