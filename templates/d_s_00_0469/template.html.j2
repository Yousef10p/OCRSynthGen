<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 21.6mm; inline-size: 160.6mm; block-size: 50.6mm; font-size: 40.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 84.6mm; inline-size: 216.0mm; block-size: 108.4mm; font-size: 15.4pt"></div>
<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 202.5mm; inline-size: 65.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 129.0mm; inset-block-start: 200.4mm; inline-size: 63.9mm; block-size: 36.2mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 208.6mm; inline-size: 108.9mm; block-size: 25.4mm; font-size: 14.4pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 14.0mm; inset-block-start: 246.5mm; inline-size: 24.0mm; block-size: 14.6mm; font-size: 13.8pt"></div>
<div class="box ph" style="inset-inline-start: 68.3mm; inset-block-start: 250.6mm; inline-size: 21.8mm; block-size: 8.7mm; font-size: 12.4pt"></div>
<div class="box ph" style="inset-inline-start: 121.0mm; inset-block-start: 250.6mm; inline-size: 24.8mm; block-size: 8.7mm; font-size: 12.4pt"></div>
<div class="box ph" style="inset-inline-start: 180.0mm; inset-block-start: 250.4mm; inline-size: 19.3mm; block-size: 7.5mm; font-size: 21.3pt"></div>
<footer class="box" style="inset-inline-start: 16.9mm; inset-block-start: 271.2mm; inline-size: 34.4mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_3 }}</footer>
</div></body>
</html>
