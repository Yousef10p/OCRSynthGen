<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 28.5mm; inset-block-start: 25.4mm; inline-size: 158.2mm; block-size: 14.0mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 48.9mm; inset-block-start: 47.0mm; inline-size: 117.5mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 59.9mm; inset-block-start: 54.9mm; inline-size: 95.6mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 70.0mm; inline-size: 6.3mm; block-size: 120.5mm; font-size: 20.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 83.7mm; inset-block-start: 70.2mm; inline-size: 47.7mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 37.3mm; inset-block-start: 79.5mm; inline-size: 140.6mm; block-size: 42.1mm; font-size: 10.9pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 85.9mm; inset-block-start: 133.2mm; inline-size: 43.7mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 145.3mm; inline-size: 164.5mm; block-size: 26.4mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 174.8mm; inline-size: 164.5mm; block-size: 44.1mm; font-size: 12.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 219.1mm; inline-size: 164.5mm; block-size: 41.1mm; font-size: 12.0pt">{{ slot_9 }}</p>
</div></body>
</html>
