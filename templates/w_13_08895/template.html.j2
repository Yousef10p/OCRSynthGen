<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}


header {
  position: fixed;
  top: 0;
  right: 0;
  width: 100%;
  background: #000;
  color: #fff;
  padding: 10px;
}

nav ul {
  list-style-type: none;
}

nav ul li {
  display: inline-block;
  margin-left: 10px;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}


#featured {
  margin-top: 60px;
  padding: 20px;
  text-align: center;
}

#featured h1 {
  margin-bottom: 20px;
}

.product {
  display: inline-block;
  width: 30%;
  margin-left: 5%;
  text-align: center;
}

.product-image {
  width: 100px;
  height: 100px;
  background: #000;
  margin: 0 auto;
  margin-bottom: 10px;
}

#scroll-btn {
  display: block;
  margin: 20px auto;
  padding: 10px 20px;
  background: #000;
  color: #fff;
  border: none;
  cursor: pointer;
}


#accordion {
  width: 100%;
  padding: 20px;
  margin-top: 60px;
}

.accordion-item {
  margin-bottom: 20px;
  padding: 10px;
  border: 1px solid #000;
}

.accordion-item h2 {
  margin-bottom: 10px;
  cursor: pointer;
}

.accordion-item p {
  display: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
