}
header > img {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
}
nav ul {
    list-style: none;
    display: flex;
    justify-content: space-around;
    background-color: #ddd;
}
nav a {
    color: #333;
