<h2 class="box" style="inset-inline-start: 42.6mm; inset-block-start: 135.6mm; inline-size: 136.6mm; block-size: 11.0mm; font-size: 15.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 151.2mm; inline-size: 147.6mm; block-size: 10.5mm; font-size: 14.8pt">{{ slot_5 }}</p>
