<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 49.4mm; inset-block-start: 33.4mm; inline-size: 132.4mm; block-size: 28.5mm; font-size: 16.1pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 21.4mm; inset-block-start: 40.2mm; inline-size: 13.2mm; block-size: 7.4mm; font-size: 10.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 49.4mm; inset-block-start: 64.5mm; inline-size: 131.2mm; block-size: 34.7mm; font-size: 16.4pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 21.4mm; inset-block-start: 71.3mm; inline-size: 15.2mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 49.4mm; inset-block-start: 101.8mm; inline-size: 130.8mm; block-size: 22.3mm; font-size: 15.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 49.4mm; inset-block-start: 126.7mm; inline-size: 130.2mm; block-size: 16.0mm; font-size: 15.1pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 7.4mm; inset-block-start: 146.4mm; inline-size: 1.4mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 49.4mm; inset-block-start: 176.5mm; inline-size: 16.1mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 130.1mm; inset-block-start: 182.3mm; inline-size: 48.7mm; block-size: 10.4mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 74.3mm; inset-block-start: 183.6mm; inline-size: 40.3mm; block-size: 15.1mm; font-size: 14.2pt"></div>
<div class="box ph" style="inset-inline-start: 76.5mm; inset-block-start: 222.0mm; inline-size: 31.5mm; block-size: 31.3mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 131.1mm; inset-block-start: 222.2mm; inline-size: 30.9mm; block-size: 30.9mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 77.7mm; inset-block-start: 257.5mm; inline-size: 32.2mm; block-size: 7.5mm; font-size: 10.7pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 131.7mm; inset-block-start: 257.5mm; inline-size: 26.2mm; block-size: 7.5mm; font-size: 10.7pt">{{ slot_9 }}</p>
</div></body>
</html>
