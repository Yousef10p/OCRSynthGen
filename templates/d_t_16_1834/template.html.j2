<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 60.6mm; inline-size: 84.6mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 68.7mm; inline-size: 77.0mm; block-size: 6.0mm; font-size: 17.1pt">{{ slot_4 }}</h2>
