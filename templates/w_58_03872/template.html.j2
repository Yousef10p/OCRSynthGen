<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.nav-menu {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 200px;
    background: #f8f9fa;
    padding: 20px;
}

.nav-menu ul {
    list-style-type: none;
    padding: 0;
}

.nav-menu a {
    text-decoration: none;
    color: #343a40;
    display: block;
    margin-bottom: 10px;
}

.search-bar {
    position: fixed;
    top: 0;
    left: 0;
    padding: 20px;
}

.search-bar input {
    width: 200px;
    padding: 10px;
    border: 1px solid #ced4da;
    border-radius: 5px;
}

.container {
    margin-right: 220px;
    padding: 20px;
}

p {
    line-height: 25px;
}

h1 {
    color: #343a40;
}

h2 {
    color: #343a40;
}

.placeholder-image {
    width: 500px;
    height: 300px;
    background: #6c757d
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="nav-menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="search-bar">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</div>
<div class="container">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>