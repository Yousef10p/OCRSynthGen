<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
}
.menu {
    position: fixed;
    right: 0;
    top: 0;
    width: 200px;
    height: 100%;
    background-color: #f8f8f8;
    padding: 1em;
}
.menu ul {
    list-style-type: none;
}
.menu ul li {
    margin: 1em 0;
}
.slider {
    width: 70%;
    margin: 2em auto;
    height: 200px;
    background-color: #f1f1f1;
    overflow: hidden;
}
.slider .slide {
    width: 100%;
    height: 200px;
    background-color: #ddd;
    float: right;
    text-align: center;
    line-height: 200px;
}
.content {
    margin-right: 200px;
    padding: 2em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="slider">
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
</div>
<div class="content">
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
</body>
</html>