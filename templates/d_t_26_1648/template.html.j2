<div class="box ph" style="inset-inline-start: 48.1mm; inset-block-start: 63.5mm; inline-size: 145.0mm; block-size: 51.8mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 116.4mm; inline-size: 95.1mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 55.5mm; inset-block-start: 129.4mm; inline-size: 127.8mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 143.9mm; inline-size: 143.8mm; block-size: 11.7mm; font-size: 11.1pt"><li>{{ slot_6 }}</li></ul>
