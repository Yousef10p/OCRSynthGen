<footer class="box" style="inset-inline-start: 17.5mm; inset-block-start: 283.9mm; inline-size: 49.8mm; block-size: 4.9mm; font-size: 13.9pt">{{ slot_9 }}</footer><footer class="box" style="inset-inline-start: 99.7mm; inset-block-start: 284.2mm; inline-size: 4.0mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_10 }}</footer>
</div></body>
</html>
