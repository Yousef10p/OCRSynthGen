<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 17.5mm; inset-block-start: 16.5mm; inline-size: 49.0mm; block-size: 6.5mm; font-size: 18.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 17.5mm; inset-block-start: 51.7mm; inline-size: 170.8mm; block-size: 15.1mm; font-size: 14.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 17.5mm; inset-block-start: 72.1mm; inline-size: 169.5mm; block-size: 20.2mm; font-size: 14.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 17.5mm; inset-block-start: 97.6mm; inline-size: 173.8mm; block-size: 25.3mm; font-size: 14.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 17.5mm; inset-block-start: 128.2mm; inline-size: 172.0mm; block-size: 15.1mm; font-size: 14.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 17.5mm; inset-block-start: 148.7mm; inline-size: 170.5mm; block-size: 25.3mm; font-size: 14.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 17.5mm; inset-block-start: 179.3mm; inline-size: 165.6mm; block-size: 15.1mm; font-size: 14.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 17.5mm; inset-block-start: 199.7mm; inline-size: 172.2mm; block-size: 20.2mm; font-size: 14.3pt">{{ slot_7 }}</p>
