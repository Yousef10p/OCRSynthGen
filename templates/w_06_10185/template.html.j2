<div id="header">
<h1>{{ slot_0 }}</h1>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</div>
<div id="left-column">
<h2>{{ slot_2 }}</h2>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div id="right-column">
<h2>{{ slot_6 }}</h2>
<div class="property" id="property1">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</div>
<div class="property" id="property2">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
</div>
</div>
<footer>
<h2>{{ slot_11 }}</h2>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</footer>
</body>
</html>