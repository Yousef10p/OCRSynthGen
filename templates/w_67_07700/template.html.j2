<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background: #f0f0f0;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  padding: 20px;
}

.grid-title {
  grid-column: 1 / span 3;
  text-align: center;
  font-size: 2em;
}

.grid-item,
.collection-item,
.promotion-item {
  display: grid;
  grid-template-columns: 1fr 2fr;
  background: #fff;
  border: 1px solid #000;
  padding: 10px;
  border-radius: 10px;
}

.grid-item-image,
.collection-item-image,
.promotion-item-image {
  width: 100px;
  height: 100px;
  background: #000;
}

.grid-item-details,
.collection-item-details,
.promotion-item-details {
  display: grid;
  align-content: center;
  justify-content: center;
}

.grid-item-details h3,
.collection-item-details h3,
.promotion-item-details h3 {
  margin: 0 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="grid-container">

<h2 class="grid-title">{{ slot_0 }}</h2>
<div class="featured">

<div class="grid-item">
<div class="grid-item-image">{{ slot_1 }}</div>
<div class="grid-item-details">
<h3>{{ slot_2 }}</h3>
<p>{{ slot_3 }}</p>
<button>{{ slot_4 }}</button>
</div>
</div>

</div>

<h2 class="grid-title">{{ slot_5 }}</h2>
<div class="collections">

<div class="collection-item">
<div class="collection-item-image">{{ slot_6 }}</div>
<div class="collection-item-details">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
<button>{{ slot_9 }}</button>
</div>
</div>

</div>

<h2 class="grid-title">{{ slot_10 }}</h2>
<div class="promotions">

<div class="promotion-item">
<div class="promotion-item-image">{{ slot_11 }}</div>
<div class="promotion-item-details">
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<button>{{ slot_14 }}</button>
</div>
</div>

</div>
</div>
</body>
</html>