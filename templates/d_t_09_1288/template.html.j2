<h2 class="box" style="inset-inline-start: 97.7mm; inset-block-start: 70.5mm; inline-size: 15.4mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 81.6mm; inline-size: 6.3mm; block-size: 129.7mm; font-size: 20.0pt">{{ slot_5 }}</header><p class="box" style="inset-inline-start: 21.9mm; inset-block-start: 80.9mm; inline-size: 167.0mm; block-size: 31.6mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 21.9mm; inset-block-start: 118.0mm; inline-size: 166.9mm; block-size: 10.5mm; font-size: 10.0pt">{{ slot_7 }}</p>
