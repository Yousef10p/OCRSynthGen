<div class="numbertext">{{ slot_8 }}</div>
<div class="text">{{ slot_9 }}</div>
</div>
<div class="mySlides fade">
<div class="numbertext">{{ slot_10 }}</div>
<div class="text">{{ slot_11 }}</div>
</div>
</div>
<br>
</main>
<footer>
<nav>
<ul>
