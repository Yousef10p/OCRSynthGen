<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 125.9mm; inset-block-start: 10.2mm; inline-size: 7.6mm; block-size: 8.7mm; font-size: 24.7pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 50.8mm; inset-block-start: 12.3mm; inline-size: 70.7mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 23.3mm; inline-size: 91.2mm; block-size: 46.0mm; font-size: 10.9pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 35.9mm; inset-block-start: 73.3mm; inline-size: 90.7mm; block-size: 8.7mm; font-size: 24.7pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 83.2mm; inline-size: 88.7mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 38.8mm; inset-block-start: 94.6mm; inline-size: 89.4mm; block-size: 27.1mm; font-size: 11.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.8mm; inset-block-start: 122.9mm; inline-size: 87.0mm; block-size: 27.1mm; font-size: 11.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.8mm; inset-block-start: 151.2mm; inline-size: 87.6mm; block-size: 27.1mm; font-size: 11.0pt"><li>{{ slot_7 }}</li></ul>
<div class="box ph" style="inset-inline-start: 20.7mm; inset-block-start: 177.6mm; inline-size: 12.0mm; block-size: 14.4mm; font-size: 13.6pt"></div>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 181.4mm; inline-size: 85.9mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 26.7mm; inset-block-start: 201.9mm; inline-size: 95.7mm; block-size: 7.2mm; font-size: 8.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
