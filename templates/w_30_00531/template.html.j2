    width: 200px;
}

header nav ul {
    display: flex;
    list-style-type: none;
}

header nav ul li a {
    margin-right: 10px;
    text-decoration: none;
    color: #333;
}

.hero {
    text-align: center;
    padding: 100px 0;
    background-color: #007BFF;
    color: #fff;
}

.hero-image {
    width: 200px;
    height: 200px;
