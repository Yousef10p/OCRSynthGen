<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 13.7mm; inline-size: 45.8mm; block-size: 21.1mm; font-size: 14.9pt"></div>
<header class="box" style="inset-inline-start: 81.5mm; inset-block-start: 19.5mm; inline-size: 96.7mm; block-size: 6.1mm; font-size: 8.6pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 93.3mm; inset-block-start: 36.8mm; inline-size: 29.7mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 44.2mm; inline-size: 150.0mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 50.0mm; inline-size: 101.7mm; block-size: 3.2mm; font-size: 9.2pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 62.4mm; inset-block-start: 54.9mm; inline-size: 91.3mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_4 }}</h2>
<div class="box ph" style="inset-inline-start: 23.0mm; inset-block-start: 61.6mm; inline-size: 170.0mm; block-size: 209.6mm; font-size: 22.9pt"></div>
</div></body>
</html>
