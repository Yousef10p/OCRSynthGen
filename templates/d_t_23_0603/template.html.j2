<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 175.4mm; inset-block-start: 18.2mm; inline-size: 14.8mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_0 }}</header><ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 36.1mm; inline-size: 167.9mm; block-size: 14.0mm; font-size: 22.1pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 56.5mm; inline-size: 165.9mm; block-size: 38.5mm; font-size: 22.1pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 101.5mm; inline-size: 167.8mm; block-size: 38.5mm; font-size: 22.1pt"><li>{{ slot_3 }}</li></ul>
<div class="box ph" style="inset-inline-start: 44.4mm; inset-block-start: 148.3mm; inline-size: 59.2mm; block-size: 75.0mm; font-size: 15.2pt"></div>
<div class="box ph" style="inset-inline-start: 109.3mm; inset-block-start: 148.1mm; inline-size: 59.7mm; block-size: 74.7mm; font-size: 15.1pt"></div>
<footer class="box" style="inset-inline-start: 130.5mm; inset-block-start: 269.8mm; inline-size: 60.7mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_4 }}</footer>
</div></body>
</html>
