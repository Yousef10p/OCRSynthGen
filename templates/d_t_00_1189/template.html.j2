<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 114.0mm; inset-block-start: 0.0mm; inline-size: 57.5mm; block-size: 82.6mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 174.7mm; inset-block-start: 36.3mm; inline-size: 22.5mm; block-size: 9.8mm; font-size: 9.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 43.7mm; inline-size: 72.9mm; block-size: 21.0mm; font-size: 14.9pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 66.3mm; inline-size: 74.8mm; block-size: 32.2mm; font-size: 15.2pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 94.5mm; inline-size: 79.9mm; block-size: 43.5mm; font-size: 15.4pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 100.1mm; inline-size: 74.7mm; block-size: 26.6mm; font-size: 15.1pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 128.4mm; inline-size: 77.8mm; block-size: 66.1mm; font-size: 15.6pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 120.6mm; inset-block-start: 139.6mm; inline-size: 71.7mm; block-size: 21.0mm; font-size: 14.9pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 120.6mm; inset-block-start: 162.2mm; inline-size: 74.2mm; block-size: 15.3mm; font-size: 14.5pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 120.6mm; inset-block-start: 179.1mm; inline-size: 78.4mm; block-size: 32.2mm; font-size: 15.2pt"><li>{{ slot_8 }}</li></ul>
<h2 class="box" style="inset-inline-start: 27.5mm; inset-block-start: 210.0mm; inline-size: 30.6mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_9 }}</h2>
