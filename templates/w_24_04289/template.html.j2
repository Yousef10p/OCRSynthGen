<p>{{ slot_6 }}</p>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
</div>
<div class="main-content">
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
</ul>
</div>
</div>
<footer>
<a>{{ slot_16 }}</a>
</footer>
</body>
</html>