<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 23.8mm; inline-size: 111.7mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 70.0mm; inset-block-start: 37.0mm; inline-size: 123.0mm; block-size: 13.4mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 60.5mm; inline-size: 156.7mm; block-size: 6.7mm; font-size: 10.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 74.6mm; inset-block-start: 74.5mm; inline-size: 118.4mm; block-size: 7.0mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 88.6mm; inline-size: 170.2mm; block-size: 11.6mm; font-size: 10.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 108.2mm; inline-size: 170.2mm; block-size: 22.1mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 135.6mm; inline-size: 170.2mm; block-size: 84.0mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 220.8mm; inline-size: 170.2mm; block-size: 11.6mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 239.8mm; inline-size: 170.1mm; block-size: 7.2mm; font-size: 10.9pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 107.0mm; inset-block-start: 264.2mm; inline-size: 1.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_7 }}</footer>
</div></body>
</html>
