* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    color: #333;
}

.container {
    width: 90%;
    margin: 0 auto;
}

header {
    background-color: #e6b968; 
    color: #FFF;
    padding: 2rem 0;
    text-align: center;
    font-size: 2rem;
}

nav ul {
    display: flex;
    justify-content: space-around;
    align-items: center;
    list-style: none;
}

nav ul li a {
    color: #FFF;
    text-decoration: none;
    font-size: 1.2rem;
}

main {
    margin: 2rem 0;
}

h2 {
    margin: 2rem 0 1rem;
    font-size: 2rem;
    text-align: center;
}

p {
    margin: 1rem 0;
    line-height: 1.6;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
}

.item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem;
    background-color: #c8d5b9; 
    border-radius: 5px;
}

.image {
    width: 75%;
    height: 200px;
    background-color: #564d4d; 
    margin-bottom: 1rem;
}

footer {
    background-color: #cd5c5c; 
    color: #FFF;
    padding: 1rem;
    text-align: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
