<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 12.0mm; inset-block-start: 19.8mm; inline-size: 59.3mm; block-size: 72.9mm; font-size: 12.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 77.9mm; inset-block-start: 20.3mm; inline-size: 57.5mm; block-size: 31.7mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 143.9mm; inset-block-start: 19.9mm; inline-size: 57.5mm; block-size: 59.8mm; font-size: 12.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 78.0mm; inset-block-start: 55.9mm; inline-size: 58.7mm; block-size: 73.1mm; font-size: 12.2pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 143.9mm; inset-block-start: 85.9mm; inline-size: 71.8mm; block-size: 41.8mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 12.0mm; inset-block-start: 99.0mm; inline-size: 59.9mm; block-size: 68.5mm; font-size: 12.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 78.0mm; inset-block-start: 135.1mm; inline-size: 58.5mm; block-size: 72.9mm; font-size: 12.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 11.6mm; inset-block-start: 173.2mm; inline-size: 55.7mm; block-size: 40.2mm; font-size: 14.2pt"></div>
<p class="box" style="inset-inline-start: 104.7mm; inset-block-start: 222.0mm; inline-size: 7.2mm; block-size: 8.6mm; font-size: 24.4pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 208.5mm; inset-block-start: 270.0mm; inline-size: 2.8mm; block-size: 1.9mm; font-size: 5.4pt">{{ slot_6 }}</footer>
</div></body>
</html>
