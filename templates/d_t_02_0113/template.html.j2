<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 117.5mm; inset-block-start: 35.9mm; inline-size: 21.5mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 117.5mm; inset-block-start: 45.3mm; inline-size: 35.9mm; block-size: 11.0mm; font-size: 10.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 117.5mm; inset-block-start: 62.9mm; inline-size: 35.7mm; block-size: 11.0mm; font-size: 10.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 117.5mm; inset-block-start: 80.5mm; inline-size: 28.3mm; block-size: 11.0mm; font-size: 10.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 117.5mm; inset-block-start: 98.1mm; inline-size: 49.9mm; block-size: 11.0mm; font-size: 10.3pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 117.5mm; inset-block-start: 115.7mm; inline-size: 18.8mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 117.5mm; inset-block-start: 120.0mm; inline-size: 77.8mm; block-size: 26.5mm; font-size: 10.7pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 117.5mm; inset-block-start: 153.1mm; inline-size: 25.6mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_7 }}</h2>
