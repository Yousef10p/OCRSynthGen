<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    height: 100%;
    box-sizing: border-box;
    display: flex;
}

nav {
    padding: 10px;
    margin-left: 10px;
    width: 200px;
    background: #f0f0f0; 
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    margin-bottom: 10px;
}

nav ul li p {
    padding: 5px;
    cursor: pointer;
}

form {
    margin-bottom: 10px;
}

aside {
    background: #d0d0d0;
    padding: 10px;
    margin-bottom: 10px;
    width: 200px;
}

article {
    margin-left: 10px;
}

article p {
    margin-bottom: 5px;
}

.meme-rectangle, .sticker-rectangle {
    height: 200px;
    width: 200px;
    background: #c0c0c0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><p>{{ slot_0 }}</p></li>
<li><p>{{ slot_1 }}</p></li>
<li><p>{{ slot_2 }}</p></li>
<li><p>{{ slot_3 }}</p></li>
<li><p>{{ slot_4 }}</p></li>
</ul>
</nav>
<section>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
<button>{{ slot_6 }}</button>
</form>
<aside>
<p>{{ slot_7 }}</p>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</aside>
<article>
<p>{{ slot_11 }}</p>
<div class="meme-rectangle"></div>
<p>{{ slot_12 }}</p>
</article>
<article>
<p>{{ slot_13 }}</p>
<div class="sticker-rectangle"></div>
<p>{{ slot_14 }}</p>
</article>
</section>
</body>
</html>