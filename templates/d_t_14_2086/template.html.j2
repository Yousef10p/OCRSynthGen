<ul class="box" style="inset-inline-start: 12.6mm; inset-block-start: 192.8mm; inline-size: 73.4mm; block-size: 3.5mm; font-size: 9.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 12.6mm; inset-block-start: 198.3mm; inline-size: 114.0mm; block-size: 3.5mm; font-size: 9.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 12.6mm; inset-block-start: 203.8mm; inline-size: 54.2mm; block-size: 3.5mm; font-size: 9.0pt"><li>{{ slot_6 }}</li></ul>
