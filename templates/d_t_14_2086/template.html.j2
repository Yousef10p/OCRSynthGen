<footer class="box" style="inset-inline-start: 12.6mm; inset-block-start: 285.8mm; inline-size: 110.9mm; block-size: 3.2mm; font-size: 8.0pt">{{ slot_12 }}</footer><footer class="box" style="inset-inline-start: 174.4mm; inset-block-start: 285.8mm; inline-size: 16.7mm; block-size: 3.2mm; font-size: 8.0pt">{{ slot_13 }}</footer>
