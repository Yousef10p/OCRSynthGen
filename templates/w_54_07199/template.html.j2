<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	margin: 0;
	font-family: var(--font-body);
}

nav {
	background-color: #333;
	color: #fff;
	display: flex;
	justify-content: space-around;
	padding: 10px 0;
	position: sticky;
	top: 0;
}

nav a {
	color: #fff;
	text-decoration: none;
}

.grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 20px;
	margin: 20px;
}

.grid-item {
	border: 1px solid #333;
	padding: 20px;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	text-align: center;
}

header {
	background-color: #DDD;
	padding: 50px 0;
	text-align: center;
	margin: 0 0 40px;
}

h1 {
	margin: 0;
}

footer {
	background-color: #333;
	color: #fff;
	text-align: center;
	padding: 10px 0;
	position: fixed;
	bottom: 0;
	width: 100%;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</nav>
<header>
<div style="background-color: #FFEB3B; width: 100px; height: 100px;">{{ slot_4 }}</div>
<h1>{{ slot_5 }}</h1>
</header>
<div class="grid">
<div class="grid-item">
<div style="background-color: #4CAF50; width: 100px; height: 100px;">{{ slot_6 }}</div>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<h3>{{ slot_9 }}</h3>
</div>
<div class="grid-item">
<div style="background-color: #2196F3; width: 100px; height: 100px;">{{ slot_10 }}</div>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h3>{{ slot_13 }}</h3>
</div>
<div class="grid-item">
<div style="background-color: #FF9800; width: 100px; height: 100px;">{{ slot_14 }}</div>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<h3>{{ slot_17 }}</h3>
</div>
<div class="grid-item">
