<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 15.7mm; inline-size: 118.9mm; block-size: 20.4mm; font-size: 9.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 37.1mm; inline-size: 118.9mm; block-size: 20.4mm; font-size: 9.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 16.0mm; inset-block-start: 62.2mm; inline-size: 51.7mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 65.6mm; inline-size: 118.9mm; block-size: 13.3mm; font-size: 9.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 79.9mm; inline-size: 118.9mm; block-size: 13.3mm; font-size: 9.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 94.1mm; inline-size: 118.9mm; block-size: 20.4mm; font-size: 9.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 115.5mm; inline-size: 118.9mm; block-size: 16.9mm; font-size: 9.6pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 16.0mm; inset-block-start: 137.1mm; inline-size: 43.2mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 140.5mm; inline-size: 119.0mm; block-size: 24.0mm; font-size: 9.7pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 130.7mm; inset-block-start: 201.6mm; inline-size: 4.2mm; block-size: 1.8mm; font-size: 5.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
