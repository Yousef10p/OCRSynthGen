<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 18.7mm; inset-block-start: 10.8mm; inline-size: 21.4mm; block-size: 6.8mm; font-size: 19.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 20.7mm; inline-size: 109.1mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 19.2mm; inset-block-start: 38.3mm; inline-size: 26.2mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 19.2mm; inset-block-start: 44.4mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 50.6mm; inline-size: 108.2mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 50.6mm; inset-block-start: 66.6mm; inline-size: 45.6mm; block-size: 33.6mm; font-size: 15.9pt"></div>
<h2 class="box" style="inset-inline-start: 19.2mm; inset-block-start: 109.3mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 115.5mm; inline-size: 111.2mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 49.8mm; inset-block-start: 131.0mm; inline-size: 45.9mm; block-size: 31.0mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 19.0mm; inset-block-start: 167.0mm; inline-size: 14.0mm; block-size: 13.6mm; font-size: 12.9pt"></div>
<footer class="box" style="inset-inline-start: 15.0mm; inset-block-start: 198.0mm; inline-size: 3.1mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
