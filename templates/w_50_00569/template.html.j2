  padding: 1em;
  background-color: #f0f0f0;
}

.logo {
  font-weight: bold;
  font-size: 1.5em;
}

nav ul {
  display: flex;
  list-style: none;
}

nav ul li {
  margin-right: 1em;
}

main, footer {
  padding: 1em;
}

.menu, .gallery, .reviews, .location, .contact {
  margin-bottom: 1em;
}


.menu::before, .gallery::before, .reviews::before, .location::before, .contact::before {
  content: "";
  display: block;
  width: 100%;
  height: 200px;
  background-color: #ccc;
  margin-bottom: 1em;
}

footer {
  background-color: #f0f0f0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
