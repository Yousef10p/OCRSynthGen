<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-body);
}

h1 {
    color: #333;
    text-align: center;
}

p {
    color: #333;
    text-align: center;
}

ul {
    list-style-type: none;
}

#investment-options, #financial-planning {
    display: flex;
    justify-content: space-between;
    width: 100%;
}

.image-placeholder {
    width: 200px;
    height: 200px;
    background-color: #ccc;
}

#call-to-action {
    margin: 20px 0;
}

button {
    padding: 10px 20px;
    background-color: #007BFF;
    color: #fff;
    border: none;
    cursor: pointer;
}

footer {
    position: absolute;
    bottom: 0;
    background-color: #333;
    color: #fff;
    width: 100%;
    text-align: center;
}

footer a {
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="investment-options">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<ul>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
<div class="image-placeholder ph"></div>
</div>
<div id="financial-planning">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
<div class="image-placeholder ph"></div>
</div>
<div id="call-to-action">
<h1>{{ slot_10 }}</h1>
<button>{{ slot_11 }}</button>
</div>
<footer>
<h1>{{ slot_12 }}</h1>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</footer>
</body>
</html>