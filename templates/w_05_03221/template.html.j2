<div class="color-block"><p>{{ slot_5 }}</p></div>
<div class="color-block"><p>{{ slot_6 }}</p></div>
<div class="color-block"><p>{{ slot_7 }}</p></div>
</div>

<div class="footer">
<p>{{ slot_8 }}</p>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
