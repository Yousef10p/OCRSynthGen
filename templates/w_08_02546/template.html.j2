    margin: 0;
}
nav {
    display: flex;
    justify-content: space-around;
}
nav ul {
    list-style-type: none;
    padding: 0;
}
nav li {
    display: inline;
}
nav a {
    color: white;
    text-decoration: none;
    padding: 5px;
}
main {
    display: flex;
    flex-direction: column;
    align-items: center;
}
section {
    margin: 20px;
}
.destination-card, .booking-tool, .review-card {
    width: 300px;
    height: 200px;
    background-color: #ccc;
    margin: 20px; 
}
footer {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
