<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 9.8mm; inset-block-start: 69.5mm; inline-size: 202.7mm; block-size: 56.5mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 127.5mm; inline-size: 164.2mm; block-size: 5.2mm; font-size: 7.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 137.6mm; inline-size: 80.4mm; block-size: 34.6mm; font-size: 10.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 104.5mm; inset-block-start: 137.6mm; inline-size: 80.4mm; block-size: 18.7mm; font-size: 10.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 104.5mm; inset-block-start: 159.6mm; inline-size: 80.4mm; block-size: 34.6mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 175.5mm; inline-size: 80.4mm; block-size: 58.4mm; font-size: 11.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 104.5mm; inset-block-start: 197.4mm; inline-size: 80.4mm; block-size: 30.6mm; font-size: 10.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 104.5mm; inset-block-start: 231.4mm; inline-size: 80.4mm; block-size: 14.7mm; font-size: 10.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 17.1mm; inset-block-start: 237.2mm; inline-size: 81.2mm; block-size: 26.6mm; font-size: 10.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 104.5mm; inset-block-start: 249.4mm; inline-size: 81.4mm; block-size: 14.7mm; font-size: 10.4pt">{{ slot_8 }}</p>
</div></body>
</html>
