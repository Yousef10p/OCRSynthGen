<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    color: white;
    margin: 0;
    padding: 0;
}

header, footer {
    height: 50px;
    line-height: 50px;
    background-color: #2d3436;
    text-align: center;
}

header input {
    margin: 10px;
}

header div {
    margin: 10px;
}

header div button {
    margin: 0 10px;
    border: none;
    background-color: #d63031;
    color: white;
    padding: 10px;
    cursor: pointer;
}

.products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 20px;
}

.product {
    height: 100px;
    background-color: #55efc4;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease-in-out;
}

.product:hover {
    background-color: #00b894;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<div>
<button>{{ slot_1 }}</button>
<button>{{ slot_2 }}</button>
<button>{{ slot_3 }}</button>
<button>{{ slot_4 }}</button>
<button>{{ slot_5 }}</button>
</div>
</nav>
</header>
<main>
<section class="products">
<div class="product"><p>{{ slot_6 }}</p></div>
<div class="product"><p>{{ slot_7 }}</p></div>
<div class="product"><p>{{ slot_8 }}</p></div>
<div class="product"><p>{{ slot_9 }}</p></div>
<div class="product"><p>{{ slot_10 }}</p></div>
<div class="product"><p>{{ slot_11 }}</p></div>
<div class="product"><p>{{ slot_12 }}</p></div>
<div class="product"><p>{{ slot_13 }}</p></div>
<div class="product"><p>{{ slot_14 }}</p></div>
<div class="product"><p>{{ slot_15 }}</p></div>
</section>
</main>
</body>
</html>