    align-items: center;
    height: calc(100vh - 60px);
    background-image: none;
    background-size: cover;
}


#services {
    display: flex;
    justify-content: space-around;
    margin-bottom: 20px;
}

.service {
    width: 30%;
    padding: 20px;
    text-align: center;
    border: 1px solid #000;
    box-shadow: -1px 1px 5px rgba(0, 0, 0, 0.1);
