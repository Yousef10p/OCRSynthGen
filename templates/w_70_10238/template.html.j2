    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
}

nav ul li {
    display: inline-block;
    margin: 0 10px;
}

nav ul li a {
    text-decoration: none;
    color: #fff;
}


section {
    padding: 20px;
    margin: 20px 0;
}


#slider div {
    background-color: #00897b;
    height: 200px;
    color: #fff;
    text-align: center;
    padding-top: 90px;
    margin: 10px 0;
}


#menu div {
    background-color: #8e24aa;
    height: 100px;
    color: #fff;
