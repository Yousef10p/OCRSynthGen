}


#reviews div {
    background-color: #ffeb3b;
    height: 100px;
    margin: 10px 0;
    text-align: center;
    padding-top: 45px;
}


footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px 0;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
