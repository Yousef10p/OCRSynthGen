<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 16.4mm; inline-size: 29.4mm; block-size: 5.0mm; font-size: 14.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 23.3mm; inline-size: 103.9mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 28.2mm; inline-size: 69.5mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 33.1mm; inline-size: 59.4mm; block-size: 4.7mm; font-size: 12.0pt"><li>{{ slot_3 }}</li></ul>
<div class="box ph" style="inset-inline-start: 31.7mm; inset-block-start: 37.9mm; inline-size: 50.8mm; block-size: 24.9mm; font-size: 12.0pt"></div>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 68.2mm; inline-size: 44.2mm; block-size: 4.7mm; font-size: 12.0pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 31.5mm; inset-block-start: 73.2mm; inline-size: 35.8mm; block-size: 72.4mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 150.7mm; inline-size: 123.7mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 31.3mm; inset-block-start: 160.2mm; inline-size: 125.3mm; block-size: 61.2mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 226.5mm; inline-size: 177.1mm; block-size: 14.4mm; font-size: 12.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 198.3mm; inset-block-start: 259.5mm; inline-size: 6.2mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
