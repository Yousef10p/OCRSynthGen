<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.0mm; inline-size: 215.9mm; block-size: 95.8mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 59.3mm; inset-block-start: 97.1mm; inline-size: 103.6mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 32.1mm; inset-block-start: 104.5mm; inline-size: 94.5mm; block-size: 40.2mm; font-size: 14.2pt"></div>
<p class="box" style="inset-inline-start: 134.5mm; inset-block-start: 106.3mm; inline-size: 55.4mm; block-size: 42.4mm; font-size: 15.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 147.9mm; inline-size: 71.0mm; block-size: 8.5mm; font-size: 12.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 114.9mm; inset-block-start: 151.4mm; inline-size: 70.7mm; block-size: 14.2mm; font-size: 13.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 161.7mm; inline-size: 75.3mm; block-size: 87.6mm; font-size: 15.5pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 114.7mm; inset-block-start: 170.3mm; inline-size: 78.0mm; block-size: 77.6mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 115.3mm; inset-block-start: 251.1mm; inline-size: 75.6mm; block-size: 6.9mm; font-size: 9.7pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 31.7mm; inset-block-start: 273.0mm; inline-size: 3.2mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 129.9mm; inset-block-start: 272.8mm; inline-size: 60.9mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
