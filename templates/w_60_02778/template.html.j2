<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<div class="slideshow">
<div class="mySlides fade">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_5 }}</p>
</div>
