<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 39.6mm; inline-size: 88.8mm; block-size: 12.8mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 54.2mm; inline-size: 82.6mm; block-size: 6.3mm; font-size: 13.0pt">{{ slot_6 }}</p>
