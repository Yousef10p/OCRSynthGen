<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 12.7mm; inset-block-start: 10.5mm; inline-size: 12.0mm; block-size: 12.0mm; font-size: 34.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 60.8mm; inset-block-start: 45.1mm; inline-size: 97.7mm; block-size: 23.3mm; font-size: 22.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 60.8mm; inset-block-start: 74.4mm; inline-size: 44.9mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 112.6mm; inline-size: 28.6mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 60.7mm; inset-block-start: 112.6mm; inline-size: 108.0mm; block-size: 21.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 60.7mm; inset-block-start: 138.0mm; inline-size: 112.0mm; block-size: 17.0mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 60.7mm; inset-block-start: 159.2mm; inline-size: 110.2mm; block-size: 25.5mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 60.7mm; inset-block-start: 188.8mm; inline-size: 108.0mm; block-size: 17.0mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 60.7mm; inset-block-start: 210.0mm; inline-size: 109.9mm; block-size: 17.0mm; font-size: 12.0pt">{{ slot_8 }}</p>
</div></body>
</html>
