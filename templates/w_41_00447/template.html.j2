    align-items: center;
    height: 100vh;
    color: #333;
}
header {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #f8f8f8;
}
nav ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
    padding: 0;
}
nav ul li a {
    text-decoration: none;
    color: #333;
}
nav input {
    margin: 10px;
    padding: 5px;
}
.product, .recipe {
    display: flex;
    flex-direction: column;
    align-items: center;
}
.product-image, .recipe-image {
    width: 100px;
    height: 100px;
    background-color: #ff69b4;
}
section {
    margin: 100px 0;
}
form {
    display: flex;
    flex-direction: column;
}
form input, form textarea {
    margin: 10px 0;
    padding: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
