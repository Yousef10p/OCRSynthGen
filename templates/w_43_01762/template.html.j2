  align-items: center;
  padding: 20px;
  min-height: 400px;
  background-color: lightgray;
}

#slideshow {
  display: flex;
  gap: 20px;
}

.slide {
  width: 200px;
  height: 200px;
  background-color: darkgray;
}

button {
  margin-top: 20px;
  padding: 10px 20px;
  background-color: lightgreen;
  border: none;
  cursor: pointer;
}


#membership {
  padding: 20px;
  background-color: lightsalmon;
}


#about {
  padding: 20px;
  background-color: lightyellow;
}


#contact {
  padding: 20px;
  background-color: lightpink;
}


footer {
  padding: 20px;
  background-color: black;
  color: white;
  text-align: center;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
