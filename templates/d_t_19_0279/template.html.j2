<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 9.4mm; inset-block-start: 6.9mm; inline-size: 67.9mm; block-size: 19.8mm; font-size: 14.0pt"></div>
<h1 class="box" style="inset-inline-start: 128.4mm; inset-block-start: 23.6mm; inline-size: 63.0mm; block-size: 40.5mm; font-size: 38.2pt">{{ slot_0 }}</h1>
<div class="box ph" style="inset-inline-start: 14.8mm; inset-block-start: 39.9mm; inline-size: 92.9mm; block-size: 188.5mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 141.9mm; inset-block-start: 89.7mm; inline-size: 40.0mm; block-size: 6.8mm; font-size: 19.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 142.4mm; inset-block-start: 98.6mm; inline-size: 38.9mm; block-size: 109.1mm; font-size: 14.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 181.0mm; inset-block-start: 218.0mm; inline-size: 20.1mm; block-size: 17.7mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 168.7mm; inset-block-start: 232.9mm; inline-size: 11.2mm; block-size: 2.4mm; font-size: 6.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 171.6mm; inset-block-start: 240.9mm; inline-size: 20.4mm; block-size: 5.4mm; font-size: 7.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 161.2mm; inset-block-start: 245.8mm; inline-size: 41.9mm; block-size: 10.4mm; font-size: 7.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 253.8mm; inline-size: 58.9mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 25.2mm; inset-block-start: 267.3mm; inline-size: 44.1mm; block-size: 8.8mm; font-size: 8.3pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 105.1mm; inset-block-start: 269.9mm; inline-size: 1.5mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
