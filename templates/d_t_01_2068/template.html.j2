<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 57.5mm; inset-block-start: 31.8mm; inline-size: 106.6mm; block-size: 79.1mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 66.2mm; inset-block-start: 115.1mm; inline-size: 89.5mm; block-size: 6.9mm; font-size: 19.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 123.7mm; inline-size: 6.1mm; block-size: 1.3mm; font-size: 5.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 64.6mm; inset-block-start: 127.9mm; inline-size: 93.6mm; block-size: 8.8mm; font-size: 12.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 65.8mm; inset-block-start: 139.0mm; inline-size: 91.2mm; block-size: 19.9mm; font-size: 14.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 71.6mm; inset-block-start: 161.3mm; inline-size: 79.6mm; block-size: 14.4mm; font-size: 13.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 81.5mm; inset-block-start: 183.1mm; inline-size: 58.7mm; block-size: 25.5mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 90.8mm; inset-block-start: 226.6mm; inline-size: 39.5mm; block-size: 18.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 89.0mm; inset-block-start: 249.4mm; inline-size: 44.1mm; block-size: 15.8mm; font-size: 11.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 14.5mm; inset-block-start: 268.0mm; inline-size: 45.1mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 94.9mm; inset-block-start: 267.6mm; inline-size: 32.3mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_8 }}</footer>
</div></body>
</html>
