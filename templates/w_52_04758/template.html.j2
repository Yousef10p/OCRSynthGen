<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<button>{{ slot_4 }}</button>
</header>
<section class="feature-sections">
<h2>{{ slot_5 }}</h2>
<div class="category">{{ slot_6 }}</div>
<div class="category">{{ slot_7 }}</div>
<div class="category">{{ slot_8 }}</div>
<h2>{{ slot_9 }}</h2>
<div class="deal">{{ slot_10 }}</div>
<div class="deal">{{ slot_11 }}</div>
</section>
<footer>
<a>{{ slot_12 }}</a> {{ slot_13 }}
        <a>{{ slot_14 }}</a> {{ slot_15 }}
        <a>{{ slot_16 }}</a> {{ slot_17 }}
        <a>{{ slot_18 }}</a>
</footer>
</body>
</html>