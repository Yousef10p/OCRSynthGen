<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    background-color: #eee;
}

.logo, .slide, .menu, .promo, .footer {
    background-color: #ccc;
    margin: 10px;
    padding: 20px;
    text-align: center;
}

.nav ul {
    display: flex;
    list-style: none;
}

.nav ul li a {
    margin-left: 10px;
}

.slideshow, .menuContainer, .promoContainer {
    display: flex;
    justify-content: space-evenly;
}

.footer a {
    margin-left: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo ph"></div>
<div class="nav">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
</div>
<div class="slideshow">
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
</div>
<div class="menuContainer">
<div class="menu">{{ slot_7 }}</div>
<div class="menu">{{ slot_8 }}</div>
<div class="menu">{{ slot_9 }}</div>
</div>
<div class="promoContainer">
<div class="promo">{{ slot_10 }}</div>
<div class="promo">{{ slot_11 }}</div>
<div class="promo">{{ slot_12 }}</div>
</div>
<div class="footer">
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</div>
</body>
</html>