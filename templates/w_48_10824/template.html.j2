<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    background-color: #f8f8f8;
    padding: 20px;
    text-align: center;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav li {
    display: inline-block;
    margin: 0 10px;
}

.dropdown {
    position: relative;
    display: inline-block;
}

.dropdown-btn {
    padding: 10px;
    background-color: #ddd;
}

.dropdown-content {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 160px;
    padding: 10px;
}

.dropdown:hover .dropdown-content {
    display: block;
}

.colored-rectangle {
    background-color: #333;
    width: 200px;
    height: 200px;
    margin: 10px auto;
}

.column {
    float: right;
    width: 33.3%;
    padding: 10px;
}

.row::after {
    content: "";
    display: table;
    clear: both;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</header>
<nav>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li class="dropdown">
<a class="dropdown-btn">{{ slot_4 }}</a>
<div class="dropdown-content">
<a>{{ slot_5 }}</a>
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
</div>
</li>
<li class="dropdown">
<a class="dropdown-btn">{{ slot_8 }}</a>
<div class="dropdown-content">
<a>{{ slot_9 }}</a>
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
</div>
</li>
<li><a>{{ slot_12 }}</a></li>
</ul>
</nav>
<div class="row">
<div class="column">
<p>{{ slot_13 }}</p>
<div class="colored-rectangle"></div>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>