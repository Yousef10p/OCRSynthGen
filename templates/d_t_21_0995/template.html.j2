<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 20.6mm; inset-block-start: 31.1mm; inline-size: 172.2mm; block-size: 103.2mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 59.5mm; inset-block-start: 137.1mm; inline-size: 93.8mm; block-size: 5.6mm; font-size: 19.0pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 153.3mm; inline-size: 90.3mm; block-size: 5.9mm; font-size: 22.1pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 160.5mm; inline-size: 149.9mm; block-size: 14.9mm; font-size: 22.1pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 176.9mm; inline-size: 140.2mm; block-size: 14.9mm; font-size: 22.1pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 193.2mm; inline-size: 34.1mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 201.4mm; inline-size: 131.1mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 209.5mm; inline-size: 147.5mm; block-size: 14.9mm; font-size: 22.1pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 225.9mm; inline-size: 153.6mm; block-size: 23.1mm; font-size: 22.1pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 250.4mm; inline-size: 126.7mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 258.5mm; inline-size: 37.9mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_9 }}</li></ul>
