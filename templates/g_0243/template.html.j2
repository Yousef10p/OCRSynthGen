<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 10pt; --line-height: 1.4; --align: justify; --page-width: 215.9mm; --page-height: 355.6mm; --page-margin: 17mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main style="column-count: 3; column-gap: 8mm; column-rule: 1px solid #bbb"><h3 style="font-size: calc(var(--base-size) * 1.15); text-align: end; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_1 }}</h3>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: end; margin-block: 0.6em 0.4em">{{ slot_2 }}</h3>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: var(--align); font-size: 1em">{{ slot_3 }}</p>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_4 }}</blockquote>
<p style="margin-block: 0 1em; text-indent: 0; text-align: start; font-size: 0.95em">{{ slot_5 }}</p>
<table style="border-collapse: collapse; inline-size: 100%; margin-block: 0.6em; font-size: 0.9em; break-inside: avoid">
<thead><tr>
<th style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start; background: #e8e8e8; font-weight: bold">{{ slot_6 }}</th>
<th style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start; background: #e8e8e8; font-weight: bold">{{ slot_7 }}</th>
<th style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start; background: #e8e8e8; font-weight: bold">{{ slot_8 }}</th>
</tr></thead>
<tbody>
<tr>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_9 }}</td>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_10 }}</td>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_11 }}</td>
</tr>
<tr>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_12 }}</td>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_13 }}</td>
<td style="border: 1px dashed #555; padding: 0.2em 0.3em; text-align: start">{{ slot_14 }}</td>
</tr>
</tbody>
</table></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_15 }}</span></footer>
</div></body>
</html>
