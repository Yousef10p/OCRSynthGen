<p>{{ slot_4 }}<br>
           {{ slot_5 }}</p>
</header>
<div class="slideshow">
<div class="slide" id="slide1">
<div class="text">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}<br>
                   {{ slot_8 }}</p>
</div>
</div>
<div class="slide" id="slide2">
<div class="text">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
</div>
<div class="slide" id="slide3">
<div class="text">
<h2>{{ slot_11 }}</h2>
