<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 12.5mm; inset-block-start: 14.8mm; inline-size: 69.2mm; block-size: 17.1mm; font-size: 16.1pt"></div>
<h1 class="box" style="inset-inline-start: 13.3mm; inset-block-start: 37.1mm; inline-size: 94.9mm; block-size: 7.7mm; font-size: 21.8pt">{{ slot_0 }}</h1>
<div class="box ph" style="inset-inline-start: 40.0mm; inset-block-start: 59.7mm; inline-size: 49.2mm; block-size: 49.8mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 88.6mm; inset-block-start: 62.0mm; inline-size: 44.3mm; block-size: 6.4mm; font-size: 18.2pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 136.4mm; inset-block-start: 92.5mm; inline-size: 42.2mm; block-size: 44.4mm; font-size: 15.7pt"></div>
<div class="box ph" style="inset-inline-start: 53.5mm; inset-block-start: 114.3mm; inline-size: 81.0mm; block-size: 80.4mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 147.9mm; inset-block-start: 140.7mm; inline-size: 50.7mm; block-size: 6.4mm; font-size: 18.2pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 10.8mm; inset-block-start: 166.2mm; inline-size: 40.9mm; block-size: 41.2mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 134.5mm; inset-block-start: 178.3mm; inline-size: 37.4mm; block-size: 37.1mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 211.6mm; inline-size: 68.0mm; block-size: 6.4mm; font-size: 18.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 142.7mm; inset-block-start: 220.4mm; inline-size: 48.7mm; block-size: 6.4mm; font-size: 18.2pt">{{ slot_4 }}</p>
<h1 class="box" style="inset-inline-start: 87.1mm; inset-block-start: 244.3mm; inline-size: 93.5mm; block-size: 8.1mm; font-size: 23.0pt">{{ slot_5 }}</h1>
</div></body>
</html>
