<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    background-color: #ffffff;
    color: #333333;
    margin: 0;
    padding: 0;
}
#nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #666666;
}
#nav li {
    float: right;
}
#nav li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}
#nav li a:hover {
    background-color: #999999;
}
#nav li a:active {
    background-color: #333333;
}
#hero {
    height: 500px;
    background-color: #999999;
    color: white;
    text-align: center;
    line-height: 500px;
}
#footer-container {
    display: flex;
    background-color: #333333;
    color: white;
    padding: 20px;
}
#footer-container .footer-column {
    width: 50%;
    padding: 20px;
}
#footer-container .footer-column a {
    color: white;
    text-decoration: none;
}
#footer-container .footer-column a:hover {
    text-decoration: underline;
}
form {
    margin: 20px;
}
form input[type="email"] {
    width: 200px;
    height: 30px;
    padding: 5px;
    border: 1px solid #999999;
}
form input[type="submit"] {
    height: 30px;
    padding: 5px;
    background-color: #999999;
    border: none;
    color: white;
}

@media (max-width: 600px) {
    #footer-container {
        flex-direction: column;
    }
    #footer-container .footer-column {
        width: 100%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav id="nav">
<ul>
