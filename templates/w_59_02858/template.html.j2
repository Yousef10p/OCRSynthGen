</ul>
</nav>
<div id="hero">
<h2>{{ slot_4 }}</h2>
<h3>{{ slot_5 }}</h3>
</div>
<footer id="footer-container">
<div class="footer-column">
<h3>{{ slot_6 }}</h3>
<p>{{ slot_7 }}</p>
</div>
<div class="footer-column">
<h3>{{ slot_8 }}</h3>
<p><a>{{ slot_9 }}</a></p>
<p><a>{{ slot_10 }}</a></p>
<p><a>{{ slot_11 }}</a></p>
</div>
</footer>
<form>
<label>{{ slot_12 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
