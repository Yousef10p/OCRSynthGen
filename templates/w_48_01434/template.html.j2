  padding: 0;
  font-family: var(--font-body);
}

header {
  background-color: #f8f8f8;
  padding: 20px 0;
  text-align: center;
}

#logo h1 {
  color: #333;
}

nav {
  background-color: #333;
  color: #fff;
  padding: 10px;
}

nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

nav ul li {
  display: inline;
  margin: 0 10px;
}

main {
  margin: 20px;
}

#featured {
  border: 1px solid #000;
