<li class="post">{{ slot_9 }}</li>
<li class="post">{{ slot_10 }}</li>
<li class="post">{{ slot_11 }}</li>
<li class="post">{{ slot_12 }}</li>
<li class="post">{{ slot_13 }}</li>
<li class="post">{{ slot_14 }}</li>
<li class="post">{{ slot_15 }}</li>
</ul>
</div>
<div class="right">
<h1>{{ slot_16 }}</h1>
<a>{{ slot_17 }}</a>
<a>{{ slot_18 }}</a>
</div>
</div>
</body>
</html>