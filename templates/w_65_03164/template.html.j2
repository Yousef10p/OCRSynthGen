}
.navbar ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}

.navbar li {
    float: right;
}

.navbar li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

.product-section {
    display: flex;
}

.product {
    margin: 10px;
    padding: 10px;
    border: 1px solid black;
    text-align: center;
}

.product-img {
    height: 100px;
    width: 100px;
    background-color: lightblue;
}

.about-us, .contact-us {
    margin: 20px;
    text-align: center;
}

.footer {
    background-color: #f8f8f8;
    text-align: center;
    padding: 10px;
    position: fixed;
    right: 0;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
