<div class="service">{{ slot_9 }}</div>
<div class="service">{{ slot_10 }}</div>
<div class="service">{{ slot_11 }}</div>
</section>
<section id="about">
<h2>{{ slot_12 }}</h2>
<div class="about">{{ slot_13 }}</div>
</section>
<section id="contact">
