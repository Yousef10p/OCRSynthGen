<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 171.7mm; inset-block-start: 9.2mm; inline-size: 29.4mm; block-size: 12.1mm; font-size: 17.1pt"></div>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 29.8mm; inline-size: 205.7mm; block-size: 74.2mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 107.2mm; inline-size: 45.9mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 120.0mm; inline-size: 52.0mm; block-size: 26.3mm; font-size: 12.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 120.0mm; inline-size: 51.3mm; block-size: 45.6mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 141.7mm; inset-block-start: 120.0mm; inline-size: 43.7mm; block-size: 7.8mm; font-size: 11.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.7mm; inset-block-start: 132.3mm; inline-size: 53.8mm; block-size: 53.6mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 150.8mm; inline-size: 53.9mm; block-size: 81.9mm; font-size: 12.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 170.3mm; inline-size: 52.2mm; block-size: 51.1mm; font-size: 13.2pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 83.3mm; inset-block-start: 225.6mm; inline-size: 39.4mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 231.5mm; inline-size: 54.1mm; block-size: 46.3mm; font-size: 13.1pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 236.8mm; inline-size: 40.6mm; block-size: 7.5mm; font-size: 10.7pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 246.8mm; inline-size: 53.5mm; block-size: 31.0mm; font-size: 12.5pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 133.9mm; inset-block-start: 285.2mm; inline-size: 68.1mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_11 }}</footer>
</div></body>
</html>
