<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 16.6mm; inset-block-start: 16.5mm; inline-size: 43.8mm; block-size: 6.5mm; font-size: 18.5pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 70.9mm; inset-block-start: 17.8mm; inline-size: 120.5mm; block-size: 16.7mm; font-size: 15.8pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 70.9mm; inset-block-start: 67.7mm; inline-size: 106.9mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 70.9mm; inset-block-start: 86.5mm; inline-size: 120.4mm; block-size: 15.3mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 70.9mm; inset-block-start: 102.1mm; inline-size: 120.4mm; block-size: 32.9mm; font-size: 10.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 25.2mm; inset-block-start: 126.0mm; inline-size: 32.0mm; block-size: 73.4mm; font-size: 34.7pt"></div>
<p class="box" style="inset-inline-start: 70.9mm; inset-block-start: 135.3mm; inline-size: 120.4mm; block-size: 37.7mm; font-size: 10.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 70.9mm; inset-block-start: 173.2mm; inline-size: 120.4mm; block-size: 37.7mm; font-size: 10.7pt">{{ slot_6 }}</p>
