<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
</div>
</header>

<main>
<h1>{{ slot_8 }}</h1>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>

<h2>{{ slot_11 }}</h2>
<div class="release">
