<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 32.2mm; inline-size: 125.0mm; block-size: 15.1mm; font-size: 21.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 78.1mm; inset-block-start: 57.4mm; inline-size: 111.8mm; block-size: 36.5mm; font-size: 14.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 26.5mm; inset-block-start: 100.2mm; inline-size: 164.6mm; block-size: 22.5mm; font-size: 15.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.5mm; inset-block-start: 124.2mm; inline-size: 164.1mm; block-size: 40.4mm; font-size: 16.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 26.5mm; inset-block-start: 166.2mm; inline-size: 164.3mm; block-size: 16.5mm; font-size: 15.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.5mm; inset-block-start: 184.1mm; inline-size: 162.8mm; block-size: 34.5mm; font-size: 16.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 26.5mm; inset-block-start: 220.1mm; inline-size: 162.3mm; block-size: 22.5mm; font-size: 15.9pt">{{ slot_6 }}</p>
</div></body>
</html>
