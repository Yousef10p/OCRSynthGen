  padding: 10px;
  background-color: #f8f9fa;
}
nav a {
  margin-left: 10px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin: 20px;
}
.grid-item {
  box-shadow: 0 0 5px rgba(0,0,0,0.1);
  padding: 10px;
}
.grid-item:hover {
