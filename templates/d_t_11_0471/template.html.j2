<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.9mm; inline-size: 164.5mm; block-size: 48.5mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 56.4mm; inset-block-start: 171.3mm; inline-size: 133.5mm; block-size: 25.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 200.1mm; inline-size: 124.3mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 50.8mm; inset-block-start: 207.9mm; inline-size: 139.1mm; block-size: 14.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 222.6mm; inline-size: 164.5mm; block-size: 12.1mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 69.0mm; inset-block-start: 237.8mm; inline-size: 120.9mm; block-size: 23.6mm; font-size: 12.0pt"></div>
