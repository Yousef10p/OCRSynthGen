    background-color: #f8f9fa;
    padding: 10px 20px;
}

#logo {
    font-size: 1.5em;
    font-weight: bold;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin-left: 15px;
}

#cta {
    background-color: #007bff;
    color: #fff;
    padding: 10px 15px;
    border-radius: 5px;
}

#hero {
    background-color: #007bff;
    color: #fff;
    padding: 50px 20px;
}

#services {
    display: grid;
