<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 24.6mm; inline-size: 215.7mm; block-size: 102.6mm; font-size: 15.3pt"></div>
<h2 class="box" style="inset-inline-start: 64.4mm; inset-block-start: 131.8mm; inline-size: 132.3mm; block-size: 23.7mm; font-size: 16.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 64.5mm; inset-block-start: 158.4mm; inline-size: 62.3mm; block-size: 41.3mm; font-size: 11.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 131.9mm; inset-block-start: 158.4mm; inline-size: 61.7mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 131.9mm; inset-block-start: 175.3mm; inline-size: 61.3mm; block-size: 24.5mm; font-size: 11.6pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 204.1mm; inline-size: 51.3mm; block-size: 39.0mm; font-size: 15.8pt"></div>
<div class="box ph" style="inset-inline-start: 98.3mm; inset-block-start: 204.3mm; inline-size: 34.3mm; block-size: 38.1mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 134.7mm; inset-block-start: 205.4mm; inline-size: 68.1mm; block-size: 37.1mm; font-size: 15.0pt"></div>
<div class="box ph" style="inset-inline-start: 51.9mm; inset-block-start: 211.4mm; inline-size: 46.1mm; block-size: 25.0mm; font-size: 14.2pt"></div>
<footer class="box" style="inset-inline-start: 12.6mm; inset-block-start: 257.5mm; inline-size: 2.3mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_4 }}</footer>
</div></body>
</html>
