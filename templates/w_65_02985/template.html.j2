<div class="project">{{ slot_3 }}</div>
<div class="project">{{ slot_4 }}</div>
<div class="project">{{ slot_5 }}</div>
</div>
<div class="right-column">
<h2>{{ slot_6 }}</h2>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>