<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 20.5mm; inset-block-start: 13.1mm; inline-size: 82.7mm; block-size: 8.5mm; font-size: 12.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 120.1mm; inset-block-start: 13.1mm; inline-size: 82.7mm; block-size: 14.2mm; font-size: 13.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.5mm; inset-block-start: 24.3mm; inline-size: 82.7mm; block-size: 53.7mm; font-size: 15.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 120.1mm; inset-block-start: 30.0mm; inline-size: 82.7mm; block-size: 36.8mm; font-size: 14.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 120.1mm; inset-block-start: 69.5mm; inline-size: 82.7mm; block-size: 53.7mm; font-size: 15.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.5mm; inset-block-start: 80.8mm; inline-size: 82.8mm; block-size: 48.1mm; font-size: 15.1pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 139.4mm; inline-size: 203.9mm; block-size: 127.5mm; font-size: 15.1pt"></div>
</div></body>
</html>
