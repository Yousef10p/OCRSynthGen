<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 89.5mm; inset-block-start: 35.0mm; inline-size: 32.9mm; block-size: 4.8mm; font-size: 15.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 164.7mm; inset-block-start: 36.1mm; inline-size: 15.0mm; block-size: 3.4mm; font-size: 10.6pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 35.8mm; inset-block-start: 43.2mm; inline-size: 139.8mm; block-size: 10.2mm; font-size: 14.0pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 82.4mm; inset-block-start: 62.6mm; inline-size: 45.7mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 76.5mm; inset-block-start: 72.7mm; inline-size: 57.2mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 64.1mm; inset-block-start: 79.2mm; inline-size: 82.2mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_5 }}</h2>
<h2 class="box" style="inset-inline-start: 64.3mm; inset-block-start: 97.3mm; inline-size: 52.6mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_6 }}</h2>
<h2 class="box" style="inset-inline-start: 64.3mm; inset-block-start: 105.8mm; inline-size: 47.6mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_7 }}</h2>
<div class="box ph" style="inset-inline-start: 32.7mm; inset-block-start: 118.2mm; inline-size: 144.5mm; block-size: 142.0mm; font-size: 18.3pt"></div>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 280.9mm; inline-size: 1.9mm; block-size: 3.4mm; font-size: 10.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
