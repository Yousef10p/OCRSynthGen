<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<main>
<section id="menu">
<h2>{{ slot_3 }}</h2>
<div class="item">
<h3>{{ slot_4 }}</h3>
<div class="image" style="background-color: #FFA07A;">{{ slot_5 }}</div>
<p>{{ slot_6 }}</p>
</div>
<div class="item">
<h3>{{ slot_7 }}</h3>
<div class="image" style="background-color: #FF7F50;">{{ slot_8 }}</div>
<p>{{ slot_9 }}</p>
</div>
<div class="item">
<h3>{{ slot_10 }}</h3>
<div class="image" style="background-color: #FA8072;">{{ slot_11 }}</div>
<p>{{ slot_12 }}</p>
</div>
