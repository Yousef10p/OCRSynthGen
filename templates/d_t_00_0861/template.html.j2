<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 30.2mm; inset-block-start: 13.1mm; inline-size: 156.0mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 20.3mm; inset-block-start: 35.5mm; inline-size: 176.3mm; block-size: 19.5mm; font-size: 13.8pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 145.7mm; inset-block-start: 55.9mm; inline-size: 48.8mm; block-size: 43.8mm; font-size: 15.5pt"></div>
<ul class="box" style="inset-inline-start: 33.0mm; inset-block-start: 60.2mm; inline-size: 111.2mm; block-size: 44.2mm; font-size: 12.5pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 39.4mm; inset-block-start: 104.6mm; inline-size: 157.7mm; block-size: 34.3mm; font-size: 12.2pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 33.0mm; inset-block-start: 144.1mm; inline-size: 163.8mm; block-size: 39.3mm; font-size: 12.4pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 82.0mm; inset-block-start: 183.7mm; inline-size: 115.9mm; block-size: 44.2mm; font-size: 11.4pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 38.5mm; inset-block-start: 184.4mm; inline-size: 41.5mm; block-size: 40.8mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 39.4mm; inset-block-start: 228.1mm; inline-size: 157.3mm; block-size: 24.4mm; font-size: 11.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 193.2mm; inset-block-start: 263.1mm; inline-size: 2.0mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_7 }}</footer>
</div></body>
</html>
