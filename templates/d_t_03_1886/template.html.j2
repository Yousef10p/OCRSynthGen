<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 46.3mm; inset-block-start: 7.8mm; inline-size: 145.2mm; block-size: 11.5mm; font-size: 16.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 124.4mm; inset-block-start: 22.5mm; inline-size: 70.5mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 37.0mm; inset-block-start: 34.3mm; inline-size: 57.1mm; block-size: 2.8mm; font-size: 8.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 38.2mm; inline-size: 215.5mm; block-size: 156.0mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 82.5mm; inset-block-start: 197.6mm; inline-size: 103.5mm; block-size: 37.0mm; font-size: 17.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 82.5mm; inset-block-start: 239.9mm; inline-size: 104.4mm; block-size: 23.6mm; font-size: 16.7pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 19.1mm; inset-block-start: 270.8mm; inline-size: 44.7mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 208.0mm; inset-block-start: 270.8mm; inline-size: 3.1mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_6 }}</footer>
</div></body>
</html>
