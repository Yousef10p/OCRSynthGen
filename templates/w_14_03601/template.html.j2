}

nav ul li { 
    float: right;
}

nav ul li a { 
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

nav ul li a:hover {
    background-color: #111;
}


.img-placeholder {
    height: 200px;
