<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  font-family: var(--font-body);
  color: #333;
}

nav {
  position: fixed;
  top: 0;
  width: 100%;
  background: #f8f8f8;
}

nav ul {
  margin: 0;
  padding: 1em;
  list-style: none;
  text-align: center;
}

nav li {
  display: inline;
  margin: 0 1em;
}

nav a {
  text-decoration: none;
  color: #ff6d6d;
}

.cta {
  display: inline-block;
  margin: 1em 0;
  padding: 0.5em;
  background: #f43f5e;
  color: #fff;
  text-decoration: none;
  text-transform: uppercase;
  font-weight: 700;
}

.image-rectangle {
  height: 10em;
  width: 100%;
  background: #1D4ED8;
}

main {
  margin-top: 5em;
  padding: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<main>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<a class="cta">{{ slot_7 }}</a>
<div class="image-rectangle ph"></div>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="image-rectangle ph"></div>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<div class="image-rectangle ph"></div>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="image-rectangle ph"></div>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
<a class="cta">{{ slot_16 }}</a>
</main>
</body>
</html>