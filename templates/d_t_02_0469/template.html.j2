<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.8mm; inset-block-start: 7.5mm; inline-size: 71.8mm; block-size: 10.2mm; font-size: 28.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 13.1mm; inset-block-start: 21.4mm; inline-size: 174.1mm; block-size: 42.5mm; font-size: 20.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 13.1mm; inset-block-start: 69.0mm; inline-size: 174.2mm; block-size: 49.9mm; font-size: 20.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 22.6mm; inset-block-start: 134.2mm; inline-size: 65.6mm; block-size: 6.3mm; font-size: 9.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 10.1mm; inset-block-start: 140.6mm; inline-size: 90.7mm; block-size: 6.3mm; font-size: 9.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 11.6mm; inset-block-start: 155.6mm; inline-size: 186.1mm; block-size: 107.1mm; font-size: 40.0pt"></div>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 268.6mm; inline-size: 2.6mm; block-size: 6.4mm; font-size: 18.3pt">{{ slot_5 }}</footer>
</div></body>
</html>
