<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 97.7mm; inline-size: 160.5mm; block-size: 42.5mm; font-size: 17.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 142.1mm; inline-size: 93.4mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_5 }}</p>
