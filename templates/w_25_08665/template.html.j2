.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    background-color: #f4f4f4;
    padding: 0;
    margin: 0;
}

header, main, footer {
    padding: 20px;
}

#services, #resources {
    transition: background-color 0.3s ease;
}

#services:hover, #resources:hover {
    background-color: #f1f1f1;
}

section {
    margin: 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
}

h2 {
    grid-column: 1 / span 3;
}

footer {
    position: sticky;
    bottom: 0;
    padding: 20px;
    background-color: #333;
    color: #fff;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
