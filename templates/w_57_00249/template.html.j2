<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #FFE4E1;
    color: #483D8B;
}

.container {
    display: grid;
    grid-template-areas: "navigation featured-products"
                           "footer footer";
    grid-template-columns: 1fr 3fr;
    grid-gap: 20px;
}


.navigation {
    grid-area: navigation;
    position: sticky;
    top: 0;
    height: 100vh;
    background-color: #FFB6C1;
}

.navigation h3 {
    margin-bottom: 10px;
}

.navigation ul {
    list-style-type: none;
    padding-right: 0;
}

.navigation li {
    margin-bottom: 10px;
}


.featured-products {
    grid-area: featured-products;
    padding: 20px;
}

.featured-products h1 {
    margin-bottom: 20px;
}

.product {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
}

.image {
    background-color: #FFA07A;
    width: 100px;
    height: 100px;
    margin-left: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-weight: bold;
}


.footer {
    grid-area: footer;
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 20vh;
    background-color: #FFC0CB;
}

.footer a {
    text-decoration: none;
    color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="navigation">
<h3>{{ slot_0 }}</h3>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="featured-products">
<h1>{{ slot_6 }}</h1>
<div class="product"><span class="image">{{ slot_7 }}</span><p>{{ slot_8 }}</p></div>
<div class="product"><span class="image">{{ slot_9 }}</span><p>{{ slot_10 }}</p></div>
<div class="product"><span class="image">{{ slot_11 }}</span><p>{{ slot_12 }}</p></div>
</div>
<div class="footer">
<h3>{{ slot_13 }}</h3>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
<a>{{ slot_16 }}</a>
</div>
</div>
</body>
</html>