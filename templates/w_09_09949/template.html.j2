<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  font-family: var(--font-body);
}

.sidebar {
  position: fixed;
  width: 200px;
  height: 100vh;
  background-color: #222;
  color: white;
  padding: 20px;
  box-sizing: border-box;
}

.sidebar a {
  color: white;
  text-decoration: none;
}

.sidebar .cta {
  display: inline-block;
  padding: 10px 20px;
  background-color: #ff9900;
  color: white;
  text-align: center;
  border-radius: 5px;
  margin-top: 20px;
}

.sidebar .cta:hover {
  background-color: #ff7700;
}

.main {
  margin-right: 220px;
  padding: 20px;
}

.product, .research {
  height: 200px;
  margin-bottom: 20px;
  color: white;
}

#product1 { background-color: #00ff00 }
#product2 { background-color: #0000ff }
#product3 { background-color: #ff0000 }
#research1 { background-color: #ffff00 }
#research2 { background-color: #00ffff }
#research3 { background-color: #ff00ff }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="sidebar">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
<p>{{ slot_5 }}</p>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
<div class="cta"><a>{{ slot_9 }}</a></div>
</div>
<div class="main">
<div class="product" id="product1">{{ slot_10 }}</div>
<div class="product" id="product2">{{ slot_11 }}</div>
<div class="product" id="product3">{{ slot_12 }}</div>
<div class="research" id="research1">{{ slot_13 }}</div>
<div class="research" id="research2">{{ slot_14 }}</div>
<div class="research" id="research3">{{ slot_15 }}</div>
</div>
</body>
</html>