<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 19.6mm; inset-block-start: 12.7mm; inline-size: 38.5mm; block-size: 19.0mm; font-size: 13.5pt"></div>
<p class="box" style="inset-inline-start: 62.1mm; inset-block-start: 15.2mm; inline-size: 69.2mm; block-size: 16.9mm; font-size: 8.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 17.6mm; inset-block-start: 46.7mm; inline-size: 176.0mm; block-size: 203.9mm; font-size: 9.0pt"></div>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 280.6mm; inline-size: 121.5mm; block-size: 3.2mm; font-size: 7.3pt">{{ slot_1 }}</p>
<footer class="box" style="inset-inline-start: 22.1mm; inset-block-start: 286.5mm; inline-size: 22.1mm; block-size: 6.0mm; font-size: 8.0pt">{{ slot_2 }}</footer><footer class="box" style="inset-inline-start: 50.3mm; inset-block-start: 286.2mm; inline-size: 47.1mm; block-size: 2.5mm; font-size: 8.0pt">{{ slot_3 }}</footer><footer class="box" style="inset-inline-start: 172.4mm; inset-block-start: 286.2mm; inline-size: 11.1mm; block-size: 2.5mm; font-size: 8.0pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 52.9mm; inset-block-start: 290.2mm; inline-size: 36.4mm; block-size: 2.5mm; font-size: 8.0pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 107.2mm; inset-block-start: 290.2mm; inline-size: 15.3mm; block-size: 2.5mm; font-size: 8.0pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 132.9mm; inset-block-start: 290.2mm; inline-size: 22.1mm; block-size: 2.5mm; font-size: 8.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 170.0mm; inset-block-start: 290.2mm; inline-size: 18.2mm; block-size: 2.5mm; font-size: 8.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
