    background-color: #357ebd;
    color: #fff;
}
header .hero {
    width: 100%;
    height: 100%;
    background-image: none;
    background-size: cover;
    position: absolute;
    top: 0;
    right: 0;
    z-index: -1;
}
main {
    padding: 20px;
}
section {
    margin: 50px 0;
}
footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    background-color: #333;
    color: #fff;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 20px 0;
}
footer a {
    color: #fff;
    text-decoration: none;
}
footer a:hover {
    color: #357ebd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
