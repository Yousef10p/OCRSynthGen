<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 39.0mm; inset-block-start: 51.2mm; inline-size: 102.0mm; block-size: 8.1mm; font-size: 22.8pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 39.0mm; inset-block-start: 65.1mm; inline-size: 16.7mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 48.5mm; inset-block-start: 70.0mm; inline-size: 132.9mm; block-size: 18.8mm; font-size: 10.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 39.0mm; inset-block-start: 93.0mm; inline-size: 15.9mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 48.5mm; inset-block-start: 97.9mm; inline-size: 137.8mm; block-size: 14.8mm; font-size: 10.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 39.0mm; inset-block-start: 116.9mm; inline-size: 24.7mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 48.5mm; inset-block-start: 121.8mm; inline-size: 135.9mm; block-size: 14.8mm; font-size: 10.5pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 46.6mm; inset-block-start: 160.6mm; inline-size: 147.7mm; block-size: 82.2mm; font-size: 23.3pt"></div>
<footer class="box" style="inset-inline-start: 156.8mm; inset-block-start: 268.8mm; inline-size: 44.4mm; block-size: 3.4mm; font-size: 9.5pt">{{ slot_7 }}</footer>
</div></body>
</html>
