<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 44.7mm; inline-size: 168.6mm; block-size: 27.2mm; font-size: 15.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 72.7mm; inline-size: 168.4mm; block-size: 10.0mm; font-size: 14.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 37.2mm; inset-block-start: 84.9mm; inline-size: 79.4mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 90.6mm; inline-size: 168.2mm; block-size: 8.8mm; font-size: 12.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 37.1mm; inset-block-start: 101.0mm; inline-size: 79.7mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 37.1mm; inset-block-start: 107.4mm; inline-size: 82.4mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_7 }}</p>
