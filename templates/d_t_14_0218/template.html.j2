<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 30.7mm; inline-size: 76.3mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_0 }}</p>
<h1 class="box" style="inset-inline-start: 14.9mm; inset-block-start: 129.7mm; inline-size: 65.3mm; block-size: 13.5mm; font-size: 38.2pt">{{ slot_1 }}</h1>
<h1 class="box" style="inset-inline-start: 14.9mm; inset-block-start: 146.8mm; inline-size: 90.0mm; block-size: 8.7mm; font-size: 24.6pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 14.9mm; inset-block-start: 159.5mm; inline-size: 172.9mm; block-size: 16.1mm; font-size: 22.8pt">{{ slot_3 }}</h1>
<div class="box ph" style="inset-inline-start: 14.6mm; inset-block-start: 251.2mm; inline-size: 40.3mm; block-size: 26.1mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 168.8mm; inset-block-start: 265.8mm; inline-size: 16.4mm; block-size: 11.1mm; font-size: 31.6pt"></div>
</div></body>
</html>
