<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: row;
}

#left-sidebar {
    width: 200px;
    height: 100vh;
    background-color: #ccc;
    padding: 1em;
}

#fullscreen-slider {
    width: calc(100vw - 200px);
    height: 100vh;
    background-color: #eee;
    padding: 1em;
}

a {
    display: block;
    color: #000;
    text-decoration: none;
    margin-bottom: 0.5em;
}

ul {
    list-style-type: none;
    padding: 0;
}


li:before {
    content: "";
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-left: 0.5em;
    background: red;
}

li:nth-child(2n):before {
    background: blue;
}

li:nth-child(3n):before {
    background: green;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="left-sidebar">
<h3>{{ slot_0 }}</h3>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>

</ul>
<h3>{{ slot_4 }}</h3>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>

</ul>
</div>
<div id="fullscreen-slider">
<p>{{ slot_8 }}</p>
<ul>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>

</ul>
<p>{{ slot_12 }}</p>
<ul>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>

</ul>
</div>
</body>
</html>