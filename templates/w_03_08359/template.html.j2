<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

header {
  text-align: center;
}

header img {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: #F0F0F0;
}

nav ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background-color: #333;
}

nav li {
  float: right;
}

nav li a {
  display: block;
  color: white;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}

nav li a:hover {
  background-color: #111;
}

.feature_img {
  width: 100px;
  height: 100px;
  margin: 10px;
  text-align: center;
}

.red {
  background: red;
}

.green {
  background: green;
}

.blue {
  background: blue;
}

footer {
  text-align: center;
  padding: 10px;
  background: lightgray;
  position: fixed;
  bottom: 0;
  width: 100%;
}

footer a {
  margin: 0 10px;
  color: black;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</header>
<main>
<div id="investment">
<h1>{{ slot_3 }}</h1>
<p>{{ slot_4 }}</p>
<div class="feature_img red">{{ slot_5 }}</div>
</div>
<div id="banking">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div class="feature_img green">{{ slot_8 }}</div>
</div>
<div id="insurance">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
<div class="feature_img blue">{{ slot_11 }}</div>
</div>
</main>
<footer>
<a>{{ slot_12 }}</a> {{ slot_13 }} <a>{{ slot_14 }}</a>
</footer>
</body>
</html>