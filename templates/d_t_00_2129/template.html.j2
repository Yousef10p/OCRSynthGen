<p class="box" style="inset-inline-start: 24.8mm; inset-block-start: 157.0mm; inline-size: 80.5mm; block-size: 43.0mm; font-size: 15.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 157.0mm; inline-size: 79.4mm; block-size: 53.9mm; font-size: 15.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.8mm; inset-block-start: 204.5mm; inline-size: 80.6mm; block-size: 25.8mm; font-size: 14.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 215.9mm; inline-size: 81.0mm; block-size: 42.8mm; font-size: 15.2pt">{{ slot_7 }}</p>
