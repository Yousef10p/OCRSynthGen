<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	margin: 0;
	padding: 0;
	font-family: var(--font-body);
}

#sticky_nav {
	position: sticky;
	top: 0;
	background-color: #333;
	color: #fff;
	padding: 20px;
	display: flex;
	justify-content: space-around;
}

#sticky_nav a {
	color: #fff;
	text-decoration: none;
}

.services {
	display: grid;
	grid-template-columns: 1fr 1fr 1fr;
	gap: 20px;
	padding: 20px;
}

.service {
	border: 1px solid #333;
	border-radius: 3px;
	padding: 15px;
	text-align: center;
}

.service h3 {
	margin-bottom: 10px;
}

.placeholder {
	height: 200px;
	background-color: #ddd;
	display: flex;
	justify-content: center;
	align-items: center;
	margin: 20px 0;
}

.quote {
	padding: 20px;
	text-align: center;
}

.quote h2 {
	margin-bottom: 15px;
}

.quote form {
	display: flex;
	flex-direction: column;
	width: 40%;
	margin: 0 auto;
}

.quote form input, 
.quote form textarea,
.quote form button {
	padding: 10px;
	margin-bottom: 15px;
	border: 1px solid #333;
	border-radius: 3px;
}

.quote form button {
	background-color: #333;
	color: #fff;
	border: none;
	cursor: pointer;
}

footer {
	background-color: #333;
	color: #fff;
	text-align: center;
	padding: 10px;
	position: absolute;
	bottom: 0;
	width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
