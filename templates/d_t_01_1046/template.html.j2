<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 23.6mm; inset-block-start: 0.0mm; inline-size: 185.9mm; block-size: 216.6mm; font-size: 15.0pt"></div>
<div class="box ph" style="inset-inline-start: 169.5mm; inset-block-start: 217.4mm; inline-size: 40.1mm; block-size: 51.5mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 74.8mm; inset-block-start: 224.9mm; inline-size: 26.3mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 106.2mm; inset-block-start: 224.9mm; inline-size: 15.6mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 127.4mm; inset-block-start: 224.9mm; inline-size: 10.2mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 74.8mm; inset-block-start: 238.1mm; inline-size: 80.7mm; block-size: 7.1mm; font-size: 10.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 74.8mm; inset-block-start: 249.6mm; inline-size: 88.5mm; block-size: 11.4mm; font-size: 10.7pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 7.1mm; inset-block-start: 288.0mm; inline-size: 1.8mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 20.3mm; inset-block-start: 288.0mm; inline-size: 34.7mm; block-size: 2.3mm; font-size: 6.4pt">{{ slot_6 }}</footer>
</div></body>
</html>
