.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #eee;
  font-family: var(--font-body);
}

header {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  background: #333;
  color: #fff;
  text-align: center;
  padding: 10px 0;
}

#left-column {
  width: 30%;
  background: #ddd;
  padding: 20px;
}

#right-column {
  width: 70%;
  background: #bbb;
  padding: 20px;
}

#left-column, #right-column {
  height: 70vh;
  overflow-y: auto;
  margin: 20px;
  border-radius: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
