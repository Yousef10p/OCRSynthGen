<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 72.0mm; inset-block-start: 26.9mm; inline-size: 71.9mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 36.5mm; inline-size: 30.1mm; block-size: 11.7mm; font-size: 11.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 152.7mm; inset-block-start: 36.5mm; inline-size: 35.7mm; block-size: 11.7mm; font-size: 11.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 86.6mm; inset-block-start: 55.4mm; inline-size: 42.7mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 64.6mm; inline-size: 160.9mm; block-size: 37.1mm; font-size: 11.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 107.1mm; inline-size: 160.9mm; block-size: 54.0mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 166.6mm; inline-size: 160.9mm; block-size: 28.6mm; font-size: 11.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 200.7mm; inline-size: 160.9mm; block-size: 45.6mm; font-size: 11.7pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 83.6mm; inset-block-start: 262.2mm; inline-size: 48.8mm; block-size: 6.0mm; font-size: 8.5pt">{{ slot_8 }}</footer>
</div></body>
</html>
