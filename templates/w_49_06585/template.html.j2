<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

header, footer {
  background: #333;
  color: white;
  padding: 20px;
}

header input {
  float: left;
  padding: 5px;
}

footer input {
  width: 100%;
  padding: 10px;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  grid-gap: 20px;
  padding: 20px;
}

.box {
  background: #ddd;
  height: 200px;
  color: black;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</header>
<main>
<div class="grid">
<div class="box">{{ slot_2 }}</div>
<div class="box">{{ slot_3 }}</div>
<div class="box">{{ slot_4 }}</div>
<div class="box">{{ slot_5 }}</div>
<div class="box">{{ slot_6 }}</div>
<div class="box">{{ slot_7 }}</div>
<div class="box">{{ slot_8 }}</div>
<div class="box">{{ slot_9 }}</div>
<div class="box">{{ slot_10 }}</div>
<div class="box">{{ slot_11 }}</div>
<div class="box">{{ slot_12 }}</div>
<div class="box">{{ slot_13 }}</div>
<div class="box">{{ slot_14 }}</div>
<div class="box">{{ slot_15 }}</div>
<div class="box">{{ slot_16 }}</div>
<div class="box">{{ slot_17 }}</div>
</div>
</main>
<footer>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_18 }}</span>
</footer>
</body>
</html>