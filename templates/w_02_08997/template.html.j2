<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-columns: 1fr 3fr 1fr;
    grid-template-areas: 
        "header header header"
        "featured main aside"
        "footer footer footer";
}

header {
    grid-area: header;
    background-color: #f9f9f9;
    padding: 10px;
}

#featured {
    grid-area: featured;
    background-color: #f1f1f1;
    padding: 10px;
}

main {
    grid-area: main;
    background-color: #f1f1f1;
    padding: 10px;
}

aside {
    grid-area: aside;
    background-color: #f1f1f1;
    padding: 10px;
}

footer {
    grid-area: footer;
    background-color: #f9f9f9;
    padding: 10px;
}


h2 {
    margin-bottom: 10px;
}
.product, .category, .news, .blog, .social, .logo, .copyright, .shipping {
    background-color: #c7c7c7;
    height: 200px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
</header>
<section id="featured">
<h2>{{ slot_1 }}</h2>
<div class="product">{{ slot_2 }}</div>
</section>
<main>
<h2>{{ slot_3 }}</h2>
<div class="category">{{ slot_4 }}</div>
<div class="product">{{ slot_5 }}</div>
</main>
<aside>
<h2>{{ slot_6 }}</h2>
<div class="news">{{ slot_7 }}</div>
<h2>{{ slot_8 }}</h2>
<div class="blog">{{ slot_9 }}</div>
<h2>{{ slot_10 }}</h2>
<div class="social">{{ slot_11 }}</div>
</aside>
<footer>
<div class="logo">{{ slot_12 }}</div>
<div class="copyright">{{ slot_13 }}</div>
<div class="shipping">{{ slot_14 }}</div>
</footer>
</body>
</html>