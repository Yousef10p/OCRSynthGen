<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 16.0mm; inline-size: 150.6mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 23.2mm; inline-size: 88.9mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 30.7mm; inline-size: 106.6mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 39.1mm; inline-size: 179.7mm; block-size: 97.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 140.8mm; inline-size: 179.9mm; block-size: 12.4mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 157.7mm; inline-size: 179.5mm; block-size: 25.1mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 187.3mm; inline-size: 179.5mm; block-size: 37.9mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 229.7mm; inline-size: 179.3mm; block-size: 12.4mm; font-size: 11.8pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 137.9mm; inset-block-start: 243.5mm; inline-size: 54.0mm; block-size: 4.1mm; font-size: 11.8pt"></div>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 249.1mm; inline-size: 28.8mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 19.1mm; inset-block-start: 262.0mm; inline-size: 50.3mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_9 }}</footer>
</div></body>
</html>
