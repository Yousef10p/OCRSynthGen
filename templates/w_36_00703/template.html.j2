<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
  color: #666;
  line-height: 1.6em;
}

header{
  text-align: center;
  padding: 20px;
  background: #333;
  color: white;
}

nav {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #333;
  color: white;
}

nav ul {
  list-style: none;
}

nav a {
  text-decoration: none;
  color:white;
}

.pimg1, .pimg2, .pimg3{
  position: relative;
  opacity: 0.70;
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  background-attachment: fixed;
}

.pimg1 {
  min-height: 100%;
}

.pimg2 {
  min-height: 400px;
}

.pimg3 {
  min-height: 400px;
}

.ptext {
  position: absolute;
  top: 50%;
  width: 100%;
  text-align: center;
  color: #000;
  font-size: 27px;
  letter-spacing: 8px;
  text-transform: uppercase;
}

.section {
  padding: 50px 80px;
}

.section-light {
  background: #f4f4f4;
  color: #666;
}

.section-dark {
  background: #333;
  color: #ddd;
}

footer {
  background: #333;
  color: white;
  padding: 20px;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
