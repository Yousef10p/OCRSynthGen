<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 24.4mm; inset-block-start: 4.4mm; inline-size: 56.3mm; block-size: 10.5mm; font-size: 29.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 17.0mm; inline-size: 85.4mm; block-size: 10.9mm; font-size: 15.5pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 5.7mm; inset-block-start: 29.0mm; inline-size: 136.8mm; block-size: 103.9mm; font-size: 17.3pt"></div>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 133.1mm; inline-size: 105.4mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_2 }}</h2>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 139.5mm; inline-size: 128.2mm; block-size: 4.6mm; font-size: 6.6pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 143.4mm; inline-size: 132.0mm; block-size: 12.4mm; font-size: 7.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 155.2mm; inline-size: 132.0mm; block-size: 8.5mm; font-size: 6.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 163.0mm; inline-size: 131.9mm; block-size: 12.4mm; font-size: 7.1pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 174.8mm; inline-size: 126.9mm; block-size: 4.6mm; font-size: 5.0pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 178.7mm; inline-size: 125.4mm; block-size: 8.7mm; font-size: 8.2pt"><li>{{ slot_8 }}</li></ul>
</div></body>
</html>
