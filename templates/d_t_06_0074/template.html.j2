<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 47.8mm; inset-block-start: 38.3mm; inline-size: 120.0mm; block-size: 48.9mm; font-size: 15.4pt"></div>
<h2 class="box" style="inset-inline-start: 11.7mm; inset-block-start: 92.0mm; inline-size: 133.1mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 11.7mm; inset-block-start: 101.9mm; inline-size: 194.2mm; block-size: 12.9mm; font-size: 12.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 11.7mm; inset-block-start: 119.9mm; inline-size: 193.6mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 11.7mm; inset-block-start: 133.3mm; inline-size: 193.4mm; block-size: 17.5mm; font-size: 12.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 11.7mm; inset-block-start: 155.9mm; inline-size: 193.6mm; block-size: 22.0mm; font-size: 12.5pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 12.2mm; inset-block-start: 182.2mm; inline-size: 29.7mm; block-size: 13.3mm; font-size: 12.5pt"></div>
<p class="box" style="inset-inline-start: 11.7mm; inset-block-start: 195.9mm; inline-size: 31.3mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 11.7mm; inset-block-start: 205.0mm; inline-size: 21.4mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 107.3mm; inset-block-start: 268.2mm; inline-size: 1.2mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_7 }}</footer>
</div></body>
</html>
