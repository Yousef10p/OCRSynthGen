<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: flex-end;
    padding: 20px;
    background-color: #ddd;
}

.search-bar form {
    display: flex;
}

.search-bar input {
    height: 25px;
}

.search-bar button {
    margin-right: 10px;
}

.grid-content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
    padding: 20px;
}

.grid-item {
    height: 200px;
    background-color: #ddd;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
}

footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: #ddd;
    margin-top: 20px;
}

footer form {
    display: flex;
    align-items: center;
}

footer input {
    margin-right: 10px;
    height: 25px;
}

footer button {
    margin-right: 10px;
}

footer a {
    margin-right: 10px;
    text-decoration: none;
    color: black;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>

<div class="search-bar">
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<button>{{ slot_1 }}</button>
</form>
</div>
</header>

<section class="grid-content">
<div class="grid-item">{{ slot_2 }}</div>
<div class="grid-item">{{ slot_3 }}</div>
<div class="grid-item">{{ slot_4 }}</div>
<div class="grid-item">{{ slot_5 }}</div>
<div class="grid-item">{{ slot_6 }}</div>
<div class="grid-item">{{ slot_7 }}</div>
</section>
<footer>

<form>
<label>{{ slot_8 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>
<button>{{ slot_10 }}</button>
</form>

<p>{{ slot_11 }} <a>{{ slot_12 }}</a> {{ slot_13 }} <a>{{ slot_14 }}</a> {{ slot_15 }} <a>{{ slot_16 }}</a></p>
</footer>
</body>
</html>