}

h1 {
    font-size: 3em;
}

h2 {
    font-size: 2em;
}

article {
    display: block;
    text-align: center;
    margin: 50px 0;
    color: #444444;
}

article .image-placeholder {
    height: 200px;
    width: 200px;
    background-color: #666666;
    margin: auto;
    margin-bottom: 50px;
}

footer {
    background-color: #444444;
    color: white;
    text-align: center;
    padding: 20px 0;
    position: absolute;
    bottom: 0;
    width: 100%;
}

footer a {
    color: white;
    margin: 0 20px;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
