<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 75.3mm; inset-block-start: 28.2mm; inline-size: 66.7mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 28.8mm; inset-block-start: 35.2mm; inline-size: 160.5mm; block-size: 40.1mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 28.8mm; inset-block-start: 80.9mm; inline-size: 160.5mm; block-size: 47.4mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 28.8mm; inset-block-start: 133.9mm; inline-size: 160.5mm; block-size: 18.3mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 157.8mm; inline-size: 160.9mm; block-size: 61.9mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 225.4mm; inline-size: 160.8mm; block-size: 11.1mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 242.1mm; inline-size: 160.9mm; block-size: 18.4mm; font-size: 12.0pt">{{ slot_6 }}</p>
</div></body>
</html>
