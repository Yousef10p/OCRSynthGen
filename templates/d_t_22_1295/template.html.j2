<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 48.5mm; inline-size: 39.7mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 55.7mm; inline-size: 107.7mm; block-size: 12.8mm; font-size: 12.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 71.2mm; inline-size: 107.3mm; block-size: 16.9mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 90.7mm; inline-size: 109.5mm; block-size: 16.9mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 110.3mm; inline-size: 38.8mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 18.4mm; inset-block-start: 117.6mm; inline-size: 33.7mm; block-size: 16.3mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 134.0mm; inline-size: 17.6mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 16.0mm; inset-block-start: 142.7mm; inline-size: 70.7mm; block-size: 15.3mm; font-size: 21.6pt"></div>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 157.6mm; inline-size: 37.4mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_7 }}</p>
</div></body>
</html>
