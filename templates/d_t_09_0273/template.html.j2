<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 26.7mm; inline-size: 165.1mm; block-size: 20.6mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 88.9mm; inset-block-start: 60.2mm; inline-size: 101.6mm; block-size: 4.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 72.4mm; inline-size: 165.1mm; block-size: 20.8mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 67.2mm; inset-block-start: 111.3mm; inline-size: 75.3mm; block-size: 66.4mm; font-size: 17.1pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 186.4mm; inline-size: 165.1mm; block-size: 8.8mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 209.7mm; inline-size: 165.1mm; block-size: 29.0mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 83.1mm; inset-block-start: 239.4mm; inline-size: 107.4mm; block-size: 10.6mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 261.6mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_4 }}</footer>
</div></body>
</html>
