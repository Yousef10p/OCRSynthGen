<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    font-family: var(--font-body);
}

a {
    text-decoration: none;
    color: black;
}


.left-column {
    width: 20%;
    background-color: #f1f1f1;
    padding: 10px;
}

.left-column input {
    width: 100%;
    padding: 5px;
    margin-bottom: 10px;
}

.left-column ul {
    list-style-type: none;
    padding: 0;
}

.left-column a {
    display: block;
    margin-bottom: 5px;
}


.right-column {
    width: 80%;
    padding: 10px;
}

.right-column h2 {
    margin-top: 0;
}

.hotel, .flight, .tour {
    height: 100px;
    margin-bottom: 10px;
}

.hotel {
    background-color: #FCEE21;
}

.flight {
    background-color: #44D6EB;
}

.tour {
    background-color: #F26430;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="left-column">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="right-column">
<h2>{{ slot_4 }}</h2>
<div class="hotel">{{ slot_5 }}</div>
<div class="hotel">{{ slot_6 }}</div>
<div class="hotel">{{ slot_7 }}</div>
<h2>{{ slot_8 }}</h2>
<div class="flight">{{ slot_9 }}</div>
<div class="flight">{{ slot_10 }}</div>
<div class="flight">{{ slot_11 }}</div>
<h2>{{ slot_12 }}</h2>
<div class="tour">{{ slot_13 }}</div>
<div class="tour">{{ slot_14 }}</div>
<div class="tour">{{ slot_15 }}</div>
</div>
</body>
</html>