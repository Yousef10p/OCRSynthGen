  display: inline-block;
  padding: 10px;
  position: relative;
}

nav ul li a {
  text-decoration: none;
  color: white;
}

nav ul li:hover .dropdown-menu {
  display: block;
}

nav ul .dropdown-menu {
  display: none;
  position: absolute;
  background: green;
  width: 200px;
}

nav ul .dropdown-menu li {
  display: block;
}

.banner {
  height: 300px;
  background: green;
  color: white;
  text-align: center;
  padding: 50px;
}

footer {
  background: pink;
  color: white;
  padding: 20px;
