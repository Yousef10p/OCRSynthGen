<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<section id="hero">
<div class="hero-content">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
</div>
<div class="sidebar">
<h2>{{ slot_7 }}</h2>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
<h2>{{ slot_11 }}</h2>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</div>
</section>
</header>
</body>
</html>