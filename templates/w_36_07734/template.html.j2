<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

#side-menu {
    width: 0;
    height: 100%;
    position: fixed;
    z-index: 1;
    top: 0;
    right: 0;
    background-color: #111;
    overflow-x: hidden;
    transition: 0.5s;
    padding-top: 60px;
}

#side-menu a {
    padding: 8px 32px 8px 8px;
    text-decoration: none;
    font-size: 25px;
    color: #818181;
    display: block;
    transition: 0.3s;
}

#side-menu a:hover {
    color: #f1f1f1;
}

#content {
    transition: margin-right .5s;
    padding: 20px;
}

.img-placeholder {
    width: 100%;
    height: 200px;
    background-color: #ddd;
    margin: 20px 0;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="side-menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div id="content">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div class="img-placeholder ph"></div>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="img-placeholder ph"></div>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<div class="img-placeholder ph"></div>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<div class="img-placeholder ph"></div>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
</div>
</body>
</html>