<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 54.1mm; inset-block-start: 29.6mm; inline-size: 127.2mm; block-size: 11.6mm; font-size: 16.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 50.8mm; inset-block-start: 45.3mm; inline-size: 18.0mm; block-size: 5.6mm; font-size: 15.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 54.7mm; inline-size: 152.7mm; block-size: 141.2mm; font-size: 16.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 199.8mm; inline-size: 152.6mm; block-size: 22.9mm; font-size: 16.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 41.4mm; inset-block-start: 226.7mm; inline-size: 18.2mm; block-size: 5.6mm; font-size: 15.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 236.1mm; inline-size: 152.7mm; block-size: 28.6mm; font-size: 16.2pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 268.2mm; inline-size: 62.5mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 96.2mm; inset-block-start: 268.2mm; inline-size: 32.4mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 180.4mm; inset-block-start: 268.2mm; inline-size: 3.5mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
