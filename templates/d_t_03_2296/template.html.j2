<h2 class="box" style="inset-inline-start: 150.9mm; inset-block-start: 39.3mm; inline-size: 27.2mm; block-size: 7.0mm; font-size: 6.6pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 196.3mm; inset-block-start: 39.3mm; inline-size: 30.9mm; block-size: 4.0mm; font-size: 5.7pt">{{ slot_2 }}</h2>
