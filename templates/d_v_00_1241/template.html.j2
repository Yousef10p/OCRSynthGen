<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 22.4mm; inset-block-start: 12.2mm; inline-size: 87.8mm; block-size: 7.0mm; font-size: 9.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 19.2mm; inline-size: 48.7mm; block-size: 3.9mm; font-size: 5.5pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 22.4mm; inset-block-start: 28.0mm; inline-size: 82.3mm; block-size: 5.1mm; font-size: 14.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 29.5mm; inset-block-start: 33.4mm; inline-size: 57.0mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 37.7mm; inline-size: 87.7mm; block-size: 102.4mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 29.5mm; inset-block-start: 144.8mm; inline-size: 97.5mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 29.5mm; inset-block-start: 148.8mm; inline-size: 97.2mm; block-size: 3.3mm; font-size: 9.5pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 29.5mm; inset-block-start: 152.9mm; inline-size: 95.3mm; block-size: 3.3mm; font-size: 9.5pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 29.5mm; inset-block-start: 156.9mm; inline-size: 59.4mm; block-size: 3.3mm; font-size: 9.5pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 29.5mm; inset-block-start: 160.9mm; inline-size: 102.5mm; block-size: 3.3mm; font-size: 9.5pt"><li>{{ slot_9 }}</li></ul>
<ul class="box" style="inset-inline-start: 29.5mm; inset-block-start: 164.9mm; inline-size: 164.3mm; block-size: 3.3mm; font-size: 9.5pt"><li>{{ slot_10 }}</li></ul>
<footer class="box" style="inset-inline-start: 162.3mm; inset-block-start: 286.6mm; inline-size: 37.3mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_11 }}</footer>
</div></body>
</html>
