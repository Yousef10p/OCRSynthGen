<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 99.2mm; inset-block-start: 15.4mm; inline-size: 11.2mm; block-size: 3.5mm; font-size: 15.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 22.8mm; inline-size: 33.0mm; block-size: 3.5mm; font-size: 15.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 30.1mm; inline-size: 15.9mm; block-size: 3.5mm; font-size: 15.0pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 37.4mm; inline-size: 81.7mm; block-size: 3.5mm; font-size: 15.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 44.7mm; inline-size: 199.4mm; block-size: 10.5mm; font-size: 15.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 58.9mm; inline-size: 199.4mm; block-size: 20.8mm; font-size: 15.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 83.5mm; inline-size: 199.4mm; block-size: 13.9mm; font-size: 15.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 101.2mm; inline-size: 199.4mm; block-size: 7.0mm; font-size: 15.0pt">{{ slot_7 }}</p>
