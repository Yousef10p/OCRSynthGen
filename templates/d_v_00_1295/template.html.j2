<p class="box" style="inset-inline-start: 107.1mm; inset-block-start: 209.4mm; inline-size: 73.2mm; block-size: 15.3mm; font-size: 14.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 24.7mm; inset-block-start: 226.9mm; inline-size: 74.1mm; block-size: 32.8mm; font-size: 15.5pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 106.3mm; inset-block-start: 227.3mm; inline-size: 85.8mm; block-size: 44.6mm; font-size: 15.8pt"></div>
<footer class="box" style="inset-inline-start: 11.8mm; inset-block-start: 279.6mm; inline-size: 69.8mm; block-size: 7.2mm; font-size: 20.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
