<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 18.5mm; inset-block-start: 33.5mm; inline-size: 51.3mm; block-size: 10.8mm; font-size: 30.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 123.5mm; inset-block-start: 38.7mm; inline-size: 51.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 123.2mm; inset-block-start: 49.4mm; inline-size: 34.6mm; block-size: 26.3mm; font-size: 14.9pt"></div>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 75.0mm; inline-size: 118.0mm; block-size: 104.2mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 123.5mm; inset-block-start: 80.8mm; inline-size: 49.3mm; block-size: 16.6mm; font-size: 15.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 123.5mm; inset-block-start: 102.4mm; inline-size: 62.3mm; block-size: 50.3mm; font-size: 15.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 24.7mm; inset-block-start: 188.0mm; inline-size: 54.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 24.7mm; inset-block-start: 198.6mm; inline-size: 76.2mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_5 }}</h2>
<div class="box ph" style="inset-inline-start: 24.6mm; inset-block-start: 208.6mm; inline-size: 15.6mm; block-size: 13.5mm; font-size: 12.8pt"></div>
