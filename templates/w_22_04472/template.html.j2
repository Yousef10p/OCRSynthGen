}
.nav > ul {
    display: flex;
    list-style-type: none;
}
.nav > ul > li {
    margin: 0 1em;
}
.recipes {
    display: flex;
    height: 100vh;
}
.recipes-index {
    flex: 5;
    display: flex;
}
.recipes-index > article {
    flex: 1;
}
.contact {
    height: 100vh;
}
footer {
    display: flex;
