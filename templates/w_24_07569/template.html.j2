<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  color: white;
}

.fullscreen-header-image {
  height: 100vh;
  background: linear-gradient(to left, #4b79a1, #283e51);
}

nav ul {
  display: flex;
  justify-content: space-around;
  background: #283e51;
  color: white;
  padding: 1em 0;
}

nav li {
  list-style: none;
}

nav a {
  color: white;
  text-decoration: none;
  padding: 0.5em;
  transition: background-color 0.3s ease;
}

nav a:hover {
  background-color: #4b79a1;
}

.hero, .features, .pricing, .testimonials {
  padding: 2em;
}

.hero, .testimonials {
  background: #4b79a1;
}

.icon {
  width: 100px;
  height: 100px;
  background: #283e51;
  margin: 1em 0;
}

button {
  background: #4b79a1;
  color: white;
  border: none;
  padding: 0.5em 1em;
  margin-left: 1em;
  cursor: pointer;
}

footer {
  background: #283e51;
  padding: 1em;
  display: flex;
  justify-content: space-between;
}

.company-info, .social-media-links {
  width: 300px;
  height: 100px;
  background: #4b79a1;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
