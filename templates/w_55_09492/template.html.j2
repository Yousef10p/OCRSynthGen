<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

header {
  position: fixed;
  width: 100%;
  top: 0;
  background-color: #333;
  color: #fff;
  padding: 10px 0;
  text-align: center;
}

nav ul {
  display: flex;
  justify-content: space-around;
  list-style-type: none;
  padding: 0;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}

#current-location {
  position: absolute;
  left: 0;
  padding: 10px;
}

main {
  margin-top: 60px;
}

#featured {
  display: flex;
  justify-content: space-around;
}

.destination {
  width: 30%;
  background-color: #ddd;
  text-align: center;
  padding: 20px;
  border: 1px solid #000;
  border-radius: 5px;
}

.thumbnail {
  width: 100%;
  height: 200px;
  margin-bottom: 20px;
  background-color: #000;
}

footer {
  text-align: center;
  background-color: #333;
  color: #fff;
  padding: 20px 0;
}

#map {
  width: 100%;
  height: 200px;
  background-color: #000;
  margin-bottom: 20px;
}

form {
  display: flex;
  justify-content: center;
}

form input[type="text"] {
  width: 60%;
  padding: 10px;
  margin-left: 10px;
}

form button {
  padding: 10px 20px;
  background-color: #008CBA;
  color: white;
  border: none;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
