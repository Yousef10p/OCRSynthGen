<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  height: 100vh;
  margin: 0;
  font-family: var(--font-body);
  position: relative;
}

header {
  position: relative;
  width: 100%;
  height: 200px;
  background-color: #f5f5f5;
  text-align: right;
  padding: 20px;
}

#hero {
  position: relative;
  width: 80%;
  height: 160px;
  background-color: #bcbcbc;
  color: white;
  text-align: right;
  padding-top: 60px;
  padding-right: 20px;
}

nav {
  position: absolute;
  width: 200px;
  height: 100%;
  background-color: #ebebeb;
  padding: 20px;
}

nav li {
  margin-bottom: 10px;
}

main {
  position: absolute;
  right: 200px;
  width: calc(100% - 200px);
  height: 100%;
  padding: 20px;
  overflow: auto;
}

.course {
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div id="hero">{{ slot_0 }}</div>
</header>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<main>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
<div class="course">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<button>{{ slot_8 }}</button>
</div>
<div class="course">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<button>{{ slot_11 }}</button>
</div>
<div class="course">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<button>{{ slot_14 }}</button>
</div>
</main>
</body>
</html>