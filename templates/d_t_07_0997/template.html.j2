<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 21.6mm; inset-block-start: 29.1mm; inline-size: 55.9mm; block-size: 6.5mm; font-size: 18.5pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 21.6mm; inset-block-start: 42.1mm; inline-size: 82.2mm; block-size: 23.8mm; font-size: 11.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 109.5mm; inset-block-start: 42.1mm; inline-size: 81.9mm; block-size: 23.8mm; font-size: 11.3pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 19.3mm; inset-block-start: 81.5mm; inline-size: 171.9mm; block-size: 85.1mm; font-size: 17.2pt"></div>
<h2 class="box" style="inset-inline-start: 21.7mm; inset-block-start: 177.2mm; inline-size: 57.7mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 21.7mm; inset-block-start: 181.5mm; inline-size: 71.8mm; block-size: 11.2mm; font-size: 10.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.6mm; inset-block-start: 206.8mm; inline-size: 38.4mm; block-size: 44.9mm; font-size: 11.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 65.5mm; inset-block-start: 206.8mm; inline-size: 35.5mm; block-size: 36.5mm; font-size: 11.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 109.4mm; inset-block-start: 206.8mm; inline-size: 37.3mm; block-size: 23.8mm; font-size: 11.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 153.4mm; inset-block-start: 206.8mm; inline-size: 38.1mm; block-size: 40.7mm; font-size: 11.5pt">{{ slot_8 }}</p>
</div></body>
</html>
