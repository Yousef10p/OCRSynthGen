<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

.left-menu {
  position: fixed;
  right: 0;
  top: 0;
  bottom: 0;
  width: 200px;
  padding: 20px;
  background-color: #f8f9fa;
}

.left-menu ul {
  list-style-type: none;
  padding: 0;
}

.left-menu a {
  color: #007bff;
  text-decoration: none;
}

.full-width-bg {
  width: 100%;
  height: 200px;
  background-color: #f8f9fa;
  text-align: center;
  padding-top: 80px;
}

.destination, .package {
  width: 100%;
  height: 200px;
  background-color: #f8f9fa;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="left-menu">
<h2>{{ slot_0 }}</h2>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="full-width-bg">
<p>{{ slot_6 }}</p>
</div>
<h1 id="dest1">{{ slot_7 }}</h1>
<div class="destination"></div>
<p>{{ slot_8 }}</p>
<h1 id="dest2">{{ slot_9 }}</h1>
<div class="destination"></div>
<p>{{ slot_10 }}</p>
<h1 id="dest3">{{ slot_11 }}</h1>
<div class="destination"></div>
<p>{{ slot_12 }}</p>
<h1 id="pack1">{{ slot_13 }}</h1>
<div class="package"></div>
<p>{{ slot_14 }}</p>
<h1 id="pack2">{{ slot_15 }}</h1>
<div class="package"></div>
<p>{{ slot_16 }}</p>
</body>
</html>