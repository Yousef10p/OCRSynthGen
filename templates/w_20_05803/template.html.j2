    margin: 0;
    padding: 0;
    background-color: #008080; 
    color: #fff;
}

header {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100px;
}

header img {
    width: 50%;
}

nav {
    display: flex;
    justify-content: space-around;
    background-color: #00008B; 
    color: #fff;
}

nav a {
    text-decoration: none;
    color: #fff;
}

aside {
    background-color: #00008B;
    color: #fff;
    float: right;
    width: 20%;
}

section img {
    display: block;
    width: 100%;
    height: 300px;
    background-color: #fff;
}

p {
    text-align: center;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
