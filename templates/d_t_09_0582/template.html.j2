<p class="box" style="inset-inline-start: 47.2mm; inset-block-start: 96.8mm; inline-size: 121.3mm; block-size: 17.6mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 72.4mm; inset-block-start: 121.1mm; inline-size: 96.0mm; block-size: 8.6mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 47.2mm; inset-block-start: 136.6mm; inline-size: 76.1mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 73.2mm; inset-block-start: 146.5mm; inline-size: 95.3mm; block-size: 8.9mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 47.2mm; inset-block-start: 162.4mm; inline-size: 121.3mm; block-size: 31.6mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 47.2mm; inset-block-start: 197.6mm; inline-size: 121.3mm; block-size: 38.7mm; font-size: 10.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 106.9mm; inset-block-start: 245.2mm; inline-size: 1.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
