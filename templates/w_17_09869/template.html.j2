    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
}
header {
    background-color: #f8f9fa;
    padding: 20px;
    position: sticky;
    top: 0;
}
nav ul {
    display: flex;
    justify-content: space-around;
}
nav ul li {
    list-style: none;
}
nav ul li a {
    text-decoration: none;
    color: #333;
}
.product-carousel, .category-list, .featured-products, .cart-items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    margin: 20px;
}
.product-carousel .carousel-item, .category-list .category-item, .featured-products .product-item, .cart-items .cart-item {
    height: 200px;
    line-height: 200px;
    text-align: center;
    color: #fff;
    background-color: #6c757d;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
