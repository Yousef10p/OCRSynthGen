<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 24.3mm; inset-block-start: 12.5mm; inline-size: 102.6mm; block-size: 16.5mm; font-size: 23.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 36.9mm; inline-size: 163.8mm; block-size: 20.7mm; font-size: 14.7pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 9.6mm; inset-block-start: 75.0mm; inline-size: 196.0mm; block-size: 87.1mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 178.1mm; inline-size: 78.9mm; block-size: 34.8mm; font-size: 12.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 116.4mm; inset-block-start: 178.1mm; inline-size: 75.4mm; block-size: 7.3mm; font-size: 10.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 116.4mm; inset-block-start: 189.3mm; inline-size: 75.4mm; block-size: 29.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 216.9mm; inline-size: 81.0mm; block-size: 39.4mm; font-size: 12.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 116.4mm; inset-block-start: 222.9mm; inline-size: 82.8mm; block-size: 34.2mm; font-size: 12.1pt">{{ slot_6 }}</p>
</div></body>
</html>
