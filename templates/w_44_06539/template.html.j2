<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    background-color: #f4a261;
    padding: 20px 0;
    text-align: center;
}

#search-bar input {
    padding: 10px;
    font-size: 16px;
}

#search-bar button {
    padding: 10px;
    font-size: 16px;
    background-color: #2a9d8f;
    color: white;
    border: none;
}

nav {
    background-color: #264653;
    color: white;
    padding: 10px 0;
    text-align: center;
}

nav ul {
    list-style-type: none;
}

nav ul li {
    display: inline;
    padding: 0 20px;
}

nav ul li a {
    color: white;
    text-decoration: none;
}

main {
    padding: 20px 0;
    text-align: center;
}

.image-placeholder {
    width: 100%;
    height: 400px;
    background-color: #e9c46a;
}

footer {
    background-color: #e76f51;
    color: white;
    text-align: center;
    padding: 20px 0;
}

footer ul {
    list-style-type: none;
    padding: 0;
}

footer ul li {
    display: inline;
    padding: 0 20px;
}

footer ul li a {
    color: white;
    text-decoration: none;
}

#contact-form input, #contact-form textarea {
    display: block;
    margin: 10px auto;
    padding: 10px;
    font-size: 16px;
}

#contact-form button {
    display: block;
    margin: 10px auto;
    padding: 10px;
    font-size: 16px;
    background-color: #2a9d8f;
    color: white;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
