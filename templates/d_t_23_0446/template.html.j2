<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 1.9mm; inline-size: 97.3mm; block-size: 5.6mm; font-size: 8.0pt">{{ slot_0 }}</h2>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 7.5mm; inline-size: 103.8mm; block-size: 4.4mm; font-size: 5.0pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 11.3mm; inline-size: 122.7mm; block-size: 8.7mm; font-size: 6.2pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 19.9mm; inline-size: 120.9mm; block-size: 4.4mm; font-size: 5.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 23.7mm; inline-size: 125.4mm; block-size: 8.7mm; font-size: 6.2pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 32.3mm; inline-size: 58.3mm; block-size: 27.2mm; font-size: 8.6pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 73.0mm; inset-block-start: 33.0mm; inline-size: 68.7mm; block-size: 25.7mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 17.9mm; inset-block-start: 58.8mm; inline-size: 118.7mm; block-size: 8.2mm; font-size: 5.8pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 66.4mm; inline-size: 125.4mm; block-size: 13.0mm; font-size: 7.4pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 79.2mm; inline-size: 125.4mm; block-size: 17.3mm; font-size: 8.2pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 96.4mm; inline-size: 125.4mm; block-size: 13.0mm; font-size: 9.2pt"><li>{{ slot_9 }}</li></ul>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 110.0mm; inline-size: 32.6mm; block-size: 4.6mm; font-size: 6.5pt">{{ slot_10 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 114.5mm; inline-size: 129.7mm; block-size: 24.6mm; font-size: 10.0pt">{{ slot_11 }}</p>
</div></body>
</html>
