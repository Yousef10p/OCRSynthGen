}

header { 
    position: fixed; 
    top: 0;
    width: 100%;
    padding: 1rem;
    background-color: #eee;
}

nav ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
}

section {
    padding: 1rem;
}

#hero {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: white;
    background-color: #333;
}

#products { 
    display: flex;
    flex-wrap: wrap;
}

.product { 
    width: 30%;
    margin: 1rem;
    padding: 1rem;
    background-color: #eee;
}

footer { 
    position: fixed;
    bottom: 0;
    width: 100%;
    padding: 1rem;
    background-color: #eee;
    display: flex;
    justify-content: space-around;
}

#map { 
    width: 50%;
    background-color: #ddd;
}

.social-icons a {
    margin: 0 1rem;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
