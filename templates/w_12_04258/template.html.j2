<a>{{ slot_3 }}</a>
</div>
</li>
<li class="dropdown">
<a>{{ slot_4 }}</a>
<div class="dropdown-content">
<a>{{ slot_5 }}</a>
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
</div>
</li>
<li class="dropdown">
<a>{{ slot_8 }}</a>
<div class="dropdown-content">
<a>{{ slot_9 }}</a>
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
</div>
</li>
</ul>
</nav>
<div class="logo">{{ slot_12 }}</div>
<div class="tagline">{{ slot_13 }}</div>
</header>
<div class="slider">
<div class="slide">{{ slot_14 }}</div>
<div class="slide">{{ slot_15 }}</div>
<div class="slide">{{ slot_16 }}</div>
</div>
</body>
</html>