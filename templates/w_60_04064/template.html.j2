}

.testimonial {
    width: 45%;
    background: #fff;
    box-shadow: 0 0 5px rgba(0,0,0,0.1);
    padding: 20px;
}


footer {
    background: #333;
    color: #fff;
    padding: 10px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
