<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 25.0mm; inline-size: 47.5mm; block-size: 5.5mm; font-size: 7.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 29.5mm; inline-size: 160.7mm; block-size: 18.7mm; font-size: 10.6pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 51.8mm; inline-size: 148.0mm; block-size: 9.8mm; font-size: 13.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 63.1mm; inline-size: 157.3mm; block-size: 18.7mm; font-size: 13.2pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 83.3mm; inline-size: 144.0mm; block-size: 5.3mm; font-size: 15.0pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 245.3mm; inline-size: 152.6mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 255.4mm; inline-size: 52.8mm; block-size: 11.6mm; font-size: 11.0pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 187.3mm; inset-block-start: 255.4mm; inline-size: 3.5mm; block-size: 4.3mm; font-size: 9.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
