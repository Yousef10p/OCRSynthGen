<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 94.8mm; inline-size: 165.1mm; block-size: 20.8mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 120.1mm; inline-size: 165.1mm; block-size: 12.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
