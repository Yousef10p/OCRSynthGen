<p class="box" style="inset-inline-start: 42.2mm; inset-block-start: 56.9mm; inline-size: 70.6mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 67.7mm; inline-size: 141.7mm; block-size: 18.4mm; font-size: 17.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 90.3mm; inline-size: 58.7mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 47.3mm; inset-block-start: 100.7mm; inline-size: 36.1mm; block-size: 14.7mm; font-size: 13.9pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 34.5mm; inset-block-start: 119.1mm; inline-size: 46.4mm; block-size: 6.0mm; font-size: 16.9pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 129.4mm; inline-size: 142.5mm; block-size: 89.2mm; font-size: 18.1pt">{{ slot_7 }}</p>
