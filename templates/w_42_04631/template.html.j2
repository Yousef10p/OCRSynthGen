  display: flex;
  list-style: none;
}

nav ul li:not(:last-child) {
  margin-left: 20px;
}

nav ul li a.btn {
  background-color: #333;
  color: #fff;
  padding: 6px 16px;
  border-radius: 5px;
  text-decoration: none;
}

.hero {
  width: 100%;
}

.hero img {
  width: 100%;
}

main {
  display: flex;
  flex-wrap: wrap;
  margin: 15px;
}

section {
  width: 100%;
  margin-bottom: 20px;
}

section img {
  width: 100%;
  margin-bottom: 15px;
}

footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f4f4f4;
  padding: 15px;
  text-align: center;
}

@media screen and (min-width: 768px) {
  section {
    width: 49VW;
  }
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
