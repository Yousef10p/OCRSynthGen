<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 38.1mm; inset-block-start: 33.8mm; inline-size: 40.8mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 173.7mm; inset-block-start: 33.8mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 47.3mm; inline-size: 139.7mm; block-size: 30.1mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 51.6mm; inset-block-start: 86.1mm; inline-size: 126.2mm; block-size: 29.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 127.1mm; inline-size: 139.7mm; block-size: 29.0mm; font-size: 12.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 38.1mm; inset-block-start: 168.2mm; inline-size: 98.6mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 180.0mm; inline-size: 139.7mm; block-size: 20.6mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 75.9mm; inset-block-start: 208.8mm; inline-size: 101.9mm; block-size: 10.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 227.6mm; inline-size: 139.7mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_6 }}</p>
</div></body>
</html>
