<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 136.3mm; inset-block-start: 2.2mm; inline-size: 58.5mm; block-size: 4.4mm; font-size: 10.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 14.3mm; inline-size: 114.9mm; block-size: 4.9mm; font-size: 11.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 25.8mm; inline-size: 18.3mm; block-size: 4.9mm; font-size: 11.0pt">{{ slot_2 }}</h2>
<ul class="box" style="inset-inline-start: 28.3mm; inset-block-start: 34.2mm; inline-size: 66.3mm; block-size: 4.9mm; font-size: 11.0pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 37.8mm; inset-block-start: 44.6mm; inline-size: 62.9mm; block-size: 4.6mm; font-size: 11.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 18.6mm; inset-block-start: 57.5mm; inline-size: 13.8mm; block-size: 13.8mm; font-size: 13.1pt"></div>
<h2 class="box" style="inset-inline-start: 43.2mm; inset-block-start: 57.6mm; inline-size: 11.6mm; block-size: 5.3mm; font-size: 12.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 43.2mm; inset-block-start: 66.7mm; inline-size: 146.5mm; block-size: 4.9mm; font-size: 11.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 187.4mm; inset-block-start: 288.6mm; inline-size: 7.6mm; block-size: 6.2mm; font-size: 14.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
