<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 17.8mm; inset-block-start: 27.5mm; inline-size: 95.3mm; block-size: 7.4mm; font-size: 16.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 17.8mm; inset-block-start: 40.4mm; inline-size: 59.3mm; block-size: 5.0mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 50.5mm; inline-size: 181.0mm; block-size: 15.2mm; font-size: 9.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 67.8mm; inline-size: 179.4mm; block-size: 15.2mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 85.2mm; inline-size: 179.7mm; block-size: 22.9mm; font-size: 9.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 110.3mm; inline-size: 181.1mm; block-size: 7.6mm; font-size: 9.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 120.0mm; inline-size: 179.8mm; block-size: 11.4mm; font-size: 9.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 133.6mm; inline-size: 178.1mm; block-size: 11.4mm; font-size: 9.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 147.1mm; inline-size: 180.3mm; block-size: 11.4mm; font-size: 9.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 106.2mm; inset-block-start: 261.1mm; inline-size: 3.7mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
