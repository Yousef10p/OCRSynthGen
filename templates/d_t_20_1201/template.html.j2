<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.8mm; inset-block-start: 5.8mm; inline-size: 4.3mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 48.1mm; inset-block-start: 5.2mm; inline-size: 51.8mm; block-size: 5.6mm; font-size: 15.7pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 13.3mm; inline-size: 46.7mm; block-size: 6.7mm; font-size: 18.9pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 21.4mm; inline-size: 23.7mm; block-size: 7.2mm; font-size: 10.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 27.8mm; inline-size: 109.0mm; block-size: 4.6mm; font-size: 5.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 55.8mm; inset-block-start: 31.7mm; inline-size: 73.6mm; block-size: 31.6mm; font-size: 9.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 18.4mm; inset-block-start: 33.7mm; inline-size: 36.5mm; block-size: 28.5mm; font-size: 16.2pt"></div>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 64.0mm; inline-size: 111.0mm; block-size: 47.0mm; font-size: 11.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 112.4mm; inline-size: 103.7mm; block-size: 8.3mm; font-size: 7.8pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 120.8mm; inline-size: 56.5mm; block-size: 5.6mm; font-size: 7.9pt">{{ slot_8 }}</h2>
<div class="box ph" style="inset-inline-start: 19.3mm; inset-block-start: 127.6mm; inline-size: 111.4mm; block-size: 22.9mm; font-size: 16.2pt"></div>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 153.0mm; inline-size: 110.2mm; block-size: 20.0mm; font-size: 11.3pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 35.0mm; inset-block-start: 174.7mm; inline-size: 75.0mm; block-size: 26.1mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 54.8mm; inset-block-start: 205.0mm; inline-size: 38.3mm; block-size: 3.9mm; font-size: 11.1pt"></div>
</div></body>
</html>
