<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 20.9mm; inline-size: 75.2mm; block-size: 4.7mm; font-size: 11.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 34.1mm; inline-size: 35.0mm; block-size: 4.7mm; font-size: 11.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 90.1mm; inset-block-start: 52.0mm; inline-size: 29.5mm; block-size: 4.7mm; font-size: 11.0pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 26.1mm; inset-block-start: 66.2mm; inline-size: 19.5mm; block-size: 4.7mm; font-size: 9.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 75.2mm; inline-size: 163.1mm; block-size: 19.0mm; font-size: 11.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 103.8mm; inline-size: 163.1mm; block-size: 18.8mm; font-size: 11.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 104.7mm; inset-block-start: 270.4mm; inline-size: 5.7mm; block-size: 4.3mm; font-size: 9.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
