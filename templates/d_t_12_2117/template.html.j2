<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 108.2mm; inline-size: 86.5mm; block-size: 91.7mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 117.0mm; inline-size: 86.6mm; block-size: 138.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 203.3mm; inline-size: 86.5mm; block-size: 11.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
