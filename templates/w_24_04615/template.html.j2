}

#hero-content {
    max-width: 800px;
    margin: 0 auto;
}

aside {
    background-color: blue;
    width: 20%;
    height: 100vh;
    position: fixed;
    top: 0;
    right: 0;
}

aside p, aside ul, footer p, footer ul {
    color: white;
}

footer {
