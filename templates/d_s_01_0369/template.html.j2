<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 11.3mm; inline-size: 22.3mm; block-size: 6.1mm; font-size: 17.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 20.6mm; inline-size: 161.3mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 29.0mm; inline-size: 171.4mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 37.5mm; inline-size: 61.0mm; block-size: 30.2mm; font-size: 12.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 127.0mm; inset-block-start: 37.5mm; inline-size: 73.1mm; block-size: 30.2mm; font-size: 12.2pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 71.3mm; inline-size: 34.3mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 79.8mm; inline-size: 139.4mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 11.9mm; inset-block-start: 87.4mm; inline-size: 185.8mm; block-size: 179.6mm; font-size: 40.0pt"></div>
<header class="box" style="inset-inline-start: 207.8mm; inset-block-start: 94.2mm; inline-size: 3.9mm; block-size: 91.1mm; font-size: 40.0pt">{{ slot_7 }}</header><footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 268.0mm; inline-size: 4.1mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
