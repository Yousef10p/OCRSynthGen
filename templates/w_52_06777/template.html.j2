    display: flex;
    list-style: none;
}

header li {
    margin: 0 1em;
}

.hero-image {
    position: relative;
    text-align: center;
    color: white;
}

.fake-image {
    background-color: blue;
    width: 100%;
    height: 500px;
}

.hero-text {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
}

.cta {
    background-color: #f8f8f8;
    color: blue;
    border: none;
    padding: 1em;
    margin: 1em 0;
}

main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    padding: 2em;
}

main section {
    width: 30%;
    min-height: 400px;
    margin-bottom: 2em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
