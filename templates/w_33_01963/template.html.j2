.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}


header {
  position: fixed;
  top: 0;
  width: 100%;
  background: #333;
  color: #fff;
  padding: 10px 0;
}

header ul {
  display: flex;
  justify-content: space-around;
  list-style: none;
}

header a {
  color: #fff;
  text-decoration: none;
}


.banner {
  height: 100vh;
  background: #f4f4f4;
  text-align: center;
  padding-top: 200px;
}

.banner h1 {
  font-size: 50px;
}

.banner p {
  font-size: 30px;
}

.banner button {
  background: #333;
  color: #fff;
  padding: 10px 20px;
  border: none;
}


main {
  margin-top: 50px;
  padding: 20px;
  display: flex;
  justify-content: space-around;
}

main section {
  width: 45%;
}


footer {
  background: #333;
  color: #fff;
  padding: 10px 0;
}

footer a,
footer .social a {
  color: #fff;
  text-decoration: none;
  margin: 0 10px;
}

footer .social {
  display: flex;
  justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
