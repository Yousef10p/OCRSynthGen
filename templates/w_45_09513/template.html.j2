    margin-bottom: 5px;
}

aside li a {
    text-decoration: none;
    color: #fff;
}

section {
    margin: 0 20px;
    position: relative;
    right: 300px;
}

article {
    float: right;
    width: 75%;
}

article h2 {
    color: #333;
