}

main .destination, main .tour {
  float: right;
  width: 50%;
  height: 300px;
}

main .destination__bg, main .tour__bg {
  width: 100%;
  height: 200px;
  background: none;
}

footer {
  background: #333;
  color: #fff;
  padding: 10px 0;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
