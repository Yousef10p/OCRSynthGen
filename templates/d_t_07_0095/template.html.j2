<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 9.0mm; inset-block-start: 34.9mm; inline-size: 96.5mm; block-size: 13.7mm; font-size: 9.7pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 21.6mm; inset-block-start: 98.9mm; inline-size: 157.4mm; block-size: 28.1mm; font-size: 39.8pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 21.6mm; inset-block-start: 136.7mm; inline-size: 58.7mm; block-size: 10.0mm; font-size: 14.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 107.1mm; inset-block-start: 136.8mm; inline-size: 79.2mm; block-size: 48.0mm; font-size: 15.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 21.6mm; inset-block-start: 150.5mm; inline-size: 77.7mm; block-size: 31.5mm; font-size: 14.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.6mm; inset-block-start: 188.9mm; inline-size: 79.3mm; block-size: 64.4mm; font-size: 15.2pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 107.1mm; inset-block-start: 196.8mm; inline-size: 47.4mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 107.1mm; inset-block-start: 205.1mm; inline-size: 75.9mm; block-size: 53.5mm; font-size: 15.2pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 12.4mm; inset-block-start: 277.7mm; inline-size: 48.3mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
