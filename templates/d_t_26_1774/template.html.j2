<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 143.5mm; inset-block-start: 12.3mm; inline-size: 58.0mm; block-size: 16.2mm; font-size: 15.3pt"></div>
<h1 class="box" style="inset-inline-start: 15.8mm; inset-block-start: 38.9mm; inline-size: 180.9mm; block-size: 30.3mm; font-size: 40.0pt">{{ slot_0 }}</h1>
<div class="box ph" style="inset-inline-start: 60.0mm; inset-block-start: 104.9mm; inline-size: 153.0mm; block-size: 125.6mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 106.5mm; inline-size: 30.5mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 115.0mm; inline-size: 15.9mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 123.4mm; inline-size: 20.4mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 131.9mm; inline-size: 15.2mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 140.4mm; inline-size: 26.0mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 148.8mm; inline-size: 17.6mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 15.8mm; inset-block-start: 157.3mm; inline-size: 20.8mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 15.6mm; inset-block-start: 228.0mm; inline-size: 30.4mm; block-size: 10.5mm; font-size: 14.9pt"></div>
<div class="box ph" style="inset-inline-start: 16.2mm; inset-block-start: 258.2mm; inline-size: 30.0mm; block-size: 12.5mm; font-size: 17.8pt"></div>
<div class="box ph" style="inset-inline-start: 162.4mm; inset-block-start: 261.1mm; inline-size: 40.1mm; block-size: 9.5mm; font-size: 26.8pt"></div>
</div></body>
</html>
