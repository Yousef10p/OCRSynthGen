<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</div>
<div id="content">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
</div>
<div id="footer">
<p><a>{{ slot_14 }}</a> {{ slot_15 }} <a>{{ slot_16 }}</a> {{ slot_17 }} <a>{{ slot_18 }}</a></p>
</div>
</body>
</html>