<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 22.3mm; inset-block-start: 17.4mm; inline-size: 24.0mm; block-size: 3.2mm; font-size: 9.2pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 22.3mm; inset-block-start: 39.3mm; inline-size: 70.7mm; block-size: 10.5mm; font-size: 7.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 48.9mm; inline-size: 177.8mm; block-size: 9.1mm; font-size: 8.6pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 22.3mm; inset-block-start: 63.2mm; inline-size: 73.1mm; block-size: 57.4mm; font-size: 27.1pt"></div>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 130.2mm; inline-size: 162.5mm; block-size: 33.2mm; font-size: 15.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 169.8mm; inline-size: 156.7mm; block-size: 10.5mm; font-size: 14.9pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 22.4mm; inset-block-start: 186.8mm; inline-size: 13.5mm; block-size: 4.9mm; font-size: 13.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 192.4mm; inline-size: 163.5mm; block-size: 27.5mm; font-size: 15.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 226.4mm; inline-size: 163.1mm; block-size: 16.2mm; font-size: 15.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 249.0mm; inline-size: 165.4mm; block-size: 10.5mm; font-size: 14.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 57.4mm; inset-block-start: 278.3mm; inline-size: 2.2mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
