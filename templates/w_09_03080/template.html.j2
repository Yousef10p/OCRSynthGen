<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</li>
<li><a>{{ slot_4 }}</a>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</li>
</ul>
</nav>
</header>
<section>
<h1>{{ slot_8 }}</h1>
<article>
<p>{{ slot_9 }}</p>
<footer>{{ slot_10 }}</footer>
</article>
<article>
<p>{{ slot_11 }}</p>
<footer>{{ slot_12 }}</footer>
</article>
</section>
<footer>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
