<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header, footer {
    background-color: #f4f4f4;
    text-align: center;
    padding: 15px;
}

h1 {
    color: #333;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    grid-gap: 15px;
    grid-auto-rows: minmax(100px, auto);
    margin: 15px;
}

.item {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ddd;
}

.item div {
    width: 300px;
    height: 200px;
    background-color: #ddd;
    color: #fff;
    text-align: center;
    line-height: 200px;
}

footer p {
    margin: 5px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</header>
<main class="grid">
<div class="item">
<div>{{ slot_2 }}</div>
<button>{{ slot_3 }}</button>
</div>
<div class="item">
<div>{{ slot_4 }}</div>
<button>{{ slot_5 }}</button>
</div>
<div class="item">
<div>{{ slot_6 }}</div>
<button>{{ slot_7 }}</button>
</div>
<div class="item">
<div>{{ slot_8 }}</div>
<button>{{ slot_9 }}</button>
</div>
</main>
<footer>
<p>{{ slot_10 }} <a>{{ slot_11 }}</a> {{ slot_12 }} <a>{{ slot_13 }}</a></p>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>