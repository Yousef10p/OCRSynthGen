<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background: #f5f5f5;
}

.header {
  background: #f7e1d4;
  color: #000;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
}

.logo {
  font-size: 24px;
  font-weight: bold;
}

.navigation ul {
  list-style: none;
}

.navigation ul li {
  display: inline;
  margin-right: 15px;
}

.columns {
  display: flex;
  margin: 20px;
  justify-content: space-between;
}

.column-left {
  width: 50%;
  padding: 20px;
}

.column-right {
  width: 50%;
  padding: 20px;
}

.footer {
  background: #f7e1d4;
  color: #000;
  text-align: center;
  padding: 20px;
  position: fixed;
  width: 100%;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">{{ slot_0 }}</div>
<div class="navigation">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
</div>
<div class="columns">
<div class="column-left">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>

<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>

<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
<div class="column-right">
<h2>{{ slot_11 }}</h2>

<h2>{{ slot_12 }}</h2>

<h2>{{ slot_13 }}</h2>
</div>
</div>
<div class="footer">
<p>{{ slot_14 }}</p>
</div>
</body>
</html>