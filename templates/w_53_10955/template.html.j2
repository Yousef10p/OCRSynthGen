</section>
<section class="summer-section" id="summer">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<a class="cta-button">{{ slot_10 }}</a>
</section>
<section class="winter-section" id="winter">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<a class="cta-button">{{ slot_13 }}</a>
</section>
<section class="spring-section" id="spring">
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
