    padding: 1em;
    background: #f8f8f8;
    border-bottom: 1px solid #ddd;
}
.logo {
    flex: 1;
    font-size: 2em;
}
a {
    margin-right: 1em;
    text-decoration: none;
    color: #000;
}
h2 {
    margin-bottom: 0.5em;
}
p {
