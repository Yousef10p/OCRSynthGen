    border: 1px solid #ddd;
    border-radius: 0.5em;
}
.rectangle {
    height: 100px;
    width: 100px;
    background: #f00;  
}
footer {
    background: #f8f8f8;
    padding: 2em;
    text-align: center;
    border-top: 1px solid #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
