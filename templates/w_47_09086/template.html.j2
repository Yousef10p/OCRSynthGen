<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    background: #333;
    color: #fff;
    padding: 10px;
}

h1, h2 {
    margin: 0;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav li {
    display: inline;
    margin-left: 10px;
}

.slider div {
    width: 100%;
    height: 200px;
    background: #777;
    text-align: center;
    line-height: 200px;
}

.benefit {
    float: right;
    width: 33.33%;
    padding: 15px;
    box-sizing: border-box;
}

footer {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
    clear: both;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<div class="slider">
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
<div class="slide">{{ slot_7 }}</div>
</div>
<div class="benefits">
<div class="benefit"><h2>{{ slot_8 }}</h2>{{ slot_9 }}</div>
<div class="benefit"><h2>{{ slot_10 }}</h2>{{ slot_11 }}</div>
<div class="benefit"><h2>{{ slot_12 }}</h2>{{ slot_13 }}</div>
</div>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>