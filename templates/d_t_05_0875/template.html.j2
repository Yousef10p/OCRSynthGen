<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 138.7mm; inline-size: 165.9mm; block-size: 7.5mm; font-size: 9.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 151.7mm; inline-size: 88.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 160.4mm; inline-size: 165.9mm; block-size: 8.3mm; font-size: 10.0pt">{{ slot_4 }}</p>
