<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 17.5mm; inset-block-start: 0.0mm; inline-size: 57.4mm; block-size: 61.4mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 75.8mm; inset-block-start: 23.7mm; inline-size: 2.3mm; block-size: 37.8mm; font-size: 40.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 93.2mm; inset-block-start: 27.2mm; inline-size: 100.0mm; block-size: 19.7mm; font-size: 27.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 109.3mm; inset-block-start: 48.5mm; inline-size: 86.9mm; block-size: 37.8mm; font-size: 15.3pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 16.2mm; inset-block-start: 65.1mm; inline-size: 47.0mm; block-size: 16.7mm; font-size: 15.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 29.3mm; inset-block-start: 84.2mm; inline-size: 43.7mm; block-size: 83.7mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 87.2mm; inline-size: 86.9mm; block-size: 13.8mm; font-size: 13.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 102.1mm; inline-size: 84.2mm; block-size: 28.6mm; font-size: 13.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 131.7mm; inline-size: 88.3mm; block-size: 38.5mm; font-size: 13.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 29.3mm; inset-block-start: 168.8mm; inline-size: 43.8mm; block-size: 32.9mm; font-size: 11.7pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 171.2mm; inline-size: 88.5mm; block-size: 38.5mm; font-size: 13.7pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 16.5mm; inset-block-start: 223.9mm; inline-size: 72.0mm; block-size: 37.1mm; font-size: 40.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 141.1mm; inset-block-start: 227.0mm; inline-size: 32.7mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_11 }}</p>
<div class="box ph" style="inset-inline-start: 140.5mm; inset-block-start: 235.1mm; inline-size: 39.5mm; block-size: 34.1mm; font-size: 16.1pt"></div>
<footer class="box" style="inset-inline-start: 11.7mm; inset-block-start: 268.3mm; inline-size: 3.0mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_12 }}</footer>
</div></body>
</html>
