<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 14.5mm; inline-size: 88.9mm; block-size: 37.0mm; font-size: 15.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 107.4mm; inset-block-start: 14.7mm; inline-size: 90.7mm; block-size: 75.6mm; font-size: 19.5pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 12.7mm; inset-block-start: 57.6mm; inline-size: 88.9mm; block-size: 31.4mm; font-size: 14.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 12.7mm; inset-block-start: 95.0mm; inline-size: 88.9mm; block-size: 25.7mm; font-size: 14.6pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 110.1mm; inset-block-start: 101.3mm; inline-size: 88.8mm; block-size: 25.7mm; font-size: 14.6pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 110.1mm; inset-block-start: 133.1mm; inline-size: 88.9mm; block-size: 31.4mm; font-size: 14.8pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 149.8mm; inline-size: 102.2mm; block-size: 16.5mm; font-size: 15.6pt"></div>
<p class="box" style="inset-inline-start: 10.1mm; inset-block-start: 170.3mm; inline-size: 90.7mm; block-size: 89.7mm; font-size: 19.6pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 110.1mm; inset-block-start: 170.5mm; inline-size: 88.9mm; block-size: 31.4mm; font-size: 14.8pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 110.1mm; inset-block-start: 207.9mm; inline-size: 88.9mm; block-size: 31.4mm; font-size: 14.8pt"><li>{{ slot_8 }}</li></ul>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 245.3mm; inline-size: 88.9mm; block-size: 14.4mm; font-size: 13.6pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 8.5mm; inset-block-start: 269.6mm; inline-size: 1.9mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
