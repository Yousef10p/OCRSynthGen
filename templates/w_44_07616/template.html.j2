.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}


nav {
    background-color: #333;
    color: #fff;
    position: fixed;
    width: 100%;
}


.content {
    padding: 50px 0 0 0;
