<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div id="maincontent">
<p>{{ slot_5 }}</p>
<h2>{{ slot_6 }}</h2>
<div class="item">{{ slot_7 }}</div>
<div class="item">{{ slot_8 }}</div>
<h2>{{ slot_9 }}</h2>
<div class="product">{{ slot_10 }}</div>
<div class="product">{{ slot_11 }}</div>
<h2>{{ slot_12 }}</h2>
<div class="ingredient">{{ slot_13 }}</div>
<div class="ingredient">{{ slot_14 }}</div>
<h2>{{ slot_15 }}</h2>
<div class="recipe">{{ slot_16 }}</div>
<div class="recipe">{{ slot_17 }}</div>
<h2>{{ slot_18 }}</h2>
<div class="inspiration">{{ slot_19 }}</div>
<div class="inspiration">{{ slot_20 }}</div>
</div>
</body>
</html>