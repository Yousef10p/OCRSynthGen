  padding: 20px 0;
}
.header img {
  height: 100px;
}
.header nav ul {
  list-style: none;
  padding: 0;
}
.header nav ul li {
  display: inline-block;
  margin: 0 10px;
}
.hero, .products, .recipes, .blog {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px 0;
}
.product-list, .recipe-list, .blog-posts {
  display: flex;
  justify-content: space-between;
}
.product, .recipe, .blog-post {
  background-color: #ddd;
  width: calc(50% - 40px);
  padding: 20px;
  box-sizing: border-box;
}
.img-placeholder {
  height: 150px;
  background-color: #ccc;
  margin-bottom: 20px;
}
.footer {
  text-align: center;
  padding: 5px 0;
  background-color: #333;
  color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
