<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
font-family: var(--font-body);
margin: 0;
padding: 0;
background: none no-repeat center center fixed; 
-webkit-background-size: cover;
-moz-background-size: cover;
-o-background-size: cover;
background-size: cover;
}


.navigation {
    position: relative;
}

.navigation ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}

.navigation li {
    float: right;
}

.navigation li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

.navigation li a:hover {
    background-color: #111;
}


.mainContent {
    margin: 50px;
    color: white;
    text-shadow: -2px 2px 8px rgba(0, 0, 0, 0.5);
}

.btn {
    background-color: #4CAF50; 
    border: none; 
    color: white; 
    padding: 15px 32px; 
    text-align: center; 
    text-decoration: none; 
    display: inline-block; 
    font-size: 16px; 
    margin: 4px 2px; 
    transition-duration: 0.4s;
    cursor: pointer;
}


.userContent {
    margin: 50px;
    color: #333;
    background-color: #f1f1f1;
}


.socialContent {
    margin: 50px;
    color: #333;
    background-color: #f1f1f1;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navigation">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="mainContent">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<a class="btn">{{ slot_6 }}</a>
</div>
<div class="userContent">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
</div>
<div class="socialContent">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<a class="socialBtn">{{ slot_12 }}</a>
<a class="socialBtn">{{ slot_13 }}</a>
<a class="socialBtn">{{ slot_14 }}</a>
</div>
</body>
</html>