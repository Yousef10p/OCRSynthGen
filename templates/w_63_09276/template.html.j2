<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    background-color: #f5f5f5;
    color: #1a1a1a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#logo {
    width: 80px;
    height: 80px;
    background-color: #ff6347;
    border-radius: 50%;
    position: fixed;
    top: 5px;
    right: 5px;
}

header {
    width: 100%;
    height: 80px;
    background-color: #1874cd;
    display: flex;
    justify-content: center;
    align-items: center;
    position: fixed;
    top: 0;
    right: 0;
}

nav {
    width: 60%;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

nav ul li a {
    text-decoration: none;
    color: #f5f5f5;
}

main {
    padding-top: 100px;
    display: flex;
    flex-direction: column;
}

main section {
    height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin: 20px 0;
}

main section:nth-child(odd) {
    background-color: #ffa500;
}

main section:nth-child(even) {
    background-color: #ff6347;
}

main section h1 {
    color: #f5f5f5;
    margin-bottom: 20px;
}

footer {
    width: 100%;
    height: 50px;
    background-color: #1874cd;
    display: flex;
    justify-content: center;
    align-items: center;
    position: fixed;
    bottom: 0;
    right: 0;
    color: #f5f5f5;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
