<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 87.8mm; inline-size: 84.9mm; block-size: 52.2mm; font-size: 9.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 113.1mm; inset-block-start: 87.5mm; inline-size: 85.2mm; block-size: 17.2mm; font-size: 9.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 112.9mm; inset-block-start: 105.1mm; inline-size: 87.3mm; block-size: 27.5mm; font-size: 11.1pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 22.8mm; inset-block-start: 144.6mm; inline-size: 61.3mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_7 }}</h2>
