<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 26.4mm; inline-size: 41.6mm; block-size: 13.4mm; font-size: 12.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 140.3mm; inset-block-start: 26.9mm; inline-size: 48.9mm; block-size: 13.1mm; font-size: 12.3pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 66.3mm; inline-size: 124.9mm; block-size: 179.2mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 141.1mm; inset-block-start: 113.1mm; inline-size: 33.5mm; block-size: 13.4mm; font-size: 12.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 138.8mm; inset-block-start: 141.8mm; inline-size: 38.6mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 138.8mm; inset-block-start: 151.8mm; inline-size: 51.9mm; block-size: 88.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 137.8mm; inset-block-start: 244.5mm; inline-size: 52.3mm; block-size: 5.3mm; font-size: 7.5pt">{{ slot_5 }}</p>
</div></body>
</html>
