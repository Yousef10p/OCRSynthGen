}

.menu-item {
  position: relative;
  padding: 15px;
}

.submenu {
  display: none;
  position: absolute;
  background-color :#f8f8f8;
  padding: 15px;
}

.menu-item:hover .submenu {
  display: block;
}

.abstract-background {
  position: relative;
  top: 50px;
  background-color: #333;
  color: #fff;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.sub-heading {
  font-size: 24px;
}

.main-heading {
  font-size: 36px;
}

.description {
  font-size: 18px;
