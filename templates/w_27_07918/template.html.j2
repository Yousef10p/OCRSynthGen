<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    background: linear-gradient(to bottom, #ffffff, #d5d5d5);
    width: 80%;
    margin: auto;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1em;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin: 0 1em;
}

nav ul li a {
    text-decoration: none;
    color: #000000;
    transition: all 0.3s ease 0s;
}

nav ul li a:hover {
    color: #0088a9;
}

.slider img {
    width: 100%;
    height: auto;
}

.slider p {
    text-align: center;
    font-size: 1.5em;
    font-weight: bold;
}

section article {
    width: 30%;
    margin: 1em;
}

section article img {
    width: 100%;
    height: auto;
}

footer {
    text-align: center;
    padding: 1em;
}

footer form {
    display: flex;
    flex-direction: column;
    align-items: center;
}

footer form label {
    align-self: start;
}

footer form input, footer form textarea {
    width: 100%;
    margin: 1em 0;
}

footer form input[type="submit"] {
    background: #0088a9;
    color: #ffffff;
    padding: 0.5em 1em;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease 0s;
}

footer form input[type="submit"]:hover {
    background: #ffffff;
    color: #0088a9;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
