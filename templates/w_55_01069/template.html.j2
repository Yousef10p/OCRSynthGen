<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body { background-color: #f5e1da; font-family: var(--font-body); margin: 0; padding: 0; }
h1, h2, h3, p { color: #8c1c46; }
ul { list-style: none; padding: 0; }


.hero { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; padding: 20px; }
.logo { display: flex; flex-direction: column; align-items: center; }
.rectangle { width: 200px; height: 200px; background-color: #8c1c46; margin-bottom: 20px; }
.nav { display: flex; gap: 20px; }
.nav li { position: relative; }
.nav li:hover .dropdown { display: block; }
.dropdown { position: absolute; display: none; padding: 10px; background-color: #e7c3c9; }


.left-column, .right-column { flex: 1; padding: 20px; }
.left-column .rectangle, .right-column .rectangle { height: 100px; margin: 20px 0; }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<div class="logo">
<div class="rectangle"></div>
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</div>
<ul class="nav">
<li>{{ slot_2 }} <ul class="dropdown"><li>{{ slot_3 }}</li><li>{{ slot_4 }}</li></ul></li>
<li>{{ slot_5 }} <ul class="dropdown"><li>{{ slot_6 }}</li><li>{{ slot_7 }}</li></ul></li>
</ul>
<div class="left-column">
<h2>{{ slot_8 }}</h2>
<div class="rectangle"></div>
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<div class="rectangle"></div>
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
</div>
<div class="right-column">
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
<h2>{{ slot_17 }}</h2>
<p>{{ slot_18 }}</p>
<p>{{ slot_19 }}</p>
</div>
</div>
</body>
</html>