<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 75.5mm; inset-block-start: 10.3mm; inline-size: 102.7mm; block-size: 21.9mm; font-size: 31.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 75.5mm; inset-block-start: 36.6mm; inline-size: 120.0mm; block-size: 27.1mm; font-size: 15.4pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 75.5mm; inset-block-start: 69.6mm; inline-size: 52.2mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 75.5mm; inset-block-start: 75.6mm; inline-size: 117.8mm; block-size: 38.4mm; font-size: 15.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 75.5mm; inset-block-start: 118.7mm; inline-size: 119.0mm; block-size: 21.5mm; font-size: 15.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 124.0mm; inline-size: 60.2mm; block-size: 34.4mm; font-size: 19.5pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 75.5mm; inset-block-start: 144.6mm; inline-size: 43.3mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 75.5mm; inset-block-start: 150.6mm; inline-size: 118.7mm; block-size: 27.1mm; font-size: 15.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 75.5mm; inset-block-start: 182.3mm; inline-size: 120.9mm; block-size: 32.7mm; font-size: 15.5pt">{{ slot_8 }}</p>
</div></body>
</html>
