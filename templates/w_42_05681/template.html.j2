<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

/ .container {
    display: flex;
    justify-content: space-between;
}

.left-column, .right-column {
    width: 45%;
    margin: 10px;
    padding: 20px;
    background-color: #f2f2f2;
    box-sizing: border-box;
}

.left-column h1, .left-column h2, 
.right-column h2, .right-column h3 {
    background-color: #ccc;
    height: 40px;
    margin-bottom: 20px;
}

.left-column p, .right-column p {
    background-color: #ddd;
    height: 100px;
    margin-bottom: 20px;
}

.left-column ul, .right-column article {
    color: #000;
    margin-bottom: 20px;
}

.left-column li, .right-column h3 {
    background-color: #ddd;
    height: 30px;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="left-column">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<h2>{{ slot_2 }}</h2>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
<h2>{{ slot_6 }}</h2>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
</div>
<div class="right-column">
<h2>{{ slot_10 }}</h2>
<article>
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
</article>
<article>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</article>
</div>
</div>
</body>
</html>