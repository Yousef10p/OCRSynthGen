<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 34.4mm; inline-size: 89.8mm; block-size: 54.4mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 69.3mm; inline-size: 89.3mm; block-size: 67.9mm; font-size: 12.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 93.1mm; inline-size: 89.6mm; block-size: 13.8mm; font-size: 13.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 110.9mm; inline-size: 22.3mm; block-size: 5.0mm; font-size: 7.1pt">{{ slot_7 }}</h2>
