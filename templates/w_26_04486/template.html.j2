}

input[type="text"], input[type="date"], input[type="time"] {
    margin-bottom: 1rem;
    padding: 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid #000;
}

button {
    padding: 0.5rem 1rem;
    background-color: #000;
    color: #fff;
    border-radius: 0.5rem;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
