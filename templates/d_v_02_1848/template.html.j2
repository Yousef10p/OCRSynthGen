<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 105.4mm; inset-block-start: 14.1mm; inline-size: 5.2mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 26.8mm; inline-size: 164.3mm; block-size: 36.3mm; font-size: 17.2pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 94.5mm; inset-block-start: 70.9mm; inline-size: 27.1mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 83.3mm; inline-size: 164.3mm; block-size: 23.6mm; font-size: 16.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 93.7mm; inset-block-start: 107.2mm; inline-size: 28.7mm; block-size: 4.9mm; font-size: 13.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 120.8mm; inline-size: 164.2mm; block-size: 42.5mm; font-size: 17.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 170.1mm; inline-size: 164.3mm; block-size: 17.4mm; font-size: 16.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 194.2mm; inline-size: 164.4mm; block-size: 48.2mm; font-size: 17.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 266.2mm; inline-size: 164.4mm; block-size: 18.6mm; font-size: 10.6pt">{{ slot_8 }}</p>
</div></body>
</html>
