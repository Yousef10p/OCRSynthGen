<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 5.1mm; inset-block-start: 5.1mm; inline-size: 78.2mm; block-size: 3.8mm; font-size: 16.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 12.4mm; inline-size: 72.8mm; block-size: 3.8mm; font-size: 16.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 17.0mm; inline-size: 92.0mm; block-size: 19.3mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 108.8mm; inset-block-start: 17.0mm; inline-size: 95.0mm; block-size: 33.6mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 38.2mm; inline-size: 94.2mm; block-size: 42.1mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 108.8mm; inset-block-start: 51.6mm; inline-size: 94.8mm; block-size: 21.4mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 108.8mm; inset-block-start: 74.0mm; inline-size: 94.6mm; block-size: 24.4mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 82.1mm; inline-size: 94.9mm; block-size: 45.4mm; font-size: 13.0pt">{{ slot_7 }}</p>
