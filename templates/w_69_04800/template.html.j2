<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  padding: 0;
  margin: 0;
  font-family: var(--font-body);
}

#nav-menu {
  background-color: #f0f0f0;
  width: 150px;
  height: 100vh;
  position: fixed;
  padding: 20px 20px 0 0;
}

#nav-menu ul {
  list-style-type: none;
  padding: 0;
}

#nav-menu li {
  padding: 10px 0;
}

#nav-menu a {
  text-decoration: none;
  color: #333;
}

#nav-menu ul li:hover {
  background-color: #ddd;
}

.contact-button {
  display: block;
  background-color: black;
  color: white;
  text-align: center;
  padding: 10px;
  position: absolute;
  top: 20px;
  left: 20px;
  width: 70px;
  height: 70px;
}

.content {
  margin-right: 150px;
  padding: 20px;
}

.content div {
  width: 200px;
  height: 200px;
  background-color: #ddd; 
  display: inline-block; 
  margin: 10px; 
}

h1, h2 {
  color: #333;
}

p {
  color: #666;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div>
<nav id="nav-menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<a class="contact-button">{{ slot_6 }}</a>
<div class="content">
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<ul>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
</ul>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
<p>{{ slot_17 }}</p>
</div>
</div>
</body>
</html>