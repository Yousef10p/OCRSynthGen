<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 70.4mm; inline-size: 41.7mm; block-size: 5.0mm; font-size: 14.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 76.0mm; inline-size: 81.6mm; block-size: 26.2mm; font-size: 12.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 76.0mm; inline-size: 79.2mm; block-size: 21.7mm; font-size: 12.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 98.6mm; inline-size: 81.8mm; block-size: 39.8mm; font-size: 12.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 103.1mm; inline-size: 80.5mm; block-size: 39.8mm; font-size: 12.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 158.8mm; inline-size: 51.3mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_5 }}</h2>
<header class="box" style="inset-inline-start: 202.1mm; inset-block-start: 161.2mm; inline-size: 3.6mm; block-size: 27.3mm; font-size: 40.0pt">{{ slot_6 }}</header><div class="box ph" style="inset-inline-start: 19.6mm; inset-block-start: 166.5mm; inline-size: 170.4mm; block-size: 105.7mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 142.3mm; inset-block-start: 284.6mm; inline-size: 59.7mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
