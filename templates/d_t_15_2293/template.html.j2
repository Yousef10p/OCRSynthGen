<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 154.9mm; inline-size: 49.4mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 161.8mm; inline-size: 86.7mm; block-size: 35.9mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 182.9mm; inline-size: 81.6mm; block-size: 8.9mm; font-size: 12.5pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 193.5mm; inline-size: 83.7mm; block-size: 22.4mm; font-size: 12.7pt"><li>{{ slot_6 }}</li></ul>
