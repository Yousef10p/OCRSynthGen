<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 217.7mm; inline-size: 83.9mm; block-size: 31.4mm; font-size: 12.7pt"><li>{{ slot_9 }}</li></ul>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 240.1mm; inline-size: 86.7mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_10 }}</p>
