<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 13.4mm; inline-size: 83.3mm; block-size: 29.4mm; font-size: 11.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 13.4mm; inline-size: 83.2mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 113.8mm; inset-block-start: 26.0mm; inline-size: 84.1mm; block-size: 59.9mm; font-size: 24.2pt"></div>
<div class="box ph" style="inset-inline-start: 23.4mm; inset-block-start: 49.8mm; inline-size: 84.2mm; block-size: 56.3mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 87.5mm; inline-size: 78.8mm; block-size: 9.6mm; font-size: 9.1pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 114.3mm; inset-block-start: 106.5mm; inline-size: 31.1mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 108.4mm; inline-size: 83.3mm; block-size: 17.1mm; font-size: 9.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 110.8mm; inline-size: 83.3mm; block-size: 59.7mm; font-size: 12.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 136.8mm; inline-size: 83.3mm; block-size: 33.7mm; font-size: 12.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 23.5mm; inset-block-start: 175.8mm; inline-size: 174.5mm; block-size: 81.6mm; font-size: 38.6pt"></div>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 259.7mm; inline-size: 173.7mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 191.0mm; inset-block-start: 269.1mm; inline-size: 6.3mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
