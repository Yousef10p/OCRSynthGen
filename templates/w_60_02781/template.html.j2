<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}
header, footer {
    background: #f5f5f5;
    color: white;
    padding: 20px;
}
#logo {
    width: 100px;
    height: 50px;
    background: #333;
}
main {
    padding: 20px;
}
.jumbo {
    width: 100%;
    height: 500px;
    background: #eee;
}
.divider {
    width: 100%;
    height: 10px;
    background: #ddd;
    margin: 20px 0;
}
footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    background: #333;
    color: white;
    padding: 20px;
}
footer a, footer p {
    color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div id="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<main>
<div class="jumbo">{{ slot_4 }}</div>
<p>{{ slot_5 }}</p>
<div class="divider"></div>
<p>{{ slot_6 }}</p>
<div class="jumbo">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
<div class="divider"></div>
<p>{{ slot_9 }}</p>
</main>
<footer>
<nav>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>
</nav>
<p>{{ slot_13 }}</p>
<div>{{ slot_14 }}</div>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>