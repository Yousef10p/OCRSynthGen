    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 10px;
    background-color: #f8f8f8;
}

.logo h1 {
    margin: 0;
}

.search input {
    padding: 10px;
    border: none;
    border-radius: 5px;
}

