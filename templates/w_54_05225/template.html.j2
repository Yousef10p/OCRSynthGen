    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    padding: 10px;
    background-color: #f8f8f8;
}

.logo {
    background-color: #ff6600;
    padding: 10px;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin-left: 10px;
}

.carousel-item {
    background-color: #f0f0f0;
    height: 200px;
    margin: 20px 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

footer {
    display: flex;
    padding: 20px;
    background-color: #333;
    color: #fff;
}

.footer-section {
    margin-left: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
