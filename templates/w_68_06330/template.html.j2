<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: fixed;
  top: 0;
  width: 100%;
  padding: 20px;
  background-color: #f8f8f8;
}

.logo {
  height: 50px;
}

nav ul {
  display: flex;
  list-style-type: none;
}

nav li {
  position: relative;
}

nav ul ul {
  position: absolute;
  right: 0;
}

nav a {
  display: block;
  padding: 0 10px;
  color: #000;
  text-decoration: none;
}

.hero {
  position: relative;
  height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: none;
  background-size: cover;
  color: #fff;
  text-align: center;
}

form label {
  display: block;
  margin-bottom: 10px;
}

form input[type='text'],
form textarea {
  width: 100%;
  margin-bottom: 20px;
}



@media only screen and (max-width: 600px) {
  header {
    flex-direction: column;
  }
  
  nav ul {
    flex-direction: column;
    display: none;
  }
  
  nav:hover ul {
    display: block;
  }
  
  .hero {
    height: 200px;
  }
  
  form label,
  form input[type='text'],
  form textarea,
  form input[type='submit'] {
    width: 100%;
    box-sizing: border-box;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
