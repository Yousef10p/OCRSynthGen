    height: 200px;
    background-color: grey;
}
aside {
    float: right;
    width: 20%;
}
footer {
    clear: both;
    text-align: center;
}

.slider-image:before {
    content: "";
    display: block;
    width: 200px;
    height: 200px;
    background-color: grey;
}
form {
    display: grid;
    gap: 10px;
}
a {
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
