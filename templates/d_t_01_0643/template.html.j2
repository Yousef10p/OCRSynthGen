<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 355.6mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 30.3mm; inset-block-start: 72.4mm; inline-size: 115.5mm; block-size: 60.8mm; font-size: 28.7pt"></div>
<div class="box ph" style="inset-inline-start: 152.4mm; inset-block-start: 78.2mm; inline-size: 26.1mm; block-size: 36.0mm; font-size: 34.0pt"></div>
<p class="box" style="inset-inline-start: 153.8mm; inset-block-start: 115.9mm; inline-size: 23.3mm; block-size: 8.9mm; font-size: 8.4pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 69.4mm; inset-block-start: 143.8mm; inline-size: 116.2mm; block-size: 61.0mm; font-size: 12.4pt"></div>
<div class="box ph" style="inset-inline-start: 37.5mm; inset-block-start: 149.1mm; inline-size: 26.3mm; block-size: 37.3mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 188.3mm; inline-size: 24.5mm; block-size: 8.9mm; font-size: 8.4pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 30.3mm; inset-block-start: 215.0mm; inline-size: 115.1mm; block-size: 60.8mm; font-size: 19.2pt"></div>
<div class="box ph" style="inset-inline-start: 152.6mm; inset-block-start: 223.3mm; inline-size: 26.3mm; block-size: 36.7mm; font-size: 34.6pt"></div>
<p class="box" style="inset-inline-start: 149.7mm; inset-block-start: 261.9mm; inline-size: 32.4mm; block-size: 5.6mm; font-size: 8.0pt">{{ slot_2 }}</p>
</div></body>
</html>
