<h2 class="box" style="inset-inline-start: 24.5mm; inset-block-start: 50.6mm; inline-size: 60.7mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 70.2mm; inset-block-start: 55.7mm; inline-size: 130.6mm; block-size: 12.8mm; font-size: 12.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 70.2mm; inset-block-start: 69.7mm; inline-size: 131.2mm; block-size: 26.8mm; font-size: 12.7pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 24.5mm; inset-block-start: 102.0mm; inline-size: 69.9mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 70.2mm; inset-block-start: 107.1mm; inline-size: 131.9mm; block-size: 36.2mm; font-size: 12.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 70.2mm; inset-block-start: 144.5mm; inline-size: 131.8mm; block-size: 12.8mm; font-size: 12.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 162.8mm; inline-size: 29.7mm; block-size: 3.2mm; font-size: 9.2pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 24.1mm; inset-block-start: 166.8mm; inline-size: 178.0mm; block-size: 85.0mm; font-size: 12.7pt"></div>
