}

nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

section {
    height: 500px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    text-align: center;
    color: #fff;
}

section h1, section h2 {
    margin-bottom: 20px;
}

.large-img {
    background: #aaa;
}

.left-img {
    background: #666;
}

.right-img {
    background: #333;
}

footer {
    background-color: #f4f4f4;
    padding: 20px;
    text-align: center;
    position: absolute;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
