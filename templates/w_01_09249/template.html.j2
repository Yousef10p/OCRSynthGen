<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


header {
    position: relative;
}

#logo {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    text-align: center;
    background-color: #fff7ed;
    padding: 20px;
    font-size: 30px;
}


nav ul {
    position: sticky;
    top: 0;
    padding: 0;
    margin: 0;
    list-style-type: none;
}

nav ul li a {
    display: inline-block;
    padding: 10px;
    color: #fff;
    text-decoration: none;
}

nav ul li a:hover {
    color: #000;
}


section {
    margin: 20px;
}

#food, #beverage {
    background-color: #fef3c7;
    padding: 20px;
}

#blog .post {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
    padding: 20px;
}

#blog .post .image {
    width: 100%;
    height: 100px;
    background-color: #cbd5e1;
}

h1, h2, p {
    margin: 0;
    padding: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div id="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<section id="food">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</section>
<section id="beverage">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
</section>
<section id="blog">
<h1>{{ slot_8 }}</h1>
<div class="post">
<div class="image">{{ slot_9 }}</div>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
<div class="post">
<div class="image">{{ slot_12 }}</div>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</section>
</body>
</html>