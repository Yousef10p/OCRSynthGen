<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 90.9mm; inline-size: 86.5mm; block-size: 36.8mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 137.0mm; inline-size: 86.5mm; block-size: 15.8mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 154.5mm; inline-size: 86.5mm; block-size: 62.2mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 172.0mm; inline-size: 86.5mm; block-size: 83.3mm; font-size: 10.0pt">{{ slot_6 }}</p>
