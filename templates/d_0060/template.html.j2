<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 157.1mm; inset-block-start: 9.9mm; inline-size: 43.1mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 42.1mm; inline-size: 81.5mm; block-size: 28.0mm; font-size: 11.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 109.5mm; inset-block-start: 42.1mm; inline-size: 80.5mm; block-size: 66.1mm; font-size: 11.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 75.9mm; inline-size: 81.1mm; block-size: 61.8mm; font-size: 11.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 109.5mm; inset-block-start: 113.9mm; inline-size: 48.4mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 109.4mm; inset-block-start: 118.1mm; inline-size: 81.2mm; block-size: 104.1mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 143.5mm; inline-size: 81.5mm; block-size: 87.2mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 253.5mm; inline-size: 101.7mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 137.0mm; inset-block-start: 270.8mm; inline-size: 37.9mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_8 }}</footer><div class="box ph" style="inset-inline-start: 177.4mm; inset-block-start: 269.9mm; inline-size: 13.4mm; block-size: 4.8mm; font-size: 13.6pt"></div>
</div></body>
</html>
