<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    padding: 0;
    margin: 0;
    background-color: #f4f4f4;
}

#menu {
    position: absolute;
    top: 10px;
    right: 10px;
}

.menu-item {
    margin-left: 10px;
    text-decoration: none;
    color: #000;
}

#content {
    margin: 50px;
    display: grid;
    grid-template-columns: auto auto;
    gap: 10px;
}

.course {
    border: 1px solid #000;
    padding: 10px;
}

#sign-up {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
}

.button {
    display: inline-block;
    padding: 10px 20px;
    background-color: #007BFF;
    color: #fff;
    text-decoration: none;
}

#pricing {
    position: absolute;
    top: 50px;
    left: 50px;
    background-color: #fff;
    border: 1px solid #000;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="menu">
<a class="menu-item">{{ slot_0 }}</a>
<a class="menu-item">{{ slot_1 }}</a>
<a class="menu-item">{{ slot_2 }}</a>
<a class="menu-item">{{ slot_3 }}</a>
</div>
<div id="content">
<div class="course">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
</div>
<div class="course">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div class="course">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="course">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
</div>
<div id="sign-up">
<a class="button">{{ slot_12 }}</a>
</div>
<div id="pricing">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>

</div>
</body>
</html>