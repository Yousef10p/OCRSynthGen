<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 82.4mm; inline-size: 83.5mm; block-size: 46.4mm; font-size: 13.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 25.9mm; inset-block-start: 111.9mm; inline-size: 83.1mm; block-size: 77.5mm; font-size: 14.7pt"></div>
<h2 class="box" style="inset-inline-start: 115.4mm; inset-block-start: 132.8mm; inline-size: 49.3mm; block-size: 6.2mm; font-size: 17.6pt">{{ slot_4 }}</h2>
