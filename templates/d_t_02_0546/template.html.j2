<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 14.6mm; inset-block-start: 20.0mm; inline-size: 27.4mm; block-size: 7.5mm; font-size: 21.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 14.6mm; inset-block-start: 37.5mm; inline-size: 71.7mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 108.6mm; inset-block-start: 37.5mm; inline-size: 84.7mm; block-size: 32.5mm; font-size: 13.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 14.6mm; inset-block-start: 42.4mm; inline-size: 85.3mm; block-size: 12.8mm; font-size: 12.1pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 14.6mm; inset-block-start: 61.2mm; inline-size: 46.7mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 14.6mm; inset-block-start: 68.9mm; inline-size: 85.2mm; block-size: 42.4mm; font-size: 13.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 108.6mm; inset-block-start: 72.1mm; inline-size: 82.9mm; block-size: 17.7mm; font-size: 12.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 108.6mm; inset-block-start: 97.8mm; inline-size: 83.3mm; block-size: 12.8mm; font-size: 12.1pt">{{ slot_7 }}</p>
