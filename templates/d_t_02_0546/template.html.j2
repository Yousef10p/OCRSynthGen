<div class="box ph" style="inset-inline-start: 14.6mm; inset-block-start: 134.9mm; inline-size: 83.9mm; block-size: 135.8mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 108.6mm; inset-block-start: 152.2mm; inline-size: 11.6mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 108.6mm; inset-block-start: 159.9mm; inline-size: 83.2mm; block-size: 27.6mm; font-size: 13.0pt">{{ slot_10 }}</p>
