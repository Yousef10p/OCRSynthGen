  align-items: center;
}

.product, .service {
  background-color: lightgrey;
  width: 200px;
  height: 150px;
  margin: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
