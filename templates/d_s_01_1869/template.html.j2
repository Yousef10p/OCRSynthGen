<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 40.2mm; inset-block-start: 31.1mm; inline-size: 139.7mm; block-size: 18.5mm; font-size: 11.7pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 30.2mm; inset-block-start: 60.3mm; inline-size: 149.6mm; block-size: 18.5mm; font-size: 12.0pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.2mm; inset-block-start: 89.5mm; inline-size: 149.4mm; block-size: 18.5mm; font-size: 12.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.5mm; inset-block-start: 118.7mm; inline-size: 149.7mm; block-size: 55.0mm; font-size: 12.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.5mm; inset-block-start: 184.3mm; inline-size: 149.1mm; block-size: 18.6mm; font-size: 12.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.5mm; inset-block-start: 213.5mm; inline-size: 149.4mm; block-size: 25.9mm; font-size: 12.0pt"><li>{{ slot_5 }}</li></ul>
</div></body>
</html>
