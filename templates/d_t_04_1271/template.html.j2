<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 133.5mm; inline-size: 83.7mm; block-size: 96.8mm; font-size: 10.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.8mm; inset-block-start: 233.7mm; inline-size: 83.4mm; block-size: 21.3mm; font-size: 10.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 233.6mm; inline-size: 82.5mm; block-size: 21.3mm; font-size: 10.1pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 163.9mm; inset-block-start: 264.0mm; inline-size: 23.1mm; block-size: 2.3mm; font-size: 6.4pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 198.0mm; inset-block-start: 264.0mm; inline-size: 2.4mm; block-size: 2.3mm; font-size: 6.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
