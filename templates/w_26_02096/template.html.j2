    background-color: #ccc;
    margin-bottom: 20px;
}

footer {
    width: 100%;
    background-color: #222;
    color: #fff;
    padding: 20px;
    text-align: center;
    position: fixed;
    bottom: 0;
}

button {
    background-color: #007BFF;
    border: none;
    color: white;
    padding: 15px 32px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 16px;
    margin: 4px 2px;
    cursor: pointer;
}

@media screen and (max-width: 600px) {
    nav ul {
        flex-direction: column;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
