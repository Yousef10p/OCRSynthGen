<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

header {
	position: fixed;
	top: 0;
	width: 100%;
	background: linear-gradient(to left, #f32170, #ff6b08, #cf23cf, #eedd44);
	color: white;
	font-family: var(--font-body);
	height: 100px;
	line-height: 100px;
	text-align: center;
	transition: .5s;
}

.animated {
	animation: move 10s infinite;
}

@keyframes move {
	0% {background-position: 100% 50%;}
	50% {background-position: 0% 50%;}
	100% {background-position: 100% 50%;}
}

nav ul {
	display: flex;
	justify-content: space-around;
}

nav ul li {
	list-style: none;
	padding: 30px;
	font-size: 20px;
}

.box {
	margin-top: 100px;
	display: flex;
	justify-content: space-around;
	flex-wrap: wrap;
}

.card {
	margin: 20px;
	padding: 20px;
	box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
	border-radius: 5px;
	width: 250px;
	text-align: center;
}

.card img {
	background-color: #ccc;
	width: 100%;
	height: 200px;
}

.card h1, .card p {
	padding: 10px;
}

.testimonials {
	margin-top: 20px;
	margin-bottom: 50px;
	display: flex;
	justify-content: space-around;
	flex-wrap: wrap;
}

.testimonial {
	margin: 20px;
	padding: 20px;
	box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
	border-radius: 5px;
	width: 250px;
	text-align: center;
}

.testimonial img {
	background-color: #ccc;
	width: 100%;
	height: 200px;
}

.testimonial h1, .testimonial p {
	padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
