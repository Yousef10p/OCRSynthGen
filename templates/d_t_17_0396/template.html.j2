<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 76.3mm; inline-size: 134.5mm; block-size: 34.7mm; font-size: 24.6pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 15.2mm; inset-block-start: 122.4mm; inline-size: 82.2mm; block-size: 12.4mm; font-size: 17.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 15.2mm; inset-block-start: 133.7mm; inline-size: 142.3mm; block-size: 34.7mm; font-size: 24.6pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 173.6mm; inset-block-start: 189.9mm; inline-size: 21.7mm; block-size: 21.1mm; font-size: 14.9pt"></div>
<footer class="box" style="inset-inline-start: 16.5mm; inset-block-start: 193.1mm; inline-size: 77.4mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_6 }}</footer><p class="box" style="inset-inline-start: 197.9mm; inset-block-start: 195.0mm; inline-size: 36.8mm; block-size: 11.2mm; font-size: 15.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 264.8mm; inset-block-start: 197.0mm; inline-size: 2.6mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
