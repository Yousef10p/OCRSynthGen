<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<main>
<div class="banner">
<div class="banner-text">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<a class="btn">{{ slot_7 }}</a>
</div>
<div class="banner-image ph"></div>
</div>
<div class="product-list">
<div class="product">
<div class="product-image ph"></div>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<a class="btn">{{ slot_10 }}</a>
</div>
<div class="product">
<div class="product-image ph"></div>
