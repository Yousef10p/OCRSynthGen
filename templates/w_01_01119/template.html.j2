    padding: 20px;
    overflow: hidden;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline-block;
}

nav a {
    color: white;
    background: green;
    padding: 10px 20px;
    text-decoration: none;
}

