}

.gallery {
    display: flex;
    justify-content: space-between;
}

.img {
    width: 30%;
    height: 300px;
    background: gray;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
