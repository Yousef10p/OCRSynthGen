<p>{{ slot_5 }}</p>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<section id="shop">{{ slot_8 }}</section>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<section id="lifestyle">{{ slot_11 }}</section>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<section id="press">{{ slot_14 }}</section>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<section id="contact">{{ slot_17 }}</section>
