<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 157.0mm; inset-block-start: 12.1mm; inline-size: 41.8mm; block-size: 2.6mm; font-size: 8.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 45.0mm; inset-block-start: 18.5mm; inline-size: 110.9mm; block-size: 8.4mm; font-size: 11.9pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 157.9mm; inset-block-start: 16.8mm; inline-size: 34.1mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</header><header class="box" style="inset-inline-start: 177.2mm; inset-block-start: 28.5mm; inline-size: 14.8mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_3 }}</header><header class="box" style="inset-inline-start: 71.8mm; inset-block-start: 31.3mm; inline-size: 57.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_4 }}</header><h2 class="box" style="inset-inline-start: 58.7mm; inset-block-start: 47.5mm; inline-size: 91.7mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_5 }}</h2>
<div class="box" style="inset-inline-start: 24.5mm; inset-block-start: 61.1mm; inline-size: 158.2mm; block-size: 145.4mm; font-size: 40.0pt"><table>
<tr>
<th>{{ slot_6 }}</th>
<th>{{ slot_7 }}</th>
<th>{{ slot_8 }}</th>
<th>{{ slot_9 }}</th>
</tr>
