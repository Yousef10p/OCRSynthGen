<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 60.3mm; inset-block-start: 33.1mm; inline-size: 71.3mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 149.7mm; inset-block-start: 33.1mm; inline-size: 28.3mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 39.2mm; inset-block-start: 41.5mm; inline-size: 114.3mm; block-size: 10.4mm; font-size: 9.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 154.9mm; inset-block-start: 42.0mm; inline-size: 22.8mm; block-size: 2.7mm; font-size: 7.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 42.7mm; inset-block-start: 56.3mm; inline-size: 42.4mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 39.2mm; inset-block-start: 223.3mm; inline-size: 47.1mm; block-size: 2.7mm; font-size: 7.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 39.2mm; inset-block-start: 227.5mm; inline-size: 62.7mm; block-size: 8.3mm; font-size: 7.8pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 95.2mm; inset-block-start: 237.5mm; inline-size: 4.6mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_7 }}</footer>
</div></body>
</html>
