<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 34.0mm; inset-block-start: 80.4mm; inline-size: 56.9mm; block-size: 6.8mm; font-size: 19.3pt">{{ slot_0 }}</h1>
<h1 class="box" style="inset-inline-start: 34.0mm; inset-block-start: 87.9mm; inline-size: 153.1mm; block-size: 36.0mm; font-size: 25.5pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 124.4mm; inline-size: 34.5mm; block-size: 6.7mm; font-size: 18.9pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 37.7mm; inset-block-start: 140.4mm; inline-size: 8.0mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 37.7mm; inset-block-start: 146.4mm; inline-size: 148.4mm; block-size: 12.3mm; font-size: 11.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 37.7mm; inset-block-start: 165.9mm; inline-size: 42.0mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 37.7mm; inset-block-start: 171.9mm; inline-size: 139.9mm; block-size: 8.4mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 37.7mm; inset-block-start: 181.6mm; inline-size: 147.2mm; block-size: 8.5mm; font-size: 12.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 37.3mm; inset-block-start: 197.4mm; inline-size: 115.2mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 35.5mm; inset-block-start: 243.1mm; inline-size: 32.2mm; block-size: 31.6mm; font-size: 14.9pt"></div>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 281.7mm; inline-size: 2.7mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_9 }}</footer>
</div></body>
</html>
