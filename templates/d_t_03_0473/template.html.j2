<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.4mm; inset-block-start: 19.9mm; inline-size: 131.1mm; block-size: 9.7mm; font-size: 27.5pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 19.4mm; inset-block-start: 31.7mm; inline-size: 70.3mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 41.2mm; inline-size: 180.9mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 56.7mm; inset-block-start: 65.8mm; inline-size: 105.7mm; block-size: 70.5mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 145.1mm; inline-size: 179.7mm; block-size: 12.9mm; font-size: 12.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 160.3mm; inline-size: 179.6mm; block-size: 12.9mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 175.5mm; inline-size: 179.7mm; block-size: 12.9mm; font-size: 12.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 190.7mm; inline-size: 179.6mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 38.2mm; inset-block-start: 228.7mm; inline-size: 32.5mm; block-size: 30.5mm; font-size: 14.4pt"></div>
<p class="box" style="inset-inline-start: 78.9mm; inset-block-start: 234.8mm; inline-size: 119.7mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 196.7mm; inset-block-start: 270.2mm; inline-size: 2.7mm; block-size: 2.0mm; font-size: 5.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
