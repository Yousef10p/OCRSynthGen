<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="content">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<div class="calendar">
<div class="event">
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
<button>{{ slot_10 }}</button>
</div>
</div>
</div>
<div class="footer">
<ul>
