<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 50.4mm; inset-block-start: 38.8mm; inline-size: 115.1mm; block-size: 6.9mm; font-size: 20.7pt">{{ slot_0 }}</h1>
<h1 class="box" style="inset-inline-start: 40.9mm; inset-block-start: 51.7mm; inline-size: 134.0mm; block-size: 15.1mm; font-size: 20.7pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 42.4mm; inset-block-start: 73.3mm; inline-size: 131.1mm; block-size: 4.8mm; font-size: 14.3pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 15.3mm; inset-block-start: 78.9mm; inline-size: 6.0mm; block-size: 136.8mm; font-size: 20.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 61.1mm; inset-block-start: 79.3mm; inline-size: 93.6mm; block-size: 4.8mm; font-size: 14.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 95.6mm; inset-block-start: 88.6mm; inline-size: 24.8mm; block-size: 4.8mm; font-size: 14.3pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 33.1mm; inset-block-start: 105.4mm; inline-size: 70.9mm; block-size: 5.7mm; font-size: 17.2pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 33.1mm; inset-block-start: 114.9mm; inline-size: 149.8mm; block-size: 66.8mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 33.1mm; inset-block-start: 182.6mm; inline-size: 149.8mm; block-size: 51.9mm; font-size: 12.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 33.1mm; inset-block-start: 235.3mm; inline-size: 149.8mm; block-size: 18.4mm; font-size: 12.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 107.0mm; inset-block-start: 262.5mm; inline-size: 1.9mm; block-size: 4.0mm; font-size: 12.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
