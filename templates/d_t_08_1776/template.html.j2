<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 29.2mm; inset-block-start: 26.1mm; inline-size: 17.8mm; block-size: 3.1mm; font-size: 10.0pt"><li>{{ slot_0 }}</li></ul>
<div class="box ph" style="inset-inline-start: 57.1mm; inset-block-start: 32.2mm; inline-size: 127.9mm; block-size: 29.7mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 66.8mm; inline-size: 8.7mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 53.4mm; inset-block-start: 77.1mm; inline-size: 112.0mm; block-size: 22.5mm; font-size: 10.0pt"></div>
<ul class="box" style="inset-inline-start: 29.2mm; inset-block-start: 110.6mm; inline-size: 155.8mm; block-size: 31.4mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 146.2mm; inline-size: 160.0mm; block-size: 8.0mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 46.3mm; inset-block-start: 161.6mm; inline-size: 117.3mm; block-size: 3.0mm; font-size: 7.0pt"></div>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 174.6mm; inline-size: 44.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 54.3mm; inset-block-start: 186.1mm; inline-size: 101.5mm; block-size: 19.6mm; font-size: 10.0pt"></div>
<footer class="box" style="inset-inline-start: 103.2mm; inset-block-start: 280.1mm; inline-size: 3.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
