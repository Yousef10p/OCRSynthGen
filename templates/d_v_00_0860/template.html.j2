<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 10.0mm; inset-block-start: 9.4mm; inline-size: 1.5mm; block-size: 3.4mm; font-size: 9.8pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 10.0mm; inset-block-start: 13.5mm; inline-size: 27.3mm; block-size: 5.8mm; font-size: 8.3pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 10.0mm; inset-block-start: 28.9mm; inline-size: 43.4mm; block-size: 12.0mm; font-size: 17.0pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 16.5mm; inset-block-start: 59.0mm; inline-size: 193.4mm; block-size: 141.3mm; font-size: 28.6pt"></div>
<h2 class="box" style="inset-inline-start: 10.0mm; inset-block-start: 215.8mm; inline-size: 36.4mm; block-size: 6.5mm; font-size: 18.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 10.0mm; inset-block-start: 236.0mm; inline-size: 52.6mm; block-size: 17.1mm; font-size: 24.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 105.0mm; inset-block-start: 236.0mm; inline-size: 30.7mm; block-size: 17.1mm; font-size: 24.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 10.0mm; inset-block-start: 259.5mm; inline-size: 51.4mm; block-size: 17.1mm; font-size: 24.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 105.0mm; inset-block-start: 259.5mm; inline-size: 73.4mm; block-size: 17.1mm; font-size: 24.2pt">{{ slot_7 }}</p>
</div></body>
</html>
