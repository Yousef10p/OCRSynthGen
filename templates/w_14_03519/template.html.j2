<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, ul {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}
.navbar ul {
    list-style-type: none;
    overflow: hidden;
    background-color: #333;
}
.navbar li {
    float: right;
}
.navbar li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}
.navbar li a:hover {
    background-color: #111;
}
.main {
    padding: 20px;
    text-align: center;
}
.card {
    width: 30%;
    margin: 1%;
    display: inline-block;
    height: 50px;
    background-color: #f2f2f2;
    text-align: center;
    line-height: 50px;
}
.footer {
    background-color: #f2f2f2;
    padding: 20px;
    text-align: center;
}
.footer ul {
    padding: 0;
}
.footer li {
    float: right;
}
.footer li a {
    display: block;
    color: #333;
    padding: 0 16px;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navbar">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="main">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div class="row">
<div class="card">{{ slot_8 }}</div>
<div class="card">{{ slot_9 }}</div>
<div class="card">{{ slot_10 }}</div>
</div>
<div class="row">
<div class="card">{{ slot_11 }}</div>
<div class="card">{{ slot_12 }}</div>
<div class="card">{{ slot_13 }}</div>
</div>
</div>
<div class="footer">
<p>{{ slot_14 }}</p>
<ul>
<li><a>{{ slot_15 }}</a></li>
<li><a>{{ slot_16 }}</a></li>
<li><a>{{ slot_17 }}</a></li>
</ul>
</div>
</body>
</html>