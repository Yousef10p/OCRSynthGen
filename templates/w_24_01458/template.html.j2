<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


header {
    background-color: #f4f4f4;
    color: #555;
    padding: 10px;
    text-align: center;
}

header h1 {
    font-size: 36px;
}


#player {
    background-color: #666;
    color: #fff;
    height: 60px;
    line-height: 60px;
    margin: 20px 0;
    text-align: center;
}


.artist {
    background-color: #ddd;
    color: #333;
    height: 120px;
    line-height: 120px;
    margin: 20px 0;
    text-align: center;
}

section {
    margin: 20px;
}

footer {
    background-color: #f4f4f4;
    color: #555;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<div id="player">{{ slot_1 }}</div> 
</header>
<section>
<h2>{{ slot_2 }}</h2>
<div class="artist">{{ slot_3 }}</div> 
<p>{{ slot_4 }}</p>
<div class="artist">{{ slot_5 }}</div> 
<p>{{ slot_6 }}</p>
<div class="artist">{{ slot_7 }}</div> 
<p>{{ slot_8 }}</p>
</section>
<section>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<ul>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
</ul>
</section>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>