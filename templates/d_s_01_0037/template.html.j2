<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 24.9mm; inset-block-start: 9.9mm; inline-size: 58.2mm; block-size: 15.1mm; font-size: 14.3pt"></div>
<h2 class="box" style="inset-inline-start: 30.0mm; inset-block-start: 39.2mm; inline-size: 156.4mm; block-size: 10.3mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 54.5mm; inline-size: 161.1mm; block-size: 8.5mm; font-size: 10.0pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 31.4mm; inset-block-start: 68.0mm; inline-size: 154.9mm; block-size: 30.0mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.4mm; inset-block-start: 100.1mm; inline-size: 154.9mm; block-size: 55.7mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.4mm; inset-block-start: 157.9mm; inline-size: 154.9mm; block-size: 30.0mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 193.4mm; inline-size: 161.2mm; block-size: 21.4mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 257.9mm; inline-size: 160.9mm; block-size: 10.3mm; font-size: 8.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 268.1mm; inline-size: 160.9mm; block-size: 6.9mm; font-size: 8.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 108.0mm; inset-block-start: 278.1mm; inline-size: 3.9mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
