<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #F2EADC;
    color: #593F26;
}

header, footer {
    width: 100%;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F2EADC;
}

.slider {
    width: 100%;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F2EADC;
    color: #593F26;
}

main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 50px;
}

section {
    margin-bottom: 50px;
}

section form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 10px;
}

section form input {
    padding: 10px;
    border: none;
    outline: none;
    background-color: #E1CBA5;
}

section form input[type=submit] {
    grid-column: 1 / span 2;
    background-color: #593F26;
    color: #F2EADC;
}

ul li {
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</header>
<div class="slider">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<main>
<section id="reservation">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_2 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
<span class="">{{ slot_6 }}</span>
</form>
</section>
<section id="menu">
<h1>{{ slot_7 }}</h1>
<ul>
<li><h2>{{ slot_8 }}</h2> <p>{{ slot_9 }}</p></li>
<li><h2>{{ slot_10 }}</h2> <p>{{ slot_11 }}</p></li>
<li><h2>{{ slot_12 }}</h2> <p>{{ slot_13 }}</p></li>
</ul>
</section>
<section id="reviews">
<h1>{{ slot_14 }}</h1>
<p>{{ slot_15 }}</p>
</section>
</main>
<footer>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</footer>
</body>
</html>