<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 111.1mm; inset-block-start: 44.8mm; inline-size: 36.1mm; block-size: 24.4mm; font-size: 13.8pt"></div>
<div class="box ph" style="inset-inline-start: 73.0mm; inset-block-start: 44.9mm; inline-size: 36.3mm; block-size: 24.1mm; font-size: 13.7pt"></div>
<div class="box ph" style="inset-inline-start: 149.0mm; inset-block-start: 44.9mm; inline-size: 36.3mm; block-size: 24.2mm; font-size: 13.7pt"></div>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 85.2mm; inline-size: 73.6mm; block-size: 52.9mm; font-size: 13.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 85.2mm; inline-size: 72.0mm; block-size: 28.2mm; font-size: 13.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 114.8mm; inline-size: 72.0mm; block-size: 33.1mm; font-size: 13.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 139.5mm; inline-size: 72.7mm; block-size: 52.9mm; font-size: 13.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 149.3mm; inline-size: 71.2mm; block-size: 52.9mm; font-size: 13.6pt">{{ slot_4 }}</p>
<header class="box" style="inset-inline-start: 205.7mm; inset-block-start: 166.8mm; inline-size: 2.0mm; block-size: 14.7mm; font-size: 40.0pt">{{ slot_5 }}</header><p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 193.8mm; inline-size: 73.5mm; block-size: 8.4mm; font-size: 12.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 111.1mm; inset-block-start: 219.9mm; inline-size: 93.3mm; block-size: 55.1mm; font-size: 15.6pt"></div>
<div class="box ph" style="inset-inline-start: 30.0mm; inset-block-start: 232.5mm; inline-size: 74.2mm; block-size: 38.4mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 276.1mm; inline-size: 20.3mm; block-size: 2.0mm; font-size: 5.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 276.1mm; inline-size: 18.2mm; block-size: 2.0mm; font-size: 5.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 164.9mm; inset-block-start: 287.3mm; inline-size: 34.8mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
