<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

*{
    padding: 0;
    margin: 0;
    box-sizing: border-box;
}
body{
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-body);
}
.header, .menu, .content, .footer{
    width: 80%;
    margin: 20px 0;
}
.menu ul{
    list-style: none;
}
.section{
    display: flex;
    flex-direction: column;
    align-items: center;
}
.section div{
    height: 200px;
    width: 100%;
    margin: 20px 0;
    background-color: grey;
}
.menu ul li, .footer a{
    margin: 10px 0;
}
.content{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
</div>
<div class="menu">
<h2>{{ slot_1 }}</h2>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="content">
<div class="section" id="model">
<h2>{{ slot_5 }}</h2>
<div class="model-pic"></div>
<p>{{ slot_6 }}</p>
</div>
<div class="section" id="performance">
<h2>{{ slot_7 }}</h2>
<div class="performance-pic"></div>
<p>{{ slot_8 }}</p>
</div>
<div class="section" id="ownership">
<h2>{{ slot_9 }}</h2>
<div class="ownership-pic"></div>
<p>{{ slot_10 }}</p>
</div>
</div>
<div class="footer">
<h2>{{ slot_11 }}</h2>
<div class="dealer-pic"></div>
<a>{{ slot_12 }}</a>
<h2>{{ slot_13 }}</h2>
<a>{{ slot_14 }}</a>
</div>
</body>
</html>