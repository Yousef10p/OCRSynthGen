<article class="promo">
<h3>{{ slot_6 }}</h3>
<div class="promo-image">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</article>
<article class="promo">
<h3>{{ slot_9 }}</h3>
<div class="promo-image">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
</article>
</div>
<div class="column right">
