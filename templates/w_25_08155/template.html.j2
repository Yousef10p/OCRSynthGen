* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    line-height: 1.6;
}

.header {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
}

.nav ul {
    list-style: none;
    display: flex;
    justify-content: space-around;
}

.nav a {
    color: #fff;
    text-decoration: none;
}

.product, .review, .signup {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: 10px;
    box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
    transition: 0.3s;
}

.product:hover, .review:hover, .signup:hover {
    box-shadow: 0 16px 32px 0 rgba(0, 0, 0, 0.2);
    transform: scale(1.05);
}

.rectangle {
    height: 200px;
    background-color: #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
