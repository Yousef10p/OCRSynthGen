<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 0.4mm; inline-size: 51.1mm; block-size: 51.4mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 101.4mm; inset-block-start: 0.5mm; inline-size: 51.5mm; block-size: 51.1mm; font-size: 14.5pt"></div>
<header class="box" style="inset-inline-start: 6.4mm; inset-block-start: 89.4mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 63.6mm; inset-block-start: 101.2mm; inline-size: 122.2mm; block-size: 28.1mm; font-size: 19.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 63.6mm; inset-block-start: 137.5mm; inline-size: 122.1mm; block-size: 58.3mm; font-size: 20.7pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 153.3mm; inline-size: 51.2mm; block-size: 51.1mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 63.6mm; inset-block-start: 203.9mm; inline-size: 120.9mm; block-size: 19.4mm; font-size: 18.3pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 50.8mm; inset-block-start: 245.4mm; inline-size: 51.1mm; block-size: 51.1mm; font-size: 14.5pt"></div>
</div></body>
</html>
