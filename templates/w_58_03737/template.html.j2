<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
}

header {
  background-color: #ff0000;
  color: #ffffff;
  padding: 1em 0;
}

nav ul {
  list-style-type: none;
}

nav ul li {
  display: inline;
  margin-left: 1em;
}

nav ul li a {
  color: #ffffff;
  text-decoration: none;
}

.full-screen-banner {
  background-color: #0000ff;
  color: #ffffff;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.full-screen-banner h1 {
  font-size: 3em;
}

.full-screen-banner button {
  background-color: #222222;
  color: #ffffff;
  padding: 1em;
  border: none;
  margin-top: 1em;
}

aside {
  background-color: #dddddd;
  width: 200px;
  position: fixed;
  top: 0;
  bottom: 0;
  right: 0;
}

main {
  margin-right: 200px;
  padding: 1em;
}

.product-image {
  height: 300px;
  width: 100%;
  background-color: #ff00ff;
}

footer {
  background-color: #00ff00;
  color: #ffffff;
  padding: 2em 0;
  text-align: center;
}

footer form input[type="email"] {
  padding: 0.5em;
  margin-left: 0.5em;
}

footer form button {
  padding: 0.5em;
  background-color: #ffffff;
  border: none;
}

.social-links a {
  margin-left: 1em;
  color: #ffffff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
