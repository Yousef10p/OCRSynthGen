<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 108.8mm; inline-size: 86.6mm; block-size: 25.8mm; font-size: 12.2pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 108.5mm; inline-size: 27.7mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 113.5mm; inline-size: 87.0mm; block-size: 57.4mm; font-size: 12.5pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 140.0mm; inline-size: 22.9mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_6 }}</h2>
