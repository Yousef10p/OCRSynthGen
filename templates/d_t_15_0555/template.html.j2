<div class="box ph" style="inset-inline-start: 25.4mm; inset-block-start: 183.6mm; inline-size: 177.3mm; block-size: 66.7mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 253.0mm; inline-size: 113.0mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_8 }}</p>
