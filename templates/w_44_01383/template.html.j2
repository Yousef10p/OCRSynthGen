<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.hero {
    height: 100vh;
    background: linear-gradient(to left, #f7b733, #fc4a1a); 
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2em;
}

.nav {
    display: flex;
    justify-content: space-around;
    background: #f9f9f9;
}

.nav a {
    text-decoration: none;
    color: #616161;
    padding: 20px;
}

.parallax, .column {
    padding: 50px;
    height: 300px;  
}

.aboutus {
    background: #f5f5f5;
}

.initiatives, .learnmore {
    display: flex;
}

.column {
    flex: 1;
    background: linear-gradient(to bottom left, #fc4a1a, #f7b733); 
    color: white;
    margin: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.2em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<h1>{{ slot_0 }}</h1>
</div>
<div class="nav">
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</div>
<div class="parallax">
<div class="aboutus" id="aboutus">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p></div>
<div class="initiatives" id="initiatives">
<h2>{{ slot_6 }}</h2>
<div class="column"><p>{{ slot_7 }}</p></div>
<div class="column"><p>{{ slot_8 }}</p></div>
<div class="column"><p>{{ slot_9 }}</p></div>
</div>
<div class="learnmore" id="learnmore">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</div>
</div>
</body>
</html>