<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 33.0mm; inset-block-start: 23.4mm; inline-size: 76.3mm; block-size: 5.5mm; font-size: 17.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 39.5mm; inline-size: 152.4mm; block-size: 50.5mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 58.5mm; inset-block-start: 91.2mm; inline-size: 99.3mm; block-size: 29.7mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 119.6mm; inline-size: 152.4mm; block-size: 21.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 40.0mm; inset-block-start: 150.9mm; inline-size: 138.4mm; block-size: 8.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 169.8mm; inline-size: 143.3mm; block-size: 8.3mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 181.8mm; inline-size: 152.4mm; block-size: 30.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 69.8mm; inset-block-start: 217.8mm; inline-size: 115.6mm; block-size: 15.5mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 107.1mm; inset-block-start: 259.4mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
