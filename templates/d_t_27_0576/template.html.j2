<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 56.3mm; inset-block-start: 57.9mm; inline-size: 49.3mm; block-size: 57.4mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 116.9mm; inline-size: 76.5mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 124.5mm; inline-size: 119.6mm; block-size: 7.3mm; font-size: 10.3pt"><li>{{ slot_1 }}</li></ul>
<div class="box ph" style="inset-inline-start: 56.3mm; inset-block-start: 138.0mm; inline-size: 64.3mm; block-size: 35.5mm; font-size: 14.4pt"></div>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 175.0mm; inline-size: 57.3mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 182.5mm; inline-size: 121.5mm; block-size: 11.4mm; font-size: 10.8pt"><li>{{ slot_3 }}</li></ul>
<footer class="box" style="inset-inline-start: 122.5mm; inset-block-start: 248.2mm; inline-size: 55.7mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_4 }}</footer>
</div></body>
</html>
