<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.9mm; inset-block-start: 29.1mm; inline-size: 27.1mm; block-size: 23.5mm; font-size: 16.6pt"></div>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 41.1mm; inline-size: 53.8mm; block-size: 10.2mm; font-size: 14.4pt">{{ slot_0 }}</p>
<h1 class="box" style="inset-inline-start: 93.2mm; inset-block-start: 59.3mm; inline-size: 24.7mm; block-size: 5.9mm; font-size: 16.6pt">{{ slot_1 }}</h1>
<h1 class="box" style="inset-inline-start: 71.6mm; inset-block-start: 66.1mm; inline-size: 67.9mm; block-size: 5.9mm; font-size: 16.6pt">{{ slot_2 }}</h1>
<p class="box" style="inset-inline-start: 81.6mm; inset-block-start: 72.8mm; inline-size: 47.9mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 78.5mm; inset-block-start: 79.5mm; inline-size: 54.0mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 86.2mm; inline-size: 160.6mm; block-size: 21.7mm; font-size: 15.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 109.0mm; inline-size: 160.3mm; block-size: 41.9mm; font-size: 17.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 151.9mm; inline-size: 160.7mm; block-size: 10.4mm; font-size: 14.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 163.3mm; inline-size: 160.8mm; block-size: 21.7mm; font-size: 15.4pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 176.1mm; inset-block-start: 271.8mm; inline-size: 9.5mm; block-size: 13.4mm; font-size: 19.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
