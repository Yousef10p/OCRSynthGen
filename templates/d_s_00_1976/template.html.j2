<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 26.0mm; inline-size: 161.0mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 30.2mm; inset-block-start: 33.4mm; inline-size: 159.6mm; block-size: 23.1mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 57.1mm; inline-size: 129.3mm; block-size: 4.7mm; font-size: 10.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 30.9mm; inset-block-start: 65.4mm; inline-size: 158.9mm; block-size: 42.2mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 108.7mm; inline-size: 15.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 51.6mm; inset-block-start: 113.7mm; inline-size: 138.2mm; block-size: 60.7mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 175.4mm; inline-size: 17.2mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 41.4mm; inset-block-start: 182.8mm; inline-size: 148.4mm; block-size: 42.2mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 225.7mm; inline-size: 164.4mm; block-size: 11.4mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 38.5mm; inset-block-start: 244.3mm; inline-size: 141.8mm; block-size: 18.7mm; font-size: 10.9pt"></div>
<footer class="box" style="inset-inline-start: 103.8mm; inset-block-start: 266.9mm; inline-size: 3.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_5 }}</footer>
</div></body>
</html>
