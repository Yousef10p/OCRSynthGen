<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 66.6mm; inset-block-start: 57.4mm; inline-size: 111.4mm; block-size: 70.2mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 66.2mm; inset-block-start: 129.3mm; inline-size: 63.1mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 61.3mm; inset-block-start: 138.2mm; inline-size: 53.3mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 144.1mm; inline-size: 122.0mm; block-size: 15.5mm; font-size: 11.0pt"><li>{{ slot_2 }}</li></ul>
<div class="box ph" style="inset-inline-start: 61.7mm; inset-block-start: 165.3mm; inline-size: 100.6mm; block-size: 28.0mm; font-size: 15.9pt"></div>
<p class="box" style="inset-inline-start: 61.3mm; inset-block-start: 195.4mm; inline-size: 93.6mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 58.4mm; inset-block-start: 208.1mm; inline-size: 117.9mm; block-size: 11.4mm; font-size: 10.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 58.4mm; inset-block-start: 223.9mm; inline-size: 123.6mm; block-size: 11.4mm; font-size: 10.8pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 31.6mm; inset-block-start: 248.2mm; inline-size: 121.8mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
