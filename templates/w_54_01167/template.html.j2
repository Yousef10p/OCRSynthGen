<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
</nav>
</header>
<main>
<div class="grid">
<div class="grid-item">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div class="grid-item">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="grid-item">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
<div class="grid-item">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
</div>
<a class="cta">{{ slot_14 }}</a>
</main>
</body>
</html>