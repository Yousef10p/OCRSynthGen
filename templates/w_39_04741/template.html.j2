    padding: 1em;
}
nav ul, footer ul {
    display: flex;
    list-style: none;
    gap: 1em;
}
.cta {
    position: fixed;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    background-color: #000;
    color: #fff;
    padding: 1em;
}
.destination, .tour {
    display: flex;
    flex-direction: column;
    align-items: center;
