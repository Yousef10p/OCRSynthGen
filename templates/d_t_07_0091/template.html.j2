<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 25.4mm; inset-block-start: 25.4mm; inline-size: 104.1mm; block-size: 27.3mm; font-size: 15.5pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 58.4mm; inline-size: 55.9mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_1 }}</h2>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 66.8mm; inline-size: 49.1mm; block-size: 4.1mm; font-size: 11.5pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 35.4mm; inset-block-start: 75.3mm; inline-size: 156.6mm; block-size: 37.9mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 35.4mm; inset-block-start: 117.6mm; inline-size: 156.5mm; block-size: 50.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 35.4mm; inset-block-start: 172.7mm; inline-size: 155.9mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 35.4mm; inset-block-start: 185.4mm; inline-size: 156.2mm; block-size: 21.0mm; font-size: 11.9pt">{{ slot_6 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 210.8mm; inline-size: 49.1mm; block-size: 4.1mm; font-size: 11.5pt"><li>{{ slot_7 }}</li></ul>
<p class="box" style="inset-inline-start: 35.4mm; inset-block-start: 219.2mm; inline-size: 156.8mm; block-size: 37.9mm; font-size: 11.9pt">{{ slot_8 }}</p>
