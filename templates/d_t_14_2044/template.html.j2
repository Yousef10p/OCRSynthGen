<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 24.0mm; inset-block-start: 14.9mm; inline-size: 51.1mm; block-size: 10.5mm; font-size: 29.6pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 27.7mm; inset-block-start: 30.3mm; inline-size: 23.0mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 36.4mm; inline-size: 147.8mm; block-size: 12.3mm; font-size: 11.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 50.0mm; inline-size: 87.1mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 27.3mm; inset-block-start: 60.2mm; inline-size: 115.2mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 77.2mm; inline-size: 41.6mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 83.1mm; inline-size: 41.6mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 89.1mm; inline-size: 3.6mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 281.7mm; inline-size: 2.7mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_8 }}</footer>
</div></body>
</html>
