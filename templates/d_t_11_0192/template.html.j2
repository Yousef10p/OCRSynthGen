<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 95.8mm; inline-size: 88.8mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 62.8mm; inset-block-start: 106.3mm; inline-size: 127.0mm; block-size: 6.1mm; font-size: 8.0pt"></div>
