<a>{{ slot_5 }}</a>
</nav>
<main>
<section id="content">
<article>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="post-image">{{ slot_8 }}</div>
</article>
<article>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<div class="post-image">{{ slot_11 }}</div>
</article>
</section>
<aside>
