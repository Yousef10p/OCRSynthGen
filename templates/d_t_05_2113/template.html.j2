<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 171.8mm; inset-block-start: 9.3mm; inline-size: 29.3mm; block-size: 11.8mm; font-size: 16.7pt"></div>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 50.3mm; inline-size: 42.6mm; block-size: 8.1mm; font-size: 11.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 50.0mm; inline-size: 46.7mm; block-size: 12.1mm; font-size: 11.4pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 144.3mm; inset-block-start: 49.4mm; inline-size: 48.3mm; block-size: 70.1mm; font-size: 15.3pt"></div>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 61.9mm; inline-size: 30.8mm; block-size: 8.0mm; font-size: 11.4pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 66.4mm; inline-size: 51.8mm; block-size: 52.3mm; font-size: 12.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 71.7mm; inline-size: 53.1mm; block-size: 47.1mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 126.2mm; inline-size: 169.3mm; block-size: 8.2mm; font-size: 7.8pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 149.8mm; inline-size: 205.2mm; block-size: 121.8mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 274.2mm; inline-size: 149.7mm; block-size: 6.1mm; font-size: 8.6pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 88.4mm; inset-block-start: 285.2mm; inline-size: 113.6mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_7 }}</footer>
</div></body>
</html>
