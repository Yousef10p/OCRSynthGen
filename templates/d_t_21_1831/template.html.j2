<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 35.9mm; inset-block-start: 32.7mm; inline-size: 111.8mm; block-size: 9.2mm; font-size: 34.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 18.3mm; inset-block-start: 45.5mm; inline-size: 178.3mm; block-size: 26.9mm; font-size: 22.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.3mm; inset-block-start: 77.3mm; inline-size: 77.8mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 83.3mm; inline-size: 40.5mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 91.4mm; inline-size: 87.7mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 99.6mm; inline-size: 62.6mm; block-size: 6.8mm; font-size: 22.1pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 18.3mm; inset-block-start: 112.4mm; inline-size: 176.8mm; block-size: 47.3mm; font-size: 22.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 18.3mm; inset-block-start: 160.8mm; inline-size: 144.5mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 133.0mm; inset-block-start: 269.8mm; inline-size: 38.4mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 184.9mm; inset-block-start: 269.8mm; inline-size: 6.5mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
