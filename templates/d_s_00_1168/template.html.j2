<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 22.2mm; inset-block-start: 21.1mm; inline-size: 22.0mm; block-size: 6.0mm; font-size: 17.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 28.2mm; inline-size: 84.3mm; block-size: 22.6mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 109.9mm; inset-block-start: 28.2mm; inline-size: 81.3mm; block-size: 13.1mm; font-size: 12.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 109.9mm; inset-block-start: 45.6mm; inline-size: 84.2mm; block-size: 46.5mm; font-size: 13.2pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 22.2mm; inset-block-start: 56.1mm; inline-size: 34.7mm; block-size: 6.0mm; font-size: 17.1pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 63.2mm; inline-size: 82.6mm; block-size: 51.2mm; font-size: 13.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 109.9mm; inset-block-start: 96.4mm; inline-size: 80.1mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 21.5mm; inset-block-start: 141.6mm; inline-size: 153.3mm; block-size: 31.7mm; font-size: 40.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 21.5mm; inset-block-start: 171.3mm; inline-size: 140.3mm; block-size: 25.4mm; font-size: 18.0pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 151.6mm; inset-block-start: 212.2mm; inline-size: 42.1mm; block-size: 54.4mm; font-size: 38.6pt"></div>
<h2 class="box" style="inset-inline-start: 22.2mm; inset-block-start: 226.9mm; inline-size: 34.8mm; block-size: 6.0mm; font-size: 17.1pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 233.8mm; inline-size: 124.0mm; block-size: 33.2mm; font-size: 11.8pt">{{ slot_10 }}</p>
</div></body>
</html>
