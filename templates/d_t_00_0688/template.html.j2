<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 19.4mm; inset-block-start: 24.1mm; inline-size: 113.4mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 43.2mm; inline-size: 81.5mm; block-size: 56.3mm; font-size: 17.7pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 114.2mm; inset-block-start: 43.4mm; inline-size: 82.6mm; block-size: 106.0mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 102.0mm; inline-size: 81.6mm; block-size: 62.9mm; font-size: 17.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 114.7mm; inset-block-start: 154.3mm; inline-size: 81.6mm; block-size: 75.9mm; font-size: 17.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.4mm; inset-block-start: 167.2mm; inline-size: 80.5mm; block-size: 75.9mm; font-size: 17.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 114.7mm; inset-block-start: 232.6mm; inline-size: 79.9mm; block-size: 17.2mm; font-size: 16.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 23.6mm; inset-block-start: 245.5mm; inline-size: 77.2mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_6 }}</p>
</div></body>
</html>
