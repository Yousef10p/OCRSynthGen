<p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 131.8mm; inline-size: 148.5mm; block-size: 25.1mm; font-size: 11.8pt">{{ slot_4 }}</p>
<header class="box" style="inset-inline-start: 186.7mm; inset-block-start: 153.4mm; inline-size: 3.1mm; block-size: 2.3mm; font-size: 6.4pt">{{ slot_5 }}</header><p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 158.8mm; inline-size: 148.5mm; block-size: 29.6mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 190.3mm; inline-size: 148.5mm; block-size: 25.1mm; font-size: 11.8pt">{{ slot_7 }}</p>
