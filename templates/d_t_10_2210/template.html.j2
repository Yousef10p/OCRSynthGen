<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 25.8mm; inline-size: 164.5mm; block-size: 7.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 33.1mm; inline-size: 164.5mm; block-size: 26.4mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 43.9mm; inset-block-start: 64.0mm; inline-size: 146.0mm; block-size: 15.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 78.5mm; inline-size: 164.5mm; block-size: 26.4mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 108.0mm; inline-size: 164.5mm; block-size: 41.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 30.7mm; inset-block-start: 161.0mm; inline-size: 68.9mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 172.9mm; inline-size: 164.5mm; block-size: 33.8mm; font-size: 12.0pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 31.7mm; inset-block-start: 214.4mm; inline-size: 158.2mm; block-size: 22.0mm; font-size: 12.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.7mm; inset-block-start: 240.0mm; inline-size: 158.2mm; block-size: 11.8mm; font-size: 12.0pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 104.6mm; inset-block-start: 266.7mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
