<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 91.5mm; inline-size: 175.6mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 13.0mm; inset-block-start: 101.6mm; inline-size: 32.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_6 }}</h2>
