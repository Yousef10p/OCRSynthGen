<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 42.3mm; inline-size: 149.6mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 51.8mm; inline-size: 82.5mm; block-size: 3.2mm; font-size: 8.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 61.7mm; inline-size: 174.6mm; block-size: 32.8mm; font-size: 13.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 96.3mm; inline-size: 173.7mm; block-size: 27.8mm; font-size: 13.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 125.9mm; inline-size: 174.7mm; block-size: 42.7mm; font-size: 13.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 170.4mm; inline-size: 173.6mm; block-size: 13.0mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 185.2mm; inline-size: 173.6mm; block-size: 18.0mm; font-size: 12.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 205.0mm; inline-size: 173.6mm; block-size: 18.0mm; font-size: 12.7pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 138.5mm; inset-block-start: 227.7mm; inline-size: 52.1mm; block-size: 13.6mm; font-size: 12.8pt"></div>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 239.5mm; inline-size: 32.7mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 16.9mm; inset-block-start: 264.6mm; inline-size: 2.7mm; block-size: 2.7mm; font-size: 7.5pt">{{ slot_9 }}</footer>
</div></body>
</html>
