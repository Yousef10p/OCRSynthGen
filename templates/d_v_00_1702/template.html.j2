<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 50.6mm; inset-block-start: 26.4mm; inline-size: 106.2mm; block-size: 28.0mm; font-size: 5.4pt"></div>
<p class="box" style="inset-inline-start: 39.8mm; inset-block-start: 59.2mm; inline-size: 130.5mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 70.2mm; inline-size: 74.0mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 81.2mm; inline-size: 159.2mm; block-size: 25.0mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 75.3mm; inset-block-start: 112.3mm; inline-size: 109.3mm; block-size: 23.0mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 140.2mm; inline-size: 159.2mm; block-size: 25.1mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 52.2mm; inset-block-start: 174.2mm; inline-size: 102.7mm; block-size: 64.3mm; font-size: 5.7pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 246.8mm; inline-size: 159.2mm; block-size: 12.4mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 30.8mm; inset-block-start: 266.3mm; inline-size: 153.9mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 279.1mm; inline-size: 1.8mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
