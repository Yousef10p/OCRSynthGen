<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.1mm; inset-block-start: 15.0mm; inline-size: 86.2mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 15.3mm; inset-block-start: 49.9mm; inline-size: 83.9mm; block-size: 84.1mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 106.6mm; inset-block-start: 49.4mm; inline-size: 84.3mm; block-size: 39.2mm; font-size: 13.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 106.6mm; inset-block-start: 90.3mm; inline-size: 84.4mm; block-size: 34.1mm; font-size: 13.8pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 106.6mm; inset-block-start: 130.8mm; inline-size: 40.0mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 57.0mm; inset-block-start: 136.1mm; inline-size: 42.0mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 106.6mm; inset-block-start: 136.2mm; inline-size: 84.4mm; block-size: 39.2mm; font-size: 13.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 106.6mm; inset-block-start: 177.1mm; inline-size: 85.0mm; block-size: 34.1mm; font-size: 13.8pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 106.6mm; inset-block-start: 217.6mm; inline-size: 18.4mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_7 }}</h2>
