<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 19.4mm; inline-size: 170.9mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 40.3mm; inline-size: 170.8mm; block-size: 22.5mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 65.7mm; inline-size: 170.8mm; block-size: 27.1mm; font-size: 12.8pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 2.0mm; inset-block-start: 78.6mm; inline-size: 8.5mm; block-size: 21.5mm; font-size: 20.3pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 95.7mm; inline-size: 170.8mm; block-size: 27.1mm; font-size: 12.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 125.7mm; inline-size: 170.8mm; block-size: 36.3mm; font-size: 12.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 164.9mm; inline-size: 170.8mm; block-size: 36.3mm; font-size: 12.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 204.1mm; inline-size: 170.8mm; block-size: 22.5mm; font-size: 12.8pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 11.0mm; inset-block-start: 279.4mm; inline-size: 4.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
