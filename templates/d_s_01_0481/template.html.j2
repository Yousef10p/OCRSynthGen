<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 11.3mm; inline-size: 101.8mm; block-size: 6.1mm; font-size: 17.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 20.6mm; inline-size: 89.8mm; block-size: 47.1mm; font-size: 12.2pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 102.6mm; inset-block-start: 21.6mm; inline-size: 99.4mm; block-size: 61.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 71.4mm; inline-size: 84.3mm; block-size: 13.3mm; font-size: 9.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 84.1mm; inline-size: 187.2mm; block-size: 9.0mm; font-size: 8.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 96.8mm; inline-size: 189.9mm; block-size: 4.8mm; font-size: 6.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 101.0mm; inline-size: 52.4mm; block-size: 34.4mm; font-size: 10.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 69.2mm; inset-block-start: 101.7mm; inline-size: 128.9mm; block-size: 140.2mm; font-size: 40.0pt"></div>
<header class="box" style="inset-inline-start: 5.5mm; inset-block-start: 107.9mm; inline-size: 3.9mm; block-size: 63.5mm; font-size: 40.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 139.2mm; inline-size: 45.9mm; block-size: 8.0mm; font-size: 11.4pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 150.9mm; inline-size: 52.5mm; block-size: 13.5mm; font-size: 12.8pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 167.9mm; inline-size: 51.2mm; block-size: 21.7mm; font-size: 12.3pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 268.1mm; inline-size: 4.1mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_10 }}</footer>
</div></body>
</html>
