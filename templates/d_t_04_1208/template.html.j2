<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 21.0mm; inset-block-start: 32.1mm; inline-size: 132.8mm; block-size: 6.9mm; font-size: 19.5pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 21.0mm; inset-block-start: 53.6mm; inline-size: 60.6mm; block-size: 4.2mm; font-size: 11.8pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 61.9mm; inline-size: 158.7mm; block-size: 34.6mm; font-size: 16.4pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 0.3mm; inset-block-start: 127.1mm; inline-size: 96.5mm; block-size: 143.6mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 102.9mm; inset-block-start: 132.7mm; inline-size: 76.4mm; block-size: 25.8mm; font-size: 12.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 102.9mm; inset-block-start: 170.2mm; inline-size: 76.4mm; block-size: 51.7mm; font-size: 12.2pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 102.9mm; inset-block-start: 228.0mm; inline-size: 76.2mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 102.9mm; inset-block-start: 241.3mm; inline-size: 76.3mm; block-size: 29.5mm; font-size: 12.0pt">{{ slot_6 }}</p>
</div></body>
</html>
