<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</ul>
</div>
<div id="right-column">
<h1>{{ slot_9 }}</h1>
<h2>{{ slot_10 }}</h2>
<h1>{{ slot_11 }}</h1>
<p>{{ slot_12 }}</p>
<h1>{{ slot_13 }}</h1>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>