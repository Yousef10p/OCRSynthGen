<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.menu {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #f8f8f8;
}

.menu ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

.menu li {
    float: right;
}

.menu li a {
    display: block;
    color: #666;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

.menu li:hover {
    background-color: #ddd;
}

.submenu-content, .subsubmenu-content {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 160px;
}

.subsubmenu-content {
    display: none;
}

.submenu:hover .submenu-content, .subsubmenu:hover .subsubmenu-content {
    display: block;
}

.rect {
    width: 300px;
    height: 150px;
    background-color: #ccc;
}

.product, .service {
    margin-top: 70px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu">
<ul>
<li>{{ slot_0 }}</li>
<li class="submenu">{{ slot_1 }}
                <ul class="submenu-content">
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</li>
<li class="subsubmenu">{{ slot_5 }}
                <ul class="subsubmenu-content">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
</ul>
</li>
</ul>
</div>
<div class="home">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
</div>
<div class="product">
<h2>{{ slot_11 }}</h2>
<div class="rect"></div>
<p>{{ slot_12 }}</p>
</div>
<div class="service">
<h2>{{ slot_13 }}</h2>
<div class="rect"></div>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>