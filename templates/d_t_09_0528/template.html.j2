<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 45.2mm; inset-block-start: 50.0mm; inline-size: 11.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 87.7mm; inset-block-start: 54.8mm; inline-size: 40.3mm; block-size: 14.4mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 69.6mm; inline-size: 8.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 57.6mm; inset-block-start: 80.9mm; inline-size: 120.7mm; block-size: 18.8mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 107.3mm; inline-size: 6.3mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 48.9mm; inset-block-start: 121.7mm; inline-size: 129.4mm; block-size: 24.7mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 154.0mm; inline-size: 41.3mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 99.9mm; inset-block-start: 161.8mm; inline-size: 78.5mm; block-size: 6.7mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 173.6mm; inline-size: 140.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 50.7mm; inset-block-start: 183.3mm; inline-size: 127.7mm; block-size: 59.9mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 43.3mm; inset-block-start: 253.6mm; inline-size: 135.0mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 292.7mm; inline-size: 3.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_6 }}</footer>
</div></body>
</html>
