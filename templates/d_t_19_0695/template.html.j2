<p class="box" style="inset-inline-start: 39.5mm; inset-block-start: 128.3mm; inline-size: 144.5mm; block-size: 11.3mm; font-size: 12.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 39.5mm; inset-block-start: 143.6mm; inline-size: 144.5mm; block-size: 11.6mm; font-size: 12.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 39.5mm; inset-block-start: 159.2mm; inline-size: 102.0mm; block-size: 6.0mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 168.7mm; inline-size: 152.1mm; block-size: 16.6mm; font-size: 12.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 187.2mm; inline-size: 152.1mm; block-size: 37.9mm; font-size: 12.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 227.0mm; inline-size: 152.1mm; block-size: 16.7mm; font-size: 12.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 31.9mm; inset-block-start: 257.7mm; inline-size: 45.7mm; block-size: 4.6mm; font-size: 10.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
