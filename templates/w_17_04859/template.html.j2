<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</div>
<div class="footer">
<h3>{{ slot_10 }}</h3>
<ul>
