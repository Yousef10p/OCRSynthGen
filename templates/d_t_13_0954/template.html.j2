<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 87.1mm; inset-block-start: 12.8mm; inline-size: 43.2mm; block-size: 28.5mm; font-size: 16.1pt"></div>
<p class="box" style="inset-inline-start: 139.7mm; inset-block-start: 18.6mm; inline-size: 49.8mm; block-size: 16.1mm; font-size: 11.4pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 18.9mm; inline-size: 59.7mm; block-size: 26.7mm; font-size: 10.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 91.3mm; inset-block-start: 42.8mm; inline-size: 37.3mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 81.0mm; inset-block-start: 49.4mm; inline-size: 56.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.3mm; inset-block-start: 74.5mm; inline-size: 28.6mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 90.0mm; inline-size: 98.9mm; block-size: 20.8mm; font-size: 14.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.0mm; inline-size: 17.8mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 126.4mm; inline-size: 165.9mm; block-size: 15.6mm; font-size: 14.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 147.1mm; inline-size: 57.4mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 25.9mm; inset-block-start: 172.2mm; inline-size: 38.3mm; block-size: 12.4mm; font-size: 17.6pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 185.1mm; inline-size: 40.1mm; block-size: 10.4mm; font-size: 14.7pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 107.0mm; inset-block-start: 274.7mm; inline-size: 2.3mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_10 }}</footer>
</div></body>
</html>
