    padding: 1rem;
    background: #f8f8f8;
}

.cta-button {
    background: #007BFF;
    color: white;
    padding: 1rem;
    text-decoration: none;
}

aside {
    background: #f8f8f8;
    padding: 1rem;
    flex: 1;
}

table {
    width: 100%;
}

th, td {
    border: 1px solid #ddd;
    padding: 1rem;
    text-align: right;
}

footer {
    background: #f8f8f8;
    padding: 1rem;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
