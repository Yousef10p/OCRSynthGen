<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 176.5mm; inline-size: 112.4mm; block-size: 7.3mm; font-size: 10.3pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 186.5mm; inline-size: 59.4mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_5 }}</li></ul>
