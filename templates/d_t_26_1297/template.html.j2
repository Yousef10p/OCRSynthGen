<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 149.1mm; inline-size: 65.6mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 156.6mm; inline-size: 50.8mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_1 }}</li></ul>
