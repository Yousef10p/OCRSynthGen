<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 25.6mm; inset-block-start: 25.4mm; inline-size: 151.9mm; block-size: 8.0mm; font-size: 11.3pt"><li>{{ slot_0 }}</li></ul>
<div class="box ph" style="inset-inline-start: 30.9mm; inset-block-start: 36.6mm; inline-size: 116.4mm; block-size: 120.5mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 157.3mm; inline-size: 56.3mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 25.6mm; inset-block-start: 165.3mm; inline-size: 120.1mm; block-size: 4.0mm; font-size: 11.4pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.6mm; inset-block-start: 171.3mm; inline-size: 164.5mm; block-size: 8.2mm; font-size: 11.7pt"><li>{{ slot_3 }}</li></ul>
<div class="box ph" style="inset-inline-start: 31.1mm; inset-block-start: 183.0mm; inline-size: 143.8mm; block-size: 50.8mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 234.0mm; inline-size: 71.9mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 263.1mm; inline-size: 128.2mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 188.8mm; inset-block-start: 263.1mm; inline-size: 1.8mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
