}
header nav ul li a {
    color: #fff;
    text-decoration: none;
}
header form input {
    margin-right: 20px;
}
.slider {
    display: flex;
    overflow-x: auto;
    padding: 10px;
}
.slide {
    background-color: #ddd;
    border: 1px solid #999;
    flex-shrink: 0;
    height: 200px;
    margin-left: 10px;
    padding: 10px;
    width: 300px;
}
main {
    padding: 20px;
}
