<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 53.9mm; inset-block-start: 0.7mm; inline-size: 38.4mm; block-size: 10.5mm; font-size: 29.7pt">{{ slot_0 }}</h2>
<ul class="box" style="inset-inline-start: 8.3mm; inset-block-start: 19.1mm; inline-size: 132.9mm; block-size: 4.4mm; font-size: 12.4pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 13.0mm; inset-block-start: 25.1mm; inline-size: 117.9mm; block-size: 8.2mm; font-size: 7.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 13.0mm; inset-block-start: 32.7mm; inline-size: 122.4mm; block-size: 4.4mm; font-size: 5.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 13.0mm; inset-block-start: 36.5mm; inline-size: 49.0mm; block-size: 4.4mm; font-size: 5.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 13.0mm; inset-block-start: 40.3mm; inline-size: 125.5mm; block-size: 8.2mm; font-size: 7.7pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 49.8mm; inline-size: 128.3mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 9.8mm; inset-block-start: 59.7mm; inline-size: 130.1mm; block-size: 116.9mm; font-size: 15.1pt"></div>
</div></body>
</html>
