<div class="item-image ph"></div>
<p>{{ slot_8 }}</p>
<button class="add-to-cart">{{ slot_9 }}</button>
</div>
<div class="item">
<h2>{{ slot_10 }}</h2>
<div class="item-image ph"></div>
<p>{{ slot_11 }}</p>
<button class="add-to-cart">{{ slot_12 }}</button>
</div>
</div>
<div class="cart" id="cart">
<h2>{{ slot_13 }}</h2>
<ul id="cart-items"></ul>
<button id="checkout">{{ slot_14 }}</button>
