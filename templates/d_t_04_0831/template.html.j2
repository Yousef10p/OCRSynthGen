<p class="box" style="inset-inline-start: 126.4mm; inset-block-start: 96.4mm; inline-size: 50.9mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 48.8mm; inset-block-start: 125.6mm; inline-size: 55.3mm; block-size: 12.6mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 128.1mm; inset-block-start: 127.9mm; inline-size: 46.7mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 51.1mm; inset-block-start: 157.1mm; inline-size: 49.8mm; block-size: 12.6mm; font-size: 11.9pt">{{ slot_6 }}</p>
