<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 62.8mm; inset-block-start: 13.1mm; inline-size: 136.9mm; block-size: 43.1mm; font-size: 17.5pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 12.5mm; inset-block-start: 55.2mm; inline-size: 37.8mm; block-size: 42.6mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 62.8mm; inset-block-start: 60.0mm; inline-size: 136.9mm; block-size: 43.1mm; font-size: 17.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 100.7mm; inline-size: 35.0mm; block-size: 15.4mm; font-size: 10.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 62.8mm; inset-block-start: 106.9mm; inline-size: 136.9mm; block-size: 36.4mm; font-size: 17.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 62.8mm; inset-block-start: 147.1mm; inline-size: 136.9mm; block-size: 29.7mm; font-size: 16.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 62.8mm; inset-block-start: 180.6mm; inline-size: 136.9mm; block-size: 36.4mm; font-size: 17.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 62.8mm; inset-block-start: 220.8mm; inline-size: 136.9mm; block-size: 36.4mm; font-size: 17.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 13.1mm; inset-block-start: 269.2mm; inline-size: 1.5mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_7 }}</footer>
</div></body>
</html>
