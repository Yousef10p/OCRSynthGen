<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.navigation {
    background-color: #f8f8f8;
    padding: 20px;
    text-align: center;
}

.navigation ul {
    list-style-type: none;
}

.navigation li {
    display: inline;
    margin: 0 10px;
}

.main-image {
    width: 100%;
    height: 500px;
    background-color: #ddd;
    text-align: center;
    padding-top: 150px;
}

.item-container {
    display: flex;
    justify-content: space-around;
    padding: 50px;
}

.item {
    background-color: #f8f8f8;
    padding: 20px;
    width: 30%;
    margin: 10px;
}

.category-container {
    display: flex;
    justify-content: space-around;
    padding: 50px;
}

.category {
    width: 20%;
    background-color: #f8f8f8;
    padding: 20px;
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navigation">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="main-image">{{ slot_5 }}</div>
<div class="item-container">
<div class="item">{{ slot_6 }}</div>
<div class="item">{{ slot_7 }}</div>
<div class="item">{{ slot_8 }}</div>
<div class="item">{{ slot_9 }}</div>
<div class="item">{{ slot_10 }}</div>
<div class="item">{{ slot_11 }}</div>
</div>
<div class="category-container">
<div class="category">{{ slot_12 }}</div>
<div class="category">{{ slot_13 }}</div>
<div class="category">{{ slot_14 }}</div>
<div class="category">{{ slot_15 }}</div>
<div class="category">{{ slot_16 }}</div>
</div>
</body>
</html>