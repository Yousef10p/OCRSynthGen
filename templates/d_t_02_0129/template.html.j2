<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 73.9mm; inset-block-start: 15.3mm; inline-size: 23.9mm; block-size: 2.2mm; font-size: 7.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 155.1mm; inset-block-start: 15.1mm; inline-size: 39.1mm; block-size: 2.4mm; font-size: 7.0pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 21.0mm; inset-block-start: 44.8mm; inline-size: 33.2mm; block-size: 3.2mm; font-size: 10.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 49.2mm; inline-size: 85.9mm; block-size: 55.5mm; font-size: 10.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 110.2mm; inline-size: 84.6mm; block-size: 16.3mm; font-size: 10.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 21.0mm; inset-block-start: 132.0mm; inline-size: 38.7mm; block-size: 3.2mm; font-size: 10.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 136.3mm; inline-size: 85.9mm; block-size: 33.8mm; font-size: 10.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 175.6mm; inline-size: 83.5mm; block-size: 7.6mm; font-size: 10.3pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 1.7mm; inset-block-start: 217.7mm; inline-size: 100.9mm; block-size: 47.4mm; font-size: 14.9pt"></div>
</div></body>
</html>
