<div class="product-image ph"></div>
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
</div>
<div class="product">
<div class="product-image ph"></div>
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</div>
</div>
</section>
<section id="sidebar">
