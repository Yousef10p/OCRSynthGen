<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  color: #333;
}

nav {
  display: flex;
  justify-content: space-between;
  padding: 1em;
  background-color: #f8f8f8;
}

nav form {
  display: flex;
}

nav form input[type="text"] {
  padding: 0.5em;
  border: 1px solid #ddd;
}

nav form button {
  padding: 0.5em;
  border: 1px solid #ddd;
  cursor: pointer;
}

header div:first-child {
  height: 50vh;
}

header div:first-child p {
  padding: 2em;
  color: #fff;
}

section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 1em;
}

section div:first-child div {
  height: 20vh;
  margin-bottom: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div> 
<form> 
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<button>{{ slot_1 }}</button>
</form>
</nav>
<div> 
<h1>{{ slot_2 }}</h1>
<p>{{ slot_3 }}</p>
</div>
<div> 
<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
</div>
</header>
<section>
<div> 
<div style="background-color: red;"> <p>{{ slot_8 }}</p> </div>
<div style="background-color: green;"> <p>{{ slot_9 }}</p> </div>
<div style="background-color: yellow;"> <p>{{ slot_10 }}</p> </div>
</div>
<div> 
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</section>
</body>
</html>