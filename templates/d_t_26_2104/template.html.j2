<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 161.8mm; inset-block-start: 26.6mm; inline-size: 28.8mm; block-size: 12.0mm; font-size: 33.9pt"></div>
<div class="box ph" style="inset-inline-start: 24.7mm; inset-block-start: 40.8mm; inline-size: 46.5mm; block-size: 10.4mm; font-size: 14.7pt"></div>
<h1 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 60.5mm; inline-size: 154.9mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_0 }}</h1>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 67.5mm; inline-size: 59.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 75.5mm; inline-size: 163.1mm; block-size: 20.0mm; font-size: 11.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 99.5mm; inline-size: 160.3mm; block-size: 28.0mm; font-size: 11.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 131.5mm; inline-size: 159.9mm; block-size: 16.0mm; font-size: 11.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 151.5mm; inline-size: 89.7mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 25.4mm; inset-block-start: 159.5mm; inline-size: 80.3mm; block-size: 65.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 224.7mm; inline-size: 72.9mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 263.1mm; inline-size: 73.1mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 188.7mm; inset-block-start: 263.1mm; inline-size: 1.8mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
