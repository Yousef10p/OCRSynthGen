<p class="box" style="inset-inline-start: 135.5mm; inset-block-start: 93.5mm; inline-size: 48.5mm; block-size: 25.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 80.9mm; inset-block-start: 99.8mm; inline-size: 49.3mm; block-size: 85.2mm; font-size: 12.7pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 21.1mm; inset-block-start: 101.6mm; inline-size: 42.9mm; block-size: 28.6mm; font-size: 16.2pt"><li>{{ slot_6 }}</li></ul>
