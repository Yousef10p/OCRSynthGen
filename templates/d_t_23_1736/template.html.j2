<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 91.8mm; inset-block-start: 20.0mm; inline-size: 30.4mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 63.3mm; inset-block-start: 25.1mm; inline-size: 4.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 145.7mm; inset-block-start: 25.3mm; inline-size: 4.9mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 27.3mm; inset-block-start: 30.0mm; inline-size: 77.0mm; block-size: 9.4mm; font-size: 8.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.2mm; inset-block-start: 30.6mm; inline-size: 14.4mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 115.8mm; inset-block-start: 33.5mm; inline-size: 64.1mm; block-size: 227.3mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 27.3mm; inset-block-start: 40.0mm; inline-size: 77.0mm; block-size: 22.7mm; font-size: 9.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 27.3mm; inset-block-start: 63.4mm; inline-size: 77.2mm; block-size: 16.0mm; font-size: 9.1pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 33.4mm; inset-block-start: 86.8mm; inline-size: 66.6mm; block-size: 174.6mm; font-size: 38.1pt"></div>
</div></body>
</html>
