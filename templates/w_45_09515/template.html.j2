<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  background-color: #f4f4f4;
}

#header {
  background-color: #333;
  color: #fff;
  padding: 10px;
  text-align: center;
}

#header nav ul {
  list-style: none;
}

#header nav ul li {
  display: inline;
  margin: 0 10px;
}

#header nav ul li a {
  color: #fff;
  text-decoration: none;
}

#main {
  margin: auto;
  width: 80%;
  padding: 10px;
  text-align: center;
}

#main h1 {
  font-size: 2em;
  margin-bottom: 20px;
}

#main ul {
  list-style: none;
  text-align: right;
  margin: 0 auto;
  width: 60%;
}

#main ul li {
  margin: 10px 0;
}

.cta {
  display: block;
  width: 200px;
  margin: 20px auto;
  padding: 10px;
  background-color: #333;
  color: #fff;
  text-align: center;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</div>
<section id="main">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<h2>{{ slot_6 }}</h2>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
<h2>{{ slot_11 }}</h2>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
</ul>
<a class="cta">{{ slot_16 }}</a>
</section>
</body>
</html>