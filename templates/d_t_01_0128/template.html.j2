<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 156.5mm; inline-size: 108.3mm; block-size: 31.0mm; font-size: 17.6pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 192.9mm; inline-size: 66.0mm; block-size: 70.4mm; font-size: 15.4pt"></div>
