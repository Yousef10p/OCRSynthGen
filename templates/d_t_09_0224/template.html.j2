<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 89.7mm; inset-block-start: 25.2mm; inline-size: 36.7mm; block-size: 40.2mm; font-size: 14.2pt"></div>
<p class="box" style="inset-inline-start: 66.4mm; inset-block-start: 69.0mm; inline-size: 83.2mm; block-size: 8.7mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 90.7mm; inline-size: 46.7mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 102.6mm; inline-size: 165.1mm; block-size: 12.0mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 66.8mm; inset-block-start: 123.5mm; inline-size: 82.5mm; block-size: 7.4mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 66.5mm; inset-block-start: 134.2mm; inline-size: 82.8mm; block-size: 6.6mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 66.8mm; inset-block-start: 144.1mm; inline-size: 72.4mm; block-size: 7.4mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 66.5mm; inset-block-start: 154.8mm; inline-size: 73.6mm; block-size: 6.6mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 177.4mm; inline-size: 165.1mm; block-size: 11.2mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 197.1mm; inline-size: 165.1mm; block-size: 18.9mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 76.4mm; inset-block-start: 225.7mm; inline-size: 63.1mm; block-size: 4.3mm; font-size: 10.9pt"></div>
<footer class="box" style="inset-inline-start: 106.0mm; inset-block-start: 261.9mm; inline-size: 3.8mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_5 }}</footer>
</div></body>
</html>
