<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 71.1mm; inset-block-start: 126.6mm; inline-size: 63.0mm; block-size: 7.8mm; font-size: 22.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 29.5mm; inset-block-start: 170.3mm; inline-size: 141.1mm; block-size: 16.9mm; font-size: 40.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 14.9mm; inset-block-start: 227.7mm; inline-size: 34.0mm; block-size: 33.4mm; font-size: 15.8pt"></div>
<div class="box ph" style="inset-inline-start: 59.6mm; inset-block-start: 227.7mm; inline-size: 33.6mm; block-size: 33.7mm; font-size: 15.9pt"></div>
<div class="box ph" style="inset-inline-start: 106.1mm; inset-block-start: 227.9mm; inline-size: 34.2mm; block-size: 33.6mm; font-size: 15.9pt"></div>
<div class="box ph" style="inset-inline-start: 151.0mm; inset-block-start: 227.6mm; inline-size: 34.2mm; block-size: 33.7mm; font-size: 15.9pt"></div>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 270.7mm; inline-size: 30.1mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 62.5mm; inset-block-start: 270.7mm; inline-size: 28.7mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 109.2mm; inset-block-start: 270.7mm; inline-size: 28.3mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 153.0mm; inset-block-start: 270.5mm; inline-size: 35.3mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_5 }}</p>
</div></body>
</html>
