<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 11.3mm; inset-block-start: 20.0mm; inline-size: 62.7mm; block-size: 8.0mm; font-size: 9.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 31.1mm; inline-size: 89.1mm; block-size: 69.3mm; font-size: 11.8pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 105.1mm; inset-block-start: 30.9mm; inline-size: 56.2mm; block-size: 4.6mm; font-size: 11.8pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 105.1mm; inset-block-start: 39.3mm; inline-size: 89.1mm; block-size: 64.2mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 10.8mm; inset-block-start: 100.6mm; inline-size: 88.4mm; block-size: 87.1mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 105.3mm; inset-block-start: 103.7mm; inline-size: 88.8mm; block-size: 69.0mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 105.2mm; inset-block-start: 172.9mm; inline-size: 87.7mm; block-size: 41.8mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 10.8mm; inset-block-start: 188.4mm; inline-size: 87.9mm; block-size: 73.1mm; font-size: 11.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 105.4mm; inset-block-start: 215.1mm; inline-size: 88.4mm; block-size: 47.1mm; font-size: 11.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 98.3mm; inset-block-start: 265.0mm; inline-size: 6.8mm; block-size: 3.9mm; font-size: 9.9pt">{{ slot_9 }}</footer>
</div></body>
</html>
