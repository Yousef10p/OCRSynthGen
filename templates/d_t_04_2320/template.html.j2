<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 21.2mm; inset-block-start: 19.2mm; inline-size: 30.4mm; block-size: 6.8mm; font-size: 19.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 45.8mm; inset-block-start: 40.1mm; inline-size: 32.3mm; block-size: 24.3mm; font-size: 17.2pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 38.4mm; inset-block-start: 90.2mm; inline-size: 150.1mm; block-size: 17.3mm; font-size: 24.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 119.1mm; inline-size: 155.9mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 139.2mm; inline-size: 152.7mm; block-size: 9.0mm; font-size: 12.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 158.1mm; inline-size: 154.7mm; block-size: 27.1mm; font-size: 12.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 187.2mm; inline-size: 152.9mm; block-size: 13.5mm; font-size: 12.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 210.7mm; inline-size: 155.0mm; block-size: 13.5mm; font-size: 12.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 234.1mm; inline-size: 157.9mm; block-size: 22.6mm; font-size: 12.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 199.5mm; inset-block-start: 268.4mm; inline-size: 4.1mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
