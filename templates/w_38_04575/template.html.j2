  width: 80px;
  height: 80px;
  background-color: darkblue;
}

.nav-menu {
  width: 100%;
  background-color: lightblue;
  padding: 20px 0;
  text-align: center;
}

.nav-menu ul {
  list-style-type: none;
}

.nav-menu ul li {
