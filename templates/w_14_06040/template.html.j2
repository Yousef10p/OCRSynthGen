}

.logo {
   display: inline-block;
   font-size: 2em;
   padding: 10px 20px;
   text-transform: uppercase;
}

nav ul {
   margin: 0;
   padding: 0;
   list-style: none;
}

nav li {
   float: right;
   width: 20%;
   position: relative;
}

nav li a {
   display: block;
   padding: 10px 20px;
   color: #333;
   text-decoration: none;
}

nav li ul {
   display: none;
   position: absolute;
   width: 200px;
}

nav li:hover ul {
   display: block;
}

nav li ul li {
   clear: both;
   width: 100%;
}

.content {
   margin-top: 60px;
}

.rectangle {
   height: 200px;
   width: 100%;
   background-color: #f00;
}

h1, h2 {
   text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
