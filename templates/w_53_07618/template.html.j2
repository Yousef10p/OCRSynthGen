}

.description-container {
    display: flex;
    justify-content: space-around;
    text-align: center;
    padding: 40px;
}

.description-text {
    flex-basis: 30%;
}

.reservation-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
}

.reservation-form input {
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
