    padding: 0;
    box-sizing: border-box;
    background-color: #f2f2f2;
    color: #333;
}

.hero-image {
    background-image: none;
    width: 100%;
    height: 500px;
    background-size: cover;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
}

.menu-container {
    display: flex;
