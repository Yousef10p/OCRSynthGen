<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}


.logo-container {
  text-align: right;
  display: flex;
  align-items: center;
  padding: 20px;
  height: 80px;
  background-color: #f5f5f5;
}

#logo-image {
  height: 60px;
  width: auto;
}


.search-bar {
  display: flex;
  align-items: center;
  padding: 10px 20px;
  background-color: #f5f5f5;
  border-bottom: 1px solid #ddd;
}

.search-bar input[type="text"] {
  flex-grow: 1;
  height: 30px;
  margin-left: 10px;
}

.search-bar input[type="submit"] {
  height: 34px;
  width: 70px;
}


.playlist {
  float: right;
  width: 25%;
  padding: 20px;
  background-color: #f5f5f5;
}

.playlist ul {
  list-style-type: none;
  padding: 0;
  margin: 0;
}

.playlist li {
  padding: 10px 0;
  border-bottom: 1px solid #ddd;
  display: flex;
  align-items: center;
}

.playlist .play-button {
  margin-left: 10px;
}

.playlist .song-info h3, .playlist .song-info p {
  margin: 0;
}

.playlist .view-more {
  text-decoration: underline;
}


.featured-content {
  float: left;
  width: 75%;
  padding: 20px;
}

.featured-item {
  border: 1px solid #ddd;
  padding: 10px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
}

.featured-item img {
  height: 100px;
  width: auto;
  margin-left: 10px;
}

.featured-item h3, .featured-item p {
  margin: 0;
}

.featured-item .view-more {
  margin-right: auto;
  text-decoration: underline;
}


@media screen and (max-width: 600px) {
  .playlist, .featured-content {
    width: 100%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

<div class="logo-container ph"></div>

<form class="search-bar">
