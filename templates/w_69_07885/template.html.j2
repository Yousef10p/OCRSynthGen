<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #333;
}

header {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 20px;
    background: linear-gradient(to left, #f70, #ffd300);
}

.logo {
    width: 150px;
    height: 100px;
    position: absolute;
    right: 50%;
    transform: translateX(50%);
}

nav ul {
    display: flex;
    list-style-type: none;
    justify-content: space-around;
    width: 50%;
}

nav ul li a {
    text-decoration: none;
    color: #333;
    font-weight: bold;
    transition: all 0.3s ease;
}

nav ul li a:hover {
    color: #f70;
}

section {
    padding: 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

section h1 {
    font-size: 2em;
    margin-bottom: 30px;
}

form {
    display: flex;
    flex-direction: column;
    width: 60%;
}

form label {
    font-size: 1.2em;
    margin-bottom: 10px;
}

form input, form textarea {
    margin-bottom: 20px;
    padding: 10px;
    font-size: 1em;
}

form input[type=submit], form input[type=submit]:hover {
    background: #f70;
    color: #fff;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
