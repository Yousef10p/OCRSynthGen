    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

header, nav, section, footer {
    width: 80%;
    padding: 1em;
    margin-bottom: 1em;
}

header {
    background: lightgray;
    text-align: center;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-left: 1em;
}

section {
    display: flex;
    justify-content: space-between;
}

.portfolio-item, .service-item, .testimonial-item {
    border: 1px solid black;
    background: lightblue;
    padding: 1em;
    margin-bottom: 1em;
}

footer {
    background: lightgray;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
