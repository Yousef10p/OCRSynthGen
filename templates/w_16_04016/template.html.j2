.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #007BFF;
  color: white;
  padding: 10px;
}

nav a {
  color: white;
  margin-right: 20px;
}

main {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  padding: 20px;
}

main > h2 {
  font-weight: bold;
  margin-top: 20px;
}

.image-donate,
.image-mission,
.image-impact {
  background-color: lightblue;
  height: 200px;
}

footer {
  background-color: black;
  color: white;
  text-align: center;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
