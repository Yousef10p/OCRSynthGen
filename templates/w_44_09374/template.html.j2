<li class="navIcon" id="icon2">{{ slot_1 }}</li>
<li class="navIcon" id="icon3">{{ slot_2 }}</li>
<li class="navIcon" id="icon4">{{ slot_3 }}</li>
<li class="navIcon" id="icon5">{{ slot_4 }}</li>
</ul>
</nav>
<main>
<h1>{{ slot_5 }}</h1>
<div class="products">
<div class="product" id="product1">{{ slot_6 }}</div>
<div class="product" id="product2">{{ slot_7 }}</div>
<div class="product" id="product3">{{ slot_8 }}</div>
<div class="product" id="product4">{{ slot_9 }}</div>
<div class="product" id="product5">{{ slot_10 }}</div>
<div class="product" id="product6">{{ slot_11 }}</div>
<div class="product" id="product7">{{ slot_12 }}</div>
<div class="product" id="product8">{{ slot_13 }}</div>
<div class="product" id="product9">{{ slot_14 }}</div>
</div>
</main>
</header></body>
</html>