<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

.container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.logo {
    position: absolute;
    top: 20px;
    right: 50%;
    transform: translateX(50%);
    font-size: 2em;
    text-align: center;
}

.navigation {
    position: absolute;
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
    list-style-type: none;
    font-size: 1.5em;
    text-align: center;
}

.content {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    display: flex;
    width: 60%;
    justify-content: space-between;
}

.product-category {
    width: 20%;
    text-align: center;
}

.product-image {
    background-color: #123456; 
    height: 40vh;
    width: 100%;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="logo">{{ slot_0 }}</div>
<div class="navigation">
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</div>
<div class="content">
<div class="product-category">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>

<div class="product-image">{{ slot_7 }}</div>
</div>
<div class="product-category">
<h1>{{ slot_8 }}</h1>
<p>{{ slot_9 }}</p>

<div class="product-image">{{ slot_10 }}</div>
</div>
<div class="product-category">
<h1>{{ slot_11 }}</h1>
<p>{{ slot_12 }}</p>

<div class="product-image">{{ slot_13 }}</div>
</div>
<div class="product-category">
<h1>{{ slot_14 }}</h1>
<p>{{ slot_15 }}</p>

<div class="product-image">{{ slot_16 }}</div>
</div>
</div>
</div>
</body>
</html>