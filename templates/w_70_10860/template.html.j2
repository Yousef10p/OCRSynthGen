<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

@media (max-width: 600px) {
    
    header {
        background: linear-gradient(to left, red, blue);
    }

    nav {
        display: flex;
        flex-direction: column;
    }

    .destination {
        width: calc(50% - 10px);
        height: 100px;
        float: right;
        margin: 5px;
        background-color: grey;
    }

    .call-to-action {
        display: block;
        width: 100%;
        padding: 10px;
        text-align: center;
        background-color: gold;
    }

    footer {
        padding: 10px;
        background: linear-gradient(to left, green, purple);
        position: fixed;
        bottom: 0;
        width: 100%;
    }
}

@media (min-width: 601px) and (max-width: 1024px) {
    
    header {
        background: linear-gradient(to left, yellow, orange);
    }

    nav {
        display: flex;
        justify-content: space-between;
    }

    .destination {
        width: calc(33.33% - 10px);
        height: 150px;
        float: right;
        margin: 5px;
        background-color: grey;
    }

    footer {
        padding: 20px;
        background: linear-gradient(to left, blue, green);
        position: fixed;
        bottom: 0;
        width: 100%;
    }
}

@media (min-width: 1025px) {
    
    header {
        background: linear-gradient(to left, green, blue);
    }

    nav {
        display: flex;
        justify-content: space-between;
    }

    .destination {
        width: calc(20% - 10px);
        height: 200px;
        float: right;
        margin: 5px;
        background-color: grey;
    }

    footer {
        padding: 20px;
        background: linear-gradient(to left, purple, yellow);
        position: fixed;
        bottom: 0;
        width: 100%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</ul>
</nav>
</header>

<a class="call-to-action">{{ slot_5 }}</a>

<section class="destinations">
<div class="destination"><p>{{ slot_6 }}</p><p>{{ slot_7 }}</p></div>
<div class="destination"><p>{{ slot_8 }}</p><p>{{ slot_9 }}</p></div>
<div class="destination"><p>{{ slot_10 }}</p><p>{{ slot_11 }}</p></div>
<div class="destination"><p>{{ slot_12 }}</p><p>{{ slot_13 }}</p></div>
</section>

<footer>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
<p>{{ slot_17 }}</p>
<p>{{ slot_18 }}</p>
</footer>
</body>
</html>