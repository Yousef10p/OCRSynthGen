<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    height: 100%;
}

h1, h2, p {
    text-align: center;
}

header, footer {
    background: #f8f8f8;
    padding: 20px;
}

.sidebar {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 200px;
    background: #f0f0f0;
}

.slideshow {
    text-align: center;
    height: 50%;
}

.slideshow .slide, .products .product {
    width: 200px;
    height: 200px;
    display: inline-block;
    margin: 10px;
}

.products {
    position: absolute;
    top: 50%;
    left: 0;
    bottom: 0;
    width: calc(100% - 200px);
    background: #f0f0f0;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    left: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
</header>
<section class="sidebar">
<h2>{{ slot_1 }}</h2>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</section>
<main>
<section class="slideshow">
<div class="slide" style="background: red;">{{ slot_5 }}</div>
<div class="slide" style="background: green;">{{ slot_6 }}</div>
<div class="slide" style="background: blue;">{{ slot_7 }}</div>
</section>
<section class="products">
<h2>{{ slot_8 }}</h2>
<div class="product" style="background: pink;">{{ slot_9 }}</div>
<div class="product" style="background: yellow;">{{ slot_10 }}</div>
<div class="product" style="background: orange;">{{ slot_11 }}</div>
</section>
</main>
<footer>
<h2>{{ slot_12 }}</h2>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</footer>
</body>
</html>