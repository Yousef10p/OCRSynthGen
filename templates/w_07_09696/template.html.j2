<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  color: #333;
}

a {
  text-decoration: none;
  color: #333;
}

header {
  background: #f4f4f4;
  padding: 10px;
  position: relative;
}

nav ul {
  display: flex;
  list-style: none;
}

nav ul li {
  padding: 0 10px;
}

nav ul li:hover {
  background: #ddd;
}

section {
  padding: 20px;
}

#hero {
  height: 400px;
  background: none no-repeat center center/cover;
  color: #fff;
  text-align: center;
  padding-top: 100px;
}

.hero-text h1,
.hero-text p {
  background: rgba(0,0,0,0.7);
  padding: 10px;
}

.product, .service {
  display: inline-block;
  width: 30%;
  margin: 15px;
  padding: 10px;
  vertical-align: top;
  transition: transform .2s;
}

.product:hover, .service:hover {
  transform: scale(1.1);
}

#hero-image, .product-image {
  height: 200px;
  width: 100%;
  background: #333;
}

footer {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 20px;
  position: absolute;
  width: 100%;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
