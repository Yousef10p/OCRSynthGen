}

#listings {
    width: 600px;
    float: left;
}

#footer {
    clear: both;
    text-align: center;
    padding: 10px;
    background: #f8f8f8;
    margin-top: 20px;
}


#listings ul li:before {
    content: "";
    display: inline-block;
    height: 100px;
    width: 100px;
    margin-left: 10px;
    background: #f8f8f8;
    border: 1px solid #ccc;
}
form input, form textarea, form button {
    width: 100%;
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
}
form button {
    background: #007bff;
    color: white;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
