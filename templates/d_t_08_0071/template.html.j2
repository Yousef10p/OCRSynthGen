<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 19.9mm; inset-block-start: 26.4mm; inline-size: 183.9mm; block-size: 127.5mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 47.5mm; inset-block-start: 157.5mm; inline-size: 127.2mm; block-size: 10.5mm; font-size: 9.9pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 46.1mm; inset-block-start: 184.0mm; inline-size: 128.3mm; block-size: 10.8mm; font-size: 30.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 201.8mm; inline-size: 84.7mm; block-size: 24.2mm; font-size: 11.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 116.2mm; inset-block-start: 201.8mm; inline-size: 82.6mm; block-size: 28.4mm; font-size: 11.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 230.4mm; inline-size: 82.0mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 116.2mm; inset-block-start: 234.7mm; inline-size: 82.2mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 33.3mm; inset-block-start: 268.9mm; inline-size: 38.3mm; block-size: 3.1mm; font-size: 8.6pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 193.9mm; inset-block-start: 269.0mm; inline-size: 2.0mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_7 }}</footer>
</div></body>
</html>
