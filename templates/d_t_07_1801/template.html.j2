<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 93.7mm; inset-block-start: 29.0mm; inline-size: 101.0mm; block-size: 23.2mm; font-size: 32.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 86.3mm; inset-block-start: 61.4mm; inline-size: 100.6mm; block-size: 21.6mm; font-size: 20.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 62.7mm; inset-block-start: 89.3mm; inline-size: 133.4mm; block-size: 36.0mm; font-size: 14.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 121.9mm; inline-size: 33.0mm; block-size: 33.0mm; font-size: 15.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 62.7mm; inset-block-start: 129.5mm; inline-size: 133.1mm; block-size: 20.1mm; font-size: 14.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 62.7mm; inset-block-start: 153.9mm; inline-size: 132.8mm; block-size: 14.9mm; font-size: 14.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 62.7mm; inset-block-start: 169.7mm; inline-size: 62.1mm; block-size: 51.9mm; font-size: 14.7pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 127.9mm; inset-block-start: 173.9mm; inline-size: 88.0mm; block-size: 94.1mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 44.6mm; inset-block-start: 242.5mm; inline-size: 76.2mm; block-size: 16.1mm; font-size: 15.2pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 5.5mm; inset-block-start: 269.2mm; inline-size: 1.7mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
