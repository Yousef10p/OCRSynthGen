<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 24.0mm; inset-block-start: 41.2mm; inline-size: 38.4mm; block-size: 2.0mm; font-size: 5.8pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 70.6mm; inset-block-start: 61.5mm; inline-size: 42.7mm; block-size: 16.1mm; font-size: 15.2pt"></div>
<h2 class="box" style="inset-inline-start: 22.9mm; inset-block-start: 91.6mm; inline-size: 87.1mm; block-size: 2.0mm; font-size: 5.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 95.8mm; inline-size: 138.4mm; block-size: 29.2mm; font-size: 10.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 126.8mm; inline-size: 137.8mm; block-size: 13.7mm; font-size: 9.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 142.3mm; inline-size: 137.8mm; block-size: 33.1mm; font-size: 10.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 177.2mm; inline-size: 138.4mm; block-size: 37.0mm; font-size: 10.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 216.0mm; inline-size: 138.4mm; block-size: 9.9mm; font-size: 9.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 11.4mm; inset-block-start: 237.4mm; inline-size: 2.1mm; block-size: 1.7mm; font-size: 5.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
