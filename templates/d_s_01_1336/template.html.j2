<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 166.6mm; inset-block-start: 12.8mm; inline-size: 20.5mm; block-size: 11.0mm; font-size: 15.6pt"></div>
<header class="box" style="inset-inline-start: 27.2mm; inset-block-start: 15.3mm; inline-size: 68.8mm; block-size: 5.9mm; font-size: 16.8pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 36.7mm; inline-size: 153.4mm; block-size: 10.2mm; font-size: 14.5pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 106.3mm; inset-block-start: 54.5mm; inline-size: 75.1mm; block-size: 120.1mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 29.8mm; inset-block-start: 71.3mm; inline-size: 63.4mm; block-size: 103.0mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 125.2mm; inset-block-start: 191.5mm; inline-size: 64.3mm; block-size: 53.4mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 195.3mm; inline-size: 94.3mm; block-size: 32.4mm; font-size: 15.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 232.1mm; inline-size: 93.4mm; block-size: 15.8mm; font-size: 14.9pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 101.4mm; inset-block-start: 262.6mm; inline-size: 8.5mm; block-size: 8.4mm; font-size: 11.9pt">{{ slot_4 }}</footer>
</div></body>
</html>
