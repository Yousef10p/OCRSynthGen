}

.about, .contact {
  padding: 50px 0;
  background-color: #eee;
}

.about p, .contact p {
  line-height: 24px;
}

button {
  padding: 10px 20px;
  background-color: #333;
  color: #fff;
  border: none;
  cursor: pointer;
}

@media screen and (max-width: 600px) {
  .header, .hero, .courses, .about, .contact {
    width: 100%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
