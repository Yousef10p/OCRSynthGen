<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 177.4mm; inline-size: 86.8mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 181.0mm; inline-size: 60.8mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_5 }}</h2>
