<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
  background-color: #f1f1f1;
  font-family: var(--font-body);
}

.container{
  display: flex;
  justify-content: space-between;
  width: 80%;
  height: 90%;
}

.left-column, .right-column {
  border: 1px solid #ccc;
  background-color: #fff;
  padding: 20px;
  width: 30%;
  height: 100%;
}

h3 {
  margin-bottom: 10px;
}

hr {
  border: none;
  border-top: 1px solid #ccc;
  margin: 10px 0;
}

ul {
  list-style-type: none;
  padding: 0;
  margin: 10px 0;
}

li {
  margin-bottom: 5px;
}

.featured-product{
  height: 200px;
  background-color: #bbb;
  margin-bottom: 20px;
  text-align: center;
  line-height: 200px;
  color: #fff;
}

.footer {
  position: fixed;
  right: 0;
  bottom: 0;
  width: 100%;
  background-color: #555;
  color: white;
  text-align: center;
  padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="left-column">
<h3>{{ slot_0 }}</h3>
<hr>
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ul>
<h3>{{ slot_4 }}</h3>
<hr>
<p>{{ slot_5 }}</p>
<ul>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
</ul>
</div>
<div class="right-column">
<h3>{{ slot_9 }}</h3>
<hr>
<div class="featured-product">{{ slot_10 }}</div>
<h3>{{ slot_11 }}</h3>
<hr>
<p>{{ slot_12 }}</p>
<ul>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</div>
</div>
<div class="footer">
<h3>{{ slot_15 }}</h3>
<hr>
<p>{{ slot_16 }}</p>
</div>
</body>
</html>