    color: #fff;
}

nav ul {
    margin: 0;
    padding: 0;
    list-style-type: none;
}

nav li {
    display: inline-block;
    padding: 1em;
}

aside {
    position: fixed;
    right: 0;
    bottom: 0;
    top: 2em;
    width: 200px;
    background: #eee;
}

main {
    margin-right: 220px;
    margin-top: 4em;
}

section {
    margin-bottom: 2em;
}


section::before {
    content: "";
    display: inline-block;
    height: 200px;
    width: 100%;
    margin-bottom: 1em;
    background: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
