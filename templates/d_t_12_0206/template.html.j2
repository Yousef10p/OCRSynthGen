<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 196.5mm; inset-block-start: 10.4mm; inline-size: 1.8mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 21.9mm; inset-block-start: 17.7mm; inline-size: 80.1mm; block-size: 73.6mm; font-size: 14.9pt"></div>
<div class="box ph" style="inset-inline-start: 118.7mm; inset-block-start: 19.3mm; inline-size: 75.7mm; block-size: 61.5mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 85.2mm; inline-size: 86.5mm; block-size: 17.6mm; font-size: 9.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 96.2mm; inline-size: 86.5mm; block-size: 25.0mm; font-size: 9.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 111.7mm; inline-size: 86.5mm; block-size: 67.8mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 38.2mm; inset-block-start: 130.2mm; inline-size: 48.1mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 139.1mm; inline-size: 86.5mm; block-size: 104.2mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 180.4mm; inline-size: 86.5mm; block-size: 59.7mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 244.2mm; inline-size: 86.5mm; block-size: 7.2mm; font-size: 10.0pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 126.3mm; inset-block-start: 243.5mm; inline-size: 72.0mm; block-size: 7.9mm; font-size: 10.0pt"></div>
</div></body>
</html>
