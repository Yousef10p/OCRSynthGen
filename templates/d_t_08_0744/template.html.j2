<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.8mm; inset-block-start: 12.7mm; inline-size: 182.1mm; block-size: 124.6mm; font-size: 11.4pt"></div>
<p class="box" style="inset-inline-start: 14.3mm; inset-block-start: 142.3mm; inline-size: 181.4mm; block-size: 26.2mm; font-size: 9.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 14.3mm; inset-block-start: 177.2mm; inline-size: 56.5mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 14.3mm; inset-block-start: 187.1mm; inline-size: 181.4mm; block-size: 66.4mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 83.5mm; inset-block-start: 262.1mm; inline-size: 112.2mm; block-size: 7.9mm; font-size: 10.0pt"></div>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 282.4mm; inline-size: 1.8mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_3 }}</footer>
</div></body>
</html>
