<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<main>
<section id="slideshow">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div id="slides">
<a>
<div class="slide">{{ slot_8 }}</div>
</a>
<a>
<div class="slide">{{ slot_9 }}</div>
</a>
<a>
<div class="slide">{{ slot_10 }}</div>
</a>
</div>
</section>
</main>
<footer>
<nav>
<ul>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
