* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    color: #333;
}

header, main, footer {
    padding: 20px;
}


#navbar {
    display: flex;
    justify-content: space-around;
    position: sticky;
    top: 0;
    background-color: #FFA500;
    color: white;
}


#menu {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
}

.food-item {
    background-color: #FFFF00;
    padding: 20px;
    margin: 10px;
    text-align: center;
}


#location {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
}

.location-item {
    background-color: #FFFF00;
    padding: 20px;
    margin: 10px;
    text-align: center;
}


footer {
    background-color: #333;
    color: white;
}

#reviews {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
}

.review-item {
    background-color: #FFA500;
    padding: 20px;
    margin: 10px;
    text-align: center;
}

#contact form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

#contact form input,
#contact form textarea,
#contact form button {
    padding: 10px;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
