<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 11.2mm; inset-block-start: 14.4mm; inline-size: 164.2mm; block-size: 6.7mm; font-size: 18.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 10.3mm; inset-block-start: 48.9mm; inline-size: 67.5mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 10.3mm; inset-block-start: 72.2mm; inline-size: 63.4mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 10.3mm; inset-block-start: 95.5mm; inline-size: 61.5mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 10.3mm; inset-block-start: 118.8mm; inline-size: 69.4mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 10.3mm; inset-block-start: 142.1mm; inline-size: 79.1mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 10.3mm; inset-block-start: 165.3mm; inline-size: 70.0mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 146.6mm; inset-block-start: 179.7mm; inline-size: 47.1mm; block-size: 62.7mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 147.2mm; inset-block-start: 246.6mm; inline-size: 22.6mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 147.2mm; inset-block-start: 252.5mm; inline-size: 46.3mm; block-size: 9.4mm; font-size: 8.9pt">{{ slot_8 }}</p>
</div></body>
</html>
