}
nav ul {
    display: flex;
    justify-content: center;
    list-style-type: none;
}
nav ul li {
    margin: 0 10px;
}
nav ul li a {
    text-decoration: none;
    color: black;
}
#slider {
    display: flex;
    overflow-x: auto;
}
.slide {
    height: 60vh;
    flex: 1 0 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3em;
    color: white;
}
main {
    margin: 20px;
    display: grid;
    grid-gap: 20px;
}
footer {
    padding: 20px;
    background-color: #f3f3f3;
    text-align: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
