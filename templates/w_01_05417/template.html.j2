}

.header-menu a {
    text-decoration: none;
    color: #333;
}


main {
    margin: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.recipe-image {
    background-color: #aaa;
    width: 100%;
    height: 200px;
}

.recipe-description {
    margin: 10px 0;
}


footer {
