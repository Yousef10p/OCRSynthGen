.footer-menu {
    list-style-type: none;
}

.footer-menu li {
    display: inline;
    margin: 0 10px;
}

.footer-menu a {
    text-decoration: none;
    color: #333;
}

.footer-close {
    margin-top: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
