<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.header {
    text-align: center;
    background-color: #f2f2f2;
    padding: 30px;
}

.portal {
    margin: 50px;
    text-align: center;
}

.portal form input[type="text"],
.portal form input[type="password"] {
    margin: 10px;
    padding: 5px;
}

.portal form input[type="submit"] {
    background-color: blue;
    color: white;
    padding: 5px 10px;
    border: none;
}

.appointments {
    margin: 50px;
}

.appointments table {
    width: 100%;
    border-collapse: collapse;
}

.appointments th,
.appointments td {
    border: 1px solid black;
    padding: 10px;
}


img {
    height: 150px;
    width: 150px;
    background-color: #f2f2f2;
    display: block;
    margin: 15px auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</div>
<div class="portal">
<h2>{{ slot_2 }}</h2>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<span class="">{{ slot_5 }}</span>
</form>
</div>
<div class="appointments">
<h2>{{ slot_6 }}</h2>
<table>
<tr>
<th>{{ slot_7 }}</th>
<th>{{ slot_8 }}</th>
<th>{{ slot_9 }}</th>
<th>{{ slot_10 }}</th>
</tr>
<tr>
<td>{{ slot_11 }}</td>
<td>{{ slot_12 }}</td>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
</tr>

</table>
</div>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div> 
</body>
</html>