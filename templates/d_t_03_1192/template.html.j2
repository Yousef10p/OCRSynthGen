<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 144.8mm; inline-size: 74.8mm; block-size: 19.8mm; font-size: 14.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 114.9mm; inset-block-start: 144.8mm; inline-size: 74.1mm; block-size: 36.8mm; font-size: 14.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 169.9mm; inline-size: 74.3mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 206.3mm; inline-size: 71.1mm; block-size: 48.0mm; font-size: 15.1pt">{{ slot_6 }}</p>
