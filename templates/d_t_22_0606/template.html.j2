<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 23.5mm; inset-block-start: 0.9mm; inline-size: 97.8mm; block-size: 10.5mm; font-size: 29.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 72.4mm; inset-block-start: 21.0mm; inline-size: 61.8mm; block-size: 9.2mm; font-size: 26.1pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 11.5mm; inset-block-start: 23.4mm; inline-size: 51.9mm; block-size: 45.1mm; font-size: 14.2pt"></div>
<p class="box" style="inset-inline-start: 68.5mm; inset-block-start: 35.3mm; inline-size: 70.5mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 68.3mm; inset-block-start: 49.0mm; inline-size: 71.6mm; block-size: 15.7mm; font-size: 22.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 72.4mm; inline-size: 126.4mm; block-size: 9.8mm; font-size: 13.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 74.6mm; inset-block-start: 85.6mm; inline-size: 61.6mm; block-size: 109.7mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 89.6mm; inline-size: 11.4mm; block-size: 4.8mm; font-size: 6.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 94.3mm; inline-size: 65.6mm; block-size: 32.6mm; font-size: 11.6pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 148.5mm; inline-size: 13.9mm; block-size: 4.8mm; font-size: 6.9pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 153.2mm; inline-size: 64.4mm; block-size: 23.4mm; font-size: 11.0pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 138.9mm; inset-block-start: 205.8mm; inline-size: 4.2mm; block-size: 3.7mm; font-size: 10.4pt"></div>
</div></body>
</html>
