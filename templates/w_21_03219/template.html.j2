<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<main>
<section id="banner">
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
</section>
<section id="posts">
<article>
<h2>{{ slot_7 }}</h2>
<div class="placeholder-image ph"></div>
<p>{{ slot_8 }}</p>
<h3>{{ slot_9 }}</h3>
<ul>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
</ul>
<button>{{ slot_13 }}</button>
</article>

</section>
</main>
<footer>
<div class="logo">{{ slot_14 }}</div>
</footer>
</body>
</html>