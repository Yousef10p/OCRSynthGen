<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 43.4mm; inset-block-start: 35.4mm; inline-size: 52.3mm; block-size: 5.5mm; font-size: 17.2pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 43.4mm; inset-block-start: 50.8mm; inline-size: 54.1mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 62.3mm; inline-size: 135.0mm; block-size: 54.8mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 82.0mm; inset-block-start: 128.3mm; inline-size: 96.5mm; block-size: 4.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 143.7mm; inline-size: 135.0mm; block-size: 38.0mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 49.7mm; inset-block-start: 194.3mm; inline-size: 47.9mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 84.5mm; inset-block-start: 206.3mm; inline-size: 93.9mm; block-size: 15.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 225.5mm; inline-size: 135.0mm; block-size: 21.6mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 76.7mm; inset-block-start: 254.9mm; inline-size: 101.8mm; block-size: 15.1mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 108.9mm; inset-block-start: 279.7mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
