    padding: 25px;
}

.footer ul {
    list-style-type: none;
}

.footer form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.hero, .menu, .footer {
    overflow: auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
