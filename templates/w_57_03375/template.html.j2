.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.hero {
    background: lightblue;
    padding: 50px;
    text-align: right;
}

.menu {
    background: lightgray;
    position: sticky;
    top: 0;
}

.menu ul {
    list-style-type: none;
    padding: 0;
}

.menu li {
    display: inline;
    padding: 10px;
}

.content {
    margin: 50px;
    columns: 2;
