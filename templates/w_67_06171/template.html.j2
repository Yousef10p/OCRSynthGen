<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: var(--font-body);
  color: #333;
}
.hero {
  background: none no-repeat;
  height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #fff;
}
.hero-content {
  max-width: 800px;
  margin: 0 auto;
}
.navigation {
  background: #333;
  color: #fff;
  padding: 10px 0;
}
.navigation ul {
  list-style: none;
  display: flex;
  justify-content: center;
}
.navigation ul li {
  margin: 0 10px;
}
.navigation ul li a {
  color: #fff;
  text-decoration: none;
}
.services {
  padding: 50px 0;
  text-align: center;
}
.service-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  grid-gap: 20px;
  margin-top: 50px;
}
.service {
  padding: 20px;
  text-align: center;
  border: 1px solid #333;
}
.cta-btn {
  padding: 10px 20px;
  background: #333;
  color: #fff;
  border: none;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<div class="hero-content">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<button class="cta-btn">{{ slot_2 }}</button>
</div>
</div>
<div class="navigation">
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</div>
<div class="services">
<h2>{{ slot_7 }}</h2>
<div class="service-container">
<div class="service">
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
</div>
<div class="service">
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>
<div class="service">
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
</div>
<div class="service">
<h3>{{ slot_14 }}</h3>
<p>{{ slot_15 }}</p>
</div>
</div>
</div>
</body>
</html>