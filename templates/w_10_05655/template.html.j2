}

#header {
    position: relative;
    height: 500px;
    background-color: #BBDEFB; 
}

#header .header-image,
#header .colored-rectangle {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background-color: #BBDEFB; 
}

nav {
    background-color: #0D47A1; 
    padding: 10px 20px;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

nav ul li a {
    text-decoration: none;
    color: #FFFFFF; 
}

#search-bar {
    position: absolute;
    top: 40px;
    left: 20px;
}

#search-bar input[type="text"] {
    padding: 5px;
    border: none;
}

#search-bar button {
    padding: 5px 10px;
    background-color: #FFFFFF; 
    color: #0D47A1; 
    border: none;
}

.card, .review-card {
    width: 150px;
    height: 200px;
    margin: 10px;
    background-color: #BBDEFB; 
    display: inline-block;
}

#reviews .review-card {
    width: 300px;
    height: auto;
    margin-bottom: 20px;
}

#about, #contact {
    padding: 20px;
}

#about p, #reviews p, #contact p {
    line-height: 1.6;
}

footer {
    background-color: #0D47A1; 
    color: #FFFFFF; 
    text-align: center;
    padding: 10px 0;
    position: absolute;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
