    border: 3px solid #fff;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-left: 15px;
}

#services, #locations {
    margin: 30px;
    overflow: auto;
}

footer {
    background-color: #333;
    color: #fff;
    padding: 10px 0;
    text-align: center;
}

footer form {
    display: inline-block;
    text-align: right;
}

footer label {
    display: inline-block;
    width: 100px;
    text-align: left;
    margin-left: 10px;
}

footer input, footer textarea {
    width: 200px;
    box-sizing: border-box;
}

footer input[type="submit"] {
    display: block;
    width: 100px;
    margin: 15px auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
