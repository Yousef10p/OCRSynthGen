<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
  background-color: #f0f0f0;
}

header, footer {
  background-color: #333;
  color: #fff;
  padding: 20px;
  text-align: center;
}

header img {
  width: 100%;
  height: 300px;
  display: block;
  margin-bottom: 20px;
  background-color: #666;
}

header h1 {
  font-size: 36px;
  margin-bottom: 20px;
}

header button {
  background-color: #ff0000;
  color: #fff;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
}

aside {
  background-color: #666;
  color: #fff;
  padding: 20px;
  position: absolute;
  top: 0;
  bottom: 0;
  width: 200px;
}

section {
  padding: 20px;
}

footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h1>{{ slot_5 }}</h1>
<button>{{ slot_6 }}</button>
</header>
<aside>
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</aside>
<section>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</section>
<footer>
<p>{{ slot_16 }}</p>
</footer>
</body>
</html>