  font-size: xx-large;
}

#center-column h2 {
  font-size: x-large;
}

#center-column p {
  font-size: large;
}

#center-column ul {
  list-style-type: circle;
}


#right-column {
  float: left;
  width: 30%;
}

#right-column h2 {
  font-size: xx-large;
}

#right-column ul {
  list-style-type: circle;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
