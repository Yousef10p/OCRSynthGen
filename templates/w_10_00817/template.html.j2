}

.recipe,
.blog-post {
    margin-bottom: 20px;
}

.recipe-image,
.blog-image {
    width: 100%;
    height: 200px;
    background-color: #483d8b;
}

footer {
    padding: 20px;
    text-align: center;
    background-color: #f9f9f9;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
