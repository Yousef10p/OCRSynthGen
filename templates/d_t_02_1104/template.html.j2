<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 19.9mm; inset-block-start: 15.1mm; inline-size: 2.8mm; block-size: 2.4mm; font-size: 7.5pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 31.1mm; inset-block-start: 15.3mm; inline-size: 28.7mm; block-size: 2.0mm; font-size: 6.5pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 104.5mm; inset-block-start: 15.3mm; inline-size: 49.2mm; block-size: 2.2mm; font-size: 7.0pt">{{ slot_2 }}</header><h2 class="box" style="inset-inline-start: 16.0mm; inset-block-start: 29.9mm; inline-size: 44.1mm; block-size: 2.9mm; font-size: 9.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 45.1mm; inline-size: 172.1mm; block-size: 25.3mm; font-size: 12.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 127.4mm; inset-block-start: 80.0mm; inline-size: 65.4mm; block-size: 8.3mm; font-size: 10.6pt">{{ slot_5 }}</h2>
<h2 class="box" style="inset-inline-start: 55.3mm; inset-block-start: 80.6mm; inline-size: 46.6mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 55.3mm; inset-block-start: 88.0mm; inline-size: 65.8mm; block-size: 105.4mm; font-size: 11.1pt">{{ slot_7 }}</p>
