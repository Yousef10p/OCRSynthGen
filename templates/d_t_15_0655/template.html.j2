<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 15.5mm; inline-size: 83.6mm; block-size: 62.8mm; font-size: 12.7pt"><li>{{ slot_0 }}</li></ul>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 15.5mm; inline-size: 86.9mm; block-size: 40.2mm; font-size: 12.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 61.4mm; inline-size: 27.2mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 66.6mm; inline-size: 86.8mm; block-size: 40.2mm; font-size: 12.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 83.2mm; inline-size: 30.5mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 88.4mm; inline-size: 87.0mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 26.3mm; inset-block-start: 113.3mm; inline-size: 176.4mm; block-size: 133.7mm; font-size: 22.3pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 249.4mm; inline-size: 176.5mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 192.9mm; inset-block-start: 262.8mm; inline-size: 9.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_7 }}</footer>
</div></body>
</html>
