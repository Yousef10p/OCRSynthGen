<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 65.5mm; inset-block-start: 12.8mm; inline-size: 86.1mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_0 }}</header><h1 class="box" style="inset-inline-start: 29.3mm; inset-block-start: 107.6mm; inline-size: 157.2mm; block-size: 18.5mm; font-size: 26.3pt">{{ slot_1 }}</h1>
<h1 class="box" style="inset-inline-start: 55.6mm; inset-block-start: 123.8mm; inline-size: 104.6mm; block-size: 18.5mm; font-size: 17.5pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 80.3mm; inset-block-start: 140.1mm; inline-size: 55.2mm; block-size: 18.5mm; font-size: 17.5pt">{{ slot_3 }}</h1>
<h1 class="box" style="inset-inline-start: 82.3mm; inset-block-start: 156.3mm; inline-size: 51.3mm; block-size: 18.5mm; font-size: 17.5pt">{{ slot_4 }}</h1>
<h1 class="box" style="inset-inline-start: 51.9mm; inset-block-start: 166.0mm; inline-size: 113.8mm; block-size: 52.3mm; font-size: 40.0pt">{{ slot_5 }}</h1>
<p class="box" style="inset-inline-start: 93.9mm; inset-block-start: 235.3mm; inline-size: 28.2mm; block-size: 6.6mm; font-size: 18.8pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 107.5mm; inset-block-start: 262.3mm; inline-size: 1.9mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
