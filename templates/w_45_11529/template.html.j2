<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    color: white;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    height: 50px;
    background: #444;
    display: flex;
    justify-content: center;
    align-items: center;
}

nav a {
    color: white;
    margin: 0 20px;
    text-decoration: none;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
}

.grid > div {
    background-color: #555;
    padding: 20px;
    border-radius: 5px;
    margin: 20px;
}

.course {
    grid-column: span 1;
}

.event {
    grid-column: span 2;
}

.success-story {
    grid-column: span 3;
    color: black;
    background-color: lightblue;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</nav>
</header>
<main>
<div class="grid">
<div class="course">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
</div>
<div class="course">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div class="course">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="event">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
<div class="event">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
<div class="success-story">
<p>{{ slot_14 }}</p>
</div>
</div>
</main>
</body>
</html>