<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 157.0mm; inset-block-start: 12.1mm; inline-size: 41.8mm; block-size: 2.6mm; font-size: 8.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 43.6mm; inset-block-start: 17.5mm; inline-size: 101.4mm; block-size: 12.4mm; font-size: 11.0pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 152.2mm; inset-block-start: 21.5mm; inline-size: 31.5mm; block-size: 2.9mm; font-size: 9.0pt">{{ slot_2 }}</header><div class="box ph" style="inset-inline-start: 19.6mm; inset-block-start: 23.4mm; inline-size: 18.2mm; block-size: 9.0mm; font-size: 12.8pt"></div>
<header class="box" style="inset-inline-start: 64.4mm; inset-block-start: 35.3mm; inline-size: 57.2mm; block-size: 3.5mm; font-size: 11.0pt">{{ slot_3 }}</header><header class="box" style="inset-inline-start: 159.2mm; inset-block-start: 34.1mm; inline-size: 17.5mm; block-size: 2.9mm; font-size: 9.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 57.5mm; inline-size: 105.0mm; block-size: 11.7mm; font-size: 16.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 56.7mm; inset-block-start: 87.6mm; inline-size: 98.2mm; block-size: 5.2mm; font-size: 16.0pt">{{ slot_6 }}</p>
<h1 class="box" style="inset-inline-start: 66.6mm; inset-block-start: 122.2mm; inline-size: 77.8mm; block-size: 5.9mm; font-size: 18.0pt">{{ slot_7 }}</h1>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 149.8mm; inline-size: 152.7mm; block-size: 11.7mm; font-size: 16.0pt">{{ slot_8 }}</p>
</div></body>
</html>
