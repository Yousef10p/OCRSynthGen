<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.0mm; inline-size: 75.2mm; block-size: 296.9mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 20.9mm; inline-size: 97.0mm; block-size: 27.4mm; font-size: 12.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 50.4mm; inline-size: 96.5mm; block-size: 9.1mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 61.6mm; inline-size: 84.2mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 68.2mm; inline-size: 81.4mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 74.7mm; inline-size: 97.6mm; block-size: 50.7mm; font-size: 13.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 85.0mm; inset-block-start: 130.2mm; inline-size: 44.8mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 136.5mm; inline-size: 96.8mm; block-size: 32.0mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 170.6mm; inline-size: 98.6mm; block-size: 36.6mm; font-size: 13.0pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 85.0mm; inset-block-start: 211.6mm; inline-size: 81.0mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 85.0mm; inset-block-start: 217.9mm; inline-size: 98.6mm; block-size: 45.8mm; font-size: 13.0pt">{{ slot_9 }}</p>
</div></body>
</html>
