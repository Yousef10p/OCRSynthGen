<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

header {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 50px;
    background-color: #f8f8f8;
}

#top-nav {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 100%;
}

#top-nav a {
    text-decoration: none;
    color: #000;
}

#banner {
    width: 100%;
    display: flex;
    margin-top: 50px;
}

.banner-item {
    width: 100%;
    height: 200px;
    background: #ccc;
}

#services, #products {
    display: flex;
    justify-content: space-around;
    margin: 20px 0;
}

.service-item, .product-item {
    width: 30%;
    height: 150px;
    background: #f8f8f8;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

#about {
    text-align: center;
    margin: 20px 0;
}

#contact {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 50px;
    background: #333;
    color: #fff;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 50px;
    background-color: #f8f8f8;
    display: flex;
    justify-content: space-around;
    align-items: center;
}

#service-list {
    display: flex;
    justify-content: space-around;
    width: 100%;
}

.service-icon {
    width: 20px;
    height: 20px;
    background: #000;
    margin-left: 10px;
}

.service-icon p {
    margin: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
