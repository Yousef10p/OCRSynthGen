<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 139.3mm; inset-block-start: 0.0mm; inline-size: 74.9mm; block-size: 75.2mm; font-size: 15.2pt"></div>
<h2 class="box" style="inset-inline-start: 15.2mm; inset-block-start: 11.8mm; inline-size: 107.5mm; block-size: 41.6mm; font-size: 39.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 15.6mm; inset-block-start: 79.8mm; inline-size: 114.1mm; block-size: 14.4mm; font-size: 20.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 139.8mm; inset-block-start: 79.7mm; inline-size: 44.0mm; block-size: 41.4mm; font-size: 11.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.6mm; inset-block-start: 97.4mm; inline-size: 116.3mm; block-size: 32.1mm; font-size: 22.7pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 8.3mm; inset-block-start: 109.7mm; inline-size: 2.5mm; block-size: 89.1mm; font-size: 40.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 15.6mm; inset-block-start: 132.7mm; inline-size: 114.1mm; block-size: 32.1mm; font-size: 22.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 139.8mm; inset-block-start: 133.5mm; inline-size: 50.4mm; block-size: 37.2mm; font-size: 11.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 15.6mm; inset-block-start: 168.0mm; inline-size: 112.9mm; block-size: 32.1mm; font-size: 22.7pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 139.7mm; inset-block-start: 175.6mm; inline-size: 40.9mm; block-size: 40.4mm; font-size: 14.3pt"></div>
<div class="box ph" style="inset-inline-start: 1.7mm; inset-block-start: 222.7mm; inline-size: 212.7mm; block-size: 56.4mm; font-size: 32.0pt"></div>
</div></body>
</html>
