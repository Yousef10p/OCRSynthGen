<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 227.0mm; inline-size: 91.1mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 233.0mm; inline-size: 135.0mm; block-size: 11.7mm; font-size: 11.1pt"><li>{{ slot_9 }}</li></ul>
