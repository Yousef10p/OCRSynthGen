<ul class="box" style="inset-inline-start: 53.6mm; inset-block-start: 180.8mm; inline-size: 123.6mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 53.3mm; inset-block-start: 191.0mm; inline-size: 137.0mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 201.3mm; inline-size: 98.6mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_5 }}</li></ul>
<h2 class="box" style="inset-inline-start: 22.9mm; inset-block-start: 211.8mm; inline-size: 71.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</h2>
