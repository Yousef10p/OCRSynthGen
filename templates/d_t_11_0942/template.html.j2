<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 26.0mm; inline-size: 36.2mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 29.9mm; inset-block-start: 34.3mm; inline-size: 160.0mm; block-size: 13.6mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 30.2mm; inset-block-start: 50.9mm; inline-size: 159.7mm; block-size: 13.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 70.9mm; inline-size: 164.5mm; block-size: 25.9mm; font-size: 12.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 30.7mm; inset-block-start: 108.9mm; inline-size: 32.3mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 121.0mm; inline-size: 164.5mm; block-size: 18.5mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 81.5mm; inset-block-start: 144.3mm; inline-size: 51.9mm; block-size: 26.3mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 172.9mm; inline-size: 164.5mm; block-size: 22.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 63.0mm; inset-block-start: 200.0mm; inline-size: 89.2mm; block-size: 6.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 214.6mm; inline-size: 46.7mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 103.5mm; inset-block-start: 266.9mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
