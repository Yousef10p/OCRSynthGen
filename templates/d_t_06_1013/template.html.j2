<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 16.4mm; inline-size: 177.0mm; block-size: 23.9mm; font-size: 13.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 41.4mm; inline-size: 180.0mm; block-size: 10.4mm; font-size: 14.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 52.8mm; inline-size: 177.8mm; block-size: 14.9mm; font-size: 14.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 68.8mm; inline-size: 180.8mm; block-size: 28.4mm; font-size: 13.4pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 8.6mm; inset-block-start: 76.6mm; inline-size: 5.5mm; block-size: 7.4mm; font-size: 20.9pt"></div>
<div class="box ph" style="inset-inline-start: 17.3mm; inset-block-start: 118.6mm; inline-size: 63.1mm; block-size: 12.7mm; font-size: 18.1pt"></div>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 132.3mm; inline-size: 31.7mm; block-size: 7.8mm; font-size: 11.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 17.7mm; inset-block-start: 144.8mm; inline-size: 67.9mm; block-size: 11.7mm; font-size: 16.6pt"></div>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 158.4mm; inline-size: 28.3mm; block-size: 7.8mm; font-size: 11.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 175.3mm; inline-size: 26.3mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 160.6mm; inset-block-start: 264.8mm; inline-size: 37.9mm; block-size: 5.9mm; font-size: 16.8pt">{{ slot_7 }}</footer>
</div></body>
</html>
