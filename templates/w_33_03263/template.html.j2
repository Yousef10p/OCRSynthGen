<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-body);
  }

  header {
    position: sticky;
    top: 0;
    background-color: #eee;
    padding: 10px 0;
  }

  nav {
    display: flex;
    justify-content: space-around;
  }

  nav a {
    text-decoration: none;
    color: #000;
    transition: color 0.2s;
  }

  nav a:hover {
    color: #f00;
  }

  section {
    padding: 50px 0;
    position: relative;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .menu-item {
    margin: 10px;
    height: 200px;
    background-color: #eee;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    transition: background-color 0.2s;
  }

  .menu-item:hover {
    background-color: #ddd;
  }

  form {
    display: grid;
    grid-template-columns: auto;
    gap: 10px;
  }

  .reservation-form {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background-color: #fff;
    display: none;
    animation: slide-in 0.5s ease;
  }

  .reserve-btn {
    text-align: center;
  }

  .reserve-btn button {
    padding: 10px 20px;
    cursor: pointer;
  }

  @keyframes slide-in {
    from {right: -100%;}
    to {right: 0;}
  }

  @media screen and (max-width: 600px) {
    .menu-grid {
      grid-template-columns: 1fr;
    }
  }


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
