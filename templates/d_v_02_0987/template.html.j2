<p class="box" style="inset-inline-start: 23.4mm; inset-block-start: 77.4mm; inline-size: 155.8mm; block-size: 12.9mm; font-size: 18.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 23.3mm; inset-block-start: 93.8mm; inline-size: 155.9mm; block-size: 53.2mm; font-size: 21.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 32.7mm; inset-block-start: 150.2mm; inline-size: 85.8mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_6 }}</p>
