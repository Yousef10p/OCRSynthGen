    text-align: center;
}


main {
    margin: 20px;
}

main section {
    margin-bottom: 20px;
}


footer {
    background-color: #f2f2f2;
    color: #333;
    padding: 20px;
    display: flex;
    justify-content: space-around;
}

footer section {
    text-align: center;
}

footer a {
    display: block;
}

footer form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

footer input, footer textarea, footer button {
    grid-column: 1 / span 2;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
