<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 62.9mm; inset-block-start: 44.6mm; inline-size: 36.3mm; block-size: 24.5mm; font-size: 13.9pt"></div>
<div class="box ph" style="inset-inline-start: 24.8mm; inset-block-start: 44.9mm; inline-size: 36.3mm; block-size: 24.0mm; font-size: 13.6pt"></div>
<div class="box ph" style="inset-inline-start: 100.7mm; inset-block-start: 45.1mm; inline-size: 36.7mm; block-size: 24.2mm; font-size: 13.7pt"></div>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 85.2mm; inline-size: 72.9mm; block-size: 41.9mm; font-size: 13.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 85.2mm; inline-size: 72.8mm; block-size: 51.5mm; font-size: 13.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 128.3mm; inline-size: 73.6mm; block-size: 104.2mm; font-size: 13.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 137.9mm; inline-size: 73.1mm; block-size: 37.1mm; font-size: 13.1pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 2.6mm; inset-block-start: 166.4mm; inline-size: 2.0mm; block-size: 14.7mm; font-size: 40.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 176.3mm; inline-size: 73.8mm; block-size: 56.3mm; font-size: 13.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 233.9mm; inline-size: 73.7mm; block-size: 41.9mm; font-size: 13.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 233.9mm; inline-size: 70.5mm; block-size: 8.3mm; font-size: 11.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 106.0mm; inset-block-start: 243.5mm; inline-size: 73.8mm; block-size: 37.1mm; font-size: 13.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 10.5mm; inset-block-start: 287.3mm; inline-size: 34.8mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
