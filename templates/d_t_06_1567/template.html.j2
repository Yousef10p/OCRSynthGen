<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 95.1mm; inline-size: 170.8mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 116.0mm; inline-size: 170.8mm; block-size: 13.3mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 132.2mm; inline-size: 170.3mm; block-size: 13.3mm; font-size: 12.6pt">{{ slot_6 }}</p>
