<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

.container {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.left-sidebar, .right-sidebar {
  width: 20%;
  background-color: yellow;
  color: green;
  padding: 20px;
}

.main-content {
  width: 60%;
  padding: 20px;
  color: green;
}

.full-screen-image {
  background-color: yellow;
  height: 100vh;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

input[type="text"] {
  width: 100%;
  line-height: 2em;
}

a {
  display: block;
  color: green;
}

a:hover {
  color: yellow;
}

ul {
  list-style-type: none;
  padding: 0;
}

li {
  margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="left-sidebar">
<h2>{{ slot_0 }}</h2>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
<div class="search-bar">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</div>
</div>
<div class="main-content">
<p>{{ slot_5 }}</p>
<p>{{ slot_6 }}</p>
<div class="full-screen-image">{{ slot_7 }}</div>
</div>
<div class="right-sidebar">
<h2>{{ slot_8 }}</h2>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>