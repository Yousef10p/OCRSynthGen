<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 71.5mm; inset-block-start: 27.7mm; inline-size: 82.2mm; block-size: 23.2mm; font-size: 16.4pt"></div>
<h2 class="box" style="inset-inline-start: 27.1mm; inset-block-start: 35.9mm; inline-size: 40.2mm; block-size: 11.2mm; font-size: 31.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 27.1mm; inset-block-start: 64.9mm; inline-size: 122.9mm; block-size: 19.7mm; font-size: 18.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 27.3mm; inset-block-start: 104.3mm; inline-size: 81.3mm; block-size: 58.9mm; font-size: 13.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 115.5mm; inset-block-start: 104.3mm; inline-size: 84.4mm; block-size: 18.5mm; font-size: 10.5pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 7.6mm; inset-block-start: 119.7mm; inline-size: 1.8mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 168.7mm; inset-block-start: 122.8mm; inline-size: 36.3mm; block-size: 63.0mm; font-size: 19.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 115.5mm; inset-block-start: 124.5mm; inline-size: 52.7mm; block-size: 43.7mm; font-size: 13.8pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 27.3mm; inset-block-start: 167.0mm; inline-size: 33.5mm; block-size: 4.0mm; font-size: 11.2pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 27.3mm; inset-block-start: 172.8mm; inline-size: 81.3mm; block-size: 79.1mm; font-size: 14.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 115.5mm; inset-block-start: 172.1mm; inline-size: 48.6mm; block-size: 18.5mm; font-size: 13.1pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 115.5mm; inset-block-start: 192.3mm; inline-size: 81.9mm; block-size: 23.5mm; font-size: 13.3pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 115.5mm; inset-block-start: 219.7mm; inline-size: 81.9mm; block-size: 33.6mm; font-size: 13.6pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 14.1mm; inset-block-start: 268.9mm; inline-size: 59.9mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_12 }}</footer>
</div></body>
</html>
