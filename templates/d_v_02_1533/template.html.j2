<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 31.3mm; inset-block-start: 8.7mm; inline-size: 84.8mm; block-size: 53.9mm; font-size: 11.7pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 214.7mm; inset-block-start: 12.2mm; inline-size: 15.1mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 209.0mm; inset-block-start: 17.7mm; inline-size: 26.3mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 181.1mm; inset-block-start: 24.0mm; inline-size: 82.5mm; block-size: 36.6mm; font-size: 10.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 181.3mm; inset-block-start: 62.0mm; inline-size: 82.4mm; block-size: 13.8mm; font-size: 9.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 66.2mm; inline-size: 82.9mm; block-size: 37.0mm; font-size: 11.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 181.2mm; inset-block-start: 79.3mm; inline-size: 82.6mm; block-size: 53.9mm; font-size: 11.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 107.0mm; inline-size: 83.1mm; block-size: 79.7mm; font-size: 11.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 181.3mm; inset-block-start: 137.0mm; inline-size: 82.5mm; block-size: 32.7mm; font-size: 11.6pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 181.5mm; inset-block-start: 173.4mm; inline-size: 82.3mm; block-size: 16.1mm; font-size: 11.4pt">{{ slot_9 }}</p>
</div></body>
</html>
