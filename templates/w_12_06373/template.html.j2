<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}

nav li {
    float: right;
}

nav li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

nav li a:hover {
    background-color: #111;
}

#slider {
    width: 100%;
    overflow: hidden;
}

.slide {
    width: 100%;
    height: 250px;
    line-height: 250px;
    text-align: center;
    background-color: LightGray;
}

#course-boxes {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

.course-box {
    width: 150px;
    height: 150px;
    margin: 20px;
    background-color: #bbb;
    line-height: 150px;
    text-align: center;
    font-weight: bold;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div id="slider">
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
<div class="slide">{{ slot_7 }}</div>
</div>
<div id="course-boxes">
<div class="course-box">
<div class="course-title">{{ slot_8 }}</div>
<div class="course-description">{{ slot_9 }}</div>
</div>
<div class="course-box">
<div class="course-title">{{ slot_10 }}</div>
<div class="course-description">{{ slot_11 }}</div>
</div>
<div class="course-box">
<div class="course-title">{{ slot_12 }}</div>
<div class="course-description">{{ slot_13 }}</div>
</div>
<div class="course-box">
<div class="course-title">{{ slot_14 }}</div>
<div class="course-description">{{ slot_15 }}</div>
</div>
</div>
</body>
</html>