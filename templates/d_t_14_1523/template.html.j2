<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 25.0mm; inset-block-start: 9.9mm; inline-size: 73.6mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 116.5mm; inset-block-start: 9.9mm; inline-size: 66.5mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 24.6mm; inset-block-start: 19.8mm; inline-size: 59.0mm; block-size: 15.4mm; font-size: 14.5pt"></div>
<h1 class="box" style="inset-inline-start: 77.1mm; inset-block-start: 39.7mm; inline-size: 57.5mm; block-size: 6.8mm; font-size: 9.7pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 32.3mm; inset-block-start: 45.8mm; inline-size: 146.5mm; block-size: 9.1mm; font-size: 8.6pt">{{ slot_3 }}</h1>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 65.4mm; inline-size: 162.2mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 83.2mm; inline-size: 37.8mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 91.8mm; inline-size: 155.6mm; block-size: 30.5mm; font-size: 12.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 126.1mm; inline-size: 161.2mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 138.9mm; inline-size: 162.1mm; block-size: 17.6mm; font-size: 12.5pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 104.3mm; inset-block-start: 284.1mm; inline-size: 2.3mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
