<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

nav {
    background-color: #333;
    color: #fff;
    height: 50px;
    display: flex;
    justify-content: space-around;
    align-items: center;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li a {
    margin-left: 10px;
    text-decoration: none;
    color: #fff;
}

header {
    background-color: #f4f4f4;
    height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
}

header h1 {
    margin-bottom: 15px;
}

header a {
    text-decoration: none;
    color: #333;
    border: 1px solid #333;
    padding: 10px 20px;
    border-radius: 5px;
}

section {
    padding: 20px;
}

footer {
    background-color: #333;
    color: #fff;
    position: fixed;
    width: 100%;
    bottom: 0;
    text-align: center;
    padding: 20px;
}

#map {
    height: 50vh;
    width: 100%;
    
    background-color: #ddd;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 15px 0;
}

#contact form {
    display: flex;
    flex-direction: column;
}


@media(max-width: 600px) {
    header h1 {
        font-size: 20px;
    }

    header h2 {
        font-size: 15px;
    }

    header a {
        font-size: 13px;
    }

    nav ul li a {
        font-size: 13px;
    }

    nav ul {
        flex-direction: column;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
