<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 26.4mm; inline-size: 169.9mm; block-size: 11.4mm; font-size: 10.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 61.5mm; inset-block-start: 44.6mm; inline-size: 92.9mm; block-size: 22.1mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 74.5mm; inline-size: 12.0mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 69.4mm; inset-block-start: 82.1mm; inline-size: 77.2mm; block-size: 6.8mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 93.5mm; inline-size: 129.2mm; block-size: 3.6mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 67.2mm; inset-block-start: 107.5mm; inline-size: 81.5mm; block-size: 6.7mm; font-size: 10.9pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 134.8mm; inline-size: 23.4mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 145.0mm; inline-size: 165.1mm; block-size: 11.4mm; font-size: 10.9pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 106.0mm; inset-block-start: 261.9mm; inline-size: 3.8mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_5 }}</footer>
</div></body>
</html>
