<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 48.0mm; inset-block-start: 48.4mm; inline-size: 136.5mm; block-size: 28.0mm; font-size: 19.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 48.0mm; inset-block-start: 80.5mm; inline-size: 134.7mm; block-size: 11.8mm; font-size: 11.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 48.5mm; inset-block-start: 100.4mm; inline-size: 38.6mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 47.7mm; inset-block-start: 108.3mm; inline-size: 140.3mm; block-size: 35.5mm; font-size: 20.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 47.7mm; inset-block-start: 147.9mm; inline-size: 132.2mm; block-size: 11.8mm; font-size: 11.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 46.9mm; inset-block-start: 167.8mm; inline-size: 142.3mm; block-size: 75.1mm; font-size: 21.3pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 117.5mm; inset-block-start: 268.4mm; inline-size: 9.3mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_6 }}</footer>
</div></body>
</html>
