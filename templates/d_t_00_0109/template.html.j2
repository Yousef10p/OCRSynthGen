<p class="box" style="inset-inline-start: 15.3mm; inset-block-start: 224.8mm; inline-size: 45.2mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 128.3mm; inset-block-start: 225.5mm; inline-size: 12.9mm; block-size: 1.1mm; font-size: 5.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 20.2mm; inset-block-start: 229.3mm; inline-size: 36.1mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_5 }}</h2>
