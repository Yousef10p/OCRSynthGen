<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

header {
  background-color: #333;
  color: #fff;
  padding: 10px;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin-left: 10px;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}

aside {
  float: left;
  width: 20%;
  background-color: #f0f0f0;
  padding: 10px;
}

aside .product {
  height: 80px;
  margin-bottom: 10px;
  background-color: #666;
  color: #fff;
  text-align: center;
  line-height: 80px;
}

aside .promotion {
  height: 40px;
  margin-bottom: 10px;
  background-color: #999;
  color: #fff;
  text-align: center;
  line-height: 40px;
}

main {
  float: right;
  width: 80%;
  padding: 10px;
}

.product-grid .product {
  width: 30%;
  height: 200px;
  float: right;
  margin-left: 5%;
  margin-bottom: 10px;
  background-color: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<aside>
<h2>{{ slot_5 }}</h2>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
<h2>{{ slot_9 }}</h2>
<div class="promotion">{{ slot_10 }}</div>
<div class="promotion">{{ slot_11 }}</div>
</aside>
<main>
<h1>{{ slot_12 }}</h1>
<div class="product-grid">
<div class="product">{{ slot_13 }}</div>
<div class="product">{{ slot_14 }}</div>
<div class="product">{{ slot_15 }}</div>

</div>
</main>
</body>
</html>