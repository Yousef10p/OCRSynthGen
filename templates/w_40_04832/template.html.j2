.ph { background: #d0d0d0; }

body {
  display: grid; 
  grid-template-columns: 1fr 3fr 1fr; 
  grid-template-rows: auto auto; 
}

header {
  grid-column: 1 / span 3; 
  text-align: center; 
  font-size: 2em; 
}

nav {
  grid-column: 1 / span 1; 
}

section {
  grid-column: 2 / span 1; 
}

article {
  display: flex; 
  flex-direction: column; 
}

img.product-placeholder {
  background: #D3D3D3; 
  width: 50px;
  height: 50px;
  margin: 5px; 
}

aside {
  grid-column: 3 / span 1; 
  display: flex; 
  flex-direction: column; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
