<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
}

header {
    background-color: #333;
    color: #fff;
    padding: 10px;
}

header h1 {
    margin: 0;
}

header form {
    display: flex;
    margin-top: 10px;
}

header form input[type="text"] {
    flex-grow: 1;
    margin-left: 10px;
}

aside {
    background-color: #ddd;
    padding: 10px;
    width: 200px;
    float: left;
}

aside ul {
    list-style-type: none;
    padding: 0;
}

aside li {
    margin-bottom: 5px;
}

main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 10px;
    padding: 10px;
}

.product {
    background-color: #f90;
    min-height: 150px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
<button>{{ slot_2 }}</button>
</form>
</header>
<aside>
<h3>{{ slot_3 }}</h3>
<ul>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
<h3>{{ slot_7 }}</h3>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</aside>
<main>
<div class="product">{{ slot_11 }}</div>
<div class="product">{{ slot_12 }}</div>
<div class="product">{{ slot_13 }}</div>
<div class="product">{{ slot_14 }}</div>

</main>
</body>
</html>