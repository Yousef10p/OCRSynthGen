<p class="box" style="inset-inline-start: 74.8mm; inset-block-start: 130.2mm; inline-size: 65.8mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 91.7mm; inset-block-start: 140.7mm; inline-size: 32.0mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_5 }}</p>
