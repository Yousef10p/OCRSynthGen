<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}
.header {
    background: linear-gradient(-45deg, #1a2a6c, #b21f1f, #fdbb2d);
    color: white;
    display: flex;
    justify-content: space-between;
    padding: 10px;
}
.logo {
    font-size: 24px;
}
.menu ul {
    display: flex;
    list-style: none;
}
.menu ul li {
    margin-left: 10px;
}
.banner {
    height: 300px;
    background: none no-repeat center;
    background-size: cover;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 32px;
}
.destination {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 50px;
}
.destination h2 {
    font-size: 32px;
    margin-bottom: 20px;
}
.photo1, .photo2, .photo3 {
    width: 300px;
    height: 200px;
    background: blue;
    margin: 20px;
}
.book {
    margin-top: 50px;
    text-align: center;
}
.book h2 {
    font-size: 24px;
    margin-bottom: 20px;
}
.book form input[type="text"] {
    margin: 10px 0;
    width: 100%;
    padding: 10px;
}
.book form input[type="submit"] {
    background: blue;
    color: white;
    padding: 10px;
    border: none;
    cursor: pointer;
}
.footer {
    text-align: center;
    padding: 20px;
    background: #333;
    color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
