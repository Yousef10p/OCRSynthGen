<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 21.7mm; inline-size: 78.2mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 10.0mm; inset-block-start: 27.4mm; inline-size: 49.1mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 14.9mm; inset-block-start: 33.1mm; inline-size: 85.0mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 10.0mm; inset-block-start: 38.8mm; inline-size: 17.6mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 14.9mm; inset-block-start: 44.5mm; inline-size: 52.9mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 5.9mm; inset-block-start: 50.2mm; inline-size: 169.4mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.9mm; inset-block-start: 55.9mm; inline-size: 104.2mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 61.5mm; inline-size: 44.1mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 66.0mm; inline-size: 8.0mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 103.2mm; inset-block-start: 76.4mm; inline-size: 3.4mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
