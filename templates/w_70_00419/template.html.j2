  padding: 0;
  overflow: hidden;
  background-color: #333333;
}
.navigation li {
  float: right;
}
.navigation li a {
  display: block;
  color: white;
  text-align: center;
  padding: 16px;
  text-decoration: none;
}
.navigation li a:hover {
