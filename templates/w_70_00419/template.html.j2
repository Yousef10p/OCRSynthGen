}
.store_locator input[type=text] {
  width: 100%;
  padding: 12px 20px;
  margin: 8px 0;
  box-sizing: border-box;
}
.footer a {
  margin-left: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
