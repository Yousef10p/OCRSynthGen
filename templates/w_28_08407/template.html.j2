<label>{{ slot_2 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<button>{{ slot_4 }}</button>
</div>
<div class="property-grid">

<div class="property-card">{{ slot_5 }}</div>
<div class="property-card">{{ slot_6 }}</div>
<div class="property-card">{{ slot_7 }}</div>

</div>
<div class="contact-form">
<label>{{ slot_8 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>
<label>{{ slot_10 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<label>{{ slot_12 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_13 }}</span>
