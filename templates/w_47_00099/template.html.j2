  top: 50%;
  right: 50%;
  transform: translate(50%, -50%);
}

.service, .testimonial {
  float: right;
  width: 50%;
  padding: 15px;
  box-sizing: border-box;
}

.service img, .testimonial img {
  width: 100%;
  height: 200px;
  background: #D6D6D6;
}

footer {
  clear: both;
  padding: 20px;
  text-align: center;
  background: #ddd;
}

footer input, footer textarea {
  width: 100%;
  padding: 15px;
  margin: 5px 0 22px 0;
  border: none;
  background: #f1f1f1;
}

footer input[type=submit] {
  background-color: #4CAF50;
  color: white;
  cursor: pointer;
}

footer input[type=submit]:hover {
  background-color: #45a049;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
