<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
}

header {
    background-color: #aaa;
    width: 100%;
}

.menu {
    display: flex;
    justify-content: space-around;
    list-style: none;
    padding: 1em;
}

.menu a {
    text-decoration: none;
    color: white;
}

.full-width-slider {
    width: 100%;
    height: 20em;
    display: flex;
    overflow: hidden;
    position: relative;
}

.slide {
    position: absolute;
    width: 100%;
    height: 100%;
    transition: right 2s;
}

.slide.slide1 {
    background-color: red;
    right: 0;
    z-index: 1;
}

.slide.slide2 {
    background-color: green;
    right: 100%;
    z-index: 2;
}

.slide.slide3 {
    background-color: blue;
    right: 200%;
    z-index: 3;
}

.slides:hover .slide {
    right: -100%;
}

.slides:hover .slide2 {
    right: 0;
}

.slides:hover .slide3 {
    right: 100%;
}

form {
    display: flex;
    flex-direction: column;
    width: 60%;
    margin: 5em auto;
}

form input {
    margin: 1em 0;
}

.placeholder {
    background-color: #ddd;
    width: 100%;
    height: 20em;
    margin: 5em auto;
}

section {
    padding: 3em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
