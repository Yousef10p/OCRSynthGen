<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 25.8mm; inline-size: 159.1mm; block-size: 27.2mm; font-size: 19.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 60.8mm; inline-size: 159.2mm; block-size: 27.2mm; font-size: 19.3pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 6.4mm; inset-block-start: 89.4mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 95.8mm; inline-size: 159.1mm; block-size: 11.6mm; font-size: 16.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 83.8mm; inset-block-start: 111.3mm; inline-size: 100.8mm; block-size: 42.7mm; font-size: 20.2pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 114.7mm; inline-size: 52.0mm; block-size: 39.4mm; font-size: 22.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 161.9mm; inline-size: 159.1mm; block-size: 11.6mm; font-size: 16.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 181.3mm; inline-size: 159.1mm; block-size: 27.2mm; font-size: 19.3pt">{{ slot_7 }}</p>
