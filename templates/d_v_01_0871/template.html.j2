<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 15.4mm; inline-size: 38.7mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 102.9mm; inset-block-start: 15.1mm; inline-size: 87.1mm; block-size: 218.2mm; font-size: 24.7pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 20.5mm; inline-size: 86.2mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 38.6mm; inline-size: 88.4mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 65.6mm; inline-size: 88.4mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 92.7mm; inline-size: 88.4mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 115.3mm; inline-size: 88.9mm; block-size: 35.7mm; font-size: 12.7pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 155.5mm; inline-size: 23.9mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_6 }}</h2>
