<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<main>
