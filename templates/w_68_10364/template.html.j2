}

header, main, footer {
  width: 80%;
  margin: 0 auto;
}

a {
  color: #1B1C1D;
  text-decoration: none;
  transition: color 0.2s ease;
}

a:hover {
  color: #1B1C1D;
}

h1, h2, p, .product, .review, .tip {
  width: 100%;
  margin-bottom: 10px;
  background-color: #F6F8FA;
  color: #1B1C1D;
}


@media (max-width: 768px) {
  main {
    flex-wrap: wrap;
  }
  .product, .review, .tip {
    width: 50%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
