<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 38.6mm; inset-block-start: 33.7mm; inline-size: 138.0mm; block-size: 11.5mm; font-size: 12.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 35.1mm; inset-block-start: 57.0mm; inline-size: 145.0mm; block-size: 42.5mm; font-size: 11.8pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 90.6mm; inset-block-start: 103.2mm; inline-size: 34.1mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 35.2mm; inset-block-start: 110.5mm; inline-size: 144.8mm; block-size: 50.2mm; font-size: 11.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 35.2mm; inset-block-start: 164.8mm; inline-size: 144.9mm; block-size: 58.0mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 35.1mm; inset-block-start: 226.9mm; inline-size: 144.8mm; block-size: 27.0mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 47.6mm; inset-block-start: 257.9mm; inline-size: 132.1mm; block-size: 3.7mm; font-size: 11.8pt">{{ slot_6 }}</p>
</div></body>
</html>
