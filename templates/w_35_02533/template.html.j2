    border-radius: 5px;
}

main section {
    margin: 20px;
    padding: 20px;
}

.about .image, .cta .image {
    width: 100px;
    height: 100px;
    margin-top: 20px;
}

footer {
    background-color: #f8f8f8;
}

footer ul {
    list-style-type: none;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
