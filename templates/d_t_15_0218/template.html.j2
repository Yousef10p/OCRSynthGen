<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.3mm; inset-block-start: 16.1mm; inline-size: 176.3mm; block-size: 53.7mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 72.5mm; inline-size: 64.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 82.2mm; inline-size: 87.0mm; block-size: 44.8mm; font-size: 12.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 82.2mm; inline-size: 87.0mm; block-size: 58.3mm; font-size: 12.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 131.8mm; inline-size: 42.4mm; block-size: 4.8mm; font-size: 6.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 136.7mm; inline-size: 86.9mm; block-size: 8.7mm; font-size: 8.2pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 27.4mm; inset-block-start: 149.9mm; inline-size: 174.7mm; block-size: 99.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 252.5mm; inline-size: 40.2mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 196.9mm; inset-block-start: 262.8mm; inline-size: 6.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_6 }}</footer>
</div></body>
</html>
