<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

#banner {
  width: 100%;
  height: 200px;
  background-color: lightblue;
  text-align: center;
  padding: 40px 0;
  margin-bottom: 40px;
}

#nav ul {
  list-style-type: none;
  padding: 0;
  margin: 0;
  width: 200px;
  position: fixed;
  height: 100%;
  overflow: auto;
  background-color: #f1f1f1;
}

#nav li {
  display: block;
  color: #000;
  padding: 8px 16px;
  text-decoration: none;
}

#content {
  margin-right: 220px;
  padding: 1px 16px;
  height: 1000px;
}

#image, #image2 {
  height: 200px;
  margin-top: 20px;
  background-color: lightgray;
}

#footer {
  background-color: lightblue;
  text-align: center;
  padding: 10px 0;
  position: fixed;
  width: 100%;
  bottom: 0;
}

#footer ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
  overflow: hidden;
}

#footer li {
  display: inline;
  color: #000;
  padding: 8px 16px;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="banner">{{ slot_0 }}</div>
<div id="nav">
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</div>
<div id="content">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div id="image">{{ slot_7 }}</div>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div id="image2">{{ slot_10 }}</div>
</div>
<div id="footer">
<p>{{ slot_11 }}</p>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</div>
</body>
</html>