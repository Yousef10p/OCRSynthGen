<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 187.0mm; inset-block-start: 6.0mm; inline-size: 3.0mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 13.1mm; inset-block-start: 12.0mm; inline-size: 21.6mm; block-size: 16.4mm; font-size: 15.5pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 43.7mm; inset-block-start: 12.0mm; inline-size: 14.8mm; block-size: 10.6mm; font-size: 15.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 102.0mm; inset-block-start: 21.5mm; inline-size: 79.9mm; block-size: 39.8mm; font-size: 16.1pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 10.2mm; inset-block-start: 66.4mm; inline-size: 61.5mm; block-size: 30.4mm; font-size: 40.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 102.0mm; inset-block-start: 66.1mm; inline-size: 80.2mm; block-size: 28.2mm; font-size: 16.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 10.1mm; inset-block-start: 255.0mm; inline-size: 162.8mm; block-size: 14.5mm; font-size: 20.6pt">{{ slot_6 }}</p>
</div></body>
</html>
