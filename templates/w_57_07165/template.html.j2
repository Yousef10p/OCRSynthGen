<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  justify-content: center;
  text-align: center;
}

header {
  display: flex;
  justify-content: center;
  align-items: center;
  position: absolute;
  top: 0;
  width: 100%;
  height: 10vh;
  background-color: #f8f8f8;
}

nav ul {
  display: flex;
  justify-content: space-around;
  list-style-type: none;
  padding: 0;
}

.promo {
  position: absolute;
  top: 10vh;
  width: 100%;
  height: 20vh;
  background-color: #f8f8f8;
  display: flex;
  justify-content: center;
  align-items: center;
}

.left-column {
  position: absolute;
  right: 0;
  width: 50%;
  height: calc(100vh - 20vh);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.right-column {
  position: absolute;
  left: 0;
  width: 50%;
  height: calc(100vh - 20vh);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

button, input {
  margin-top: 20px;
  padding: 10px 20px;
  font-size: 18px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<aside>
<div class="promo">{{ slot_4 }}</div>
</aside>
<section>
<div class="left-column">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
<div class="right-column">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<button>{{ slot_13 }}</button>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_16 }}</span>
<button>{{ slot_17 }}</button>
</div>
</section>
</body>
</html>