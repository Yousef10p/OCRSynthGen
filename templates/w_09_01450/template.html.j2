}

#destination p {
  width: 50%;
  margin: auto;
}

#booking-form {
  width: 50%;
  margin: 20px auto;
  text-align: center;
}

#booking-form input {
  display: block;
  margin-bottom: 10px;
}

#footer {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 20px;
}

#company-info {
  margin-bottom: 20px;
}

#centered-logo {
  height: 100px;
  width: 200px;
  background: #eee;
  margin: auto;
  display: block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
