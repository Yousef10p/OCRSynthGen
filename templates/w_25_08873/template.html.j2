    position: relative;
    height: 500px;
    text-align: center;
    background: #f2f2f2;
}

#hero div {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
}

.cta {
    position: absolute;
    bottom: 20px;
    right: 50%;
    transform: translateX(50%);
    padding: 10px 20px;
    background: #000;
    color: #fff;
    text-decoration: none;
}


section {
    padding: 50px;
}

h2 {
    margin-bottom: 20px;
}

.sample {
    height: 200px;
    margin-bottom: 20px;
    background: #ccc;
}

article {
    margin-bottom: 40px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
