<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 100.9mm; inset-block-start: 12.2mm; inline-size: 8.1mm; block-size: 3.4mm; font-size: 9.5pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 141.2mm; inset-block-start: 12.2mm; inline-size: 48.7mm; block-size: 3.4mm; font-size: 9.5pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 22.4mm; inline-size: 167.6mm; block-size: 34.1mm; font-size: 9.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 53.2mm; inline-size: 41.9mm; block-size: 8.4mm; font-size: 9.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 63.5mm; inline-size: 167.6mm; block-size: 64.9mm; font-size: 9.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 130.3mm; inline-size: 25.1mm; block-size: 3.2mm; font-size: 9.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 135.5mm; inline-size: 167.6mm; block-size: 142.0mm; font-size: 9.5pt">{{ slot_6 }}</p>
</div></body>
</html>
