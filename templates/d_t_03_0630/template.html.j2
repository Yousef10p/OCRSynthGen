<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 37.5mm; inset-block-start: 12.2mm; inline-size: 122.5mm; block-size: 89.7mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 165.1mm; inset-block-start: 12.1mm; inline-size: 38.0mm; block-size: 75.3mm; font-size: 11.9pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 38.1mm; inset-block-start: 113.2mm; inline-size: 55.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 119.7mm; inline-size: 164.4mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 126.0mm; inline-size: 162.3mm; block-size: 16.8mm; font-size: 15.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 44.5mm; inset-block-start: 145.1mm; inline-size: 69.6mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 151.4mm; inline-size: 157.7mm; block-size: 23.2mm; font-size: 16.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 176.8mm; inline-size: 161.9mm; block-size: 16.8mm; font-size: 15.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 195.9mm; inline-size: 164.6mm; block-size: 29.5mm; font-size: 16.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 64.7mm; inset-block-start: 231.5mm; inline-size: 126.1mm; block-size: 15.2mm; font-size: 21.5pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 171.0mm; inset-block-start: 266.3mm; inline-size: 32.2mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
