<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}


.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px;
  background-color: #eee;
}

.logo {
  margin-left: 20px;
}

.nav {
  list-style: none;
  display: flex;
}

.nav li {
  margin-right: 20px;
}

.nav a {
  text-decoration: none;
  color: #000;
}


.hero {
  text-align: center;
  padding: 50px 0;
  background-color: #f9f9f9;
}


.section {
  margin: 20px 0;
  text-align: center;
}


.hero-image,
.info-image,
.menu-image,
.reservations-image {
  background-color: #ccc;
  margin: 20px auto;
  width: 80%;
  height: 400px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">{{ slot_0 }}</div>
<ul class="nav">
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="hero">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<div class="hero-image">{{ slot_6 }}</div>
</div>
<div class="section" id="info">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="info-image">{{ slot_9 }}</div>
</div>
<div class="section" id="menu">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<div class="menu-image">{{ slot_12 }}</div>
</div>
<div class="section" id="reservations">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<div class="reservations-image">{{ slot_15 }}</div>
</div>
</body>
</html>