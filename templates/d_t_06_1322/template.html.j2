<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 25.9mm; inline-size: 84.0mm; block-size: 10.3mm; font-size: 29.3pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 22.3mm; inset-block-start: 62.4mm; inline-size: 161.6mm; block-size: 83.8mm; font-size: 5.1pt"></div>
<h2 class="box" style="inset-inline-start: 22.7mm; inset-block-start: 170.6mm; inline-size: 16.4mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 22.7mm; inset-block-start: 175.1mm; inline-size: 158.4mm; block-size: 24.9mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.7mm; inset-block-start: 204.8mm; inline-size: 153.8mm; block-size: 3.8mm; font-size: 10.7pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 13.2mm; inset-block-start: 263.7mm; inline-size: 2.7mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 22.7mm; inset-block-start: 264.3mm; inline-size: 41.7mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_5 }}</footer>
</div></body>
</html>
