<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  max-width: 1200px;
  margin: auto;
  padding: 20px;
}

#slider img {
  width: 100%;
  height: 400px;
}

#menu {
  display: flex;
  flex-wrap: wrap;
}

.menu-item {
  width: 30%;
  padding: 10px;
  box-sizing: border-box;
}

.menu-button {
  display: block;
  width: 100%;
  padding: 10px;
  background-color: #4CAF50;
  color: white;
  border: none;
  cursor: pointer;
}

#delivery-button, #take-out-button {
  display: block;
  width: 100%;
  padding: 10px;
  background-color: #4CAF50;
  color: white;
  border: none;
  cursor: pointer;
}

#delivery-button:hover {
  content: "";
}

#take-out-button:hover {
  content: "";
}

footer {
  margin-top: 20px;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="slider">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<div id="menu">
<div class="menu-item">
<h2>{{ slot_0 }}</h2>
<p>{{ slot_1 }}</p>
<button class="menu-button">{{ slot_2 }}</button>
</div>
<div class="menu-item">
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
<button class="menu-button">{{ slot_5 }}</button>
</div>
<div class="menu-item">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<button class="menu-button">{{ slot_8 }}</button>
</div>
<button id="delivery-button">{{ slot_9 }}</button>
<button id="take-out-button">{{ slot_10 }}</button>
</div>
<footer>
<p>{{ slot_11 }}</p>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</footer>
</body>
</html>