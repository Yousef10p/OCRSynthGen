<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 148.2mm; inset-block-start: 8.7mm; inline-size: 30.3mm; block-size: 2.3mm; font-size: 6.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 74.6mm; inline-size: 66.1mm; block-size: 25.8mm; font-size: 12.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 100.0mm; inset-block-start: 74.6mm; inline-size: 68.0mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 100.0mm; inset-block-start: 88.4mm; inline-size: 31.0mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 100.0mm; inset-block-start: 92.9mm; inline-size: 68.5mm; block-size: 30.4mm; font-size: 12.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 102.1mm; inline-size: 68.5mm; block-size: 48.7mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 100.0mm; inset-block-start: 125.0mm; inline-size: 69.0mm; block-size: 35.0mm; font-size: 12.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 152.5mm; inline-size: 68.4mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 181.6mm; inline-size: 116.5mm; block-size: 7.4mm; font-size: 10.6pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 24.5mm; inset-block-start: 192.5mm; inline-size: 185.2mm; block-size: 88.3mm; font-size: 14.7pt"></div>
</div></body>
</html>
