<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 19.4mm; inline-size: 170.8mm; block-size: 36.3mm; font-size: 12.8pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 58.5mm; inline-size: 170.1mm; block-size: 8.8mm; font-size: 12.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 70.3mm; inline-size: 170.8mm; block-size: 31.7mm; font-size: 12.8pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 2.0mm; inset-block-start: 78.6mm; inline-size: 8.5mm; block-size: 21.5mm; font-size: 20.3pt">{{ slot_3 }}</header><h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 104.8mm; inline-size: 170.8mm; block-size: 8.8mm; font-size: 12.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 116.6mm; inline-size: 170.8mm; block-size: 36.3mm; font-size: 12.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 156.7mm; inline-size: 86.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</h2>
