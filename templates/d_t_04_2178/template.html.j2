<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 115.3mm; inline-size: 170.9mm; block-size: 12.1mm; font-size: 11.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.9mm; inset-block-start: 132.3mm; inline-size: 170.9mm; block-size: 29.0mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.9mm; inset-block-start: 166.2mm; inline-size: 170.8mm; block-size: 7.9mm; font-size: 11.1pt">{{ slot_6 }}</p>
