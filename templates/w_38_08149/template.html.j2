<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.container {
    display: flex;
}

.left-column, .middle-section, .right-column {
    padding: 20px;
}

.left-column {
    flex: 1;
    background-color: #f0f0f0;
}

.middle-section {
    flex: 3;
    background-color: #fff;
}

.right-column {
    flex: 1;
    background-color: #f0f0f0;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: 10px;
}

.grid-item {
    background-color: #ddd;
    padding: 20px;
    border-radius: 5px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li a {
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="left-column">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</div>
<div class="middle-section">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<h2>{{ slot_6 }}</h2>
<div class="grid-container">
<div class="grid-item">{{ slot_7 }}</div>
<div class="grid-item">{{ slot_8 }}</div>
<div class="grid-item">{{ slot_9 }}</div>
<div class="grid-item">{{ slot_10 }}</div>
</div>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>

</div>
<div class="right-column">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>

</div>
</div>
</body>
</html>