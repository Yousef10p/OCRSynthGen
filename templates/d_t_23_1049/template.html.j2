<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 22.5mm; inset-block-start: 20.0mm; inline-size: 26.2mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 148.1mm; inset-block-start: 20.0mm; inline-size: 40.7mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 30.9mm; inline-size: 154.6mm; block-size: 67.2mm; font-size: 21.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.0mm; inset-block-start: 99.8mm; inline-size: 154.8mm; block-size: 97.7mm; font-size: 21.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 26.9mm; inset-block-start: 199.0mm; inline-size: 154.5mm; block-size: 75.3mm; font-size: 21.4pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 103.8mm; inset-block-start: 281.3mm; inline-size: 3.4mm; block-size: 2.5mm; font-size: 7.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
