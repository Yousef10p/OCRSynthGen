<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  grid-template-rows: auto 1fr;
  grid-gap: 10px;
  height: 100vh;
  margin: 0;
  background-color: #ff0000; 
  color: white;
  font-size: 20px;
}

header {
  grid-row: 1;
  grid-column: 1 / span 3;
}

aside {
  grid-row: 2;
  grid-column: 1;
}

main {
  grid-row: 2;
  grid-column: 2;
}

input {
  width: 100%;
  padding: 10px;
  font-size: 20px;
}

ul {
  list-style: none;
  padding: 0;
}

.product {
  width: 100%;
  height: 100px;
  background-color: white;
  margin-bottom: 10px;
  color: black;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</header>
<aside>
<h3>{{ slot_5 }}</h3>
<p>{{ slot_6 }}</p>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</aside>
<main>
<h2>{{ slot_11 }}</h2>
<div class="product">{{ slot_12 }}</div>
<div class="product">{{ slot_13 }}</div>
<div class="product">{{ slot_14 }}</div>
</main>
</body>
</html>