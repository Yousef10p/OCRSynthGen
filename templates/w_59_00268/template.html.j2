}
footer form label, input, textarea {
  display: block;
}
table {
  width: 100%;
  margin: 20px 0;
  border-collapse: collapse;
}
table th, table td {
  border: 1px solid #ddd;
  padding: 8px;
  text-align: right;
}
table th {
  background-color: #333;
  color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
