<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

body {
    display: flex;
    flex-direction: column;
    align-items: center;
}

nav {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #f8f8f8;
}

ul {
    list-style-type: none;
    display: flex;
    justify-content: space-around;
    width: 100%;
}

ul li {
    padding: 10px;
}

main {
    margin-top: 70px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

main p {
    margin-bottom: 20px;
    text-align: center;
}

.scrolling-carousel, .service-carousel {
    height: 200px;
    width: 100%;
    display: flex;
    overflow: auto;
    margin-bottom: 20px;
}

.item {
    height: 150px;
    width: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #ddd;
    margin: 10px;
    border: 1px solid #000;
    border-radius: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li>{{ slot_0 }}</li>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</nav>
<main>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div class="scrolling-carousel">
<div class="item">{{ slot_7 }}</div>
<div class="item">{{ slot_8 }}</div>
<div class="item">{{ slot_9 }}</div>
<div class="item">{{ slot_10 }}</div>
<div class="item">{{ slot_11 }}</div>
</div>
<div class="service-carousel">
<div class="item">{{ slot_12 }}</div>
<div class="item">{{ slot_13 }}</div>
<div class="item">{{ slot_14 }}</div>
<div class="item">{{ slot_15 }}</div>
<div class="item">{{ slot_16 }}</div>
</div>
</main>
</body>
</html>