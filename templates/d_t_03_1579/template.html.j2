<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 11.4mm; inset-block-start: 8.7mm; inline-size: 190.9mm; block-size: 5.6mm; font-size: 15.9pt">{{ slot_0 }}</p>
<h1 class="box" style="inset-inline-start: 13.4mm; inset-block-start: 21.4mm; inline-size: 88.9mm; block-size: 60.6mm; font-size: 40.0pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 147.8mm; inset-block-start: 22.6mm; inline-size: 54.1mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.2mm; inset-block-start: 151.8mm; inline-size: 85.2mm; block-size: 40.4mm; font-size: 22.9pt">{{ slot_3 }}</p>
<h1 class="box" style="inset-inline-start: 13.4mm; inset-block-start: 198.2mm; inline-size: 123.2mm; block-size: 63.4mm; font-size: 40.0pt">{{ slot_4 }}</h1>
<div class="box ph" style="inset-inline-start: 180.9mm; inset-block-start: 252.5mm; inline-size: 21.1mm; block-size: 10.7mm; font-size: 15.1pt"></div>
<footer class="box" style="inset-inline-start: 98.8mm; inset-block-start: 267.9mm; inline-size: 18.4mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_5 }}</footer>
</div></body>
</html>
