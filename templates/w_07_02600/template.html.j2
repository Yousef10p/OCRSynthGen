<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #f0f0f0;
    display: flex;
    flex-direction: row;
}


.slideshow {
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
}
.slide {
    width: 100px;
    height: 100px;
    background-color: #ccc;
    margin: 10px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    transition: all 0.3s ease;
}
.slide:hover {
    cursor: pointer;
    transform: scale(1.1);
}


.sidebar {
    width: 50%;
    padding: 20px;
}
.sidebar h2 {
    margin-bottom: 10px;
}


.footer {
    width: 100%;
    background-color: #333;
    color: #fff;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.footer h2 {
   margin-bottom: 10px;
}
.footer textarea {
    width: 100%;
    margin-bottom: 10px;
    height: 100px;
}
.footer input[type="text"] {
    width: 100%;
    margin-bottom: 10px;
    height: 30px;
}
.footer input[type="submit"] {
    width: 100%;
    height: 30px;
    border: none;
    background-color: #666;
    color: #fff;
}
.footer input[type="submit"]:hover {
    background-color: #555;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="slideshow">
<div class="slide">{{ slot_0 }}</div>
<div class="slide">{{ slot_1 }}</div>
