<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #333;
    background-color: #f8f8f8;
}

nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: space-around;
    background-color: #333;
    color: #f8f8f8;
}

nav ul li {
    padding: 20px;
}

nav ul li a {
    color: #f8f8f8;
    text-decoration: none;
}

section {
    display: flex;
    justify-content: space-between;
    padding: 20px;
}

article {
    flex: 1;
    margin-left: 20px;
}

aside {
    width: 25%;
    background-color: #f8f8f8;
    padding: 20px;
}

aside ul {
    list-style: none;
    padding: 0;
}

aside a {
    color: #333;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<main>
<section>
<article>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<a>{{ slot_8 }}</a>
</article>

</section>
<aside>
<h3>{{ slot_9 }}</h3>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>
<h3>{{ slot_13 }}</h3>
<ul>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
<li><a>{{ slot_16 }}</a></li>
</ul>
</aside>
</main>
</body>
</html>