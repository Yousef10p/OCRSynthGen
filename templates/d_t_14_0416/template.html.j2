<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 93.2mm; inline-size: 171.0mm; block-size: 12.1mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 110.3mm; inline-size: 171.0mm; block-size: 24.3mm; font-size: 10.0pt"><li>{{ slot_6 }}</li></ul>
