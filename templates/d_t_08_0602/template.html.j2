<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 115.5mm; inline-size: 113.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 22.9mm; inset-block-start: 125.6mm; inline-size: 170.9mm; block-size: 21.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 151.6mm; inline-size: 17.5mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 76.7mm; inset-block-start: 159.4mm; inline-size: 57.5mm; block-size: 4.9mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 172.3mm; inline-size: 42.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
