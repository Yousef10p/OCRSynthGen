<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


.header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    background: #444;
    color: white;
    padding: 20px;
}


.logo {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 2em;
    font-weight: bold;
}


.cta-button {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 10px 20px;
    background: #333;
    color: white;
    border-radius: 5px;
}


.full-screen-image {
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 4em;
    background: #ddd;
    margin-top: 80px;
}


.panel {
    display: flex;
    height: 300px;
    margin: 20px;
}


.filter {
    flex: 1;
    background: #eee;
    padding: 20px;
    margin-left: 20px;
}


.carousel {
    flex: 2;
    background: #ddd;
    padding: 20px;
}


.reviews {
    flex: 1;
    background: #ccc;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">{{ slot_0 }}</div>
<div class="cta-button">{{ slot_1 }}</div>
</div>
<div class="full-screen-image">{{ slot_2 }}</div>
<div class="panel">
<div class="filter">
<h2>{{ slot_3 }}</h2>
<ul>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</div>
<div class="carousel">
<h2>{{ slot_8 }}</h2>
<ul>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
</ul>
</div>
<div class="reviews">
<h2>{{ slot_12 }}</h2>
<ul>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
</ul>
</div>
</div>
</body>
</html>