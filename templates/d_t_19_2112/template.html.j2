<div class="box ph" style="inset-inline-start: 96.3mm; inset-block-start: 65.6mm; inline-size: 28.5mm; block-size: 82.8mm; font-size: 14.7pt"></div>
<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 67.1mm; inline-size: 26.2mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 18.8mm; inset-block-start: 73.3mm; inline-size: 12.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 18.8mm; inset-block-start: 79.5mm; inline-size: 59.3mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_6 }}</p>
