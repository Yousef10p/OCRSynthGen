<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
  background-color: #f5f5f5;
  font-family: var(--font-body);
}

#logo-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 200px;
  background-color: #5c5c5c;
}

#logo { 
  width: 300px;
  height: 150px;
  background-color: white;
}

#columns-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

#services-wrapper, #treatments-wrapper, 
#facilities-wrapper, #testimonials-wrapper, 
#health-tips-wrapper {
  margin: 20px;
  padding: 20px;
  width: 50%;
  height: 100%;
  background-color: white;
  box-shadow: 0 0 10px 0 rgba(0,0,0,0.15);
}

#services-title, #treatments-title, 
#facilities-title, #testimonials-title, 
#health-tips-title {
  font-size: 2em;
  font-weight: bold;
  margin-bottom: 20px;
}

#services-list, #treatments-list, 
#facilities-list, #testimonials-list, 
#health-tips-list {
  margin-right: 20px;
}

li {
  line-height: 1.5em;
  list-style-type: disc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
