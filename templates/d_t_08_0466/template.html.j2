<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 36.3mm; inset-block-start: 32.9mm; inline-size: 47.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 167.2mm; inset-block-start: 32.9mm; inline-size: 6.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 47.4mm; inline-size: 137.1mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 45.3mm; inset-block-start: 67.6mm; inline-size: 128.2mm; block-size: 18.7mm; font-size: 9.0pt"></div>
<h2 class="box" style="inset-inline-start: 36.3mm; inset-block-start: 89.1mm; inline-size: 97.5mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 100.2mm; inline-size: 137.1mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 78.3mm; inset-block-start: 129.2mm; inline-size: 95.1mm; block-size: 32.6mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 169.4mm; inline-size: 137.1mm; block-size: 32.5mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 113.5mm; inset-block-start: 209.4mm; inline-size: 60.0mm; block-size: 7.9mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 74.6mm; inset-block-start: 226.4mm; inline-size: 98.8mm; block-size: 11.1mm; font-size: 8.0pt"></div>
</div></body>
</html>
