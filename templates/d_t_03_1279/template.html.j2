<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 73.6mm; inset-block-start: 21.8mm; inline-size: 108.6mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 74.4mm; inset-block-start: 43.1mm; inline-size: 107.1mm; block-size: 25.6mm; font-size: 12.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 104.0mm; inset-block-start: 71.7mm; inline-size: 93.6mm; block-size: 20.3mm; font-size: 14.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 128.4mm; inset-block-start: 95.0mm; inline-size: 64.8mm; block-size: 52.1mm; font-size: 14.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 113.2mm; inset-block-start: 150.0mm; inline-size: 84.2mm; block-size: 46.8mm; font-size: 14.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 73.6mm; inset-block-start: 199.8mm; inline-size: 77.3mm; block-size: 52.1mm; font-size: 14.8pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 156.6mm; inset-block-start: 203.1mm; inline-size: 59.4mm; block-size: 46.3mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 156.5mm; inset-block-start: 252.7mm; inline-size: 43.1mm; block-size: 10.7mm; font-size: 10.1pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 9.5mm; inset-block-start: 267.2mm; inline-size: 5.0mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_7 }}</footer>
</div></body>
</html>
