  margin: 0 auto;
  padding: 1em;
}

input, textarea {
  margin: 0.5em 0;
}

input[type="submit"] {
  background-color: #007BFF;
  color: white;
  border: none;
  padding: 0.5em;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
