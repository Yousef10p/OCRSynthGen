<p class="box" style="inset-inline-start: 53.8mm; inset-block-start: 67.9mm; inline-size: 127.0mm; block-size: 8.1mm; font-size: 11.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 53.8mm; inset-block-start: 80.6mm; inline-size: 127.4mm; block-size: 25.0mm; font-size: 11.8pt">{{ slot_4 }}</p>
