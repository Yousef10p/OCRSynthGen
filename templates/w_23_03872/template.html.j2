<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  color: #333;
}

nav ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
}

nav li {
  display: inline-block;
  background-color: #bada55;
  margin: 0 2px;
}

nav li a {
  display: block;
  color: #333;
  text-decoration: none;
  padding: 10px 20px;
}

.hero {
  background-color: #bada55;
  height: 400px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
}

.image {
  background-color: #bada55;
  height: 300px;
  margin: 50px auto;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
}

.content {
  max-width: 800px;
  margin: 50px auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<section class="hero">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
</section>
<div class="image">{{ slot_9 }}</div>
<section class="content">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</section>
</body>
</html>