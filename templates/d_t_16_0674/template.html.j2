<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 119.8mm; inline-size: 32.9mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 124.8mm; inline-size: 86.9mm; block-size: 39.3mm; font-size: 12.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 169.9mm; inline-size: 86.9mm; block-size: 43.9mm; font-size: 12.4pt">{{ slot_6 }}</p>
