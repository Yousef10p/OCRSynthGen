<footer class="box" style="inset-inline-start: 12.7mm; inset-block-start: 266.4mm; inline-size: 53.9mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_9 }}</footer><footer class="box" style="inset-inline-start: 175.6mm; inset-block-start: 266.3mm; inline-size: 27.6mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_10 }}</footer>
</div></body>
</html>
