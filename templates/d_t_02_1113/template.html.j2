<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 88.3mm; inline-size: 116.0mm; block-size: 23.2mm; font-size: 16.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 113.7mm; inline-size: 111.4mm; block-size: 23.2mm; font-size: 16.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 139.1mm; inline-size: 110.0mm; block-size: 16.8mm; font-size: 15.9pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 87.9mm; inset-block-start: 162.3mm; inline-size: 108.8mm; block-size: 7.4mm; font-size: 21.1pt">{{ slot_7 }}</h2>
