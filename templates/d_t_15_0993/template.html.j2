<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.0mm; inset-block-start: 14.4mm; inline-size: 40.2mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 19.6mm; inline-size: 189.7mm; block-size: 19.8mm; font-size: 11.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 43.5mm; inline-size: 189.7mm; block-size: 27.7mm; font-size: 11.2pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 58.4mm; inset-block-start: 80.5mm; inline-size: 93.9mm; block-size: 83.7mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 87.7mm; inset-block-start: 173.5mm; inline-size: 40.2mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 181.4mm; inline-size: 189.7mm; block-size: 31.7mm; font-size: 11.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 217.2mm; inline-size: 189.7mm; block-size: 19.8mm; font-size: 11.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 241.1mm; inline-size: 189.7mm; block-size: 15.8mm; font-size: 11.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 103.2mm; inset-block-start: 267.9mm; inline-size: 7.1mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
