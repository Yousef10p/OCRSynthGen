<div class="box ph" style="inset-inline-start: 19.6mm; inset-block-start: 61.6mm; inline-size: 171.3mm; block-size: 77.5mm; font-size: 11.0pt"></div>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 141.0mm; inline-size: 170.9mm; block-size: 12.1mm; font-size: 11.4pt">{{ slot_4 }}</p>
