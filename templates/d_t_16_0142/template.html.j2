<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 12.7mm; inset-block-start: 15.2mm; inline-size: 177.3mm; block-size: 129.6mm; font-size: 14.1pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 146.9mm; inline-size: 70.1mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 155.9mm; inline-size: 76.8mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 155.9mm; inline-size: 82.8mm; block-size: 35.9mm; font-size: 12.7pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 171.0mm; inline-size: 82.9mm; block-size: 22.4mm; font-size: 12.7pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 193.6mm; inline-size: 82.9mm; block-size: 40.4mm; font-size: 12.7pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 195.2mm; inline-size: 82.6mm; block-size: 58.5mm; font-size: 12.8pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 235.8mm; inline-size: 82.4mm; block-size: 17.9mm; font-size: 12.7pt"><li>{{ slot_6 }}</li></ul>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.7mm; inline-size: 4.8mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
