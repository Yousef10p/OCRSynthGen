<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 110.4mm; inline-size: 86.5mm; block-size: 92.0mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 141.3mm; inline-size: 86.5mm; block-size: 32.3mm; font-size: 9.0pt">{{ slot_5 }}</p>
