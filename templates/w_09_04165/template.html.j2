}

nav li {
   margin: 0 10px;
}

nav a {
   text-decoration: none;
   color: #333;
}

form {
   display: flex;
   flex-direction: column;
}

input {
   margin: 10px 0;
   padding: 10px;
   border: none;
   border-radius: 5px;
}

button {
   background-color: #333;
   color: white;
   border: none;
   padding: 10px 20px;
   border-radius: 5px;
   cursor: pointer;
}

.menu, .reservation {
