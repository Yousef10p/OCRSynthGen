<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


.fullscreen-bg {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    overflow: hidden;
    z-index: -100;
}
.fullscreen-bg__video {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
}


nav {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 50px;
    background-color: #333;
}
nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 100%;
}
nav a {
    color: #fff;
    text-decoration: none;
}


div {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 50px;
}


footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 50px;
    background-color: #333;
    display: flex;
    justify-content: space-around;
    align-items: center;
}
footer a, footer p {
    color: #fff;
    text-decoration: none;
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div class="fullscreen-bg">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<div id="about">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</div>
<div id="services">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
</div>
<div id="portfolio">
<h1>{{ slot_8 }}</h1>
<p>{{ slot_9 }}</p>
</div>
<div id="contact">
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
</div>
<footer>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
<p>{{ slot_17 }}</p>
</footer>
</body>
</html>