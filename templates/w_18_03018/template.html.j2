}

.grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(100px, auto);
    gap: 1em;
}

.grid-item {
    border: 1px solid #000;
    padding: 1em;
    position: relative;
}

.grid-item div {
    height: 100px;
    width: 100px;
    position: absolute;
    top: 0;
    left: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
