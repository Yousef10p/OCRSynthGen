<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.0mm; inset-block-start: 15.9mm; inline-size: 176.8mm; block-size: 106.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 124.5mm; inline-size: 58.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 133.7mm; inline-size: 86.9mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 133.4mm; inline-size: 87.0mm; block-size: 67.3mm; font-size: 12.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 159.7mm; inline-size: 35.0mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 166.6mm; inline-size: 87.0mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 26.5mm; inset-block-start: 189.6mm; inline-size: 86.2mm; block-size: 59.2mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 205.2mm; inline-size: 30.7mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 210.3mm; inline-size: 87.2mm; block-size: 40.2mm; font-size: 12.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 26.9mm; inset-block-start: 251.1mm; inline-size: 36.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 194.9mm; inset-block-start: 262.8mm; inline-size: 7.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
