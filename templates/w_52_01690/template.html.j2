  margin: 1em;
}

#carousel .carousel-item, #product-grid .grid-item {
  height: 160px;
  border: 1px solid #dee2e6;
  border-radius: 0.25rem;
  padding: 1em;
  background-color: #f1f3f5;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
