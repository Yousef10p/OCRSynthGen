  flex-direction: column;
  align-items: center;
  font-family: var(--font-body);
}

header, footer {
  background-color: #333;
  color: white;
  width: 100%;
  text-align: center;
}

header div {
  font-size: 2em;
  padding: 20px;
}

ul {
  list-style-type: none;
  display: flex;
  justify-content: space-around;
}

a {
  color: white;
  text-decoration: none;
}

main {
  display: flex;
  margin: 20px;
}

.product-img, .testimonial-img, .offer-img {
  width: 150px;
  height: 150px;
  background-color: #aaa;
  margin: 10px;
}

.left-column, .right-column {
  margin: 20px;
}

footer div a {
  margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
