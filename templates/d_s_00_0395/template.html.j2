<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 0.0mm; inline-size: 215.7mm; block-size: 142.6mm; font-size: 15.0pt"></div>
<div class="box ph" style="inset-inline-start: 15.2mm; inset-block-start: 153.9mm; inline-size: 41.5mm; block-size: 82.1mm; font-size: 14.5pt"></div>
<h2 class="box" style="inset-inline-start: 63.5mm; inset-block-start: 156.0mm; inline-size: 43.7mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 135.5mm; inset-block-start: 156.0mm; inline-size: 32.3mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 63.5mm; inset-block-start: 162.1mm; inline-size: 61.1mm; block-size: 64.9mm; font-size: 15.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 135.5mm; inset-block-start: 162.1mm; inline-size: 63.3mm; block-size: 70.6mm; font-size: 15.4pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 16.1mm; inset-block-start: 246.5mm; inline-size: 14.9mm; block-size: 16.7mm; font-size: 15.8pt"></div>
<div class="box ph" style="inset-inline-start: 181.8mm; inset-block-start: 246.5mm; inline-size: 18.1mm; block-size: 16.5mm; font-size: 15.6pt"></div>
<div class="box ph" style="inset-inline-start: 70.1mm; inset-block-start: 247.0mm; inline-size: 20.1mm; block-size: 16.3mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 123.8mm; inset-block-start: 247.4mm; inline-size: 21.2mm; block-size: 13.8mm; font-size: 13.1pt"></div>
<footer class="box" style="inset-inline-start: 171.3mm; inset-block-start: 271.1mm; inline-size: 27.7mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_4 }}</footer>
</div></body>
</html>
