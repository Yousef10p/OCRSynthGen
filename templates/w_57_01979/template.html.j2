}

#menu, #reviews {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
}

#map {
    background: #ddd; 
    height: 200px;
    width:  400px;
}



.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
