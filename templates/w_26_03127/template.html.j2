<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    background-color: #f2f2f2;
    font-family: var(--font-body);
}

header {
    background-color: #1a1a1a;
    color: #fff;
    padding: 20px 15px;
    text-align: center;
}

#slider {
    width: 100%;
    height: 500px;
    background-color: #ddd;
    padding: 50px 0;
    overflow-x: scroll;
    white-space: nowrap;
}

#slider img {
    display: inline-block;
    margin-left: 10px;
}

#services-testimonials {
    display: flex;
    margin: 50px;
}

#services {
    flex: 1;
    margin-left: 50px;
}

#testimonials {
    flex: 1;
}

h2 {
    font-size: 24px;
    color: #1a1a1a;
    margin-bottom: 20px;
}

#case-studies h2 {
    text-align: center;
    margin: 50px 0;
}

.case-study {
    margin: 20px;
    padding: 20px;
    background-color: #fff;
    box-shadow: -1px 1px 5px #ddd;
    text-align: center;
}

.case-study img {
    display: block;
    margin: 50px auto;
}

.case-study a {
    color: #1a1a1a;
    text-decoration: none;
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    border: 1px solid #1a1a1a;
    border-radius: 5px;
}

.case-study a:hover {
    background-color: #1a1a1a;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
