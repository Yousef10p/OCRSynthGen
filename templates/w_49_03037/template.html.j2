<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

.hero-image, .brand, .tagline, .grid-container div, .navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 25vh;
    color: white;
}

.hero-image {
    background-color: #FF6347;
}

.brand {
    background-color: #00008B;
    font-size: 2em;
}

.tagline {
    background-color: #800000;
}

.navigation {
    background-color: #FFD700;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.navigation ul {
    list-style-type: none;
    padding: 0;
}

.navigation ul li {
    display: inline;
    margin: 0 10px;
}

.grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    text-align: center;
}

.product, .blog-post, .social-media {
    border: 1px solid black;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero-image">{{ slot_0 }}</div>
<div class="brand">{{ slot_1 }}</div>
<div class="tagline">{{ slot_2 }}</div>
<div class="navigation">
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="grid-container" id="products">
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
</div>
<div class="grid-container" id="blog">
<div class="blog-post">{{ slot_9 }}</div>
<div class="blog-post">{{ slot_10 }}</div>
<div class="blog-post">{{ slot_11 }}</div>
</div>
<div class="grid-container" id="social-media">
<div class="social-media">{{ slot_12 }}</div>
<div class="social-media">{{ slot_13 }}</div>
<div class="social-media">{{ slot_14 }}</div>
</div>
</body>
</html>