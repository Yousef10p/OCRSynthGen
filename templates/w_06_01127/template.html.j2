<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.product-filter {
    margin-bottom: 20px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
}

.product {
    border: 1px solid #000;
    padding: 10px;
    text-align: center;
}

.product-image {
    background-color: #ccc;
    margin-bottom: 10px;
    height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="product-filter">
<label>{{ slot_0 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</div>
<div class="product-grid">
<div class="product">
<div class="product-image">{{ slot_2 }}</div>
<p>{{ slot_3 }}</p>
<p>{{ slot_4 }}</p>
<p>{{ slot_5 }}</p>
<p>{{ slot_6 }}</p>
</div>
<div class="product">
<div class="product-image">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</div>
<div class="product">
<div class="product-image">{{ slot_12 }}</div>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p></div>
</div>
</body>
</html>