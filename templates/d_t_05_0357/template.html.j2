<h2 class="box" style="inset-inline-start: 25.6mm; inset-block-start: 44.2mm; inline-size: 38.0mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 25.6mm; inset-block-start: 52.4mm; inline-size: 23.9mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 73.5mm; inset-block-start: 52.4mm; inline-size: 20.9mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.6mm; inset-block-start: 59.7mm; inline-size: 19.1mm; block-size: 36.7mm; font-size: 11.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 73.5mm; inset-block-start: 59.7mm; inline-size: 26.1mm; block-size: 7.1mm; font-size: 10.0pt">{{ slot_7 }}</p>
