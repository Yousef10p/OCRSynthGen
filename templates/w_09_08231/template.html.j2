.property, .neighborhood {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 10px;
}

.property .image, .neighborhood .image {
    background-color: #999;
    width: 100%;
    height: 200px;
}

.property .description, .neighborhood .description {
    background-color: #ddd;
    padding: 10px;
}

.footer {
    background-color: #333;
    color: #fff;
    padding: 10px;
    margin-top: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
