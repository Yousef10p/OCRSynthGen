  padding: 0;
  overflow: hidden;
}

nav ul li {
  float: right;
  border-left:1px solid #bbb;
}

nav ul li a {
  display: block;
  color: black;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}

.menu-item {
