<div class="box ph" style="inset-inline-start: 85.9mm; inset-block-start: 83.4mm; inline-size: 107.1mm; block-size: 3.8mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 97.4mm; inline-size: 170.2mm; block-size: 27.0mm; font-size: 10.9pt">{{ slot_2 }}</p>
