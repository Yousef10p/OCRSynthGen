<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 67.9mm; inline-size: 45.5mm; block-size: 18.5mm; font-size: 10.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 108.9mm; inset-block-start: 75.0mm; inline-size: 58.6mm; block-size: 38.0mm; font-size: 10.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 56.9mm; inset-block-start: 97.2mm; inline-size: 6.3mm; block-size: 7.8mm; font-size: 22.1pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 110.8mm; inline-size: 60.1mm; block-size: 26.3mm; font-size: 10.7pt">{{ slot_7 }}</p>
