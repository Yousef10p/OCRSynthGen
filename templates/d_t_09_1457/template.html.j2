<p class="box" style="inset-inline-start: 31.4mm; inset-block-start: 136.2mm; inline-size: 54.7mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 147.2mm; inline-size: 165.1mm; block-size: 15.3mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 62.4mm; inset-block-start: 166.8mm; inline-size: 128.1mm; block-size: 12.9mm; font-size: 10.9pt"></div>
