<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 19.2mm; inline-size: 3.9mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 25.8mm; inline-size: 77.6mm; block-size: 31.4mm; font-size: 12.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 61.1mm; inline-size: 3.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 67.7mm; inline-size: 55.1mm; block-size: 81.0mm; font-size: 12.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 152.6mm; inline-size: 3.9mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 159.2mm; inline-size: 39.1mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 176.4mm; inline-size: 3.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 183.1mm; inline-size: 102.2mm; block-size: 67.5mm; font-size: 12.8pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.7mm; inline-size: 5.7mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
