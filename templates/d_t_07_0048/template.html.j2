<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 119.7mm; inline-size: 164.3mm; block-size: 7.2mm; font-size: 9.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 129.1mm; inline-size: 165.1mm; block-size: 21.8mm; font-size: 9.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 153.0mm; inline-size: 39.8mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_6 }}</h2>
