<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	font-family: var(--font-body);
}

header {
	position: fixed;
	top: 0;
	right: 0;
	width: 100%;
	padding: 20px;
	background: #333;
	color: #fff;
}

nav ul {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

nav ul li {
	display: inline;
	margin-left: 20px;
}

nav ul li:last-child {
	margin-left: 0;
}

nav ul li a {
	color: #fff;
	text-decoration: none;
}

.hero {
	height: 100vh;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	text-align: center;
	background: #ccc;
}

.hero-img {
	width: 200px;
	height: 200px;
	background: #666;
}

.product-category {
	display: flex;
	justify-content: space-between;
	margin: 20px;
	border-bottom: 1px solid #ccc;
}

.product-category div {
	width: 200px;
	height: 200px;
	background: #666;
}

.product-category h2 {
	margin-bottom: 20px;
}

.cart {
	background: #000;
	color: #fff;
	padding: 10px;
	border-radius: 5px;
	text-decoration: none;
}

.cta-button {
	background: #000;
	color: #fff;
	padding: 10px;
	border-radius: 5px;
	text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
