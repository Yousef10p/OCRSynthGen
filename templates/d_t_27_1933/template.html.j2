<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 16.8mm; inline-size: 197.6mm; block-size: 16.1mm; font-size: 13.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 35.1mm; inline-size: 199.1mm; block-size: 9.6mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 46.7mm; inline-size: 196.5mm; block-size: 43.3mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 92.1mm; inline-size: 199.2mm; block-size: 36.2mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 130.5mm; inline-size: 199.3mm; block-size: 19.3mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 151.8mm; inline-size: 166.1mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 156.9mm; inline-size: 197.3mm; block-size: 16.1mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 175.2mm; inline-size: 195.3mm; block-size: 6.3mm; font-size: 13.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 183.5mm; inline-size: 199.0mm; block-size: 6.3mm; font-size: 13.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 103.2mm; inset-block-start: 198.4mm; inline-size: 3.4mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
