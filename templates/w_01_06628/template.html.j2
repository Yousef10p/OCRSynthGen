}

#featured-deals .deal h3 {
    width: 30%;
}

#featured-deals .deal .deal-image {
    width: 60%;
    height: 100px;
    background-color: black;
}

#privacy-issues {
    position: absolute;
    top: 230px;
    right: 10px;
    width: 30%;
    background-color: lightpink;
}

#privacy-issues .privacy-issue {
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
