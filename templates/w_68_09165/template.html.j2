<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.header {
    text-align: center;
    background-color: #FFE4C4;
    padding: 20px;
}

.content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 20px;
    padding: 20px;
}

.food-img {
    height: 100px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 14px;
}

.recipe, .recommendation, .booking {
    border: 1px solid #FFE4E1;
    padding: 30px;
}

.button {
    background-color: #FA8072;
    color: white;
    padding: 10px 20px;
    border: none;
    cursor: pointer;
}

input, textarea {
    width: 100%;
    margin-bottom: 20px;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
<button class="button">{{ slot_1 }}</button>
</div>
<div class="content">
<div class="recipe">
<h2>{{ slot_2 }}</h2>
<div class="food-img" style="background-color: #FFE4E1;">{{ slot_3 }}</div>
<p>{{ slot_4 }}</p>
<a>{{ slot_5 }}</a>
</div>
<div class="recommendation">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div class="booking">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_12 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
<span class="">{{ slot_14 }}</span>
</form>
</div>
</div>
</body>
</html>