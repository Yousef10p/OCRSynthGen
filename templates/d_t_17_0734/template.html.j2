<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 25.8mm; inset-block-start: 15.9mm; inline-size: 176.8mm; block-size: 121.9mm; font-size: 21.6pt"></div>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 139.9mm; inline-size: 63.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 149.1mm; inline-size: 45.7mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 148.8mm; inline-size: 86.9mm; block-size: 40.2mm; font-size: 12.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 154.3mm; inline-size: 86.9mm; block-size: 26.7mm; font-size: 12.6pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 25.6mm; inset-block-start: 184.8mm; inline-size: 87.7mm; block-size: 59.4mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 193.9mm; inline-size: 87.0mm; block-size: 26.7mm; font-size: 12.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 225.6mm; inline-size: 24.0mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 230.8mm; inline-size: 86.9mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 246.3mm; inline-size: 47.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 196.9mm; inset-block-start: 262.8mm; inline-size: 5.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
