<div class="slider-image ph"></div>
<div class="slider-image ph"></div>
</section>

<section class="main">
<div class="concert-schedule">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</div>
<div class="playlist">
