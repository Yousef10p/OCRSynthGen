<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 88.9mm; inset-block-start: 12.8mm; inline-size: 38.1mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 178.1mm; inset-block-start: 12.8mm; inline-size: 13.3mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 103.0mm; inset-block-start: 26.5mm; inline-size: 10.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 58.4mm; inset-block-start: 34.8mm; inline-size: 100.2mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 59.2mm; inline-size: 135.6mm; block-size: 3.9mm; font-size: 11.2pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 37.0mm; inset-block-start: 71.9mm; inline-size: 142.8mm; block-size: 64.4mm; font-size: 30.4pt"></div>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 144.2mm; inline-size: 154.2mm; block-size: 8.0mm; font-size: 11.3pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 40.0mm; inset-block-start: 156.1mm; inline-size: 136.1mm; block-size: 89.7mm; font-size: 40.0pt"></div>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 262.7mm; inline-size: 16.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 98.8mm; inset-block-start: 262.7mm; inline-size: 18.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
