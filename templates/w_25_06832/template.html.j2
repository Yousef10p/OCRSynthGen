<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
}

nav {
    background-color: #333;
    color: #fff;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

nav li {
    list-style: none;
    padding: 1em;
}

.slideshow {
    display: flex;
    justify-content: space-around;
}

.slide {
    background-color: #ccc;
    height: 200px;
    width: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
}

article {
    margin: 2em;
}

footer {
    background-color: #333;
    color: #fff;
}

.footer-menu ul {
    display: flex;
    justify-content: space-around;
}

.footer-menu li {
    list-style: none;
    padding: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<div class="slideshow">
<div class="slide" id="slide1">{{ slot_3 }}</div>
<div class="slide" id="slide2">{{ slot_4 }}</div>
<div class="slide" id="slide3">{{ slot_5 }}</div>
</div>
<article class="article1">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</article>
<article class="article2">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</article>
<article class="article3">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</article>
<footer>
<div class="footer-menu">
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</div>
</footer>
</body>
</html>