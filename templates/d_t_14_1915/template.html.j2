<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 80.7mm; inset-block-start: 12.3mm; inline-size: 54.7mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 78.1mm; inset-block-start: 23.7mm; inline-size: 60.2mm; block-size: 7.8mm; font-size: 22.2pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 46.4mm; inset-block-start: 42.8mm; inline-size: 123.5mm; block-size: 7.8mm; font-size: 22.2pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 97.7mm; inset-block-start: 58.7mm; inline-size: 20.8mm; block-size: 7.8mm; font-size: 22.2pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 75.8mm; inset-block-start: 76.7mm; inline-size: 64.7mm; block-size: 7.8mm; font-size: 22.2pt">{{ slot_4 }}</h2>
<footer class="box" style="inset-inline-start: 93.3mm; inset-block-start: 260.2mm; inline-size: 23.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 162.0mm; inset-block-start: 267.9mm; inline-size: 28.5mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 157.2mm; inset-block-start: 275.6mm; inline-size: 33.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
