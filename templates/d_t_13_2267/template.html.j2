<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 27.4mm; inset-block-start: 22.5mm; inline-size: 168.1mm; block-size: 17.9mm; font-size: 25.4pt"></div>
<h2 class="box" style="inset-inline-start: 30.0mm; inset-block-start: 44.8mm; inline-size: 35.2mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 27.6mm; inset-block-start: 49.5mm; inline-size: 164.4mm; block-size: 110.3mm; font-size: 14.9pt"></div>
<h2 class="box" style="inset-inline-start: 30.0mm; inset-block-start: 164.3mm; inline-size: 43.4mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 170.9mm; inline-size: 155.9mm; block-size: 14.2mm; font-size: 13.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 188.5mm; inline-size: 155.9mm; block-size: 19.0mm; font-size: 13.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 211.1mm; inline-size: 155.8mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 27.6mm; inset-block-start: 222.0mm; inline-size: 167.9mm; block-size: 17.7mm; font-size: 25.0pt"></div>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 246.2mm; inline-size: 155.9mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 272.7mm; inline-size: 45.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 170.2mm; inset-block-start: 280.7mm; inline-size: 20.7mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
