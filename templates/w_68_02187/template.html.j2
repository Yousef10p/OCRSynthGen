  margin: 0;
  padding: 0;
}
body {
  font-family: var(--font-body);
}
header {
  background: #333;
  color: #fff;
  padding: 20px 0;
}
nav ul {
  display: flex;
  list-style: none;
  justify-content: space-around;
}
nav ul li a {
  color: #fff;
  text-decoration: none;
}
main {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  grid-gap: 20px;
  padding: 20px;
}
section, aside {
  background: #eee;
  padding: 20px;
}
.car-img, .truck-img {
  width: 100%;
  height: 200px;
  background: purple;
}
form {
  display: flex;
  flex-direction: column;
}
input, button, textarea {
  margin-bottom: 10px;
}
footer {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
