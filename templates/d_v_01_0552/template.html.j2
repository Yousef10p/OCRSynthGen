<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 35.3mm; inset-block-start: 15.6mm; inline-size: 46.8mm; block-size: 19.3mm; font-size: 13.6pt"></div>
<header class="box" style="inset-inline-start: 86.1mm; inset-block-start: 31.6mm; inline-size: 52.8mm; block-size: 8.1mm; font-size: 22.9pt">{{ slot_0 }}</header><ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 64.2mm; inline-size: 142.2mm; block-size: 31.1mm; font-size: 14.7pt"><li>{{ slot_1 }}</li></ul>
<h2 class="box" style="inset-inline-start: 31.6mm; inset-block-start: 98.5mm; inline-size: 47.4mm; block-size: 7.3mm; font-size: 20.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 108.0mm; inline-size: 147.9mm; block-size: 30.8mm; font-size: 14.6pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 31.6mm; inset-block-start: 140.7mm; inline-size: 119.1mm; block-size: 5.7mm; font-size: 16.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 148.1mm; inline-size: 147.9mm; block-size: 15.6mm; font-size: 14.7pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 31.6mm; inset-block-start: 165.5mm; inline-size: 147.6mm; block-size: 15.8mm; font-size: 15.0pt">{{ slot_6 }}</h2>
<footer class="box" style="inset-inline-start: 31.6mm; inset-block-start: 259.7mm; inline-size: 12.1mm; block-size: 15.8mm; font-size: 40.0pt">{{ slot_7 }}</footer><div class="box ph" style="inset-inline-start: 111.6mm; inset-block-start: 262.1mm; inline-size: 10.4mm; block-size: 6.9mm; font-size: 19.5pt"></div>
<footer class="box" style="inset-inline-start: 159.2mm; inset-block-start: 265.4mm; inline-size: 20.1mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
