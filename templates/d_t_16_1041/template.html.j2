<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.3mm; inset-block-start: 16.1mm; inline-size: 86.3mm; block-size: 54.8mm; font-size: 15.5pt"></div>
<div class="box ph" style="inset-inline-start: 116.2mm; inset-block-start: 16.2mm; inline-size: 86.7mm; block-size: 74.4mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 73.6mm; inline-size: 86.5mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 26.4mm; inset-block-start: 90.6mm; inline-size: 86.2mm; block-size: 76.9mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 116.9mm; inset-block-start: 93.0mm; inline-size: 86.4mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 110.8mm; inline-size: 86.7mm; block-size: 26.7mm; font-size: 12.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 142.4mm; inline-size: 87.0mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 116.4mm; inset-block-start: 155.1mm; inline-size: 86.2mm; block-size: 94.1mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 170.1mm; inline-size: 86.6mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 183.3mm; inline-size: 86.9mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 196.9mm; inline-size: 21.1mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 202.1mm; inline-size: 87.1mm; block-size: 53.8mm; font-size: 12.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 252.0mm; inline-size: 84.3mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 192.9mm; inset-block-start: 262.8mm; inline-size: 9.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
