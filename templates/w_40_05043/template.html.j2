<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: #333;
    background-color: #f4f4f4;
}


header {
    background-color: #009933;
    text-align: center;
    padding: 10px;
}

.green-rectangle {
    background-color: #009933;
    height: 200px;  
    width: 100%;  
}


nav {
    background-color: #006633;
    padding: 10px;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: white;
    text-decoration: none;
}


.form-container {
    margin: 20px;
    padding: 10px;
    border: 1px solid #006633;
}

.form-container input[type="text"] {
    display: block;
    margin: 10px 0;
}

.form-container button[type="submit"] {
    float: left;
    background-color: #006633;
    color: white;
    border: none;
    padding: 5px;
    cursor: pointer;
}


.class-container {
    display: flex;
    justify-content: space-between;
    padding: 20px;
}

.class-element {
    border: 1px solid #006633;
    padding: 10px;
    width: calc(33.33% - 20px);  
}

.class-element img {
    height: 200px;  
    width: 100%;  
}


footer {
    background-color: #006633;
    color: white;
    text-align: center;
    padding: 5px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
