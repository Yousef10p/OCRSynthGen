  padding: 10px;
  background: #007bff;
  color: white;
  border: none;
  cursor: pointer;
}

.footer {
  display: flex;
  justify-content: space-between;
  background: #f8f9fa;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
