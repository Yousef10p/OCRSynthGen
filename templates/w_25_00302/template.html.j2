.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #333;
}
header, footer {
    background-color: #BADA55;
    padding: 20px;
    text-align: center;
}
nav ul {
    list-style-type: none;
}
nav ul li {
    display: inline;
    margin: 0 10px;
}
.image-placeholder {
    background-color: #777;
    height: 200px;
    margin: 20px 0;
}
main {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
}
section {
    margin: 20px;
}
h1, h2 {
    margin: 0;
}
a {
    color: #369;
    text-decoration: none;
}
a:hover {
    color: #145;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
