<div class="box ph" style="inset-inline-start: 29.8mm; inset-block-start: 134.8mm; inline-size: 136.3mm; block-size: 19.9mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 157.7mm; inline-size: 144.9mm; block-size: 15.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
