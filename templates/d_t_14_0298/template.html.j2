<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 71.4mm; inset-block-start: 18.3mm; inline-size: 47.2mm; block-size: 5.0mm; font-size: 14.3pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 28.7mm; inline-size: 72.1mm; block-size: 5.0mm; font-size: 14.3pt">{{ slot_1 }}</h2>
<ul class="box" style="inset-inline-start: 20.5mm; inset-block-start: 34.8mm; inline-size: 170.7mm; block-size: 9.3mm; font-size: 13.2pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.5mm; inset-block-start: 45.4mm; inline-size: 171.0mm; block-size: 33.6mm; font-size: 11.9pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.5mm; inset-block-start: 80.2mm; inline-size: 171.1mm; block-size: 33.6mm; font-size: 11.9pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.5mm; inset-block-start: 115.1mm; inline-size: 170.5mm; block-size: 13.3mm; font-size: 12.6pt"><li>{{ slot_5 }}</li></ul>
<footer class="box" style="inset-inline-start: 174.5mm; inset-block-start: 282.0mm; inline-size: 18.3mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
