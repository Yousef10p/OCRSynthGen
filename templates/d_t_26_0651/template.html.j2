<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 25.2mm; inline-size: 146.5mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 41.5mm; inline-size: 144.8mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 22.4mm; inset-block-start: 58.5mm; inline-size: 170.7mm; block-size: 128.4mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 187.7mm; inline-size: 113.4mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 196.8mm; inline-size: 107.6mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 204.6mm; inline-size: 119.5mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 210.7mm; inline-size: 144.3mm; block-size: 45.5mm; font-size: 10.7pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 22.9mm; inset-block-start: 266.3mm; inline-size: 112.1mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
