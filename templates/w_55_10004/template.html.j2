}

form {
  display: grid;
  grid-template-columns: 1fr 2fr;
}

form label {
  grid-column: 1 / 2;
}

form input,
form textarea {
  grid-column: 2 / 3;
}

button {
  grid-column: 2 / 3;
}

footer {
  background: #222;
  color: #fff;
  text-align: center;
  padding: 1em 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
