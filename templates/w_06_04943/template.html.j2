}

nav {
    background-color: #00ff00;
    color: #ffffff;
    padding: 10px;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 5px;
}

main {
    background-color: #0000ff;
    color: #ffffff;
    padding: 10px;
    float: right;
    width: 70%;
}

aside {
