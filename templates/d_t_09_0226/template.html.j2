<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 86.8mm; inset-block-start: 40.9mm; inline-size: 91.6mm; block-size: 13.9mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 57.1mm; inline-size: 135.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 65.1mm; inline-size: 135.0mm; block-size: 13.1mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 49.7mm; inset-block-start: 82.4mm; inline-size: 113.3mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 43.4mm; inset-block-start: 97.0mm; inline-size: 53.5mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 107.9mm; inline-size: 135.0mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 67.4mm; inset-block-start: 139.5mm; inline-size: 111.1mm; block-size: 7.9mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 155.6mm; inline-size: 135.0mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 80.6mm; inset-block-start: 176.2mm; inline-size: 97.9mm; block-size: 15.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 194.9mm; inline-size: 135.0mm; block-size: 36.2mm; font-size: 12.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 43.4mm; inset-block-start: 234.7mm; inline-size: 65.5mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 245.7mm; inline-size: 137.2mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 107.9mm; inset-block-start: 279.7mm; inline-size: 6.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
