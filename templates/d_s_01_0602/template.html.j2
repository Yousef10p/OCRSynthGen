<p class="box" style="inset-inline-start: 10.8mm; inset-block-start: 93.4mm; inline-size: 85.4mm; block-size: 29.6mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 10.9mm; inset-block-start: 123.3mm; inline-size: 84.2mm; block-size: 54.6mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 10.6mm; inset-block-start: 178.2mm; inline-size: 85.1mm; block-size: 61.9mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 101.2mm; inset-block-start: 209.5mm; inline-size: 88.4mm; block-size: 52.6mm; font-size: 11.9pt">{{ slot_7 }}</p>
