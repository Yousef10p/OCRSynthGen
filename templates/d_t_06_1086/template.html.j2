<div class="box ph" style="inset-inline-start: 20.7mm; inset-block-start: 171.6mm; inline-size: 52.3mm; block-size: 55.4mm; font-size: 15.7pt"></div>
<p class="box" style="inset-inline-start: 80.2mm; inset-block-start: 199.2mm; inline-size: 57.7mm; block-size: 20.6mm; font-size: 11.7pt">{{ slot_4 }}</p>
