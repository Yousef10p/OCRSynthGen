<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 31.8mm; inset-block-start: 25.5mm; inline-size: 112.5mm; block-size: 5.1mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 38.1mm; inset-block-start: 36.1mm; inline-size: 79.7mm; block-size: 5.1mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 46.7mm; inline-size: 159.9mm; block-size: 59.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.7mm; inline-size: 40.5mm; block-size: 5.1mm; font-size: 12.0pt">{{ slot_3 }}</h2>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 124.5mm; inline-size: 156.4mm; block-size: 20.7mm; font-size: 12.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 148.0mm; inline-size: 152.8mm; block-size: 28.6mm; font-size: 12.0pt"><li>{{ slot_5 }}</li></ul>
<h2 class="box" style="inset-inline-start: 31.8mm; inset-block-start: 189.8mm; inline-size: 53.5mm; block-size: 5.1mm; font-size: 12.0pt">{{ slot_6 }}</h2>
<h2 class="box" style="inset-inline-start: 31.8mm; inset-block-start: 200.4mm; inline-size: 69.4mm; block-size: 5.1mm; font-size: 12.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 208.2mm; inline-size: 159.9mm; block-size: 28.5mm; font-size: 12.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 173.2mm; inset-block-start: 250.1mm; inline-size: 16.4mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
