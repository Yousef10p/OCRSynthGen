<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 25.9mm; inline-size: 84.2mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 112.4mm; inset-block-start: 25.9mm; inline-size: 72.0mm; block-size: 8.8mm; font-size: 12.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 30.8mm; inline-size: 86.1mm; block-size: 78.1mm; font-size: 13.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 112.4mm; inset-block-start: 35.8mm; inline-size: 86.2mm; block-size: 73.1mm; font-size: 13.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 112.4mm; inset-block-start: 110.0mm; inline-size: 85.0mm; block-size: 68.2mm; font-size: 13.8pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 115.0mm; inline-size: 69.6mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_5 }}</h2>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 119.9mm; inline-size: 59.5mm; block-size: 8.8mm; font-size: 12.4pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 129.8mm; inline-size: 85.0mm; block-size: 23.6mm; font-size: 13.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 154.6mm; inline-size: 84.9mm; block-size: 23.6mm; font-size: 13.4pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 112.4mm; inset-block-start: 179.3mm; inline-size: 86.1mm; block-size: 58.3mm; font-size: 13.8pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 106.2mm; inset-block-start: 286.8mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_10 }}</footer><footer class="box" style="inset-inline-start: 141.4mm; inset-block-start: 287.3mm; inline-size: 56.2mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_11 }}</footer>
</div></body>
</html>
