<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
<h3>{{ slot_5 }}</h3>
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
</div>
<div class="sidebar-right">
<h3>{{ slot_8 }}</h3>
<ul>
