<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 75.3mm; inset-block-start: 29.1mm; inline-size: 110.6mm; block-size: 38.0mm; font-size: 13.4pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 75.3mm; inset-block-start: 69.7mm; inline-size: 109.6mm; block-size: 23.7mm; font-size: 13.4pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 96.1mm; inline-size: 108.5mm; block-size: 23.7mm; font-size: 13.4pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 75.3mm; inset-block-start: 127.4mm; inline-size: 69.1mm; block-size: 8.3mm; font-size: 23.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 137.7mm; inline-size: 109.9mm; block-size: 14.2mm; font-size: 13.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 154.7mm; inline-size: 106.5mm; block-size: 23.7mm; font-size: 13.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 181.1mm; inline-size: 107.3mm; block-size: 28.5mm; font-size: 13.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 212.2mm; inline-size: 109.0mm; block-size: 19.0mm; font-size: 13.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 75.3mm; inset-block-start: 233.9mm; inline-size: 106.2mm; block-size: 19.0mm; font-size: 13.4pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 185.3mm; inset-block-start: 278.6mm; inline-size: 6.3mm; block-size: 4.5mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
