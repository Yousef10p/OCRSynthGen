<p class="box" style="inset-inline-start: 140.7mm; inset-block-start: 114.6mm; inline-size: 55.9mm; block-size: 75.2mm; font-size: 13.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 80.2mm; inset-block-start: 131.5mm; inline-size: 56.1mm; block-size: 46.7mm; font-size: 13.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 80.2mm; inset-block-start: 181.5mm; inline-size: 56.0mm; block-size: 51.5mm; font-size: 13.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 183.6mm; inline-size: 56.3mm; block-size: 46.7mm; font-size: 13.2pt">{{ slot_6 }}</p>
