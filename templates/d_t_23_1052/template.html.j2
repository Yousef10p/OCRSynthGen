<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 46.6mm; inline-size: 145.6mm; block-size: 12.4mm; font-size: 17.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 70.8mm; inline-size: 116.8mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 87.1mm; inline-size: 146.0mm; block-size: 37.1mm; font-size: 21.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 135.8mm; inline-size: 145.8mm; block-size: 21.1mm; font-size: 19.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 168.9mm; inline-size: 23.2mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_7 }}</p>
