:root {
    --green: #006400;
    --white: #f0f0f0;
    --black: #222;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    color: var(--black);
    background-color: var(--white);
    font-family: var(--font-body);
}

.rectangle {
    width: 100px;
    height: 100px;
    background-color: var(--green);
}

a {
    color: var(--white);
    text-decoration: none;
}

button {
    background-color: var(--green);
    color: var(--white);
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}


.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    grid-gap: 10px;
    margin: 1em 0;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
