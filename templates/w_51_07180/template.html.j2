<p>{{ slot_6 }}</p>
</div>
<div>
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</div>
<div>
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
</div>
</div>
</div>
<div class="portfolio">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<div class="portfolio-container">
<div>{{ slot_13 }}</div>
<div>{{ slot_14 }}</div>
<div>{{ slot_15 }}</div>
</div>
</div>
</body>
</html>