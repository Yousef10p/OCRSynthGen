<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.3mm; inset-block-start: 26.0mm; inline-size: 106.1mm; block-size: 34.1mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 74.2mm; inline-size: 53.0mm; block-size: 112.9mm; font-size: 13.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 78.0mm; inset-block-start: 74.2mm; inline-size: 55.8mm; block-size: 93.5mm; font-size: 12.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 136.1mm; inset-block-start: 118.1mm; inline-size: 53.7mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 136.1mm; inset-block-start: 141.8mm; inline-size: 51.9mm; block-size: 41.4mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 78.0mm; inset-block-start: 173.7mm; inline-size: 52.6mm; block-size: 55.6mm; font-size: 13.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 192.6mm; inline-size: 51.6mm; block-size: 74.6mm; font-size: 13.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 136.1mm; inset-block-start: 193.9mm; inline-size: 53.9mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 136.1mm; inset-block-start: 212.9mm; inline-size: 33.7mm; block-size: 55.6mm; font-size: 12.1pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 78.0mm; inset-block-start: 235.3mm; inline-size: 38.1mm; block-size: 22.4mm; font-size: 12.7pt">{{ slot_9 }}</p>
</div></body>
</html>
