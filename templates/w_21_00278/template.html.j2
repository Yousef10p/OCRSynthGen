}

aside, section {
  border: 1px solid darkgray;
}

.review, #main-product, #secondary-product1, #secondary-product2 {
  background-color: lightgray;
  height: 25px;
  margin-bottom: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
