    align-items: center;
}

.course-box, .blog-post {
    border: 1px solid black;
    width: 50%;
    text-align: center;
    padding: 10px 0;
    margin: 20px 0;
}

a.cta {
    background: green;
    color: white;
    padding: 10px;
    border-radius: 5px;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
