}

footer form input[type="text"], footer form input[type="email"] {
  width: 100%;
}

footer form button {
  background-color: #333;
  color: white;
  padding: 10px;
  border: none;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
