<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.4; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 24mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-end: 1px solid #444"><span>{{ slot_0 }}</span></header><h1 style="font-size: calc(var(--base-size) * 2.6); text-align: center; margin-block: 0.3em 0.5em">{{ slot_1 }}</h1>
<p style="font-size: 1.2em; text-align: center; margin-block: 0 1em">{{ slot_2 }}</p>
<main><ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: justify; font-size: 1.05em">{{ slot_5 }}</p>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 39mm; margin-inline: auto; inline-size: 50%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_6 }}</figcaption></figure><p style="margin-block: 0 0.4em; text-indent: 0; text-align: var(--align); font-size: 1.05em">{{ slot_7 }}</p>
<ol style="list-style-type: decimal; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}<ol style="list-style-type: decimal; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
</ol>
</li>
<li>{{ slot_13 }}</li>
</ol>
<h3 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 0.6em 0.4em">{{ slot_14 }}</h3>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 44mm; margin-inline: auto; inline-size: 100%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_15 }}</figcaption></figure><div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em"><p style="margin-block: 0.15em">{{ slot_16 }}</p></div></main>
</div></body>
</html>
