  width: 70%;
  padding: 10px;
}


.aside:after, .main:after {
  content: "";
  display: block;
  clear: both;
  height: 200px;
  background: #ababab;
}


@media(min-width:960px) {
  .aside {
    width: 35%;
  }

  .main {
    width: 60%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
