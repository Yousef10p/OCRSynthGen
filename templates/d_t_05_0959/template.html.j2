<h2 class="box" style="inset-inline-start: 101.0mm; inset-block-start: 129.1mm; inline-size: 20.5mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 101.0mm; inset-block-start: 138.2mm; inline-size: 103.1mm; block-size: 9.0mm; font-size: 12.8pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 101.0mm; inset-block-start: 150.2mm; inline-size: 111.0mm; block-size: 9.0mm; font-size: 12.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 101.0mm; inset-block-start: 161.5mm; inline-size: 99.2mm; block-size: 9.0mm; font-size: 12.8pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 101.0mm; inset-block-start: 173.5mm; inline-size: 102.4mm; block-size: 9.0mm; font-size: 12.8pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 192.1mm; inline-size: 87.1mm; block-size: 41.7mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 90.3mm; inset-block-start: 191.9mm; inline-size: 64.8mm; block-size: 41.8mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 237.2mm; inline-size: 86.9mm; block-size: 41.8mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 90.3mm; inset-block-start: 237.2mm; inline-size: 64.9mm; block-size: 42.0mm; font-size: 14.9pt"></div>
<footer class="box" style="inset-inline-start: 176.2mm; inset-block-start: 270.3mm; inline-size: 26.8mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_5 }}</footer>
</div></body>
</html>
