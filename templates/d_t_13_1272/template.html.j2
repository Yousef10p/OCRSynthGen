<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 25.6mm; inset-block-start: 30.5mm; inline-size: 32.4mm; block-size: 30.7mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 65.0mm; inset-block-start: 31.1mm; inline-size: 109.8mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 65.0mm; inset-block-start: 52.2mm; inline-size: 36.7mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 85.4mm; inset-block-start: 98.5mm; inline-size: 40.3mm; block-size: 6.9mm; font-size: 19.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 83.8mm; inset-block-start: 109.5mm; inline-size: 43.5mm; block-size: 6.9mm; font-size: 19.5pt">{{ slot_3 }}</p>
<h1 class="box" style="inset-inline-start: 31.2mm; inset-block-start: 142.0mm; inline-size: 149.6mm; block-size: 22.1mm; font-size: 31.3pt">{{ slot_4 }}</h1>
<h1 class="box" style="inset-inline-start: 68.5mm; inset-block-start: 167.9mm; inline-size: 74.5mm; block-size: 8.5mm; font-size: 24.2pt">{{ slot_5 }}</h1>
<h1 class="box" style="inset-inline-start: 50.7mm; inset-block-start: 180.2mm; inline-size: 108.7mm; block-size: 14.7mm; font-size: 40.0pt">{{ slot_6 }}</h1>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 278.6mm; inline-size: 2.4mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
