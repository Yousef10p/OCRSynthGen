<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 70.8mm; inset-block-start: 24.1mm; inline-size: 41.6mm; block-size: 3.2mm; font-size: 9.1pt"><li>{{ slot_0 }}</li></ul>
<p class="box" style="inset-inline-start: 84.6mm; inset-block-start: 31.1mm; inline-size: 103.9mm; block-size: 11.0mm; font-size: 10.4pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 70.8mm; inset-block-start: 43.1mm; inline-size: 45.1mm; block-size: 3.2mm; font-size: 9.1pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 84.6mm; inset-block-start: 50.1mm; inline-size: 104.8mm; block-size: 22.6mm; font-size: 10.7pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 70.8mm; inset-block-start: 73.7mm; inline-size: 44.1mm; block-size: 3.2mm; font-size: 9.1pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 84.6mm; inset-block-start: 80.7mm; inline-size: 105.3mm; block-size: 11.0mm; font-size: 10.4pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 57.0mm; inset-block-start: 97.3mm; inline-size: 123.9mm; block-size: 8.8mm; font-size: 12.5pt"><li>{{ slot_6 }}</li></ul>
<footer class="box" style="inset-inline-start: 21.1mm; inset-block-start: 264.0mm; inline-size: 57.9mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_7 }}</footer>
</div></body>
</html>
