    max-width: 600px;
}

form input, form textarea {
    margin: 0.5em 0;
    padding: 1em;
    border: 1px solid #ced4da;
}

form button {
    background-color: #007bff;
    color: #fff;
    border: none;
    padding: 1em;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
