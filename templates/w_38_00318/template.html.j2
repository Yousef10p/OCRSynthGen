</form>
</header>

<main>
<section class="products">
<h2>{{ slot_2 }}</h2>
<div class="product" id="prod1">{{ slot_3 }}</div>
<div class="product" id="prod2">{{ slot_4 }}</div>
<div class="product" id="prod3">{{ slot_5 }}</div>

</section>
<section class="categories">
<h2>{{ slot_6 }}</h2>
<div class="category" id="cat1">{{ slot_7 }}</div>
<div class="category" id="cat2">{{ slot_8 }}</div>
<div class="category" id="cat3">{{ slot_9 }}</div>

</section>
</main>

<aside>
<div class="blog">{{ slot_10 }}</div>
<div class="customer-review">{{ slot_11 }}</div>
<div id="social-links">
