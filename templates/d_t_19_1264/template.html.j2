<div class="box ph" style="inset-inline-start: 35.6mm; inset-block-start: 52.8mm; inline-size: 139.5mm; block-size: 16.0mm; font-size: 22.7pt"></div>
<p class="box" style="inset-inline-start: 79.3mm; inset-block-start: 73.0mm; inline-size: 51.7mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 34.7mm; inset-block-start: 83.7mm; inline-size: 141.0mm; block-size: 18.5mm; font-size: 17.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 47.4mm; inset-block-start: 105.8mm; inline-size: 43.3mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.5mm; inset-block-start: 115.3mm; inline-size: 141.0mm; block-size: 18.5mm; font-size: 17.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 47.5mm; inset-block-start: 136.9mm; inline-size: 121.8mm; block-size: 50.3mm; font-size: 17.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 34.5mm; inset-block-start: 192.1mm; inline-size: 141.3mm; block-size: 31.7mm; font-size: 18.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 47.5mm; inset-block-start: 227.1mm; inline-size: 104.3mm; block-size: 10.7mm; font-size: 15.2pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 34.7mm; inset-block-start: 242.9mm; inline-size: 141.9mm; block-size: 25.2mm; font-size: 17.9pt">{{ slot_9 }}</p>
</div></body>
</html>
