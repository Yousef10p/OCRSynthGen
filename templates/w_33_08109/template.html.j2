}

h1, h2, h3, h4, h5, h6 {
    text-align: center;
}

header {
    margin: 1em 0;
}

#navbar {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    background-color: #f8f8f8;
    text-align: center;
}

#navbar ul {
    margin: 0;
    padding: 0;
}

#navbar li {
    display: inline;
    margin: 0 1em;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 10px;
    grid-auto-rows: minmax(100px, auto);
    margin: 2em;
}

.grid-item {
    background-color: #ddd;
    padding: 20px;
}

footer {
    position: fixed;
    right: 0;
    bottom: 0;
    width: 100%;
    background-color: #f8f8f8;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
