<span class="icon">{{ slot_1 }}</span>
<span class="icon">{{ slot_2 }}</span>
<span class="icon">{{ slot_3 }}</span>
</div>
</header>
<nav>
<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
<a>{{ slot_6 }}</a>
</nav>
<aside>
<h2>{{ slot_7 }}</h2>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
</aside>
<main>
<article>
<h1>{{ slot_11 }}</h1>
<p>{{ slot_12 }}</p>
</article>

</main>
<footer>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>