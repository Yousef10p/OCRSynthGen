<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</nav>
<header class="header">
<div class="logo">
<p class="logo-text">{{ slot_4 }}</p>
</div>
</header>
<section class="services">
<h2>{{ slot_5 }}</h2>
<div class="service">
<h3>{{ slot_6 }}</h3>
<p>{{ slot_7 }}</p>
<div class="placeholder">{{ slot_8 }}</div>
</div>
<div class="service">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<div class="placeholder">{{ slot_11 }}</div>
</div>
<div class="service">
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<div class="placeholder">{{ slot_14 }}</div>
</div>
</section>
</body>
</html>