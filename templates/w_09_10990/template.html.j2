}

section {
    padding: 20px;
}

form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

input[type="text"], input[type="email"], textarea {
    grid-column: 2 / 3;
}

input[type="submit"] {
    grid-column-start: 2;
    grid-column-end: 3;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
