<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 45.4mm; inset-block-start: 25.4mm; inline-size: 119.3mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 71.3mm; inset-block-start: 36.0mm; inline-size: 67.2mm; block-size: 4.2mm; font-size: 8.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 38.0mm; inset-block-start: 46.2mm; inline-size: 133.8mm; block-size: 2.6mm; font-size: 6.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 43.6mm; inset-block-start: 53.2mm; inline-size: 121.7mm; block-size: 2.6mm; font-size: 6.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 97.3mm; inset-block-start: 69.7mm; inline-size: 15.4mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 79.4mm; inline-size: 159.2mm; block-size: 25.0mm; font-size: 10.0pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 85.2mm; inline-size: 6.3mm; block-size: 124.6mm; font-size: 20.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 109.5mm; inline-size: 159.1mm; block-size: 11.0mm; font-size: 10.0pt">{{ slot_7 }}</p>
