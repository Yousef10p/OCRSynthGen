<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 22.1mm; inset-block-start: 28.3mm; inline-size: 17.3mm; block-size: 20.2mm; font-size: 14.3pt"></div>
<h2 class="box" style="inset-inline-start: 50.6mm; inset-block-start: 34.2mm; inline-size: 53.2mm; block-size: 7.2mm; font-size: 20.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 51.2mm; inset-block-start: 60.9mm; inline-size: 130.4mm; block-size: 44.3mm; font-size: 15.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 51.2mm; inset-block-start: 113.8mm; inline-size: 129.4mm; block-size: 35.9mm; font-size: 17.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 118.3mm; inset-block-start: 151.9mm; inline-size: 62.1mm; block-size: 23.2mm; font-size: 16.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 155.8mm; inline-size: 22.1mm; block-size: 35.5mm; font-size: 8.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 56.6mm; inset-block-start: 155.5mm; inline-size: 55.2mm; block-size: 69.5mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 118.3mm; inset-block-start: 183.6mm; inline-size: 63.2mm; block-size: 35.9mm; font-size: 17.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 13.1mm; inset-block-start: 267.6mm; inline-size: 56.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
