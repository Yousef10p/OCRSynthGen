<div class="image">{{ slot_10 }}</div>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<button>{{ slot_13 }}</button>
</div>
</div>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
<button>{{ slot_16 }}</button>
</main>
<footer>
