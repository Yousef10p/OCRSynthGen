<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
</header>
<main>
<div class="article" id="featured-story">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
</div>
<div id="related-articles">
<div class="article" id="article1">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="article" id="article2">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
<div class="article" id="article3">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</div>
<div class="article" id="article4">
