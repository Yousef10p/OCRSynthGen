.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
}

.left-column,
.center-column,
.footer {
  padding: 20px;
}

.left-column {
  width: 20%;
  float: right;
  background-color: #f2f2f2;
}

.center-column {
  width: 60%;
  float: right;
  text-align: center;
}

.product-image {
  height: 200px;
  width: 200px;
  background-color: #bebebe;
  margin: 0 auto;
}

.product-details {
  position: relative;
}

.product-details:hover p {
  visibility: visible;
}

.product-details p {
  visibility: hidden;
  position: absolute;
  top: 0;
  right: 50%;
  transform: translateX(50%);
  background-color: rgba(242, 242, 242, 0.75);
  padding: 10px;
}

.footer {
  clear: both;
  background-color: #333;
  color: #fff;
}

.social-media span {
  display: inline-block;
  margin-left: 20px;
}

form {
  float: left;
}

textarea {
  display: block;
  width: 100%;
  height: 100px;
  margin: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
