    padding: 20px;
    background-color: #333;
    color: #fff;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}


main {
    padding: 40px;
}


footer {
    background-color: #333;
    color: #fff;
    padding: 20px;
    text-align: center;
}


@media screen and (max-width: 600px) {
    header {
        flex-direction: column;
    }

    nav ul {
        flex-direction: column;
        align-items: center;
    }

    nav ul li {
        margin: 10px 0;
    }

    main {
        padding: 20px;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
