<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 13.1mm; inset-block-start: 13.1mm; inline-size: 82.7mm; block-size: 19.8mm; font-size: 14.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 112.7mm; inset-block-start: 13.1mm; inline-size: 82.7mm; block-size: 59.4mm; font-size: 15.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 13.1mm; inset-block-start: 35.6mm; inline-size: 82.7mm; block-size: 53.7mm; font-size: 15.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 112.7mm; inset-block-start: 75.1mm; inline-size: 82.8mm; block-size: 36.8mm; font-size: 14.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.1mm; inset-block-start: 92.1mm; inline-size: 85.0mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 112.7mm; inset-block-start: 114.7mm; inline-size: 82.7mm; block-size: 8.5mm; font-size: 12.1pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 11.9mm; inset-block-start: 139.4mm; inline-size: 203.9mm; block-size: 105.4mm; font-size: 14.9pt"></div>
<footer class="box" style="inset-inline-start: 13.1mm; inset-block-start: 269.2mm; inline-size: 3.0mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_6 }}</footer>
</div></body>
</html>
