<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 279.4mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 218.5mm; inset-block-start: 32.2mm; inline-size: 9.8mm; block-size: 48.5mm; font-size: 13.7pt">{{ slot_0 }}</p>
<header class="box" style="inset-inline-start: 259.5mm; inset-block-start: 42.1mm; inline-size: 6.7mm; block-size: 28.9mm; font-size: 16.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 35.2mm; inset-block-start: 75.2mm; inline-size: 21.5mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 259.2mm; inset-block-start: 80.7mm; inline-size: 8.5mm; block-size: 28.4mm; font-size: 13.4pt">{{ slot_3 }}</header><div class="box ph" style="inset-inline-start: 29.3mm; inset-block-start: 82.3mm; inline-size: 218.3mm; block-size: 75.0mm; font-size: 17.7pt"></div>
<header class="box" style="inset-inline-start: 260.2mm; inset-block-start: 125.2mm; inline-size: 4.7mm; block-size: 21.3mm; font-size: 12.1pt">{{ slot_4 }}</header><header class="box" style="inset-inline-start: 259.4mm; inset-block-start: 152.9mm; inline-size: 9.6mm; block-size: 34.3mm; font-size: 16.2pt">{{ slot_5 }}</header>
</div></body>
</html>
