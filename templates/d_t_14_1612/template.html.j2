<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 140.6mm; inset-block-start: 2.4mm; inline-size: 69.3mm; block-size: 34.5mm; font-size: 14.0pt"></div>
<div class="box ph" style="inset-inline-start: 14.7mm; inset-block-start: 17.5mm; inline-size: 41.6mm; block-size: 19.8mm; font-size: 14.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 60.6mm; inline-size: 160.3mm; block-size: 8.5mm; font-size: 10.0pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 73.5mm; inline-size: 147.6mm; block-size: 12.9mm; font-size: 10.0pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.1mm; inset-block-start: 86.3mm; inline-size: 147.7mm; block-size: 34.3mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 124.9mm; inline-size: 160.4mm; block-size: 25.7mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 154.9mm; inline-size: 160.4mm; block-size: 21.4mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 180.7mm; inline-size: 160.5mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 202.1mm; inline-size: 160.5mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 223.6mm; inline-size: 160.3mm; block-size: 30.0mm; font-size: 10.0pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 257.9mm; inline-size: 27.2mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 262.1mm; inline-size: 160.4mm; block-size: 8.6mm; font-size: 10.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 201.4mm; inset-block-start: 282.3mm; inline-size: 3.2mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
