<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 26.6mm; inline-size: 149.8mm; block-size: 18.3mm; font-size: 11.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 48.4mm; inline-size: 149.8mm; block-size: 18.4mm; font-size: 11.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 70.4mm; inline-size: 149.9mm; block-size: 18.4mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 92.3mm; inline-size: 147.6mm; block-size: 11.0mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 106.9mm; inline-size: 147.6mm; block-size: 11.0mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 121.3mm; inline-size: 149.8mm; block-size: 25.7mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 150.6mm; inline-size: 149.7mm; block-size: 18.4mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 172.6mm; inline-size: 151.8mm; block-size: 40.2mm; font-size: 11.8pt">{{ slot_7 }}</p>
