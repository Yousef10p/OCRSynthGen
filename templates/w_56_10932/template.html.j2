}

form {
    margin-top: 20px;
}

input[type="text"], 
input[type="email"], 
textarea {
    display: block;
    width: 100%;
    margin-bottom: 20px;
}

footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    background-color: #333;
    color: #FFF;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
    font-size: 14px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
