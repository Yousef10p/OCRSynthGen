<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<section class="hero">
<div class="banner-animation ph"></div>
</section>
<main>
<article>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="product-demo"></div>
</article>
<article>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</article>
</main>
<footer>
<nav>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
</ul>
</nav>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>