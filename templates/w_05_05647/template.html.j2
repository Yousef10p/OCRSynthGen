<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</li>
<li><a>{{ slot_4 }}</a>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</div>
<div class="hero">
<div class="slider">
<div class="slide">{{ slot_8 }}</div>
<div class="slide">{{ slot_9 }}</div>
<div class="slide">{{ slot_10 }}</div>
</div>
<a class="cta">{{ slot_11 }}</a>
</div>
<div class="social">
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</div>
</body>
</html>