<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

#navbar {
  background-color: #34495e;
  color: white;
  padding: 20px;
}

#navbar ul {
  float: left;
}

#navbar ul li {
  display: inline-block;
  margin-right: 15px;
}

#navbar ul li a {
  color: white;
  text-decoration: none;
}

#main-image {
  background-image: linear-gradient(to left, #34495e, #2c3e50);
  color: white;
  padding: 50px;
  box-shadow: -5px 5px 15px 0px rgba(127,140,141,1);
  text-align: center;
}

#main-image h1 {
  font-size: 3em;
}

#main-image p {
  font-size: 1.5em;
}

#main-image button {
  background-color: white;
  color: #34495e;
  padding: 10px 20px;
  border: none;
  border-radius: 5px;
}

#content {
  padding: 20px;
  display: flex;
  flex-wrap: wrap;
}

.product {
  box-shadow: -5px 5px 15px 0px rgba(127,140,141,1);
  margin: 15px;
  width: 30%;
  text-align: center;
  transition: all 0.2s ease-in-out;
}

.product-image {
  background-color: grey;
  height: 200px;
  width: 100%;
}

.product h3 {
  font-size: 1.5em;
}

.product p {
  font-size: 1em;
}

.product button {
  background-color: #34495e;
  color: white;
  padding: 10px 20px;
  border: none;
  border-radius: 5px;
}

.product:hover {
  transform: scale(1.05);
  background-color: #27ae60;
}

.product:hover h3,
.product:hover p,
.product:hover button {
  color: white;
}

.product button:hover {
  background-color: #27ae60;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
