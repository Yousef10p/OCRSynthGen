<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 56.2mm; inset-block-start: 24.9mm; inline-size: 103.1mm; block-size: 44.4mm; font-size: 12.9pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 82.0mm; inline-size: 164.5mm; block-size: 26.7mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 115.9mm; inline-size: 164.5mm; block-size: 33.8mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 152.8mm; inline-size: 164.5mm; block-size: 63.3mm; font-size: 12.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 227.9mm; inline-size: 43.4mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 239.8mm; inline-size: 164.4mm; block-size: 19.0mm; font-size: 12.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 104.6mm; inset-block-start: 266.7mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
