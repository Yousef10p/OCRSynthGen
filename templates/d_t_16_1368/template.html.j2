<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 45.0mm; inset-block-start: 24.0mm; inline-size: 145.4mm; block-size: 24.4mm; font-size: 34.6pt">{{ slot_0 }}</h1>
<h1 class="box" style="inset-inline-start: 73.1mm; inset-block-start: 60.2mm; inline-size: 88.6mm; block-size: 8.3mm; font-size: 23.6pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 104.7mm; inset-block-start: 83.4mm; inline-size: 21.5mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 30.0mm; inset-block-start: 101.6mm; inline-size: 157.9mm; block-size: 81.3mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 82.9mm; inset-block-start: 213.7mm; inline-size: 69.1mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 44.7mm; inset-block-start: 221.0mm; inline-size: 147.3mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 99.0mm; inset-block-start: 229.3mm; inline-size: 37.8mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 151.7mm; inset-block-start: 254.1mm; inline-size: 38.2mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_6 }}</p>
</div></body>
</html>
