    margin: 20px;
    max-width: 500px;
    text-align: center;
}

.banner-item-image {
    height: 200px;
    margin-bottom: 10px;
}

footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #333;
    color: white;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
