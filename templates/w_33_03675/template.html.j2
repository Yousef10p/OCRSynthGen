<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<section id="hero">
<div class="ph"></div>
<button>{{ slot_4 }}</button>
</section>
<aside>
<h2>{{ slot_5 }}</h2>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</aside>
<article id="testimonials">
<h2>{{ slot_9 }}</h2>
<blockquote>
<p>{{ slot_10 }}</p>
<cite>{{ slot_11 }}</cite>
</blockquote>
<blockquote>
<p>{{ slot_12 }}</p>
<cite>{{ slot_13 }}</cite>
</blockquote>
</article>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>