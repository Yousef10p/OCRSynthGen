<div class="box ph" style="inset-inline-start: 77.5mm; inset-block-start: 143.2mm; inline-size: 40.9mm; block-size: 8.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 159.6mm; inline-size: 91.3mm; block-size: 7.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
