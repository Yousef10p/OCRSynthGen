<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div id="container">
<div class="content">{{ slot_5 }} 
      <a>{{ slot_6 }}</a>
</div>
<div class="product">{{ slot_7 }}
    <a>{{ slot_8 }}</a>
</div>
<div class="services">{{ slot_9 }}
    <a>{{ slot_10 }}</a>
</div>
<div class="about">{{ slot_11 }}
    <a>{{ slot_12 }}</a>
</div>
<div class="contact">{{ slot_13 }}
    <a>{{ slot_14 }}</a>
</div>
</div>
</body>
</html>