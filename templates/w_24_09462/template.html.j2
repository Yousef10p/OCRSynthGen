	margin: 20px 0;
}
#services .service {
	border: 1px solid #595b83;
	padding: 20px;
	margin: 10px;
}


#portal {
	background-color: #b0a8b9;
	padding: 20px;
	margin: 20px 0;
}


#blog {
	margin: 20px 0;
}
#blog article {
	border-bottom: 1px solid #595b83;
	padding: 20px;
}


#contact {
	background-color: #b0a8b9;
	padding: 20px;
	margin: 20px 0;
}
#contact form {
	display: flex;
	flex-direction: column;
	width: 50%;
	margin: 0 auto;
}
#contact input, #contact textarea {
	margin: 10px 0;
}
#contact input[type="submit"] {
	cursor: pointer;
	background-color: #595b83;
	color: #fdf9ff;
	border: none;
	padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
