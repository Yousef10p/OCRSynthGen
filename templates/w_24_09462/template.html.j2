	color: #fdf9ff;
	padding: 10px 0;
}
nav ul {
	display: flex;
	justify-content: space-around;
	list-style-type: none;
}
nav a {
	color: #fdf9ff;
	text-decoration: none;
}


#hero {
	height: 200px;
	display: flex;
	justify-content: space-around;
	align-items: center;
	background-color: #f3d2c1;
	flex-direction: column;
}


#services {
