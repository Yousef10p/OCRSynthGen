<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.0mm; inline-size: 209.9mm; block-size: 127.1mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 130.2mm; inline-size: 168.3mm; block-size: 6.1mm; font-size: 8.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 145.0mm; inline-size: 51.9mm; block-size: 67.7mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 73.3mm; inset-block-start: 145.0mm; inline-size: 52.4mm; block-size: 53.6mm; font-size: 12.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 133.4mm; inset-block-start: 147.4mm; inline-size: 3.9mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 141.7mm; inset-block-start: 147.9mm; inline-size: 41.8mm; block-size: 27.3mm; font-size: 9.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 73.3mm; inset-block-start: 203.0mm; inline-size: 53.1mm; block-size: 58.2mm; font-size: 12.7pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 15.0mm; inset-block-start: 216.9mm; inline-size: 52.0mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 222.6mm; inline-size: 49.6mm; block-size: 30.8mm; font-size: 12.5pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 8.0mm; inset-block-start: 285.2mm; inline-size: 3.3mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
