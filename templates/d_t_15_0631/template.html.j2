<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.5mm; inset-block-start: 15.9mm; inline-size: 86.1mm; block-size: 64.7mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 103.0mm; inset-block-start: 15.9mm; inline-size: 86.3mm; block-size: 64.6mm; font-size: 15.2pt"></div>
<div class="box ph" style="inset-inline-start: 13.5mm; inset-block-start: 84.0mm; inline-size: 86.1mm; block-size: 64.6mm; font-size: 15.2pt"></div>
<div class="box ph" style="inset-inline-start: 103.3mm; inset-block-start: 84.2mm; inline-size: 86.0mm; block-size: 64.9mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 13.3mm; inset-block-start: 152.6mm; inline-size: 86.3mm; block-size: 64.9mm; font-size: 15.3pt"></div>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 151.4mm; inline-size: 83.2mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_0 }}</li></ul>
<div class="box ph" style="inset-inline-start: 103.0mm; inset-block-start: 162.9mm; inline-size: 86.5mm; block-size: 62.6mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 219.8mm; inline-size: 14.8mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_1 }}</h2>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 226.6mm; inline-size: 83.2mm; block-size: 13.2mm; font-size: 12.4pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 229.7mm; inline-size: 83.2mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 240.3mm; inline-size: 76.7mm; block-size: 4.1mm; font-size: 11.7pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 241.8mm; inline-size: 83.2mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_5 }}</li></ul>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 7.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_6 }}</footer>
</div></body>
</html>
