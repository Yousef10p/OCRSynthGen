<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.1mm; inset-block-start: 15.6mm; inline-size: 90.5mm; block-size: 116.0mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 106.9mm; inset-block-start: 16.3mm; inline-size: 83.7mm; block-size: 21.3mm; font-size: 12.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 106.9mm; inset-block-start: 43.4mm; inline-size: 83.6mm; block-size: 34.8mm; font-size: 12.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 106.9mm; inset-block-start: 84.0mm; inline-size: 86.5mm; block-size: 52.9mm; font-size: 12.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.8mm; inset-block-start: 135.3mm; inline-size: 86.1mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 142.6mm; inline-size: 89.3mm; block-size: 57.4mm; font-size: 12.5pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 150.2mm; inline-size: 83.7mm; block-size: 52.9mm; font-size: 12.5pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 205.8mm; inline-size: 87.0mm; block-size: 39.3mm; font-size: 12.4pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 209.2mm; inline-size: 36.5mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 214.2mm; inline-size: 87.0mm; block-size: 34.8mm; font-size: 12.3pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 7.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
