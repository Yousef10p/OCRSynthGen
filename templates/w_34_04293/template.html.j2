    margin-bottom: 20px;
}

.service-img, .portfolio-img {
    background-color: #333;
    width: 200px;
    height: 200px;
}

@media screen and (max-width: 600px) {
    nav ul {
        flex-direction: column;
        align-items: center;
    }

    .service, .portfolio-item {
        flex-direction: column;
        align-items: center;
    }

    .service-img, .portfolio-img {
        margin-bottom: 20px;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
