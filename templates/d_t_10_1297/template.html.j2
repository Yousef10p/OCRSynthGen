<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 62.9mm; inset-block-start: 25.2mm; inline-size: 90.3mm; block-size: 60.3mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 94.4mm; inline-size: 164.5mm; block-size: 26.4mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 129.3mm; inline-size: 20.3mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 72.8mm; inset-block-start: 139.4mm; inline-size: 117.1mm; block-size: 10.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 153.6mm; inline-size: 32.8mm; block-size: 4.0mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 161.3mm; inline-size: 164.5mm; block-size: 18.5mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 80.6mm; inset-block-start: 182.6mm; inline-size: 109.3mm; block-size: 5.3mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 83.7mm; inset-block-start: 192.3mm; inline-size: 106.2mm; block-size: 5.3mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 64.3mm; inset-block-start: 199.9mm; inline-size: 125.6mm; block-size: 9.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 212.2mm; inline-size: 164.5mm; block-size: 11.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 63.9mm; inset-block-start: 228.1mm; inline-size: 126.0mm; block-size: 11.1mm; font-size: 8.0pt"></div>
<div class="box ph" style="inset-inline-start: 66.9mm; inset-block-start: 244.2mm; inline-size: 122.9mm; block-size: 11.1mm; font-size: 8.0pt"></div>
<footer class="box" style="inset-inline-start: 103.5mm; inset-block-start: 266.9mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
