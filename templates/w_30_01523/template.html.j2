<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    color: #333;
}

header {
    width: 100%;
    background-color: #f8f8f8;
    padding: 20px 0;
}

nav {
    width: 900px;
    margin: 0 auto;
}

nav ul {
    list-style: none;
    text-align: left;
}

nav ul li {
    display: inline;
    margin: 0 20px;
}

nav ul li a {
    text-decoration: none;
    color: #777;
}

.banner {
    width: 900px;
    height: 300px;
    margin: 50px auto;
    background-color: #ddd;
    text-align: center;
    padding-top: 100px;
}

.banner h1 {
    font-size: 40px;
    margin-bottom: 20px;
}

.banner p {
    font-size: 20px;
}

.button {
    display: inline-block;
    padding: 10px 20px;
    background-color: #333;
    color: #fff;
    text-decoration: none;
}

main {
    width: 900px;
    margin: 50px auto;
}

.col1, .col2, .col3 {
    width: 300px;
    height: 200px;
    background-color: #aaa;
    display: inline-block;
}

article {
    width: 300px;
    height: 200px;
    display: inline-block;
    margin-top: 50px;
}

footer {
    width: 100%;
    background-color: #f8f8f8;
    text-align: center;
    padding: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<main>
<div class="banner">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<a class="button">{{ slot_7 }}</a>
</div>
<section>
<div class="col1"><div class="ph" style="inline-size: 100%; block-size: 150px"></div></div>
<div class="col2"><div class="ph" style="inline-size: 100%; block-size: 150px"></div></div>
<div class="col3"><div class="ph" style="inline-size: 100%; block-size: 150px"></div></div>
</section>
<section>
<article class="article1">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</article>
<article class="article2">
