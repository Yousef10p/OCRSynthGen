  height: 200px;
  width: 200px;
  background-color: #dddddd;
}
.recipe {
  opacity: 0;
  transition: opacity 0.3s ease;
}
section div:hover .recipe {
  opacity: 1;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
