<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 75.4mm; inline-size: 57.1mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 87.0mm; inline-size: 159.2mm; block-size: 11.9mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 101.8mm; inline-size: 159.2mm; block-size: 11.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.5mm; inline-size: 159.2mm; block-size: 16.2mm; font-size: 10.0pt">{{ slot_6 }}</p>
