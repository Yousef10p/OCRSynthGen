<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 131.9mm; inset-block-start: 31.4mm; inline-size: 35.5mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 115.7mm; inset-block-start: 37.8mm; inline-size: 68.0mm; block-size: 16.8mm; font-size: 14.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 88.9mm; inset-block-start: 75.4mm; inline-size: 33.5mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 33.6mm; inset-block-start: 83.2mm; inline-size: 144.1mm; block-size: 16.8mm; font-size: 14.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 112.2mm; inline-size: 161.1mm; block-size: 24.5mm; font-size: 14.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 137.6mm; inline-size: 161.3mm; block-size: 43.6mm; font-size: 14.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 182.0mm; inline-size: 161.3mm; block-size: 11.8mm; font-size: 14.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 194.7mm; inline-size: 161.2mm; block-size: 24.5mm; font-size: 14.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 220.1mm; inline-size: 161.1mm; block-size: 30.9mm; font-size: 14.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 251.9mm; inline-size: 161.2mm; block-size: 18.2mm; font-size: 14.0pt">{{ slot_9 }}</p>
</div></body>
</html>
