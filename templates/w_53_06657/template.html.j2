<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: #333;
    color: #fff;
}

.header-logo {
    font-size: 24px;
}

.header-menu a {
    margin-right: 20px;
    color: #fff;
    text-decoration: none;
}

.content {
    display: flex;
    padding: 20px;
}

.sidebar {
    width: 30%;
    padding: 20px;
    background-color: #f2f2f2;
}

.main-content {
    width: 70%;
    padding: 20px;
}

.sticky-sidebar {
    position: sticky;
    top: 0;
}

.course {
    margin-bottom: 10px;
    padding: 20px;
    background-color: #ddd;
}

.grid-content {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: 20px;
}

.grid-item {
    padding: 20px;
    background-color: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="header-logo">{{ slot_0 }}</div>
<div class="header-menu">
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
</div>
</div>
<div class="content">
<div class="sidebar">
<div class="sticky-sidebar">
<h2>{{ slot_5 }}</h2>
<div class="course">{{ slot_6 }}</div>
<div class="course">{{ slot_7 }}</div>
<div class="course">{{ slot_8 }}</div>
<div class="course">{{ slot_9 }}</div>
</div>
</div>
<div class="main-content">
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
<div class="grid-content">
<div class="grid-item">{{ slot_12 }}</div>
<div class="grid-item">{{ slot_13 }}</div>
<div class="grid-item">{{ slot_14 }}</div>
<div class="grid-item">{{ slot_15 }}</div>
</div>
</div>
</div>
</body>
</html>