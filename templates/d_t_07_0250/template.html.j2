<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 6.9mm; inset-block-start: 29.2mm; inline-size: 5.6mm; block-size: 14.2mm; font-size: 40.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 32.6mm; inline-size: 156.4mm; block-size: 31.3mm; font-size: 12.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 66.3mm; inline-size: 156.4mm; block-size: 31.3mm; font-size: 12.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 32.1mm; inset-block-start: 99.9mm; inline-size: 97.5mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 106.9mm; inline-size: 156.5mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 127.1mm; inline-size: 156.5mm; block-size: 53.6mm; font-size: 12.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 183.0mm; inline-size: 156.5mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 203.3mm; inline-size: 156.4mm; block-size: 22.3mm; font-size: 12.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 228.1mm; inline-size: 156.5mm; block-size: 35.7mm; font-size: 12.7pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 10.4mm; inset-block-start: 280.4mm; inline-size: 3.8mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_9 }}</footer>
</div></body>
</html>
