<ul class="box" style="inset-inline-start: 31.0mm; inset-block-start: 54.1mm; inline-size: 164.8mm; block-size: 8.7mm; font-size: 6.2pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.7mm; inset-block-start: 62.7mm; inline-size: 112.1mm; block-size: 4.5mm; font-size: 5.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.0mm; inset-block-start: 67.1mm; inline-size: 164.3mm; block-size: 8.8mm; font-size: 6.2pt"><li>{{ slot_6 }}</li></ul>
