<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 28.6mm; inset-block-start: 25.4mm; inline-size: 143.7mm; block-size: 14.0mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 45.4mm; inset-block-start: 46.7mm; inline-size: 109.8mm; block-size: 4.6mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 55.0mm; inline-size: 129.0mm; block-size: 11.5mm; font-size: 12.0pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 71.4mm; inline-size: 6.3mm; block-size: 154.4mm; font-size: 20.0pt">{{ slot_3 }}</header><h2 class="box" style="inset-inline-start: 91.0mm; inset-block-start: 71.2mm; inline-size: 18.9mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 79.7mm; inline-size: 150.0mm; block-size: 103.2mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 190.8mm; inline-size: 69.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 214.5mm; inline-size: 42.1mm; block-size: 3.5mm; font-size: 7.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 219.8mm; inline-size: 50.5mm; block-size: 3.5mm; font-size: 7.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 97.3mm; inset-block-start: 229.8mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
