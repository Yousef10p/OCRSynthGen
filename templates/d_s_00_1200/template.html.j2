<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 6.2mm; inline-size: 114.3mm; block-size: 115.8mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 116.0mm; inset-block-start: 5.7mm; inline-size: 68.2mm; block-size: 4.9mm; font-size: 7.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 115.9mm; inset-block-start: 19.0mm; inline-size: 99.6mm; block-size: 120.8mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 132.6mm; inline-size: 75.8mm; block-size: 7.4mm; font-size: 7.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 16.5mm; inset-block-start: 157.6mm; inline-size: 63.3mm; block-size: 58.0mm; font-size: 13.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 87.1mm; inset-block-start: 157.6mm; inline-size: 64.0mm; block-size: 18.0mm; font-size: 12.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 165.8mm; inset-block-start: 190.6mm; inline-size: 37.9mm; block-size: 27.7mm; font-size: 13.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 84.6mm; inset-block-start: 197.7mm; inline-size: 50.9mm; block-size: 9.2mm; font-size: 13.0pt"></div>
<p class="box" style="inset-inline-start: 87.1mm; inset-block-start: 208.3mm; inline-size: 27.2mm; block-size: 6.1mm; font-size: 8.7pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 86.0mm; inset-block-start: 219.0mm; inline-size: 31.7mm; block-size: 9.1mm; font-size: 12.9pt"></div>
<h2 class="box" style="inset-inline-start: 16.5mm; inset-block-start: 223.2mm; inline-size: 16.9mm; block-size: 2.3mm; font-size: 6.5pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 16.5mm; inset-block-start: 227.6mm; inline-size: 63.7mm; block-size: 28.0mm; font-size: 13.2pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 87.1mm; inset-block-start: 228.9mm; inline-size: 45.4mm; block-size: 6.1mm; font-size: 8.7pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 86.1mm; inset-block-start: 238.6mm; inline-size: 33.8mm; block-size: 9.2mm; font-size: 13.0pt"></div>
<p class="box" style="inset-inline-start: 87.2mm; inset-block-start: 248.9mm; inline-size: 46.8mm; block-size: 6.1mm; font-size: 8.7pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 204.5mm; inset-block-start: 268.4mm; inline-size: 1.4mm; block-size: 1.8mm; font-size: 5.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
