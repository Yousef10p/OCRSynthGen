<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 34.1mm; inset-block-start: 13.8mm; inline-size: 46.4mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 26.9mm; inline-size: 108.1mm; block-size: 5.5mm; font-size: 15.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 36.7mm; inline-size: 131.6mm; block-size: 118.5mm; font-size: 16.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 33.8mm; inset-block-start: 162.0mm; inline-size: 13.2mm; block-size: 5.9mm; font-size: 16.8pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 43.7mm; inset-block-start: 168.7mm; inline-size: 120.5mm; block-size: 11.9mm; font-size: 16.8pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.4mm; inset-block-start: 181.2mm; inline-size: 112.0mm; block-size: 12.3mm; font-size: 17.5pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.4mm; inset-block-start: 194.3mm; inline-size: 129.3mm; block-size: 12.1mm; font-size: 17.1pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.4mm; inset-block-start: 207.4mm; inline-size: 121.7mm; block-size: 12.0mm; font-size: 17.0pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.3mm; inset-block-start: 220.5mm; inline-size: 124.4mm; block-size: 18.5mm; font-size: 17.5pt"><li>{{ slot_8 }}</li></ul>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 243.3mm; inline-size: 142.0mm; block-size: 18.5mm; font-size: 17.5pt">{{ slot_9 }}</p>
</div></body>
</html>
