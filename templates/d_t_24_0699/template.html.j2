<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 27.2mm; inset-block-start: 19.9mm; inline-size: 38.2mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 163.9mm; inset-block-start: 19.9mm; inline-size: 22.1mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 103.7mm; inset-block-start: 25.4mm; inline-size: 6.8mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_2 }}</header><div class="box ph" style="inset-inline-start: 26.7mm; inset-block-start: 38.3mm; inline-size: 76.2mm; block-size: 222.9mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 114.9mm; inset-block-start: 38.5mm; inline-size: 65.4mm; block-size: 94.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 109.6mm; inset-block-start: 139.9mm; inline-size: 77.0mm; block-size: 13.8mm; font-size: 9.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 109.6mm; inset-block-start: 156.4mm; inline-size: 77.2mm; block-size: 24.9mm; font-size: 10.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 109.7mm; inset-block-start: 187.3mm; inline-size: 18.9mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 109.6mm; inset-block-start: 194.4mm; inline-size: 77.1mm; block-size: 24.9mm; font-size: 10.1pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 137.4mm; inset-block-start: 228.6mm; inline-size: 50.0mm; block-size: 30.7mm; font-size: 40.0pt"></div>
</div></body>
</html>
