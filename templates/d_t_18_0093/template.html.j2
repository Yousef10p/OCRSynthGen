<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 98.5mm; inset-block-start: 4.1mm; inline-size: 93.5mm; block-size: 7.8mm; font-size: 8.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 31.2mm; inset-block-start: 21.4mm; inline-size: 8.8mm; block-size: 5.6mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.2mm; inset-block-start: 27.1mm; inline-size: 149.6mm; block-size: 5.6mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 29.9mm; inset-block-start: 31.6mm; inline-size: 167.1mm; block-size: 220.4mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 31.2mm; inset-block-start: 251.7mm; inline-size: 82.7mm; block-size: 5.6mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 18.5mm; inset-block-start: 257.7mm; inline-size: 67.5mm; block-size: 5.5mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 18.5mm; inset-block-start: 263.7mm; inline-size: 67.7mm; block-size: 5.5mm; font-size: 10.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 31.2mm; inset-block-start: 268.0mm; inline-size: 165.1mm; block-size: 14.0mm; font-size: 10.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 96.8mm; inset-block-start: 287.7mm; inline-size: 23.4mm; block-size: 4.5mm; font-size: 8.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
