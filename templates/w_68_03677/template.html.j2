<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
  
  color: #333;
  background-color: #f2f2f2;
}

nav {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: #333;
  padding: 10px;
  position: sticky;
  top: 0;
}

nav a {
  text-decoration: none;
  color: #f2f2f2;
  transition: all 0.5s;
}

nav a:hover {
  color: #ffd700;
}

section {
  margin: 20px;
  padding: 20px;
  background-color: #fff;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

section p::first-letter {
  font-size: 1.5em;
  color: #ffd700;
}

#section1, #section2 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

#section1::before, #section2::before {
  content: "";
  display: inline-block;
  width: 100px;
  height: 100px;
  background-color: #ffd700;
}

table {
  width: 100%;
  text-align: right;
}

footer {
  background-color: #ffd700;
  padding: 20px;
  text-align: center;
}

#go-to-top {
  position: fixed;
  bottom: 20px;
  left: 20px;
  display: none;
  padding: 10px;
  background-color: #ffd700;
  color: #333;
  text-decoration: none;
  border-radius: 5px;
}

#go-to-top:hover {
  background-color: #333;
  color: #ffd700;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</nav>
<section id="section1">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</section>
<section id="section2">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
</section>
<section id="section3">
<h1>{{ slot_8 }}</h1>
<table>
<tr>
<th>{{ slot_9 }}</th>
<th>{{ slot_10 }}</th>
<th>{{ slot_11 }}</th>
</tr>
<tr>
<td>{{ slot_12 }}</td>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
</tr>

</table>
</section>
<section id="section4">
<h1>{{ slot_15 }}</h1>
<p>{{ slot_16 }}</p>

</section>
<footer>
<p>{{ slot_17 }}</p>
</footer>
<a id="go-to-top">{{ slot_18 }}</a>
</body>
</html>