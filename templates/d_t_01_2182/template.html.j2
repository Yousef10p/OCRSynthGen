<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 9.0mm; inset-block-start: 50.0mm; inline-size: 62.6mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 101.7mm; inset-block-start: 50.0mm; inline-size: 68.1mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 9.0mm; inset-block-start: 54.1mm; inline-size: 84.9mm; block-size: 37.0mm; font-size: 10.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 101.7mm; inset-block-start: 54.1mm; inline-size: 85.5mm; block-size: 6.7mm; font-size: 9.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 101.7mm; inset-block-start: 65.4mm; inline-size: 85.5mm; block-size: 33.2mm; font-size: 10.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 9.0mm; inset-block-start: 95.8mm; inline-size: 84.3mm; block-size: 33.2mm; font-size: 10.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 101.7mm; inset-block-start: 103.4mm; inline-size: 84.6mm; block-size: 40.8mm; font-size: 10.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 9.0mm; inset-block-start: 133.7mm; inline-size: 85.0mm; block-size: 29.4mm; font-size: 10.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 101.7mm; inset-block-start: 148.9mm; inline-size: 83.8mm; block-size: 25.6mm; font-size: 10.4pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 100.8mm; inset-block-start: 186.1mm; inline-size: 57.0mm; block-size: 7.9mm; font-size: 22.4pt"></div>
<p class="box" style="inset-inline-start: 101.7mm; inset-block-start: 198.2mm; inline-size: 28.2mm; block-size: 10.5mm; font-size: 9.9pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 96.9mm; inset-block-start: 270.7mm; inline-size: 3.5mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_10 }}</footer>
</div></body>
</html>
