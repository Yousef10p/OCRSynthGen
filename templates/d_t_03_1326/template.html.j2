<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 91.0mm; inline-size: 85.5mm; block-size: 44.7mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 112.1mm; inset-block-start: 94.2mm; inline-size: 85.6mm; block-size: 104.3mm; font-size: 12.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 138.6mm; inline-size: 85.5mm; block-size: 40.1mm; font-size: 12.6pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 15.9mm; inset-block-start: 182.5mm; inline-size: 25.6mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 189.4mm; inline-size: 85.5mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_7 }}</p>
