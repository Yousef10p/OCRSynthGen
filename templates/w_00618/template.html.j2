<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	font-family: var(--font-body);
	margin: 0;
	padding: 0;
	color: #333;
	background-color: #f9f9f9;
}

#nav {
	position: fixed;
	top: 0;
	width: 100%;
	background-color: #333;
	color: white;
	padding: 10px 0;
}

#nav ul {
	list-style-type: none;
}

#nav li {
	display: inline-block;
	margin: 0 15px;
}

#nav a {
	color: white;
	text-decoration: none;
}

.recipe {
	margin: 50px auto;
	width: 80%;
	border: 1px solid #ddd;
	padding: 20px;
	text-align: center;
}

.img-placeholder {
	width: 200px;
	height: 200px;
	background-color: #ddd;
	margin: 20px auto;
}

#search-box {
	display: block;
	margin: 20px auto;
	padding: 10px;
	width: 80%;
}

#search-results {
	margin: 20px auto;
	text-align: right;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav id="nav">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div class="recipe" id="breakfast">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div class="img-placeholder ph"></div>
</div>
<div class="recipe" id="lunch">
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
<div class="img-placeholder ph"></div>
</div>
<div class="recipe" id="dinner">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
<div class="img-placeholder ph"></div>
</div>
<div class="recipe" id="dessert">
