<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: var(--font-body);
    color: white;
}

header {
    background-color: #333;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav li a {
    color: white;
    text-decoration: none;
    padding: 1em;
    display: inline-block;
    transition: background-color 0.3s ease;
}

nav li a:hover {
    background-color: red;
}

section {
    padding: 1em;
    display: flex;
    flex-direction: column;
    align-items: center;
}

section h1, section h2 {
    color: #333;
}

section p {
    text-align: center;
    color: #666;
}

.placeholder {
    width: 100px;
    height: 100px;
    margin: 1em 0;
}

form {
    display: flex;
    flex-direction: column;
    width: 100%;
}

form label {
    margin-bottom: 0.5em;
    color: #333;
}

form input, form textarea {
    margin-bottom: 1em;
    padding: 0.5em;
    border: none;
    border-radius: 0.5em;
    background-color: #f1f1f1;
}

form input[type="submit"] {
    background-color: red;
    color: white;
}

footer {
    background-color: #333;
    padding: 1em;
    position: fixed;
    bottom: 0;
    width: 100%;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
