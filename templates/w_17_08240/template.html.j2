}
#carousel .slide {
  height: 200px;
  width: 200px;
}
#filters {
  display: grid;
  grid-template-columns: auto auto auto;
  grid-gap: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
