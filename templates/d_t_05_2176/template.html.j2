<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 172.4mm; inset-block-start: 9.6mm; inline-size: 27.6mm; block-size: 10.9mm; font-size: 15.5pt"></div>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 30.5mm; inline-size: 43.2mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 61.8mm; inset-block-start: 179.2mm; inline-size: 99.6mm; block-size: 9.6mm; font-size: 9.1pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 196.7mm; inline-size: 34.1mm; block-size: 7.7mm; font-size: 21.8pt">{{ slot_2 }}</h2>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 213.0mm; inline-size: 143.6mm; block-size: 10.5mm; font-size: 14.9pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 225.7mm; inline-size: 148.4mm; block-size: 4.2mm; font-size: 11.9pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 232.0mm; inline-size: 110.8mm; block-size: 4.2mm; font-size: 11.9pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.0mm; inset-block-start: 238.4mm; inline-size: 139.9mm; block-size: 4.2mm; font-size: 11.9pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 252.2mm; inline-size: 111.7mm; block-size: 25.3mm; font-size: 14.3pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 143.3mm; inset-block-start: 285.2mm; inline-size: 58.7mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
