<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 50.1mm; inset-block-start: 25.5mm; inline-size: 115.2mm; block-size: 14.0mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 57.2mm; inset-block-start: 47.3mm; inline-size: 100.9mm; block-size: 3.8mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 55.1mm; inline-size: 151.8mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 55.5mm; inset-block-start: 62.8mm; inline-size: 108.0mm; block-size: 11.5mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 37.6mm; inset-block-start: 78.3mm; inline-size: 140.3mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_4 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 85.3mm; inline-size: 6.3mm; block-size: 126.0mm; font-size: 20.0pt">{{ slot_5 }}</header><h2 class="box" style="inset-inline-start: 99.1mm; inset-block-start: 87.0mm; inline-size: 17.2mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 95.4mm; inline-size: 165.0mm; block-size: 34.1mm; font-size: 10.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 138.0mm; inline-size: 66.2mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 145.7mm; inline-size: 147.9mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 26.5mm; inset-block-start: 251.8mm; inline-size: 34.0mm; block-size: 3.2mm; font-size: 8.5pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 29.0mm; inset-block-start: 256.9mm; inline-size: 125.1mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 104.5mm; inset-block-start: 267.0mm; inline-size: 2.1mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
