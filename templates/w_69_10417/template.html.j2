<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

#header {
    background-color: #1890ff;
    color: #ffffff;
    padding: 15px;
    text-align: center;
}

#nav {
    float: right;
    background-color: #ddd;
    width: 15%;
    height: 100vh;
    padding: 20px;
}

#nav a {
    display: block;
    margin: 10px 0;
}

#content {
    float: right;
    width: 85%;
    padding: 20px;
}

.placeholder {
    background-color: #ddd;
    text-align: center;
    padding: 100px 0;
}

.cta-button {
    display: block;
    background-color: #1890ff;
    color: #ffffff;
    padding: 10px 20px;
    margin: 15px 0;
    text-align: center;
    text-decoration: none;
    border: none;
    cursor: pointer;
}

h2 {
    color: #1890ff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<h1>{{ slot_0 }}</h1>
</div>
<div id="nav">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div id="content">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<button class="cta-button">{{ slot_6 }}</button>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="placeholder">{{ slot_9 }}</div>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<div class="placeholder">{{ slot_12 }}</div>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<div class="placeholder">{{ slot_15 }}</div>
</div>
</body>
</html>