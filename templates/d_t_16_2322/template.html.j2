<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.0mm; inset-block-start: 15.4mm; inline-size: 176.2mm; block-size: 107.9mm; font-size: 25.5pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 126.4mm; inline-size: 98.1mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 135.6mm; inline-size: 86.8mm; block-size: 16.8mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 135.6mm; inline-size: 89.8mm; block-size: 30.3mm; font-size: 12.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 158.1mm; inline-size: 86.2mm; block-size: 21.3mm; font-size: 12.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 171.7mm; inline-size: 87.0mm; block-size: 25.8mm; font-size: 12.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 185.2mm; inline-size: 91.9mm; block-size: 57.4mm; font-size: 12.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 203.3mm; inline-size: 88.8mm; block-size: 30.3mm; font-size: 12.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 239.4mm; inline-size: 86.8mm; block-size: 16.8mm; font-size: 11.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 248.4mm; inline-size: 86.6mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 9.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
