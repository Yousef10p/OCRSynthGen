<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 27.2mm; inset-block-start: 20.0mm; inline-size: 38.2mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 161.1mm; inset-block-start: 20.0mm; inline-size: 24.8mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 103.7mm; inset-block-start: 25.1mm; inline-size: 6.7mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 58.8mm; inset-block-start: 39.0mm; inline-size: 14.5mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.2mm; inset-block-start: 39.0mm; inline-size: 14.4mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 33.2mm; inset-block-start: 42.1mm; inline-size: 65.4mm; block-size: 214.4mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 115.7mm; inset-block-start: 41.9mm; inline-size: 66.1mm; block-size: 219.7mm; font-size: 40.0pt"></div>
</div></body>
</html>
