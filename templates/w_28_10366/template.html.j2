<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background-color: #f4f4f4;
}

header, footer {
  background-color: #333;
  color: #fff;
  padding: 10px;
  text-align: center;
}

header h1 {
  display: inline;
  margin: 0;
}

header nav {
  position: relative;
}

header button {
  display: none;
  position: absolute;
  top: 0;
  left: 10px;
  height: 100%;
  width: 50px;
  cursor: pointer;
}

header button span {
  display: block;
  height: 3px;
  background-color: #fff;
  margin: 7px 0;
}

header nav ul {
  list-style: none;
  padding: 0;
  display: inline-block;
}

header nav ul li {
  display: block;
  float: right;
  padding: 10px 20px;
}

header nav ul li a {
  color: #fff;
  text-decoration: none;
}

header nav ul li a:hover {
  color: #2196F3;
  transition: color .3s linear;
}


main {
  padding: 20px;
}

main section {
  margin-bottom: 30px;
}

main section h2 {
  color: #333;
}

main section p {
  line-height: 1.6;
}

#contact form {
  max-width: 400px;
  margin: 0 auto;
  text-align: right;
}

#contact form input, #contact form select, #contact form button {
  display: block;
  width: 100%;
  margin-bottom: 10px;
  padding: 10px;
  box-sizing: border-box;
}

#contact form button {
  background-color: #333;
  color: #fff;
  cursor: pointer;
  border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
