<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 140.2mm; inline-size: 37.0mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 150.5mm; inline-size: 110.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 63.0mm; inset-block-start: 159.5mm; inline-size: 49.5mm; block-size: 9.2mm; font-size: 10.9pt"></div>
