    padding: 0;
    text-align: center;
}

nav ul li {
    display: inline-block;
    margin: 0 10px;
}

nav ul li a {
    text-decoration: none;
    color: #fff;
}

h2 {
    color: #000;
}

p {
    color: #333;
}

#course-info {
    display: flex;
    justify-content: space-between;
}

.course {
    width: 30%;
    background: #f5f5f5;
    padding: 20px;
    margin: 20px 0;
    border-radius: 5px;
}

form {
    display: flex;
    flex-direction: column;
    width: 50%;
    margin: 20px 0;
}

form input, form button {
    margin: 10px 0;
    font-size: 16px;
    border-radius: 5px;
    padding: 10px;
}

form button {
    background: #333;
    color: #fff;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
