<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 34.0mm; inset-block-start: 24.6mm; inline-size: 31.5mm; block-size: 6.6mm; font-size: 18.6pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 34.1mm; inset-block-start: 41.4mm; inline-size: 41.6mm; block-size: 8.9mm; font-size: 25.3pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 34.2mm; inset-block-start: 96.5mm; inline-size: 83.2mm; block-size: 6.2mm; font-size: 17.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 107.9mm; inline-size: 141.6mm; block-size: 18.5mm; font-size: 17.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 127.1mm; inline-size: 141.7mm; block-size: 31.6mm; font-size: 17.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 159.3mm; inline-size: 141.9mm; block-size: 37.8mm; font-size: 17.8pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 41.7mm; inset-block-start: 206.9mm; inline-size: 105.0mm; block-size: 39.9mm; font-size: 18.9pt"><li>{{ slot_6 }}</li></ul>
<footer class="box" style="inset-inline-start: 104.8mm; inset-block-start: 264.3mm; inline-size: 2.2mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
