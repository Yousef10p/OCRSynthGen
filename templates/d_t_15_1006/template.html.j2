<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.9mm; inset-block-start: 16.5mm; inline-size: 85.3mm; block-size: 81.8mm; font-size: 12.9pt"></div>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 15.5mm; inline-size: 86.5mm; block-size: 67.3mm; font-size: 12.7pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 86.6mm; inline-size: 31.1mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 93.1mm; inline-size: 35.7mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 98.2mm; inline-size: 86.5mm; block-size: 35.7mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 101.8mm; inline-size: 60.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 107.7mm; inline-size: 79.1mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 113.3mm; inline-size: 86.5mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 28.1mm; inset-block-start: 137.1mm; inline-size: 170.4mm; block-size: 112.8mm; font-size: 13.3pt"></div>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 252.8mm; inline-size: 55.2mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 196.9mm; inset-block-start: 262.8mm; inline-size: 5.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
