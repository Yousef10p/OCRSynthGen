<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}
.header {
  background-color: #ffcc00;
  text-align: center;
  padding: 20px;
  margin-bottom: 20px;
}
h1 {
  color: #fff;
}
.product-grid, .review-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-gap: 20px;
  padding: 20px;
  margin-bottom: 20px;
}
.product-cell, .review-cell {
  border: 1px solid #000;
  padding: 20px;
  text-align: center;
}
.product-image {
  background-color: #00ff00;
  width: 100%;
  height: 100px;
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</div>
<div class="product-grid">
<div class="product-cell">
<div class="product-image">{{ slot_2 }}</div>
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
</div>
<div class="product-cell">
<div class="product-image">{{ slot_5 }}</div>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div class="product-cell">
<div class="product-image">{{ slot_8 }}</div>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
</div>
<div class="review-grid">
<div class="review-cell">
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
</div>
<div class="review-cell">
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>