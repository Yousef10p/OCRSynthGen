    font-size: 1.5em;
}

#content-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 1em;
    padding: 1em;
}

#left-column {
    flex: 1;
    background-color: #f8f8f8;
    padding: 1em;
}

#main-content {
    flex: 3;
    background-color: #fff;
    padding: 1em;
}

#sidebar {
    flex: 1;
