    width: 200px;
    height: 100%;
    background: #f0f0f0;
    padding: 20px;
    box-sizing: border-box;
}

.menu ul {
    padding: 0;
    margin: 0;
    list-style-type: none;
}

.menu li {
    margin-bottom: 10px;
}

.main-content {
    margin-right: 200px;
    padding: 20px;
}

.studio-image, .service-image, .classes-image, .membership-image {
