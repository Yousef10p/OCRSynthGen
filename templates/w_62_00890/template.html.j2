</ul>
</nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<button>{{ slot_5 }}</button>
</header>
<section id="properties">
<h2>{{ slot_6 }}</h2>
<div class="property">{{ slot_7 }}</div>
<div class="property">{{ slot_8 }}</div>
<div class="property">{{ slot_9 }}</div>
</section>
<section id="about">
