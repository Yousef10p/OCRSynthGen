<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 65.7mm; inline-size: 107.2mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 54.4mm; inset-block-start: 78.3mm; inline-size: 131.0mm; block-size: 30.5mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 124.0mm; inline-size: 152.4mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 59.3mm; inset-block-start: 143.2mm; inline-size: 126.1mm; block-size: 35.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 186.3mm; inline-size: 99.0mm; block-size: 5.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 199.0mm; inline-size: 152.4mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 56.6mm; inset-block-start: 222.6mm; inline-size: 112.3mm; block-size: 13.5mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 107.2mm; inset-block-start: 259.6mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
