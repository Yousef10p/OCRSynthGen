<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background-color: #f5f5f5;
    padding: 10px 0;
}

.logo {
    font-size: 24px;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin: 0 10px;
}

nav ul li a {
    text-decoration: none;
    color: black;
}

nav ul li.dropdown {
    position: relative;
}

nav ul li.dropdown ul {
    position: absolute;
    top: 100%;
    right: 0;
    display: none;
    background-color: #f5f5f5;
    padding: 10px;
}

nav ul li.dropdown:hover ul {
    display: block;
}

.product {
    margin: 20px;
    text-align: center;
}

.product-image {
    background-color: #f5f5f5;
    height: 200px;
    margin: 10px auto;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li>
<a>{{ slot_1 }}</a>
</li>
<li class="dropdown">
<a>{{ slot_2 }}</a>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</nav>
</header>
<main>
<section class="product">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="product-image">{{ slot_10 }}</div>
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<h3>{{ slot_14 }}</h3>
<p>{{ slot_15 }}</p>
</section>

</main>
</body>
</html>