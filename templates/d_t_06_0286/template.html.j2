<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 86.0mm; inset-block-start: 34.9mm; inline-size: 43.9mm; block-size: 4.6mm; font-size: 13.2pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 13.3mm; inset-block-start: 63.3mm; inline-size: 61.9mm; block-size: 75.7mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 77.6mm; inset-block-start: 64.1mm; inline-size: 125.5mm; block-size: 41.7mm; font-size: 13.1pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 77.6mm; inset-block-start: 111.6mm; inline-size: 86.5mm; block-size: 10.1mm; font-size: 14.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 77.6mm; inset-block-start: 122.8mm; inline-size: 125.5mm; block-size: 32.2mm; font-size: 13.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 77.6mm; inset-block-start: 160.7mm; inline-size: 62.8mm; block-size: 4.6mm; font-size: 13.2pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 77.6mm; inset-block-start: 166.4mm; inline-size: 125.5mm; block-size: 27.4mm; font-size: 12.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 77.6mm; inset-block-start: 199.9mm; inline-size: 125.5mm; block-size: 22.6mm; font-size: 12.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 77.6mm; inset-block-start: 228.6mm; inline-size: 125.5mm; block-size: 22.6mm; font-size: 12.8pt">{{ slot_7 }}</p>
</div></body>
</html>
