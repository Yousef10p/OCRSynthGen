    justify-content: space-between;
}

.package, .itinerary, .destination {
    padding: 20px;
    border: 1px solid black;
    margin-bottom: 20px;
}

h2 {
    margin-bottom: 10px;
}

@media (max-width: 768px) {
    main {
        flex-direction: column;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
