    display: flex;
}

nav li {
    margin: 0 10px;
}

nav a {
    color: white;
    text-decoration: none;
}

#book-now-button {
    padding: 10px 20px;
    border: 2px solid white;
    cursor: pointer;
}

main {
    margin-top: 70px;
    padding: 20px;
