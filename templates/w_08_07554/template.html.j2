<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 1em 0;
    background-color: #f5f5f5;
}

header form{
    display: flex;
    flex-direction: column;
}

nav ul {
    display: flex;
    justify-content: space-around;
    margin: 1em 0;
}

main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1em;
    margin: 1em;
}

section {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding: 1em;
    border: 1px solid #ddd;
}

section img, section video {
    width: 100%;
    aspect-ratio: 16/9;
    background-color: #ddd;
}

section a {
    padding: 0.5em;
    text-align: center;
    background-color: #ccc;
    color: #fff;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
</form>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_2 }}</span>
<span class="">{{ slot_3 }}</span>
</form>
</header>
<nav>
<ul>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</nav>
<main>
<section>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_10 }}</p>
<a>{{ slot_11 }}</a>
</section>
<section>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<a>{{ slot_14 }}</a>
</section>

</main>
</body>
</html>