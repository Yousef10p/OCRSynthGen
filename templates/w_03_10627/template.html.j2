<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    height: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: var(--font-body);
    color: #000;
}

.container {
    width: 80%;
    background-color: #eee;
    padding: 20px;
    box-sizing: border-box;
}

.nav {
    display: flex;
    align-items: center;
}

.icon {
    width: 50px;
    height: 50px;
    background-color: #000;
    margin-left: 20px;
}

.menu a {
    margin-left: 20px;
    text-decoration: none;
}

.content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
}

.track, .artist, .playlist {
    height: 100px;
    background-color: #000;
} 

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="nav">
<div class="icon"></div>
<div class="menu">
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
</div>
</div>
<div class="content">
<section id="tracks">
<h1>{{ slot_3 }}</h1>
<div class="track">{{ slot_4 }}</div>
<div class="track">{{ slot_5 }}</div>
<div class="track">{{ slot_6 }}</div>
</section>
<section id="artists">
<h1>{{ slot_7 }}</h1>
<div class="artist">{{ slot_8 }}</div>
<div class="artist">{{ slot_9 }}</div>
<div class="artist">{{ slot_10 }}</div>
</section>
<section id="playlists">
<h1>{{ slot_11 }}</h1>
<div class="playlist">{{ slot_12 }}</div>
<div class="playlist">{{ slot_13 }}</div>
<div class="playlist">{{ slot_14 }}</div>
</section>
</div>
</div>
</body>
</html>