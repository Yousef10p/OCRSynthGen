body {
    font-family: var(--font-body);
    background-color: #008000;
    color: #ffffff;
    text-align: center;
}

header {
    background-color: #000080;
    padding: 1em 0;
}

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
}

nav ul li {
    display: inline;
    padding: 0.5em;
}

nav ul li a {
    text-decoration: none;
    color: #ffffff;
}

section#hero {
    background-color: #000080;
    padding: 2em 0;
}

section#hero h1 {
    font-size: 2em;
}

section#hero p {
