}

div.call-to-action {
    background-color: #008000;
    padding: 2em;
    margin-top: 2em;
}

div.call-to-action form {
    margin-top: 2em;
}

div.call-to-action form input {
    padding: 0.5em;
    margin-left: 0.5em;
}

div.columns {
    display: flex;
    justify-content: center;
    margin: 2em 0;
}

div.columns section,
div.columns aside {
    width: 40%;
    margin: 0 1em;
    padding: 1em;
    background-color: #000080;
}

div.columns h2 {
    font-size: 1.5em;
}

div.columns div.product,
div.columns div.review {
    background-color: #ffffff;
    color: #000000;
    height: 200px;
    margin: 1em 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
