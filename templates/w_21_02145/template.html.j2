 padding: 10px;
}

nav ul {
 list-style-type: none;
 padding: 0;
 display: flex;
 justify-content: space-around;
}

nav a {
 color: #E8AA65;
 text-decoration: none;
}

nav a:hover {
 color: #855050;
}

form {
 display: flex;
 flex-direction: column;
 margin: 1em;
}

form input, form textarea {
 margin-bottom: 25px;
 border: 0;
 padding: 10px;
 background-color: #CDCDCD;
}

.image_placeholder_menu, .image_placeholder_contact, .image_placeholder_newsletter {
 width: 100%;
 height: 500px;
 background-color: #AA6262;
 margin: 25px 0 ;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
