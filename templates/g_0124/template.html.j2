<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.4; --align: start; --page-width: 215.9mm; --page-height: 355.6mm; --page-margin: 14mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main><p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: justify; font-size: 1.05em">{{ slot_1 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1em 0.4em">{{ slot_2 }}</h2>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: var(--align); font-size: 0.95em">{{ slot_3 }}</p>
<h3 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1.4em 0.4em">{{ slot_4 }}</h3>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
<p style="margin-block: 0.15em">{{ slot_5 }}</p>
<p style="margin-block: 0.15em">{{ slot_6 }}</p>
<p style="margin-block: 0.15em">{{ slot_7 }}</p>
</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_8 }}</span><span>{{ slot_9 }}</span><span>{{ slot_10 }}</span></footer>
</div></body>
</html>
