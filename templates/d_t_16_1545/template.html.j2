<ul class="box" style="inset-inline-start: 18.8mm; inset-block-start: 125.7mm; inline-size: 144.4mm; block-size: 34.7mm; font-size: 32.8pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 184.3mm; inset-block-start: 171.8mm; inline-size: 62.3mm; block-size: 7.3mm; font-size: 20.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 10.9mm; inset-block-start: 176.0mm; inline-size: 32.8mm; block-size: 7.3mm; font-size: 20.6pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 172.8mm; inset-block-start: 190.3mm; inline-size: 23.1mm; block-size: 21.3mm; font-size: 15.1pt"></div>
<footer class="box" style="inset-inline-start: 16.5mm; inset-block-start: 193.1mm; inline-size: 77.4mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 197.9mm; inset-block-start: 195.0mm; inline-size: 36.8mm; block-size: 11.2mm; font-size: 15.9pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 264.8mm; inset-block-start: 197.0mm; inline-size: 2.6mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
