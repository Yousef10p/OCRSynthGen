<h2 class="box" style="inset-inline-start: 35.2mm; inset-block-start: 100.7mm; inline-size: 8.9mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 38.2mm; inset-block-start: 105.8mm; inline-size: 59.1mm; block-size: 50.8mm; font-size: 14.4pt">{{ slot_6 }}</p>
