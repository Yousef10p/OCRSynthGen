    background-color: #aaa;
}

.hero-content {
    width: 50%;
}

.cta-button {
    display: inline-block;
    padding: 0.5em 1em;
    background-color: #333;
    color: #fff;
    text-transform: uppercase;
    border-radius: 5px;
}

.recipe, .flavor {
    width: 50%;
    margin: 2em auto;
}

footer {
    background-color: #333;
    color: #fff;
    position: absolute;
    width: 100%;
    bottom: 0;
}

footer ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
    padding: 1em 0;
}

footer p {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
