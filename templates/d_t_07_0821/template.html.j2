<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 13.8mm; inline-size: 111.4mm; block-size: 27.0mm; font-size: 15.3pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 145.4mm; inset-block-start: 44.3mm; inline-size: 33.1mm; block-size: 26.8mm; font-size: 15.2pt"></div>
<h2 class="box" style="inset-inline-start: 27.7mm; inset-block-start: 48.0mm; inline-size: 75.1mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 56.0mm; inline-size: 105.4mm; block-size: 9.8mm; font-size: 13.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 67.5mm; inline-size: 107.0mm; block-size: 21.2mm; font-size: 15.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 145.7mm; inset-block-start: 74.5mm; inline-size: 33.9mm; block-size: 13.8mm; font-size: 9.7pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 98.6mm; inline-size: 124.0mm; block-size: 24.8mm; font-size: 40.0pt">{{ slot_5 }}</h2>
<h2 class="box" style="inset-inline-start: 27.7mm; inset-block-start: 136.4mm; inline-size: 50.9mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_6 }}</h2>
