<h2 class="box" style="inset-inline-start: 28.1mm; inset-block-start: 247.8mm; inline-size: 47.7mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 252.1mm; inline-size: 111.3mm; block-size: 13.8mm; font-size: 9.7pt">{{ slot_9 }}</p>
</div></body>
</html>
