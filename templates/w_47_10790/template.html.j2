    margin-right: 20px;
}

.cta {
    text-align: center;
    padding: 40px 0;
}

.cta button {
    padding: 10px 20px;
    font-size: 20px;
    cursor: pointer;
}

.services, .testimonials, .faq {
    margin: 20px;
}

.services, .testimonials, .faq h2 {
    font-size: 28px;
    color: #333;
}

.services, .testimonials, .faq p {
    font-size: 18px;
    line-height: 1.6;
}


.services, .testimonials, .faq {
    height: 200px;
    width: 100%;
    background-color: #ccc;
}

.faq h3 {
    font-size: 18px;
    color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
