<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 74.5mm; inline-size: 120.5mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 80.9mm; inline-size: 159.2mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 88.6mm; inline-size: 141.6mm; block-size: 138.2mm; font-size: 9.0pt">{{ slot_6 }}</p>
