<p>{{ slot_3 }}</p>
<p>{{ slot_4 }}</p>
</aside>
<main>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
</main>
<aside id="kitchen">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
</aside>
<section id="recipe-display">
