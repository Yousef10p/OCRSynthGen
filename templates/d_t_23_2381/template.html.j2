<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 91.8mm; inset-block-start: 19.9mm; inline-size: 30.3mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 62.3mm; inset-block-start: 25.2mm; inline-size: 7.0mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 144.7mm; inset-block-start: 25.2mm; inline-size: 7.0mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 33.7mm; inset-block-start: 29.9mm; inline-size: 11.9mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 33.6mm; inset-block-start: 33.4mm; inline-size: 70.6mm; block-size: 6.3mm; font-size: 8.9pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 33.6mm; inset-block-start: 40.5mm; inline-size: 37.9mm; block-size: 2.7mm; font-size: 7.7pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 33.6mm; inset-block-start: 44.0mm; inline-size: 71.0mm; block-size: 16.8mm; font-size: 9.5pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 33.7mm; inset-block-start: 61.6mm; inline-size: 69.6mm; block-size: 6.3mm; font-size: 8.9pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 33.6mm; inset-block-start: 68.6mm; inline-size: 70.7mm; block-size: 9.8mm; font-size: 9.2pt"><li>{{ slot_8 }}</li></ul>
<p class="box" style="inset-inline-start: 55.2mm; inset-block-start: 88.2mm; inline-size: 21.7mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_9 }}</p>
</div></body>
</html>
