<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 82.9mm; inline-size: 170.2mm; block-size: 27.7mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 63.9mm; inset-block-start: 113.9mm; inline-size: 129.0mm; block-size: 30.7mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 63.9mm; inset-block-start: 140.9mm; inline-size: 129.0mm; block-size: 14.3mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 160.3mm; inline-size: 170.2mm; block-size: 14.3mm; font-size: 10.9pt">{{ slot_3 }}</p>
