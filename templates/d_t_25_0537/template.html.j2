<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 91.7mm; inset-block-start: 20.0mm; inline-size: 30.3mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 63.3mm; inset-block-start: 25.3mm; inline-size: 4.6mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 145.6mm; inset-block-start: 25.3mm; inline-size: 4.8mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 58.8mm; inset-block-start: 30.7mm; inline-size: 14.5mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.1mm; inset-block-start: 30.6mm; inline-size: 14.4mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 33.4mm; inset-block-start: 34.6mm; inline-size: 70.7mm; block-size: 64.4mm; font-size: 18.3pt"></div>
<div class="box ph" style="inset-inline-start: 115.8mm; inset-block-start: 34.3mm; inline-size: 70.7mm; block-size: 67.5mm; font-size: 21.2pt"></div>
<div class="box ph" style="inset-inline-start: 33.4mm; inset-block-start: 105.7mm; inline-size: 70.9mm; block-size: 72.1mm; font-size: 20.4pt"></div>
<div class="box ph" style="inset-inline-start: 115.7mm; inset-block-start: 106.6mm; inline-size: 70.9mm; block-size: 75.6mm; font-size: 21.4pt"></div>
<div class="box ph" style="inset-inline-start: 33.0mm; inset-block-start: 184.2mm; inline-size: 71.4mm; block-size: 75.0mm; font-size: 35.4pt"></div>
<div class="box ph" style="inset-inline-start: 115.8mm; inset-block-start: 185.9mm; inline-size: 70.8mm; block-size: 74.8mm; font-size: 19.3pt"></div>
</div></body>
</html>
