<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 176.5mm; inset-block-start: 14.3mm; inline-size: 21.2mm; block-size: 9.5mm; font-size: 13.5pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 164.2mm; inset-block-start: 23.5mm; inline-size: 33.7mm; block-size: 11.9mm; font-size: 16.9pt"></div>
<p class="box" style="inset-inline-start: 165.1mm; inset-block-start: 35.7mm; inline-size: 33.2mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_1 }}</p>
<h1 class="box" style="inset-inline-start: 92.3mm; inset-block-start: 89.3mm; inline-size: 102.4mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_2 }}</h1>
<div class="box ph" style="inset-inline-start: 0.3mm; inset-block-start: 95.8mm; inline-size: 209.5mm; block-size: 77.6mm; font-size: 14.7pt"></div>
<footer class="box" style="inset-inline-start: 55.6mm; inset-block-start: 264.7mm; inline-size: 89.1mm; block-size: 10.2mm; font-size: 9.6pt">{{ slot_3 }}</footer>
</div></body>
</html>
