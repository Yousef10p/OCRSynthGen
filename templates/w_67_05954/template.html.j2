<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #f2f2f2;
}

header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px;
    background-color: #4caf50;
    color: #fff;
}

header img {
    height: 50px;
    width: auto;
}

header input {
    width: 50%;
    padding: 10px;
    border-radius: 5px;
    border: none;
    outline: none;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li ul {
    display: none;
    position: absolute;
}

nav ul li:hover > ul {
    display: block;
}

.testimonial, .case-study {
    background-color: #fff;
    padding: 20px;
    margin: 20px;
    border-radius: 5px;
}

footer {
    background-color: #4caf50;
    color: #fff;
    text-align: center;
    padding: 20px;
}

footer form {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 20px;
}

footer form input, footer form textarea {
    width: 100%;
    padding: 10px;
    margin-bottom: 20px;
    border-radius: 5px;
    border: none;
    outline: none;
}

footer form input[type="submit"] {
    background-color: #fff;
    color: #4caf50;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
