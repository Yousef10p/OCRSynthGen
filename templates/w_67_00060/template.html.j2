<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  font-family: var(--font-body);
}


header {
  background-color: #f8f9fa;
  padding: 20px;
  text-align: center;
}

header input[type="text"] {
  width: 80%;
  padding: 12px 20px;
  margin: 8px 0;
  display: inline-block;
  border: 1px solid #ccc;
  border-radius: 4px;
}


main {
  display: flex;
}

.featured {
  width: 70%;
  padding: 20px;
}

.carousel {
  display: flex;
  overflow-x: auto;
}

.carousel-cell {
  width: 300px;
  height: 200px;
  flex: none; 
  text-align: center;
  background-color: #f8f9fa;
  margin-left: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.categories {
  width: 30%;
  padding: 20px;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 10px;
}

.category {
  height: 100px;
  background-color: #f8f9fa;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
</header>
<main>
<div class="featured">
<h2>{{ slot_1 }}</h2>
<div class="carousel">
<div class="carousel-cell">{{ slot_2 }} <p>{{ slot_3 }}</p></div>
<div class="carousel-cell">{{ slot_4 }} <p>{{ slot_5 }}</p></div>
<div class="carousel-cell">{{ slot_6 }} <p>{{ slot_7 }}</p></div>

</div>
</div>
<div class="categories">
<h2>{{ slot_8 }}</h2>
<div class="category-grid">
<div class="category">{{ slot_9 }} <p>{{ slot_10 }}</p></div>
<div class="category">{{ slot_11 }} <p>{{ slot_12 }}</p></div>
<div class="category">{{ slot_13 }} <p>{{ slot_14 }}</p></div>

</div>
</div>
</main>
</body>
</html>