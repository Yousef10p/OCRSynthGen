<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 61.3mm; inset-block-start: 54.4mm; inline-size: 117.1mm; block-size: 11.4mm; font-size: 10.8pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 61.5mm; inset-block-start: 71.6mm; inline-size: 48.2mm; block-size: 22.4mm; font-size: 15.9pt"></div>
<p class="box" style="inset-inline-start: 61.3mm; inset-block-start: 95.6mm; inline-size: 63.6mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 104.5mm; inline-size: 121.8mm; block-size: 7.3mm; font-size: 10.3pt"><li>{{ slot_2 }}</li></ul>
<h2 class="box" style="inset-inline-start: 56.3mm; inset-block-start: 117.5mm; inline-size: 74.6mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 122.7mm; inline-size: 122.1mm; block-size: 11.4mm; font-size: 10.8pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 56.3mm; inset-block-start: 138.8mm; inline-size: 76.4mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 144.0mm; inline-size: 117.2mm; block-size: 15.5mm; font-size: 11.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 56.3mm; inset-block-start: 164.2mm; inline-size: 96.9mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 169.4mm; inline-size: 122.1mm; block-size: 32.0mm; font-size: 11.3pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 205.8mm; inline-size: 113.9mm; block-size: 7.3mm; font-size: 10.3pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 61.5mm; inset-block-start: 248.2mm; inline-size: 116.6mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
