}

.property-image {
  aspect-ratio: 1 / 1;
  background-color: #c0c0c0;
}

.map {
  aspect-ratio: 2 / 1;
  background-color: #c0c0c0;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
