<h2 class="box" style="inset-inline-start: 34.9mm; inset-block-start: 68.9mm; inline-size: 23.0mm; block-size: 20.2mm; font-size: 28.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 86.7mm; inline-size: 33.2mm; block-size: 16.2mm; font-size: 15.3pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 39.1mm; inset-block-start: 106.4mm; inline-size: 14.9mm; block-size: 20.2mm; font-size: 28.6pt">{{ slot_5 }}</h2>
