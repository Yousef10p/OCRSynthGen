<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 142.0mm; inset-block-start: 17.0mm; inline-size: 58.8mm; block-size: 77.3mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 19.1mm; inline-size: 110.5mm; block-size: 26.9mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 48.8mm; inline-size: 110.6mm; block-size: 62.5mm; font-size: 11.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 114.0mm; inline-size: 110.6mm; block-size: 34.8mm; font-size: 11.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 147.0mm; inset-block-start: 142.4mm; inline-size: 49.3mm; block-size: 38.8mm; font-size: 15.7pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 151.6mm; inline-size: 110.7mm; block-size: 42.7mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 197.1mm; inline-size: 110.5mm; block-size: 23.0mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 222.8mm; inline-size: 110.6mm; block-size: 46.7mm; font-size: 11.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 278.1mm; inline-size: 48.1mm; block-size: 2.1mm; font-size: 5.8pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 162.9mm; inset-block-start: 284.7mm; inline-size: 37.5mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_7 }}</footer>
</div></body>
</html>
