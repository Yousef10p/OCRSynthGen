<p class="box" style="inset-inline-start: 160.5mm; inset-block-start: 133.5mm; inline-size: 47.4mm; block-size: 80.5mm; font-size: 15.2pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 6.8mm; inset-block-start: 151.1mm; inline-size: 31.4mm; block-size: 31.0mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 6.8mm; inset-block-start: 192.8mm; inline-size: 31.7mm; block-size: 31.0mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 6.5mm; inset-block-start: 234.8mm; inline-size: 31.9mm; block-size: 31.2mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 142.8mm; inset-block-start: 250.8mm; inline-size: 64.3mm; block-size: 14.8mm; font-size: 14.0pt"></div>
<p class="box" style="inset-inline-start: 150.7mm; inset-block-start: 268.0mm; inline-size: 48.2mm; block-size: 4.9mm; font-size: 13.7pt">{{ slot_2 }}</p>
<footer class="box" style="inset-inline-start: 7.5mm; inset-block-start: 269.5mm; inline-size: 3.3mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</footer>
</div></body>
</html>
