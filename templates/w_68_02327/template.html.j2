<li class="o-nav__item"><a class="o-nav__link">{{ slot_3 }}</a></li>
<li class="o-nav__item"><a class="o-nav__link">{{ slot_4 }}</a></li>
</ul>
</nav>
<section class="u-content">
<div class="u-content__image">
<div class="u-content__image--placeholder">{{ slot_5 }}</div>
<div class="u-content__image--placeholder">{{ slot_6 }}</div>
<div class="u-content__image--placeholder">{{ slot_7 }}</div>
</div>
<div class="u-content__text">
<div class="u-content__text--paragraph">
<p>{{ slot_8 }}</p>
</div>
<div class="u-content__text--paragraph">
<p>{{ slot_9 }}</p>
</div>
</div>
</section>
<section class="u-login">
