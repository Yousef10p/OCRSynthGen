<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

.u-header {
    background: linear-gradient(to left, #FF0000, #0000FF);
    color: #fff;
    padding: 10px 0;
    text-align: center;
}
.u-header__title {
    font-size: 2em;
    text-shadow: -2px 2px 4px #000000;
}

.o-nav {
    background-color: #555;
}
.o-nav__list {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
}
.o-nav__item {
    float: right;
}
.o-nav__link {
    display: block;
    color: #fff;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}
.o-nav__link:hover {
    background-color: #111;
}

.u-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    padding: 20px;
}
.u-content__image--placeholder {
    background-color: #ddd;
    padding: 20px;
    font-size: 20px;
}
.u-content__text--paragraph {
    grid-column: 1 / 3;
    padding: 20px;
}

.u-login__form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 300px;
    margin: 0 auto;
}
.u-login__form--input,
.u-login__form--select {
    padding: 5px 10px;
    margin: 10px 0;
    border-radius: 5px;
    border: 1px solid #555;
}
.u-login__form--label {
    display: flex;
    align-items: center;
}
.u-login__form--button {
    padding: 5px 10px;
    margin: 10px 0;
    border-radius: 5px;
    border: 1px solid #555;
    background-color: #eee;
    transition: background-color 0.3s ease-in-out;
    cursor: pointer;
}
.u-login__form--button:hover {
    background-color: #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header class="u-header">
<h1 class="u-header__title">{{ slot_0 }}</h1>
</header>
<nav class="o-nav">
<ul class="o-nav__list">
