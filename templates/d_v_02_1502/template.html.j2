<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 217.0mm; inset-block-start: 6.9mm; inline-size: 3.9mm; block-size: 2.5mm; font-size: 7.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 71.3mm; inset-block-start: 10.0mm; inline-size: 5.2mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 209.2mm; inset-block-start: 16.7mm; inline-size: 20.0mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 32.8mm; inset-block-start: 19.4mm; inline-size: 82.6mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 177.8mm; inset-block-start: 28.3mm; inline-size: 83.4mm; block-size: 32.5mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 32.5mm; inset-block-start: 34.6mm; inline-size: 83.1mm; block-size: 86.8mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 178.0mm; inset-block-start: 64.6mm; inline-size: 83.4mm; block-size: 91.8mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 32.5mm; inset-block-start: 125.2mm; inline-size: 83.4mm; block-size: 75.8mm; font-size: 11.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 178.4mm; inset-block-start: 160.1mm; inline-size: 83.0mm; block-size: 24.6mm; font-size: 11.6pt">{{ slot_8 }}</p>
</div></body>
</html>
