<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background: #fff;
  color: #000;
}

header {
  display: flex;
  justify-content: flex-end;
  padding: 20px;
  background: #ff0000; 
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin-left: 10px;
}

nav ul li a {
  color: #ffff00; 
}

section {
  padding: 20px;
}

.deal, .special {
  margin-bottom: 10px;
  padding: 10px;
  background: #008000; 
  color: #fff;
}

.map {
  height: 200px;
  background: #000; 
}

footer {
  text-align: center;
  padding: 20px;
  background: #ffff00; 
  color: #000;
}

footer a {
  color: #ff0000; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<section id="deals">
<h2>{{ slot_4 }}</h2>
<div class="deal">{{ slot_5 }}</div>
<div class="deal">{{ slot_6 }}</div>
<div class="deal">{{ slot_7 }}</div>
</section>
<section id="specials">
<h2>{{ slot_8 }}</h2>
<div class="special">{{ slot_9 }}</div>
<div class="special">{{ slot_10 }}</div>
</section>
<section id="map">
<h2>{{ slot_11 }}</h2>
<div class="map">{{ slot_12 }}</div>
</section>
<footer>
<p>{{ slot_13 }}</p>
<ul>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
<li><a>{{ slot_16 }}</a></li>
</ul>
</footer>
</body>
</html>