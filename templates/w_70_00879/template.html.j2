}

.footer-col a {
    display: block;
    color: black;
    padding: 14px 16px;
    text-decoration: none;
    transition: 0.3s;
}

.footer-col a:hover {
    color: red;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
