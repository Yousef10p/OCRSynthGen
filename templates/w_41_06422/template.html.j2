<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #f8f8f8;
    padding: 10px 0;
}

#search-bar {
    width: 70%;
    margin: 0 auto;
    display: block;
    padding: 10px;
}

nav {
    width: 20%;
    float: right;
    background-color: #f0f0f0;
    padding: 10px;
}

ul {
    list-style-type: none;
}

section {
    margin-top: 100px;
    padding: 20px;
}

.square {
    width: 200px;
    height: 200px;
    background-color: #ddd;
    margin: 20px 0;
}

#square1 {
    float: right;
}

#square2 {
    float: left;
}

footer {
    clear: both;
    background-color: #f8f8f8;
    padding: 10px 0;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
</header>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</nav>
<section>
<div class="square" id="square1"></div>
<p>{{ slot_10 }}</p>
<div class="square" id="square2"></div>
<p>{{ slot_11 }}</p>
</section>
<footer>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</footer>
</body>
</html>