<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
    color: #333;
}
header {
    background-color: #f5f5f5;
    text-align: center;
    padding: 20px;
}
.promotion {
    color: green;
    font-size: 20px;
}
main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 20px;
}
.product {
    border: 1px solid #ccc;
    padding: 10px;
}
.product h2 {
    margin-bottom: 10px;
}
button {
    display: block;
    width: 100%;
    padding: 10px;
    background-color: blue;
    color: white;
    border: none;
    cursor: pointer;
    margin-top: 20px;
}
footer {
    background-color: #f5f5f5;
    text-align: center;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<p class="promotion">{{ slot_0 }}</p>
<h1>{{ slot_1 }}</h1>
</header>
<main>
<section class="product">
<div class="image ph"></div> 
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<button>{{ slot_4 }}</button>
<div class="reviews">
<h4>{{ slot_5 }}</h4>
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
</div>
</section>
<section class="product">
<div class="image ph"></div> 
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<button>{{ slot_10 }}</button>
<div class="reviews">
<h4>{{ slot_11 }}</h4>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
</div>
</section>
</main>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>