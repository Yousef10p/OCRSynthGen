<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 20.9mm; inset-block-start: 18.9mm; inline-size: 175.6mm; block-size: 8.7mm; font-size: 12.0pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 83.8mm; inset-block-start: 32.6mm; inline-size: 49.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 47.8mm; inset-block-start: 36.7mm; inline-size: 121.7mm; block-size: 6.6mm; font-size: 9.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 46.7mm; inline-size: 140.6mm; block-size: 40.7mm; font-size: 9.0pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 56.4mm; inline-size: 6.4mm; block-size: 148.5mm; font-size: 20.0pt">{{ slot_4 }}</header><h2 class="box" style="inset-inline-start: 43.9mm; inset-block-start: 95.3mm; inline-size: 36.7mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 94.9mm; inline-size: 86.5mm; block-size: 23.7mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 107.4mm; inline-size: 86.5mm; block-size: 132.8mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 121.1mm; inline-size: 86.5mm; block-size: 128.8mm; font-size: 10.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 252.5mm; inline-size: 61.7mm; block-size: 2.6mm; font-size: 7.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 252.4mm; inline-size: 83.0mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_10 }}</p>
</div></body>
</html>
