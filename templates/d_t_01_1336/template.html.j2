<p class="box" style="inset-inline-start: 110.5mm; inset-block-start: 87.8mm; inline-size: 83.1mm; block-size: 13.1mm; font-size: 12.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 110.5mm; inset-block-start: 101.5mm; inline-size: 88.2mm; block-size: 13.1mm; font-size: 12.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.4mm; inset-block-start: 106.0mm; inline-size: 25.5mm; block-size: 2.8mm; font-size: 7.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 110.5mm; inset-block-start: 115.3mm; inline-size: 86.3mm; block-size: 36.1mm; font-size: 12.8pt">{{ slot_6 }}</p>
