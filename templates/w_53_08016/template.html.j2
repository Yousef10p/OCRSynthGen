}

nav a {
    text-decoration: none;
    color: #000;
}

#logo {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%); 
    width: 200px; 
    height: 60px; 
    background-color: #ff2323; 
    display: flex;
    align-items: center; 
    justify-content: center; 
    color: #fff;
}

#banner {
    height: 200px; 
    background-color: #f4f4f4; 
    display: flex;
    align-items: center; 
    justify-content: center; 
    font-size: 2em;
    margin: 0;
}


main {
    display: flex;
}

main section {
    flex: 1; 
    padding: 1em;
}

main section p {
    text-align: center;
}


footer {
    background-color: #f4f4f4; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
