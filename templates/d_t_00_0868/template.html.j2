<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 61.0mm; inset-block-start: 12.2mm; inline-size: 94.1mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 23.7mm; inset-block-start: 26.3mm; inline-size: 81.5mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 8.4mm; inset-block-start: 30.7mm; inline-size: 1.9mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 36.0mm; inline-size: 20.9mm; block-size: 102.0mm; font-size: 11.1pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 64.4mm; inset-block-start: 36.0mm; inline-size: 29.9mm; block-size: 2.3mm; font-size: 6.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 64.4mm; inset-block-start: 39.9mm; inline-size: 32.9mm; block-size: 82.1mm; font-size: 11.1pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 104.6mm; inset-block-start: 42.3mm; inline-size: 91.2mm; block-size: 99.8mm; font-size: 35.4pt"></div>
<h2 class="box" style="inset-inline-start: 42.3mm; inset-block-start: 177.5mm; inline-size: 132.5mm; block-size: 12.1mm; font-size: 17.1pt">{{ slot_6 }}</h2>
<div class="box ph" style="inset-inline-start: 5.9mm; inset-block-start: 203.2mm; inline-size: 100.7mm; block-size: 70.9mm; font-size: 15.5pt"></div>
<div class="box ph" style="inset-inline-start: 109.4mm; inset-block-start: 203.6mm; inline-size: 101.4mm; block-size: 70.9mm; font-size: 15.5pt"></div>
</div></body>
</html>
