    color: white;
}

#right_column {
    width: 30%;
    float: right;
}

#center {
    width: 40%;
    float: right;
}

ul {
    list-style-type: none;
}

@media screen and (max-width: 600px) {
    body {
        font-size: 18px;
    }

    #left_column,
    #right_column,
    #center {
        width: auto;
        float: none;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
