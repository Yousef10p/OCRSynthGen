<div class="box ph" style="inset-inline-start: 61.7mm; inset-block-start: 151.8mm; inline-size: 87.8mm; block-size: 53.2mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 61.1mm; inset-block-start: 208.9mm; inline-size: 35.5mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_5 }}</p>
