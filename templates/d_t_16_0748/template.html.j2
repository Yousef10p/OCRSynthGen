<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.5mm; inset-block-start: 16.0mm; inline-size: 175.6mm; block-size: 79.4mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 97.5mm; inline-size: 43.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 107.2mm; inline-size: 28.1mm; block-size: 9.3mm; font-size: 13.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 107.3mm; inline-size: 87.0mm; block-size: 35.7mm; font-size: 12.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 117.3mm; inline-size: 87.0mm; block-size: 53.8mm; font-size: 12.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 147.7mm; inline-size: 28.7mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 152.8mm; inline-size: 87.1mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 170.8mm; inline-size: 86.9mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 175.8mm; inline-size: 16.6mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 181.4mm; inline-size: 87.0mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 26.7mm; inset-block-start: 198.4mm; inline-size: 176.1mm; block-size: 52.4mm; font-size: 37.1pt"></div>
<p class="box" style="inset-inline-start: 27.1mm; inset-block-start: 253.2mm; inline-size: 41.3mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 192.9mm; inset-block-start: 262.8mm; inline-size: 10.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_10 }}</footer>
</div></body>
</html>
