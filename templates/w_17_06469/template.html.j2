    right: 0;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 20px 0;
    display: flex;
    justify-content: space-around;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 20px;
}

nav a:hover {
    color: #ffcc00;
}

section {
    padding: 100px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.7);
}

section:nth-child(odd) {
    background-color: rgba(0, 0, 0, 0.5);
}

h1, p {
    color: white;
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
