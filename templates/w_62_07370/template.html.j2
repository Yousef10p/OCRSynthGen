}

.hero-content p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
}

button {
    padding: 0.8rem 1.6rem;
    font-size: 1rem;
    background-color: #000;
    color: #fff;
    border: none;
    cursor: pointer;
}

.about, .services {
    padding: 3rem 0;
    text-align: center;
}

footer {
    display: flex;
    justify-content: space-between;
    padding: 2rem;
    background-color: #000;
    color: #fff;
}

.footer-left, .footer-right {
    width: 50%;
    padding: 0 1rem;
}

.footer-right {
    text-align: left;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
