<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 123.2mm; inline-size: 159.4mm; block-size: 46.4mm; font-size: 11.9pt">{{ slot_4 }}</p>
<header class="box" style="inset-inline-start: 7.4mm; inset-block-start: 146.4mm; inline-size: 3.4mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_5 }}</header><h2 class="box" style="inset-inline-start: 19.3mm; inset-block-start: 176.5mm; inline-size: 12.4mm; block-size: 16.9mm; font-size: 40.0pt">{{ slot_6 }}</h2>
