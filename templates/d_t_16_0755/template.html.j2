<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.5mm; inset-block-start: 15.9mm; inline-size: 175.9mm; block-size: 58.7mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 77.3mm; inline-size: 153.8mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 26.5mm; inset-block-start: 84.1mm; inline-size: 86.3mm; block-size: 77.6mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 126.4mm; inset-block-start: 83.3mm; inline-size: 76.4mm; block-size: 8.9mm; font-size: 12.5pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 96.6mm; inline-size: 59.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 103.5mm; inline-size: 86.8mm; block-size: 26.9mm; font-size: 12.7pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 136.7mm; inline-size: 82.9mm; block-size: 40.4mm; font-size: 12.7pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 164.3mm; inline-size: 86.7mm; block-size: 12.6mm; font-size: 11.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 26.7mm; inset-block-start: 181.2mm; inline-size: 175.3mm; block-size: 69.2mm; font-size: 39.2pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 253.4mm; inline-size: 171.1mm; block-size: 8.6mm; font-size: 9.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 197.4mm; inset-block-start: 262.7mm; inline-size: 4.8mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
