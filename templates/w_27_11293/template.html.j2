  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  text-align: center;
}

#planner, .event-list, .sponsorship-list {
  margin-top: 40px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
