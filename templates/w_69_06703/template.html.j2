    bottom: 0;
    left: 0;
    width: 400px;
    background-color: #cfc;
    padding: 10px;
}

.products,
.product_description {
    text-align: center;
}

button {
    margin-top: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
