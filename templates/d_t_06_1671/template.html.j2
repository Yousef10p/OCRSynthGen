<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 135.1mm; inset-block-start: 0.0mm; inline-size: 74.6mm; block-size: 296.9mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 27.0mm; inset-block-start: 20.7mm; inline-size: 72.3mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 27.3mm; inline-size: 96.6mm; block-size: 29.2mm; font-size: 13.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 58.9mm; inline-size: 97.8mm; block-size: 24.2mm; font-size: 13.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 83.6mm; inline-size: 98.1mm; block-size: 14.4mm; font-size: 13.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 100.4mm; inline-size: 93.7mm; block-size: 29.2mm; font-size: 13.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 132.1mm; inline-size: 96.7mm; block-size: 53.9mm; font-size: 13.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 188.4mm; inline-size: 90.7mm; block-size: 14.4mm; font-size: 13.6pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 62.0mm; inset-block-start: 226.9mm; inline-size: 27.4mm; block-size: 8.9mm; font-size: 12.6pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 234.3mm; inline-size: 86.9mm; block-size: 30.7mm; font-size: 21.7pt">{{ slot_8 }}</p>
</div></body>
</html>
