<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 27.3mm; inset-block-start: 25.1mm; inline-size: 160.6mm; block-size: 14.5mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 77.7mm; inset-block-start: 46.7mm; inline-size: 59.9mm; block-size: 4.6mm; font-size: 12.0pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 51.0mm; inline-size: 6.4mm; block-size: 157.2mm; font-size: 20.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 35.8mm; inset-block-start: 54.9mm; inline-size: 143.7mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 54.5mm; inset-block-start: 62.7mm; inline-size: 106.3mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 74.4mm; inset-block-start: 74.3mm; inline-size: 66.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.9mm; inset-block-start: 82.2mm; inline-size: 163.5mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 98.2mm; inset-block-start: 90.6mm; inline-size: 18.9mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_7 }}</h2>
