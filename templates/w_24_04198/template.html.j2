<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
</li>
</ul>
</div>
<div class="product">
<h1>{{ slot_12 }}</h1>
<div class="image-placeholder ph"></div>
<p>{{ slot_13 }}</p>
</div>
<div class="product">
