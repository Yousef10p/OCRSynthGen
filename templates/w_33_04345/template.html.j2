<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    background-color: #000;
    color: #fff;
    display: grid;
    grid-template-columns: 1fr 3fr;
    grid-gap: 20px;
    padding: 20px;
}

nav ul {
    list-style-type: none;
    display: flex;
    justify-content: space-around;
}

nav a, aside a {
    color: #fff;
    text-decoration: none;
}

nav a:hover, aside a:hover {
    color: #fad84a;
}

main {
    display: flex;
    flex-direction: column;
}

aside {
    margin-right: 20px;
}

aside a {
    display: block;
    margin-bottom: 10px;
}

.products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
}

.products div {
    display: flex;
    flex-direction: column;
}

.product-img {
    height: 200px;
    background-color: #fad84a;
    margin: 10px 0;
}

h2, h3 {
    color: #fad84a;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<main>
<aside>
<ul>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</aside>
<section>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="products">
<div>
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
<div class="product-img ph"></div>
</div>
<div>
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<div class="product-img ph"></div>
</div>
<div>
<h3>{{ slot_14 }}</h3>
<p>{{ slot_15 }}</p>
<div class="product-img ph"></div>
</div>
</div>
</section>
</main>
</body>
</html>