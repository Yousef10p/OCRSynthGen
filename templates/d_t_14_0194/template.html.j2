<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 25.0mm; inset-block-start: 5.0mm; inline-size: 38.3mm; block-size: 17.4mm; font-size: 16.5pt"></div>
<header class="box" style="inset-inline-start: 67.5mm; inset-block-start: 6.1mm; inline-size: 53.6mm; block-size: 16.8mm; font-size: 8.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 157.0mm; inset-block-start: 12.1mm; inline-size: 41.8mm; block-size: 2.6mm; font-size: 8.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 28.9mm; inset-block-start: 60.4mm; inline-size: 154.4mm; block-size: 9.4mm; font-size: 24.0pt">{{ slot_2 }}</p>
<h1 class="box" style="inset-inline-start: 57.4mm; inset-block-start: 78.6mm; inline-size: 97.0mm; block-size: 8.6mm; font-size: 22.0pt">{{ slot_3 }}</h1>
<h1 class="box" style="inset-inline-start: 57.8mm; inset-block-start: 97.5mm; inline-size: 94.4mm; block-size: 8.6mm; font-size: 22.0pt">{{ slot_4 }}</h1>
<p class="box" style="inset-inline-start: 56.4mm; inset-block-start: 125.0mm; inline-size: 98.8mm; block-size: 7.0mm; font-size: 18.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 60.2mm; inset-block-start: 153.3mm; inline-size: 91.1mm; block-size: 6.2mm; font-size: 16.0pt">{{ slot_6 }}</p>
</div></body>
</html>
