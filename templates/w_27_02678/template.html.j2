<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
  color: #000000;
}

#container {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 80%;
  margin: auto;
  padding: 20px;
}

#left, #center, #right {
  width: 30%;
  padding: 15px;
  line-height: 1.4;
}

#left {
  background-color: #ADD8E6;
}

#center {
  background-color: #90EE90;
}

#right {
  background-color: #ffffff;
}

h1, h2 {
  color: #000000;
}

a {
  color: #000080;
  text-decoration: none;
}

.image-placeholder {
  background-color: #D3D3D3;
  height: 150px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="container">
<div id="left">
<h1>{{ slot_0 }}</h1>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div id="center">
<h1>{{ slot_4 }}</h1>
<div class="image-placeholder">{{ slot_5 }}</div>
<p>{{ slot_6 }}</p>
<div class="image-placeholder">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</div>
<div id="right">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
</div>
</body>
</html>