    background-color: #f0f0f0;
    padding: 1em;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 1em;
}

.property {
    width: 30%;
    float: right;
    margin: 1.5%;
    text-align: center;
}

.property-image {
    background-color: #e0e0e0;
