    margin-bottom: 1em;
}

footer {
    clear: both;
    text-align: center;
    padding: 2em;
    background-color: #f0f0f0;
}

footer form {
    margin: 1em 0;
    text-align: right;
}

footer form input,
footer form textarea {
    display: block;
    width: 100%;
    margin: .5em 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
