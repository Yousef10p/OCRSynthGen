<div class="box ph" style="inset-inline-start: 23.8mm; inset-block-start: 151.4mm; inline-size: 156.8mm; block-size: 90.7mm; font-size: 21.4pt"></div>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 244.3mm; inline-size: 155.6mm; block-size: 5.7mm; font-size: 8.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 24.3mm; inset-block-start: 252.4mm; inline-size: 4.8mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_10 }}</footer>
</div></body>
</html>
