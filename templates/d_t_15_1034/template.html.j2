<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 9.3mm; inset-block-start: 1.3mm; inline-size: 59.4mm; block-size: 2.0mm; font-size: 5.8pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 22.8mm; inline-size: 75.1mm; block-size: 7.0mm; font-size: 9.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 105.8mm; inset-block-start: 22.8mm; inline-size: 76.9mm; block-size: 22.6mm; font-size: 10.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 24.3mm; inset-block-start: 33.0mm; inline-size: 14.5mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 37.1mm; inline-size: 75.1mm; block-size: 57.8mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 105.8mm; inset-block-start: 49.2mm; inline-size: 74.1mm; block-size: 34.3mm; font-size: 10.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 105.8mm; inset-block-start: 87.6mm; inline-size: 74.2mm; block-size: 50.0mm; font-size: 10.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 98.3mm; inline-size: 75.1mm; block-size: 50.0mm; font-size: 10.9pt">{{ slot_7 }}</p>
