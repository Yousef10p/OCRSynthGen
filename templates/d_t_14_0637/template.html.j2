<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 80.7mm; inset-block-start: 12.3mm; inline-size: 54.7mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 22.7mm; inset-block-start: 17.8mm; inline-size: 74.1mm; block-size: 13.3mm; font-size: 12.6pt"></div>
<p class="box" style="inset-inline-start: 144.0mm; inset-block-start: 19.7mm; inline-size: 37.5mm; block-size: 12.1mm; font-size: 17.1pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 64.7mm; inset-block-start: 58.1mm; inline-size: 86.7mm; block-size: 15.0mm; font-size: 21.3pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 84.5mm; inset-block-start: 82.5mm; inline-size: 47.0mm; block-size: 23.2mm; font-size: 21.9pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 54.6mm; inset-block-start: 115.1mm; inline-size: 106.8mm; block-size: 6.9mm; font-size: 19.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 50.2mm; inset-block-start: 145.2mm; inline-size: 114.4mm; block-size: 21.9mm; font-size: 20.7pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 93.3mm; inset-block-start: 260.2mm; inline-size: 23.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_6 }}</footer><p class="box" style="inset-inline-start: 162.0mm; inset-block-start: 267.9mm; inline-size: 28.5mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 157.2mm; inset-block-start: 275.6mm; inline-size: 33.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_8 }}</p>
</div></body>
</html>
