<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<section id="hero">
<div class="image-placeholder">{{ slot_5 }}</div>
</section>
<main>
<section id="destinations">
<div class="card">
<h2>{{ slot_6 }}</h2>
<div class="image-placeholder">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
<a class="button">{{ slot_9 }}</a>
</div>
<div class="card">
<h2>{{ slot_10 }}</h2>
<div class="image-placeholder">{{ slot_11 }}</div>
<p>{{ slot_12 }}</p>
<a class="button">{{ slot_13 }}</a>
</div>

</section>
</main>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>