<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    color: blue;
    font-family: var(--font-body);
    font-size: 15px;
}

header {
    background: black;
    color: blue;
    padding: 15px 0;
    position: sticky;
    top: 0;
}

header h1 {
    font-size: 30px;
    text-align: center;
}

header nav ul {
    display: flex;
    justify-content: space-around;
}

header nav ul li {
    list-style-type: none;
}

header nav ul li a {
    color: blue;
    text-decoration: none;
}

#hero .image-placeholder {
    height: 400px;
    margin: 20px;
    background: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: black;
}

main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 15px;
}

main .card {
    border: 1px solid black;
    padding: 20px;
}

main .card h2 {
    font-size: 25px;
    margin-bottom: 15px;
}

main .card .image-placeholder {
    height: 200px;
    margin: 20px 0;
    background: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: black;
}

main .card p {
    margin: 10px 0;
}

main .card .button {
    display: block;
    text-align: center;
    background: red;
    color: white;
    padding: 10px 20px;
    text-decoration: none;
}

footer {
    background: black;
    color: blue;
    padding: 10px 0;
    text-align: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
