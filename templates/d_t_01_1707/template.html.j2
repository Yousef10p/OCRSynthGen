<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 173.2mm; inset-block-start: 5.8mm; inline-size: 123.6mm; block-size: 170.6mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 55.7mm; inset-block-start: 47.2mm; inline-size: 81.4mm; block-size: 13.6mm; font-size: 12.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 55.7mm; inset-block-start: 67.8mm; inline-size: 80.5mm; block-size: 29.0mm; font-size: 13.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 55.7mm; inset-block-start: 103.9mm; inline-size: 83.2mm; block-size: 49.7mm; font-size: 14.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 173.2mm; inset-block-start: 182.4mm; inline-size: 52.7mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 180.1mm; inset-block-start: 186.5mm; inline-size: 46.5mm; block-size: 6.6mm; font-size: 9.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 134.3mm; inset-block-start: 188.4mm; inline-size: 40.0mm; block-size: 2.8mm; font-size: 8.1pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 10.4mm; inset-block-start: 188.7mm; inline-size: 4.0mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_6 }}</footer><p class="box" style="inset-inline-start: 173.2mm; inset-block-start: 194.7mm; inline-size: 52.9mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_7 }}</p>
</div></body>
</html>
