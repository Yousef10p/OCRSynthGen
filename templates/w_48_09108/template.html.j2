<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}
.hero {
    width: 100%;
    text-align: center;
}
.logo {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
}
.menu {
    background-color: #f8f8f8;
    padding: 10px 0;
    text-align: center;
}
.menu ul {
    list-style-type: none;
    padding: 0;
}
.menu li {
    display: inline;
    padding: 0 10px;
}
.menu a {
    color: black;
    text-decoration: none;
}
.main-content {
    margin: 20px auto;
    width: 80%;
}
.product, .trend, .tutorial {
    height: 200px;
    margin: 20px 0;
    background-color: #f1f1f1;
    color: transparent;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="logo ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<nav class="menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div class="main-content">
<h2>{{ slot_4 }}</h2>
<div class="product">{{ slot_5 }}</div>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<h2>{{ slot_8 }}</h2>
<div class="trend">{{ slot_9 }}</div>
<div class="trend">{{ slot_10 }}</div>
<div class="trend">{{ slot_11 }}</div>
<h2>{{ slot_12 }}</h2>
<div class="tutorial">{{ slot_13 }}</div>
<div class="tutorial">{{ slot_14 }}</div>
</div>
</body>
</html>