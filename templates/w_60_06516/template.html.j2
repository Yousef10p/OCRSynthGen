<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}


nav {
  background-color: #74b9ff;
  position: fixed;
  width: 100%;
  height: 50px;
}

nav ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
}

nav li {
  display: inline;
}

nav a {
  color: white;
  text-decoration: none;
  padding: 15px;
}


header {
  background-color: #ffeaa7;
  text-align: center;
  padding: 100px 0;
  margin-top: 70px;
}


section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  padding: 20px;
}

.image {
  background-color: #2d3436; 
  height: 200px;
}

.image:nth-child(odd) {
  background-color: #27ae60; 
}

.content {
  padding: 10px;
}

.content h2 {
  color: #2d3436; 
  font-size: 1.5em;
}


#contact {
  background-color: #ff7675;
}

#contact form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 10px;
}

#contact input,
#contact textarea {
  padding: 5px;
}


#social {
  display: flex;
  gap: 10px;
  padding: 10px;
}

#social img {
  width: 50px;
  height: 50px;
}


footer {
  background-color: #1dd1a1;
  text-align: center;
  padding: 20px;
}


@media (max-width: 600px) {
  
  section {
    grid-template-columns: 1fr;
  }
  
  
  .content {
    padding: 0;
    text-align: center;
  }
  
  
  .image {
    height: 100px;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
