    height: 50px;
    padding-top: 20px;
}

nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 50px;
}

nav ul li a {
    text-decoration: none;
    color: #333;
}

