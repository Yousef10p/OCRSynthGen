<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 48.0mm; inset-block-start: 69.0mm; inline-size: 113.9mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 95.4mm; inline-size: 74.7mm; block-size: 56.4mm; font-size: 12.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 108.3mm; inset-block-start: 95.4mm; inline-size: 76.3mm; block-size: 60.7mm; font-size: 12.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 154.5mm; inline-size: 76.4mm; block-size: 47.6mm; font-size: 12.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 108.3mm; inset-block-start: 158.8mm; inline-size: 75.4mm; block-size: 60.7mm; font-size: 12.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 204.8mm; inline-size: 76.2mm; block-size: 52.0mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 108.3mm; inset-block-start: 222.2mm; inline-size: 76.4mm; block-size: 34.5mm; font-size: 12.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 103.7mm; inset-block-start: 272.4mm; inline-size: 2.6mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 71.8mm; inset-block-start: 280.1mm; inline-size: 66.3mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_8 }}</footer>
</div></body>
</html>
