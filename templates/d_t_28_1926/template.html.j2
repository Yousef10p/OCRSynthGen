<ul class="box" style="inset-inline-start: 10.0mm; inset-block-start: 51.8mm; inline-size: 192.0mm; block-size: 6.1mm; font-size: 13.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 10.0mm; inset-block-start: 59.5mm; inline-size: 189.7mm; block-size: 6.1mm; font-size: 13.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 10.0mm; inset-block-start: 67.3mm; inline-size: 190.6mm; block-size: 18.3mm; font-size: 13.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 10.0mm; inset-block-start: 87.2mm; inline-size: 189.9mm; block-size: 12.2mm; font-size: 13.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 10.0mm; inset-block-start: 101.0mm; inline-size: 102.1mm; block-size: 3.1mm; font-size: 13.0pt"><li>{{ slot_7 }}</li></ul>
