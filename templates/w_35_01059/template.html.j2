}

.slide {
  position: absolute;
  top: 0;
  right: 0;
  opacity: 0;
  transition: opacity .5s;
}

.slide:nth-child(1) {
  opacity: 1;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
