<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 88.1mm; inset-block-start: 11.5mm; inline-size: 105.8mm; block-size: 56.9mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 25.8mm; inset-block-start: 52.4mm; inline-size: 44.0mm; block-size: 11.7mm; font-size: 11.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 82.1mm; inset-block-start: 51.7mm; inline-size: 4.0mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 20.9mm; inset-block-start: 75.5mm; inline-size: 111.3mm; block-size: 60.9mm; font-size: 14.4pt"></div>
<div class="box ph" style="inset-inline-start: 100.1mm; inset-block-start: 138.3mm; inline-size: 90.3mm; block-size: 60.6mm; font-size: 15.6pt"></div>
<header class="box" style="inset-inline-start: 205.4mm; inset-block-start: 138.3mm; inline-size: 4.8mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_2 }}</header><header class="box" style="inset-inline-start: 207.3mm; inset-block-start: 152.6mm; inline-size: 2.9mm; block-size: 27.4mm; font-size: 40.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 49.9mm; inset-block-start: 181.9mm; inline-size: 29.7mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 88.0mm; inset-block-start: 181.5mm; inline-size: 4.0mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_5 }}</p>
</div></body>
</html>
