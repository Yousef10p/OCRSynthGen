<p class="box" style="inset-inline-start: 102.6mm; inset-block-start: 92.2mm; inline-size: 87.9mm; block-size: 67.7mm; font-size: 19.2pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 5.3mm; inset-block-start: 193.5mm; inline-size: 60.7mm; block-size: 69.6mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 74.4mm; inset-block-start: 197.5mm; inline-size: 87.4mm; block-size: 7.5mm; font-size: 10.7pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 74.4mm; inset-block-start: 211.5mm; inline-size: 56.7mm; block-size: 11.3mm; font-size: 16.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 139.3mm; inset-block-start: 212.8mm; inline-size: 61.5mm; block-size: 48.2mm; font-size: 17.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 74.4mm; inset-block-start: 225.4mm; inline-size: 60.6mm; block-size: 35.5mm; font-size: 16.8pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 167.7mm; inset-block-start: 266.0mm; inline-size: 35.5mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
