<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	font-family: var(--font-body);
}
header {
	position: fixed;
	top: 0; 
	width: 100%;
	padding: 10px;
	background: pink;
	box-shadow: 0 2px 2px rgba(0, 0, 0, 0.5);
}
h1 {
	font-size: 2em;
	text-align: center;
	color: blue;
}
nav ul {
	list-style: none;
	display: flex;
	justify-content: space-around;
	padding: 10px 0;
}
nav ul li a {
	text-decoration: none;
	color: red;
	font-weight: bold;
	transition: all 0.3s ease;
}
nav ul li a:hover {
	color: yellow;
}
#products, #services, #about, #contact {
	padding-top: 100px;
	height: 100vh;
}
.product, .service {
	width: 500px;
	height: 500px;
	background: green;
	margin: auto;
	margin-bottom: 50px;
	transition: all 0.5s ease;
}
.product:hover, .service:hover {
	transform: scale(1.1);
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<section id="products">
<h2>{{ slot_5 }}</h2>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
</section>
<section id="services">
