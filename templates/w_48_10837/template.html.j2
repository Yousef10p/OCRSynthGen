<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}

body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
}


#logo {
  width: 100px;
  height: 100px;
  background-color: darkblue;
  margin: 20px;
}


nav ul {
  list-style: none;
  display: flex;
  gap: 10px;
}


#programs, #services {
  width: 100%;
  max-width: 800px;
  margin: 20px 0;
}

.program-image, .services-image {
  width: 100%;
  height: 200px;
  background-color: lightgray;
  margin: 20px 0;
}


#donate {
  width: 100%;
  max-width: 200px;
  height: 50px;
  background-color: green;
  color: white;
  text-align: center;
  line-height: 50px;
  margin: 30px 0;
}


footer {
  width: 100%;
  max-width: 800px;
  display: flex;
  justify-content: space-between;
  margin-top: 30px;
}

footer a {
  color: darkblue;
  margin: 0 10px;
}


@media (max-width: 768px) {
  #programs, #services {
    width: 100%;
    max-width: 100%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
