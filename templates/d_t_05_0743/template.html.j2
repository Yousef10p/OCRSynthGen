<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 75.2mm; inset-block-start: 66.5mm; inline-size: 48.3mm; block-size: 86.0mm; font-size: 20.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 142.5mm; inset-block-start: 66.2mm; inline-size: 62.1mm; block-size: 104.6mm; font-size: 19.8pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 58.2mm; inset-block-start: 177.3mm; inline-size: 145.1mm; block-size: 70.4mm; font-size: 11.7pt"></div>
<footer class="box" style="inset-inline-start: 183.2mm; inset-block-start: 258.7mm; inline-size: 10.5mm; block-size: 8.8mm; font-size: 6.2pt">{{ slot_2 }}</footer><footer class="box" style="inset-inline-start: 198.8mm; inset-block-start: 259.2mm; inline-size: 4.7mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_3 }}</footer><footer class="box" style="inset-inline-start: 175.1mm; inset-block-start: 261.5mm; inline-size: 2.7mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_4 }}</footer>
</div></body>
</html>
