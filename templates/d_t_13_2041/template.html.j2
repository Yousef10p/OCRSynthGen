<ul class="box" style="inset-inline-start: 37.7mm; inset-block-start: 51.6mm; inline-size: 148.5mm; block-size: 12.8mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 37.7mm; inset-block-start: 64.4mm; inline-size: 148.4mm; block-size: 34.3mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 103.0mm; inline-size: 161.2mm; block-size: 30.0mm; font-size: 10.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 141.6mm; inline-size: 27.2mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_5 }}</h2>
