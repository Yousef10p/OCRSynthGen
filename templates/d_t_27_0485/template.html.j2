<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 167.5mm; inset-block-start: 15.5mm; inline-size: 32.3mm; block-size: 12.8mm; font-size: 18.1pt"></div>
<p class="box" style="inset-inline-start: 16.1mm; inset-block-start: 20.6mm; inline-size: 79.9mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 175.8mm; inset-block-start: 39.6mm; inline-size: 23.1mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 175.5mm; inset-block-start: 47.0mm; inline-size: 23.7mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 175.5mm; inset-block-start: 245.5mm; inline-size: 23.5mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 15.3mm; inset-block-start: 260.1mm; inline-size: 42.0mm; block-size: 14.0mm; font-size: 13.2pt"></div>
<div class="box ph" style="inset-inline-start: 152.3mm; inset-block-start: 260.8mm; inline-size: 50.8mm; block-size: 13.5mm; font-size: 19.2pt"></div>
</div></body>
</html>
