<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 145.3mm; inset-block-start: 19.1mm; inline-size: 61.9mm; block-size: 12.6mm; font-size: 9.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 35.1mm; inline-size: 88.9mm; block-size: 83.8mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 118.6mm; inset-block-start: 34.9mm; inline-size: 85.7mm; block-size: 9.7mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 118.4mm; inset-block-start: 44.9mm; inline-size: 88.9mm; block-size: 74.1mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 23.6mm; inset-block-start: 119.1mm; inline-size: 88.4mm; block-size: 137.8mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 117.9mm; inset-block-start: 119.3mm; inline-size: 89.1mm; block-size: 118.9mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 118.1mm; inset-block-start: 238.5mm; inline-size: 88.2mm; block-size: 23.9mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 257.4mm; inline-size: 82.2mm; block-size: 4.7mm; font-size: 11.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 110.9mm; inset-block-start: 264.9mm; inline-size: 6.8mm; block-size: 3.9mm; font-size: 9.9pt">{{ slot_8 }}</footer>
</div></body>
</html>
