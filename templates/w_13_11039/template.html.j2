<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<div class="row">
<div class="col">
<div class="placeholder ph"></div>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<a>{{ slot_8 }}</a>
</div>
<div class="col">
<div class="placeholder ph"></div>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<a>{{ slot_11 }}</a>
</div>
<div class="col">
<div class="placeholder ph"></div>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<a>{{ slot_14 }}</a>
</div>
</div>
</header></body>
</html>