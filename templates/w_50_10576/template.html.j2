<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  color: #444;
}


nav {
  background-color: #2C3E50;
  color: #FFF;
  padding: 10px;
}
nav ul {
  list-style-type: none;
  padding: 0;
}
nav ul li {
  display: inline;
  margin-left: 10px;
}
nav ul li a {
  color: #FFF;
  text-decoration: none;
}


#hero {
  background-color: #16A085;
  color: #FFF;
  display: flex;
  justify-content: space-around;
  padding: 20px;
}
.hero-content, .hero-image {
  width: 50%;
}
.hero-image {
  background-color: #E74C3C;
}


#properties {
  display: flex;
  flex-wrap: wrap;
  padding: 20px;
}
.property {
  background-color: #F1C40F;
  margin: 10px;
  padding: 10px;
  width: calc(33.33% - 20px);
}
.property-image {
  background-color: #E74C3C;
  height: 200px;
  margin-bottom: 10px;
}


footer {
  background-color: #E74C3C;
  color: #FFF;
  display: flex;
  justify-content: space-around;
  padding: 20px;
}
footer form {
  width: 30%;
}
footer form input[type="text"], footer form textarea {
  display: block;
  margin-bottom: 10px;
  width: 100%;
}
footer form button {
  background-color: #FFF;
  border: 0;
  cursor: pointer;
  padding: 10px;
}
#social-media a {
  color: #FFF;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
