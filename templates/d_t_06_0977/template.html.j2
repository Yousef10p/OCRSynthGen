<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 12.5mm; inline-size: 47.2mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 85.3mm; inset-block-start: 19.7mm; inline-size: 45.3mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 28.4mm; inline-size: 30.3mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 32.3mm; inline-size: 188.6mm; block-size: 31.2mm; font-size: 11.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 64.1mm; inline-size: 188.3mm; block-size: 19.3mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 84.0mm; inline-size: 185.2mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 37.0mm; inset-block-start: 95.5mm; inline-size: 141.7mm; block-size: 93.4mm; font-size: 9.5pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 191.2mm; inline-size: 186.9mm; block-size: 19.3mm; font-size: 10.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 211.0mm; inline-size: 188.7mm; block-size: 27.2mm; font-size: 11.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 238.8mm; inline-size: 188.8mm; block-size: 27.2mm; font-size: 11.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 190.2mm; inset-block-start: 272.8mm; inline-size: 12.1mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_9 }}</footer>
</div></body>
</html>
