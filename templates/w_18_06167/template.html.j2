    background-color: #333;
    color: white;
    width: 100%;
    height: 200px;
    text-align: center;
    margin-bottom: 20px;
}

nav {
    position: absolute;
    top: 0;
    left: 0;
    margin: 20px;
}

nav ul {
    list-style-type: none;
    display: flex;
    justify-content: space-between;
    width: 200px;
}

nav a {
    text-decoration: none;
    color: white;
}

.article-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
    margin: 20px;
}

.article {
    border: 1px solid #333;
    padding: 20px;
}

#contact {
    margin-top: 20px;
    padding: 20px;
}

footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    text-align: center;
    background-color: #333;
    color: white;
    height: 50px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
