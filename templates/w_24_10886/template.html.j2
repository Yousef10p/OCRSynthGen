}
nav li a {
	text-decoration: none;
	color: #fff;
}
nav li:hover {
	opacity: 1;
}
nav li ul {
	display: none;
}
nav li:hover ul {
	display: block;
}
.column {
	float: right;
	width: 33.33%;
	padding: 10px;
	box-sizing: border-box;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
