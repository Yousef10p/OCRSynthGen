<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 143.5mm; inset-block-start: 34.0mm; inline-size: 47.4mm; block-size: 195.9mm; font-size: 15.0pt"></div>
<h2 class="box" style="inset-inline-start: 87.8mm; inset-block-start: 67.7mm; inline-size: 49.7mm; block-size: 65.9mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 104.5mm; inset-block-start: 133.1mm; inline-size: 34.5mm; block-size: 13.9mm; font-size: 13.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 94.1mm; inset-block-start: 148.6mm; inline-size: 44.9mm; block-size: 13.9mm; font-size: 19.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 98.6mm; inset-block-start: 164.8mm; inline-size: 38.9mm; block-size: 13.9mm; font-size: 19.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 79.4mm; inset-block-start: 181.1mm; inline-size: 58.1mm; block-size: 13.9mm; font-size: 19.6pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 141.7mm; inset-block-start: 251.0mm; inline-size: 35.5mm; block-size: 16.9mm; font-size: 15.9pt"></div>
</div></body>
</html>
