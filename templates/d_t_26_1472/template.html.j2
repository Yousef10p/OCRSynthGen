<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 58.7mm; inline-size: 68.4mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 53.3mm; inset-block-start: 64.8mm; inline-size: 104.0mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 70.7mm; inline-size: 84.3mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 53.3mm; inset-block-start: 76.8mm; inline-size: 88.1mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_7 }}</p>
