	display: inline;
	margin: 0 10px;
}

nav ul li a {
	color: #fff;
	text-decoration: none;
}

.hero {
	background-color: #f4f4f4;
	padding: 50px 0;
	text-align: center;
}

.cta {
	display: inline-block;
