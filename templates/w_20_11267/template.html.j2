<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<div id="left-column">
<h1>{{ slot_3 }}</h1>
<p id="movie1">{{ slot_4 }}</p>
<p id="movie2">{{ slot_5 }}</p>
<h2>{{ slot_6 }}</h2>
<p id="tv1">{{ slot_7 }}</p>
<p id="tv2">{{ slot_8 }}</p>
<h1>{{ slot_9 }}</h1>
<p id="album1">{{ slot_10 }}</p>
<p id="album2">{{ slot_11 }}</p>
</div>
<div id="center-column">
<p id="movie-image">{{ slot_12 }}</p>
<p id="tv-image">{{ slot_13 }}</p>
<p id="album-image">{{ slot_14 }}</p>
</div>
</body>
</html>