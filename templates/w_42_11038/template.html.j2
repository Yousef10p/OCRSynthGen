</ul>
</nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<div class="fake-button">{{ slot_4 }}</div>
<div class="fake-button">{{ slot_5 }}</div>
</header>
<section>
<div>
<h1>{{ slot_6 }}</h1>
<div class="fake-img">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</div>
<div>
<h1>{{ slot_9 }}</h1>
<div class="fake-img">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
</div>
<div>
