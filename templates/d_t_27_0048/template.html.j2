<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 68.3mm; inset-block-start: 58.2mm; inline-size: 106.7mm; block-size: 7.3mm; font-size: 10.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 66.2mm; inset-block-start: 72.3mm; inline-size: 79.3mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 31.4mm; inset-block-start: 79.1mm; inline-size: 148.5mm; block-size: 100.2mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 179.7mm; inline-size: 57.5mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 31.6mm; inset-block-start: 189.6mm; inline-size: 99.8mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 56.3mm; inset-block-start: 198.6mm; inline-size: 108.3mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 204.5mm; inline-size: 121.0mm; block-size: 7.3mm; font-size: 10.3pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 214.4mm; inline-size: 70.1mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 220.2mm; inline-size: 86.8mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 226.1mm; inline-size: 69.1mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 56.3mm; inset-block-start: 231.9mm; inline-size: 114.2mm; block-size: 7.3mm; font-size: 10.3pt"><li>{{ slot_9 }}</li></ul>
<footer class="box" style="inset-inline-start: 31.6mm; inset-block-start: 248.2mm; inline-size: 110.2mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
