    padding: 10px 20px;
    background-color: #333;
    color: #fff;
}

.logo {
    background-color: #444;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin-left: 10px;
}

.hero {
    text-align: center;
    padding: 50px 0;
    background-color: #ddd;
}

.content {
    display: flex;
    justify-content: space-around;
    padding: 50px 0;
}

.content div {
    text-align: center;
    background-color: #ddd;
}

footer {
    text-align: center;
    padding: 20px;
    background-color: #333;
    color: #fff;
}

footer ul {
    list-style: none;
}

footer ul li {
    display: inline;
    margin-left: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
