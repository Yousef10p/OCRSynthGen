<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 22.6mm; inset-block-start: 27.9mm; inline-size: 170.9mm; block-size: 82.4mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 110.9mm; inline-size: 52.7mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 120.1mm; inline-size: 95.6mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 126.1mm; inline-size: 134.8mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_2 }}</li></ul>
<div class="box ph" style="inset-inline-start: 22.6mm; inset-block-start: 134.4mm; inline-size: 170.5mm; block-size: 117.3mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 252.5mm; inline-size: 41.2mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 154.7mm; inset-block-start: 266.3mm; inline-size: 38.3mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_4 }}</footer>
</div></body>
</html>
