</ul>
</nav>
<main>
<section id="carousel">
<div class="slide"><article><h1>{{ slot_4 }}</h1><p>{{ slot_5 }}</p></article></div>
<div class="slide"><article><h1>{{ slot_6 }}</h1><p>{{ slot_7 }}</p></article></div>
<div class="slide"><article><h1>{{ slot_8 }}</h1><p>{{ slot_9 }}</p></article></div>

</section>
<section id="articles">
