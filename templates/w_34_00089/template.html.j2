.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 10px;
}

header {
    grid-column: 1 / 3;
}

section {
    border: 1px solid gray;
    border-radius: 5px;
    padding: 5px;
}

h1, h2 {
    text-align: center;
}

nav {
    display: flex;
    justify-content: space-around;
    margin-bottom: 10px;
}

.product, .testimonial, .blog-post, .case-study {
    background-color: gray;
    color: white;
    margin-bottom: 10px;
    text-align: center;
    padding: 10px 0;
    border-radius: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
