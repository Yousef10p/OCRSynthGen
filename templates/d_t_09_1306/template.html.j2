<p class="box" style="inset-inline-start: 33.1mm; inset-block-start: 156.5mm; inline-size: 110.5mm; block-size: 4.0mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 81.7mm; inset-block-start: 161.7mm; inline-size: 101.1mm; block-size: 14.8mm; font-size: 12.0pt"></div>
