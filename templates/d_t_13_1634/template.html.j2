<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 20.0mm; inline-size: 106.3mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 28.4mm; inline-size: 143.1mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 37.1mm; inline-size: 82.3mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 43.7mm; inline-size: 155.9mm; block-size: 26.6mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 74.7mm; inline-size: 155.8mm; block-size: 8.8mm; font-size: 11.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 30.8mm; inset-block-start: 89.2mm; inline-size: 140.9mm; block-size: 125.7mm; font-size: 11.0pt"></div>
<footer class="box" style="inset-inline-start: 30.0mm; inset-block-start: 282.7mm; inline-size: 27.0mm; block-size: 7.2mm; font-size: 9.0pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 170.4mm; inset-block-start: 282.7mm; inline-size: 15.2mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
