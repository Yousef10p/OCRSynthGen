}

header, footer {
    background-color: #333;
    color: white;
    padding: 10px;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 10px;
}

main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 10px;
}

#featured {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
