    margin: 10px 0;
}

.property {
    border: 1px solid #dedede;
    padding: 10px;
}

.img {
    height: 200px;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
