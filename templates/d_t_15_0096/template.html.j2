<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 12.9mm; inset-block-start: 12.3mm; inline-size: 189.9mm; block-size: 15.9mm; font-size: 11.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 12.9mm; inset-block-start: 31.9mm; inline-size: 190.0mm; block-size: 24.3mm; font-size: 11.5pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 17.7mm; inset-block-start: 56.9mm; inline-size: 181.1mm; block-size: 88.7mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 66.6mm; inset-block-start: 146.4mm; inline-size: 82.6mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 12.9mm; inset-block-start: 154.6mm; inline-size: 190.0mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 12.9mm; inset-block-start: 170.7mm; inline-size: 190.0mm; block-size: 15.9mm; font-size: 11.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 12.9mm; inset-block-start: 190.7mm; inline-size: 190.0mm; block-size: 23.8mm; font-size: 11.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 12.9mm; inset-block-start: 218.8mm; inline-size: 189.8mm; block-size: 7.9mm; font-size: 11.2pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 12.9mm; inset-block-start: 233.0mm; inline-size: 91.1mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 12.9mm; inset-block-start: 239.0mm; inline-size: 138.8mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 104.4mm; inset-block-start: 269.5mm; inline-size: 6.0mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
