<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}

.container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.sidebar {
  width: 20%;
  padding: 20px;
  background-color: #f1f1f1;
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
}

.sidebar h2 {
  color: #333;
}

.sidebar ul {
  list-style-type: none;
  padding: 0;
}

.sidebar ul li a {
  color: #333;
  text-decoration: none;
  margin-bottom: 10px;
  display: block;
}

.product-grid {
  width: 80%;
  margin-right: 20%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.product {
  width: 30%;
  margin: 1.66%;
  padding: 20px;
  text-align: center;
  background-color: #f1f1f1;
  color: #333;
}

.product h2 {
  color: #333;
}

.product-image {
  background-color: #f1f1f1;
  height: 200px;
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="sidebar">
<h2>{{ slot_0 }}</h2>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
<h2>{{ slot_4 }}</h2>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</div>
<div class="product-grid">
<div class="product">
<h2>{{ slot_6 }}</h2>
<div class="product-image">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</div>
<div class="product">
<h2>{{ slot_9 }}</h2>
<div class="product-image">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
</div>
<div class="product">
<h2>{{ slot_12 }}</h2>
<div class="product-image">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
</div>

</div>
</div></body>
</html>