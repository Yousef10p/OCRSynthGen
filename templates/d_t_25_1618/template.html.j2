<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 31.7mm; inline-size: 152.6mm; block-size: 23.0mm; font-size: 16.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 58.5mm; inline-size: 152.6mm; block-size: 34.2mm; font-size: 16.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 96.5mm; inline-size: 152.6mm; block-size: 28.5mm; font-size: 16.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 128.9mm; inline-size: 152.6mm; block-size: 17.3mm; font-size: 16.3pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 92.3mm; inset-block-start: 150.0mm; inline-size: 25.3mm; block-size: 6.1mm; font-size: 17.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 85.7mm; inset-block-start: 159.9mm; inline-size: 38.5mm; block-size: 6.1mm; font-size: 17.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 169.8mm; inline-size: 152.6mm; block-size: 39.9mm; font-size: 16.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 213.5mm; inline-size: 152.6mm; block-size: 34.2mm; font-size: 16.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 41.4mm; inset-block-start: 251.6mm; inline-size: 20.1mm; block-size: 5.6mm; font-size: 15.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 268.2mm; inline-size: 103.2mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
