<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.2mm; inset-block-start: 17.5mm; inline-size: 19.0mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 154.2mm; inset-block-start: 17.5mm; inline-size: 35.6mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 24.8mm; inset-block-start: 30.0mm; inline-size: 145.3mm; block-size: 21.0mm; font-size: 19.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 62.3mm; inline-size: 145.4mm; block-size: 29.7mm; font-size: 21.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.7mm; inset-block-start: 103.4mm; inline-size: 145.9mm; block-size: 45.4mm; font-size: 21.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 160.4mm; inline-size: 145.9mm; block-size: 21.3mm; font-size: 20.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 37.6mm; inset-block-start: 193.0mm; inline-size: 107.3mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 209.2mm; inline-size: 146.1mm; block-size: 47.0mm; font-size: 22.2pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 39.2mm; inset-block-start: 267.4mm; inline-size: 134.7mm; block-size: 5.2mm; font-size: 14.6pt">{{ slot_8 }}</p>
</div></body>
</html>
