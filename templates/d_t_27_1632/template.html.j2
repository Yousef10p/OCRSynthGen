<h2 class="box" style="inset-inline-start: 10.0mm; inset-block-start: 97.3mm; inline-size: 71.8mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 104.5mm; inline-size: 197.0mm; block-size: 12.8mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 121.3mm; inline-size: 196.2mm; block-size: 9.6mm; font-size: 13.0pt">{{ slot_6 }}</p>
