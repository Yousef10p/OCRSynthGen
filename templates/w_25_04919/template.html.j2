  font-weight: bold;
  color: #5b784f;
}

header {
  position: relative;
}

nav {
  position: absolute;
  top: 0;
  left: 0;
}

nav ul {
  list-style: none;
}

nav ul li {
  display: inline;
  margin-left: 1em;
}

#slideshow {
  background-color: #444;
  color: #f0ead2;
  padding: 1em;
  text-align: center;
}

.image {
  display: none;
}

#main-content {
