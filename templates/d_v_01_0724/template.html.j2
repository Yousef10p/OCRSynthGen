<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 103.1mm; inset-block-start: 16.0mm; inline-size: 86.3mm; block-size: 64.9mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 20.1mm; inline-size: 88.8mm; block-size: 35.7mm; font-size: 12.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 60.7mm; inline-size: 88.9mm; block-size: 58.3mm; font-size: 12.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 83.5mm; inline-size: 74.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 93.6mm; inline-size: 89.6mm; block-size: 53.8mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 123.9mm; inline-size: 87.3mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 146.0mm; inline-size: 60.4mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 151.1mm; inline-size: 89.3mm; block-size: 35.7mm; font-size: 12.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 152.3mm; inline-size: 88.9mm; block-size: 53.8mm; font-size: 12.7pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 13.8mm; inset-block-start: 190.7mm; inline-size: 86.2mm; block-size: 57.4mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 210.9mm; inline-size: 88.4mm; block-size: 35.7mm; font-size: 12.7pt">{{ slot_8 }}</p>
