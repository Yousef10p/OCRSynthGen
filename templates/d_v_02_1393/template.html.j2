<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 28.9mm; inline-size: 159.5mm; block-size: 34.6mm; font-size: 11.4pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 75.4mm; inline-size: 144.3mm; block-size: 11.4mm; font-size: 11.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 98.7mm; inline-size: 159.9mm; block-size: 73.5mm; font-size: 11.4pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 25.1mm; inset-block-start: 186.3mm; inline-size: 83.9mm; block-size: 3.7mm; font-size: 11.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 196.3mm; inline-size: 159.8mm; block-size: 34.7mm; font-size: 11.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 242.9mm; inline-size: 155.4mm; block-size: 26.7mm; font-size: 11.4pt">{{ slot_5 }}</p>
</div></body>
</html>
