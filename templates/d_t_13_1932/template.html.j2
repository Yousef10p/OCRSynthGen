<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 16.4mm; inset-block-start: 36.0mm; inline-size: 189.0mm; block-size: 18.6mm; font-size: 26.3pt"></div>
<h2 class="box" style="inset-inline-start: 19.2mm; inset-block-start: 58.6mm; inline-size: 172.7mm; block-size: 9.5mm; font-size: 13.4pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 16.4mm; inset-block-start: 69.5mm; inline-size: 176.1mm; block-size: 26.9mm; font-size: 15.2pt"></div>
<h2 class="box" style="inset-inline-start: 19.2mm; inset-block-start: 102.2mm; inline-size: 95.8mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 16.9mm; inset-block-start: 110.9mm; inline-size: 173.9mm; block-size: 24.6mm; font-size: 17.4pt"></div>
<h2 class="box" style="inset-inline-start: 19.2mm; inset-block-start: 140.8mm; inline-size: 45.1mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 149.8mm; inline-size: 172.8mm; block-size: 24.2mm; font-size: 11.4pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 19.2mm; inset-block-start: 180.5mm; inline-size: 53.7mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 189.6mm; inline-size: 172.8mm; block-size: 16.1mm; font-size: 11.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 207.9mm; inline-size: 172.8mm; block-size: 12.1mm; font-size: 11.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 222.2mm; inline-size: 167.8mm; block-size: 12.1mm; font-size: 11.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 235.1mm; inline-size: 167.8mm; block-size: 28.4mm; font-size: 11.5pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 19.2mm; inset-block-start: 274.0mm; inline-size: 15.2mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
