<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 91.9mm; inset-block-start: 65.1mm; inline-size: 81.5mm; block-size: 15.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 42.6mm; inset-block-start: 95.0mm; inline-size: 76.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 36.3mm; inset-block-start: 105.2mm; inline-size: 137.0mm; block-size: 14.4mm; font-size: 12.0pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 125.6mm; inline-size: 137.0mm; block-size: 14.4mm; font-size: 12.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 36.3mm; inset-block-start: 146.0mm; inline-size: 137.0mm; block-size: 14.4mm; font-size: 12.0pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 166.4mm; inline-size: 137.3mm; block-size: 14.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 36.3mm; inset-block-start: 197.1mm; inline-size: 78.8mm; block-size: 5.5mm; font-size: 17.2pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 219.8mm; inline-size: 137.1mm; block-size: 34.8mm; font-size: 12.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 103.9mm; inset-block-start: 260.9mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
