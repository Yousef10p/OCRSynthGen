.ph { background: #d0d0d0; }

body {
    background-color: lightgray;
    font-family: var(--font-body);
}

#dashboard, #settings {
    float: right;
    width: 45%;
    margin: 1%;
    padding: 20px;
    background-color: white;
    border: 2px solid darkgray;
    border-radius: 10px;
}

form {
    display: grid;
    grid-template-columns: 1fr 4fr;
}

input {
    margin: 10px 0;
}

canvas {
    background-color: lightgray;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
