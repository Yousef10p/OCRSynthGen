}

nav ul li {
    display: inline-block;
    position: relative;
}

nav ul li:hover ul {
    display: block;
}

nav ul li ul {
    display: none;
    position: absolute;
    width: 200px;
}

nav ul li ul li {
    display: block;
    background-color: #333;
    color: #fff;
    padding: 10px;
    border: 1px solid #000;
}

nav ul li ul li a {
    color: #fff;
