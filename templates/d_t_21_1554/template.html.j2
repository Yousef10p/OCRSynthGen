<ul class="box" style="inset-inline-start: 28.6mm; inset-block-start: 90.4mm; inline-size: 90.8mm; block-size: 8.3mm; font-size: 11.8pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 28.6mm; inset-block-start: 100.7mm; inline-size: 90.8mm; block-size: 8.3mm; font-size: 11.8pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 28.6mm; inset-block-start: 110.9mm; inline-size: 43.9mm; block-size: 3.2mm; font-size: 9.1pt"><li>{{ slot_6 }}</li></ul>
