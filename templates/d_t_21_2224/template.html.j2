<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 125.9mm; inset-block-start: 10.2mm; inline-size: 7.6mm; block-size: 8.7mm; font-size: 24.7pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 61.5mm; inset-block-start: 12.3mm; inline-size: 60.0mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 23.3mm; inline-size: 92.2mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 36.2mm; inline-size: 65.7mm; block-size: 18.7mm; font-size: 26.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 56.1mm; inline-size: 89.4mm; block-size: 12.0mm; font-size: 11.4pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 35.9mm; inset-block-start: 72.1mm; inline-size: 57.3mm; block-size: 15.6mm; font-size: 22.1pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 88.9mm; inline-size: 88.4mm; block-size: 34.7mm; font-size: 10.9pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 35.9mm; inset-block-start: 127.5mm; inline-size: 57.3mm; block-size: 15.6mm; font-size: 22.1pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 144.3mm; inline-size: 93.5mm; block-size: 42.2mm; font-size: 10.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 26.7mm; inset-block-start: 201.9mm; inline-size: 95.7mm; block-size: 7.2mm; font-size: 8.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
