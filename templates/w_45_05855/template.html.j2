<div class="filter-category-element">{{ slot_5 }}</div>
</div>
<div class="filter-price">
<h1>{{ slot_6 }}</h1>
<div class="filter-price-element">{{ slot_7 }}</div>
<div class="filter-price-element">{{ slot_8 }}</div>
<div class="filter-price-element">{{ slot_9 }}</div>
</div>
<div class="filter-brand">
<h1>{{ slot_10 }}</h1>
<div class="filter-brand-element">{{ slot_11 }}</div>
<div class="filter-brand-element">{{ slot_12 }}</div>
