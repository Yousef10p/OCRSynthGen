<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 126.7mm; inline-size: 158.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 74.0mm; inset-block-start: 139.2mm; inline-size: 62.1mm; block-size: 10.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 157.0mm; inline-size: 111.2mm; block-size: 6.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 164.8mm; inline-size: 170.0mm; block-size: 13.9mm; font-size: 12.0pt">{{ slot_4 }}</p>
