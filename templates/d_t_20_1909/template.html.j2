<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 99.7mm; inline-size: 89.8mm; block-size: 6.4mm; font-size: 18.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 108.1mm; inline-size: 112.7mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 115.4mm; inline-size: 114.0mm; block-size: 8.8mm; font-size: 12.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 126.2mm; inline-size: 60.1mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 132.8mm; inline-size: 109.6mm; block-size: 13.2mm; font-size: 12.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 148.3mm; inline-size: 111.6mm; block-size: 8.8mm; font-size: 12.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 158.9mm; inline-size: 117.3mm; block-size: 13.2mm; font-size: 12.5pt">{{ slot_7 }}</p>
