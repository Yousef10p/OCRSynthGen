<p class="box" style="inset-inline-start: 108.5mm; inset-block-start: 73.1mm; inline-size: 81.0mm; block-size: 80.2mm; font-size: 16.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 108.1mm; inline-size: 77.0mm; block-size: 27.7mm; font-size: 15.7pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 20.7mm; inset-block-start: 140.8mm; inline-size: 80.0mm; block-size: 33.5mm; font-size: 15.8pt"><li>{{ slot_6 }}</li></ul>
