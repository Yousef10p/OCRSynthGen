<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 33.4mm; inline-size: 160.9mm; block-size: 46.4mm; font-size: 11.9pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 42.4mm; inset-block-start: 89.4mm; inline-size: 45.0mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 93.3mm; inline-size: 160.2mm; block-size: 20.7mm; font-size: 11.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 114.7mm; inline-size: 158.5mm; block-size: 33.5mm; font-size: 11.9pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 7.4mm; inset-block-start: 146.4mm; inline-size: 3.4mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 148.9mm; inline-size: 160.9mm; block-size: 25.0mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 174.6mm; inline-size: 160.8mm; block-size: 16.4mm; font-size: 11.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 191.7mm; inline-size: 160.1mm; block-size: 50.6mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 243.0mm; inline-size: 159.6mm; block-size: 20.7mm; font-size: 11.7pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 78.6mm; inset-block-start: 271.8mm; inline-size: 46.2mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_9 }}</footer>
</div></body>
</html>
