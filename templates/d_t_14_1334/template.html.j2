<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 21.8mm; inset-block-start: 21.5mm; inline-size: 38.7mm; block-size: 19.0mm; font-size: 13.5pt"></div>
<header class="box" style="inset-inline-start: 64.2mm; inset-block-start: 23.2mm; inline-size: 53.9mm; block-size: 17.6mm; font-size: 8.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 84.6mm; inset-block-start: 69.8mm; inline-size: 44.3mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 86.5mm; inset-block-start: 77.6mm; inline-size: 40.6mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 75.0mm; inset-block-start: 85.4mm; inline-size: 62.1mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_3 }}</h2>
<h1 class="box" style="inset-inline-start: 28.2mm; inset-block-start: 101.0mm; inline-size: 157.3mm; block-size: 14.4mm; font-size: 18.0pt">{{ slot_4 }}</h1>
<h2 class="box" style="inset-inline-start: 72.6mm; inset-block-start: 132.2mm; inline-size: 67.0mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_5 }}</h2>
<h2 class="box" style="inset-inline-start: 72.7mm; inset-block-start: 140.0mm; inline-size: 68.1mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_6 }}</h2>
<footer class="box" style="inset-inline-start: 22.2mm; inset-block-start: 272.0mm; inline-size: 109.8mm; block-size: 14.4mm; font-size: 9.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 169.9mm; inset-block-start: 286.6mm; inline-size: 20.1mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
