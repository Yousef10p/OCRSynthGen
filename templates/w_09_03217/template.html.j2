<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #ccc;
}

.grid-container {
    display: grid;
    grid-template-columns: 20% 80%;
    color: #333;
}

.book-categories, .book-reviews {
    padding: 10px;
    text-align: right;
}

.author-bio, .book-review-img {
    background-color: yellow; 
    width: 100px;
    height: 100px;
    margin: 2.5px;
}

.book-review {
    background-color: #fff;
    margin-top: 10px;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="grid-container">
<div class="book-categories">
<h2 style="color: white">{{ slot_0 }}</h2>
<div><p>{{ slot_1 }}</p></div>
<div><p>{{ slot_2 }}</p></div>
<div><p>{{ slot_3 }}</p></div>
<div><p>{{ slot_4 }}</p></div>
<div><p>{{ slot_5 }}</p></div>
</div>
<div class="book-reviews">
<h2 style="color: white">{{ slot_6 }}</h2>

<div class="book-review">
<h3 style="color: white">{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
<div class="book-review-img"><p>{{ slot_9 }}</p></div>
<div class="author-bio">
<h3 style="color: white">{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>
</div>

<div class="book-review">
<h3 style="color: white">{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<div class="book-review-img"><p>{{ slot_14 }}</p></div>
<div class="author-bio">
<h3 style="color: white">{{ slot_15 }}</h3>
<p>{{ slot_16 }}</p>
</div>
</div>

</div>
</div>
</body>
</html>