<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 76.3mm; inset-block-start: 12.5mm; inline-size: 77.8mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 76.3mm; inset-block-start: 20.5mm; inline-size: 111.9mm; block-size: 55.6mm; font-size: 15.8pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 17.5mm; inset-block-start: 84.3mm; inline-size: 172.5mm; block-size: 24.8mm; font-size: 40.0pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 76.3mm; inset-block-start: 117.7mm; inline-size: 57.1mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 76.3mm; inset-block-start: 125.7mm; inline-size: 112.5mm; block-size: 49.9mm; font-size: 15.7pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 76.3mm; inset-block-start: 184.2mm; inline-size: 65.4mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 76.3mm; inset-block-start: 192.2mm; inline-size: 107.0mm; block-size: 9.8mm; font-size: 13.8pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 21.0mm; inset-block-start: 222.2mm; inline-size: 49.9mm; block-size: 50.3mm; font-size: 20.4pt"></div>
<div class="box ph" style="inset-inline-start: 82.7mm; inset-block-start: 222.2mm; inline-size: 51.1mm; block-size: 50.7mm; font-size: 20.5pt"></div>
<div class="box ph" style="inset-inline-start: 139.1mm; inset-block-start: 222.4mm; inline-size: 45.7mm; block-size: 50.1mm; font-size: 20.3pt"></div>
</div></body>
</html>
