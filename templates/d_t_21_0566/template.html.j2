<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 9.0mm; inset-block-start: 7.9mm; inline-size: 37.4mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_0 }}</header><ul class="box" style="inset-inline-start: 12.4mm; inset-block-start: 27.3mm; inline-size: 120.5mm; block-size: 17.4mm; font-size: 9.8pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 63.7mm; inline-size: 110.6mm; block-size: 16.4mm; font-size: 9.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.6mm; inset-block-start: 94.5mm; inline-size: 110.3mm; block-size: 12.8mm; font-size: 9.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 9.0mm; inset-block-start: 122.6mm; inline-size: 57.1mm; block-size: 5.4mm; font-size: 12.0pt">{{ slot_4 }}</h2>
<h2 class="box" style="inset-inline-start: 24.6mm; inset-block-start: 135.6mm; inline-size: 21.5mm; block-size: 4.4mm; font-size: 9.8pt">{{ slot_5 }}</h2>
<ul class="box" style="inset-inline-start: 14.3mm; inset-block-start: 140.3mm; inline-size: 115.0mm; block-size: 9.8mm; font-size: 9.8pt"><li>{{ slot_6 }}</li></ul>
<h2 class="box" style="inset-inline-start: 24.6mm; inset-block-start: 154.9mm; inline-size: 21.5mm; block-size: 4.4mm; font-size: 9.8pt">{{ slot_7 }}</h2>
<ul class="box" style="inset-inline-start: 14.3mm; inset-block-start: 159.6mm; inline-size: 115.0mm; block-size: 9.8mm; font-size: 9.8pt"><li>{{ slot_8 }}</li></ul>
<footer class="box" style="inset-inline-start: 9.0mm; inset-block-start: 204.9mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 9.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
