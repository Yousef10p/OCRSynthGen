<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

.hero {
    background: gray;
    color: white;
    text-align: center;
    padding: 200px 0;
    font-size: 50px;
}

.menu { 
    width: 350px;
    height: 100%;
    position: fixed;
    top: 0;
    right: 0;
    background: lightgray;
    padding: 20px;
}

.menu ul {
    list-style-type: none;
    padding: 0;
}

.menu li {
    margin: 20px 0;
    font-size: 30px;
}

.content {
    margin-right: 350px;
    padding: 20px;
}

.paragraph {
    margin: 20px 0;
    font-size: 25px;
}

.image {
    background: lightblue;
    height: 400px;
    margin: 20px 0;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
}

.footer {
    background: lightgray;
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    padding: 20px 0;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">{{ slot_0 }}</div>
<div class="menu">
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
<div class="content">
<div class="paragraph">{{ slot_6 }}</div>
<div class="image">{{ slot_7 }}</div>
<div class="paragraph">{{ slot_8 }}</div>
<div class="image">{{ slot_9 }}</div>
<div class="paragraph">{{ slot_10 }}</div>
<div class="image">{{ slot_11 }}</div>
<div class="paragraph">{{ slot_12 }}</div>
<div class="image">{{ slot_13 }}</div>
<div class="paragraph">{{ slot_14 }}</div>
<div class="image">{{ slot_15 }}</div>
</div>
<div class="footer">{{ slot_16 }}</div>
</body>
</html>