<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 26.1mm; inline-size: 14.7mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 52.2mm; inset-block-start: 33.2mm; inline-size: 51.0mm; block-size: 8.3mm; font-size: 6.0pt"></div>
<div class="box ph" style="inset-inline-start: 50.5mm; inset-block-start: 43.1mm; inline-size: 88.7mm; block-size: 8.3mm; font-size: 6.0pt"></div>
<div class="box ph" style="inset-inline-start: 48.5mm; inset-block-start: 52.7mm; inline-size: 100.4mm; block-size: 8.3mm; font-size: 6.0pt"></div>
<div class="box ph" style="inset-inline-start: 48.1mm; inset-block-start: 62.3mm; inline-size: 102.3mm; block-size: 8.1mm; font-size: 6.0pt"></div>
<div class="box ph" style="inset-inline-start: 44.1mm; inset-block-start: 72.2mm; inline-size: 121.8mm; block-size: 8.1mm; font-size: 6.0pt"></div>
<div class="box ph" style="inset-inline-start: 46.1mm; inset-block-start: 82.0mm; inline-size: 113.2mm; block-size: 8.1mm; font-size: 6.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 102.1mm; inline-size: 160.0mm; block-size: 17.2mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 122.2mm; inline-size: 160.0mm; block-size: 32.9mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 56.7mm; inset-block-start: 163.5mm; inline-size: 96.2mm; block-size: 37.8mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 206.0mm; inline-size: 160.0mm; block-size: 10.3mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 223.0mm; inline-size: 160.0mm; block-size: 10.2mm; font-size: 10.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 103.2mm; inset-block-start: 280.1mm; inline-size: 3.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
