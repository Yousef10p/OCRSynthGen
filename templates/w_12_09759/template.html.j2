  top: 0;
  width: 100%;
  height: 50px;
  z-index: 1;
}
nav ul {
  list-style-type: none;
  padding: 0;
  display: flex;
  justify-content: space-between;
}
nav li {
  flex: 1;
  text-align: center;
  padding: 15px 0;
}
nav a {
  color: #fff;
  text-decoration: none;
}
nav a:hover {
  background-color: #555;
}


aside {
  position: absolute;
  top: 50px;
