<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<label>{{ slot_12 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
<button>{{ slot_14 }}</button>
</form>
</section>
<footer>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>