<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 26.0mm; inline-size: 158.5mm; block-size: 30.1mm; font-size: 10.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.3mm; inset-block-start: 66.3mm; inline-size: 155.0mm; block-size: 16.6mm; font-size: 10.5pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 31.6mm; inset-block-start: 86.5mm; inline-size: 149.3mm; block-size: 16.7mm; font-size: 10.5pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.6mm; inset-block-start: 106.8mm; inline-size: 145.2mm; block-size: 23.5mm; font-size: 10.5pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.6mm; inset-block-start: 133.9mm; inline-size: 93.4mm; block-size: 3.4mm; font-size: 10.5pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.6mm; inset-block-start: 140.8mm; inline-size: 137.1mm; block-size: 23.5mm; font-size: 10.5pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.6mm; inset-block-start: 167.8mm; inline-size: 145.6mm; block-size: 10.0mm; font-size: 10.5pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 187.8mm; inline-size: 152.7mm; block-size: 17.0mm; font-size: 10.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.2mm; inset-block-start: 214.9mm; inline-size: 160.5mm; block-size: 43.4mm; font-size: 10.4pt">{{ slot_8 }}</p>
</div></body>
</html>
