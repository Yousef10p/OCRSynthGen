<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.4mm; inset-block-start: 76.5mm; inline-size: 133.3mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 85.4mm; inline-size: 210.1mm; block-size: 41.8mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 152.3mm; inline-size: 79.0mm; block-size: 54.4mm; font-size: 14.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 107.7mm; inset-block-start: 152.3mm; inline-size: 78.7mm; block-size: 95.3mm; font-size: 14.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 19.7mm; inset-block-start: 211.9mm; inline-size: 56.6mm; block-size: 3.2mm; font-size: 8.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 216.7mm; inline-size: 78.0mm; block-size: 49.3mm; font-size: 14.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 99.1mm; inset-block-start: 276.4mm; inline-size: 8.5mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_5 }}</footer>
</div></body>
</html>
