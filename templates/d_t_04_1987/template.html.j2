<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 155.5mm; inline-size: 170.8mm; block-size: 45.5mm; font-size: 12.9pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 203.9mm; inline-size: 131.8mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_10 }}</p>
<ul class="box" style="inset-inline-start: 25.1mm; inset-block-start: 211.0mm; inline-size: 165.7mm; block-size: 22.5mm; font-size: 12.8pt"><li>{{ slot_11 }}</li></ul>
<footer class="box" style="inset-inline-start: 194.7mm; inset-block-start: 279.4mm; inline-size: 4.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_12 }}</footer>
</div></body>
</html>
