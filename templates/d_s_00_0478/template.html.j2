<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 171.7mm; inset-block-start: 24.8mm; inline-size: 33.1mm; block-size: 33.0mm; font-size: 15.6pt"></div>
<h2 class="box" style="inset-inline-start: 16.6mm; inset-block-start: 29.7mm; inline-size: 142.7mm; block-size: 31.2mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 67.6mm; inline-size: 215.9mm; block-size: 88.6mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 161.8mm; inset-block-start: 156.2mm; inline-size: 53.9mm; block-size: 87.7mm; font-size: 14.6pt"></div>
<ul class="box" style="inset-inline-start: 12.0mm; inset-block-start: 169.5mm; inline-size: 129.9mm; block-size: 26.2mm; font-size: 24.7pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 207.4mm; inline-size: 115.3mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 213.6mm; inline-size: 131.7mm; block-size: 14.1mm; font-size: 13.4pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 17.1mm; inset-block-start: 248.6mm; inline-size: 28.6mm; block-size: 10.2mm; font-size: 14.4pt"></div>
<footer class="box" style="inset-inline-start: 54.0mm; inset-block-start: 252.9mm; inline-size: 135.0mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_4 }}</footer>
</div></body>
</html>
