    padding: 0;
    overflow: hidden;
    background-color: #f1f1f1;
}

nav ul li {
    float: right;
}

nav ul li a {
    display: block;
    color: #666;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

header {
    background-color: #f1f1f1;
    padding: 20px;
