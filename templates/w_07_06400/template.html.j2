}

.hero-image, .product {
    background-color: #ddd;
    height: 200px;
    line-height: 200px;
    text-align: center;
    margin: 20px 0;
}

footer {
    text-align: center;
    background-color: #f1f1f1;
    padding: 10px 0;
    position: absolute;
    width: 100%;
    bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
