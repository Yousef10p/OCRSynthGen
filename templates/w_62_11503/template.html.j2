  box-shadow: 0px 2px 10px rgba(0,0,0,0.2);
}

nav ul {
  display: flex;
}

nav ul li {
  list-style: none;
  margin: 0px 20px;
}

nav ul li a {
  text-decoration: none;
  color: #000;
}

main {
  display: flex;
  justify-content: space-around;
}

.item {
  width: 30%;
  text-align: center;
  box-shadow: 0px 2px 10px rgba(0,0,0,0.2);
}

.item img {
  width: 100%;
  
