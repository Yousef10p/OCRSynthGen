  margin-bottom: 10px;
}

.item a {
  display: inline-block;
  text-decoration: none;
  color: #fff;
  background: #000;
  padding: 10px 20px;
  border-radius: 5px;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
