<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.4mm; inset-block-start: 0.0mm; inline-size: 208.9mm; block-size: 102.4mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 132.7mm; inset-block-start: 103.5mm; inline-size: 70.1mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 118.2mm; inline-size: 92.1mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 29.8mm; inset-block-start: 128.0mm; inline-size: 43.2mm; block-size: 9.8mm; font-size: 13.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 132.4mm; inline-size: 100.0mm; block-size: 28.8mm; font-size: 11.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 29.8mm; inset-block-start: 142.3mm; inline-size: 32.1mm; block-size: 23.2mm; font-size: 40.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 163.5mm; inline-size: 99.0mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 177.7mm; inline-size: 98.4mm; block-size: 16.1mm; font-size: 11.4pt">{{ slot_6 }}</p>
