<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}


.menu ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}
.menu li {
    float: right;
}
.menu li a, .dropdown-content {
    display: inline-block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}
.menu li a:hover, .dropdown:hover .dropdown-content {
    background-color: red;
}
.menu li a:hover{
    color: blue;
}
.menu .dropdown-content {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 160px;
    z-index: 1;
}
.menu .dropdown:hover .dropdown-content {
    display: block;
}


.carousel .image {
    height: 200px;
    width: 200px;
    margin: 20px;
    background-color: green;
    display: inline-block;
}


.content {
    margin: 20px;
    font-size: 18px;
}


.footer {
    background-color: #f2f2f2;
    padding: 25px;
    text-align: center;
}
.footer h4 {
    margin-top: 0;
}
.footer ul {
    list-style-type: none;
    padding: 0;
}
.footer li {
    display: inline;
    padding: 0 10px;
    border-left: 1px solid black;
}
.footer li:last-child {
    border-left: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</div>
<div class="carousel">
<div class="image ph"></div>
<div class="image ph"></div>
<div class="image ph"></div>
</div>
<div class="content">
<p>{{ slot_7 }}</p>
</div>
<div class="footer">
<h4>{{ slot_8 }}</h4>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
<h4>{{ slot_12 }}</h4>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</div>
</body>
</html>