<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 108.3mm; inline-size: 86.9mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 121.9mm; inline-size: 86.8mm; block-size: 31.2mm; font-size: 12.6pt">{{ slot_5 }}</p>
