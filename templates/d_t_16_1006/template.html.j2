<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 87.8mm; inline-size: 12.0mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 92.8mm; inline-size: 89.4mm; block-size: 89.0mm; font-size: 12.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 116.8mm; inset-block-start: 111.3mm; inline-size: 37.5mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 116.8mm; inset-block-start: 116.3mm; inline-size: 87.1mm; block-size: 16.8mm; font-size: 11.9pt">{{ slot_6 }}</p>
