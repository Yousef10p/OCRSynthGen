    display: flex;
    justify-content: space-around;
    background: #DDD;
    padding: 10px 0;
}

nav ul li {
    list-style-type: none;
}

main {
    padding: 20px;
}

footer {
    display: block;
    position: absolute;
    bottom: 0;
    width: 100%;
    background: #333;
    height: 100px;
    line-height: 100px;
    color: #FFF;
    text-align: center;
}

.featured {
