}

.featured button {
    background: #FFF;
    color: #333;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    transition: background 0.3s ease;
}

.featured button:hover {
    background: #333;
    color: #FFF;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
