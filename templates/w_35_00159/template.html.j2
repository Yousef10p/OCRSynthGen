<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}


.grid {
    display: grid;
    grid-template-columns: 1fr 3fr;
}


#banner {
    background-color: #000;
    color: #fff;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.text {
    font-size: 2em;
    text-align: center;
}


#sidebar {
    background-color: #ddd;
    padding: 20px;
}
input#search {
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 10px;
}
ul#nav {
    list-style-type: none;
    padding: 0;
}
#nav li a {
    display: block;
    color: #000;
    text-decoration: none;
    margin-bottom: 10px;
}


#content {
    margin: 20px;
}
p {
    font-size: 1.2em;
    line-height: 1.5em;
}


.img-placeholder {
    width: 100%;
    background-color: #999;
    height: 300px;
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="banner"> 
<div class="text"> {{ slot_0 }} </div>
</div>
<div class="grid"> 
<div id="sidebar">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
<ul id="nav">
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
<div> {{ slot_7 }} <a>{{ slot_8 }}</a>{{ slot_9 }} <a>{{ slot_10 }}</a>{{ slot_11 }} <a>{{ slot_12 }}</a></div>
</div>
<div id="content">
<div class="img-placeholder ph"></div> 
<p> {{ slot_13 }} </p>
<div class="img-placeholder ph"></div> 
<p> {{ slot_14 }} </p>

</div>
</div>
</body>
</html>