<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.2mm; inset-block-start: 69.7mm; inline-size: 34.8mm; block-size: 7.2mm; font-size: 20.5pt"></div>
<div class="box ph" style="inset-inline-start: 77.5mm; inset-block-start: 68.2mm; inline-size: 42.9mm; block-size: 10.8mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 26.3mm; inset-block-start: 78.0mm; inline-size: 9.1mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 26.3mm; inset-block-start: 89.8mm; inline-size: 14.6mm; block-size: 12.3mm; font-size: 11.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 77.4mm; inset-block-start: 89.7mm; inline-size: 14.6mm; block-size: 12.3mm; font-size: 11.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 129.6mm; inline-size: 171.4mm; block-size: 16.7mm; font-size: 15.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 26.2mm; inset-block-start: 153.0mm; inline-size: 33.1mm; block-size: 5.0mm; font-size: 14.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 158.8mm; inline-size: 169.9mm; block-size: 28.4mm; font-size: 16.1pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 26.2mm; inset-block-start: 193.8mm; inline-size: 47.3mm; block-size: 5.0mm; font-size: 14.3pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 199.6mm; inline-size: 166.1mm; block-size: 16.7mm; font-size: 15.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 223.0mm; inline-size: 167.6mm; block-size: 28.4mm; font-size: 16.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 113.9mm; inset-block-start: 282.4mm; inline-size: 40.2mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
