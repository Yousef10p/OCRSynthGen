<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #F5F5F5;
}

header, footer {
    background-color: #333;
    color: #FFF;
    padding: 20px;
    text-align: center;
}

.destinations {
    display: grid;
    grid-template-columns: auto auto auto;
    gap: 20px;
    padding: 20px;
}

.destination {
    background-color: #FFF;
    border-radius: 10px;
    padding: 20px;
}

.image {
    background-color: #AAA;
    color: #FFF;
    padding: 100px 0;
    text-align: center;
    margin: 20px 0;
}

form {
    margin: 20px 0;
}

form input {
    padding: 10px;
    margin: 10px;
    border-radius: 5px;
    border: 1px solid #AAA;
}

button {
    padding: 10px;
    background-color: #008CBA;
    color: #FFF;
    border: none;
    border-radius: 5px;
}

button:hover {
    background-color: #007B9A;
}

.center {
    text-align: center;
}

.center-text {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1 class="center-text">{{ slot_0 }}</h1>
<h2 class="center-text">{{ slot_1 }}</h2>
<form class="center">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_2 }}</span>
</form>
</header>
<main class="destinations">
<section class="destination">
<h2>{{ slot_3 }}</h2>
<div class="image">{{ slot_4 }}</div>
<button>{{ slot_5 }}</button>
</section>
<section class="destination">
<h2>{{ slot_6 }}</h2>
<div class="image">{{ slot_7 }}</div>
<button>{{ slot_8 }}</button>
</section>
<section class="destination">
<h2>{{ slot_9 }}</h2>
<div class="image">{{ slot_10 }}</div>
<button>{{ slot_11 }}</button>
</section>
</main>
<footer>
<h2>{{ slot_12 }}</h2>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
<button>{{ slot_14 }}</button>
</form>
</footer>
</body>
</html>