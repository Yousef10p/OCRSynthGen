<div class="box ph" style="inset-inline-start: 26.6mm; inset-block-start: 82.7mm; inline-size: 86.0mm; block-size: 64.6mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 116.5mm; inset-block-start: 81.9mm; inline-size: 86.0mm; block-size: 59.2mm; font-size: 15.2pt"></div>
