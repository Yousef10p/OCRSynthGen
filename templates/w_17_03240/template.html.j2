}

.hero-article,
.column-article {
    width: 30%;
    background-color: #f2f2f2;
    padding: 20px;
    text-align: center;
}

.image-placeholder {
    background-color: #c6d5ff;
    height: 100px;
    margin: 20px 0;
}

#column-section {
    display: flex;
    justify-content: space-between;
    padding: 20px;
}

nav ul {
    display: flex;
    justify-content: space-around;
    list-style-type: none;
}

nav ul li a {
    color: #333;
    text-decoration: none;
}

@media (max-width: 600px) {
    #hero-section,
    .hero-article,
    .column-article,
    #column-section {
        flex-direction: column;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
