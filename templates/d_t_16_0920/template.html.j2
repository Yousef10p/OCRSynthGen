<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 13.4mm; inline-size: 83.3mm; block-size: 16.4mm; font-size: 11.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 13.4mm; inline-size: 83.3mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 27.1mm; inline-size: 85.0mm; block-size: 25.1mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 35.0mm; inline-size: 83.3mm; block-size: 25.1mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 58.1mm; inline-size: 83.3mm; block-size: 51.1mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 65.3mm; inline-size: 83.4mm; block-size: 72.7mm; font-size: 12.1pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 114.3mm; inset-block-start: 114.3mm; inline-size: 29.4mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 120.2mm; inline-size: 83.3mm; block-size: 16.4mm; font-size: 11.6pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 23.3mm; inset-block-start: 142.3mm; inline-size: 174.7mm; block-size: 115.4mm; font-size: 19.2pt"></div>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 260.0mm; inline-size: 134.4mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 191.0mm; inset-block-start: 269.1mm; inline-size: 6.3mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
