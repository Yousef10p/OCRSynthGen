<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 11.3mm; inline-size: 117.2mm; block-size: 6.2mm; font-size: 17.5pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 25.3mm; inline-size: 112.8mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 12.4mm; inset-block-start: 33.7mm; inline-size: 187.3mm; block-size: 108.2mm; font-size: 13.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 145.9mm; inline-size: 187.8mm; block-size: 44.0mm; font-size: 13.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 193.9mm; inline-size: 187.1mm; block-size: 14.4mm; font-size: 13.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 212.3mm; inline-size: 44.2mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 229.2mm; inline-size: 25.5mm; block-size: 9.5mm; font-size: 13.4pt">{{ slot_6 }}</p>
</div></body>
</html>
