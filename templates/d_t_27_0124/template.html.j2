<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 25.2mm; inline-size: 144.8mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 48.7mm; inset-block-start: 42.6mm; inline-size: 140.8mm; block-size: 62.9mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 107.0mm; inline-size: 36.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 48.3mm; inset-block-start: 116.1mm; inline-size: 42.3mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 121.4mm; inline-size: 132.3mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 127.4mm; inline-size: 144.8mm; block-size: 15.9mm; font-size: 11.3pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 53.8mm; inset-block-start: 149.6mm; inline-size: 138.6mm; block-size: 80.5mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 53.3mm; inset-block-start: 231.8mm; inline-size: 70.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 158.1mm; inset-block-start: 266.3mm; inline-size: 35.0mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
