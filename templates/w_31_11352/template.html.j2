}

nav a {
    color: white;
    text-decoration: none;
}

section {
    margin: 20px;
    padding: 20px;
    background: white;
    box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
}

ul {
    list-style-type: none;
}

li {
    margin: 10px 0;
