}

input[type="date"], input[type="time"], input[type="number"], input[type="submit"] {
    display: block;
    margin: 10px 0;
    padding: 10px;
    width: 100%;
}

input[type="submit"] {
    background: #333;
    color: white;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
