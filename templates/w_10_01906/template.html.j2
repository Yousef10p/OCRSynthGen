  background-color: #f8f8f8;
  padding: 10px;
}

header img#logo {
  height: 50px;
}

nav ul {
  display: flex;
  list-style-type: none;
}

nav li {
  margin-right: 15px;
}

.image-placeholder {
  width: 100%;
  height: 400px;
  background-color: #f8f8f8;
  margin-bottom: 50px;
}

main {
  padding: 20px;
}

main > h1, main > p {
  text-align: center;
  margin-bottom: 30px;
}

main .product-img, .info-img, .post-img {
  height: 300px;
  width: 100%;
  display: block;
  margin: 30px auto;
}

main > h2 {
