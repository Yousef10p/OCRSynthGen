<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 36.1mm; inset-block-start: 12.0mm; inline-size: 153.2mm; block-size: 60.3mm; font-size: 15.5pt"></div>
<h2 class="box" style="inset-inline-start: 36.6mm; inset-block-start: 73.8mm; inline-size: 50.2mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 36.6mm; inset-block-start: 78.1mm; inline-size: 149.8mm; block-size: 10.2mm; font-size: 9.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 73.4mm; inset-block-start: 98.3mm; inline-size: 55.9mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 73.4mm; inset-block-start: 106.2mm; inline-size: 113.4mm; block-size: 21.2mm; font-size: 15.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 73.4mm; inset-block-start: 134.7mm; inline-size: 91.4mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 73.4mm; inset-block-start: 142.7mm; inline-size: 114.6mm; block-size: 27.0mm; font-size: 15.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 73.4mm; inset-block-start: 173.4mm; inline-size: 111.0mm; block-size: 9.8mm; font-size: 13.8pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 72.7mm; inset-block-start: 193.0mm; inline-size: 116.4mm; block-size: 52.6mm; font-size: 14.9pt"></div>
<h2 class="box" style="inset-inline-start: 73.5mm; inset-block-start: 247.7mm; inline-size: 43.3mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 73.5mm; inset-block-start: 252.0mm; inline-size: 108.6mm; block-size: 13.8mm; font-size: 9.7pt">{{ slot_8 }}</p>
</div></body>
</html>
