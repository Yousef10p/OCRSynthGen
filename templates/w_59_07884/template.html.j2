<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}


body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.5;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background-color: #f8f8f8;
  padding: 80px 0;
}

.hero__logo {
  background-color: #000;
  width: 100px;
  height: 100px;
  margin-bottom: 20px;
}

.hero__nav {
  margin-top: 20px;
}

.hero__nav-link {
  margin: 0 10px;
  color: #000;
  text-decoration: none;
}

.hero__content {
  max-width: 600px;
  padding: 60px 30px;
  animation: fadeIn 2s ease-in-out;
}

.hero__title {
  font-size: 3em;
  margin-bottom: 20px;
}

.hero__subtitle {
  margin-bottom: 40px;
  color: #999;
}

.hero__cta {
  display: inline-block;
  padding: 10px 20px;
  background-color: #000;
  color: #fff;
  text-decoration: none;
  margin-top: 60px;
}

.section {
  padding: 60px 30px;
  text-align: center;
}

.section__title {
  font-size: 2em;
  margin-bottom: 30px;
  text-transform: uppercase;
}

.section__content {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  margin-top: 30px;
}

.section__item {
  background-color: #000;
  height: 200px;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<section class="hero">
<header class="header">
<div class="header__logo ph"></div>
<nav class="header__nav">
<a class="header__nav-link">{{ slot_0 }}</a>
<a class="header__nav-link">{{ slot_1 }}</a>
</nav>
</header>
<div class="hero__content">
<h1 class="hero__title">{{ slot_2 }}</h1>
<p class="hero__subtitle">{{ slot_3 }}</p>
<a class="hero__cta">{{ slot_4 }}</a>
</div>
</section>
<section class="section" id="products">
<h2 class="section__title">{{ slot_5 }}</h2>
<p class="section__paragraph">{{ slot_6 }}</p>
<div class="section__content">
<div class="section__item">{{ slot_7 }}</div>
<div class="section__item">{{ slot_8 }}</div>
<div class="section__item">{{ slot_9 }}</div>
</div>
</section>
<section class="section" id="services">
<h2 class="section__title">{{ slot_10 }}</h2>
<p class="section__paragraph">{{ slot_11 }}</p>
<div class="section__content">
<div class="section__item">{{ slot_12 }}</div>
<div class="section__item">{{ slot_13 }}</div>
<div class="section__item">{{ slot_14 }}</div>
</div>
</section>
</body>
</html>