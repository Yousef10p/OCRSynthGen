<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 171.4mm; inline-size: 16.8mm; block-size: 3.2mm; font-size: 9.5pt"><li>{{ slot_8 }}</li></ul>
<div class="box ph" style="inset-inline-start: 54.8mm; inset-block-start: 176.1mm; inline-size: 59.7mm; block-size: 11.4mm; font-size: 32.3pt"></div>
