<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 93.7mm; inline-size: 167.6mm; block-size: 13.5mm; font-size: 9.5pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 109.1mm; inline-size: 25.1mm; block-size: 3.2mm; font-size: 9.5pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 114.2mm; inline-size: 167.6mm; block-size: 23.8mm; font-size: 9.5pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 140.4mm; inline-size: 16.8mm; block-size: 3.2mm; font-size: 9.5pt"><li>{{ slot_6 }}</li></ul>
