<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 52.0mm; inline-size: 258.0mm; block-size: 17.7mm; font-size: 11.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.0mm; inset-block-start: 72.0mm; inline-size: 258.0mm; block-size: 22.2mm; font-size: 11.0pt"><li>{{ slot_5 }}</li></ul>
