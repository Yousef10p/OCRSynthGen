<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 91.9mm; inline-size: 127.4mm; block-size: 4.6mm; font-size: 9.5pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 61.5mm; inset-block-start: 102.8mm; inline-size: 128.4mm; block-size: 7.9mm; font-size: 12.0pt"></div>
