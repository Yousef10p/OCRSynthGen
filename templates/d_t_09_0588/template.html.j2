<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 42.3mm; inline-size: 144.9mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 76.9mm; inline-size: 64.1mm; block-size: 6.1mm; font-size: 17.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 89.8mm; inline-size: 145.0mm; block-size: 55.9mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 29.8mm; inset-block-start: 150.8mm; inline-size: 136.3mm; block-size: 15.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 172.4mm; inline-size: 145.0mm; block-size: 46.4mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 67.3mm; inset-block-start: 222.3mm; inline-size: 61.4mm; block-size: 25.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 247.4mm; inline-size: 6.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 73.0mm; inset-block-start: 255.8mm; inline-size: 49.8mm; block-size: 7.2mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 95.9mm; inset-block-start: 268.6mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
