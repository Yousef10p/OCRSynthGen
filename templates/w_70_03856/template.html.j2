    color: #fff;
    padding: 10px;
}

nav ul {
    display: flex;
    justify-content: space-between;
    list-style: none;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

section {
    padding: 20px;
}

form {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
}

form input, form textarea {
    margin-bottom: 10px;
    padding: 10px;
}

form input[type="submit"] {
    background: #333;
    color: #fff;
    cursor: pointer;
}


section::after {
    content: "";
    display: block;
    margin: 20px 0;
    width: 100%;
    height: 200px;
    background: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
