<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 48.1mm; inset-block-start: 28.0mm; inline-size: 127.5mm; block-size: 67.5mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 96.5mm; inline-size: 80.2mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 22.9mm; inset-block-start: 106.7mm; inline-size: 84.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 115.9mm; inline-size: 143.7mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 134.6mm; inline-size: 35.8mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 138.8mm; inline-size: 32.0mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 143.1mm; inline-size: 68.0mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 147.3mm; inline-size: 80.0mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 155.1mm; inline-size: 144.8mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 47.6mm; inset-block-start: 176.1mm; inline-size: 129.2mm; block-size: 72.0mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 249.3mm; inline-size: 123.7mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 123.8mm; inset-block-start: 266.3mm; inline-size: 69.3mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
