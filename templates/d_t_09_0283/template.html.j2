<div class="box ph" style="inset-inline-start: 84.8mm; inset-block-start: 135.2mm; inline-size: 105.7mm; block-size: 6.6mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 148.1mm; inline-size: 155.5mm; block-size: 12.7mm; font-size: 10.9pt">{{ slot_3 }}</p>
