<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 57.8mm; inset-block-start: 7.7mm; inline-size: 65.4mm; block-size: 10.5mm; font-size: 29.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 127.3mm; inset-block-start: 9.1mm; inline-size: 66.4mm; block-size: 27.2mm; font-size: 11.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 57.9mm; inset-block-start: 34.7mm; inline-size: 66.5mm; block-size: 53.7mm; font-size: 15.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 127.3mm; inset-block-start: 38.2mm; inline-size: 60.5mm; block-size: 27.2mm; font-size: 11.0pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 200.6mm; inset-block-start: 52.9mm; inline-size: 8.1mm; block-size: 27.1mm; font-size: 25.6pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 83.0mm; inline-size: 14.5mm; block-size: 5.0mm; font-size: 7.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 68.6mm; inset-block-start: 123.4mm; inline-size: 119.2mm; block-size: 109.9mm; font-size: 24.0pt"></div>
<footer class="box" style="inset-inline-start: 137.2mm; inset-block-start: 269.3mm; inline-size: 20.9mm; block-size: 5.7mm; font-size: 8.1pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 187.4mm; inset-block-start: 268.7mm; inline-size: 5.3mm; block-size: 5.8mm; font-size: 16.5pt">{{ slot_7 }}</footer>
</div></body>
</html>
