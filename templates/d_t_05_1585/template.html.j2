<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 51.5mm; inline-size: 87.6mm; block-size: 182.9mm; font-size: 11.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 109.9mm; inset-block-start: 51.8mm; inline-size: 87.9mm; block-size: 94.9mm; font-size: 11.2pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 5.8mm; inset-block-start: 138.9mm; inline-size: 3.1mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 109.9mm; inset-block-start: 149.4mm; inline-size: 87.6mm; block-size: 51.0mm; font-size: 11.1pt">{{ slot_7 }}</p>
