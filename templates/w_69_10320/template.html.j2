}

nav ul li {
    margin-left: 10px;
}

#search-bar input[type="text"] {
    padding: 5px;
    border: none;
    border-radius: 5px;
}

#search-bar button {
    padding: 5px 10px;
    border: none;
    border-radius: 5px;
