}

.product .cta {
    display: inline-block;
    padding: 10px 20px;
    background-color: #ffc107;
    color: #fff;
    text-decoration: none;
}

#categories {
    margin: 50px 0;
    text-align: center;
}

.filters button {
    margin-left: 10px;
    border: none;
    padding: 5px 10px;
    background-color: #f8f9fa;
    cursor: pointer;
}

.filters button.active {
    background-color: #ffc107;
    color: #fff;
}

footer {
    background-color: #000;
    color: #fff;
    text-align: center;
    padding: 20px 0;
    position: absolute;
    width: 100%;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
