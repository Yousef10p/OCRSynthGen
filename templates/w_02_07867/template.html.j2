}

header, footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8f9fa;
    padding: 10px;
}

nav ul {
    display: flex;
    gap: 10px;
}

form input[type="text"],
footer form input[type="text"],
footer form textarea {
    margin: 10px 0;
}

main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 10px;
}

footer {
    position: absolute;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
