<p class="box" style="inset-inline-start: 30.9mm; inset-block-start: 123.1mm; inline-size: 148.0mm; block-size: 10.4mm; font-size: 11.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 27.0mm; inset-block-start: 134.7mm; inline-size: 157.0mm; block-size: 10.4mm; font-size: 11.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.9mm; inset-block-start: 146.3mm; inline-size: 152.1mm; block-size: 50.9mm; font-size: 11.0pt"><li>{{ slot_6 }}</li></ul>
