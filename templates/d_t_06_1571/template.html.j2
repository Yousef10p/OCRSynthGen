<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 124.0mm; inline-size: 60.0mm; block-size: 27.3mm; font-size: 19.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 75.5mm; inset-block-start: 150.4mm; inline-size: 120.9mm; block-size: 32.7mm; font-size: 15.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 75.5mm; inset-block-start: 187.8mm; inline-size: 120.3mm; block-size: 32.7mm; font-size: 15.5pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 75.5mm; inset-block-start: 225.0mm; inline-size: 76.6mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_7 }}</h2>
