<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 171.1mm; inset-block-start: 8.0mm; inline-size: 29.6mm; block-size: 13.0mm; font-size: 18.5pt"></div>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 29.6mm; inline-size: 205.2mm; block-size: 143.0mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 175.5mm; inline-size: 166.8mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 187.0mm; inline-size: 53.6mm; block-size: 64.0mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 187.0mm; inline-size: 51.3mm; block-size: 59.5mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 141.7mm; inset-block-start: 187.0mm; inline-size: 48.5mm; block-size: 16.9mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.7mm; inset-block-start: 208.4mm; inline-size: 54.1mm; block-size: 44.4mm; font-size: 12.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 83.3mm; inset-block-start: 251.1mm; inline-size: 53.9mm; block-size: 26.6mm; font-size: 12.6pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 255.2mm; inline-size: 31.6mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 265.2mm; inline-size: 51.0mm; block-size: 12.5mm; font-size: 11.8pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 128.1mm; inset-block-start: 285.2mm; inline-size: 73.9mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
