<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 21.8mm; inset-block-start: 12.5mm; inline-size: 27.5mm; block-size: 2.4mm; font-size: 6.9pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 21.8mm; inset-block-start: 15.2mm; inline-size: 2.5mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 21.8mm; inset-block-start: 30.9mm; inline-size: 139.2mm; block-size: 31.7mm; font-size: 40.0pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 21.5mm; inset-block-start: 117.5mm; inline-size: 166.5mm; block-size: 65.7mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 194.4mm; inline-size: 80.7mm; block-size: 49.0mm; font-size: 34.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 108.1mm; inset-block-start: 195.4mm; inline-size: 80.6mm; block-size: 26.8mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 108.1mm; inset-block-start: 225.4mm; inline-size: 80.6mm; block-size: 26.8mm; font-size: 12.7pt">{{ slot_5 }}</p>
</div></body>
</html>
