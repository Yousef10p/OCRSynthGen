<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 150.0mm; inset-block-start: 12.5mm; inline-size: 44.4mm; block-size: 5.8mm; font-size: 8.2pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 28.2mm; inset-block-start: 33.8mm; inline-size: 80.6mm; block-size: 33.6mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 114.4mm; inset-block-start: 33.8mm; inline-size: 80.6mm; block-size: 50.8mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 28.2mm; inset-block-start: 70.2mm; inline-size: 80.6mm; block-size: 7.9mm; font-size: 11.3pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 28.2mm; inset-block-start: 90.1mm; inline-size: 134.3mm; block-size: 6.5mm; font-size: 18.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 28.2mm; inset-block-start: 99.1mm; inline-size: 80.7mm; block-size: 29.4mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 114.4mm; inset-block-start: 99.1mm; inline-size: 80.6mm; block-size: 16.5mm; font-size: 11.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 114.4mm; inset-block-start: 118.3mm; inline-size: 80.7mm; block-size: 20.8mm; font-size: 11.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 28.2mm; inset-block-start: 131.2mm; inline-size: 80.6mm; block-size: 12.2mm; font-size: 11.6pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 27.0mm; inset-block-start: 151.7mm; inline-size: 80.6mm; block-size: 106.7mm; font-size: 15.1pt"></div>
<div class="box ph" style="inset-inline-start: 110.7mm; inset-block-start: 158.3mm; inline-size: 104.8mm; block-size: 120.8mm; font-size: 14.9pt"></div>
</div></body>
</html>
