<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 40.1mm; inset-block-start: 33.0mm; inline-size: 105.0mm; block-size: 5.5mm; font-size: 17.2pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 40.1mm; inset-block-start: 48.3mm; inline-size: 138.6mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 59.9mm; inline-size: 150.0mm; block-size: 46.4mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 113.1mm; inline-size: 135.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 95.1mm; inset-block-start: 124.8mm; inline-size: 39.8mm; block-size: 35.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 165.3mm; inline-size: 150.0mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 193.2mm; inline-size: 150.0mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 40.1mm; inset-block-start: 221.1mm; inline-size: 150.0mm; block-size: 46.4mm; font-size: 12.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 114.0mm; inset-block-start: 273.8mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
