<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.0mm; inset-block-start: 14.0mm; inline-size: 25.4mm; block-size: 1.1mm; font-size: 5.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 18.0mm; inset-block-start: 26.2mm; inline-size: 19.7mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 109.9mm; inset-block-start: 26.2mm; inline-size: 62.9mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 30.2mm; inline-size: 87.8mm; block-size: 79.0mm; font-size: 11.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 109.9mm; inset-block-start: 32.9mm; inline-size: 7.0mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 114.2mm; inline-size: 87.3mm; block-size: 27.0mm; font-size: 10.9pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 5.9mm; inset-block-start: 138.9mm; inline-size: 2.8mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 146.2mm; inline-size: 86.5mm; block-size: 15.0mm; font-size: 10.6pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 18.0mm; inset-block-start: 166.2mm; inline-size: 11.3mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 170.2mm; inline-size: 86.7mm; block-size: 27.0mm; font-size: 10.9pt">{{ slot_9 }}</p>
</div></body>
</html>
