<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

h2 {
    text-align: center;
    padding: 20px 0;
    color: white;
}

.hero {
    background: #2980b9;
    padding: 50px 0;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    grid-gap: 20px;
    padding: 20px;
}

.destination {
    background: #3498db;
    height: 200px;
    text-align: center;
    border-radius: 5px;
}

.package {
    background: white;
    padding: 10px;
    margin: 10px 0;
    border-radius: 5px;
    color: #3498db;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<h2>{{ slot_0 }}</h2>
</div>
<div class="grid">
<div class="destination">
<h3>{{ slot_1 }}</h3>
<div class="package">{{ slot_2 }}</div>
</div>
<div class="destination">
<h3>{{ slot_3 }}</h3>
<div class="package">{{ slot_4 }}</div>
</div>
<div class="destination">
<h3>{{ slot_5 }}</h3>
<div class="package">{{ slot_6 }}</div>
</div>
<div class="destination">
<h3>{{ slot_7 }}</h3>
<div class="package">{{ slot_8 }}</div>
</div>
<div class="destination">
<h3>{{ slot_9 }}</h3>
<div class="package">{{ slot_10 }}</div>
</div>
<div class="destination">
<h3>{{ slot_11 }}</h3>
<div class="package">{{ slot_12 }}</div>
</div>
<div class="destination">
<h3>{{ slot_13 }}</h3>
<div class="package">{{ slot_14 }}</div>
</div>
</div>
</body>
</html>