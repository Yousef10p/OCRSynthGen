    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
}

img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
