<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.6mm; inline-size: 215.5mm; block-size: 102.2mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 19.8mm; inset-block-start: 102.8mm; inline-size: 93.0mm; block-size: 7.0mm; font-size: 20.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 130.9mm; inset-block-start: 118.5mm; inline-size: 53.9mm; block-size: 29.4mm; font-size: 40.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 19.8mm; inset-block-start: 123.2mm; inline-size: 85.3mm; block-size: 43.7mm; font-size: 17.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 139.6mm; inset-block-start: 150.8mm; inline-size: 44.7mm; block-size: 28.2mm; font-size: 40.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 139.6mm; inset-block-start: 185.6mm; inline-size: 45.5mm; block-size: 39.1mm; font-size: 22.2pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 18.8mm; inset-block-start: 243.7mm; inline-size: 13.3mm; block-size: 16.3mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 244.8mm; inline-size: 32.6mm; block-size: 2.6mm; font-size: 5.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.6mm; inset-block-start: 247.7mm; inline-size: 74.3mm; block-size: 11.2mm; font-size: 6.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 143.8mm; inset-block-start: 250.9mm; inline-size: 51.8mm; block-size: 6.6mm; font-size: 9.3pt">{{ slot_7 }}</p>
</div></body>
</html>
