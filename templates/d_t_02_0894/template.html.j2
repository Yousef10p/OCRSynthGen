<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 60.5mm; inset-block-start: 42.8mm; inline-size: 98.1mm; block-size: 115.8mm; font-size: 14.9pt"></div>
<h2 class="box" style="inset-inline-start: 46.6mm; inset-block-start: 162.7mm; inline-size: 124.3mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 40.9mm; inset-block-start: 174.0mm; inline-size: 63.8mm; block-size: 63.2mm; font-size: 13.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 110.5mm; inset-block-start: 174.0mm; inline-size: 63.0mm; block-size: 53.2mm; font-size: 13.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 110.5mm; inset-block-start: 231.8mm; inline-size: 63.5mm; block-size: 38.2mm; font-size: 13.5pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 13.6mm; inset-block-start: 263.8mm; inline-size: 2.6mm; block-size: 2.3mm; font-size: 6.6pt">{{ slot_4 }}</footer>
</div></body>
</html>
