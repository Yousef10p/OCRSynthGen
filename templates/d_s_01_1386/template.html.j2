<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 87.1mm; inset-block-start: 7.7mm; inline-size: 37.5mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 28.2mm; inline-size: 165.6mm; block-size: 25.3mm; font-size: 17.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 59.9mm; inline-size: 165.7mm; block-size: 18.9mm; font-size: 17.9pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 90.5mm; inline-size: 74.5mm; block-size: 9.7mm; font-size: 27.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 105.8mm; inline-size: 165.8mm; block-size: 18.9mm; font-size: 17.9pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 22.5mm; inset-block-start: 138.8mm; inline-size: 61.4mm; block-size: 6.7mm; font-size: 18.9pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.5mm; inset-block-start: 152.9mm; inline-size: 57.1mm; block-size: 6.7mm; font-size: 18.9pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.5mm; inset-block-start: 167.0mm; inline-size: 68.6mm; block-size: 6.7mm; font-size: 18.9pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.5mm; inset-block-start: 181.1mm; inline-size: 97.6mm; block-size: 6.7mm; font-size: 18.9pt"><li>{{ slot_8 }}</li></ul>
</div></body>
</html>
