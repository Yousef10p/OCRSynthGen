<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
  background-color: #fff;
  color: #000;
}


header {
  background-color: #f00;
  color: #fff;
  padding: 10px 0;
  text-align: center;
}


nav {
  float: right;
  width: 20%;
  padding-left: 40px;
  box-sizing: border-box;
}
nav ul {
  list-style: none;
}
nav ul li {
  border-bottom: 1px solid #000;
  padding: 10px 0;
  text-align: center;
}


main {
  float: left;
  width: 80%;
  padding-right: 40px;
  box-sizing: border-box;
}
main p {
  font-size: 20px;
  line-height: 1.4;
}
.featured-image {
  height: 200px;
  width: 200px;
  background-color: #00f;
  margin: 20px auto;
}


footer {
  clear: both;
  background-color: #000;
  color: #fff;
  text-align: center;
  padding: 20px 0;
}
.contact-form, .social-media {
  margin: 20px 0;
}
.contact-form input, .contact-form textarea {
  display: block;
  margin: 20px 0;
  width: 80%;
  padding: 10px;
  box-sizing: border-box;
}
.contact-form button {
  background-color: #f00;
  color: #fff;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
}
.social-media ul {
  list-style: none;
  display: flex;
  justify-content: center;
}
.social-media ul li {
  margin: 0 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
