    padding: 20px;
    margin-bottom: 20px;
}

.review p {
    margin-bottom: 10px;
}

.review .reviewer {
    font-weight: bold;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
