<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 59.6mm; inset-block-start: 49.3mm; inline-size: 100.4mm; block-size: 45.6mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 100.9mm; inline-size: 10.3mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 65.2mm; inset-block-start: 110.1mm; inline-size: 89.3mm; block-size: 26.2mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 140.5mm; inline-size: 56.3mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 48.2mm; inset-block-start: 149.6mm; inline-size: 130.2mm; block-size: 46.9mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 201.2mm; inline-size: 130.7mm; block-size: 7.3mm; font-size: 11.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 209.6mm; inline-size: 140.9mm; block-size: 14.5mm; font-size: 11.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 72.4mm; inset-block-start: 229.1mm; inline-size: 106.0mm; block-size: 9.3mm; font-size: 11.1pt"></div>
<p class="box" style="inset-inline-start: 37.4mm; inset-block-start: 246.1mm; inline-size: 63.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 54.7mm; inset-block-start: 255.2mm; inline-size: 110.0mm; block-size: 25.2mm; font-size: 11.1pt"></div>
<footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 292.7mm; inline-size: 3.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_5 }}</footer>
</div></body>
</html>
