<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.4mm; inset-block-start: 0.0mm; inline-size: 215.1mm; block-size: 137.8mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 18.6mm; inset-block-start: 142.5mm; inline-size: 98.1mm; block-size: 9.2mm; font-size: 26.1pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 143.9mm; inline-size: 10.8mm; block-size: 82.4mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 167.4mm; inset-block-start: 143.2mm; inline-size: 33.7mm; block-size: 26.0mm; font-size: 12.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 156.8mm; inline-size: 145.2mm; block-size: 25.5mm; font-size: 12.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 167.4mm; inset-block-start: 172.1mm; inline-size: 28.2mm; block-size: 21.7mm; font-size: 12.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 186.8mm; inline-size: 145.8mm; block-size: 25.5mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 167.4mm; inset-block-start: 196.7mm; inline-size: 32.9mm; block-size: 47.4mm; font-size: 10.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 216.7mm; inline-size: 145.4mm; block-size: 25.5mm; font-size: 12.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 246.7mm; inline-size: 145.4mm; block-size: 8.4mm; font-size: 11.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 148.9mm; inset-block-start: 261.3mm; inline-size: 48.8mm; block-size: 10.0mm; font-size: 14.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
