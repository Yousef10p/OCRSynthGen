<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #333;
  color: #fff;
}

.header nav ul {
  display: flex;
  list-style: none;
}

.header nav ul li {
  margin-left: 1em;
}

.header nav ul li a {
  color: #fff;
  text-decoration: none;
}

.hero {
  width: 100%;
  height: 300px;
  background-color: #999;
}

.content {
  margin: 1em;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.content section {
  width: 30%;
  margin-bottom: 1em;
}

.footer {
  background-color: #333;
  color: #fff;
  padding: 1em;
  display: flex;
  justify-content: space-between;
}

.footer ul {
  list-style: none;
  display: flex;
}

.footer ul li {
  margin-left: 1em;
}

.footer ul li a {
  color: #fff;
  text-decoration: none;
}

.footer form {
  display: flex;
  flex-direction: column;
}

.footer form input,
.footer form textarea {
  margin-bottom: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</div>
<div class="hero"></div>
<div class="content">
<section id="destinations">
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
</section>
<section id="deals">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</section>
<section id="reviews">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</section>
</div>
<div class="footer">
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_12 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_14 }}</span>
<span class="">{{ slot_15 }}</span>
</form>
</div>
</body>
</html>