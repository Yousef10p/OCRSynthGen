<h2 class="box" style="inset-inline-start: 122.9mm; inset-block-start: 35.9mm; inline-size: 38.2mm; block-size: 4.6mm; font-size: 11.8pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 122.9mm; inset-block-start: 42.2mm; inline-size: 87.3mm; block-size: 49.1mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 29.1mm; inset-block-start: 90.2mm; inline-size: 88.8mm; block-size: 68.9mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 123.1mm; inset-block-start: 91.7mm; inline-size: 88.7mm; block-size: 93.9mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 29.6mm; inset-block-start: 159.3mm; inline-size: 89.2mm; block-size: 102.5mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 123.6mm; inset-block-start: 186.0mm; inline-size: 87.4mm; block-size: 75.3mm; font-size: 11.8pt">{{ slot_7 }}</p>
