<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 29.9mm; inset-block-start: 16.0mm; inline-size: 53.3mm; block-size: 83.2mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 15.5mm; inline-size: 86.9mm; block-size: 31.4mm; font-size: 12.7pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 50.7mm; inline-size: 15.0mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 57.6mm; inline-size: 86.9mm; block-size: 103.6mm; font-size: 12.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 101.4mm; inline-size: 85.9mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 108.1mm; inline-size: 37.5mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 114.9mm; inline-size: 87.1mm; block-size: 40.4mm; font-size: 12.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 160.1mm; inline-size: 86.7mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 165.9mm; inline-size: 86.6mm; block-size: 8.9mm; font-size: 12.5pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 13.2mm; inset-block-start: 176.6mm; inline-size: 176.5mm; block-size: 75.5mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 13.6mm; inset-block-start: 254.7mm; inline-size: 71.5mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.7mm; inline-size: 5.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_9 }}</footer>
</div></body>
</html>
