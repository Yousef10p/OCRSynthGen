    width: 50%;
    margin: 0 auto;
}
input, button {
    margin-bottom: 20px;
    height: 30px;
}
.menu-image {
    width: 30%;
    height: 200px;
    margin: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
