}

label, select {
    padding: .5em;
    margin: 0 .5em;
}


#featured {
    padding: 2em;
}

#featured h2 {
    color: #333;
    text-align: center;
}

.listing {
    width: 100%;
    margin: 2em;
}

.listing .image {
    width: auto;
    height: 150px;
    margin: 0 auto;
}

.listing h3 {
    color: #333;
    text-align: center;
}

.listing p {
    text-align: center;
    color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
