body, html {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    background-color: #F2F2F2;
}


nav ul {
    display: flex;
    justify-content: center;
    list-style-type: none;
    background-color: #333; 
}

nav ul li a {
    color: #8C8C8C;
    text-decoration: none;
    padding: 1em;
    display: inline-block;
}

nav ul li a:hover {
    background-color: #F7F7F7;
    color: #333;
}


header {
    padding: 2em;
    text-align: center;
}

