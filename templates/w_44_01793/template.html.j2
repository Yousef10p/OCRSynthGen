    color: #333;
    font-size: 2.5em;
}

form {
    margin: 2em 0;
}

input {
    border: none;
    border-bottom: 1px solid #333;
    padding: .5em;
    margin: 0 .5em;
}

button {
    border: none;
    background-color: #333;
    color: #F2F2F2;
    padding: .5em;
}

header h2 {
    color: #333;
}

.filter {
    display: flex;
