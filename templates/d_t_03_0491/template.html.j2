<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 19.0mm; inset-block-start: 17.4mm; inline-size: 107.1mm; block-size: 5.8mm; font-size: 16.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 30.4mm; inline-size: 85.8mm; block-size: 52.4mm; font-size: 12.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 30.4mm; inline-size: 85.9mm; block-size: 96.5mm; font-size: 12.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 83.3mm; inline-size: 87.7mm; block-size: 131.8mm; font-size: 12.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 127.6mm; inline-size: 87.6mm; block-size: 65.7mm; font-size: 12.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 193.9mm; inline-size: 85.6mm; block-size: 26.0mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 215.6mm; inline-size: 86.9mm; block-size: 30.4mm; font-size: 12.3pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 19.0mm; inset-block-start: 265.6mm; inline-size: 67.1mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_7 }}</footer>
</div></body>
</html>
