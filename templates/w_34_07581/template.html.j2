<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    height: 100%;
    font-family: var(--font-body);
}

.container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    height: 100%;
}

.hero {
    width: 100%;
    padding: 50px 0;
    text-align: center;
    background-color: #CCC;
}

.nav {
    width: 100%;
    background-color: #333;
}

.nav ul {
    padding: 0;
    list-style-type: none;
}

.nav ul li {
    display: inline;
    margin-left: 20px;
}

.nav ul li a {
    color: #FFF;
    text-decoration: none;
}

.content {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.col-left, .col-right {
    width: 50%;
    padding: 20px;
}

.col-right h3, .col-left h1 {
    color: #111;
}

.col-right p, .col-left p {
    color: #666;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="hero">{{ slot_0 }}</div>
<div class="nav">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="content">
<div class="col-left">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<div class="col-right">
<h2>{{ slot_8 }}</h2>
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</div>
</div>
</div>
</body>
</html>