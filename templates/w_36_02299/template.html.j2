<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-gap: 10px;
    padding: 10px;
}

.container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-gap: 10px;
    height: 100vh;
}

.title {
    grid-column: 1 / span 4;
    text-align: center;
}

.category-title {
    text-align: center;
    grid-column: 1 / span 4;
}

.item {
    background-color: lightblue;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<h1 class="title">{{ slot_0 }}</h1>
<div class="category-title">{{ slot_1 }}</div>
<div class="item item1">{{ slot_2 }}</div>
<div class="item item2">{{ slot_3 }}</div>
<div class="item item3">{{ slot_4 }}</div>
<div class="item item4">{{ slot_5 }}</div>
<div class="category-title">{{ slot_6 }}</div>
<div class="item item5">{{ slot_7 }}</div>
<div class="item item6">{{ slot_8 }}</div>
<div class="item item7">{{ slot_9 }}</div>
<div class="item item8">{{ slot_10 }}</div>
<div class="category-title">{{ slot_11 }}</div>
<div class="item item9">{{ slot_12 }}</div>
<div class="item item10">{{ slot_13 }}</div>
<div class="item item11">{{ slot_14 }}</div>
<div class="item item12">{{ slot_15 }}</div>
</div>
</body>
</html>