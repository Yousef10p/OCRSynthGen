<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 83.4mm; inset-block-start: 12.3mm; inline-size: 47.4mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 32.6mm; inset-block-start: 30.0mm; inline-size: 71.5mm; block-size: 7.0mm; font-size: 19.8pt"></div>
<p class="box" style="inset-inline-start: 166.2mm; inset-block-start: 28.3mm; inline-size: 37.4mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 173.5mm; inset-block-start: 35.2mm; inline-size: 31.0mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_2 }}</p>
<h1 class="box" style="inset-inline-start: 53.8mm; inset-block-start: 84.2mm; inline-size: 127.0mm; block-size: 18.4mm; font-size: 26.1pt">{{ slot_3 }}</h1>
<footer class="box" style="inset-inline-start: 45.5mm; inset-block-start: 272.8mm; inline-size: 31.5mm; block-size: 12.8mm; font-size: 12.1pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 90.8mm; inset-block-start: 272.8mm; inline-size: 29.5mm; block-size: 12.0mm; font-size: 11.3pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 133.0mm; inset-block-start: 272.8mm; inline-size: 39.0mm; block-size: 12.0mm; font-size: 11.3pt">{{ slot_6 }}</footer>
</div></body>
</html>
