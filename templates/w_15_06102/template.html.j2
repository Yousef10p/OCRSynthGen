<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


header {
    width: 100%;
    height: 300px;
    background-color: #ccc;
    position: relative;
}

.header-image {
    width: 100%;
    height: 100%;
}

.header-text {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    font-size: 24px;
    color: #fff;
}


.portfolio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(100px, auto);
    gap: 20px;
    padding: 20px;
}

.portfolio-item {
    height: 200px;
}


.testimonials {
    padding: 20px;
    text-align: center;
}


.cta {
    text-align: center;
    padding: 20px;
}


footer {
    text-align: center;
    padding: 20px;
    background-color: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="header-image">
<div class="header-text">{{ slot_0 }}</div>
</div>
</header>
<main class="portfolio">
<div class="portfolio-item" style="background-color: red;"></div>
<div class="portfolio-item" style="background-color: green;"></div>
<div class="portfolio-item" style="background-color: blue;"></div>

</main>
<section class="testimonials">
<p>{{ slot_1 }}</p>
<p>{{ slot_2 }}</p>

</section>
<section class="cta">
<button>{{ slot_3 }}</button>
</section>
<footer>
<a>{{ slot_4 }}</a> {{ slot_5 }}
        <a>{{ slot_6 }}</a> {{ slot_7 }}
        <a>{{ slot_8 }}</a> {{ slot_9 }}
        <a>{{ slot_10 }}</a> {{ slot_11 }}
        <a>{{ slot_12 }}</a> {{ slot_13 }}
        <a>{{ slot_14 }}</a>
</footer>
</body>
</html>