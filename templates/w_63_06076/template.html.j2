<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
}

.container {
    width: 80%;
    margin: 0 auto;
}

.header {
    text-align: center;
    padding: 20px 0;
    background-color: #333;
    color: #fff;
}

.menu {
    margin-top: 20px;
}

.menu li {
    display: inline-block;
    width: 30%;
    margin: 1%;
}

.menu img {
    width: 100%;
    height: 200px;
    background-color: #ddd;
}

.price-list {
    margin-top: 20px;
}

.price-list table {
    width: 100%;
}

.reservation {
    margin-top: 20px;
}

.reservation form {
    width: 50%;
    margin: 0 auto;
}

.reservation input,
.reservation button {
    display: block;
    width: 100%;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="header">
<h1>{{ slot_0 }}</h1>
</div>
<div class="menu">
<ul>
<li><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_1 }}</p></li>
<li><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_2 }}</p></li>
<li><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_3 }}</p></li>
</ul>
</div>
<div class="price-list">
<table>
<tr>
<td>{{ slot_4 }}</td>
<td>{{ slot_5 }}</td>
</tr>
<tr>
<td>{{ slot_6 }}</td>
<td>{{ slot_7 }}</td>
</tr>
<tr>
<td>{{ slot_8 }}</td>
<td>{{ slot_9 }}</td>
</tr>
</table>
</div>
<div class="reservation">
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_12 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_14 }}</span>
<button>{{ slot_15 }}</button>
</form>
</div>
</div>
</body>
</html>