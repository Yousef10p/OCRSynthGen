<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<ul>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
</ul>
</div>
<div class="main-content">
<h1>{{ slot_14 }}</h1>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<h2>{{ slot_17 }}</h2>
<p>{{ slot_18 }}</p>
</div>
</body>
</html>