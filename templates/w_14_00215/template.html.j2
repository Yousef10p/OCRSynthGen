<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

#navigation-bar {
    position: fixed;
    width: 100%;
    height: 50px;
    background-color: #f8f8f8;
    top: 0;
    right: 0;
}

#navigation-bar ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
}

#navigation-bar li {
    display: inline-block;
    margin-left: 20px;
}

#navigation-bar input {
    float: left;
    margin-top: 10px;
}

#image-carousel {
    height: 500px;
    background-color: #ddd;
}

#popular-locations {
    column-count: 3;
    column-rule: 1px solid #ddd;
    margin: 50px 0;
}

#popular-locations .destination {
    display: inline-block;
    width: 250px;
    margin: 15px;
}

#popular-locations .image {
    height: 150px;
    background-color: #ddd;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="navigation-bar">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</div>
<div class="ph"></div>
<div id="popular-locations">
<h2>{{ slot_5 }}</h2>
<div class="destination">
<h3>{{ slot_6 }}</h3>
<p>{{ slot_7 }}</p>
<div class="image">{{ slot_8 }}</div>
</div>
<div class="destination">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<div class="image">{{ slot_11 }}</div>
</div>
<div class="destination">
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<div class="image">{{ slot_14 }}</div>
</div>
</div>
</body>
</html>