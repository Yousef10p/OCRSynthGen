}
input, textarea {
    border: none;
    border-bottom: 2px solid #000;
    padding: 0.5em;
}
input[type="submit"] {
    background: #000;
    color: #fff;
    cursor: pointer;
}

article {
    margin-bottom: 2em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
