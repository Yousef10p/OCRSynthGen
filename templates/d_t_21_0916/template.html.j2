<div class="box ph" style="inset-inline-start: 5.7mm; inset-block-start: 27.2mm; inline-size: 33.8mm; block-size: 41.3mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 40.8mm; inset-block-start: 27.4mm; inline-size: 31.1mm; block-size: 41.5mm; font-size: 14.7pt"></div>
