<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 46.1mm; inset-block-start: 32.9mm; inline-size: 117.7mm; block-size: 53.1mm; font-size: 6.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 90.0mm; inline-size: 160.0mm; block-size: 18.1mm; font-size: 10.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 30.3mm; inset-block-start: 112.0mm; inline-size: 112.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 96.1mm; inset-block-start: 124.9mm; inline-size: 17.7mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 137.8mm; inline-size: 141.6mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 92.3mm; inset-block-start: 150.7mm; inline-size: 25.4mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 163.6mm; inline-size: 9.0mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 44.0mm; inset-block-start: 166.2mm; inline-size: 119.8mm; block-size: 13.8mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 185.0mm; inline-size: 78.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 30.3mm; inset-block-start: 191.1mm; inline-size: 103.5mm; block-size: 4.7mm; font-size: 8.5pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 85.3mm; inset-block-start: 202.0mm; inline-size: 39.3mm; block-size: 10.1mm; font-size: 7.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 218.6mm; inline-size: 5.7mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 76.5mm; inset-block-start: 222.7mm; inline-size: 57.0mm; block-size: 10.1mm; font-size: 7.0pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 236.9mm; inline-size: 160.0mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 103.2mm; inset-block-start: 280.1mm; inline-size: 3.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_11 }}</footer>
</div></body>
</html>
