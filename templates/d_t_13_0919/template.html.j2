<h2 class="box" style="inset-inline-start: 50.8mm; inset-block-start: 87.7mm; inline-size: 37.6mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 57.2mm; inset-block-start: 98.1mm; inline-size: 129.7mm; block-size: 36.3mm; font-size: 14.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 57.2mm; inset-block-start: 139.6mm; inline-size: 130.0mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_6 }}</p>
