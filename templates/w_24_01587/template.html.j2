</ul>
</nav>
<h1>{{ slot_3 }}</h1>
</header>
<main>
<section>
<h2>{{ slot_4 }}</h2>
<p class="service">{{ slot_5 }}</p>
<p class="service">{{ slot_6 }}</p>
<p class="service">{{ slot_7 }}</p>
</section>
<section>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</section>
<section>
<h2>{{ slot_12 }}</h2>
<div class="testimonial">{{ slot_13 }}</div>
<div class="testimonial">{{ slot_14 }}</div>
<div class="testimonial">{{ slot_15 }}</div>
</section>
</main>
</body>
</html>