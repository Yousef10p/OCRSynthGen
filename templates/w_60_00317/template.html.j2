<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #f0f0f0;
    color: #333;
}

a {
    text-decoration: none;
    color: #333;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #222;
    color: #fff;
    padding: 15px;
}

#logo {
    background-color: #fff;
    color: #222;
    padding: 10px;
}

nav ul {
    list-style: none;
    display: flex;
}

nav ul li {
    margin-left: 15px;
}

#ticker {
    background-color: #ddd;
    padding: 15px;
}

main {
    padding: 20px;
}

h1, h2 {
    color: #222;
}

#blog {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

article {
    width: calc(50% - 10px);
    margin-bottom: 20px;
    padding: 10px;
    background-color: #fff;
    color: #333;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.author-info {
    display: flex;
    align-items: center;
    margin-top: 20px;
}

.author-info img {
    background-color: #333;
    color: #fff;
    width: 50px;
    height: 50px;
    margin-left: 10px;
    display: inline-block;
    text-align: center;
    line-height: 50px;
}

.author-info p {
    margin: 0;
}


@media screen and (max-width: 768px) {
    article {
        width: 100%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
