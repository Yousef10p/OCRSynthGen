<h2 class="box" style="inset-inline-start: 140.7mm; inset-block-start: 176.2mm; inline-size: 25.8mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 148.8mm; inset-block-start: 191.1mm; inline-size: 9.6mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 135.2mm; inset-block-start: 196.1mm; inline-size: 36.8mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_4 }}</p>
