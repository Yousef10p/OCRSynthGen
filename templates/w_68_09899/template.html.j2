<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  text-align: center;
}

body {
  font-family: var(--font-body);
}

header {
  background-color: #333;
  color: white;
  padding: 1em 0;
}

nav {
  margin: 1em 0;
}

nav a {
  color: white;
  text-decoration: none;
  padding: 0 1em;
  border-left: 1px solid white;
}

nav a:last-child {
  border-left: none;
}

#hero {
  background-color: #eee;
  padding: 5em 0;
}

.cta {
  display: inline-block;
  margin: 1em 0;
  padding: 0.5em 1em;
  background-color: #333;
  color: white;
  text-decoration: none;
  border-radius: 5px;
  transition: background-color 0.3s;
}

.cta:hover {
  background-color: #555;
}

#products, #about {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 2em 0;
}

.product-card, #about {
  border: 1px solid #ddd;
  border-radius: 5px;
  padding: 2em;
  margin: 0 1em;
  max-width: 300px;
  width: 100%;
}

.product-card ul {
  text-align: right;
}

#about {
  max-width: 600px;
}

.check-credit {
  display: block;
  margin: 2em auto;
  padding: 0.5em 1em;
  background-color: #333;
  color: white;
  border: none;
  border-radius: 5px;
  transition: background-color 0.3s;
}

.check-credit:hover {
  background-color: #555;
}

.social-media a {
  margin: 0 1em;
}

footer {
  background-color: #333;
  color: white;
  padding: 2em 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
