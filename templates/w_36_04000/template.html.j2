    color: #333;
}

header {
    background-color: #222;
    padding: 20px;
}

header h1, header a {
    color: #fff;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

main section {
    margin-bottom: 40px;
}

main h2 {
    font-size: 2em;
    text-align: center;
