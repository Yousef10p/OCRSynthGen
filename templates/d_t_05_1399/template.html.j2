<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 9.5mm; inset-block-start: 6.6mm; inline-size: 70.2mm; block-size: 5.5mm; font-size: 15.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 22.8mm; inline-size: 178.5mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 42.2mm; inline-size: 176.8mm; block-size: 18.2mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 61.7mm; inline-size: 177.8mm; block-size: 30.3mm; font-size: 12.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 93.2mm; inline-size: 178.7mm; block-size: 34.4mm; font-size: 12.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 128.9mm; inline-size: 178.1mm; block-size: 46.5mm; font-size: 12.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 19.0mm; inset-block-start: 176.0mm; inline-size: 99.5mm; block-size: 6.0mm; font-size: 17.0pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 183.3mm; inline-size: 177.8mm; block-size: 30.3mm; font-size: 12.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 19.0mm; inset-block-start: 214.9mm; inline-size: 178.0mm; block-size: 50.6mm; font-size: 12.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 9.5mm; inset-block-start: 270.0mm; inline-size: 10.0mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_9 }}</footer>
</div></body>
</html>
