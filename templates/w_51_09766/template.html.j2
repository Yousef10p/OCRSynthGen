}
section {
    padding: 2rem;
    text-align: center;
}
#intro {
    background-color: #007BFF;
    color: #fff;
}
.product, .feature {
    display: inline-block;
    width: calc(25% - 2rem);
    margin: 1rem;
    padding: 1rem;
    border: 1px solid #333;
    border-radius: 5px;
    transition: transform .2s;
}

.product-image, .feature-image {
    height: 5rem;
    background-color: #ccc;
}
.product:hover, .feature:hover {
    transform: scale(1.05);
}
footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    padding: 1rem;
    background-color: #333;
    color: #fff;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
