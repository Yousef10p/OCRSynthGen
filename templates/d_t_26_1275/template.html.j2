<div class="box ph" style="inset-inline-start: 48.1mm; inset-block-start: 91.7mm; inline-size: 146.0mm; block-size: 63.6mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 156.0mm; inline-size: 73.5mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 53.3mm; inset-block-start: 165.2mm; inline-size: 132.3mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 47.3mm; inset-block-start: 176.8mm; inline-size: 146.8mm; block-size: 56.9mm; font-size: 14.7pt"></div>
