<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.0mm; inline-size: 209.8mm; block-size: 127.7mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 130.2mm; inline-size: 140.3mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 145.0mm; inline-size: 47.5mm; block-size: 20.2mm; font-size: 11.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 73.3mm; inset-block-start: 145.0mm; inline-size: 53.1mm; block-size: 61.4mm; font-size: 12.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 133.0mm; inset-block-start: 147.4mm; inline-size: 3.9mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.3mm; inset-block-start: 147.9mm; inline-size: 39.6mm; block-size: 27.3mm; font-size: 9.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 169.5mm; inline-size: 52.1mm; block-size: 48.2mm; font-size: 12.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 131.7mm; inset-block-start: 188.0mm; inline-size: 42.5mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 131.7mm; inset-block-start: 200.1mm; inline-size: 53.2mm; block-size: 52.3mm; font-size: 12.4pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 73.3mm; inset-block-start: 211.5mm; inline-size: 37.1mm; block-size: 7.4mm; font-size: 10.6pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 73.3mm; inset-block-start: 220.8mm; inline-size: 51.5mm; block-size: 57.0mm; font-size: 12.4pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 222.1mm; inline-size: 53.8mm; block-size: 21.2mm; font-size: 12.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 247.6mm; inline-size: 51.9mm; block-size: 30.2mm; font-size: 12.2pt">{{ slot_11 }}</p>
<p class="box" style="inset-inline-start: 131.7mm; inset-block-start: 256.7mm; inline-size: 52.9mm; block-size: 21.0mm; font-size: 11.9pt">{{ slot_12 }}</p>
<footer class="box" style="inset-inline-start: 8.0mm; inset-block-start: 285.2mm; inline-size: 3.3mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_13 }}</footer>
</div></body>
</html>
