<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 80.4mm; inset-block-start: 26.7mm; inline-size: 55.6mm; block-size: 3.6mm; font-size: 11.5pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 38.6mm; inline-size: 149.4mm; block-size: 11.2mm; font-size: 11.8pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 89.7mm; inset-block-start: 60.6mm; inline-size: 36.6mm; block-size: 3.8mm; font-size: 11.8pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 67.9mm; inline-size: 93.9mm; block-size: 3.8mm; font-size: 11.6pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 93.1mm; inset-block-start: 82.5mm; inline-size: 29.4mm; block-size: 3.8mm; font-size: 11.8pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 89.8mm; inline-size: 151.3mm; block-size: 33.0mm; font-size: 11.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 97.6mm; inset-block-start: 133.5mm; inline-size: 21.6mm; block-size: 3.8mm; font-size: 11.8pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 140.9mm; inline-size: 149.2mm; block-size: 47.6mm; font-size: 11.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 192.0mm; inline-size: 150.6mm; block-size: 25.7mm; font-size: 11.8pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 221.2mm; inline-size: 150.6mm; block-size: 33.0mm; font-size: 11.8pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 257.7mm; inline-size: 134.2mm; block-size: 11.0mm; font-size: 11.8pt">{{ slot_10 }}</p>
</div></body>
</html>
