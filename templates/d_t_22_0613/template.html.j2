<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 25.9mm; inline-size: 136.7mm; block-size: 58.3mm; font-size: 10.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 36.0mm; inset-block-start: 89.1mm; inline-size: 4.5mm; block-size: 4.7mm; font-size: 14.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 95.0mm; inline-size: 103.0mm; block-size: 3.3mm; font-size: 10.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 36.0mm; inset-block-start: 103.3mm; inline-size: 11.3mm; block-size: 4.7mm; font-size: 14.4pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 109.1mm; inline-size: 113.2mm; block-size: 3.3mm; font-size: 10.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 36.0mm; inset-block-start: 117.4mm; inline-size: 4.8mm; block-size: 4.7mm; font-size: 14.4pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 123.3mm; inline-size: 166.5mm; block-size: 130.3mm; font-size: 10.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 195.4mm; inset-block-start: 263.0mm; inline-size: 7.8mm; block-size: 3.3mm; font-size: 10.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
