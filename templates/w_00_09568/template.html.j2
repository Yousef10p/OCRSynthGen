<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0px;
  padding: 0px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  font-family: var(--font-body);
}

.left-column, .right-column {
  flex: 1;
  padding: 20px;
  background-color: #f0f0f0;
}

.top-banner {
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ff0000;
  color: #ffffff;
}

.top-banner h1 {
  font-size: 20px;
}

.content {
  flex: 1;
  padding: 20px;
}

.content p {
  color: #000000;
  font-size: 14px;
  line-height: 1.5;
}

.content h2 {
  font-size: 20px;
  color: #000000;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="left-column">
<h2>{{ slot_0 }}</h2>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
<h2>{{ slot_4 }}</h2>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</div>
<div class="top-banner">
<h1>{{ slot_8 }}</h1>
</div>
<div class="right-column">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</div>
<div class="content">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<p>{{ slot_17 }}</p>
</div>
</body>
</html>