<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 60.1mm; inset-block-start: 26.8mm; inline-size: 123.5mm; block-size: 28.3mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 136.1mm; inset-block-start: 64.9mm; inline-size: 53.2mm; block-size: 112.5mm; font-size: 13.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 93.0mm; inline-size: 53.5mm; block-size: 60.4mm; font-size: 13.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 78.0mm; inset-block-start: 95.5mm; inline-size: 52.8mm; block-size: 98.3mm; font-size: 13.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 159.3mm; inline-size: 53.6mm; block-size: 31.9mm; font-size: 12.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 136.1mm; inset-block-start: 183.3mm; inline-size: 52.3mm; block-size: 79.3mm; font-size: 13.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 197.2mm; inline-size: 53.4mm; block-size: 50.9mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 78.0mm; inset-block-start: 199.7mm; inline-size: 53.1mm; block-size: 65.1mm; font-size: 13.2pt">{{ slot_7 }}</p>
</div></body>
</html>
