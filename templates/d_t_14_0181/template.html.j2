<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 140.5mm; inset-block-start: 0.5mm; inline-size: 69.4mm; block-size: 36.8mm; font-size: 14.9pt"></div>
<div class="box ph" style="inset-inline-start: 12.6mm; inset-block-start: 15.6mm; inline-size: 45.9mm; block-size: 21.7mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 43.7mm; inline-size: 161.2mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 65.9mm; inline-size: 41.3mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 75.3mm; inline-size: 161.2mm; block-size: 21.4mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 101.8mm; inline-size: 161.2mm; block-size: 30.0mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 143.8mm; inline-size: 29.3mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 152.3mm; inline-size: 27.0mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 160.9mm; inline-size: 37.3mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 212.0mm; inline-size: 64.9mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_7 }}</p>
<ul class="box" style="inset-inline-start: 31.4mm; inset-block-start: 221.4mm; inline-size: 85.8mm; block-size: 4.3mm; font-size: 10.0pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.4mm; inset-block-start: 230.8mm; inline-size: 74.7mm; block-size: 4.3mm; font-size: 10.0pt"><li>{{ slot_9 }}</li></ul>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 253.6mm; inline-size: 161.0mm; block-size: 17.2mm; font-size: 8.0pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 282.3mm; inline-size: 2.4mm; block-size: 3.2mm; font-size: 8.0pt">{{ slot_11 }}</footer>
</div></body>
</html>
