<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 84.0mm; inset-block-start: 15.1mm; inline-size: 47.9mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 23.7mm; inline-size: 35.3mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 22.6mm; inset-block-start: 26.9mm; inline-size: 50.1mm; block-size: 90.3mm; font-size: 28.4pt"></div>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 31.5mm; inline-size: 108.0mm; block-size: 29.5mm; font-size: 16.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 68.0mm; inline-size: 108.0mm; block-size: 62.2mm; font-size: 17.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 133.3mm; inline-size: 108.0mm; block-size: 42.6mm; font-size: 17.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 136.2mm; inline-size: 29.4mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 23.0mm; inset-block-start: 139.6mm; inline-size: 49.1mm; block-size: 89.0mm; font-size: 36.0pt"></div>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 178.9mm; inline-size: 108.0mm; block-size: 55.6mm; font-size: 17.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 104.9mm; inset-block-start: 265.0mm; inline-size: 6.1mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_7 }}</footer>
</div></body>
</html>
