<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
    background-color: #fff;
    color: #000;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    background-color: #f1f1f1;
}

.logo {
    font-size: 20px;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    padding: 0 10px;
}

.slideshow {
    position: relative;
    height: 300px;
}

.slide {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background: blue;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 20px;
}

#slide1 {
    z-index: 1;
}

#slide2 {
    z-index: 2;
}

#slide3 {
    z-index: 3;
}

.form-wrapper {
    display: flex;
    justify-content: center;
    padding: 20px 0;
}

form {
    display: flex;
}

input {
    width: 200px;
    padding: 10px;
}

button {
    padding: 10px;
}

.info-container {
    display: flex;
    justify-content: space-around;
    margin: 20px 0;
}

.info-row {
    width: 45%;
    padding: 20px;
    background: #f1f1f1;
}

footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0;
    background: #f1f1f1;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<h2 class="logo">{{ slot_0 }}</h2>
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</nav>
</header>
<div class="slideshow">
<div class="slide" id="slide1">{{ slot_5 }}</div>
<div class="slide" id="slide2">{{ slot_6 }}</div>
<div class="slide" id="slide3">{{ slot_7 }}</div>
</div>
<div class="form-wrapper">
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_8 }}</span>
<button>{{ slot_9 }}</button>
</form>
</div>
<div class="info-container">
<div class="info-row">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
<div class="info-row">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
</div>
<footer>
<div>
<h2 class="logo">{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</div>
