    background-color: rgba(255,255,255,0.8);
}

.section {
    margin-bottom: 50px;
}

a {
    color: blue;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
