    flex-direction: column;
    align-items: center;
    background-color: #f2f2f2;
    font-family: var(--font-body);
}

header, nav, .search-bar, main {
    width: 80%;
    margin-bottom: 20px;
}

header {
    display: flex;
    justify-content: flex-end;
}

form {
    display: flex;
}

input[type="text"], input[type="password"], button {
    margin: 0 5px;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

.slider .slide {
    width: 200px;
    height: 200px;
    margin: 10px;
    background-color: lightgray;
    display: inline-block;
    text-align: center;
    line-height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
