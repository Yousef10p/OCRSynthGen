<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

#header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background-color: #f5f5f5;
}

#header h1 {
    font-size: 2em;
    color: #333;
}

#header input {
    padding: 8px;
    font-size: 1em;
    border: 1px solid #ddd;
    border-radius: 5px;
}

#navigation ul {
    list-style: none;
    display: flex;
}

#navigation ul li {
    margin-left: 15px;
}

#navigation ul li a {
    text-decoration: none;
    color: #333;
}

#popular-destinations {
    margin-top: 40px;
}

#popular-destinations h2 {
    font-size: 1.7em;
    color: #333;
    margin-bottom: 20px;
}

.destination {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
}

.destination p {
    font-size: 1.2em;
    color: #555;
    margin-left: 20px;
    width: 20%;
}

.img-placeholder {
    width: 75%;
    height: 150px;
    background-color: #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<h1>{{ slot_0 }}</h1>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</div>
<div id="navigation">
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div id="popular-destinations">
<h2>{{ slot_6 }}</h2>
<div class="destination">
<p>{{ slot_7 }}</p>
<div class="img-placeholder ph"></div>
<p>{{ slot_8 }}</p>
</div>
<div class="destination">
<p>{{ slot_9 }}</p>
<div class="img-placeholder ph"></div>
<p>{{ slot_10 }}</p>
</div>
<div class="destination">
<p>{{ slot_11 }}</p>
<div class="img-placeholder ph"></div>
<p>{{ slot_12 }}</p>
</div>
<div class="destination">
<p>{{ slot_13 }}</p>
<div class="img-placeholder ph"></div>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>