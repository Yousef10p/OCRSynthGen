<nav>
<ul>
<li><a>{{ slot_0 }}</a>
<ul><li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li></ul>
</li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div id="section-content">
<section id="section1">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<section id="subsection1">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</section>
<section id="subsection2">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
</section>
</section>
<section id="section2">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</section>
<section id="section3">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</section>
</div>
</body>
</html>