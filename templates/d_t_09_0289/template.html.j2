<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 36.3mm; inset-block-start: 45.4mm; inline-size: 122.2mm; block-size: 5.5mm; font-size: 17.2pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 60.9mm; inline-size: 137.1mm; block-size: 55.2mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 70.0mm; inset-block-start: 139.6mm; inline-size: 103.4mm; block-size: 9.6mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 71.1mm; inset-block-start: 150.9mm; inline-size: 102.3mm; block-size: 9.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 170.5mm; inline-size: 137.1mm; block-size: 24.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 42.6mm; inset-block-start: 201.1mm; inline-size: 126.9mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 84.8mm; inset-block-start: 225.4mm; inline-size: 88.7mm; block-size: 4.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 240.1mm; inline-size: 137.0mm; block-size: 14.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 103.9mm; inset-block-start: 260.9mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
