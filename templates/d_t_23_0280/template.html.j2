<p class="box" style="inset-inline-start: 35.1mm; inset-block-start: 130.1mm; inline-size: 87.9mm; block-size: 32.5mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 170.0mm; inline-size: 40.5mm; block-size: 4.1mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 181.9mm; inline-size: 78.1mm; block-size: 4.3mm; font-size: 6.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 186.3mm; inline-size: 144.3mm; block-size: 24.5mm; font-size: 8.7pt">{{ slot_7 }}</p>
