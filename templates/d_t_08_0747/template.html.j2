<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 60.1mm; inset-block-start: 42.1mm; inline-size: 100.0mm; block-size: 70.4mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 71.2mm; inset-block-start: 117.6mm; inline-size: 78.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 129.2mm; inline-size: 157.5mm; block-size: 13.1mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 71.6mm; inset-block-start: 146.8mm; inline-size: 78.2mm; block-size: 13.2mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 165.1mm; inline-size: 157.5mm; block-size: 14.1mm; font-size: 8.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 37.9mm; inset-block-start: 182.4mm; inline-size: 148.8mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 52.3mm; inset-block-start: 192.2mm; inline-size: 116.9mm; block-size: 20.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 217.7mm; inline-size: 161.2mm; block-size: 24.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 246.2mm; inline-size: 157.5mm; block-size: 6.0mm; font-size: 10.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 107.4mm; inset-block-start: 262.7mm; inline-size: 6.2mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
