    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
}

nav a {
    color: white;
    text-decoration: none;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 20px;
}

.col {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
}

.img-placeholder {
    background-color: #ddd;
