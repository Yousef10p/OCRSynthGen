}

footer {
    background-color: #f0f0f0;
    padding: 20px;
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
}

footer .blog {
    flex: 3;
}

footer .social {
    flex: 1;
    text-align: left;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
