<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 17.7mm; inset-block-start: 17.5mm; inline-size: 53.3mm; block-size: 37.0mm; font-size: 15.0pt"></div>
<div class="box ph" style="inset-inline-start: 74.8mm; inset-block-start: 17.0mm; inline-size: 53.8mm; block-size: 37.3mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 132.9mm; inset-block-start: 18.6mm; inline-size: 34.3mm; block-size: 5.7mm; font-size: 8.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 132.9mm; inset-block-start: 31.1mm; inline-size: 31.3mm; block-size: 6.3mm; font-size: 8.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 132.9mm; inset-block-start: 44.3mm; inline-size: 34.5mm; block-size: 9.8mm; font-size: 9.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 16.8mm; inset-block-start: 84.6mm; inline-size: 9.4mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 16.8mm; inset-block-start: 90.7mm; inline-size: 127.3mm; block-size: 15.7mm; font-size: 14.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 16.8mm; inset-block-start: 114.7mm; inline-size: 127.3mm; block-size: 27.7mm; font-size: 15.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.8mm; inset-block-start: 150.7mm; inline-size: 128.2mm; block-size: 21.7mm; font-size: 15.4pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 16.0mm; inset-block-start: 266.3mm; inline-size: 22.8mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 165.3mm; inset-block-start: 266.3mm; inline-size: 42.7mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_8 }}</footer>
</div></body>
</html>
