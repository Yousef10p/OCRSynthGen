<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 132.5mm; inset-block-start: 0.9mm; inline-size: 68.0mm; block-size: 43.3mm; font-size: 30.7pt"></div>
<div class="box ph" style="inset-inline-start: 100.4mm; inset-block-start: 24.2mm; inline-size: 17.3mm; block-size: 18.6mm; font-size: 13.2pt"></div>
<h1 class="box" style="inset-inline-start: 43.2mm; inset-block-start: 45.3mm; inline-size: 152.3mm; block-size: 18.3mm; font-size: 17.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 99.6mm; inset-block-start: 69.2mm; inline-size: 19.1mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 30.3mm; inset-block-start: 76.6mm; inline-size: 49.4mm; block-size: 13.4mm; font-size: 12.7pt"></div>
<div class="box ph" style="inset-inline-start: 139.8mm; inset-block-start: 75.3mm; inline-size: 47.6mm; block-size: 10.0mm; font-size: 14.1pt"></div>
<p class="box" style="inset-inline-start: 101.9mm; inset-block-start: 85.4mm; inline-size: 14.6mm; block-size: 3.2mm; font-size: 9.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 42.6mm; inset-block-start: 106.7mm; inline-size: 136.7mm; block-size: 15.8mm; font-size: 14.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 128.9mm; inline-size: 158.6mm; block-size: 81.8mm; font-size: 23.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 42.2mm; inset-block-start: 214.6mm; inline-size: 28.8mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 32.5mm; inset-block-start: 222.5mm; inline-size: 158.5mm; block-size: 21.8mm; font-size: 20.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 32.7mm; inset-block-start: 247.7mm; inline-size: 158.5mm; block-size: 22.0mm; font-size: 20.8pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 32.7mm; inset-block-start: 284.1mm; inline-size: 38.7mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
