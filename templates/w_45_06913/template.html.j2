<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}


header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 70px;
  background-color: #2980b9;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20px;
}

header > div {
  background-color: #4a4a4a;
  padding: 10px;
  font-size: 24px;
  font-weight: bold;
}

header ul {
  list-style-type: none;
  display: flex;
}

header ul li {
  margin: 0 10px;
}


#hero {
  background-color: #f39c12;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: auto;
}

#hero h1 {
  font-size: 48px;
  font-weight: bold;
  margin-bottom: 20px;
}


#features {
  background-color: #ecf0f1;
  padding: 50px 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}


#testimonials {
  background-color: #2c3e50;
  color: #ecf0f1;
  padding: 50px 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}


#pricing {
  background-color: #ecf0f1;
  padding: 50px 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.feature-box, .testimonial-box, .price-box {
  background-color: #2980b9;
  width: 100%;
  max-width: 500px;
  height: 200px;
  margin: 20px 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

footer {
  background-color: #2c3e50;
  color: #ecf0f1;
  height: 70px;
  display: flex;
  justify-content: center;
  align-items: center;
  position: fixed;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
