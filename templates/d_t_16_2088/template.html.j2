<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.4mm; inset-block-start: 15.8mm; inline-size: 86.0mm; block-size: 105.7mm; font-size: 15.0pt"></div>
<div class="box ph" style="inset-inline-start: 116.4mm; inset-block-start: 16.0mm; inline-size: 86.0mm; block-size: 114.7mm; font-size: 20.3pt"></div>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 124.0mm; inline-size: 86.6mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 133.2mm; inline-size: 87.0mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 142.8mm; inline-size: 36.5mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 148.4mm; inline-size: 17.2mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 150.9mm; inline-size: 87.0mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 153.6mm; inline-size: 86.9mm; block-size: 49.3mm; font-size: 12.7pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 178.0mm; inline-size: 36.5mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 183.2mm; inline-size: 86.9mm; block-size: 67.3mm; font-size: 12.7pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 207.8mm; inline-size: 24.9mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 213.0mm; inline-size: 86.9mm; block-size: 40.2mm; font-size: 12.7pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 192.9mm; inset-block-start: 262.8mm; inline-size: 9.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_10 }}</footer>
</div></body>
</html>
