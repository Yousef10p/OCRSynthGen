<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 109.4mm; inset-block-start: 10.2mm; inline-size: 20.1mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 18.2mm; inset-block-start: 18.4mm; inline-size: 20.1mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 18.2mm; inset-block-start: 27.1mm; inline-size: 90.7mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 18.2mm; inset-block-start: 35.4mm; inline-size: 39.1mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.2mm; inset-block-start: 39.5mm; inline-size: 52.4mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.2mm; inset-block-start: 43.6mm; inline-size: 58.3mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.2mm; inset-block-start: 47.7mm; inline-size: 50.6mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 18.2mm; inset-block-start: 51.8mm; inline-size: 60.9mm; block-size: 3.2mm; font-size: 9.0pt"><li>{{ slot_7 }}</li></ul>
</div></body>
</html>
