  margin-left: 10px;
}

header ul li a {
  color: white;
  text-decoration: none;
}

section {
  padding: 20px;
  background: #f4f4f4;
  margin: 5px;
  border: #333 solid 1px;
}

footer {
  background: #333;
  color: white;
  text-align: center;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
