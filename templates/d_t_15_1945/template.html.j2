<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 15.2mm; inline-size: 50.7mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 103.4mm; inset-block-start: 16.2mm; inline-size: 86.8mm; block-size: 83.3mm; font-size: 8.4pt"></div>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 21.7mm; inline-size: 22.7mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 26.8mm; inline-size: 86.5mm; block-size: 44.8mm; font-size: 12.7pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 13.7mm; inset-block-start: 78.6mm; inline-size: 86.6mm; block-size: 83.3mm; font-size: 8.7pt"></div>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 102.2mm; inline-size: 86.5mm; block-size: 8.2mm; font-size: 7.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 112.6mm; inline-size: 86.5mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 135.0mm; inline-size: 29.2mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 140.6mm; inline-size: 86.5mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 164.6mm; inline-size: 86.5mm; block-size: 8.2mm; font-size: 7.7pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 15.3mm; inset-block-start: 174.5mm; inline-size: 173.2mm; block-size: 75.4mm; font-size: 9.3pt"></div>
<p class="box" style="inset-inline-start: 13.4mm; inset-block-start: 252.3mm; inline-size: 140.6mm; block-size: 6.1mm; font-size: 8.6pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 7.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
