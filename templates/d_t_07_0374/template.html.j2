<h2 class="box" style="inset-inline-start: 83.3mm; inset-block-start: 188.9mm; inline-size: 32.5mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 141.7mm; inset-block-start: 188.9mm; inline-size: 11.2mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 29.9mm; inset-block-start: 193.5mm; inline-size: 45.6mm; block-size: 52.7mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 88.3mm; inset-block-start: 193.5mm; inline-size: 46.1mm; block-size: 36.1mm; font-size: 11.4pt">{{ slot_5 }}</p>
