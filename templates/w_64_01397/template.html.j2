  width: 100%;
  max-width: 1000px;
  display: inline-block;
}

nav ul {
  list-style: none;
  padding: 0;
  text-align: center;
}

nav ul li {
  display: inline;
  margin: 0 10px;
}

form input[type="text"] {
  padding: 10px;
}

#content {
  display: flex;
  margin-top: 20px;
}

#main {
  width: 70%;
  padding: 20px;
}

.post .image {
  background-color: #bbb;
  width: 100px;
  height: 100px;
}

#sidebar {
