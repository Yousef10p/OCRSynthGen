<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	font-family: var(--font-body);
}

.left-column {
	float: right;
	width: 20%;
	background-color: #f0f0f0;
	padding: 10px;
}

.main-column {
	float: right;
	width: 60%;
	padding: 10px;
}

.right-column {
	float: left;
	width: 20%;
	background-color: #f0f0f0;
	padding: 10px;
}

.product {
	margin-bottom: 20px;
}

.banner {
	margin-bottom: 20px;
}

.product img, .banner img {
	width: 200px;
	height: 200px;
	background-color: #ff0000; 
}


.clearfix::after {
  content: "";
  display: table;
  clear: both;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="left-column">
<h2>{{ slot_0 }}</h2>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="main-column">
<div class="banner ph"></div>
<div class="product">
<h3>{{ slot_5 }}</h3>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_6 }}</p>
</div>
<div class="product">
<h3>{{ slot_7 }}</h3>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_8 }}</p>
</div>
<div class="product">
<h3>{{ slot_9 }}</h3>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_10 }}</p>
</div>
</div>
<div class="right-column">
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>