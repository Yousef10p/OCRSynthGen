body {
    font-family: var(--font-body);
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
}

nav {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
}

nav input {
    flex-grow: 1;
    margin-left: 10px;
}

main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

section {
    display: flex;
    flex-direction: column;
}

article {
    background-color: lightgrey;
    padding: 20px;
    margin-bottom: 20px;
}

h1, p {
    margin: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
