<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.0mm; inset-block-start: 90.4mm; inline-size: 14.5mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 73.3mm; inset-block-start: 90.0mm; inline-size: 53.2mm; block-size: 47.9mm; font-size: 13.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 131.7mm; inset-block-start: 90.0mm; inline-size: 54.1mm; block-size: 51.1mm; font-size: 13.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 96.1mm; inline-size: 50.5mm; block-size: 42.7mm; font-size: 13.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 73.3mm; inset-block-start: 142.8mm; inline-size: 53.7mm; block-size: 48.0mm; font-size: 13.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 15.0mm; inset-block-start: 144.3mm; inline-size: 38.0mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 131.7mm; inset-block-start: 145.8mm; inline-size: 52.5mm; block-size: 31.9mm; font-size: 12.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 150.3mm; inline-size: 53.2mm; block-size: 27.7mm; font-size: 13.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 182.7mm; inline-size: 52.8mm; block-size: 8.1mm; font-size: 11.4pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 8.0mm; inset-block-start: 285.2mm; inline-size: 3.3mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
