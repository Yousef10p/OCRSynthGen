<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	background-color: #f0f0f0;
	margin: 0;
	padding: 0;
	font-family: var(--font-body);
}

.menu-bar {
	background-color: #333;
	color: #fff;
	padding: 10px 0;
}

.menu-bar ul {
	margin: 0;
	padding: 0;
	list-style: none;
}

.menu-bar li {
	display: block;
	position: relative;
	float: right;
	width: 20%;
	background: #252525;
}

.menu-bar li a {
	display: block;
	text-decoration: none;
	color: #fff;
	border-left: 1px solid #333;
	padding: 15px;
}

.menu-bar li ul { 
	display: none;
	position: absolute;
	background: #444;
}

.menu-bar li:hover ul {
	display: block;
}

.menu-bar li ul li {
	width: 200px;
}
	
.slideshow-container {
	max-width: 1000px;
	position: relative;
	margin: auto;
}
	
.mySlides {
	display: none;
	width: 100%;
	height: 400px;
	background-color: #aaa; 
}

.text {
	color: #fff; 
	position: absolute;
	bottom: 0;
	padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu-bar">
<ul>
<li><a>{{ slot_0 }}</a>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</li>
<li><a>{{ slot_4 }}</a>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</li>
<li><a>{{ slot_8 }}</a>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
</li>
</ul>
</div>
<div class="slideshow-container">
<div class="mySlides">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div> 
<p class="text">{{ slot_12 }}</p>
</div>
<div class="mySlides">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div> 
<p class="text">{{ slot_13 }}</p>
</div>
<div class="mySlides">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div> 
<p class="text">{{ slot_14 }}</p>
</div>

</div>
</body>
</html>