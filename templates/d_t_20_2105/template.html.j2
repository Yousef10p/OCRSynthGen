<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 38.0mm; inline-size: 167.9mm; block-size: 21.9mm; font-size: 22.1pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 68.2mm; inline-size: 169.5mm; block-size: 79.0mm; font-size: 22.1pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 155.5mm; inline-size: 169.7mm; block-size: 54.5mm; font-size: 22.1pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 218.3mm; inline-size: 170.7mm; block-size: 13.7mm; font-size: 22.1pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 240.3mm; inline-size: 164.3mm; block-size: 13.7mm; font-size: 22.1pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 35.3mm; inset-block-start: 256.3mm; inline-size: 52.4mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 133.0mm; inset-block-start: 269.8mm; inline-size: 58.3mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_6 }}</footer>
</div></body>
</html>
