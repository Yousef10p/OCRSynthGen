<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 50.7mm; inset-block-start: 7.0mm; inline-size: 46.7mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 36.4mm; inset-block-start: 16.8mm; inline-size: 95.0mm; block-size: 15.2mm; font-size: 10.8pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 23.9mm; inset-block-start: 36.0mm; inline-size: 72.4mm; block-size: 3.7mm; font-size: 10.6pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 30.1mm; inset-block-start: 43.6mm; inline-size: 102.5mm; block-size: 22.9mm; font-size: 10.8pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 23.9mm; inset-block-start: 70.4mm; inline-size: 41.2mm; block-size: 3.7mm; font-size: 10.6pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 30.1mm; inset-block-start: 78.1mm; inline-size: 101.7mm; block-size: 26.7mm; font-size: 10.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 108.5mm; inline-size: 56.9mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 116.7mm; inline-size: 107.9mm; block-size: 30.6mm; font-size: 10.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 151.2mm; inline-size: 108.1mm; block-size: 38.2mm; font-size: 10.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 68.5mm; inset-block-start: 196.7mm; inline-size: 4.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
