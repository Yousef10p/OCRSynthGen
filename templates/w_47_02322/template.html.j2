<a>{{ slot_5 }}</a> {{ slot_6 }}
<a>{{ slot_7 }}</a> {{ slot_8 }}
<a>{{ slot_9 }}</a> {{ slot_10 }}
<a>{{ slot_11 }}</a>
</nav>
<section>
<div class="book-shelf">
<div class="book"><p>{{ slot_12 }}</p></div>
<div class="book"><p>{{ slot_13 }}</p></div>
<div class="book"><p>{{ slot_14 }}</p></div>
<div class="book"><p>{{ slot_15 }}</p></div>
</div>
</section>
</body>
</html>