<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.2mm; inset-block-start: 16.3mm; inline-size: 51.0mm; block-size: 13.2mm; font-size: 37.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 31.3mm; inline-size: 157.7mm; block-size: 7.2mm; font-size: 10.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 42.2mm; inline-size: 166.9mm; block-size: 11.0mm; font-size: 10.4pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 4.9mm; inset-block-start: 48.5mm; inline-size: 2.1mm; block-size: 17.4mm; font-size: 24.6pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 20.2mm; inset-block-start: 56.8mm; inline-size: 174.4mm; block-size: 11.0mm; font-size: 10.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 98.7mm; inline-size: 216.0mm; block-size: 108.4mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 11.8mm; inset-block-start: 211.8mm; inline-size: 38.5mm; block-size: 19.8mm; font-size: 11.2pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 59.0mm; inset-block-start: 212.1mm; inline-size: 42.2mm; block-size: 17.1mm; font-size: 16.2pt"></div>
<div class="box ph" style="inset-inline-start: 106.3mm; inset-block-start: 212.2mm; inline-size: 41.9mm; block-size: 17.0mm; font-size: 16.0pt"></div>
<div class="box ph" style="inset-inline-start: 11.8mm; inset-block-start: 234.2mm; inline-size: 42.4mm; block-size: 17.2mm; font-size: 16.2pt"></div>
<div class="box ph" style="inset-inline-start: 59.0mm; inset-block-start: 234.2mm; inline-size: 42.2mm; block-size: 16.9mm; font-size: 16.0pt"></div>
<div class="box ph" style="inset-inline-start: 106.4mm; inset-block-start: 234.2mm; inline-size: 42.1mm; block-size: 16.9mm; font-size: 16.0pt"></div>
<div class="box ph" style="inset-inline-start: 153.6mm; inset-block-start: 234.1mm; inline-size: 41.8mm; block-size: 17.3mm; font-size: 16.3pt"></div>
</div></body>
</html>
