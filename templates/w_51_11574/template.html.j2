<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

h1, h2 {
    text-align: center;
    margin: 20px 0;
}

#slideshow {
    position: relative;
    height: 400px;
}

.slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity .5s ease-in-out;
}

#product-categories {
    margin: 50px 0;
}

ul {
    list-style-type: none;
    display: flex;
    justify-content: space-around;
}

footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    background-color: #f8f8f8;
    padding: 10px 0;
    text-align: center;
    font-size: 0.8em;
}

footer a {
    color: inherit;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
</header>
<section id="slideshow">
<div class="slide" style="background:red;"></div>
<div class="slide" style="background:green;"></div>
<div class="slide" style="background:blue;"></div>
</section>
<section id="product-categories">
<h2>{{ slot_1 }}</h2>
<ul>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</section>
<footer>
<p>{{ slot_6 }} <a>{{ slot_7 }}</a></p>
<p>{{ slot_8 }} <a>{{ slot_9 }}</a> {{ slot_10 }} <a>{{ slot_11 }}</a> {{ slot_12 }} <a>{{ slot_13 }}</a></p>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>