<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 28.6mm; inset-block-start: 17.1mm; inline-size: 24.8mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 117.1mm; inset-block-start: 17.7mm; inline-size: 88.4mm; block-size: 9.7mm; font-size: 9.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 22.7mm; inline-size: 86.8mm; block-size: 97.8mm; font-size: 9.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 118.5mm; inset-block-start: 29.2mm; inline-size: 89.2mm; block-size: 48.5mm; font-size: 9.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 117.1mm; inset-block-start: 78.4mm; inline-size: 95.0mm; block-size: 111.3mm; font-size: 9.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 122.0mm; inline-size: 86.3mm; block-size: 69.4mm; font-size: 9.8pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 112.8mm; inset-block-start: 253.1mm; inline-size: 2.4mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_6 }}</footer>
</div></body>
</html>
