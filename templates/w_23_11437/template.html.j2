</div>
<div class="col col-1">
<h2>{{ slot_7 }}</h2>
<div class="col-img ph"></div>
<p>{{ slot_8 }}</p>
</div>
<div class="col col-2">
<h2>{{ slot_9 }}</h2>
<div class="col-img ph"></div>
<p>{{ slot_10 }}</p>
</div>
</main>
<nav class="bottom-nav">
