<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 172.7mm; inset-block-start: 11.8mm; inline-size: 38.7mm; block-size: 37.9mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 42.3mm; inset-block-start: 34.6mm; inline-size: 128.0mm; block-size: 11.9mm; font-size: 16.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 104.9mm; inset-block-start: 81.0mm; inline-size: 67.6mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 152.3mm; inset-block-start: 89.8mm; inline-size: 17.8mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 168.7mm; inset-block-start: 166.4mm; inline-size: 20.2mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 198.7mm; inset-block-start: 169.4mm; inline-size: 5.1mm; block-size: 83.9mm; font-size: 40.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 168.9mm; inset-block-start: 175.2mm; inline-size: 20.2mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 23.3mm; inset-block-start: 253.2mm; inline-size: 111.8mm; block-size: 14.5mm; font-size: 13.7pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 201.7mm; inset-block-start: 265.6mm; inline-size: 3.0mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_7 }}</footer>
</div></body>
</html>
