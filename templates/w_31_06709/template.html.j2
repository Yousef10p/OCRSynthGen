}
header h1 {
    margin: 0;
    font-size: 3em;
}
#hero-button {
    background-color: #006600;
    color: #fff;
    border: none;
    padding: 10px 20px;
    font-size: 1.2em;
    cursor: pointer;
}
main {
    max-width: 960px;
    margin: 0 auto;
}
section {
    margin: 20px 0;
    padding: 20px;
    background-color: #fff;
    box-shadow: 0 0 10px rgba(0,0,0,.1);
}
#service-1, #service-2, #service-3 {
    background-color: #006600;
    color: #fff;
    padding: 20px;
    margin: 20px 0;
