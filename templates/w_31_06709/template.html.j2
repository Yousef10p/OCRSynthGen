}
form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}
input, textarea {
    grid-column: span 2;
    padding: 10px;
    border: 1px solid #ccc;
}
input[type="submit"] {
    background-color: #006600;
    color: #fff;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
