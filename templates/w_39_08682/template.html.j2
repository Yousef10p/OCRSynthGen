    text-decoration: none;
}
body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    color: #444;
    background-color: #f0f0f0;
}
header {
    background-color: #222;
    color: #fff;
    padding: 15px;
    width: 100%;
}
nav a {
    color: #fff;
    margin-left: 10px;
}
main {
    margin: 20px 0;
    max-width: 600px;
    text-align: center;
}
main h1, main h2 {
    margin-bottom: 15px;
}
section {
    margin-bottom: 25px;
}
footer {
    background-color: #222;
    color: #fff;
    padding: 10px;
    position: fixed;
    bottom: 0;
    width: 100%;
}


.chart {
    background: #ccc;
    height: 150px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
