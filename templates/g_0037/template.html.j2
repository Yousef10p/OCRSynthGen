<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.4; --align: start; --page-width: 210mm; --page-height: 148mm; --page-margin: 21mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<main style="display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 8mm"><div>
<p style="margin-block: 0 1em; text-indent: 0; text-align: justify; font-size: 1.05em">{{ slot_0 }}</p>
<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 61mm; margin-inline: auto; inline-size: 100%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_1 }}</figcaption></figure><figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 58mm; margin-inline: auto; inline-size: 50%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_2 }}</figcaption></figure><aside style="border: 1px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><h4>{{ slot_3 }}</h4>
<p style="margin-block: 0.2em">{{ slot_4 }}</p>
<p style="margin-block: 0.2em">{{ slot_5 }}</p></aside>
</div>
<div>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 0.6em 0.4em">{{ slot_6 }}</h2>
<h3 style="font-size: calc(var(--base-size) * 1.15); text-align: start; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_7 }}</h3>
<p style="margin-block: 0 0.4em; text-indent: 1.5em; text-align: justify; font-size: 1.05em">{{ slot_8 }}</p>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: justify; font-size: 1.05em">{{ slot_9 }}</p>
</div>
<div style="border-block-start: 1px solid #000; margin-block-start: 1.2em; padding-block-start: 0.4em; font-size: 0.8em">
<p style="margin-block: 0.15em">{{ slot_10 }}</p>
<p style="margin-block: 0.15em">{{ slot_11 }}</p>
<p style="margin-block: 0.15em">{{ slot_12 }}</p>
</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_13 }}</span></footer>
</div></body>
</html>
