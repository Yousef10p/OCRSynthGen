  text-align: center;
  padding: 1em;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  padding: 0 1em;
}

.banner {
  background-color: #ffe6cc;
  padding: 2em;
}

.banner h1 {
  font-size: 2em;
  margin: 0;
}

.banner p {
