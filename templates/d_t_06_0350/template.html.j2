<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 23.2mm; inset-block-start: 34.6mm; inline-size: 50.6mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 23.0mm; inset-block-start: 41.0mm; inline-size: 135.4mm; block-size: 121.2mm; font-size: 21.5pt"></div>
<h2 class="box" style="inset-inline-start: 23.1mm; inset-block-start: 178.5mm; inline-size: 27.7mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 23.0mm; inset-block-start: 184.8mm; inline-size: 135.2mm; block-size: 72.6mm; font-size: 20.6pt"></div>
<header class="box" style="inset-inline-start: 204.5mm; inset-block-start: 224.5mm; inline-size: 4.2mm; block-size: 41.8mm; font-size: 40.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 162.0mm; inset-block-start: 252.9mm; inline-size: 28.1mm; block-size: 5.0mm; font-size: 7.0pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 137.2mm; inset-block-start: 269.3mm; inline-size: 20.9mm; block-size: 5.7mm; font-size: 8.1pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 187.5mm; inset-block-start: 268.7mm; inline-size: 5.3mm; block-size: 5.8mm; font-size: 16.5pt">{{ slot_5 }}</footer>
</div></body>
</html>
