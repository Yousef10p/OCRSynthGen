<div class="box ph" style="inset-inline-start: 110.6mm; inset-block-start: 160.9mm; inline-size: 86.1mm; block-size: 57.1mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 163.7mm; inline-size: 20.8mm; block-size: 3.3mm; font-size: 5.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 52.0mm; inset-block-start: 163.6mm; inline-size: 23.5mm; block-size: 3.3mm; font-size: 5.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 18.9mm; inset-block-start: 170.3mm; inline-size: 22.9mm; block-size: 35.5mm; font-size: 25.2pt"></div>
