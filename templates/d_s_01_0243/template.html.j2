<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 29.0mm; inset-block-start: 15.4mm; inline-size: 47.3mm; block-size: 19.4mm; font-size: 13.8pt"></div>
<header class="box" style="inset-inline-start: 127.5mm; inset-block-start: 35.0mm; inline-size: 66.6mm; block-size: 3.6mm; font-size: 9.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 46.7mm; inline-size: 170.6mm; block-size: 13.3mm; font-size: 11.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 28.1mm; inset-block-start: 68.6mm; inline-size: 78.7mm; block-size: 6.3mm; font-size: 16.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 76.0mm; inline-size: 159.5mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 80.9mm; inset-block-start: 80.5mm; inline-size: 66.0mm; block-size: 27.1mm; font-size: 11.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 112.1mm; inline-size: 168.0mm; block-size: 31.1mm; font-size: 11.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 148.3mm; inline-size: 158.1mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 27.9mm; inset-block-start: 279.3mm; inline-size: 11.3mm; block-size: 7.8mm; font-size: 22.0pt"></div>
<footer class="box" style="inset-inline-start: 93.0mm; inset-block-start: 283.2mm; inline-size: 34.9mm; block-size: 3.6mm; font-size: 9.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 175.9mm; inset-block-start: 283.2mm; inline-size: 20.1mm; block-size: 3.6mm; font-size: 9.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
