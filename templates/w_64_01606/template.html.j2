  height: 70px;
  line-height: 70px;
  text-align: center;
  background-color: lightblue;
}

.navbar {
  background-color: lightgray;
  overflow: hidden;
}

.navbar a {
  float: right;
  display: block;
  color: black;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}

.sidebar {
  float: left;
  width: 30%;
