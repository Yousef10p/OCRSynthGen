}

.content {
  width: 70%;
  padding: 20px;
}

.investment-option, .loans, .insurance-product {
  width: 100%;
  height: 200px;
  line-height: 200px;
  text-align: center;
  margin-bottom: 10px;
  background-color: lightblue;
}

.content form {
  margin-bottom: 30px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
