<p>{{ slot_6 }}</p>
</article>
<section>
<div>
<div class="square"></div>
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</div>
<div>
<div class="square"></div>
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
</div>
<div>
<div class="square"></div>
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
</div>
<div>
<div class="square"></div>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</div>
</section>
</main>
</body>
</html>