<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 27.4mm; inset-block-start: 18.1mm; inline-size: 32.6mm; block-size: 6.1mm; font-size: 17.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 71.4mm; inset-block-start: 19.7mm; inline-size: 23.4mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 105.7mm; inset-block-start: 19.7mm; inline-size: 24.6mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_2 }}</header><header class="box" style="inset-inline-start: 150.8mm; inset-block-start: 19.0mm; inline-size: 35.6mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_3 }}</header><div class="box ph" style="inset-inline-start: 55.7mm; inset-block-start: 46.3mm; inline-size: 101.6mm; block-size: 75.0mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 96.5mm; inset-block-start: 131.6mm; inline-size: 25.0mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 57.5mm; inset-block-start: 166.3mm; inline-size: 99.6mm; block-size: 74.4mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 97.5mm; inset-block-start: 251.3mm; inline-size: 24.0mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_5 }}</p>
</div></body>
</html>
