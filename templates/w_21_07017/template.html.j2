}

section {
  margin-bottom: 40px;
}

footer {
  width: 100%;
  padding: 20px;
  background: #000;
  color: #fff;
  text-align: center;
  position: fixed;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
