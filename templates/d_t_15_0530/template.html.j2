<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 9.3mm; inset-block-start: 1.3mm; inline-size: 59.4mm; block-size: 2.0mm; font-size: 5.8pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 64.8mm; inset-block-start: 22.9mm; inline-size: 5.2mm; block-size: 7.0mm; font-size: 19.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 112.3mm; inset-block-start: 22.8mm; inline-size: 25.6mm; block-size: 7.2mm; font-size: 10.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 29.1mm; inset-block-start: 36.1mm; inline-size: 45.7mm; block-size: 72.8mm; font-size: 11.5pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 146.6mm; inset-block-start: 35.2mm; inline-size: 7.8mm; block-size: 7.0mm; font-size: 19.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 112.3mm; inset-block-start: 48.4mm; inline-size: 55.4mm; block-size: 40.0mm; font-size: 11.3pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 147.7mm; inset-block-start: 93.1mm; inline-size: 5.6mm; block-size: 7.0mm; font-size: 19.9pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 112.3mm; inset-block-start: 105.9mm; inline-size: 45.3mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 185.1mm; inset-block-start: 252.7mm; inline-size: 3.6mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
