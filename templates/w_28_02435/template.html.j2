<p>{{ slot_6 }}</p>
<div class="genre">{{ slot_7 }}</div>
<div class="genre">{{ slot_8 }}</div>
<div class="genre">{{ slot_9 }}</div>
</section>
<section>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<div class="playlist">{{ slot_12 }}</div>
<div class="playlist">{{ slot_13 }}</div>
<div class="playlist">{{ slot_14 }}</div>
</section>
</main>
<footer>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>