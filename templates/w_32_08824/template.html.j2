}

.grid-container {
    display: grid;
    grid-template-columns: auto auto auto;
    padding: 10px;
}

.grid-item {
    border: 1px solid #333;
    padding: 20px;
    font-size: 15px;
    text-align: center;
    margin: 10px;
}

.item-image {
    background-color: lightgray;
