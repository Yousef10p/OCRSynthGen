<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 84.1mm; inline-size: 83.5mm; block-size: 17.7mm; font-size: 12.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 114.2mm; inset-block-start: 86.4mm; inline-size: 83.9mm; block-size: 40.5mm; font-size: 12.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 106.9mm; inline-size: 84.0mm; block-size: 36.0mm; font-size: 12.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 114.0mm; inset-block-start: 132.0mm; inline-size: 84.1mm; block-size: 81.5mm; font-size: 12.8pt">{{ slot_7 }}</p>
