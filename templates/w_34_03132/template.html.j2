    grid-template-columns: 1fr 1fr 1fr;
}

header, footer {
    background-color: #ffc125;
    text-align: center;
}

nav {
    display: flex;
    justify-content: space-around;
    padding: 1em 0;
}

nav a {
    text-decoration: none;
    font-weight: bold;
    color: #2e3047;
}

.hero-article, .breaking-news article {
    background-color: #88a2d2;
    color: #2e3047;
    padding: 1em;
    margin: 1em;
}

aside {
    background-color: #2e3047;
    color: #88a2d2;
    padding: 1em;
    grid-column: 2/span 2;
}

aside form {
    display: flex;
    flex-direction: column;
}

aside input,
aside button {
    margin-bottom: 1em;
    padding: 0.5em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
