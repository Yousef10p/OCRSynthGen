    padding: 0;
    font-family: var(--font-body);
}
nav {
    position: sticky;
    top: 0;
    background-color: #333;
    color: #fff;
    padding: 10px 0;
}
nav ul {
    display: flex;
    list-style: none;
    justify-content: space-around;
}
nav a {
    color: #fff;
    text-decoration: none;
}
header, section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 50px 0;
    text-align: center;
}
section {
    border-bottom: 1px solid #ccc;
}
form {
    display: flex;
    flex-direction: column;
    width: 300px;
    margin-top: 20px;
}
input, textarea {
    margin-bottom: 10px;
    padding: 10px;
}
footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px 0;
}
footer a {
    color: #fff;
    margin: 0 10px;
    text-decoration: none;
}


header:before {
    content: "";
    display: block;
    width: 100%;
    height: 200px;
    background-color: #0f0;
}
section:before {
    content: "";
    display: block;
    width: 320px;
    height: 200px;
    background-color: #00f;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
