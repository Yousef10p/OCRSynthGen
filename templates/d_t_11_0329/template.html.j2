<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 39.1mm; inset-block-start: 26.0mm; inline-size: 137.0mm; block-size: 11.1mm; font-size: 12.0pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 66.7mm; inset-block-start: 44.5mm; inline-size: 81.8mm; block-size: 4.2mm; font-size: 10.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 57.0mm; inset-block-start: 53.6mm; inline-size: 101.3mm; block-size: 10.6mm; font-size: 9.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 56.9mm; inset-block-start: 67.9mm; inline-size: 101.4mm; block-size: 10.6mm; font-size: 10.9pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 74.5mm; inline-size: 6.3mm; block-size: 124.8mm; font-size: 20.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 39.5mm; inset-block-start: 82.3mm; inline-size: 136.3mm; block-size: 3.4mm; font-size: 8.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 87.2mm; inset-block-start: 88.8mm; inline-size: 40.9mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 99.8mm; inset-block-start: 97.4mm; inline-size: 15.7mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 104.3mm; inline-size: 164.5mm; block-size: 41.1mm; font-size: 10.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 151.9mm; inline-size: 64.2mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 104.8mm; inset-block-start: 267.2mm; inline-size: 1.9mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_10 }}</footer>
</div></body>
</html>
