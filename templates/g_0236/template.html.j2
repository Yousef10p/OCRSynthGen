<figure style="margin-block: 0.8em; margin-inline: 0; break-inside: avoid"><div class="ph" style="block-size: 51mm; margin-inline: auto; inline-size: 50%"></div>
<figcaption style="font-size: 0.85em; text-align: center; margin-block-start: 0.3em">{{ slot_20 }}</figcaption></figure><h3 style="font-size: calc(var(--base-size) * 1.3); text-align: start; margin-block: 1em 0.4em">{{ slot_21 }}</h3>
</div></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_22 }}</span><span>{{ slot_23 }}</span><span>{{ slot_24 }}</span></footer>
</div></body>
</html>
