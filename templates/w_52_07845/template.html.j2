  margin: 0;
  padding: 0;
}

header {
  background-color: #006b3c;
  color: white;
  padding: 1rem;
  position: sticky;
  top: 0;
}

nav ul {
  display: flex;
  justify-content: space-around;
  align-items: center;
  list-style: none;
}

nav li {
  position: relative;
}

nav li ul {
  position: absolute;
  top: 100%;
  right: 0;
  width: 200px;
  display: none;
}

nav li:hover ul {
  display: block;
}

footer {
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  background-color: #f2f2f2;
  padding: 1rem;
}

footer div {
  width: 30%;
  height: 200px;
  border: 1px solid #ccc;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  align-items: flex-start;
}

#rectangle1 { background-color: #FF9933; }
#rectangle2 { background-color: #6699FF; }
#rectangle3 { background-color: #FF6666; }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
