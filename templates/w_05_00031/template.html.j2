body {
    display: flex;
    flex-direction: column;
    align-items: center;
}

header, footer {
    width: 100%;
    background: #f8f9fa;
    text-align: center;
    padding: 20px;
}

.logo {
    margin: 20px 0;
}

.products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 20px;
    width: 80%;
}

.product {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f8f9fa;
    padding: 20px;
}

.product-image {
    width: 100px;
    height: 100px;
    background: #dee2e6;
    margin-bottom: 10px;
}

footer {
    margin-top: auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
