    width: 100%;
    height: 100%;
    object-fit: cover;
}

nav {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    background-color: rgba(0,0,0, 0.5);
    padding: 20px 0;
}

nav ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
}

nav ul li {
    position: relative;
}

nav ul li ul {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    width: 100%;
    background-color: rgba(0,0,0, 0.5);
}

nav ul li:hover ul {
    display: flex;
    flex-direction: column;
}

#services, #products {
    padding: 50px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
