<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 141.3mm; inset-block-start: 4.1mm; inline-size: 137.7mm; block-size: 7.8mm; font-size: 8.0pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 28.4mm; inset-block-start: 24.9mm; inline-size: 119.3mm; block-size: 119.1mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 174.1mm; inset-block-start: 25.1mm; inline-size: 102.8mm; block-size: 103.8mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 80.2mm; inset-block-start: 146.4mm; inline-size: 15.4mm; block-size: 6.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 216.6mm; inset-block-start: 146.4mm; inline-size: 16.5mm; block-size: 6.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<footer class="box" style="inset-inline-start: 141.1mm; inset-block-start: 200.7mm; inline-size: 21.8mm; block-size: 4.5mm; font-size: 8.0pt">{{ slot_3 }}</footer>
</div></body>
</html>
