<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

.container {
    width: 80%;
    margin: auto;
}

.header {
    background-color: #f4f4f4;
    padding: 20px;
    text-align: center;
}

.nav-bar {
    background-color: #333;
    color: #fff;
    padding: 20px;
}

.nav-bar ul {
    list-style-type: none;
    padding: 0;
}

.nav-bar li {
    display: inline;
    margin-left: 10px;
}

.main-content {
    padding: 20px;
}

.pricing {
    list-style-type: none;
    padding: 0;
}

.pricing li {
    background-color: #f4f4f4;
    display: inline-block;
    width: 20%;
    margin: 10px;
    padding: 20px;
    text-align: center;
}

.cta {
    background-color: #333;
    color: #fff;
    padding: 10px;
    text-decoration: none;
}

.footer {
    background-color: #f4f4f4;
    padding: 20px;
    text-align: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="header">
<h1>{{ slot_0 }}</h1>
</div>
<div class="nav-bar">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="main-content">
<p>{{ slot_4 }}</p>
<div class="image ph"></div>
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
<h2>{{ slot_10 }}</h2>
<ul class="pricing">
<li><h3>{{ slot_11 }}</h3><p>{{ slot_12 }}</p><a class="cta">{{ slot_13 }}</a></li>
<li><h3>{{ slot_14 }}</h3><p>{{ slot_15 }}</p><a class="cta">{{ slot_16 }}</a></li>
<li><h3>{{ slot_17 }}</h3><p>{{ slot_18 }}</p><a class="cta">{{ slot_19 }}</a></li>
</ul>
</div>
<div class="footer">
<p>{{ slot_20 }}</p>
</div>
</div>
</body>
</html>