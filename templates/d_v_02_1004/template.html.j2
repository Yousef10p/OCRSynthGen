<p class="box" style="inset-inline-start: 23.3mm; inset-block-start: 60.6mm; inline-size: 155.8mm; block-size: 37.9mm; font-size: 21.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 101.1mm; inline-size: 156.0mm; block-size: 29.3mm; font-size: 20.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 23.3mm; inset-block-start: 133.3mm; inline-size: 156.0mm; block-size: 53.8mm; font-size: 21.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 23.3mm; inset-block-start: 190.0mm; inline-size: 155.8mm; block-size: 29.6mm; font-size: 21.0pt">{{ slot_7 }}</p>
