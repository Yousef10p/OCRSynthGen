<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #333;
    padding: 10px 0;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 10px;
}

main {
    margin-top: 50px;
    padding: 20px;
}

section {
    display: grid;
    grid-template-columns: 70% 30%;
}

aside {
    padding-right: 20px;
}

h2, h3 {
    text-transform: uppercase;
}

div.category, div.offer, div.review {
    margin: 10px 0;
}

img {
    width: 100%;
    height: 300px;
    background: #ddd;
    border: 1px solid #333;
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</nav>
</header>
<main>
<section>
<article>
<h2>{{ slot_4 }}</h2>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_5 }}</p>
</article>
<aside>
<h3>{{ slot_6 }}</h3>
<div class="category">{{ slot_7 }}</div>
<div class="category">{{ slot_8 }}</div>
<div class="category">{{ slot_9 }}</div>
<div class="category">{{ slot_10 }}</div>
<h3>{{ slot_11 }}</h3>
<div class="offer">{{ slot_12 }}</div>
<h3>{{ slot_13 }}</h3>
<div class="review">{{ slot_14 }}</div>
</aside>
</section>
</main>
</body>
</html>