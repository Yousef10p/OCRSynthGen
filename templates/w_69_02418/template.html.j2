<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-family: var(--font-body);
}

header {
  width: 100%;
  background: #f8f8f8;
  padding: 20px 0;
  display: flex;
  justify-content: center;
}

nav ul {
  list-style: none;
  display: flex;
  padding: 0;
}

nav ul li {
  margin: 0 20px;
}

main {
  width: 100%;
  display: flex;
  justify-content: space-around;
}

aside {
  width: 100%;
  background: #f8f8f8;
  padding: 20px 0;
  margin-top: 20px;
  display: flex;
  justify-content: center;
}


@media (max-width: 600px) {
  main {
    flex-direction: column;
    align-items: center;
  }
  
  main, aside {
    width: 90%;
  }
}
.hidden-mobile {
  display: none;
}

@media (max-width: 600px) {
  aside {
    display: none;
  }
  .hidden-mobile {
    display: block;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</header>
<main>
<section>
<h4>{{ slot_3 }}</h4>
<div class="item">{{ slot_4 }}</div>
<div class="item">{{ slot_5 }}</div>
<div class="item">{{ slot_6 }}</div>

</section>
<section>
<h4>{{ slot_7 }}</h4>
<div class="deal">{{ slot_8 }}</div>
<div class="deal">{{ slot_9 }}</div>
<div class="deal">{{ slot_10 }}</div>

</section>
</main>
<aside>
<h4>{{ slot_11 }}</h4>
<nav>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</nav>
</aside>
</body>
</html>