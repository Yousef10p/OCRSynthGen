</div>
</div>
<div id="main">
<h1>{{ slot_6 }}</h1>
<div id="offer_image">{{ slot_7 }}</div>
<h2>{{ slot_8 }}</h2>
<div class="item" id="popular1">{{ slot_9 }}</div>
