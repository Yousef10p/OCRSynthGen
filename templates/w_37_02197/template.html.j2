}


header nav ul li {
    display: inline;
    margin: 5px 15px;
}


.image-section {
    display: flex;
    justify-content: space-around;
    width: 100%;
}

.image-box {
    width: 200px;
    height: 200px;
    background-color: grey;
}

p {
    text-align: center;
}


.footer-box {
    display: flex;
    flex-direction: column;
    margin: 15px;
    min-width: 100px;
}

.footer-box a {
    text-align: right;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
