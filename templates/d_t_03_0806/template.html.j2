<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.5mm; inset-block-start: 38.5mm; inline-size: 172.9mm; block-size: 28.1mm; font-size: 39.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 100.7mm; inline-size: 120.3mm; block-size: 23.1mm; font-size: 16.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 134.2mm; inline-size: 117.1mm; block-size: 56.7mm; font-size: 17.8pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 13.3mm; inset-block-start: 198.1mm; inline-size: 2.7mm; block-size: 59.5mm; font-size: 40.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 95.4mm; inset-block-start: 198.1mm; inline-size: 73.7mm; block-size: 5.0mm; font-size: 7.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 51.2mm; inset-block-start: 222.6mm; inline-size: 121.0mm; block-size: 26.0mm; font-size: 24.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 51.2mm; inset-block-start: 254.8mm; inline-size: 72.8mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 10.7mm; inset-block-start: 262.4mm; inline-size: 7.5mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_7 }}</footer>
</div></body>
</html>
