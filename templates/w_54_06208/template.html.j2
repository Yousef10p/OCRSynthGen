body {
    font-size: 16px;
    font-family: var(--font-body);
}


nav {
    background-color: #333;
    padding: 1em 0;
    margin-bottom: 1em;
}
nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
}
nav ul li {
    display: inline-block;
    margin-left: 1em;
}
nav ul li:last-child {
    margin-left: 0;
}
nav ul li a {
    color: #fff;
    text-decoration: none;
}
nav ul li a:hover {
    text-decoration: underline;
}


.hero {
    background-color: #eee;
    padding: 2em 0;
}
.hero h1 {
    color: #333;
    font-size: 2em;
}
.hero p {
    color: #666;
}
.button {
    display: inline-block;
    padding: 0.5em 1em;
    background-color: #333;
    color: #fff;
    text-decoration: none;
}


.about-us {
    background-color: #1a1a1a;
    color: #fff;
    padding: 2em 0;
}


.services {
    background-color: #f4f4f4;
    padding: 2em 0;
}
.service {
    margin-bottom: 1em;
}
.service:last-child {
    margin-bottom: 0;
}
.service h3 {
    color: #333;
}


.portfolio {
    background-color: #1a1a1a;
    color: #fff;
    padding: 2em 0;
}
.project {
    margin-bottom: 2em;
}
.project:last-child {
    margin-bottom: 0;
}
.project h3 {
    color: #fff;
}
.image {
    background-color: #888;
    height: 200px;
    width: 100%;
}


.contact-us {
    background-color: #333;
    color: #fff;
    padding: 2em 0;
}
.contact-us label {
    display: block;
    color: #fff;
}
.contact-us input,
.contact-us textarea {
    display: block;
    width: 100%;
    margin-bottom: 1em;
}
.contact-us button {
    padding: 0.5em 1em;
    background-color: #eee;
    color: #333;
    border: none;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
