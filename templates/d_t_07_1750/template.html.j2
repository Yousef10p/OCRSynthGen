<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 21.4mm; inline-size: 81.9mm; block-size: 6.2mm; font-size: 17.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 28.3mm; inline-size: 84.9mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 49.4mm; inline-size: 23.3mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 54.6mm; inline-size: 170.9mm; block-size: 12.1mm; font-size: 11.4pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 72.8mm; inline-size: 57.2mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 77.7mm; inline-size: 170.9mm; block-size: 16.3mm; font-size: 11.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 98.9mm; inline-size: 170.9mm; block-size: 16.3mm; font-size: 11.6pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 119.9mm; inline-size: 20.6mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 124.8mm; inline-size: 91.5mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 4.5mm; inset-block-start: 287.1mm; inline-size: 4.0mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_9 }}</footer><footer class="box" style="inset-inline-start: 20.0mm; inset-block-start: 288.6mm; inline-size: 52.0mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_10 }}</footer>
</div></body>
</html>
