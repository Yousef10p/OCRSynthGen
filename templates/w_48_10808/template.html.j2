}

.service {
    width: 30%;
    text-align: center;
}

.service-image {
    height: 200px;
    width: 200px;
    background-color: #ccc;
    margin-bottom: 1rem;
}

.privacy {
    background-color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 0;
}

.privacy h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.privacy .privacy-images {
    display: flex;
    justify-content: space-around;
    width: 100%;
}

.privacy .privacy-image {
    height: 200px;
    width: 30%;
    background-color: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
