    padding: 0;
    color: #333;
}

nav {
    background-color: #333;
    color: #fff;
    display: flex;
    justify-content: space-around;
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: space-around;
    width: 100%;
}

nav ul li a {
    text-decoration: none;
    color: #fff;
}

