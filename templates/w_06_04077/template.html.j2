<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-body);
}

header {
    width: 100%;
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 20px 0;
}

nav ul {
    list-style-type: none;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

.square {
    min-height: 200px;
    min-width: 200px;
    border: 2px solid #000;
    margin: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ccc;
}

footer {
    width: 100%;
    background-color: #333;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0;
}

footer form {
    margin-bottom: 20px;
}

footer a {
    color: #fff;
    margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</header>
<main>
<div class="square investment">{{ slot_6 }}</div>
<div class="square finance">{{ slot_7 }}</div>
<div class="square loans">{{ slot_8 }}</div>
<div class="square cards">{{ slot_9 }}</div>
</main>
<footer>
<form>
<label>{{ slot_10 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<button>{{ slot_12 }}</button>
</form>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</footer>
</body>
</html>