<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 77.2mm; inset-block-start: 13.5mm; inline-size: 37.1mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 165.4mm; inset-block-start: 13.5mm; inline-size: 13.3mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_1 }}</header><ul class="box" style="inset-inline-start: 12.7mm; inset-block-start: 21.4mm; inline-size: 165.7mm; block-size: 11.4mm; font-size: 10.7pt"><li>{{ slot_2 }}</li></ul>
<div class="box ph" style="inset-inline-start: 36.4mm; inset-block-start: 41.3mm; inline-size: 107.7mm; block-size: 144.3mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 90.3mm; inset-block-start: 212.0mm; inline-size: 9.8mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 45.7mm; inset-block-start: 224.7mm; inline-size: 104.3mm; block-size: 11.4mm; font-size: 10.7pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 12.7mm; inset-block-start: 265.9mm; inline-size: 16.8mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 95.9mm; inset-block-start: 265.9mm; inline-size: 18.8mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_6 }}</footer>
</div></body>
</html>
