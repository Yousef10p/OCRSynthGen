<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 111.0mm; inline-size: 141.6mm; block-size: 18.5mm; font-size: 17.5pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 34.2mm; inset-block-start: 140.9mm; inline-size: 63.2mm; block-size: 6.1mm; font-size: 17.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 152.6mm; inline-size: 142.3mm; block-size: 24.9mm; font-size: 17.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 178.3mm; inline-size: 142.1mm; block-size: 37.6mm; font-size: 17.7pt">{{ slot_6 }}</p>
