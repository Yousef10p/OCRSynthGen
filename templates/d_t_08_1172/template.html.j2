<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 24.2mm; inset-block-start: 52.0mm; inline-size: 161.6mm; block-size: 21.0mm; font-size: 20.7pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 77.4mm; inset-block-start: 83.9mm; inline-size: 55.1mm; block-size: 5.3mm; font-size: 10.0pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 94.6mm; inline-size: 6.3mm; block-size: 120.5mm; font-size: 20.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 65.6mm; inset-block-start: 94.4mm; inline-size: 78.7mm; block-size: 5.0mm; font-size: 10.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 58.7mm; inset-block-start: 104.9mm; inline-size: 92.6mm; block-size: 15.5mm; font-size: 10.9pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 96.5mm; inset-block-start: 133.1mm; inline-size: 16.9mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 30.3mm; inset-block-start: 142.5mm; inline-size: 149.4mm; block-size: 43.0mm; font-size: 10.9pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 199.6mm; inline-size: 47.0mm; block-size: 5.4mm; font-size: 17.2pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 213.5mm; inline-size: 170.0mm; block-size: 54.4mm; font-size: 12.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 104.0mm; inset-block-start: 274.6mm; inline-size: 2.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
