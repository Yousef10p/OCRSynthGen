<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.3mm; inset-block-start: 30.1mm; inline-size: 31.7mm; block-size: 31.0mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 65.0mm; inset-block-start: 31.1mm; inline-size: 113.2mm; block-size: 11.4mm; font-size: 16.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 65.0mm; inset-block-start: 57.1mm; inline-size: 45.9mm; block-size: 6.3mm; font-size: 17.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 80.6mm; inset-block-start: 67.2mm; inline-size: 50.3mm; block-size: 7.3mm; font-size: 20.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 78.1mm; inset-block-start: 78.0mm; inline-size: 55.1mm; block-size: 7.3mm; font-size: 20.8pt">{{ slot_3 }}</p>
<h1 class="box" style="inset-inline-start: 27.1mm; inset-block-start: 99.3mm; inline-size: 157.7mm; block-size: 23.6mm; font-size: 33.4pt">{{ slot_4 }}</h1>
<h1 class="box" style="inset-inline-start: 59.6mm; inset-block-start: 127.3mm; inline-size: 94.0mm; block-size: 9.2mm; font-size: 26.2pt">{{ slot_5 }}</h1>
<h1 class="box" style="inset-inline-start: 49.4mm; inset-block-start: 150.4mm; inline-size: 111.2mm; block-size: 12.6mm; font-size: 35.6pt">{{ slot_6 }}</h1>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 278.6mm; inline-size: 2.4mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
