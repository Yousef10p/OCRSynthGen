</ul>
</nav>
<div class="header">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<div class="main">
<div class="mission">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<button>{{ slot_6 }}</button>
</div>
<div class="programs">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<button>{{ slot_9 }}</button>
</div>
</div>
<div class="donate">
