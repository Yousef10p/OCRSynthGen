.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: #FFF;
}

header ul {
    display: flex;
    justify-content: space-around;
    list-style-type: none;
}

section {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

section h2 {
    font-size: 2em;
}

.bubble {
    width: 200px;
    height: 200px;
    border-radius: 50%;
