<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 72.6mm; inset-block-start: 22.9mm; inline-size: 69.1mm; block-size: 40.8mm; font-size: 9.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 70.2mm; inline-size: 164.7mm; block-size: 16.2mm; font-size: 10.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 93.4mm; inline-size: 164.4mm; block-size: 11.0mm; font-size: 10.9pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 30.7mm; inset-block-start: 115.1mm; inline-size: 69.4mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 126.8mm; inline-size: 164.5mm; block-size: 25.4mm; font-size: 10.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 45.5mm; inset-block-start: 157.6mm; inline-size: 144.4mm; block-size: 3.8mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 167.0mm; inline-size: 164.5mm; block-size: 39.7mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 100.8mm; inset-block-start: 212.1mm; inline-size: 89.0mm; block-size: 3.8mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 63.7mm; inset-block-start: 218.3mm; inline-size: 126.2mm; block-size: 9.1mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 73.2mm; inset-block-start: 227.6mm; inline-size: 116.6mm; block-size: 9.8mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 98.7mm; inset-block-start: 239.9mm; inline-size: 91.2mm; block-size: 3.8mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 249.3mm; inline-size: 164.5mm; block-size: 11.0mm; font-size: 10.9pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 104.8mm; inset-block-start: 266.9mm; inline-size: 1.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
