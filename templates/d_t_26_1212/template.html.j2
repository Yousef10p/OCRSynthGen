<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 25.4mm; inline-size: 159.0mm; block-size: 12.0mm; font-size: 11.3pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 24.6mm; inset-block-start: 42.0mm; inline-size: 162.5mm; block-size: 71.8mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 114.1mm; inline-size: 83.0mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 126.0mm; inline-size: 38.1mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 134.8mm; inline-size: 112.9mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 142.8mm; inline-size: 70.7mm; block-size: 8.0mm; font-size: 11.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 154.8mm; inline-size: 83.3mm; block-size: 8.0mm; font-size: 11.3pt"><li>{{ slot_5 }}</li></ul>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 263.1mm; inline-size: 94.0mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 187.0mm; inset-block-start: 263.1mm; inline-size: 3.5mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
