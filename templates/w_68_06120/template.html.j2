<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background-color: #f2f2f2;
  color: #333;
}

a {
  text-decoration: none;
  color: #333;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1em;
  background-color: #007bff;
  color: #fff;
}

.logo {
  width: 100px;
  height: 50px;
  background-color: #007bff;
  margin-left: auto;
}

nav ul {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0;
}

nav li {
  margin: 0 1em;
}

.hero {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
  background-color: #eee;
  background-image: none; 
}

.hero-content {
  text-align: center;
}

.hero-content h1 {
  font-size: 2em;
  margin-bottom: 1em;
}

.cta {
  font-size: 1.2em;
  padding: 0.5em 1em;
  background-color: #007bff;
  color: #fff;
  border: none;
  cursor: pointer;
}

.sign-up-form {
  display: flex;
  flex-direction: column;
  max-width: 400px;
  margin: 2em auto;
  padding: 2em;
  background-color: #fff;
  border-radius: 10px;
  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
}

.sign-up-form label {
  margin-bottom: 0.5em;
}

.sign-up-form input,
.sign-up-form select {
  margin-bottom: 1em;
  padding: 0.5em;
  border: 1px solid #ddd;
  border-radius: 5px;
}

.sign-up-form input[type="submit"] {
  background-color: #007bff;
  color: #fff;
  cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo ph"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</header>
<section class="hero">
<div class="hero-content">
<h1>{{ slot_3 }}</h1>
<button class="cta">{{ slot_4 }}</button>
</div>
</section>
<form class="sign-up-form">
<label>{{ slot_5 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_6 }}</span>
<label>{{ slot_7 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_8 }}</span>
<label>{{ slot_9 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
<label>{{ slot_11 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_12 }}</span>
<span class="">{{ slot_13 }}</span>
</form>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>