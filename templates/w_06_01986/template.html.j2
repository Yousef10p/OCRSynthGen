}

.logo {
    color: #333;
    font-size: 24px;
}

.nav {
    list-style: none;
    padding: 0;
}

.nav li {
    display: inline;
    margin: 0 10px;
}

.slide {
    width: 100%;
    height: 500px;
    background-color: #f8f8f8;
    text-align: center;
    padding: 50px 0;
}

.slide-content {
    max-width: 600px;
    margin: 0 auto;
}

.full-width-product-images {
