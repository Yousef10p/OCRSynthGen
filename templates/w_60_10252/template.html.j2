    height: 100vh;
    font-family: var(--font-body);
    color: #333;
}
header, nav, main, footer {
    padding: 20px;
}
header {
    background-color: #e0e0e0;
}
nav {
    background-color: #f8f8f8;
    width: 20%;
    position: fixed;
    top: 0;
    bottom: 0;
}
main {
    background-color: #fff;
    margin-right: 20%;
