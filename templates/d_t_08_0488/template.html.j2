<div class="box ph" style="inset-inline-start: 55.3mm; inset-block-start: 96.1mm; inline-size: 92.5mm; block-size: 13.3mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 113.1mm; inline-size: 29.2mm; block-size: 6.7mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 31.2mm; inset-block-start: 122.7mm; inline-size: 140.7mm; block-size: 13.1mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 138.9mm; inline-size: 111.3mm; block-size: 7.7mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 145.9mm; inline-size: 159.2mm; block-size: 11.2mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 164.2mm; inline-size: 159.2mm; block-size: 13.0mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 181.1mm; inline-size: 124.8mm; block-size: 4.2mm; font-size: 10.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 70.8mm; inset-block-start: 192.0mm; inline-size: 68.4mm; block-size: 11.1mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 206.9mm; inline-size: 159.2mm; block-size: 18.2mm; font-size: 10.0pt">{{ slot_7 }}</p>
