<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 14.6mm; inset-block-start: 67.8mm; inline-size: 18.2mm; block-size: 5.6mm; font-size: 15.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 84.2mm; inset-block-start: 67.4mm; inline-size: 14.4mm; block-size: 5.5mm; font-size: 15.7pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 143.3mm; inset-block-start: 76.6mm; inline-size: 64.9mm; block-size: 98.4mm; font-size: 16.4pt"></div>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 79.1mm; inline-size: 57.2mm; block-size: 4.9mm; font-size: 6.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 93.0mm; inset-block-start: 79.3mm; inline-size: 34.0mm; block-size: 2.8mm; font-size: 8.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 74.3mm; inset-block-start: 81.8mm; inline-size: 65.6mm; block-size: 134.2mm; font-size: 25.4pt"></div>
<p class="box" style="inset-inline-start: 4.3mm; inset-block-start: 84.4mm; inline-size: 62.0mm; block-size: 5.0mm; font-size: 7.1pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 212.4mm; inset-block-start: 213.7mm; inline-size: 3.0mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_5 }}</footer><p class="box" style="inset-inline-start: 1.1mm; inset-block-start: 274.9mm; inline-size: 74.4mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_6 }}</p>
</div></body>
</html>
