<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    background-color: orange;
    padding: 20px;
    align-items: center;
}
  
nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin-left: 10px;
}

form input {
    padding: 10px;
    border-radius: 5px;
    border: none;
}

.property-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    padding: 20px;
}

.property {
    padding: 20px;
    border: 1px solid lightgray;
    border-radius: 5px;
}

.property-image {
    width: 100%;
    height: 200px;
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</form>
</header>
<main>
<div class="property-grid">
<div class="property">
<div class="property-image" style="background-color: orange;">{{ slot_5 }}</div>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div class="property">
<div class="property-image" style="background-color: blue;">{{ slot_8 }}</div>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
<div class="property">
<div class="property-image" style="background-color: orange;">{{ slot_11 }}</div>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
<div class="property">
<div class="property-image" style="background-color: blue;">{{ slot_14 }}</div>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
</div>
</main>
</body>
</html>