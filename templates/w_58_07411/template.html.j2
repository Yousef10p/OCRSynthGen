<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body{
    font-family: var(--font-body);
}
header{
    background-color: #f8f8f8;
    padding: 20px;
}
nav ul{
    list-style-type: none;
}
nav ul li{
    display: inline;
    margin-left: 10px;
}
#slider{
    width: 100%;
    height: 200px;
    background-color: #ddd;
}
.slide{
    width: 100%;
    height: 200px;
    line-height: 200px;
    text-align: center;
    color: white;
}
.slide:nth-child(2){
    background-color: #aaa;
}
.slide:nth-child(3){
    background-color: #888;
}
.branch{
    margin-bottom: 20px;
    color: black;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<div id="slider">
<div class="slide"><p>{{ slot_4 }}</p></div>
<div class="slide"><p>{{ slot_5 }}</p></div>
<div class="slide"><p>{{ slot_6 }}</p></div>
</div>
<h2 id="branch1">{{ slot_7 }}</h2>
<div class="branch"><p>{{ slot_8 }}</p></div>
<h2 id="branch2">{{ slot_9 }}</h2>
<div class="branch"><p>{{ slot_10 }}</p></div>
<h2 id="branch3">{{ slot_11 }}</h2>
<div class="branch"><p>{{ slot_12 }}</p></div>
<h2 id="branch4">{{ slot_13 }}</h2>
<div class="branch"><p>{{ slot_14 }}</p></div>
</body>
</html>