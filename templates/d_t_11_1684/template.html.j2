<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 79.6mm; inset-block-start: 24.9mm; inline-size: 56.2mm; block-size: 56.7mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 89.4mm; inline-size: 164.5mm; block-size: 19.1mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.8mm; inline-size: 164.5mm; block-size: 48.5mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 64.3mm; inset-block-start: 165.3mm; inline-size: 86.7mm; block-size: 10.8mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 179.3mm; inline-size: 40.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 90.9mm; inset-block-start: 187.1mm; inline-size: 33.4mm; block-size: 4.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 209.7mm; inline-size: 164.5mm; block-size: 26.4mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 66.7mm; inset-block-start: 240.6mm; inline-size: 81.9mm; block-size: 10.5mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 103.5mm; inset-block-start: 266.7mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</footer>
</div></body>
</html>
