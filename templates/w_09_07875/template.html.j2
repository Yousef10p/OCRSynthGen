    top: 0;
    width: 100%;
    background-color: #f8f9fa;
    padding: 10px 0;
}

#navbar ul {
    list-style-type: none;
    text-align: center;
    padding: 0;
}

#navbar li {
    display: inline;
    margin: 0 10px;
}


#left-column {
    float: right;
    width: 20%;
