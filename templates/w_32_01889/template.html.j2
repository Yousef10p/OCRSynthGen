}

aside form input[type="text"], aside form input[type="submit"] {
    padding: 10px;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    background: rgba(0, 0, 0, 0.5);
    padding: 20px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
