<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 86.5mm; inset-block-start: 17.8mm; inline-size: 31.6mm; block-size: 8.3mm; font-size: 23.5pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 39.8mm; inset-block-start: 29.8mm; inline-size: 123.5mm; block-size: 106.5mm; font-size: 27.5pt"></div>
<div class="box ph" style="inset-inline-start: 39.4mm; inset-block-start: 155.0mm; inline-size: 123.9mm; block-size: 82.0mm; font-size: 13.7pt"></div>
<h2 class="box" style="inset-inline-start: 64.8mm; inset-block-start: 244.3mm; inline-size: 74.1mm; block-size: 3.5mm; font-size: 5.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 247.4mm; inline-size: 169.3mm; block-size: 3.3mm; font-size: 5.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 252.0mm; inline-size: 166.4mm; block-size: 4.8mm; font-size: 5.0pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 7.6mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 148.9mm; inset-block-start: 262.6mm; inline-size: 40.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_5 }}</footer>
</div></body>
</html>
