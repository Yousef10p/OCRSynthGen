<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: #333;
    background: #f2f2f2;
}


header {
    position: fixed;
    top: 0;
    width: 100%;
    background: #fff;
    box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.1);
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: flex-end;
}

nav li {
    margin-left: 15px;
}


section {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    scroll-snap-align: start;
    padding: 100px;
}


.parallax {
    background: none no-repeat center;
    background-size: cover;
}


#equipment {
    background: #f4f4f4;
}

.equipment-images, .class-cards, .plan-cards, .instructor-cards {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
}

.tile, .card {
    width: 100px;
    height: 100px; 
    margin: 10px; 
    background: grey;
}


#signup {
    background: #eb192e;
    color: #fff;
}

form {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 20px;
}

input, button {
    margin: 10px;
    padding: 10px;
}

button {
    background: #fb6811;
    color: #fff;
    border: none;
    cursor: pointer;
}


h2 {
    font-size: 2.5em;
    font-weight: 700;
    margin-bottom: 5px;
}

p {
    font-weight: 200;
    font-size: 1.2em;
    text-align: center;
}

footer {
    text-align: center;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
