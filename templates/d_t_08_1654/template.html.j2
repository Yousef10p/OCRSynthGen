<div class="box ph" style="inset-inline-start: 68.6mm; inset-block-start: 128.1mm; inline-size: 78.1mm; block-size: 8.4mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 39.1mm; inset-block-start: 144.6mm; inline-size: 36.4mm; block-size: 7.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 45.3mm; inset-block-start: 151.9mm; inline-size: 107.0mm; block-size: 8.3mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 45.3mm; inset-block-start: 161.5mm; inline-size: 24.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 81.6mm; inset-block-start: 175.8mm; inline-size: 51.4mm; block-size: 8.3mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 83.0mm; inset-block-start: 182.3mm; inline-size: 93.2mm; block-size: 13.2mm; font-size: 12.0pt"></div>
