<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.0mm; inline-size: 101.6mm; block-size: 107.3mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 103.0mm; inset-block-start: 17.5mm; inline-size: 75.8mm; block-size: 105.5mm; font-size: 40.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 27.2mm; inset-block-start: 109.5mm; inline-size: 43.5mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 104.8mm; inset-block-start: 136.7mm; inline-size: 33.8mm; block-size: 7.0mm; font-size: 19.7pt">{{ slot_2 }}</h2>
<header class="box" style="inset-inline-start: 204.4mm; inset-block-start: 138.3mm; inline-size: 5.7mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_3 }}</header><h2 class="box" style="inset-inline-start: 96.9mm; inset-block-start: 152.0mm; inline-size: 50.4mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_4 }}</h2>
<header class="box" style="inset-inline-start: 207.3mm; inset-block-start: 152.6mm; inline-size: 2.9mm; block-size: 27.4mm; font-size: 40.0pt">{{ slot_5 }}</header><p class="box" style="inset-inline-start: 102.3mm; inset-block-start: 158.2mm; inline-size: 88.6mm; block-size: 37.8mm; font-size: 13.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 102.3mm; inset-block-start: 202.6mm; inline-size: 88.6mm; block-size: 32.9mm; font-size: 13.3pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 97.3mm; inset-block-start: 242.0mm; inline-size: 45.9mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 102.3mm; inset-block-start: 247.1mm; inline-size: 88.6mm; block-size: 23.0mm; font-size: 13.0pt">{{ slot_9 }}</p>
</div></body>
</html>
