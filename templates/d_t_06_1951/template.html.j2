<h2 class="box" style="inset-inline-start: 146.8mm; inset-block-start: 57.2mm; inline-size: 34.3mm; block-size: 3.1mm; font-size: 5.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 13.8mm; inset-block-start: 60.5mm; inline-size: 57.4mm; block-size: 55.5mm; font-size: 9.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 81.1mm; inset-block-start: 60.5mm; inline-size: 55.0mm; block-size: 55.5mm; font-size: 9.2pt">{{ slot_6 }}</p>
