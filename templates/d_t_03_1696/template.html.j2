<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 21.2mm; inset-block-start: 14.9mm; inline-size: 134.0mm; block-size: 5.7mm; font-size: 16.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 29.1mm; inline-size: 150.2mm; block-size: 77.4mm; font-size: 36.6pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 56.8mm; inset-block-start: 120.4mm; inline-size: 100.9mm; block-size: 7.1mm; font-size: 6.7pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 131.3mm; inline-size: 84.3mm; block-size: 30.7mm; font-size: 12.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 131.3mm; inline-size: 42.9mm; block-size: 7.7mm; font-size: 7.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 140.4mm; inline-size: 84.5mm; block-size: 39.8mm; font-size: 11.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 163.4mm; inline-size: 84.7mm; block-size: 39.8mm; font-size: 12.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 181.7mm; inline-size: 84.2mm; block-size: 76.5mm; font-size: 12.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 21.2mm; inset-block-start: 204.6mm; inline-size: 84.9mm; block-size: 53.6mm; font-size: 12.7pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 136.4mm; inset-block-start: 268.1mm; inline-size: 58.3mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_9 }}</footer>
</div></body>
</html>
