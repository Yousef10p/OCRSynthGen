<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 65.6mm; inset-block-start: 30.0mm; inline-size: 107.2mm; block-size: 7.7mm; font-size: 21.8pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 19.3mm; inset-block-start: 30.2mm; inline-size: 38.7mm; block-size: 50.2mm; font-size: 15.8pt"></div>
<p class="box" style="inset-inline-start: 65.6mm; inset-block-start: 47.3mm; inline-size: 110.7mm; block-size: 19.0mm; font-size: 17.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 65.6mm; inset-block-start: 79.8mm; inline-size: 115.3mm; block-size: 29.0mm; font-size: 16.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 65.6mm; inset-block-start: 116.8mm; inline-size: 117.8mm; block-size: 35.1mm; font-size: 16.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 65.6mm; inset-block-start: 160.1mm; inline-size: 120.3mm; block-size: 35.1mm; font-size: 16.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 65.6mm; inset-block-start: 203.3mm; inline-size: 120.4mm; block-size: 22.8mm; font-size: 16.1pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 65.9mm; inset-block-start: 248.1mm; inline-size: 16.7mm; block-size: 13.6mm; font-size: 12.8pt"></div>
<p class="box" style="inset-inline-start: 86.0mm; inset-block-start: 246.4mm; inline-size: 96.5mm; block-size: 18.8mm; font-size: 13.3pt">{{ slot_6 }}</p>
</div></body>
</html>
