<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 12.6mm; inset-block-start: 19.5mm; inline-size: 46.4mm; block-size: 8.1mm; font-size: 9.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 30.6mm; inline-size: 86.4mm; block-size: 9.7mm; font-size: 11.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 105.8mm; inset-block-start: 30.3mm; inline-size: 88.5mm; block-size: 99.4mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 12.1mm; inset-block-start: 40.5mm; inline-size: 89.1mm; block-size: 34.4mm; font-size: 11.8pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 45.1mm; inset-block-start: 89.6mm; inline-size: 23.2mm; block-size: 14.3mm; font-size: 11.8pt"></div>
<p class="box" style="inset-inline-start: 12.1mm; inset-block-start: 109.0mm; inline-size: 88.6mm; block-size: 49.2mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 105.8mm; inset-block-start: 130.1mm; inline-size: 86.8mm; block-size: 44.2mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 12.0mm; inset-block-start: 158.4mm; inline-size: 89.3mm; block-size: 59.0mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 105.8mm; inset-block-start: 174.7mm; inline-size: 88.0mm; block-size: 87.0mm; font-size: 11.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 12.0mm; inset-block-start: 217.8mm; inline-size: 89.1mm; block-size: 28.6mm; font-size: 11.8pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 11.8mm; inset-block-start: 246.7mm; inline-size: 88.6mm; block-size: 15.3mm; font-size: 11.8pt">{{ slot_9 }}</p>
</div></body>
</html>
