<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.2mm; inset-block-start: 17.5mm; inline-size: 26.8mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 150.3mm; inset-block-start: 17.5mm; inline-size: 39.5mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 22.7mm; inset-block-start: 28.3mm; inline-size: 155.9mm; block-size: 28.5mm; font-size: 20.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.6mm; inset-block-start: 60.2mm; inline-size: 155.9mm; block-size: 69.7mm; font-size: 22.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.5mm; inset-block-start: 133.1mm; inline-size: 155.8mm; block-size: 29.2mm; font-size: 20.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 165.6mm; inline-size: 130.6mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 173.7mm; inline-size: 156.0mm; block-size: 29.2mm; font-size: 20.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 206.0mm; inline-size: 157.8mm; block-size: 39.1mm; font-size: 22.2pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 31.3mm; inset-block-start: 246.8mm; inline-size: 119.6mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 21.9mm; inset-block-start: 255.1mm; inline-size: 155.8mm; block-size: 13.1mm; font-size: 18.6pt">{{ slot_9 }}</p>
</div></body>
</html>
