<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 17.9mm; inset-block-start: 11.1mm; inline-size: 21.5mm; block-size: 17.6mm; font-size: 16.6pt"></div>
<h2 class="box" style="inset-inline-start: 66.3mm; inset-block-start: 29.8mm; inline-size: 25.9mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 40.5mm; inline-size: 85.3mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 44.5mm; inline-size: 38.9mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 50.2mm; inline-size: 128.0mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 59.7mm; inline-size: 15.2mm; block-size: 8.7mm; font-size: 12.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 79.9mm; inline-size: 48.4mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 84.9mm; inline-size: 109.3mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 93.6mm; inline-size: 140.9mm; block-size: 5.2mm; font-size: 7.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 103.9mm; inline-size: 136.6mm; block-size: 13.2mm; font-size: 7.5pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 119.0mm; inline-size: 132.1mm; block-size: 6.7mm; font-size: 9.5pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 129.1mm; inline-size: 105.0mm; block-size: 5.2mm; font-size: 7.4pt">{{ slot_10 }}</p>
<div class="box ph" style="inset-inline-start: 17.7mm; inset-block-start: 137.1mm; inline-size: 123.1mm; block-size: 105.7mm; font-size: 16.6pt"></div>
<footer class="box" style="inset-inline-start: 98.5mm; inset-block-start: 286.7mm; inline-size: 12.7mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_11 }}</footer>
</div></body>
</html>
