<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 36.5mm; inline-size: 134.9mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 61.8mm; inline-size: 135.0mm; block-size: 54.8mm; font-size: 12.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 43.4mm; inset-block-start: 130.4mm; inline-size: 81.9mm; block-size: 5.5mm; font-size: 17.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 142.9mm; inline-size: 135.0mm; block-size: 30.8mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 49.7mm; inset-block-start: 177.9mm; inline-size: 52.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 85.8mm; inset-block-start: 192.5mm; inline-size: 92.6mm; block-size: 5.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 208.2mm; inline-size: 135.0mm; block-size: 24.6mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 234.0mm; inline-size: 135.0mm; block-size: 29.5mm; font-size: 12.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 108.9mm; inset-block-start: 279.7mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
