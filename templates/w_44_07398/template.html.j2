<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="right-column">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>