<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 83.6mm; inset-block-start: 14.3mm; inline-size: 43.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 24.7mm; inline-size: 74.3mm; block-size: 8.1mm; font-size: 22.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 36.9mm; inline-size: 161.1mm; block-size: 29.1mm; font-size: 16.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 69.5mm; inline-size: 161.3mm; block-size: 29.1mm; font-size: 16.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 102.0mm; inline-size: 160.2mm; block-size: 23.1mm; font-size: 16.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 128.4mm; inline-size: 161.5mm; block-size: 41.3mm; font-size: 16.7pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 37.3mm; inset-block-start: 179.5mm; inline-size: 137.3mm; block-size: 88.1mm; font-size: 40.0pt"></div>
<footer class="box" style="inset-inline-start: 182.8mm; inset-block-start: 273.5mm; inline-size: 2.7mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 62.1mm; inset-block-start: 279.2mm; inline-size: 86.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
