<div class="slide" style="background-color: blue;">{{ slot_4 }}</div>
<div class="slide" style="background-color: green;">{{ slot_5 }}</div>
<div class="slide" style="background-color: yellow;">{{ slot_6 }}</div>
</div>
<section id="exhibit1">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</section>
<section id="exhibit2">
