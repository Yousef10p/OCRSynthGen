<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 96.6mm; inset-block-start: 30.4mm; inline-size: 27.5mm; block-size: 5.5mm; font-size: 7.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 36.1mm; inline-size: 156.4mm; block-size: 9.0mm; font-size: 8.5pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 123.0mm; inset-block-start: 55.3mm; inline-size: 55.3mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 126.0mm; inset-block-start: 68.5mm; inline-size: 58.9mm; block-size: 10.8mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 113.6mm; inset-block-start: 78.1mm; inline-size: 5.0mm; block-size: 4.5mm; font-size: 6.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 113.6mm; inset-block-start: 82.2mm; inline-size: 70.7mm; block-size: 8.0mm; font-size: 7.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 90.1mm; inline-size: 28.9mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 33.2mm; inset-block-start: 105.5mm; inline-size: 153.8mm; block-size: 102.5mm; font-size: 15.3pt"></div>
<footer class="box" style="inset-inline-start: 9.4mm; inset-block-start: 280.4mm; inline-size: 5.7mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
