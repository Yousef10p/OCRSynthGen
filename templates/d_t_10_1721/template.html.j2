<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 89.9mm; inline-size: 130.3mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 36.4mm; inset-block-start: 100.5mm; inline-size: 142.4mm; block-size: 8.1mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 78.0mm; inset-block-start: 112.4mm; inline-size: 111.9mm; block-size: 16.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 127.7mm; inline-size: 164.5mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 63.7mm; inset-block-start: 144.7mm; inline-size: 126.2mm; block-size: 13.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 160.7mm; inline-size: 164.5mm; block-size: 48.5mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 40.5mm; inset-block-start: 212.6mm; inline-size: 149.4mm; block-size: 14.1mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 228.7mm; inline-size: 164.5mm; block-size: 13.6mm; font-size: 8.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 39.5mm; inset-block-start: 246.4mm; inline-size: 150.4mm; block-size: 16.8mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 103.5mm; inset-block-start: 266.7mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
