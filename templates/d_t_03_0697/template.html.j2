<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 16.0mm; inset-block-start: 12.0mm; inline-size: 80.5mm; block-size: 2.6mm; font-size: 7.4pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 16.0mm; inset-block-start: 15.6mm; inline-size: 119.7mm; block-size: 6.2mm; font-size: 8.7pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 16.0mm; inset-block-start: 22.7mm; inline-size: 113.6mm; block-size: 6.2mm; font-size: 8.7pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 29.9mm; inline-size: 118.9mm; block-size: 38.3mm; font-size: 9.9pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 16.0mm; inset-block-start: 72.9mm; inline-size: 46.4mm; block-size: 2.1mm; font-size: 5.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 76.2mm; inline-size: 118.9mm; block-size: 27.6mm; font-size: 9.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 16.0mm; inset-block-start: 108.4mm; inline-size: 19.5mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 111.8mm; inline-size: 118.9mm; block-size: 27.6mm; font-size: 9.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 140.4mm; inline-size: 118.9mm; block-size: 16.9mm; font-size: 9.6pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 16.0mm; inset-block-start: 161.9mm; inline-size: 60.1mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 165.3mm; inline-size: 118.9mm; block-size: 24.0mm; font-size: 9.7pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 190.3mm; inline-size: 118.9mm; block-size: 6.2mm; font-size: 8.7pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 131.9mm; inset-block-start: 201.6mm; inline-size: 3.0mm; block-size: 1.8mm; font-size: 5.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
