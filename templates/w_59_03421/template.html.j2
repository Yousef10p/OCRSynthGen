}

footer {
    width: 100%;
    background-color: #f5f5f5;
    padding: 20px;
    text-align: center;
}

footer h3 {
    text-decoration: underline;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
