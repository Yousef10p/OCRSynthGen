<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.0mm; inset-block-start: 14.4mm; inline-size: 41.0mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 20.4mm; inline-size: 189.7mm; block-size: 23.8mm; font-size: 11.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 48.3mm; inline-size: 189.7mm; block-size: 19.8mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 72.2mm; inline-size: 189.7mm; block-size: 19.8mm; font-size: 11.2pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 16.0mm; inset-block-start: 97.1mm; inline-size: 181.9mm; block-size: 118.7mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 19.5mm; inset-block-start: 219.9mm; inline-size: 176.4mm; block-size: 7.9mm; font-size: 11.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 231.7mm; inline-size: 189.7mm; block-size: 23.8mm; font-size: 11.2pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 267.9mm; inline-size: 6.0mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
