<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 11.7mm; inset-block-start: 9.8mm; inline-size: 20.3mm; block-size: 13.2mm; font-size: 18.8pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 5.6mm; inset-block-start: 26.2mm; inline-size: 127.7mm; block-size: 139.8mm; font-size: 39.6pt"></div>
<h2 class="box" style="inset-inline-start: 138.7mm; inset-block-start: 54.0mm; inline-size: 33.9mm; block-size: 16.4mm; font-size: 23.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 138.7mm; inset-block-start: 72.9mm; inline-size: 27.3mm; block-size: 5.3mm; font-size: 15.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 138.7mm; inset-block-start: 86.6mm; inline-size: 16.5mm; block-size: 5.4mm; font-size: 15.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 138.7mm; inset-block-start: 94.0mm; inline-size: 55.5mm; block-size: 45.6mm; font-size: 9.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 138.7mm; inset-block-start: 141.9mm; inline-size: 54.4mm; block-size: 13.8mm; font-size: 9.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 138.7mm; inset-block-start: 158.0mm; inline-size: 54.7mm; block-size: 20.9mm; font-size: 9.9pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 11.8mm; inset-block-start: 171.6mm; inline-size: 117.5mm; block-size: 23.0mm; font-size: 16.3pt"></div>
<p class="box" style="inset-inline-start: 138.7mm; inset-block-start: 181.1mm; inline-size: 55.0mm; block-size: 10.3mm; font-size: 9.7pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 5.9mm; inset-block-start: 200.5mm; inline-size: 204.0mm; block-size: 91.0mm; font-size: 40.0pt"></div>
</div></body>
</html>
