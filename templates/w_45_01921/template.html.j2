}

div.service p, div.testimonial p {
    font-size: 16px;
}

div.testimonial cite {
    display: block;
    text-align: left;
    margin-top: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
