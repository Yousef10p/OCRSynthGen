<div class="program">{{ slot_5 }}</div>
<div class="program">{{ slot_6 }}</div>
</div>

<div class="schedule">
<h2>{{ slot_7 }}</h2>

<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
</div>

<div class="blog">
<h2>{{ slot_10 }}</h2>

<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
</div>

<div class="shop">
<h2>{{ slot_13 }}</h2>

<div class="item">{{ slot_14 }}</div>
<div class="item">{{ slot_15 }}</div>
</div>
</div>
</body>
</html>