</ul>
</nav>
<div class="hero">
<h1 id="heroTitle">{{ slot_4 }}</h1>
<div class="featuredDestination">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<button>{{ slot_7 }}</button>
</div>
</div>
<section class="featuredTours">
<h2>{{ slot_8 }}</h2>
<ul>
<li>
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<button>{{ slot_11 }}</button>
</li>
<li>
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<button>{{ slot_14 }}</button>
</li>
<li>
<h3>{{ slot_15 }}</h3>
<p>{{ slot_16 }}</p>
<button>{{ slot_17 }}</button>
</li>
</ul>
</section>
</body>
</html>