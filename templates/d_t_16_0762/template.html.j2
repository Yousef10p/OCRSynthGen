<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 279.4mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 29.1mm; inset-block-start: 11.9mm; inline-size: 222.4mm; block-size: 21.6mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 89.1mm; inset-block-start: 36.6mm; inline-size: 101.2mm; block-size: 15.1mm; font-size: 40.0pt">{{ slot_1 }}</h2>
<ul class="box" style="inset-inline-start: 21.0mm; inset-block-start: 64.6mm; inline-size: 128.0mm; block-size: 23.6mm; font-size: 33.4pt"><li>{{ slot_2 }}</li></ul>
<div class="box ph" style="inset-inline-start: 164.4mm; inset-block-start: 64.1mm; inline-size: 97.7mm; block-size: 109.8mm; font-size: 14.8pt"></div>
<ul class="box" style="inset-inline-start: 21.0mm; inset-block-start: 91.6mm; inline-size: 120.7mm; block-size: 23.6mm; font-size: 33.4pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 21.0mm; inset-block-start: 118.6mm; inline-size: 126.9mm; block-size: 23.6mm; font-size: 33.4pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 21.0mm; inset-block-start: 145.7mm; inline-size: 108.5mm; block-size: 23.6mm; font-size: 33.4pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 8.8mm; inset-block-start: 177.3mm; inline-size: 41.9mm; block-size: 7.3mm; font-size: 20.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 16.5mm; inset-block-start: 193.1mm; inline-size: 77.4mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 197.9mm; inset-block-start: 195.0mm; inline-size: 36.8mm; block-size: 11.2mm; font-size: 15.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 264.8mm; inset-block-start: 197.0mm; inline-size: 2.6mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
