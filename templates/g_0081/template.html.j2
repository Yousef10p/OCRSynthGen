</tr>
<tr><td style="border: 1px solid #888; padding: 0.2em 0.8em; text-align: center">{{ slot_17 }}</td></tr>
</tbody></table>
<p style="margin-block: 0 0.4em; text-indent: 0; text-align: start; font-size: 1em">{{ slot_18 }}</p>
<blockquote style="border-inline-start: 4px solid #888; padding-inline-start: 0.9em; margin-inline: 1.5em 0.5em; margin-block: 0.8em; font-size: 1.05em">{{ slot_19 }}</blockquote></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_20 }}</span><span>{{ slot_21 }}</span></footer>
</div></body>
</html>
