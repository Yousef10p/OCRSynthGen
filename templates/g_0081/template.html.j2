<p style="margin-block: 0.2em">{{ slot_4 }}</p>
<p style="margin-block: 0.2em">{{ slot_5 }}</p></aside><ol style="list-style-type: arabic-indic; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ol>
<p style="margin-block: 0 1em; text-indent: 0; text-align: var(--align); font-size: 1em">{{ slot_10 }}</p>
<aside style="border: 2px dashed #444; background: #f4f4f4; padding: 0.6em 0.9em; margin-block: 0.8em; border-radius: 0; break-inside: avoid"><h4>{{ slot_11 }}</h4>
<p style="margin-block: 0.2em">{{ slot_12 }}</p></aside><table style="border-collapse: collapse; inline-size: 100%; margin-block: 0.6em; font-size: 0.9em; break-inside: avoid"><tbody>
<tr>
