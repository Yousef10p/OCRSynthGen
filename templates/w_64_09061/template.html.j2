<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div id="content">
<p>{{ slot_5 }}</p>
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
<p>{{ slot_8 }}</p>
</div>
<div id="subscription-form">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>
<button>{{ slot_10 }}</button>
</div>
<div id="footer">
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</div>
</body>
</html>