<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 160.9mm; inset-block-start: 16.0mm; inline-size: 41.7mm; block-size: 8.1mm; font-size: 9.8pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 79.0mm; inset-block-start: 65.6mm; inline-size: 70.3mm; block-size: 6.6mm; font-size: 16.8pt">{{ slot_1 }}</h2>
<ul class="box" style="inset-inline-start: 44.3mm; inset-block-start: 76.1mm; inline-size: 68.3mm; block-size: 19.4mm; font-size: 11.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.2mm; inset-block-start: 95.9mm; inline-size: 91.9mm; block-size: 19.8mm; font-size: 11.8pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.0mm; inset-block-start: 115.8mm; inline-size: 81.1mm; block-size: 19.6mm; font-size: 11.8pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.0mm; inset-block-start: 135.3mm; inline-size: 128.8mm; block-size: 24.9mm; font-size: 11.8pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.2mm; inset-block-start: 160.1mm; inline-size: 76.8mm; block-size: 19.7mm; font-size: 11.8pt"><li>{{ slot_6 }}</li></ul>
<footer class="box" style="inset-inline-start: 105.2mm; inset-block-start: 260.9mm; inline-size: 6.7mm; block-size: 3.9mm; font-size: 9.8pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 162.1mm; inset-block-start: 267.4mm; inline-size: 37.2mm; block-size: 3.9mm; font-size: 9.8pt">{{ slot_8 }}</footer>
</div></body>
</html>
