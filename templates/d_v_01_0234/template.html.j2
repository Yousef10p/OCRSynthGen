<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 24.6mm; inset-block-start: 18.9mm; inline-size: 168.2mm; block-size: 8.7mm; font-size: 12.0pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 46.1mm; inset-block-start: 32.3mm; inline-size: 125.1mm; block-size: 15.0mm; font-size: 9.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 50.2mm; inline-size: 140.6mm; block-size: 17.9mm; font-size: 9.0pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 71.6mm; inline-size: 6.3mm; block-size: 118.9mm; font-size: 20.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 37.3mm; inset-block-start: 76.2mm; inline-size: 49.8mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 75.9mm; inline-size: 86.6mm; block-size: 49.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 46.9mm; inset-block-start: 87.8mm; inline-size: 30.7mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 18.9mm; inset-block-start: 96.6mm; inline-size: 86.7mm; block-size: 134.2mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 127.1mm; inline-size: 86.5mm; block-size: 16.2mm; font-size: 10.0pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 132.8mm; inset-block-start: 148.0mm; inline-size: 65.5mm; block-size: 8.3mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 161.0mm; inline-size: 86.5mm; block-size: 11.9mm; font-size: 10.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 174.2mm; inline-size: 86.5mm; block-size: 35.3mm; font-size: 10.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 209.0mm; inline-size: 86.5mm; block-size: 47.1mm; font-size: 10.0pt">{{ slot_11 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 231.6mm; inline-size: 86.6mm; block-size: 24.6mm; font-size: 10.0pt">{{ slot_12 }}</p>
</div></body>
</html>
