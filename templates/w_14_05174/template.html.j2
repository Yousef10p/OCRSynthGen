    text-align: center;
    padding: 20px;
    margin: 0;
}

main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 20px;
}

article {
    border: 1px solid #ccc;
    padding: 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
}

.product-img {
    width: 100px;
    height: 100px;
    margin-left: 20px;
    flex-shrink: 0;
}

form {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    margin-top: 20px;
}

label {
    font-weight: bold;
}

input, textarea {
    padding: 10px;
    border: 1px solid #ccc;
}

footer {
    background-color: #f1f1f1;
    text-align: center;
    padding: 20px;
    position: fixed;
    width: 100%;
    bottom: 0;
    right: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
