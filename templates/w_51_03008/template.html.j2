<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

.dashboard {
    width: 100%;
    height: 100vh;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: 10px;
    padding: 10px;
}

.dashboard div {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    background-color: #f2f2f2;
    padding: 10px;
}

.button {
    background-color: #008CBA;
    color: white;
    padding: 15px 32px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 16px;
    margin: 4px 2px;
    cursor: pointer;
}

h1, h2, p {
    padding: 10px;
    text-align: center;
    color: #333;
}


.workout, .nutrition, .progress, .social {
    height: 200px;
    margin: 10px;
    box-sizing: border-box;
}


.start-button, .nutri-button, .progress-button, .social-button {
    border: none;
    color: white;
    padding: 15px 32px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 16px;
    cursor: pointer;
}

.start-button, .nutri-button, .progress-button, .social-button:hover {
    background-color: #4CAF50;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="dashboard">
<h1>{{ slot_0 }}</h1>
<div class="workout">
<h2>{{ slot_1 }}</h2>
<p>{{ slot_2 }} <span class="button">{{ slot_3 }}</span> {{ slot_4 }}</p>
<button class="start-button">{{ slot_5 }}</button>
</div>
<div class="nutrition">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<button class="nutri-button">{{ slot_8 }}</button>
</div>
<div class="progress">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<button class="progress-button">{{ slot_11 }}</button>
</div>
<div class="social">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<button class="social-button">{{ slot_14 }}</button>
</div>
</div>
</body>
</html>