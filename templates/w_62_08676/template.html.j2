<li><a>{{ slot_3 }}</a></li>
</ul>
</li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
</header>
<div class="content">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>