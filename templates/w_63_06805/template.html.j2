<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}



#header {
    position: sticky;
    top: 0;
    width: 100%;
    background-color: #f0f0f0;
}

#main-menu ul {
    list-style-type: none;
    margin: 0;
    padding: 1em;
    display: flex;
    justify-content: space-around;
}

#main-menu ul li a {
    color: #333;
    text-decoration: none;
}



#hero {
    width: 100%;
    height: 50vh;
    background-color: #333;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#hero h1 {
    font-size: 3em;
}

#hero p {
    margin: 0;
    font-size: 1.5em;
}



#main-section {
    padding: 2em;
}



#footer {
    background-color: #f0f0f0;
    padding: 2em;
    text-align: center;
}

#footer p {
    font-size: 1.5em;
}

#reservations label {
    display: block;
    margin-bottom: 0.5em;
}

#reservations input[type="text"],
#reservations input[type="date"],
#reservations input[type="time"],
#reservations input[type="number"] {
    width: 100%;
    margin-bottom: 1em;
    padding: 0.5em;
}

#reservations input[type="submit"] {
    background-color: #333;
    color: #fff;
    padding: 0.5em 1em;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
