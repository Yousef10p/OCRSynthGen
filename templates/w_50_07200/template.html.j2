<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}
header {
  position: fixed;
  top: 0;
  width: 100%;
  background: #fff;
}

nav ul {
  list-style: none;
  padding: 0;
  text-align: left;
}

nav li {
  display: inline-block;
  margin: 0 20px;
}

nav a {
  text-decoration: none;
  color: #000;
  transition: 0.3s;
}

nav a:hover {
  color: #a80f0f;
}

.hero-image {
  height: 800px;
  width: 100%;
}

.hero-button {
  margin: 20px;
}

.hero-button button {
  background: #a80f0f;
  color: #fff;
  border: none;
  padding: 10px 20px;
  border-radius: 5px;
  cursor: pointer;
  transition: 0.3s;
}

.hero-button button:hover {
  background: #7e0b0b;
}

.privacy-text, .security-text, .about-us {
  width: 30%;
  margin: 50px auto;
  text-align: center;
}

.privacy-text h1, .security-text h1, .about-us h1 {
  color: #a80f0f;
}

footer {
  background: #444;
  color: #fff;
  text-align: center;
  padding: 20px 0;
  position: fixed;
  width: 100%;
  bottom: 0;
}




@media screen and (max-width: 1024px) {
  .privacy-text, .security-text, .about-us {
    width: 50%;
  }
}

@media screen and (max-width: 600px) {
  .privacy-text, .security-text, .about-us {
    width: 70%;
  }
}

@media screen and (max-width: 480px) {
  .privacy-text, .security-text, .about-us {
    width: 90%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<section class="hero-image">

<div style="height:400px;width: 100%;background-color:#a80f0f;">{{ slot_4 }}</div>
<div class="hero-button">
<a><button>{{ slot_5 }}</button></a>
</div>
</section>
<section class="privacy-text">
<h1>{{ slot_6 }}</h1>

<p>{{ slot_7 }}</p>
<a><button>{{ slot_8 }}</button></a>
</section>
<section class="security-text">
<h1>{{ slot_9 }}</h1>

<p>{{ slot_10 }}</p>
<a><button>{{ slot_11 }}</button></a>
</section>
<section class="about-us">
<h1>{{ slot_12 }}</h1>

<p>{{ slot_13 }}</p>
<a><button>{{ slot_14 }}</button></a>
</section>
<footer>

<p>{{ slot_15 }}</p>
</footer>
</body>
</html>