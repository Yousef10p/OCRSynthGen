<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 54.5mm; inline-size: 6.4mm; block-size: 153.6mm; font-size: 20.0pt">{{ slot_5 }}</header><p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 58.5mm; inline-size: 140.6mm; block-size: 36.3mm; font-size: 9.0pt">{{ slot_6 }}</p>
