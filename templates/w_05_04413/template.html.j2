<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    background-color: white;
}

.logo {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    text-align: center;
}

ul.menu {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}

li {
    float: right;
}

li a, .sub-menu {
    display: inline-block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

li a:hover, .sub-menu:hover .sub-menu {
    background-color: #111;
}

.sub-menu {
    display: none;
    position: absolute;
    min-width: 160px;
    z-index: 1;
}

.sub-menu li:hover {
    background-color: #f1f1f1
}

#image1, #image2, #image3 {
    width: 100px;
    height: 100px;
    background-color: blue;
    margin: auto;
}

p {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="logo">{{ slot_0 }}</div>
<ul class="menu">
<li>
            {{ slot_1 }}
            <ul class="sub-menu">
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</li>
<li>
            {{ slot_6 }}
            <ul class="sub-menu">
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
</li>
<li>
            {{ slot_10 }}
            <ul class="sub-menu">
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
</ul>
</li>
</ul>
<div id="image1">{{ slot_14 }}</div>
<p>{{ slot_15 }}</p>
<div id="image2">{{ slot_16 }}</div>
<p>{{ slot_17 }}</p>
<div id="image3">{{ slot_18 }}</div>
<p>{{ slot_19 }}</p>
</body>
</html>