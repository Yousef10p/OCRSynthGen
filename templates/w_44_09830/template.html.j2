    padding: 20px 0;
}

form {
    display: flex;
    justify-content: center;
    padding: 20px 0;
}

form input[type="text"] {
    padding: 10px;
    margin-left: 10px;
}

.calculator {
    text-align: center;
    padding: 50px;
}

.calculator h2 {
    margin-bottom: 20px;
}

.calculator form {
    margin-bottom: 20px;
}

.calculator select,
.calculator input[type="text"] {
    padding: 10px;
    margin-left: 10px;
}

.calculator button {
    padding: 10px 20px;
    background: #333;
    color: white;
    border: none;
}

.result {
    text-align: center;
    padding-top: 20px;
}

.privacy {
    text-align: center;
    padding: 50px;
}

.testimonials {
    text-align: center;
    padding: 50px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
