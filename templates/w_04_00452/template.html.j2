<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}
.fullscreen-background {
    background: none no-repeat center center fixed; 
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    background-size: cover;
    height: 100vh;
}
nav {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(0, 0, 0, 0.5);
    color: white;
}
nav ul {
    margin: 0;
    padding: 15px 0;
    text-align: center;
}
nav ul li {
    display: inline;
    margin: 0 10px;
}
nav ul li a {
    color: white;
    text-decoration: none;
}
.blog {
    margin-top: 50px;
    padding: 20px;
    text-align: center;
}
.blog h1 {
    font-size: 3em;
}
.blog-post {
    display: inline-block;
    width: 30%;
    margin: 1.66%;
    text-align: right;
    vertical-align: top;
}
footer {
    background: rgba(0, 0, 0, 0.5);
    color: white;
    text-align: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}
footer a {
    color: white;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="fullscreen-background"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<section class="blog">
<h1>{{ slot_4 }}</h1>
<div class="blog-post">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>

</section>
<footer>
<p>{{ slot_7 }} <a>{{ slot_8 }}</a>{{ slot_9 }} <a>{{ slot_10 }}</a>{{ slot_11 }} <a>{{ slot_12 }}</a></p>
<p>{{ slot_13 }} <a>{{ slot_14 }}</a></p>
</footer>
</body>
</html>