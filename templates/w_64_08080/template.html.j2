}
#navbar ul {
    list-style: none;
    padding-right: 0;
}
#navbar > ul > li {
    padding: 10px 0;
    border-bottom: 1px solid #eee;
    cursor: pointer;
    position: relative;
}
#navbar > ul > li > ul {
    position: absolute;
    right: 200px;
    top: 0;
    background: #fff;
    width: 200px;
    display: none;
}
#navbar > ul > li:hover > ul {
    display: block;
}
#content {
