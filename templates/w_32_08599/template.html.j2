  text-decoration: none;
  background-color: #333;
}

nav li ul {
  display: none;
  position: absolute;
  background-color: #333;
  min-width: 150px;
}

nav li:hover ul {
  display: block;
}

nav li ul li {
  float: none;
}

nav li ul li a {
  white-space: nowrap;
}

.item {
  margin: 20px;
  display: inline-block;
  width: 200px;
  vertical-align: top;
}

.item-image {
