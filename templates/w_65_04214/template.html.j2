}

.nav-links a {
    color: #fff;
    text-decoration: none;
    margin: 0 10px;
}

h1, h2, p {
    text-align: center;
}

section {
    padding: 50px 0;
}

.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.portfolio-image {
    
    background-color: #ddd;
    min-height: 200px;
}

.testimonial {
    background-color: #f9f9f9;
    padding: 20px;
