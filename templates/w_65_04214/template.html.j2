}

form {
    display: grid;
    gap: 10px;
}

input, textarea, button {
    padding: 10px;
}

footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px 0;
    position: absolute;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
