<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 47.3mm; inset-block-start: 55.2mm; inline-size: 16.9mm; block-size: 15.1mm; font-size: 14.3pt"></div>
<h2 class="box" style="inset-inline-start: 31.4mm; inset-block-start: 73.5mm; inline-size: 48.7mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 19.7mm; inset-block-start: 84.9mm; inline-size: 64.7mm; block-size: 88.7mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 91.2mm; inset-block-start: 89.0mm; inline-size: 100.4mm; block-size: 43.0mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 95.4mm; inset-block-start: 134.5mm; inline-size: 87.1mm; block-size: 14.1mm; font-size: 10.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 135.8mm; inset-block-start: 166.8mm; inline-size: 49.3mm; block-size: 58.2mm; font-size: 18.3pt"></div>
<p class="box" style="inset-inline-start: 32.7mm; inset-block-start: 179.6mm; inline-size: 48.1mm; block-size: 30.9mm; font-size: 9.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 94.2mm; inset-block-start: 179.6mm; inline-size: 35.0mm; block-size: 21.8mm; font-size: 10.3pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 15.6mm; inset-block-start: 237.9mm; inline-size: 22.2mm; block-size: 2.4mm; font-size: 6.8pt">{{ slot_4 }}</footer>
</div></body>
</html>
