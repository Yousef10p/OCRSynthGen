}
.right-column {
    border-right: 1px solid #ddd;
}
h1 {
    color: #333;
}
.banner {
    height: 400px; 
    background: #ddd;
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
