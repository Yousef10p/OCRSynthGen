    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px;
}

#hero {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
}

header h1 {
    font-size: 5vw;
    margin-bottom: 10px;
}

.cta {
    display: inline-block;
