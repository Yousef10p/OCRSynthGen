<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 34.0mm; inset-block-start: 24.7mm; inline-size: 31.5mm; block-size: 6.5mm; font-size: 18.5pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 34.1mm; inset-block-start: 41.4mm; inline-size: 96.9mm; block-size: 18.3mm; font-size: 25.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 99.6mm; inline-size: 141.8mm; block-size: 38.1mm; font-size: 18.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 55.3mm; inset-block-start: 208.3mm; inline-size: 98.6mm; block-size: 35.2mm; font-size: 33.2pt"></div>
<p class="box" style="inset-inline-start: 49.2mm; inset-block-start: 247.6mm; inline-size: 111.3mm; block-size: 5.6mm; font-size: 15.9pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 103.4mm; inset-block-start: 264.1mm; inline-size: 3.8mm; block-size: 5.3mm; font-size: 14.9pt">{{ slot_4 }}</footer>
</div></body>
</html>
