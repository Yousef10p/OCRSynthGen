<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</header>
<main class="product-showcase">
<section class="product">
<h2><a>{{ slot_6 }}</a></h2>
<div class="product-image">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</section>
<section class="product">
<h2><a>{{ slot_9 }}</a></h2>
<div class="product-image">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
</section>
<section class="product">
<h2><a>{{ slot_12 }}</a></h2>
<div class="product-image">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
</section>
</main>
</body>
</html>