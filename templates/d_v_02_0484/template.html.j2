<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.0mm; inset-block-start: 32.6mm; inline-size: 41.4mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 134.8mm; inset-block-start: 32.6mm; inline-size: 55.2mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 42.7mm; inline-size: 62.2mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 53.0mm; inline-size: 167.9mm; block-size: 11.6mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 73.6mm; inline-size: 41.2mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 83.9mm; inline-size: 163.8mm; block-size: 11.6mm; font-size: 10.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 104.6mm; inline-size: 42.1mm; block-size: 4.6mm; font-size: 14.3pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 114.9mm; inline-size: 36.5mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 101.5mm; inset-block-start: 286.6mm; inline-size: 7.0mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
