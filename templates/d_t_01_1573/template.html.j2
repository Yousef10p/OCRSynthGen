<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 30.2mm; inset-block-start: 13.1mm; inline-size: 156.0mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 18.4mm; inset-block-start: 26.3mm; inline-size: 176.2mm; block-size: 8.1mm; font-size: 22.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 155.5mm; inset-block-start: 92.9mm; inline-size: 51.0mm; block-size: 11.4mm; font-size: 16.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 9.4mm; inset-block-start: 171.4mm; inline-size: 27.4mm; block-size: 11.4mm; font-size: 16.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 168.7mm; inset-block-start: 192.5mm; inline-size: 40.1mm; block-size: 21.5mm; font-size: 20.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 186.3mm; inset-block-start: 258.0mm; inline-size: 18.9mm; block-size: 11.4mm; font-size: 16.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 9.4mm; inset-block-start: 263.9mm; inline-size: 39.2mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_6 }}</p>
</div></body>
</html>
