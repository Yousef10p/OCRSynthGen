<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 27.1mm; inset-block-start: 19.4mm; inline-size: 121.9mm; block-size: 30.7mm; font-size: 14.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 27.1mm; inset-block-start: 57.3mm; inline-size: 122.0mm; block-size: 25.3mm; font-size: 14.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 27.1mm; inset-block-start: 89.2mm; inline-size: 18.7mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 27.1mm; inset-block-start: 95.2mm; inline-size: 127.1mm; block-size: 25.3mm; font-size: 14.3pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 0.5mm; inset-block-start: 127.4mm; inline-size: 214.5mm; block-size: 32.8mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 27.1mm; inset-block-start: 165.6mm; inline-size: 119.1mm; block-size: 14.5mm; font-size: 13.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.1mm; inset-block-start: 192.7mm; inline-size: 11.8mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 28.7mm; inset-block-start: 199.4mm; inline-size: 30.6mm; block-size: 10.5mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 27.1mm; inset-block-start: 213.3mm; inline-size: 45.1mm; block-size: 8.4mm; font-size: 11.9pt">{{ slot_6 }}</p>
</div></body>
</html>
