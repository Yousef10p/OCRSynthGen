<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
}

header {
  background: linear-gradient(to left, #1e5799 0%,#207cca 50%,#207cca 50%,#1e5799 100%);
  color: white;
  padding: 20px;
  position: relative;
}

header h1 {
  font-size: 3em;
  margin-bottom: 10px;
position: absolute;
  top: 50%;
  right: 50%;
  transform: translate(50%, -50%);
}

nav {
  background: linear-gradient(to left, #1e5799 0%,#207cca 50%,#207cca 50%,#1e5799 100%);
  height: 50px;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
}

nav ul {
  list-style: none;
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 100%;
}

nav ul li a {
  color: white;
  text-decoration: none;
}

nav ul li a:hover {
  color: #1e5799;
}

main {
  padding: 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 20px;
}

.intro, .about, .contact, .chat-widget {
  background: #f2f2f2;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
  overflow: hidden;
}

.contact form {
  display: flex;
  flex-direction: column;
}

.contact input[type="text"] {
  margin-bottom: 20px;
  padding: 10px;
  border: 1px solid #ddd;
}

.contact input[type="submit"] {
  background: #1e5799;
  color: white;
  padding: 10px;
  border: none;
  cursor: pointer;
}

.contact input[type="submit"]:hover {
  background: #207cca;
}

footer {
  background: #1e5799;
  color: white;
  text-align: center;
  padding: 10px;
  position: fixed;
  bottom: 0;
  width: 100%;
}

@media (max-width: 600px) {
  main {
    grid-template-columns: 1fr;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
