    color: #fff;
    text-align: center;
    vertical-align: middle;
    line-height: 200px;
    margin-bottom: 10px;
}

.product p {
    margin: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
