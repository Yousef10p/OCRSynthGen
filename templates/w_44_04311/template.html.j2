<div class="dropdown-content">
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
</div>
</li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
</header>
<section class="content">
<div class="col">
