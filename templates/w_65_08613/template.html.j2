    margin: 2em;
}
label {
    display: block;
    margin-bottom: 0.5em;
}
input, textarea, button {
    grid-column: span 2;
}
button {
    margin: 1em auto 0 0;
    padding: 0.5em 1em;
    background: #333;
    color: #fff;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
