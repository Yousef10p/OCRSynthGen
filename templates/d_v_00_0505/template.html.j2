<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 10.6mm; inset-block-start: 73.2mm; inline-size: 27.0mm; block-size: 36.8mm; font-size: 14.9pt"></div>
<h2 class="box" style="inset-inline-start: 41.5mm; inset-block-start: 74.0mm; inline-size: 8.1mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 41.5mm; inset-block-start: 82.0mm; inline-size: 56.1mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 10.9mm; inset-block-start: 135.4mm; inline-size: 171.6mm; block-size: 5.5mm; font-size: 15.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 10.9mm; inset-block-start: 147.3mm; inline-size: 80.3mm; block-size: 19.1mm; font-size: 13.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 102.7mm; inset-block-start: 147.3mm; inline-size: 83.0mm; block-size: 64.8mm; font-size: 14.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 10.9mm; inset-block-start: 172.7mm; inline-size: 83.6mm; block-size: 34.3mm; font-size: 13.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 10.9mm; inset-block-start: 213.3mm; inline-size: 81.6mm; block-size: 39.4mm; font-size: 14.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 102.7mm; inset-block-start: 218.4mm; inline-size: 84.0mm; block-size: 34.3mm; font-size: 13.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 10.9mm; inset-block-start: 283.9mm; inline-size: 2.8mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
