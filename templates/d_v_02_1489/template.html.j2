<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 74.2mm; inset-block-start: 10.8mm; inline-size: 4.9mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 219.8mm; inset-block-start: 15.9mm; inline-size: 5.3mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 35.8mm; inset-block-start: 20.4mm; inline-size: 81.9mm; block-size: 127.2mm; font-size: 11.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 182.2mm; inset-block-start: 25.3mm; inline-size: 81.0mm; block-size: 57.3mm; font-size: 11.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 182.4mm; inset-block-start: 86.1mm; inline-size: 81.1mm; block-size: 49.5mm; font-size: 11.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 182.7mm; inset-block-start: 139.1mm; inline-size: 81.4mm; block-size: 62.1mm; font-size: 11.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 151.1mm; inline-size: 81.7mm; block-size: 35.9mm; font-size: 11.3pt">{{ slot_6 }}</p>
</div></body>
</html>
