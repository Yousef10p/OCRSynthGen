<p class="box" style="inset-inline-start: 49.0mm; inset-block-start: 147.0mm; inline-size: 117.9mm; block-size: 5.6mm; font-size: 14.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 60.8mm; inset-block-start: 156.7mm; inline-size: 94.3mm; block-size: 15.7mm; font-size: 14.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 38.0mm; inset-block-start: 177.7mm; inline-size: 139.9mm; block-size: 15.7mm; font-size: 14.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 46.7mm; inset-block-start: 199.8mm; inline-size: 122.4mm; block-size: 4.2mm; font-size: 14.3pt">{{ slot_7 }}</p>
