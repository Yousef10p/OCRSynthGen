<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 77.8mm; inline-size: 6.3mm; block-size: 118.0mm; font-size: 20.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 60.4mm; inset-block-start: 93.9mm; inline-size: 94.9mm; block-size: 5.3mm; font-size: 10.0pt">{{ slot_2 }}</p>
