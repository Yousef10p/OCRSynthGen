<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 72.1mm; inset-block-start: 48.6mm; inline-size: 72.6mm; block-size: 71.7mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 80.2mm; inset-block-start: 127.3mm; inline-size: 60.0mm; block-size: 13.3mm; font-size: 12.5pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 50.0mm; inset-block-start: 147.0mm; inline-size: 108.5mm; block-size: 4.2mm; font-size: 11.8pt">{{ slot_1 }}</h2>
<ul class="box" style="inset-inline-start: 58.5mm; inset-block-start: 155.0mm; inline-size: 111.7mm; block-size: 4.0mm; font-size: 11.3pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 58.8mm; inset-block-start: 163.0mm; inline-size: 126.3mm; block-size: 8.0mm; font-size: 11.3pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 58.7mm; inset-block-start: 174.8mm; inline-size: 109.9mm; block-size: 12.0mm; font-size: 11.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 58.6mm; inset-block-start: 190.2mm; inline-size: 116.9mm; block-size: 32.1mm; font-size: 11.4pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 58.6mm; inset-block-start: 226.1mm; inline-size: 59.7mm; block-size: 4.3mm; font-size: 12.3pt"><li>{{ slot_6 }}</li></ul>
<footer class="box" style="inset-inline-start: 115.0mm; inset-block-start: 250.1mm; inline-size: 9.0mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_7 }}</footer>
</div></body>
</html>
