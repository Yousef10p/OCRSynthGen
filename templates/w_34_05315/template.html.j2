}

nav ul li a {
  text-decoration: none;
  color: #fff;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-gap: 1em;
  padding: 1em;
}

.grid-item {
  background-color: #fff;
  padding: 1em;
  box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
}

.grid-item-image {
  height: 10em;
  background-color: #333;
}

footer {
  background-color: #333;
  color: #fff;
  text-align: center;
  padding: 1em;
}

footer p span a {
  text-decoration: none;
  color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
