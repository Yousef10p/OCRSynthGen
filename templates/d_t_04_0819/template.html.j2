<p class="box" style="inset-inline-start: 51.1mm; inset-block-start: 99.9mm; inline-size: 140.3mm; block-size: 23.6mm; font-size: 13.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 51.1mm; inset-block-start: 125.2mm; inline-size: 145.2mm; block-size: 23.6mm; font-size: 13.4pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 60.9mm; inset-block-start: 161.9mm; inline-size: 48.6mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 163.2mm; inset-block-start: 171.7mm; inline-size: 32.6mm; block-size: 80.5mm; font-size: 9.1pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 14.4mm; inset-block-start: 175.6mm; inline-size: 66.9mm; block-size: 78.3mm; font-size: 13.9pt"></div>
