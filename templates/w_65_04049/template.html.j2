}

section {
  padding: 20px;
}

h1 {
  color: #333;
  padding-bottom: 10px;
  border-bottom: 1px solid #aaa;
}

p {
  line-height: 1.6;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
