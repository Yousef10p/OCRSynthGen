<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: #333;
}

nav {
    background: #333;
    color: #fff;
    padding: 10px 0;
}

nav ul {
    list-style: none;
    text-align: center;
}

nav ul li {
    display: inline;
    margin: 0 20px;
}

#carousel {
    background: #eee;
    padding: 30px;
    text-align: center;
}

aside {
    float: left;
    width: 30%;
    padding: 20px;
}

.carousel-item {
    background: #333;
    color: #fff;
    height: 150px;
    line-height: 150px;
    margin-bottom: 10px;
}


.carousel-item::before {
    content: "";
    display: inline-block;
    width: 100%;
    height: 100%;
    background: #999;
}

h3 {
    margin-bottom: 10px;
}

ul li {
    margin: 5px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<section id="carousel">
<div class="carousel-item">{{ slot_4 }}</div>
<div class="carousel-item">{{ slot_5 }}</div>
<div class="carousel-item">{{ slot_6 }}</div>
</section>
<aside>
<h3>{{ slot_7 }}</h3>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
<h3>{{ slot_11 }}</h3>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</aside>
</body>
</html>