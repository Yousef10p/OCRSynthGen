<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    background-color: #f2f2f2;
    font-family: var(--font-body);
}

.header {
    background-color: #4CAF50;
    color: white;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.header .logo {
    font-size: 24px;
    margin: 0;
}

.searchbar input {
    width: 200px;
    height: 30px;
    border-radius: 15px;
    border: none;
    padding: 0 10px;
}

.wrapper {
    display: flex;
    margin-top: 50px;
}

.left-col,
.right-col {
    flex: 1;
    padding: 20px;
}

.left-col {
    background-color: #f2f2f2;
}

.right-col {
    background-color: #d3d3d3;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="logo">
<h1>{{ slot_0 }}</h1>
</div>
<div class="searchbar">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</div>
</div>
<div class="wrapper">
<div class="left-col">
<h2>{{ slot_2 }}</h2>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>

</ul>
<h2>{{ slot_6 }}</h2>
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>

</ul>
</div>
<div class="right-col">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>

<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>

</div>
</div>
</body>
</html>