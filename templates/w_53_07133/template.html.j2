<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<br>
<div id="comparisonSlider">
<div class="car" id="car1">
<p>{{ slot_4 }}</p>
<h3>{{ slot_5 }}</h3>
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
</div>
<div class="car" id="car2">
<p>{{ slot_8 }}</p>
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</div>
<div class="car" id="car3">
<p>{{ slot_12 }}</p>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
</div>
</div>
</body>
</html>