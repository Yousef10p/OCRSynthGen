<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 33.0mm; inset-block-start: 23.4mm; inline-size: 76.3mm; block-size: 5.4mm; font-size: 17.2pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 33.0mm; inset-block-start: 42.3mm; inline-size: 49.8mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 57.0mm; inline-size: 152.4mm; block-size: 38.0mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 103.2mm; inline-size: 152.4mm; block-size: 29.0mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 83.9mm; inset-block-start: 136.7mm; inline-size: 50.6mm; block-size: 6.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 148.9mm; inline-size: 152.4mm; block-size: 12.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 53.4mm; inset-block-start: 172.8mm; inline-size: 118.7mm; block-size: 13.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 197.7mm; inline-size: 117.5mm; block-size: 4.0mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 206.1mm; inline-size: 152.4mm; block-size: 37.7mm; font-size: 12.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 107.2mm; inset-block-start: 259.6mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
