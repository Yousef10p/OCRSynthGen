<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 22.4mm; inset-block-start: 7.1mm; inline-size: 27.7mm; block-size: 35.0mm; font-size: 14.2pt"></div>
<div class="box ph" style="inset-inline-start: 87.6mm; inset-block-start: 6.9mm; inline-size: 27.2mm; block-size: 34.7mm; font-size: 14.1pt"></div>
<div class="box ph" style="inset-inline-start: 152.8mm; inset-block-start: 7.4mm; inline-size: 26.9mm; block-size: 34.0mm; font-size: 16.1pt"></div>
<h2 class="box" style="inset-inline-start: 24.0mm; inset-block-start: 55.2mm; inline-size: 41.5mm; block-size: 4.9mm; font-size: 13.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 66.7mm; inline-size: 155.1mm; block-size: 10.6mm; font-size: 15.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 84.0mm; inline-size: 155.4mm; block-size: 22.1mm; font-size: 15.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 112.8mm; inline-size: 154.9mm; block-size: 10.6mm; font-size: 15.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 130.1mm; inline-size: 155.9mm; block-size: 33.7mm; font-size: 15.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 170.5mm; inline-size: 155.7mm; block-size: 33.7mm; font-size: 15.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 210.8mm; inline-size: 155.0mm; block-size: 16.4mm; font-size: 15.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 24.0mm; inset-block-start: 233.8mm; inline-size: 156.2mm; block-size: 16.4mm; font-size: 15.5pt">{{ slot_7 }}</p>
</div></body>
</html>
