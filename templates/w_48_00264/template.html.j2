<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  color: white;
  margin: 0;
  padding: 0;
  background: linear-gradient(to left, orange , blue);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
}

.logo {
  font-size: 24px;
}

nav ul {
  list-style: none;
  display: flex;
}

nav ul li {
  margin: 0 10px;
}

.carousel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 400px;
  padding: 50px;
}

.carousel-item {
  position: relative;
  width: 30%;
  height: 100%;
}

.carousel-item-image {
  width: 100%;
  height: 100%;
  background-color: #222;
}

.carousel-item-button {
  display: block;
  position: absolute;
  bottom: 5%;
  left: 5%;
  padding: 10px 20px;
  background-color: white;
  color: orange;
  text-decoration: none;
  border-radius: 5px;
}

.product {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
}

.product-image {
  width: 40%;
  height: 200px;
  background-color: #222;
}

main {
  display: flex;
  flex-direction: column;
  padding: 20px;
}

main div {
  margin: 20px 0;
}

h2 {
  font-size: 32px;
}

p {
  line-height: 1.6;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
