<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 64.7mm; inline-size: 6.3mm; block-size: 128.9mm; font-size: 20.0pt">{{ slot_0 }}</header><h1 class="box" style="inset-inline-start: 41.4mm; inset-block-start: 66.3mm; inline-size: 132.4mm; block-size: 21.1mm; font-size: 20.7pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 50.5mm; inset-block-start: 98.0mm; inline-size: 114.2mm; block-size: 6.1mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 61.0mm; inset-block-start: 122.4mm; inline-size: 93.4mm; block-size: 4.5mm; font-size: 9.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 51.3mm; inset-block-start: 130.3mm; inline-size: 112.8mm; block-size: 4.5mm; font-size: 9.4pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 99.2mm; inset-block-start: 143.5mm; inline-size: 16.9mm; block-size: 2.7mm; font-size: 10.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 49.4mm; inset-block-start: 153.6mm; inline-size: 118.2mm; block-size: 75.1mm; font-size: 10.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 43.8mm; inset-block-start: 232.6mm; inline-size: 56.3mm; block-size: 3.5mm; font-size: 8.5pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 106.6mm; inset-block-start: 244.5mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
