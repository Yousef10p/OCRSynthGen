<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 25.7mm; inline-size: 5.7mm; block-size: 4.2mm; font-size: 10.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 84.0mm; inset-block-start: 28.5mm; inline-size: 42.2mm; block-size: 13.3mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 43.2mm; inline-size: 50.3mm; block-size: 4.2mm; font-size: 10.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 62.3mm; inset-block-start: 52.1mm; inline-size: 85.5mm; block-size: 14.4mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 70.2mm; inline-size: 155.9mm; block-size: 4.2mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 64.5mm; inset-block-start: 79.1mm; inline-size: 88.0mm; block-size: 23.6mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 106.4mm; inline-size: 28.4mm; block-size: 4.2mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 73.6mm; inset-block-start: 115.3mm; inline-size: 69.8mm; block-size: 27.6mm; font-size: 7.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 151.6mm; inline-size: 159.2mm; block-size: 11.2mm; font-size: 10.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 72.9mm; inset-block-start: 171.5mm; inline-size: 71.0mm; block-size: 54.2mm; font-size: 10.0pt"></div>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 278.9mm; inline-size: 1.8mm; block-size: 4.2mm; font-size: 10.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
