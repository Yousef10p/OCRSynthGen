<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 28.0mm; inset-block-start: 38.3mm; inline-size: 152.6mm; block-size: 7.6mm; font-size: 21.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 48.9mm; inline-size: 159.2mm; block-size: 26.7mm; font-size: 15.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 33.6mm; inset-block-start: 93.6mm; inline-size: 148.1mm; block-size: 92.4mm; font-size: 15.4pt"></div>
<h2 class="box" style="inset-inline-start: 17.9mm; inset-block-start: 211.8mm; inline-size: 173.2mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 65.4mm; inset-block-start: 221.9mm; inline-size: 78.2mm; block-size: 6.1mm; font-size: 17.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 52.7mm; inset-block-start: 232.1mm; inline-size: 104.0mm; block-size: 4.9mm; font-size: 14.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 62.8mm; inset-block-start: 240.6mm; inline-size: 83.8mm; block-size: 2.3mm; font-size: 6.4pt">{{ slot_5 }}</p>
</div></body>
</html>
