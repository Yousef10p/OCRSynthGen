<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 22.1mm; inset-block-start: 12.3mm; inline-size: 26.1mm; block-size: 10.9mm; font-size: 15.5pt"></div>
<h2 class="box" style="inset-inline-start: 22.4mm; inset-block-start: 29.4mm; inline-size: 140.0mm; block-size: 4.9mm; font-size: 14.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 36.0mm; inline-size: 51.0mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 42.6mm; inline-size: 159.9mm; block-size: 9.2mm; font-size: 13.1pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 31.9mm; inset-block-start: 53.5mm; inline-size: 161.3mm; block-size: 9.2mm; font-size: 13.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.9mm; inset-block-start: 63.2mm; inline-size: 140.8mm; block-size: 4.8mm; font-size: 13.7pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 25.6mm; inset-block-start: 77.3mm; inline-size: 27.7mm; block-size: 10.7mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 97.9mm; inline-size: 11.6mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 22.1mm; inset-block-start: 111.3mm; inline-size: 45.6mm; block-size: 14.4mm; font-size: 13.6pt"></div>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 138.4mm; inline-size: 25.8mm; block-size: 9.2mm; font-size: 13.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 149.3mm; inline-size: 17.1mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 155.8mm; inline-size: 29.4mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 260.6mm; inline-size: 167.5mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 264.9mm; inline-size: 43.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 269.3mm; inline-size: 87.3mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 162.3mm; inset-block-start: 286.6mm; inline-size: 37.3mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_12 }}</footer>
</div></body>
</html>
