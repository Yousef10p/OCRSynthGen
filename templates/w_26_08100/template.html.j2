<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f8f8f8;
}

h1 {
    text-align: center;
}

p {
    text-align: center;
    margin: 1em 0;
}

nav {
    margin: 1em 0;
}

.nav-links {
    list-style-type: none;
    padding: 0;
}

.nav-links li {
    display: inline-block;
    margin: 0 1em;
}

.nav-links li a {
    text-decoration: none;
    color: #000;
    transition: all 0.3s ease 0s;
}

.nav-links li a:hover {
    color: #6d6d6d;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    grid-auto-rows: 1fr;
    grid-gap: 1em;
}

.product {
    background: #333;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul class="nav-links">
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
<div class="product-grid">
<div class="product">{{ slot_9 }}</div>
<div class="product">{{ slot_10 }}</div>
<div class="product">{{ slot_11 }}</div>
<div class="product">{{ slot_12 }}</div>
<div class="product">{{ slot_13 }}</div>
<div class="product">{{ slot_14 }}</div>
</div>
</body>
</html>