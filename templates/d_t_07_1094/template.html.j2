<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 10.4mm; inline-size: 112.6mm; block-size: 13.3mm; font-size: 18.8pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 19.8mm; inset-block-start: 24.4mm; inline-size: 27.2mm; block-size: 20.8mm; font-size: 14.7pt"></div>
<h2 class="box" style="inset-inline-start: 20.1mm; inset-block-start: 56.8mm; inline-size: 62.6mm; block-size: 4.4mm; font-size: 12.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 63.2mm; inline-size: 73.3mm; block-size: 10.6mm; font-size: 10.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 20.1mm; inset-block-start: 74.4mm; inline-size: 68.0mm; block-size: 10.6mm; font-size: 7.5pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.1mm; inset-block-start: 85.0mm; inline-size: 78.3mm; block-size: 7.1mm; font-size: 6.7pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 94.2mm; inline-size: 74.4mm; block-size: 7.1mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 20.6mm; inset-block-start: 122.9mm; inline-size: 32.8mm; block-size: 23.4mm; font-size: 16.6pt"></div>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 146.9mm; inline-size: 33.5mm; block-size: 11.3mm; font-size: 10.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 160.3mm; inline-size: 16.3mm; block-size: 7.1mm; font-size: 10.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 245.8mm; inline-size: 72.9mm; block-size: 6.9mm; font-size: 9.7pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 193.7mm; inset-block-start: 283.0mm; inline-size: 7.8mm; block-size: 6.6mm; font-size: 18.7pt">{{ slot_9 }}</footer>
</div></body>
</html>
