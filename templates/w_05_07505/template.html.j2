}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 1rem;
}

main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 80%;
}

section {
    flex-basis: 20%;
    margin: 2rem;
}

.color-rect {
    height: 150px;
    width: 100%;
    background: linear-gradient(to bottom, orange, yellow);
