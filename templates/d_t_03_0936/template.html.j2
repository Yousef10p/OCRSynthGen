<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.0mm; inline-size: 137.3mm; block-size: 141.3mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 143.8mm; inset-block-start: 31.7mm; inline-size: 54.9mm; block-size: 11.1mm; font-size: 15.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 143.8mm; inset-block-start: 45.2mm; inline-size: 43.5mm; block-size: 79.5mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 143.8mm; inset-block-start: 125.6mm; inline-size: 45.7mm; block-size: 71.0mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 151.4mm; inline-size: 86.2mm; block-size: 18.8mm; font-size: 13.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 171.1mm; inline-size: 88.6mm; block-size: 18.8mm; font-size: 13.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 190.9mm; inline-size: 88.1mm; block-size: 18.8mm; font-size: 13.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 48.0mm; inset-block-start: 228.9mm; inline-size: 152.9mm; block-size: 28.4mm; font-size: 40.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 201.2mm; inset-block-start: 268.3mm; inline-size: 3.0mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_7 }}</footer>
</div></body>
</html>
