<h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 87.9mm; inline-size: 69.6mm; block-size: 7.6mm; font-size: 21.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 114.9mm; inset-block-start: 109.5mm; inline-size: 73.4mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 32.2mm; inset-block-start: 111.3mm; inline-size: 41.8mm; block-size: 10.2mm; font-size: 14.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 127.3mm; inline-size: 75.2mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_6 }}</p>
