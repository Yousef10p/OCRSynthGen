<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  margin: 0;
  padding: 0;
  height: 100vh;
}

.slider, .sidebar {
  flex: 1 1 50%;
  overflow: auto;
}

.slider {
  display: flex;
}

.slide {
  height: 100vh;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
}

.sidebar {
  padding: 1em;
}

.left {
  border-left: 1px solid black;
}

.right {
  border-right: 1px solid black;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="slider">
<div class="slide" style="background-color: blue;">{{ slot_0 }}</div>
<div class="slide" style="background-color: red;">{{ slot_1 }}</div>
<div class="slide" style="background-color: green;">{{ slot_2 }}</div>
</div>
<div class="sidebar left">
<h2>{{ slot_3 }}</h2>
<ul>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
<h2>{{ slot_7 }}</h2>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</div>
<div class="sidebar right">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
</body>
</html>