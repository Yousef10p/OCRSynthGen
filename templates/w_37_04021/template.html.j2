}

.contact-form form input, .contact-form form textarea {
    margin-bottom: 10px;
    padding: 10px;
}

.contact-form form button {
    background-color: #000;
    color: #fff;
    padding: 10px 20px;
    border: none;
}

.legal a {
    color: #fff;
    margin-right: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
