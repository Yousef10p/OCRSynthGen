header, footer {
    background-color: #333;
    color: #fff;
    padding: 20px 0;
}

main {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 40px 0;
}

section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

.placeholder {
    width: 100%;
    height: 200px;
    background-color: #ccc;
    border-radius: 5px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

form input, form textarea, form button {
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #ccc;
}

form button {
    background-color: #333;
    color: #fff;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
