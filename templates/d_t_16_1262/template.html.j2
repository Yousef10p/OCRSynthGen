<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 19.1mm; inset-block-start: 12.8mm; inline-size: 28.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 158.9mm; inset-block-start: 12.8mm; inline-size: 13.5mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</header><h1 class="box" style="inset-inline-start: 64.1mm; inset-block-start: 23.0mm; inline-size: 90.7mm; block-size: 7.1mm; font-size: 20.1pt">{{ slot_2 }}</h1>
<p class="box" style="inset-inline-start: 14.3mm; inset-block-start: 36.0mm; inline-size: 190.8mm; block-size: 43.6mm; font-size: 13.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 14.3mm; inset-block-start: 83.0mm; inline-size: 190.2mm; block-size: 29.0mm; font-size: 13.7pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 72.5mm; inset-block-start: 127.3mm; inline-size: 67.5mm; block-size: 7.4mm; font-size: 20.8pt">{{ slot_5 }}</h2>
<div class="box ph" style="inset-inline-start: 54.0mm; inset-block-start: 139.8mm; inline-size: 100.5mm; block-size: 117.3mm; font-size: 19.6pt"></div>
<footer class="box" style="inset-inline-start: 195.1mm; inset-block-start: 262.7mm; inline-size: 2.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_6 }}</footer>
</div></body>
</html>
