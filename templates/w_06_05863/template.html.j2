<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

#menu {
  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  width: 20%;
  background-color: #f8f8f8;
  padding: 20px;
}

#menu a {
  display: block;
  margin-bottom: 10px;
}

#content {
  margin-right: 22%;
  padding: 20px;
}

#main-image {
  display: block;
  margin: 0 auto;
  height: 300px;
  width: 600px;
  background-color: #ddd;
  margin-bottom: 20px;
}

#products, #categories {
  column-count: 2;
  column-gap: 20px;
}

.product, .category {
  margin-bottom: 10px;
  background-color: #f1f1f1;
  padding: 10px;
}

#news p {
  margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="menu">
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
</div>
<div id="content">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div id="products">
<h2>{{ slot_3 }}</h2>
<div class="product">{{ slot_4 }}</div>
<div class="product">{{ slot_5 }}</div>
<div class="product">{{ slot_6 }}</div>
</div>
<div id="categories">
<h2>{{ slot_7 }}</h2>
<div class="category">{{ slot_8 }}</div>
<div class="category">{{ slot_9 }}</div>
<div class="category">{{ slot_10 }}</div>
</div>
<div id="news">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>