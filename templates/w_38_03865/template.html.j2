    border-radius: 5px;
    padding: 10px;
    text-align: center;
}

.product-image {
    height: 200px;
    background-color: #999;
    margin-bottom: 10px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.grid-item {
    background-color: #fdfdfd;
