<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 52.1mm; inset-block-start: 45.3mm; inline-size: 105.9mm; block-size: 5.5mm; font-size: 17.2pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 64.4mm; inset-block-start: 59.7mm; inline-size: 82.5mm; block-size: 4.4mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 88.8mm; inset-block-start: 71.8mm; inline-size: 32.5mm; block-size: 3.9mm; font-size: 12.0pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 85.6mm; inline-size: 6.3mm; block-size: 124.2mm; font-size: 20.0pt">{{ slot_3 }}</header><h2 class="box" style="inset-inline-start: 97.3mm; inset-block-start: 93.4mm; inline-size: 15.4mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 35.1mm; inset-block-start: 100.5mm; inline-size: 140.1mm; block-size: 64.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 35.1mm; inset-block-start: 169.1mm; inline-size: 41.1mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 35.1mm; inset-block-start: 176.4mm; inline-size: 140.0mm; block-size: 8.6mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 255.4mm; inline-size: 159.2mm; block-size: 7.0mm; font-size: 7.5pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 265.3mm; inline-size: 159.2mm; block-size: 7.1mm; font-size: 7.5pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 104.1mm; inset-block-start: 279.3mm; inline-size: 1.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_10 }}</footer>
</div></body>
</html>
