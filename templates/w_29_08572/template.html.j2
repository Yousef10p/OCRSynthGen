<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

#top-header {
  background: blue;
  color: white;
  padding: 10px;
}

#main-container {
  display: flex;
}

#side-menu {
  width: 20%;
  background: lightgrey;
  padding: 20px;
}

#side-menu ul {
  list-style-type: none;
  padding: 0;
}

#side-menu li a {
  text-decoration: none;
  color: black;
}

#side-menu li a:hover {
  color: blue;
}

#content {
  width: 80%;
  padding: 20px;
}

h1, h2 {
  color: blue;
}

hr {
  border: 1px solid blue;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header id="top-header">
<span style="font-size: 22px">{{ slot_0 }}</span>
<span style="background: blue; color: white;">{{ slot_1 }}</span>
</header>
<div id="main-container">
<div id="side-menu">
<h3>{{ slot_2 }}</h3>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
<h3>{{ slot_6 }}</h3>
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</div>
<div id="content">
<h1>{{ slot_10 }}</h1>
<hr>
<h2>{{ slot_11 }}</h2>
<div style="width:200px;height:200px;background:green"></div>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<div style="width:200px;height:200px;background:blue"></div>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<div style="width:200px;height:200px;background:green"></div>
<p>{{ slot_16 }}</p>
</div>
</div>
</body>
</html>