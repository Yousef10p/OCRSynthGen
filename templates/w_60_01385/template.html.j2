    justify-content: space-around;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

main {
    flex: 1;
    padding: 20px;
}

.recommendations, .blog {
    display: flex;
    flex-direction: column;
}

.product, .blog article, .social-media .feed {
