    padding: 1em 0;
    background-color: #f8f9fa;
}

nav {
    background-color: #e9ecef;
}

ul {
    list-style: none;
}

ul li {
    display: inline;
    padding: 1em;
}

.slider section {
    display: inline-block;
    width: 30%;
