<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 190.0mm; inset-block-start: 15.1mm; inline-size: 3.7mm; block-size: 7.9mm; font-size: 22.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 25.4mm; inset-block-start: 18.8mm; inline-size: 96.0mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 37.5mm; inline-size: 103.7mm; block-size: 6.8mm; font-size: 19.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 75.6mm; inline-size: 80.1mm; block-size: 38.9mm; font-size: 13.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 115.9mm; inline-size: 77.5mm; block-size: 49.0mm; font-size: 13.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 118.2mm; inset-block-start: 159.8mm; inline-size: 42.2mm; block-size: 5.6mm; font-size: 8.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 166.4mm; inline-size: 79.9mm; block-size: 59.1mm; font-size: 14.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 176.8mm; inline-size: 80.9mm; block-size: 69.2mm; font-size: 14.0pt">{{ slot_7 }}</p>
