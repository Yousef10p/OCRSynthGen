<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 147.0mm; inset-block-start: 6.7mm; inline-size: 23.3mm; block-size: 21.6mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 186.0mm; inset-block-start: 12.7mm; inline-size: 2.6mm; block-size: 67.1mm; font-size: 40.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 193.0mm; inset-block-start: 12.7mm; inline-size: 13.3mm; block-size: 254.0mm; font-size: 40.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 143.7mm; inset-block-start: 69.8mm; inline-size: 25.3mm; block-size: 130.6mm; font-size: 40.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 153.1mm; inset-block-start: 214.7mm; inline-size: 3.3mm; block-size: 28.8mm; font-size: 40.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 159.7mm; inset-block-start: 220.6mm; inline-size: 3.3mm; block-size: 23.1mm; font-size: 40.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 128.4mm; inset-block-start: 229.1mm; inline-size: 2.6mm; block-size: 24.5mm; font-size: 40.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 185.8mm; inset-block-start: 229.5mm; inline-size: 3.3mm; block-size: 32.2mm; font-size: 40.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 131.9mm; inset-block-start: 232.4mm; inline-size: 2.6mm; block-size: 22.5mm; font-size: 40.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 135.4mm; inset-block-start: 234.2mm; inline-size: 2.6mm; block-size: 16.6mm; font-size: 40.0pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 153.3mm; inset-block-start: 251.1mm; inline-size: 9.9mm; block-size: 23.3mm; font-size: 16.5pt"></div>
</div></body>
</html>
