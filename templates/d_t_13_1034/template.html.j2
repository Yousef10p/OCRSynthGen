<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 84.7mm; inset-block-start: 30.6mm; inline-size: 40.6mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_0 }}</h2>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 41.0mm; inline-size: 161.0mm; block-size: 24.1mm; font-size: 13.7pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 38.1mm; inset-block-start: 70.3mm; inline-size: 147.7mm; block-size: 10.4mm; font-size: 14.7pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 132.5mm; inset-block-start: 116.0mm; inline-size: 39.0mm; block-size: 13.4mm; font-size: 38.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 129.4mm; inline-size: 28.6mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 132.9mm; inset-block-start: 129.4mm; inline-size: 40.1mm; block-size: 10.4mm; font-size: 14.7pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 101.8mm; inset-block-start: 274.7mm; inline-size: 7.4mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_5 }}</footer>
</div></body>
</html>
