}

#services, #testimonials, #appointment {
    width: 80%;
    margin: 20px;
}

.testimonial {
    height: 100px;
    width: 100px;
    margin: auto;
    background-color: lightgray;
}

form {
    display: flex;
    flex-direction: column;
