<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 18.8mm; inset-block-start: 11.8mm; inline-size: 47.6mm; block-size: 8.7mm; font-size: 12.3pt"></div>
<h2 class="box" style="inset-inline-start: 16.1mm; inset-block-start: 36.9mm; inline-size: 142.0mm; block-size: 71.5mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 117.0mm; inline-size: 87.7mm; block-size: 44.1mm; font-size: 15.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 117.0mm; inline-size: 74.7mm; block-size: 15.9mm; font-size: 15.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 134.0mm; inline-size: 87.1mm; block-size: 49.8mm; font-size: 15.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 162.2mm; inline-size: 87.6mm; block-size: 55.4mm; font-size: 15.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 184.8mm; inline-size: 85.4mm; block-size: 32.8mm; font-size: 15.5pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 168.4mm; inset-block-start: 271.0mm; inline-size: 22.8mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 200.0mm; inset-block-start: 270.7mm; inline-size: 1.7mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_7 }}</footer>
</div></body>
</html>
