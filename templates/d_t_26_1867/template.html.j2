<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 22.7mm; inset-block-start: 27.7mm; inline-size: 170.5mm; block-size: 44.8mm; font-size: 15.9pt"></div>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 73.7mm; inline-size: 82.1mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 48.3mm; inset-block-start: 82.8mm; inline-size: 47.4mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 88.1mm; inline-size: 150.6mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 100.1mm; inline-size: 63.5mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 106.1mm; inline-size: 147.7mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 116.3mm; inline-size: 88.6mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 122.3mm; inline-size: 81.9mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 130.1mm; inline-size: 109.7mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_7 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 136.1mm; inline-size: 140.5mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_8 }}</li></ul>
<footer class="box" style="inset-inline-start: 130.8mm; inset-block-start: 266.3mm; inline-size: 62.3mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
