<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 41.7mm; inset-block-start: 37.3mm; inline-size: 148.1mm; block-size: 18.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 60.2mm; inline-size: 108.6mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 31.8mm; inset-block-start: 75.4mm; inline-size: 158.0mm; block-size: 11.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 92.4mm; inline-size: 164.5mm; block-size: 11.1mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 81.4mm; inset-block-start: 107.9mm; inline-size: 108.5mm; block-size: 10.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 122.8mm; inline-size: 164.5mm; block-size: 55.4mm; font-size: 12.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 30.7mm; inset-block-start: 190.4mm; inline-size: 77.5mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 202.5mm; inline-size: 164.5mm; block-size: 11.1mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 217.2mm; inline-size: 157.8mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 59.7mm; inset-block-start: 226.9mm; inline-size: 130.2mm; block-size: 5.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 239.3mm; inline-size: 90.0mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 62.4mm; inset-block-start: 249.9mm; inline-size: 127.5mm; block-size: 10.4mm; font-size: 8.0pt"></div>
<footer class="box" style="inset-inline-start: 103.5mm; inset-block-start: 266.9mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
