<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
}


nav {
    position: fixed;
    top: 0;
    width: 100%;
    display: flex;
    justify-content: space-around;
    background-color: #f8f9fa;
    padding: 15px 0;
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
    width: 100%;
}

nav ul li {
    cursor: pointer;
}


.img-rect {
    width: 100px;
    height: 100px;
    background-color: skyblue;
    margin: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 2px solid #000;
    border-radius: 10px;
}

.slideshow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: 90%;
    margin-top: 80px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li>{{ slot_0 }}</li>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
</ul>
</nav>
<div class="slideshow">
<div class="img-rect"> {{ slot_3 }} </div>
<div class="img-rect"> {{ slot_4 }} </div>
<div class="img-rect"> {{ slot_5 }} </div>
<div class="img-rect"> {{ slot_6 }} </div>
<div class="img-rect"> {{ slot_7 }} </div>
<div class="img-rect"> {{ slot_8 }} </div>
<div class="img-rect"> {{ slot_9 }} </div>
<div class="img-rect"> {{ slot_10 }} </div>
<div class="img-rect"> {{ slot_11 }} </div>
<div class="img-rect"> {{ slot_12 }} </div>
<div class="img-rect"> {{ slot_13 }} </div>
<div class="img-rect"> {{ slot_14 }} </div>
</div>
</body>
</html>