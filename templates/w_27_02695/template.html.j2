    height: 50px;
    width: 100%;
    text-align: center;
}

main {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
}

.service {
    border: 2px solid #000;
    padding: 10px;
    margin: 10px;
    flex: 1;
}

aside {
    display: flex;
