    justify-content: space-around;
    width: 100%;
}

.widget {
    border: 2px solid #000;
    padding: 10px;
    margin: 10px;
    flex: 1;
}

.widget ul {
    list-style: none;
    padding: 0;
}

.widget a {
    color: #000;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
