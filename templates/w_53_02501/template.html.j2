<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

nav {
  position: fixed;
  top: 0;
  right: 0;
  width: 200px;
  height: 100%;
  background-color: blue;
  color: white;
}

nav ul {
  list-style: none;
}

nav li {
  margin-bottom: 10px;
}

nav a {
  color: white;
  text-decoration: none;
}

.hero {
  height: 500px;
  background-color: orange;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  animation: slide-in 2s;
}

.button {
  border: 2px solid white;
  padding: 10px 20px;
  margin-top: 50px;
  transition: background-color 0.3s;
}

.button:hover {
  background-color: green;
}

#sports, #politics, #security, #other {
  padding: 20px;
}

@keyframes slide-in {
  0% { transform: translateX(100%); }
  100% { transform: translateX(0%); }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<section class="hero">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div class="button">{{ slot_7 }}</div>
</section>
<section id="sports">
<h2>{{ slot_8 }}</h2>
<div class="content">{{ slot_9 }}</div>
</section>
<section id="politics">
<h2>{{ slot_10 }}</h2>
<div class="content">{{ slot_11 }}</div>
</section>
<section id="security">
<h2>{{ slot_12 }}</h2>
<div class="content">{{ slot_13 }}</div>
</section>
<section id="other">
<h2>{{ slot_14 }}</h2>
<div class="content">{{ slot_15 }}</div>
</section>
</body>
</html>