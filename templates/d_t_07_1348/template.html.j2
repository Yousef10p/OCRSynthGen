<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 14.1mm; inline-size: 143.7mm; block-size: 7.1mm; font-size: 20.2pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 26.9mm; inline-size: 60.4mm; block-size: 4.0mm; font-size: 5.6pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 12.7mm; inset-block-start: 31.1mm; inline-size: 39.3mm; block-size: 4.0mm; font-size: 5.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 37.6mm; inline-size: 89.2mm; block-size: 54.7mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 37.7mm; inline-size: 89.9mm; block-size: 25.1mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 65.2mm; inline-size: 88.2mm; block-size: 12.4mm; font-size: 11.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 80.0mm; inline-size: 90.7mm; block-size: 37.8mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 94.7mm; inline-size: 90.6mm; block-size: 50.5mm; font-size: 11.9pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 141.3mm; inset-block-start: 122.4mm; inline-size: 53.9mm; block-size: 15.2mm; font-size: 14.4pt"></div>
<p class="box" style="inset-inline-start: 109.0mm; inset-block-start: 142.3mm; inline-size: 35.0mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 147.6mm; inline-size: 89.7mm; block-size: 80.1mm; font-size: 12.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 8.2mm; inset-block-start: 267.7mm; inline-size: 2.8mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_10 }}</footer>
</div></body>
</html>
