footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    background-color: #212121;
    color: #fff;
    display: flex;
    justify-content: space-around;
    align-items: center;
}

footer input {
    flex: 1;
}

footer a { text-decoration: none; color: #fff; }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
