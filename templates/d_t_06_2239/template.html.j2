<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 19.8mm; inset-block-start: 19.0mm; inline-size: 49.2mm; block-size: 67.1mm; font-size: 13.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 81.6mm; inset-block-start: 19.0mm; inline-size: 52.2mm; block-size: 67.0mm; font-size: 13.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 143.2mm; inset-block-start: 19.0mm; inline-size: 49.3mm; block-size: 67.0mm; font-size: 13.6pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 93.3mm; inline-size: 198.5mm; block-size: 8.7mm; font-size: 24.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 109.2mm; inline-size: 51.1mm; block-size: 62.2mm; font-size: 13.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 81.6mm; inset-block-start: 109.2mm; inline-size: 50.8mm; block-size: 47.5mm; font-size: 13.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 143.2mm; inset-block-start: 109.2mm; inline-size: 47.4mm; block-size: 62.2mm; font-size: 13.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 81.6mm; inset-block-start: 160.6mm; inline-size: 50.0mm; block-size: 8.6mm; font-size: 12.1pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 78.9mm; inset-block-start: 181.8mm; inline-size: 136.4mm; block-size: 94.3mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 191.1mm; inline-size: 49.2mm; block-size: 59.4mm; font-size: 14.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 10.8mm; inset-block-start: 270.4mm; inline-size: 1.4mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
