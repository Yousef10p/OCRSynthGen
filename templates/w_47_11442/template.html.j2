}

#services {
    background-color: mediumseagreen;
}

#about {
    background-color: dodgerblue;
}

#contact {
    background-color: darkorange;
}

.social-links {
    margin-top: 50px;
}

.social-links a {
    color: white;
    margin: 0 15px;
}

footer {
    text-align: center;
    padding: 20px;
    background-color: black;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
