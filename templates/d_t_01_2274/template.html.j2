<h2 class="box" style="inset-inline-start: 13.0mm; inset-block-start: 78.6mm; inline-size: 32.9mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 83.6mm; inline-size: 29.7mm; block-size: 32.0mm; font-size: 13.0pt">{{ slot_5 }}</p>
