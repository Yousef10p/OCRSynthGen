<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 81.8mm; inset-block-start: 33.2mm; inline-size: 50.7mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 63.8mm; inset-block-start: 41.9mm; inline-size: 87.3mm; block-size: 8.3mm; font-size: 7.9pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 73.7mm; inset-block-start: 63.2mm; inline-size: 66.7mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 74.5mm; inset-block-start: 72.6mm; inline-size: 65.5mm; block-size: 11.1mm; font-size: 10.5pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 67.3mm; inset-block-start: 88.1mm; inline-size: 80.0mm; block-size: 51.9mm; font-size: 24.5pt"></div>
<h2 class="box" style="inset-inline-start: 80.7mm; inset-block-start: 156.8mm; inline-size: 54.1mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 72.2mm; inset-block-start: 166.2mm; inline-size: 72.9mm; block-size: 7.1mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 67.3mm; inset-block-start: 181.3mm; inline-size: 79.4mm; block-size: 52.4mm; font-size: 29.7pt"></div>
</div></body>
</html>
