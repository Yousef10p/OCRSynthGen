<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}
#banner {
  background-color: #f2f2f2;
  height: 20em;
  text-align: center;
  line-height: 20em;
  font-size: 2em;
}
#navbar ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background-color: #333;
}
#navbar li {
  float: right;
}
#navbar li a {
  display: block;
  color: white;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}
#services, #packages {
  margin: 20px;
}
h1 {
  text-align: center;
  margin-bottom: 20px;
}
.service-grid, .package-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-gap: 10px;
}
.service, .package {
  background-color: #f2f2f2;
  text-align: center;
  line-height: 5em;
  font-size: 1.5em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="banner">{{ slot_0 }}</div>
<div id="navbar">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div id="services">
<h1>{{ slot_6 }}</h1>
<div class="service-grid">
<div class="service">{{ slot_7 }}</div>
<div class="service">{{ slot_8 }}</div>
<div class="service">{{ slot_9 }}</div>
<div class="service">{{ slot_10 }}</div>
<div class="service">{{ slot_11 }}</div>
</div>
</div>
<div id="packages">
<h1>{{ slot_12 }}</h1>
<div class="package-grid">
<div class="package">{{ slot_13 }}</div>
<div class="package">{{ slot_14 }}</div>
<div class="package">{{ slot_15 }}</div>
<div class="package">{{ slot_16 }}</div>
<div class="package">{{ slot_17 }}</div>
</div>
</div>
</body>
</html>