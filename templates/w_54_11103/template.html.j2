}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.work-examples, .blog-post, .social-icons {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.work-image, .linkedin-image, .instagram-image {
  width: 100px;
  height: 100px;
  background-color: blue;
}


@media screen and (max-width: 768px) {
  .work-examples, .blog-post, .social-icons {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (max-width: 480px) {
  .work-examples, .blog-post, .social-icons {
    grid-template-columns: 1fr;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
