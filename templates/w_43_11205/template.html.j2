<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div class="cta-container">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<a class="cta-button">{{ slot_6 }}</a>
</div>
</header>
<section class="products">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>
</section>
<footer>
<nav>
<ul>
