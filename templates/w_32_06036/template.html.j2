  background-color: #333;
  color: #fff;
  padding: 10px;
}

header h1 {
  margin: 0;
}

header ul {
  list-style-type: none;
  padding: 0;
  display: flex;
}

header ul li {
  margin-left: 10px;
}

header ul li a {
  color: #fff;
  text-decoration: none;
}

section {
  margin: 20px;
}

.image-placeholder {
  height: 200px;
  background-color: #ddd;
  margin-bottom: 10px;
}

form {
  display: grid;
  grid-template-columns: auto 200px;
  gap: 10px;
}

form label {
  align-self: center;
}

form button {
  grid-column: span 2;
}

footer {
  background-color: #333;
  color: #fff;
  padding: 10px;
  text-align: center;
  position: fixed;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
