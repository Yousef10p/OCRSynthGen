<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 112.1mm; inset-block-start: 0.0mm; inline-size: 35.2mm; block-size: 38.4mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 75.6mm; inline-size: 41.9mm; block-size: 92.2mm; font-size: 11.9pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 112.2mm; inset-block-start: 75.5mm; inline-size: 57.9mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 81.9mm; inline-size: 84.0mm; block-size: 23.2mm; font-size: 16.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 107.3mm; inline-size: 82.7mm; block-size: 42.2mm; font-size: 17.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 151.8mm; inline-size: 84.7mm; block-size: 54.9mm; font-size: 17.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 75.4mm; inset-block-start: 225.9mm; inline-size: 121.8mm; block-size: 20.4mm; font-size: 28.9pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 171.8mm; inset-block-start: 266.3mm; inline-size: 31.4mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
