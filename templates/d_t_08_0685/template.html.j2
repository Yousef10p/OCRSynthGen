<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 31.4mm; inset-block-start: 26.4mm; inline-size: 152.1mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 94.8mm; inset-block-start: 38.5mm; inline-size: 26.3mm; block-size: 6.1mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 100.1mm; inset-block-start: 47.1mm; inline-size: 15.7mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 56.7mm; inset-block-start: 54.8mm; inline-size: 133.7mm; block-size: 40.6mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 34.8mm; inset-block-start: 110.9mm; inline-size: 155.7mm; block-size: 111.4mm; font-size: 10.9pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 229.5mm; inline-size: 71.5mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 239.1mm; inline-size: 165.1mm; block-size: 11.0mm; font-size: 10.9pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 106.0mm; inset-block-start: 261.7mm; inline-size: 3.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</footer>
</div></body>
</html>
