}

nav ul {
    display: flex;
    justify-content: center;
}

nav li {
    margin: 0 10px;
}

nav ul ul {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background-color: white;
    padding: 10px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

nav ul li:hover > ul {
    display: block;
}


#hero, #featured-products, #reviews {
    margin: 20px;
}

.product, .review {
    border: 1px solid #333;
    margin: 20px 0;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
