<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 119.9mm; inset-block-start: 31.7mm; inline-size: 29.6mm; block-size: 11.3mm; font-size: 16.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 21.7mm; inset-block-start: 98.0mm; inline-size: 35.1mm; block-size: 31.2mm; font-size: 14.7pt"></div>
<h2 class="box" style="inset-inline-start: 20.1mm; inset-block-start: 141.8mm; inline-size: 38.3mm; block-size: 12.2mm; font-size: 17.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 77.3mm; inset-block-start: 143.8mm; inline-size: 51.2mm; block-size: 57.2mm; font-size: 13.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 134.4mm; inset-block-start: 143.8mm; inline-size: 52.7mm; block-size: 52.3mm; font-size: 13.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 158.3mm; inline-size: 52.7mm; block-size: 62.2mm; font-size: 13.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 77.3mm; inset-block-start: 205.2mm; inline-size: 52.4mm; block-size: 57.2mm; font-size: 13.5pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 147.2mm; inset-block-start: 205.6mm; inline-size: 37.9mm; block-size: 38.8mm; font-size: 15.7pt"></div>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 224.6mm; inline-size: 51.9mm; block-size: 27.6mm; font-size: 13.0pt">{{ slot_6 }}</p>
</div></body>
</html>
