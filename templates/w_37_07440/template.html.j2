}

h1, h2 {
    font-weight: bold;
}

nav, footer {
    background-color: #f8f8f8;
    padding: 10px;
}

nav ul, footer ul {
    list-style: none;
    padding: 0;
}

nav ul li, footer ul li {
    display: inline;
    margin-left: 10px;
}

nav a, footer a {
    text-decoration: none;
    color: #333;
}

form {
    margin: 20px 0;
}

form input, form button {
    padding: 10px;
    border: 1px solid #ddd;
}

form button {
    cursor: pointer;
    background-color: #f8f8f8;
}

article img, #privacy img {
    width: 200px;
    height: 200px;
    background-color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
