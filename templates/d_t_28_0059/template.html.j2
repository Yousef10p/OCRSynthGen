<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 40.8mm; inline-size: 198.2mm; block-size: 16.0mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 59.4mm; inline-size: 196.8mm; block-size: 9.5mm; font-size: 13.0pt">{{ slot_5 }}</p>
