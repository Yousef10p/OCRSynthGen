<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 96.1mm; inline-size: 81.8mm; block-size: 7.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 106.6mm; inset-block-start: 96.1mm; inline-size: 81.9mm; block-size: 153.0mm; font-size: 10.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 21.5mm; inset-block-start: 110.8mm; inline-size: 78.5mm; block-size: 111.3mm; font-size: 5.4pt"></div>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 227.9mm; inline-size: 81.8mm; block-size: 17.9mm; font-size: 9.0pt">{{ slot_5 }}</p>
