}

label, input, textarea {
	margin: 0.5rem 0;
}

input[type="submit"] {
	cursor: pointer;
	padding: 0.5rem;
	background-color: #333;
	color: #fff;
	border: none;
}


footer {
	background-color: #333;
	color: #fff;
	padding: 1rem;
	text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
