<ul class="box" style="inset-inline-start: 22.0mm; inset-block-start: 42.7mm; inline-size: 104.9mm; block-size: 7.2mm; font-size: 20.3pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.0mm; inset-block-start: 53.0mm; inline-size: 78.6mm; block-size: 7.3mm; font-size: 20.6pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 28.0mm; inset-block-start: 63.6mm; inline-size: 162.6mm; block-size: 18.9mm; font-size: 17.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 45.5mm; inset-block-start: 91.4mm; inline-size: 120.2mm; block-size: 12.3mm; font-size: 17.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 80.5mm; inset-block-start: 109.6mm; inline-size: 49.0mm; block-size: 6.3mm; font-size: 17.7pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 121.3mm; inline-size: 209.9mm; block-size: 121.5mm; font-size: 15.0pt"></div>
