}
nav ul {
    display: flex;
    justify-content: space-around;
    width: 100%;
}
nav a {
    color: #fff;
    text-decoration: none;
}
header, .content {
    margin: 1em;
}

.content h2, footer {
    margin-bottom: 1em;
}

.fake-img {
    width: 50%;
    height: 200px;
    background-color: #cecece;
}

form {
    margin: 1em;
    display: flex;
    flex-direction: column;
}
input, textarea {
    margin-bottom: 1em;
    padding: 0.5em;
}
button {
    padding: 0.5em;
    background-color: #444;
    color: #fff;
    border: none;
    cursor: pointer;
}
footer {
    background-color: #444;
    color: #fff;
    padding: 1em;
    text-align: center;
    position: absolute;
    width: 100%;
    bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
