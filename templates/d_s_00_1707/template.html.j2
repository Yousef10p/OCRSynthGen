<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 77.4mm; inline-size: 159.2mm; block-size: 20.1mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 101.4mm; inline-size: 134.2mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 111.9mm; inline-size: 159.1mm; block-size: 10.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 125.9mm; inline-size: 159.1mm; block-size: 13.0mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 40.1mm; inset-block-start: 145.8mm; inline-size: 130.0mm; block-size: 6.1mm; font-size: 10.0pt"></div>
