<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 47.6mm; inline-size: 166.5mm; block-size: 15.8mm; font-size: 22.4pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 81.4mm; inline-size: 162.7mm; block-size: 46.8mm; font-size: 19.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 27.7mm; inset-block-start: 131.3mm; inline-size: 162.9mm; block-size: 32.6mm; font-size: 18.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 27.8mm; inset-block-start: 166.9mm; inline-size: 162.6mm; block-size: 25.5mm; font-size: 18.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 27.8mm; inset-block-start: 195.4mm; inline-size: 161.3mm; block-size: 39.7mm; font-size: 18.8pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 163.5mm; inset-block-start: 283.5mm; inline-size: 25.5mm; block-size: 2.1mm; font-size: 5.8pt">{{ slot_5 }}</footer>
</div></body>
</html>
