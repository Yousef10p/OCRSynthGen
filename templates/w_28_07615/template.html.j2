<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
	background-color: #f2f2f2;
	margin: 0;
	padding: 0;
	font-family: var(--font-body);
}

.left-column {
	float: right;
	width: 20%;
	height: 100vh;
	background-color: #fff;
	padding: 20px;
}

.main-content {
	float: left;
	width: 76%;
	height: 100vh;
	background-color: #ddd;
	padding: 20px;
}

.product {
	width: 100%;
	height: 100px;
	background-color: #aaa;
	margin: 10px 0;
}

h1 {
	color: #333;
	text-transform: uppercase;
	letter-spacing: 2px;
}

li {
	padding: 10px 0;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="left-column">
<h1>{{ slot_0 }}</h1>
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ul>
<h1>{{ slot_4 }}</h1>
<ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
</ul>
</div>
<div class="main-content">
<h1>{{ slot_10 }}</h1>
<div class="product">{{ slot_11 }}</div>
<div class="product">{{ slot_12 }}</div>
<div class="product">{{ slot_13 }}</div>
<h1>{{ slot_14 }}</h1>
<div class="product">{{ slot_15 }}</div>
<div class="product">{{ slot_16 }}</div>
<div class="product">{{ slot_17 }}</div>
<h1>{{ slot_18 }}</h1>
<div class="product">{{ slot_19 }}</div>
<div class="product">{{ slot_20 }}</div>
<div class="product">{{ slot_21 }}</div>
</div>
</body>
</html>