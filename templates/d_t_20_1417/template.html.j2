<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 31.3mm; inline-size: 13.5mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 40.5mm; inline-size: 3.2mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 47.4mm; inline-size: 46.0mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 51.2mm; inline-size: 24.6mm; block-size: 3.6mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 58.2mm; inline-size: 3.6mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 64.6mm; inline-size: 24.6mm; block-size: 3.6mm; font-size: 10.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 71.6mm; inline-size: 3.6mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 78.5mm; inline-size: 4.7mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 82.3mm; inline-size: 23.9mm; block-size: 3.6mm; font-size: 10.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 103.0mm; inset-block-start: 279.3mm; inline-size: 3.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
