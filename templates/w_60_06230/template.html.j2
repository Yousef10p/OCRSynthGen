  font-family: var(--font-body);
}

input[type="submit"] {
    width: 100%;
    padding: 10px;
    background-color: #3D3F46;
    color: #FFF200;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease-in-out;
}

input[type="submit"]:hover {
    background-color: #778186;
}


@media (max-width: 320px) {
  body {
    font-size: 12px;
  }
}

@media (max-width: 600px) {
  body {
    font-size: 16px;
  }
}

@media (max-width: 1280px) {
  body {
    font-size: 24px;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
