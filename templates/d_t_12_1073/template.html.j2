<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 119.0mm; inset-block-start: 13.1mm; inline-size: 64.2mm; block-size: 131.5mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 10.8mm; inset-block-start: 18.2mm; inline-size: 85.3mm; block-size: 62.8mm; font-size: 10.6pt"></div>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 85.1mm; inline-size: 89.9mm; block-size: 12.2mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 103.5mm; inline-size: 90.0mm; block-size: 12.9mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 118.1mm; inline-size: 90.0mm; block-size: 31.3mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 151.1mm; inline-size: 90.0mm; block-size: 22.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 107.4mm; inset-block-start: 149.3mm; inline-size: 90.0mm; block-size: 20.7mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 174.8mm; inline-size: 90.0mm; block-size: 26.7mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 107.4mm; inset-block-start: 176.3mm; inline-size: 92.4mm; block-size: 54.3mm; font-size: 12.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 10.5mm; inset-block-start: 207.8mm; inline-size: 35.8mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 213.9mm; inline-size: 92.4mm; block-size: 63.4mm; font-size: 12.0pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 107.4mm; inset-block-start: 236.1mm; inline-size: 46.8mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 107.4mm; inset-block-start: 241.5mm; inline-size: 92.3mm; block-size: 17.6mm; font-size: 12.0pt">{{ slot_10 }}</p>
<h2 class="box" style="inset-inline-start: 107.4mm; inset-block-start: 264.3mm; inline-size: 26.4mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_11 }}</h2>
<p class="box" style="inset-inline-start: 112.1mm; inset-block-start: 269.5mm; inline-size: 85.4mm; block-size: 7.7mm; font-size: 10.9pt">{{ slot_12 }}</p>
</div></body>
</html>
