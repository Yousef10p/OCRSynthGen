<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="right-content">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div class="img-placeholder ph"></div>
<h2>{{ slot_8 }}</h2>
<ul>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
</ul>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>

<div class="scheduling">{{ slot_15 }}</div>
</div>
</div>
</body>
</html>