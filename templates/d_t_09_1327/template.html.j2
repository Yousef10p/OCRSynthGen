<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 73.8mm; inline-size: 159.1mm; block-size: 10.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 87.8mm; inline-size: 159.1mm; block-size: 10.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 30.8mm; inset-block-start: 101.4mm; inline-size: 82.7mm; block-size: 6.5mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 72.7mm; inset-block-start: 114.7mm; inline-size: 111.9mm; block-size: 6.1mm; font-size: 10.0pt"></div>
