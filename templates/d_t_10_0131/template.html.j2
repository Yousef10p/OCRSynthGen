<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 100.9mm; inline-size: 165.1mm; block-size: 44.5mm; font-size: 12.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 71.1mm; inset-block-start: 161.7mm; inline-size: 75.7mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 174.4mm; inline-size: 165.1mm; block-size: 36.4mm; font-size: 12.0pt">{{ slot_6 }}</p>
