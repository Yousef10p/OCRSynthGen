<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  background-color: #f0f0f0;
}

.header {
  background-color: #333;
  color: white;
  padding: 20px;
  text-align: center;
}

.header h1 {
  margin: 0;
  font-size: 2em;
}

.header p {
  font-size: 1.2em;
  margin: 0;
}

.menu {
  background-color: #f8f8f8;
  padding: 10px 0;
  text-align: center;
}

.menu ul {
  margin: 0;
  padding: 0;
}

.menu li {
  display: inline;
  margin: 0 10px;
}

.menu a {
  text-decoration: none;
}

.content {
  margin: 20px;
}

.content p {
  line-height: 1.6em;
}

.footer {
  background-color: #333;
  color: white;
  text-align: center;
  padding: 10px 0;
  position: fixed;
  width: 100%;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</div>
<div class="menu">
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</div>
<div class="content">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<div class="footer">
<p>{{ slot_14 }}</p>
</div>
</body>
</html>