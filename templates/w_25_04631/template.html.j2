    height: 200px;
}
main {
    background-color: #ff9800;
}
article {
    background-color: #9c27b0;
}
#sidebar-left {
    grid-row: 2;
}
#sidebar-right {
    grid-row: 2;
    grid-column: 3;
}
input, button {
    width: 100%;
    margin: 5px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
