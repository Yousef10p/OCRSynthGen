body {
    display: grid;
    grid-template-columns: 1fr 3fr 1fr;
    font-family: var(--font-body);
    color: white;
    grid-gap: 10px;
    padding: 0;
    margin: 0;
}
header, footer {
    grid-column: 1 / 4;
    height: 100px;
    background-color: #f44336;
    display: flex;
    justify-content: center;
    align-items: center;
}
aside {
    background-color: #2196f3;
}
#hero-img {
