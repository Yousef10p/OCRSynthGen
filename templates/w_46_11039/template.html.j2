<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  color: #333;
}

nav {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f8f8f8;
  padding: 20px;
}

nav ul {
  list-style-type: none;
  display: flex;
}

nav ul li {
  margin: 0 10px;
}

nav ul li a {
  text-decoration: none;
  color: #333;
}

.hero-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200px;
  margin: 20px;
}

.hero-item {
  height: 100px;
  width: 100px;
  margin: 0 10px;
  background-color: #f8f8f8;
  display: flex;
  justify-content: center;
  align-items: center;
}

.user-profiles {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 20px;
}

.user-profile {
  height: 100px;
  width: 100px;
  background-color: #f8f8f8;
  display: flex;
  justify-content: center;
  align-items: center;
}

.success-stories, .dating-tips {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin: 20px;
}

.success-stories p, .dating-tips p {
  margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div class="hero-container">
<div class="hero-item">{{ slot_4 }}</div>
<div class="hero-item">{{ slot_5 }}</div>
<div class="hero-item">{{ slot_6 }}</div>
<div class="hero-item">{{ slot_7 }}</div>
</div>
<div class="user-profiles">
<div class="user-profile">{{ slot_8 }}</div>
<div class="user-profile">{{ slot_9 }}</div>
<div class="user-profile">{{ slot_10 }}</div>
</div>
<div class="success-stories">
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
</div>
<div class="dating-tips">
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
</div>
</body>
</html>