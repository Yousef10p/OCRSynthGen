<h2 class="box" style="inset-inline-start: 23.7mm; inset-block-start: 225.7mm; inline-size: 36.6mm; block-size: 5.9mm; font-size: 14.3pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 23.7mm; inset-block-start: 237.5mm; inline-size: 168.6mm; block-size: 19.1mm; font-size: 10.9pt">{{ slot_10 }}</p>
