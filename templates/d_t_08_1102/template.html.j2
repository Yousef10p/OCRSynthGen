<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 32.3mm; inset-block-start: 41.1mm; inline-size: 151.4mm; block-size: 19.0mm; font-size: 17.2pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 67.4mm; inline-size: 152.1mm; block-size: 12.5mm; font-size: 12.0pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 15.3mm; inset-block-start: 78.9mm; inline-size: 6.0mm; block-size: 136.8mm; font-size: 20.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 86.0mm; inline-size: 119.4mm; block-size: 5.0mm; font-size: 8.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 38.9mm; inset-block-start: 93.5mm; inline-size: 138.1mm; block-size: 12.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 57.8mm; inset-block-start: 108.5mm; inline-size: 100.2mm; block-size: 5.0mm; font-size: 8.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 97.6mm; inset-block-start: 123.2mm; inline-size: 20.7mm; block-size: 5.0mm; font-size: 12.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 100.7mm; inset-block-start: 139.4mm; inline-size: 14.5mm; block-size: 4.1mm; font-size: 10.0pt">{{ slot_7 }}</h2>
