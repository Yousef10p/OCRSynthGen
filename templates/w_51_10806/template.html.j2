    padding: 1em;
    background: #eee;
}

#left{flex: 0 0 15em;}

#right{flex: 0 0 15em;}

aside h2{
    font-size: 1.2em;
    margin-bottom: 0.5em;
}

form{
    display: flex;
    gap: 0.5em;
}

input[type="email"]{
    flex: 1;
    padding: 0.5em;
}

button[type="submit"]{
    padding: 0.5em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
