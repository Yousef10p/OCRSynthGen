<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 54.1mm; inset-block-start: 29.6mm; inline-size: 127.2mm; block-size: 56.7mm; font-size: 16.1pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 41.4mm; inset-block-start: 90.1mm; inline-size: 140.1mm; block-size: 79.3mm; font-size: 16.1pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 41.4mm; inset-block-start: 173.2mm; inline-size: 140.1mm; block-size: 45.5mm; font-size: 16.1pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 41.4mm; inset-block-start: 222.4mm; inline-size: 139.9mm; block-size: 39.9mm; font-size: 16.1pt"><li>{{ slot_3 }}</li></ul>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 268.2mm; inline-size: 103.2mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 180.4mm; inset-block-start: 268.2mm; inline-size: 3.5mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
