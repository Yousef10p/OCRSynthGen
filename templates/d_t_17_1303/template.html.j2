<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 14.8mm; inset-block-start: 15.4mm; inline-size: 174.9mm; block-size: 64.1mm; font-size: 11.4pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 81.0mm; inline-size: 132.7mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 88.3mm; inline-size: 86.5mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 88.3mm; inline-size: 86.5mm; block-size: 8.7mm; font-size: 8.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 101.6mm; inline-size: 30.3mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 107.2mm; inline-size: 86.5mm; block-size: 44.8mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 115.4mm; inline-size: 86.5mm; block-size: 31.2mm; font-size: 12.6pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 33.4mm; inset-block-start: 154.1mm; inline-size: 136.1mm; block-size: 92.7mm; font-size: 23.9pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 249.2mm; inline-size: 176.3mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 5.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_7 }}</footer>
</div></body>
</html>
