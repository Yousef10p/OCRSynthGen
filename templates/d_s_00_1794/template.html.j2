<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 248.0mm; inline-size: 80.6mm; block-size: 2.9mm; font-size: 6.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 252.5mm; inline-size: 53.4mm; block-size: 2.9mm; font-size: 6.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 257.1mm; inline-size: 61.9mm; block-size: 2.9mm; font-size: 6.0pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 104.8mm; inset-block-start: 266.9mm; inline-size: 1.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_12 }}</footer>
</div></body>
</html>
