<p class="box" style="inset-inline-start: 54.9mm; inset-block-start: 67.6mm; inline-size: 105.2mm; block-size: 10.7mm; font-size: 9.4pt">{{ slot_4 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 70.4mm; inline-size: 6.3mm; block-size: 120.1mm; font-size: 20.0pt">{{ slot_5 }}</header><p class="box" style="inset-inline-start: 87.2mm; inset-block-start: 81.2mm; inline-size: 40.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 99.8mm; inset-block-start: 90.0mm; inline-size: 15.7mm; block-size: 3.1mm; font-size: 12.0pt">{{ slot_7 }}</h2>
