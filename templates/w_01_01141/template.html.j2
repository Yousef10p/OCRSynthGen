<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.content {
    padding: 10px;
    background-color: #f2f2f2;
    color: #333;
}

.cta {
    margin: 20px 0;
    text-align: center;
}

.button {
    display: inline-block;
    background-color: #007BFF;
    color: #fff;
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
}

.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 300px;
    padding: 10px;
    background-color: #f2f2f2;
    color: #333;
}

.sidebar h3 {
    margin-bottom: 10px;
}

.sidebar li {
    margin-bottom: 5px;
}

.sidebar a {
    color: #333;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
</header>
<div class="content">
<p>{{ slot_1 }}</p>
</div>
<div class="cta">
<a class="button">{{ slot_2 }}</a>
</div>
<aside class="sidebar">
<h3>{{ slot_3 }}</h3>
<ul>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
<h3>{{ slot_7 }}</h3>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
<h3>{{ slot_11 }}</h3>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</aside>
</body>
</html>