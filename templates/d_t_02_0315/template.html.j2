<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 31.3mm; inset-block-start: 37.4mm; inline-size: 81.1mm; block-size: 59.9mm; font-size: 15.4pt"></div>
<div class="box ph" style="inset-inline-start: 116.5mm; inset-block-start: 37.4mm; inline-size: 80.6mm; block-size: 60.2mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 99.3mm; inline-size: 37.6mm; block-size: 2.6mm; font-size: 7.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 116.8mm; inset-block-start: 99.3mm; inline-size: 30.9mm; block-size: 2.6mm; font-size: 7.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 117.6mm; inline-size: 74.9mm; block-size: 30.7mm; font-size: 12.4pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 116.4mm; inset-block-start: 117.6mm; inline-size: 25.1mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 116.4mm; inset-block-start: 122.2mm; inline-size: 80.4mm; block-size: 26.2mm; font-size: 12.4pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 116.4mm; inset-block-start: 151.8mm; inline-size: 80.0mm; block-size: 26.2mm; font-size: 12.4pt"><li>{{ slot_5 }}</li></ul>
