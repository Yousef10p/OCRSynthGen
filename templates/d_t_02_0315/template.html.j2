<ul class="box" style="inset-inline-start: 116.4mm; inset-block-start: 181.5mm; inline-size: 80.0mm; block-size: 21.6mm; font-size: 12.2pt"><li>{{ slot_7 }}</li></ul>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 196.3mm; inline-size: 78.9mm; block-size: 26.2mm; font-size: 12.4pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 116.4mm; inset-block-start: 208.0mm; inline-size: 79.1mm; block-size: 21.6mm; font-size: 12.2pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 228.8mm; inline-size: 79.1mm; block-size: 21.6mm; font-size: 12.2pt">{{ slot_10 }}</p>
