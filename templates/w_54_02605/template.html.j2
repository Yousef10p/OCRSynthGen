    height: 200px;
    width: 200px;
    background-color: #ddd;
    margin-left: 10px;
}


.portfolio {
    margin-top: 50px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 10px;
}

.item {
    height: 200px;
    background-color: #ddd;
}


.blog {
    margin-top: 50px;
}

.blog article {
    margin-top: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
