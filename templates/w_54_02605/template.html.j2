    color: white;
    padding: 15px 32px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 16px;
    margin: 4px 2px;
    cursor: pointer;
}


.services {
    margin-top: 50px;
}

.slider {
    display: flex;
    overflow-x: auto;
}

.slider .slide {
    display: flex;
    align-items: center;
