    padding: 10px;
}

#social-media-links, #blog-posts {
    display: flex;
    gap: 10px;
}

#social-media-links a, #blog-posts a {
    color: #fff;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
