<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 122.4mm; inset-block-start: 36.2mm; inline-size: 81.6mm; block-size: 49.4mm; font-size: 15.6pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 36.8mm; inline-size: 89.2mm; block-size: 43.7mm; font-size: 15.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 83.6mm; inline-size: 91.9mm; block-size: 26.8mm; font-size: 15.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 124.2mm; inset-block-start: 87.4mm; inline-size: 77.5mm; block-size: 17.6mm; font-size: 12.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 111.8mm; inline-size: 132.5mm; block-size: 15.5mm; font-size: 14.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 130.3mm; inline-size: 130.3mm; block-size: 9.9mm; font-size: 14.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 143.2mm; inline-size: 137.3mm; block-size: 26.8mm; font-size: 15.2pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 176.2mm; inline-size: 70.7mm; block-size: 12.0mm; font-size: 17.0pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 188.7mm; inline-size: 75.8mm; block-size: 38.4mm; font-size: 15.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 255.9mm; inline-size: 48.6mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 201.8mm; inset-block-start: 269.4mm; inline-size: 1.4mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
