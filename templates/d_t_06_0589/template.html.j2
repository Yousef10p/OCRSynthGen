<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 22.0mm; inset-block-start: 19.5mm; inline-size: 71.6mm; block-size: 10.2mm; font-size: 28.8pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 22.0mm; inset-block-start: 31.3mm; inline-size: 39.5mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 39.9mm; inline-size: 159.6mm; block-size: 19.3mm; font-size: 13.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 61.6mm; inline-size: 161.7mm; block-size: 19.3mm; font-size: 13.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 83.4mm; inline-size: 161.2mm; block-size: 24.2mm; font-size: 13.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 110.1mm; inline-size: 161.2mm; block-size: 24.2mm; font-size: 13.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 136.8mm; inline-size: 159.2mm; block-size: 39.0mm; font-size: 13.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 178.3mm; inline-size: 156.9mm; block-size: 14.4mm; font-size: 13.6pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 24.0mm; inset-block-start: 198.0mm; inline-size: 47.4mm; block-size: 18.2mm; font-size: 17.2pt"></div>
<p class="box" style="inset-inline-start: 22.0mm; inset-block-start: 222.9mm; inline-size: 25.9mm; block-size: 9.4mm; font-size: 13.3pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 22.0mm; inset-block-start: 261.1mm; inline-size: 38.9mm; block-size: 13.9mm; font-size: 19.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
