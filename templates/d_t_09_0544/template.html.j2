<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 102.3mm; inline-size: 151.1mm; block-size: 20.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 76.7mm; inset-block-start: 127.6mm; inline-size: 62.0mm; block-size: 10.6mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 58.2mm; inset-block-start: 149.0mm; inline-size: 99.5mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_5 }}</p>
