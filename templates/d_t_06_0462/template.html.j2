<p class="box" style="inset-inline-start: 75.2mm; inset-block-start: 20.4mm; inline-size: 47.9mm; block-size: 65.9mm; font-size: 11.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 127.3mm; inset-block-start: 20.4mm; inline-size: 47.3mm; block-size: 27.2mm; font-size: 11.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 127.3mm; inset-block-start: 49.5mm; inline-size: 49.0mm; block-size: 46.5mm; font-size: 11.0pt">{{ slot_6 }}</p>
