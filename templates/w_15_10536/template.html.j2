<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    background-color: #f2f2f2;
}
h1, h2 {
    text-align: center;
}
main {
    margin: 50px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
}
section {
    background-color: #fff;
    padding: 20px;
    border-radius: 5px;
}
form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
form input[type="number"], form button {
    height: 30px;
}
button {
    background-color: #008CBA;
    color: white;
    border: none;
    cursor: pointer;
}
table {
    width: 100%;
    border-collapse: collapse;
}
th, td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<main>
<section>
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</section>
<section>
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
<button>{{ slot_6 }}</button>
</form>
</section>
<section>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<table>
<tr>
<th>{{ slot_9 }}</th>
<th>{{ slot_10 }}</th>
</tr>
<tr>
<td>{{ slot_11 }}</td>
<td>{{ slot_12 }}</td>
</tr>
<tr>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
</tr>
</table>
</section>
</main>
</body>
</html>