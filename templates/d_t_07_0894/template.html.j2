<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 14.2mm; inline-size: 88.4mm; block-size: 25.2mm; font-size: 11.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 113.2mm; inset-block-start: 14.3mm; inline-size: 90.8mm; block-size: 54.7mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 41.8mm; inline-size: 89.7mm; block-size: 97.1mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 113.2mm; inset-block-start: 71.4mm; inline-size: 90.7mm; block-size: 54.7mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 113.2mm; inset-block-start: 128.5mm; inline-size: 90.2mm; block-size: 80.1mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 141.1mm; inline-size: 90.7mm; block-size: 80.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 113.2mm; inset-block-start: 211.1mm; inline-size: 90.5mm; block-size: 42.0mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 223.7mm; inline-size: 90.0mm; block-size: 33.7mm; font-size: 11.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 205.1mm; inset-block-start: 267.7mm; inline-size: 2.6mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_8 }}</footer>
</div></body>
</html>
