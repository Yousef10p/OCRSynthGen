<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

#wrapper {
    width: 800px;
    margin: auto;
}

#header {
    text-align: center;
    background-color: #f2f2f2;
    padding: 20px;
    margin-bottom: 20px;
}

#nav {
    width: 200px;
    float: right;
    margin-left: 20px;
}

#content, #events {
    float: left;
    width: 500px;
}

.game, #events {
    padding: 20px;
    margin-bottom: 20px;
    background-color: #f2f2f2;
}

.game-title, .event-title {
    font-weight: bold;
}

.game-image, #events {
    width: 100%;
    height: 200px;
    background-color: #ccc;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="wrapper">
<div id="header">{{ slot_0 }}</div>
<div id="nav">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div id="content">
<div class="game">
<p class="game-title">{{ slot_5 }}</p>
<div class="game-image">{{ slot_6 }}</div>
<p>{{ slot_7 }}</p>
</div>
<div class="game">
<p class="game-title">{{ slot_8 }}</p>
<div class="game-image">{{ slot_9 }}</div>
<p>{{ slot_10 }}</p>
</div>
</div>
<div id="events">
<p class="event-title">{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
<p class="event-title">{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>