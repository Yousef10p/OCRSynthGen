}
#destinations-rect {
    background-color: blue;
}
#contact-rect {
    background-color: yellow;
}

form {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 20px;
} 
form input[type="text"] {
    margin-bottom: 10px;
    padding: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
