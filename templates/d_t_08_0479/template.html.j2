<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 110.1mm; inline-size: 161.9mm; block-size: 21.5mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 135.9mm; inline-size: 161.9mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
