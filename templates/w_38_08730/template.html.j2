<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ul>
</nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</header>
<section class="feature">
<h2>{{ slot_5 }}</h2>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
<div class="service">{{ slot_9 }}</div>
<div class="service">{{ slot_10 }}</div>
<div class="service">{{ slot_11 }}</div>
</section>
<footer>
<p>{{ slot_12 }}</p>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</footer>
</body>
</html>