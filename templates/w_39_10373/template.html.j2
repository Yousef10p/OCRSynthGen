<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
}

body, html {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

.header {
  width: 100%;
  height: 100px;
  background-color: navy;
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-menu {
  position: absolute;
  left: 20px;
  top: 20px;
}

.nav-menu ul {
  list-style-type: none;
}

.nav-menu ul li {
  display: inline;
  margin-left: 10px;
}

.logo {
  height: 80px;
  width: 150px;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}

.carousel {
  width: 70%;
}

.carousel-item {
  display: block;
  height: 50px;
  width: 100%;
  background-color: grey;
  margin-bottom: 10px;
  text-align: center;
  color: white;
  line-height: 50px;
}

.cta-btn {
  background-color: white;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
}

main {
  margin: 20px;
  text-align: center;
  padding: 40px;
}

footer {
  background-color: navy;
  color: white;
  text-align: center;
  padding: 20px;
  position: absolute;
  width: 100%;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
