    color: #fff;
    border-radius: 5px;
}

#content {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    padding: 20px;
}

div[id$='-col'] {
    margin: 20px;
}

#mid-col p {
    text-align: justify;
}

ol li {
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
