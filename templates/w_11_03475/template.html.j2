}

nav ul li {
    list-style-type: none;
}

nav ul li a {
    text-decoration: none;
    color: #000;
}

.hero {
    width: 100%;
    background-color: #f8f8f8;
    padding: 50px 0;
    text-align: center;
}

.placeholder {
    width: 240px;
    height: 180px;
    background-color: #ccc;
    margin: 20px auto;
    display: flex;
    justify-content: center;
    align-items: center;
}

main {
    max-width: 960px;
    margin: 20px auto;
