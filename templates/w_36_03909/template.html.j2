}

nav ul {
    display: flex;
    justify-content: space-around;
}

nav ul li {
    list-style-type: none;
    padding: 1em;
}

nav ul li a {
    color: white;
    text-decoration: none;
}

section {
    padding: 1em;
    margin: 1em;
}

#home, #about, #contact {
    display: flex;
    flex-direction: column;
