<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-columns: 2fr 3fr;
    grid-gap: 20px;
}

.header-container {
    grid-column: span 2;
}

.search-column, .booking-column {
    display: flex;
    flex-direction: column;
}

.travel-inspiration-column, .travel-tips-column {
    display: flex;
    flex-direction: column;
}

input[type="text"], input[type="date"] {
    margin-bottom: 10px;
}

.colored-rectangle {
    height: 200px;
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header-container">
<div class="search-column">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<button>{{ slot_1 }}</button>
</div>
<div class="booking-column">
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_2 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<button>{{ slot_5 }}</button>
</form>
</div>
</div>
<div class="travel-inspiration-column">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="colored-rectangle" style="background-color: #AED6F1"></div>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
</div>
<div class="travel-tips-column">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<div class="colored-rectangle" style="background-color: #F9E79F"></div>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</div>
</body>
</html>