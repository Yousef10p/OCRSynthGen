<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 53.2mm; inset-block-start: 12.5mm; inline-size: 57.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 52.7mm; inset-block-start: 18.4mm; inline-size: 49.6mm; block-size: 4.2mm; font-size: 11.9pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 53.1mm; inset-block-start: 37.9mm; inline-size: 79.3mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 53.1mm; inset-block-start: 47.7mm; inline-size: 131.0mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 53.1mm; inset-block-start: 62.5mm; inline-size: 130.4mm; block-size: 24.2mm; font-size: 13.7pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 52.3mm; inset-block-start: 92.9mm; inline-size: 28.4mm; block-size: 43.1mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 118.2mm; inset-block-start: 92.8mm; inline-size: 64.9mm; block-size: 43.1mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 52.7mm; inset-block-start: 140.8mm; inline-size: 50.6mm; block-size: 46.1mm; font-size: 13.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 118.6mm; inset-block-start: 140.8mm; inline-size: 63.0mm; block-size: 32.0mm; font-size: 13.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 115.5mm; inset-block-start: 265.7mm; inline-size: 3.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_7 }}</footer>
</div></body>
</html>
