    justify-content: center;
}

.portfolio-image .image {
    width: 50%;
    height: 50%;
    background-color: #f8f8f8;
}

.portfolio-image h3 {
    margin-top: 10px;
}

footer {
    background-color: #f8f8f8;
    padding: 20px;
    text-align: center;
}

.footer-logo {
    width: 50px;
    height: 50px;
    background-color: #f8f8f8;
}

footer form {
    margin: 20px 0;
}

footer form input[type="email"] {
    padding: 10px;
    width: 20%;
}

footer form input[type="submit"] {
    padding: 10px 20px;
    background-color: #000;
    color: #fff;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
