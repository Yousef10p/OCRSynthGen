    padding: 10px;
}

.navigation__list {
    list-style-type: none;
    padding: 0;
}

.navigation__item {
    display: inline;
    margin-left: 10px;
}

.content {
    padding: 20px;
}

.content__title {
    color: #000;
}

.content__collection, .content__product, .content__post {
