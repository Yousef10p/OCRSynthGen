<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 31.0mm; inline-size: 157.2mm; block-size: 50.3mm; font-size: 10.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 30.3mm; inset-block-start: 84.5mm; inline-size: 154.7mm; block-size: 16.9mm; font-size: 10.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 104.8mm; inline-size: 155.6mm; block-size: 16.6mm; font-size: 10.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 124.6mm; inline-size: 158.2mm; block-size: 37.0mm; font-size: 10.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 165.0mm; inline-size: 157.8mm; block-size: 70.1mm; font-size: 10.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 238.5mm; inline-size: 155.4mm; block-size: 16.7mm; font-size: 10.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 30.3mm; inset-block-start: 258.5mm; inline-size: 154.7mm; block-size: 10.1mm; font-size: 10.3pt">{{ slot_6 }}</p>
</div></body>
</html>
