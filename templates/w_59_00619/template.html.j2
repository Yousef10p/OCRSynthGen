  width: 70%;
}
#contact {
  clear: both;
}
footer {
  padding: 20px;
  background: #333;
  color: #fff;
  position: absolute;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
