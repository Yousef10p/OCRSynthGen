}
footer {
  position: absolute;
  bottom: 0;
  width: 100vw;
  background: #ff0;
  color: #000;
  text-align: center;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
