<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body{
    font-family: var(--font-body);
}
header{
    position: relative;
}
header img{
    width: 100%;
    height: 500px;
    object-fit: cover;
}
nav{
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
}
nav ul{
    display: flex;
    justify-content: space-around;
    list-style: none;
}
nav ul li a{
    text-decoration: none;
}
aside{
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 200px;
    background: #eee;
}
aside h2, aside ul h2{
    padding: 20px 0;
}
main{
    margin-right: 220px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="hero-image ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</header>
<aside>
<h2>{{ slot_6 }}</h2>
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>
</aside>
<main>
<h1>{{ slot_13 }}</h1>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</main>
</body>
</html>