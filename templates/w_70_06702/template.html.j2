<nav>
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</nav>
<div class="container">
<div class="menu">
<h2>{{ slot_4 }}</h2>
<ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
<h2>{{ slot_8 }}</h2>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>
<button>{{ slot_10 }}</button>
</form>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>