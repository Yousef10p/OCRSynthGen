<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-columns: 1fr;
    grid-gap: 10px;
    justify-items: left;
}

nav {
    grid-column: 1;
    grid-row: 1;
    background-color: #f2f2f2;
    display: flex;
    justify-content: space-between;
    padding: 20px;
}

.logo {
    grid-column: 1;
    grid-row: 1;
    color: #333;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    grid-gap: 20px;
    justify-items: stretch;
    align-items: stretch;
}

.grid > div {
    background-color: #ccc;
    padding: 20px;
}

.featured-promotions {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-gap: 50px;
    justify-items: center;
}

.featured-promotions > div {
    background-color: #333;
    color: #fff;
    padding: 50px;
}

footer {
    grid-column: 1;
    grid-row: 3;
    background-color: #333;
    color: #fff;
    padding: 20px;
    display: flex;
    justify-content: space-around;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<div class="logo">{{ slot_0 }}</div>
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</nav>
<div class="featured-promotions">
<div>{{ slot_5 }}</div>
<div>{{ slot_6 }}</div>
<div>{{ slot_7 }}</div>
</div>
<div class="grid">
<div>{{ slot_8 }}</div>
<div>{{ slot_9 }}</div>
<div>{{ slot_10 }}</div>
<div>{{ slot_11 }}</div>
<div>{{ slot_12 }}</div>
<div>{{ slot_13 }}</div>
</div>
<footer>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
</footer>
</body>
</html>