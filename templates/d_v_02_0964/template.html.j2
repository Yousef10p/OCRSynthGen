<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.2mm; inset-block-start: 15.7mm; inline-size: 26.8mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 91.1mm; inset-block-start: 15.7mm; inline-size: 27.8mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 175.0mm; inset-block-start: 15.7mm; inline-size: 14.8mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_2 }}</header><h2 class="box" style="inset-inline-start: 49.1mm; inset-block-start: 30.8mm; inline-size: 107.9mm; block-size: 5.4mm; font-size: 15.4pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 25.0mm; inset-block-start: 47.2mm; inline-size: 19.5mm; block-size: 4.7mm; font-size: 13.4pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 34.3mm; inset-block-start: 55.4mm; inline-size: 134.2mm; block-size: 5.2mm; font-size: 14.9pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 24.8mm; inset-block-start: 71.4mm; inline-size: 19.5mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 79.6mm; inline-size: 155.8mm; block-size: 37.2mm; font-size: 21.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 24.2mm; inset-block-start: 120.1mm; inline-size: 156.1mm; block-size: 37.0mm; font-size: 21.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 160.6mm; inline-size: 156.2mm; block-size: 53.7mm; font-size: 21.7pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 217.5mm; inline-size: 155.9mm; block-size: 37.8mm; font-size: 21.4pt">{{ slot_10 }}</p>
</div></body>
</html>
