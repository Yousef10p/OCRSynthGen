  flex-grow: 1;
  padding: 10px;
  border: none;
}

#search-box button {
  padding: 10px 20px;
  border: none;
  background-color: #333;
  color: #fff;
}

.back-photo {
  height: 300px;
  background-image: none;
  background-size: cover;
  margin: 20px;
}

.text-box {
  margin: 20px;
  text-align: justify;
}

footer {
