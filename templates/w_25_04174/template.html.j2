<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.navigation a {
  margin: 0 10px;
  text-decoration: none;
  color: #000;
}

.slider {
  display: flex;
  justify-content: space-evenly;
}

.slider .slide {
  width: 30%;
  height: 300px;
  background-color: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-bar form {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #eee;
  padding: 10px;
}

.search-bar input[type="text"] {
  flex: 1;
  margin-left: 10px;
}

.search-bar button {
  background-color: #000;
  color: #fff;
  border: none;
  padding: 10px;
}

.call-to-action {
  background-color: #000;
  color: #fff;
  padding: 10px;
  text-align: center;
  cursor: pointer;
}

.content {
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="navigation">
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</div>
</div>
<div class="slider">
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
</div>
<div class="search-bar">
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span>
<button>{{ slot_8 }}</button>
</form>
</div>
<div class="call-to-action">
<button>{{ slot_9 }}</button>
</div>
<div class="content">
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }} </p>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</div>
</body>
</html>