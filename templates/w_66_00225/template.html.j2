</ul>
</nav>
<div class="carousel">
<div class="slide current">{{ slot_3 }} <strong>{{ slot_4 }}</strong> {{ slot_5 }}</div>
<div class="slide">{{ slot_6 }} <strong>{{ slot_7 }}</strong> {{ slot_8 }}</div>
<div class="slide">{{ slot_9 }} <strong>{{ slot_10 }}</strong> {{ slot_11 }}</div>
</div>
<footer>
        {{ slot_12 }} 
        <a>{{ slot_13 }}</a>{{ slot_14 }} 
        <a>{{ slot_15 }}</a>{{ slot_16 }} 
        <a>{{ slot_17 }}</a>
</footer>
</body>
</html>