<ul class="box" style="inset-inline-start: 35.6mm; inset-block-start: 88.9mm; inline-size: 148.4mm; block-size: 21.9mm; font-size: 12.6pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 114.5mm; inline-size: 152.1mm; block-size: 21.9mm; font-size: 12.6pt">{{ slot_5 }}</p>
