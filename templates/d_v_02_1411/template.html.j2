<ul class="box" style="inset-inline-start: 40.2mm; inset-block-start: 137.9mm; inline-size: 145.1mm; block-size: 10.1mm; font-size: 10.6pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 40.2mm; inset-block-start: 151.2mm; inline-size: 145.1mm; block-size: 10.1mm; font-size: 10.6pt"><li>{{ slot_5 }}</li></ul>
