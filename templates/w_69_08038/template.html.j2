<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    width: 100%;
    position: fixed;
    top: 0;
    display: flex;
    align-items: center;
}

input[type="text"] {
    margin: 20px;
}

nav ul {
    display: flex;
    justify-content: space-around;
    width: 100%;
}

.parallax {
    height: 500px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    background: linear-gradient(to left, #ff0000, #00ff00);
}

.parallax .bg-image {
    width: 100%;
    height: 100%;
    background: #000;
    display: flex;
    justify-content: center;
    align-items: center;
}

.content {
    margin: 20px 0;
    padding: 20px;
    background: #ddd;
}

footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #333;
    color: #fff;
    height: 100px;
}

footer ul {
    display: flex;
    list-style-type: none;
}

footer a {
    color: #fff;
    text-decoration: none;
    margin: 0 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<main>
<section class="parallax">
<div class="bg-image">
<h1>{{ slot_5 }}</h1>
</div>
<div class="content">
<p>{{ slot_6 }}</p>
</div>
</section>
</main>
<footer>
<div>
<p>{{ slot_7 }}</p>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
</div>
<div>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</footer>
</body>
</html>