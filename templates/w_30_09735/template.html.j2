<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
	margin: 0;
	padding: 0;
	background-color: white;
	color: red;
	font-family: var(--font-body);
}
a {
	color: red;
	text-decoration: none;
}
#header, #footer {
	background-color: red;
	color: white;
	text-align: center;
	padding: 20px;
}
#navigation {
	background-color: white;
	color: red;
	padding: 10px;
	margin-bottom: 20px;
}
#navigation ul {
	list-style-type: none;
	padding: 0;
}
#navigation li {
	display: inline;
	margin-left: 10px;
}
#navigation #search {
	float: left;
	margin-top: 10px;
}
#left-column, #central-column {
	width: 45%;
	float: right;
	padding: 20px;
}
#footer {
	clear: both;
	text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">{{ slot_0 }}</div>
<div id="navigation">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
<div id="search">{{ slot_6 }}</div>
</div>
<div id="content">
<div id="left-column">
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
</div>
<div id="central-column">
<h1>{{ slot_11 }}</h1>
<p>{{ slot_12 }}</p>
<h1>{{ slot_13 }}</h1>
<p>{{ slot_14 }}</p>
</div>
</div>
<div id="footer">
<p>{{ slot_15 }}</p>
</div>
</body>
</html>