<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 44.5mm; inset-block-start: 48.2mm; inline-size: 128.0mm; block-size: 25.9mm; font-size: 18.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 44.5mm; inset-block-start: 71.6mm; inline-size: 91.8mm; block-size: 42.2mm; font-size: 15.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 141.6mm; inset-block-start: 73.1mm; inline-size: 58.8mm; block-size: 89.7mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 44.5mm; inset-block-start: 116.1mm; inline-size: 91.9mm; block-size: 42.2mm; font-size: 17.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 44.5mm; inset-block-start: 160.5mm; inline-size: 91.9mm; block-size: 29.5mm; font-size: 16.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.7mm; inset-block-start: 166.3mm; inline-size: 53.4mm; block-size: 23.9mm; font-size: 13.5pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 98.5mm; inset-block-start: 262.6mm; inline-size: 19.0mm; block-size: 7.3mm; font-size: 10.4pt">{{ slot_5 }}</footer>
</div></body>
</html>
