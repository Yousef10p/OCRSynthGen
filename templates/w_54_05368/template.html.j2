* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
}

header {
  position: relative;
  height: 80px; 
  background-color: #f8f9fa;
}

header nav ul {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 100%;
}

header nav ul li {
  list-style: none;
}

header nav ul li a {
   text-decoration: none;
   color: #000; 
   transition: all 0.3s ease 0s; 
}

header nav ul li a:hover {
  color: #ff0000; 
}

#secondary-nav {
  position: absolute;
  top: 30px; 
  left: 50px; 
}

#secondary-nav ul {
  display: flex;
  justify-content: space-around;
  width: 150px; 
}

#secondary-nav ul li {
  list-style: none;
}

#secondary-nav ul li a {
   text-decoration: none;
   color: #000; 
   transition: all 0.3s ease 0s; 
}

#secondary-nav ul li a:hover {
  color: #ff0000; 
}

#hero {
  height: 500px; 
  background-color: #f8f9fa;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

#hero h1, #hero h2 {
  color: #000; 
}

button {
  background-color: #000; 
  color: #fff; 
  border: none;
  padding: 15px 32px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 16px;
  margin: 4px 2px;
  transition-duration: 0.4s;
  cursor: pointer;
}

button:hover {
  background-color: #fff; 
  color: #000; 
}

footer {
  background-color: #f1f1f1; 
  padding: 10px; 
  text-align: center;
  color: #000; 
}

footer ul {
  display: flex;
  justify-content: space-around;
  padding: 50px 0; 
}

footer ul li {
  list-style: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
