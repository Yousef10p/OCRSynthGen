<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<main>
<div class="grid">
<div class="product">{{ slot_4 }}</div>
<div class="product">{{ slot_5 }}</div>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
<div class="product">{{ slot_9 }}</div>

</div>
<aside>
<h2>{{ slot_10 }}</h2>
<ol>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>

</ol>
</aside>
</main>
<footer>
<p>{{ slot_14 }}</p>
</footer>
</body>
</html>