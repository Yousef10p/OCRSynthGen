<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 159.6mm; inline-size: 97.0mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 48.3mm; inset-block-start: 168.7mm; inline-size: 22.3mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_4 }}</h2>
