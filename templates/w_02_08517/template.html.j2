<div class="slide" style="background-color: lightblue;">{{ slot_3 }}</div>
<div class="slide" style="background-color: lightyellow;">{{ slot_4 }}</div>
</div>
</header>
<main>
<h2>{{ slot_5 }}</h2>
<form>
<label>{{ slot_6 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span>
<label>{{ slot_8 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>
<span class="">{{ slot_10 }}</span>
</form>
</main>
<footer>
<p>{{ slot_11 }}</p>
<div class="social-media">
