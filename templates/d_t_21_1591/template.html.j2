<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 17.0mm; inset-block-start: 12.7mm; inline-size: 167.1mm; block-size: 10.6mm; font-size: 22.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 27.3mm; inline-size: 159.6mm; block-size: 5.0mm; font-size: 10.5pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 17.7mm; inset-block-start: 37.7mm; inline-size: 14.3mm; block-size: 6.0mm; font-size: 17.0pt"></div>
<h2 class="box" style="inset-inline-start: 17.0mm; inset-block-start: 51.7mm; inline-size: 99.4mm; block-size: 8.6mm; font-size: 18.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 64.4mm; inline-size: 176.0mm; block-size: 16.2mm; font-size: 10.5pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 17.6mm; inset-block-start: 85.4mm; inline-size: 14.6mm; block-size: 4.6mm; font-size: 13.0pt"></div>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 95.1mm; inline-size: 176.0mm; block-size: 16.2mm; font-size: 10.5pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 16.8mm; inset-block-start: 116.0mm; inline-size: 159.1mm; block-size: 106.1mm; font-size: 15.0pt"></div>
<h2 class="box" style="inset-inline-start: 17.0mm; inset-block-start: 228.1mm; inline-size: 130.0mm; block-size: 8.6mm; font-size: 18.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 240.8mm; inline-size: 176.0mm; block-size: 16.2mm; font-size: 10.5pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 17.7mm; inset-block-start: 261.8mm; inline-size: 14.1mm; block-size: 5.4mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 271.5mm; inline-size: 176.0mm; block-size: 5.0mm; font-size: 10.5pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 17.4mm; inset-block-start: 288.5mm; inline-size: 5.3mm; block-size: 4.3mm; font-size: 9.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
