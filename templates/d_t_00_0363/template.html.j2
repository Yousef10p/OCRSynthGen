<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 102.1mm; inset-block-start: 9.9mm; inline-size: 88.2mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 102.1mm; inset-block-start: 24.7mm; inline-size: 88.3mm; block-size: 42.7mm; font-size: 13.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 102.1mm; inset-block-start: 74.1mm; inline-size: 88.2mm; block-size: 32.9mm; font-size: 13.3pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 96.9mm; inset-block-start: 118.2mm; inline-size: 51.4mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 102.1mm; inset-block-start: 123.5mm; inline-size: 88.2mm; block-size: 27.9mm; font-size: 13.2pt">{{ slot_4 }}</p>
<header class="box" style="inset-inline-start: 6.7mm; inset-block-start: 138.2mm; inline-size: 4.8mm; block-size: 41.9mm; font-size: 40.0pt">{{ slot_5 }}</header><p class="box" style="inset-inline-start: 102.1mm; inset-block-start: 158.0mm; inline-size: 88.2mm; block-size: 47.7mm; font-size: 13.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 102.1mm; inset-block-start: 212.4mm; inline-size: 88.2mm; block-size: 32.9mm; font-size: 13.3pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 97.2mm; inset-block-start: 255.9mm; inline-size: 24.4mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 102.1mm; inset-block-start: 261.8mm; inline-size: 88.2mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_9 }}</p>
</div></body>
</html>
