<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 279.4mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 11.4mm; inset-block-start: 32.2mm; inline-size: 28.5mm; block-size: 26.8mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 43.2mm; inset-block-start: 32.3mm; inline-size: 31.4mm; block-size: 15.2mm; font-size: 8.6pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 85.1mm; inset-block-start: 32.1mm; inline-size: 53.6mm; block-size: 27.0mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 141.7mm; inset-block-start: 32.2mm; inline-size: 22.6mm; block-size: 18.5mm; font-size: 8.7pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 175.7mm; inset-block-start: 32.2mm; inline-size: 74.5mm; block-size: 47.7mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 11.2mm; inset-block-start: 70.9mm; inline-size: 74.9mm; block-size: 30.5mm; font-size: 10.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 92.0mm; inset-block-start: 70.9mm; inline-size: 73.9mm; block-size: 26.0mm; font-size: 12.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 175.9mm; inset-block-start: 82.4mm; inline-size: 69.6mm; block-size: 8.8mm; font-size: 8.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 92.0mm; inset-block-start: 98.1mm; inline-size: 73.8mm; block-size: 30.5mm; font-size: 12.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 12.0mm; inset-block-start: 102.6mm; inline-size: 73.6mm; block-size: 30.5mm; font-size: 12.4pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 175.9mm; inset-block-start: 102.4mm; inline-size: 74.9mm; block-size: 36.2mm; font-size: 9.3pt"></div>
<p class="box" style="inset-inline-start: 92.0mm; inset-block-start: 129.8mm; inline-size: 71.3mm; block-size: 12.4mm; font-size: 11.7pt">{{ slot_7 }}</p>
</div></body>
</html>
