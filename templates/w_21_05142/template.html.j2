}
nav {
    background: #333;
    color: white;
    height: 50px;
}
nav ul {
    list-style-type: none;
}
nav ul li {
    display: inline;
    margin-left: 10px;
}
.slider {
    width: 100%;
    height: 200px;
    background: #ddd;
}
.slide {
    width: 100%;
    height: 200px;
    background: #bbb;
}
.filters {
    display: flex;
