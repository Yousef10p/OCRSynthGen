<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

nav {
  background-color: yellow;
  color: orange;
  padding: 10px 0;
  margin: 0;
}

nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

nav ul li {
  display: inline-block;
  position: relative;
}

nav ul li a {
  display: block;
  padding: 15px;
  color: orange;
  text-decoration: none;
}

nav ul li a:hover {
  background-color: orange;
  color: white;
}

nav ul ul {
  display: none;
  position: absolute;
  top: 100%;
  right: 0;
  width: 200px;
  padding: 10px 0;
  background-color: yellow;
}

nav ul li:hover ul {
  display: block;
}

section {
  margin: 20px;
}

section p {
  color: orange;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li>
<a>{{ slot_0 }}</a>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</li>
<li>
<a>{{ slot_4 }}</a>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</li>
<li>
<a>{{ slot_8 }}</a>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
</li>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
</ul>
</nav>
<section>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
</section>
</body>
</html>