<p>{{ slot_9 }}</p>
<h1 id="pants">{{ slot_10 }}</h1>
<div class="product-image">{{ slot_11 }}</div>
<p>{{ slot_12 }}</p>
<h1 id="shoes">{{ slot_13 }}</h1>
<div class="product-image">{{ slot_14 }}</div>
<p>{{ slot_15 }}</p>

<footer>
<a>{{ slot_16 }}</a>
<a>{{ slot_17 }}</a>
<a>{{ slot_18 }}</a>
</footer>
</body>
</html>