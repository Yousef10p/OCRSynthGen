<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}

header {
  display: flex;
  justify-content: space-between;
  padding: 20px;
  background-color: #333;
  color: #fff;
}

nav ul {
  display: flex;
  list-style: none;
}

nav ul li {
  margin-left: 20px;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}

aside {
  position: fixed;
  width: 200px;
  height: 100%;
  top: 0;
  right: 0;
  background-color: #f0f0f0;
  padding: 20px;
}

aside input {
  width: 100%;
  padding: 10px;
  margin-bottom: 20px;
}

aside .popular-stories,
aside .latest-tweets {
  margin-bottom: 30px;
}

main {
  margin-right: 220px;
  padding: 20px;
}

main img {
  width: 100%;
  height: 300px;
  background-color: #666;
  color: #fff;
}

main p {
  margin-top: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<aside>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
<div class="popular-stories">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
</div>
<div class="latest-tweets">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
</div>
</aside>
<main>
<h1>{{ slot_14 }}</h1>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_15 }}</p>
</main>
</body>
</html>