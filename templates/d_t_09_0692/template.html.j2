<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 89.7mm; inline-size: 107.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 81.6mm; inset-block-start: 104.5mm; inline-size: 91.9mm; block-size: 7.9mm; font-size: 8.0pt"></div>
