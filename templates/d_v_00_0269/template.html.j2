<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 355.6mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 45.4mm; inset-block-start: 69.3mm; inline-size: 124.1mm; block-size: 19.3mm; font-size: 27.3pt">{{ slot_0 }}</h1>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 106.6mm; inline-size: 216.0mm; block-size: 97.7mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 84.5mm; inset-block-start: 256.2mm; inline-size: 50.7mm; block-size: 26.1mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 58.3mm; inset-block-start: 295.8mm; inline-size: 104.1mm; block-size: 5.5mm; font-size: 15.6pt">{{ slot_1 }}</p>
</div></body>
</html>
