<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}

header {
  background-color: #ff3e00;
  color: white;
  padding: 10px;
  text-align: center;
}

nav, aside {
  background-color: #47a386;
  color: white;
  padding: 10px;
  text-align: center;
}

aside a {
  display: block;
  color: white;
}

main {
  padding: 10px;
}

.past-event {
  height: 50px;
  margin: 10px 0;
  background-color: #f4f4f4;
}

.past-event div {
  width: 50px;
  height: 50px;
  margin-left: 10px;
  background-color: #808080;
  display: inline-block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</header>
<nav>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
</nav>
<aside>
<h3>{{ slot_5 }}</h3>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
<h3>{{ slot_9 }}</h3>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
</aside>
<main>
<h2>{{ slot_12 }}</h2>
<div class="past-event"><div></div>{{ slot_13 }}</div>
<div class="past-event"><div></div>{{ slot_14 }}</div>
<div class="past-event"><div></div>{{ slot_15 }}</div>
</main>
</body>
</html>