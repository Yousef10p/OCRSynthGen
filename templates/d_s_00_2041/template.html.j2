<div class="box ph" style="inset-inline-start: 43.8mm; inset-block-start: 80.2mm; inline-size: 146.1mm; block-size: 10.6mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 36.0mm; inset-block-start: 90.9mm; inline-size: 153.9mm; block-size: 21.0mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 38.3mm; inset-block-start: 109.9mm; inline-size: 151.6mm; block-size: 7.9mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 31.4mm; inset-block-start: 118.2mm; inline-size: 158.5mm; block-size: 10.4mm; font-size: 12.0pt"></div>
<h2 class="box" style="inset-inline-start: 30.7mm; inset-block-start: 137.6mm; inline-size: 111.4mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 149.4mm; inline-size: 131.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 56.6mm; inset-block-start: 158.1mm; inline-size: 133.2mm; block-size: 12.5mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 66.7mm; inset-block-start: 170.6mm; inline-size: 123.2mm; block-size: 12.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 186.4mm; inline-size: 8.0mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 46.2mm; inset-block-start: 194.1mm; inline-size: 143.6mm; block-size: 13.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 209.6mm; inline-size: 82.8mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 27.3mm; inset-block-start: 233.3mm; inline-size: 162.6mm; block-size: 19.1mm; font-size: 10.9pt"><li>{{ slot_5 }}</li></ul>
<footer class="box" style="inset-inline-start: 103.5mm; inset-block-start: 266.7mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
