<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 74.7mm; inline-size: 6.3mm; block-size: 126.4mm; font-size: 20.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 48.7mm; inset-block-start: 77.6mm; inline-size: 117.8mm; block-size: 12.0mm; font-size: 12.0pt">{{ slot_5 }}</p>
