<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 25.8mm; inset-block-start: 22.0mm; inline-size: 164.4mm; block-size: 23.8mm; font-size: 23.9pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 68.3mm; inset-block-start: 54.8mm; inline-size: 79.0mm; block-size: 4.4mm; font-size: 11.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 42.1mm; inset-block-start: 64.7mm; inline-size: 131.7mm; block-size: 14.3mm; font-size: 13.9pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 76.8mm; inline-size: 6.3mm; block-size: 120.7mm; font-size: 20.0pt">{{ slot_3 }}</header><h2 class="box" style="inset-inline-start: 101.4mm; inset-block-start: 107.5mm; inline-size: 13.1mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 33.8mm; inset-block-start: 118.0mm; inline-size: 148.2mm; block-size: 86.9mm; font-size: 10.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 98.3mm; inset-block-start: 214.8mm; inline-size: 19.3mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 33.8mm; inset-block-start: 225.3mm; inline-size: 148.2mm; block-size: 10.1mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 244.5mm; inline-size: 96.0mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_8 }}</p>
</div></body>
</html>
