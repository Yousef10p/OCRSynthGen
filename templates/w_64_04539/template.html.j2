}

.cta {
    padding: 50px 0;
}

.cta h2 {
    font-size: 2em;
    margin-bottom: 20px;
}

.cta p {
    margin-bottom: 20px;
}

.services {
    display: flex;
    justify-content: space-evenly;
}

.service {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 30%;
    margin-bottom: 20px;
}

.service-img {
    width: 80%;
    height: 200px;
    background-color: #f2f2f2;
}

.contact {
    background-color: #f2f2f2;
    padding: 20px;
    text-align: center;
}

.contact h2 {
    font-size: 2em;
    margin-bottom: 20px;
}

.contact form {
    display: flex;
    flex-direction: column;
    width: 50%;
    margin: 20px auto;
}

.contact form label {
    margin-bottom: 10px;
}

.contact form input, .contact form textarea {
    margin-bottom: 20px;
}

.footer {
    background-color: #f2f2f2;
    padding: 20px;
    text-align: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
