}

.post, .group, .interest {
    margin-bottom: 20px;
    padding: 15px;
    background: #f0f0f0;
    border-radius: 5px;
    min-height: 100px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
