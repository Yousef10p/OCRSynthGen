<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 61.2mm; inset-block-start: 23.0mm; inline-size: 87.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 61.2mm; inset-block-start: 27.3mm; inline-size: 124.7mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 62.4mm; inset-block-start: 35.3mm; inline-size: 81.9mm; block-size: 47.2mm; font-size: 9.6pt"></div>
<h2 class="box" style="inset-inline-start: 45.4mm; inset-block-start: 87.1mm; inline-size: 61.6mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_2 }}</h2>
<h2 class="box" style="inset-inline-start: 61.2mm; inset-block-start: 95.9mm; inline-size: 75.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 61.2mm; inset-block-start: 100.1mm; inline-size: 131.5mm; block-size: 20.5mm; font-size: 11.6pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 65.2mm; inset-block-start: 121.1mm; inline-size: 109.0mm; block-size: 96.8mm; font-size: 11.4pt"></div>
<footer class="box" style="inset-inline-start: 147.0mm; inset-block-start: 264.0mm; inline-size: 47.3mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_5 }}</footer>
</div></body>
</html>
