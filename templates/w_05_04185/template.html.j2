<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    background-color: lightgray;
    text-align: center;
    padding: 50px 0;
}

.container {
    display: flex;
    justify-content: space-around;
    margin: 50px 0;
}

.game, .offer {
    height: 300px;
    width: 300px;
    background-color: lightgreen;
}

.sidebar {
    width: 30%;
    float: left;
    background-color: lightblue;
    padding: 20px;
}

footer {
    background-color: lightgray;
    text-align: center;
    padding: 20px 0;
    clear: both;
}

footer p, footer a {
    margin: 10px 0;
}

footer form {
    display: flex;
    flex-direction: column;
    align-items: center;
}

footer form input[type="text"], footer form input[type="email"], footer form textarea {
    width: 80%;
    margin: 10px;
}

footer form input[type="submit"] {
    background-color: blue;
    color: white;
    padding: 10px 20px;
    border: none;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</header>
<div class="container">
<div class="game"></div>
<div class="offer"></div>
</div>
<div class="sidebar">
<h2>{{ slot_2 }}</h2>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<footer>
<p>{{ slot_5 }} <a>{{ slot_6 }}</a> {{ slot_7 }} <a>{{ slot_8 }}</a> {{ slot_9 }} <a>{{ slot_10 }}</a></p>
<p>{{ slot_11 }} <a>{{ slot_12 }}</a> </p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_13 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_14 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_15 }}</span>
<span class="">{{ slot_16 }}</span>
</form>
</footer>
</body>
</html>