<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 140.1mm; inset-block-start: 50.1mm; inline-size: 20.6mm; block-size: 4.2mm; font-size: 11.9pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 140.1mm; inset-block-start: 60.5mm; inline-size: 47.7mm; block-size: 7.0mm; font-size: 9.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 140.1mm; inset-block-start: 75.0mm; inline-size: 49.7mm; block-size: 28.2mm; font-size: 11.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 140.1mm; inset-block-start: 110.6mm; inline-size: 49.4mm; block-size: 15.4mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 140.1mm; inset-block-start: 133.6mm; inline-size: 45.4mm; block-size: 7.0mm; font-size: 9.9pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 175.2mm; inline-size: 139.4mm; block-size: 19.2mm; font-size: 40.0pt">{{ slot_5 }}</h2>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 199.7mm; inline-size: 210.1mm; block-size: 85.7mm; font-size: 40.0pt"></div>
<footer class="box" style="inset-inline-start: 20.0mm; inset-block-start: 288.2mm; inline-size: 45.4mm; block-size: 1.9mm; font-size: 5.4pt">{{ slot_6 }}</footer>
</div></body>
</html>
