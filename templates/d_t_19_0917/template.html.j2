<ul class="box" style="inset-inline-start: 18.6mm; inset-block-start: 133.0mm; inline-size: 54.5mm; block-size: 5.0mm; font-size: 10.5pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 142.8mm; inline-size: 176.0mm; block-size: 10.6mm; font-size: 10.5pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 17.0mm; inset-block-start: 159.6mm; inline-size: 27.9mm; block-size: 8.6mm; font-size: 18.0pt">{{ slot_3 }}</h2>
<ul class="box" style="inset-inline-start: 20.1mm; inset-block-start: 172.3mm; inline-size: 172.9mm; block-size: 10.6mm; font-size: 10.5pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.1mm; inset-block-start: 185.6mm; inline-size: 172.9mm; block-size: 10.6mm; font-size: 10.5pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.1mm; inset-block-start: 198.8mm; inline-size: 172.9mm; block-size: 16.2mm; font-size: 10.5pt"><li>{{ slot_6 }}</li></ul>
<h2 class="box" style="inset-inline-start: 17.0mm; inset-block-start: 221.2mm; inline-size: 37.2mm; block-size: 8.6mm; font-size: 18.0pt">{{ slot_7 }}</h2>
<ul class="box" style="inset-inline-start: 20.1mm; inset-block-start: 233.9mm; inline-size: 172.9mm; block-size: 21.7mm; font-size: 10.5pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 20.1mm; inset-block-start: 258.3mm; inline-size: 172.9mm; block-size: 16.2mm; font-size: 10.5pt"><li>{{ slot_9 }}</li></ul>
