    background-color: #c00;
}


nav ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
    background-color: #000;
    padding: 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}


aside {
    position: absolute;
    top: 0;
    left: 0;
}

aside ul {
    list-style: none;
}

aside ul li a {
    text-decoration: none;
}


main {
    margin-top: 20px;
}


footer {
    position: fixed;
    bottom: 0;
    right: 0;
    left: 0;
    background-color: #000;
    color: #fff;
    padding: 10px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
