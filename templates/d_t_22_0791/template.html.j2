<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 125.9mm; inset-block-start: 10.2mm; inline-size: 7.6mm; block-size: 8.7mm; font-size: 24.7pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 18.8mm; inset-block-start: 12.3mm; inline-size: 102.6mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 35.8mm; inset-block-start: 24.6mm; inline-size: 63.9mm; block-size: 160.7mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 35.9mm; inset-block-start: 186.2mm; inline-size: 51.2mm; block-size: 4.2mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 201.9mm; inline-size: 95.7mm; block-size: 7.2mm; font-size: 8.8pt">{{ slot_3 }}</p>
</div></body>
</html>
