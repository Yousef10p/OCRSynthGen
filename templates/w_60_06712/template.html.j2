<li><span class="feature">{{ slot_4 }}</span><span class="price">{{ slot_5 }}</span></li>
<li><span class="feature">{{ slot_6 }}</span><span class="price">{{ slot_7 }}</span></li>
</ul>
</section>
<section id="reviews">
