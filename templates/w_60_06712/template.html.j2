<ul>
<li><span class="reviewer">{{ slot_9 }}</span><span class="review">{{ slot_10 }}</span></li>
<li><span class="reviewer">{{ slot_11 }}</span><span class="review">{{ slot_12 }}</span></li>
</ul>
</section>
<footer>
