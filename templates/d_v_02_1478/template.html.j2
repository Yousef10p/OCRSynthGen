<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 217.6mm; inset-block-start: 10.1mm; inline-size: 5.1mm; block-size: 2.5mm; font-size: 7.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 72.4mm; inset-block-start: 14.4mm; inline-size: 4.9mm; block-size: 2.6mm; font-size: 7.5pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 179.6mm; inset-block-start: 19.6mm; inline-size: 82.4mm; block-size: 119.5mm; font-size: 11.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 24.0mm; inline-size: 83.6mm; block-size: 132.6mm; font-size: 11.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 180.2mm; inset-block-start: 142.7mm; inline-size: 81.6mm; block-size: 49.3mm; font-size: 11.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.0mm; inset-block-start: 160.6mm; inline-size: 81.9mm; block-size: 41.0mm; font-size: 11.6pt">{{ slot_5 }}</p>
</div></body>
</html>
