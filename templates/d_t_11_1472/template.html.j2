<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 25.8mm; inline-size: 120.5mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 82.8mm; inset-block-start: 34.1mm; inline-size: 107.0mm; block-size: 10.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 48.1mm; inline-size: 166.9mm; block-size: 26.2mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 77.7mm; inline-size: 166.9mm; block-size: 11.4mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 82.7mm; inset-block-start: 95.6mm; inline-size: 107.2mm; block-size: 5.6mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 85.0mm; inset-block-start: 103.6mm; inline-size: 104.9mm; block-size: 6.1mm; font-size: 8.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.2mm; inline-size: 166.9mm; block-size: 77.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 197.4mm; inline-size: 166.8mm; block-size: 62.9mm; font-size: 12.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 103.4mm; inset-block-start: 267.0mm; inline-size: 4.2mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
