<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

header {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 100vh;
}

nav {
  position: fixed;
  top: 0;
  right: 0;
  width: 100%;
  background: #333;
  color: #fff;
  padding: 10px 0;
}

nav ul {
  display: flex;
  justify-content: space-around;
  list-style: none;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}

.carousel {
  width: 80%;
  margin: auto;
  display: flex;
  overflow: hidden;
}

.slide {
  display: flex;
  justify-content: center;
  align-items: center;
  flex: 1;
  height: 400px;
  color: #fff;
  background: #333;
  margin: 10px;
}

aside {
  position: fixed;
  top: 0;
  left: 0;
  width: 20%;
  background: #333;
  color: #fff;
  padding: 10px;
}

aside form input[type="submit"] {
  background: #fff;
  color: #333;
  border: none;
  padding: 10px;
}

main {
  margin: 20px;
}

footer {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 10px;
  position: fixed;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div class="carousel">
<div class="slide">{{ slot_4 }}</div>
<div class="slide"><ul>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul></div>
</div>
<aside>
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<span class="">{{ slot_12 }}</span>
</form>
</aside>
</header>
<main>
<h1>{{ slot_13 }}</h1>
<p>{{ slot_14 }}</p>
</main>
<footer>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>