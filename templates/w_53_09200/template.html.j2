<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

header, footer {
    background: #f4f4f4;
    padding: 20px;
    text-align: center;
}

nav ul {
    display: flex;
    justify-content: space-around;
}

nav ul li {
    list-style-type: none;
}

.container {
    max-width: 1100px;
    margin: auto;
    padding: 0 20px;
}

.slider-item {
    height: 40vh;
    width: 100%;
}

.properties {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    grid-gap: 20px;
    margin-top: 20px;
}

.property {
    height: 30vh;
    color: white;
    font-size: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.contact-info {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</header>
<section class="slider">
<div class="slider-item" style="background: red;">{{ slot_3 }}</div>
<div class="slider-item" style="background: green;">{{ slot_4 }}</div>
<div class="slider-item" style="background: blue;">{{ slot_5 }}</div>
</section>
<section class="properties">
<div class="property" style="background: lightgrey;">{{ slot_6 }}</div>
<div class="property" style="background: darkgrey;">{{ slot_7 }}</div>
<div class="property" style="background: lightgrey;">{{ slot_8 }}</div>
<div class="property" style="background: darkgrey;">{{ slot_9 }}</div>
</section>
<footer>
<div class="contact-info">
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</footer>
</body>
</html>