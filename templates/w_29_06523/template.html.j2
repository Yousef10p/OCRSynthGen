<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-family: var(--font-body);
}

#logo {
  align-self: flex-start;
  height: 100px;
  width: 100%;
  background-color: #000; 
  color: #fff;
  text-align: center;
  line-height: 100px;
}

nav {
  width: 100%;
  background-color: #f8f8f8;
}

nav ul {
  list-style-type: none;
  display: flex;
  padding: 0;
}

nav ul li a {
  padding: 1em;
  display: block;
  color: #000;
  text-decoration: none;
}

#content {
  display: flex;
  width: 100%;
}

#content > div {
  width: 50%;
  padding: 1em;
}

.game, .update, .asset, .tool {
  height: 200px;
  margin: 1em 0;
  background-color: #f8f8f8;
  text-align: center;
  line-height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div id="content">
<div id="games">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<div class="game">{{ slot_7 }}</div>
<div class="game">{{ slot_8 }}</div>
</div>
<div id="updates">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<div class="update">{{ slot_11 }}</div>
<div class="update">{{ slot_12 }}</div>
</div>
<div id="assets">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<div class="asset">{{ slot_15 }}</div>
<div class="asset">{{ slot_16 }}</div>
</div>
<div id="tools">
<h2>{{ slot_17 }}</h2>
<p>{{ slot_18 }}</p>
<div class="tool">{{ slot_19 }}</div>
<div class="tool">{{ slot_20 }}</div>
</div>
</div>
</body>
</html>