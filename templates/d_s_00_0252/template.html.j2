<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 116.5mm; inset-block-start: 20.0mm; inline-size: 54.6mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</h2>
<ul class="box" style="inset-inline-start: 37.1mm; inset-block-start: 39.1mm; inline-size: 132.9mm; block-size: 47.2mm; font-size: 16.7pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 37.1mm; inset-block-start: 90.3mm; inline-size: 132.9mm; block-size: 41.4mm; font-size: 16.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 37.1mm; inset-block-start: 136.1mm; inline-size: 132.9mm; block-size: 65.4mm; font-size: 16.8pt"><li>{{ slot_3 }}</li></ul>
<div class="box ph" style="inset-inline-start: 20.7mm; inset-block-start: 209.9mm; inline-size: 54.4mm; block-size: 69.9mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 80.2mm; inset-block-start: 210.2mm; inline-size: 89.7mm; block-size: 15.6mm; font-size: 14.7pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 80.3mm; inset-block-start: 262.5mm; inline-size: 51.1mm; block-size: 9.7mm; font-size: 9.1pt">{{ slot_5 }}</h2>
<footer class="box" style="inset-inline-start: 185.9mm; inset-block-start: 271.8mm; inline-size: 1.6mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_6 }}</footer><div class="box ph" style="inset-inline-start: 180.0mm; inset-block-start: 275.5mm; inline-size: 22.8mm; block-size: 16.9mm; font-size: 23.9pt"></div>
</div></body>
</html>
