<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
}
header {
    position: relative;
}
.scroll {
    position: absolute;
    top: 0;
    right: 0;
    background: #f8f8f8;
    width: 100%;
    overflow: auto;
    white-space: nowrap;
}
h1, .scroll p {
    display: inline-block;
    padding: 10px;
}
nav ul {
    list-style-type: none;
    display: flex;
    background: #333;
    color: #fff;
    position: sticky;
    top: 0;
}
nav ul li a {
    display: block;
    padding: 10px 20px;
    text-decoration: none;
}
nav ul li ul {
    display: none;
    position: absolute;
    background: #f8f8f8;
    color: #333;
}
nav ul li:hover ul {
    display: block;
}
section {
    margin: 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}
.interactive:hover + p {
    color: red;
}
.image {
    background: #555;
    height: 100px;
    width: 100px;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
}
@media(max-width: 600px) {
    section {
        flex-direction: column;
    }
    aside, article {
        width: 100%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
