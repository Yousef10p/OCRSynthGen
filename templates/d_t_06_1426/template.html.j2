<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 26.9mm; inline-size: 70.5mm; block-size: 17.6mm; font-size: 24.9pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 114.3mm; inset-block-start: 27.3mm; inline-size: 65.7mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 38.8mm; inline-size: 83.2mm; block-size: 33.5mm; font-size: 13.5pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 54.9mm; inline-size: 33.5mm; block-size: 38.7mm; font-size: 15.7pt"></div>
<div class="box ph" style="inset-inline-start: 64.4mm; inset-block-start: 55.1mm; inline-size: 33.7mm; block-size: 38.7mm; font-size: 15.7pt"></div>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 78.6mm; inline-size: 83.1mm; block-size: 48.4mm; font-size: 13.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 95.2mm; inline-size: 21.3mm; block-size: 7.2mm; font-size: 10.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 64.5mm; inset-block-start: 95.2mm; inline-size: 27.3mm; block-size: 10.7mm; font-size: 10.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 124.1mm; inline-size: 64.9mm; block-size: 40.1mm; font-size: 18.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 133.3mm; inline-size: 78.6mm; block-size: 28.5mm; font-size: 13.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 168.1mm; inline-size: 82.8mm; block-size: 78.2mm; font-size: 13.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 20.1mm; inset-block-start: 268.9mm; inline-size: 29.7mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
