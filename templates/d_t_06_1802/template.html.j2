<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 8.9mm; inset-block-start: 20.3mm; inline-size: 6.8mm; block-size: 6.8mm; font-size: 19.3pt"></div>
<header class="box" style="inset-inline-start: 16.1mm; inset-block-start: 25.1mm; inline-size: 59.7mm; block-size: 9.4mm; font-size: 14.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 60.5mm; inset-block-start: 54.1mm; inline-size: 69.9mm; block-size: 2.7mm; font-size: 8.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 71.6mm; inline-size: 45.9mm; block-size: 12.7mm; font-size: 11.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 16.1mm; inset-block-start: 94.7mm; inline-size: 59.8mm; block-size: 3.6mm; font-size: 11.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 16.1mm; inset-block-start: 103.8mm; inline-size: 179.6mm; block-size: 17.3mm; font-size: 11.2pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 16.1mm; inset-block-start: 126.8mm; inline-size: 98.2mm; block-size: 3.6mm; font-size: 11.2pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 16.2mm; inset-block-start: 136.0mm; inline-size: 179.1mm; block-size: 17.3mm; font-size: 11.2pt">{{ slot_6 }}</p>
