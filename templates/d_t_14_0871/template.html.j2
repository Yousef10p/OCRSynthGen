<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 24.7mm; inset-block-start: 9.3mm; inline-size: 58.7mm; block-size: 16.0mm; font-size: 15.1pt"></div>
<header class="box" style="inset-inline-start: 95.4mm; inset-block-start: 10.0mm; inline-size: 59.6mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 174.3mm; inset-block-start: 10.0mm; inline-size: 11.2mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_1 }}</header><h1 class="box" style="inset-inline-start: 80.2mm; inset-block-start: 65.6mm; inline-size: 54.8mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 61.6mm; inset-block-start: 79.4mm; inline-size: 90.1mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_3 }}</h1>
<h1 class="box" style="inset-inline-start: 26.3mm; inset-block-start: 93.1mm; inline-size: 162.6mm; block-size: 13.7mm; font-size: 16.0pt">{{ slot_4 }}</h1>
<h1 class="box" style="inset-inline-start: 95.9mm; inset-block-start: 106.8mm; inline-size: 21.5mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_5 }}</h1>
<h1 class="box" style="inset-inline-start: 55.5mm; inset-block-start: 120.6mm; inline-size: 104.4mm; block-size: 13.7mm; font-size: 16.0pt">{{ slot_6 }}</h1>
<p class="box" style="inset-inline-start: 59.7mm; inset-block-start: 160.0mm; inline-size: 93.8mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 51.5mm; inset-block-start: 178.0mm; inline-size: 110.3mm; block-size: 13.7mm; font-size: 16.0pt">{{ slot_8 }}</p>
</div></body>
</html>
