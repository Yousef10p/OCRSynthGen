<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 120.4mm; inset-block-start: 19.7mm; inline-size: 55.5mm; block-size: 30.9mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 23.2mm; inset-block-start: 20.7mm; inline-size: 31.2mm; block-size: 6.2mm; font-size: 8.8pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 18.7mm; inset-block-start: 31.3mm; inline-size: 66.9mm; block-size: 69.6mm; font-size: 15.2pt"></div>
<h2 class="box" style="inset-inline-start: 108.1mm; inset-block-start: 53.7mm; inline-size: 24.3mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 111.4mm; inset-block-start: 58.7mm; inline-size: 37.1mm; block-size: 14.4mm; font-size: 10.2pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 19.6mm; inset-block-start: 103.2mm; inline-size: 39.4mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 23.0mm; inset-block-start: 108.2mm; inline-size: 46.6mm; block-size: 10.7mm; font-size: 10.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 17.5mm; inset-block-start: 206.5mm; inline-size: 39.4mm; block-size: 2.7mm; font-size: 7.5pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 151.3mm; inset-block-start: 209.8mm; inline-size: 30.2mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_6 }}</h2>
<h2 class="box" style="inset-inline-start: 14.3mm; inset-block-start: 215.5mm; inline-size: 27.9mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 154.5mm; inset-block-start: 214.8mm; inline-size: 46.1mm; block-size: 7.1mm; font-size: 10.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 17.7mm; inset-block-start: 220.5mm; inline-size: 46.9mm; block-size: 10.7mm; font-size: 10.1pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 104.3mm; inset-block-start: 224.8mm; inline-size: 98.4mm; block-size: 27.3mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 13.6mm; inset-block-start: 254.6mm; inline-size: 190.8mm; block-size: 17.3mm; font-size: 12.3pt">{{ slot_10 }}</p>
</div></body>
</html>
