<div class="box ph" style="inset-inline-start: 27.9mm; inset-block-start: 143.5mm; inline-size: 162.0mm; block-size: 15.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 161.9mm; inline-size: 164.5mm; block-size: 11.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 49.0mm; inset-block-start: 177.8mm; inline-size: 140.9mm; block-size: 10.3mm; font-size: 12.0pt"></div>
