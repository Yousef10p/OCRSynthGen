    height: 100vh;
    background-color: #eee;
    padding: 20px;
    box-sizing: border-box;
}
.menu h2 {
    margin: 0;
    font-size: 18px;
    text-transform: uppercase;
}
.menu-item ul {
    list-style-type: none;
    padding: 0;
}
.menu-item ul li {
    margin: 10px 0;
}
.menu-item ul li a {
