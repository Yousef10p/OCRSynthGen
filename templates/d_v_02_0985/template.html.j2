<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.2mm; inset-block-start: 17.5mm; inline-size: 26.8mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 150.3mm; inset-block-start: 17.5mm; inline-size: 39.5mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 24.1mm; inset-block-start: 28.4mm; inline-size: 143.8mm; block-size: 5.1mm; font-size: 14.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 23.6mm; inset-block-start: 36.6mm; inline-size: 156.1mm; block-size: 102.1mm; font-size: 22.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 141.7mm; inline-size: 155.9mm; block-size: 21.7mm; font-size: 20.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 23.7mm; inset-block-start: 166.1mm; inline-size: 155.7mm; block-size: 13.2mm; font-size: 18.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 23.7mm; inset-block-start: 182.1mm; inline-size: 155.9mm; block-size: 37.9mm; font-size: 21.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 23.6mm; inset-block-start: 222.9mm; inline-size: 155.8mm; block-size: 21.8mm; font-size: 20.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 247.5mm; inline-size: 82.6mm; block-size: 4.8mm; font-size: 13.7pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 26.1mm; inset-block-start: 255.4mm; inline-size: 153.3mm; block-size: 14.9mm; font-size: 21.1pt">{{ slot_9 }}</p>
</div></body>
</html>
