<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 10.5mm; inset-block-start: 11.9mm; inline-size: 3.9mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 21.0mm; inset-block-start: 32.1mm; inline-size: 44.6mm; block-size: 6.8mm; font-size: 19.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 44.1mm; inline-size: 157.9mm; block-size: 28.7mm; font-size: 16.3pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 92.5mm; inline-size: 178.5mm; block-size: 80.3mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 84.1mm; inset-block-start: 178.9mm; inline-size: 15.2mm; block-size: 15.4mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 20.1mm; inset-block-start: 183.0mm; inline-size: 21.4mm; block-size: 7.3mm; font-size: 20.6pt"></div>
<div class="box ph" style="inset-inline-start: 48.6mm; inset-block-start: 181.3mm; inline-size: 28.9mm; block-size: 7.9mm; font-size: 22.4pt"></div>
<div class="box ph" style="inset-inline-start: 106.4mm; inset-block-start: 181.3mm; inline-size: 18.6mm; block-size: 11.6mm; font-size: 16.4pt"></div>
<h2 class="box" style="inset-inline-start: 21.1mm; inset-block-start: 200.8mm; inline-size: 67.9mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 205.1mm; inline-size: 18.6mm; block-size: 2.8mm; font-size: 8.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 20.1mm; inset-block-start: 210.0mm; inline-size: 159.2mm; block-size: 60.6mm; font-size: 19.1pt"></div>
</div></body>
</html>
