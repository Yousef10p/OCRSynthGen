<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 16.8mm; inset-block-start: 37.1mm; inline-size: 38.2mm; block-size: 57.8mm; font-size: 14.9pt"></div>
<h2 class="box" style="inset-inline-start: 72.0mm; inset-block-start: 36.5mm; inline-size: 25.1mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 72.0mm; inset-block-start: 46.9mm; inline-size: 125.3mm; block-size: 56.6mm; font-size: 14.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 72.0mm; inset-block-start: 104.3mm; inline-size: 124.0mm; block-size: 14.8mm; font-size: 14.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 72.0mm; inset-block-start: 125.2mm; inline-size: 28.0mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 72.0mm; inset-block-start: 135.6mm; inline-size: 125.6mm; block-size: 51.3mm; font-size: 14.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 29.5mm; inset-block-start: 139.3mm; inline-size: 12.3mm; block-size: 2.7mm; font-size: 5.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 29.9mm; inset-block-start: 141.9mm; inline-size: 11.6mm; block-size: 2.6mm; font-size: 5.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 144.7mm; inline-size: 20.7mm; block-size: 42.6mm; font-size: 24.2pt"></div>
<div class="box ph" style="inset-inline-start: 28.4mm; inset-block-start: 214.6mm; inline-size: 81.2mm; block-size: 50.3mm; font-size: 15.8pt"></div>
<div class="box ph" style="inset-inline-start: 124.8mm; inset-block-start: 214.4mm; inline-size: 72.0mm; block-size: 50.8mm; font-size: 14.4pt"></div>
</div></body>
</html>
