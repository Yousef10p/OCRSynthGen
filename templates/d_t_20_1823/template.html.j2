<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 28.5mm; inset-block-start: 1.2mm; inline-size: 90.6mm; block-size: 10.5mm; font-size: 29.7pt">{{ slot_0 }}</h2>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 20.4mm; inline-size: 119.3mm; block-size: 8.2mm; font-size: 7.7pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 28.0mm; inline-size: 126.7mm; block-size: 8.2mm; font-size: 5.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 11.3mm; inset-block-start: 35.6mm; inline-size: 125.8mm; block-size: 8.2mm; font-size: 7.7pt"><li>{{ slot_3 }}</li></ul>
<h2 class="box" style="inset-inline-start: 8.2mm; inset-block-start: 50.7mm; inline-size: 67.8mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 17.9mm; inset-block-start: 58.3mm; inline-size: 32.9mm; block-size: 34.7mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 57.5mm; inset-block-start: 58.3mm; inline-size: 51.8mm; block-size: 4.4mm; font-size: 6.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 57.5mm; inset-block-start: 62.1mm; inline-size: 23.5mm; block-size: 31.0mm; font-size: 9.8pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 96.5mm; inset-block-start: 66.1mm; inline-size: 38.6mm; block-size: 57.6mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 8.2mm; inset-block-start: 96.3mm; inline-size: 68.6mm; block-size: 4.4mm; font-size: 6.2pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 100.1mm; inline-size: 78.2mm; block-size: 7.3mm; font-size: 6.9pt">{{ slot_9 }}</p>
</div></body>
</html>
