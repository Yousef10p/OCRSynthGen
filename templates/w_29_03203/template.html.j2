<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}


.hero-section {
    background-color: #ccc;
    width: 100%;
    height: 300px;
}

.hero-section h1 {
    color: #fff;
    text-align: center;
    padding-top: 100px;
    margin: 0;
}


.players-section {
    display: flex;
    flex-wrap: wrap;
}

.player {
    background-color: #ccc;
    width: 200px;
    height: 200px;
    margin: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}


.games-section {
    display: flex;
    flex-direction: column;
}

.games-section table {
    width: 50%;
    margin: 20px auto;
}

.games-section h2 {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<section class="hero-section">
<h1>{{ slot_0 }}</h1>
</section>
<section class="players-section">
<h2>{{ slot_1 }}</h2>
<div class="player">{{ slot_2 }}</div>
<div class="player">{{ slot_3 }}</div>
<div class="player">{{ slot_4 }}</div>
<div class="player">{{ slot_5 }}</div>
</section>
<section class="games-section">
<h2>{{ slot_6 }}</h2>
<table>
<tr>
<th>{{ slot_7 }}</th>
<th>{{ slot_8 }}</th>
<th>{{ slot_9 }}</th>
</tr>
<tr>
<td>{{ slot_10 }}</td>
<td>{{ slot_11 }}</td>
<td>{{ slot_12 }}</td>
</tr>
<tr>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
<td>{{ slot_15 }}</td>
</tr>
</table>
<h2>{{ slot_16 }}</h2>
<p>{{ slot_17 }}</p>
</section>
</body>
</html>