<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 51.4mm; inset-block-start: 46.2mm; inline-size: 105.3mm; block-size: 76.3mm; font-size: 13.1pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 140.4mm; inline-size: 149.1mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 151.0mm; inline-size: 164.5mm; block-size: 26.4mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 95.9mm; inset-block-start: 182.7mm; inline-size: 94.0mm; block-size: 7.2mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 95.6mm; inset-block-start: 191.1mm; inline-size: 94.3mm; block-size: 7.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 200.8mm; inline-size: 164.5mm; block-size: 11.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 215.5mm; inline-size: 164.5mm; block-size: 33.7mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 84.6mm; inset-block-start: 251.8mm; inline-size: 105.3mm; block-size: 10.0mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 104.6mm; inset-block-start: 266.7mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</footer>
</div></body>
</html>
