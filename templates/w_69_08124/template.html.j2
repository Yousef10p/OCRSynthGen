<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

.header {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 10px;
}

.menu {
    background-color: #eee;
    color: black;
    padding: 1em;
}

.menu a {
    color: black;
    text-decoration: none;
}

.specials-deals {
    float: right;
    width: 33%;
    padding: 1em;
}

.bg-image {
    height: 100px;
    width: 100px;
    background-color: #bbb;
    margin: 1em 0;
}

.main-content {
    float: right;
    width: 67%;
    padding: 1em;
}

.footer {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 10px;
}

.footer a {
    color: white;
    text-decoration: none;
    margin: 0 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">{{ slot_0 }}</div>
<div class="menu">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="specials-deals">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<div class="bg-image ph"></div>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div class="main-content">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="bg-image ph"></div>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<div class="bg-image ph"></div>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="bg-image ph"></div>
</div>
<div class="footer">
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
</div>
</body>
</html>