}
.container {
    display: flex;
    justify-content: space-between;
    width: 80%;
    margin: 0 auto;
}
.left-column, .right-column {
    width: 45%;
    padding: 20px;
    background-color: #fff;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
