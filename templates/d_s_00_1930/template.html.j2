<div class="box ph" style="inset-inline-start: 40.2mm; inset-block-start: 211.6mm; inline-size: 21.6mm; block-size: 26.9mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 68.1mm; inset-block-start: 222.9mm; inline-size: 121.7mm; block-size: 39.6mm; font-size: 10.9pt"></div>
<footer class="box" style="inset-inline-start: 103.8mm; inset-block-start: 266.9mm; inline-size: 3.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_3 }}</footer>
</div></body>
</html>
