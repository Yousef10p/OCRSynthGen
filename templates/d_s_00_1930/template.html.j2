<div class="box ph" style="inset-inline-start: 61.8mm; inset-block-start: 88.1mm; inline-size: 127.9mm; block-size: 16.5mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 109.1mm; inline-size: 132.5mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 26.1mm; inset-block-start: 118.8mm; inline-size: 39.8mm; block-size: 26.7mm; font-size: 15.1pt"></div>
<div class="box ph" style="inset-inline-start: 68.1mm; inset-block-start: 129.6mm; inline-size: 121.7mm; block-size: 34.4mm; font-size: 10.9pt"></div>
