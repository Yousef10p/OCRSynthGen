}

#reservation form {
    display: flex;
    flex-direction: column;
    max-width: 400px;
    margin: auto;
}

#reservation form * {
    margin: 10px 0;
}

#social-links {
    display: flex;
    justify-content: space-around;
    padding: 20px;
    background-color: lightsalmon;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
