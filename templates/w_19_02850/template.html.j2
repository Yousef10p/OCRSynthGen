}

body {
    font-family: var(--font-body);
}

header {
    width: 100%;
    height: 50vh;
    background-color: pink;
}

#menu {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 20px;
}

.menu-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px;
    background-color: lightblue;
}

#reservation {
