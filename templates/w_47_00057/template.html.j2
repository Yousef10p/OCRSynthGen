<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    background-color: #f0f0f0;
    font-family: var(--font-body);
}
.header {
    background-color: #000;
    color: #fff;
    padding: 20px;
}
.header img {
    max-height: 120px;
    max-width: 120px;
    margin: 10px;
}
.header p {
    font-size: 1.5em;
}
.cta {
    background-color: #f00;
    color: #fff;
    border: none;
    padding: 15px 32px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 16px;
    margin: 4px 2px;
    cursor: pointer;
}
.product-grid {
    display: grid;
    grid-template-columns: auto auto auto;
    gap: 10px;
    background-color: #ddd;
    padding: 10px;
}
.product-grid img {
    max-height: 200px;
    max-width: 200px;
    margin: auto;
    display: block;
}
.product-grid p {
    margin: 2px 2px;
    font-size: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h1>{{ slot_0 }}</h1>
<div class="slider">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</div>
<p>{{ slot_1 }}</p>
<button class="cta">{{ slot_2 }}</button>
</div>
<div class="product-grid">
<div class="product"><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_3 }}</p><button>{{ slot_4 }}</button></div>
<div class="product"><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_5 }}</p><button>{{ slot_6 }}</button></div>
<div class="product"><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_7 }}</p><button>{{ slot_8 }}</button></div>
<div class="product"><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_9 }}</p><button>{{ slot_10 }}</button></div>
<div class="product"><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_11 }}</p><button>{{ slot_12 }}</button></div>
<div class="product"><div class="ph" style="inline-size: 100%; block-size: 150px"></div><p>{{ slot_13 }}</p><button>{{ slot_14 }}</button></div>
</div>
</body>
</html>