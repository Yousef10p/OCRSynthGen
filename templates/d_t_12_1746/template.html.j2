<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 19.1mm; inset-block-start: 15.8mm; inline-size: 1.8mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 98.2mm; inset-block-start: 15.8mm; inline-size: 22.7mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_1 }}</header><div class="box ph" style="inset-inline-start: 18.0mm; inset-block-start: 23.8mm; inline-size: 177.9mm; block-size: 167.7mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 17.9mm; inset-block-start: 194.1mm; inline-size: 180.3mm; block-size: 12.0mm; font-size: 8.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 17.9mm; inset-block-start: 208.7mm; inline-size: 86.2mm; block-size: 6.9mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 115.2mm; inset-block-start: 208.7mm; inline-size: 61.1mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 116.3mm; inset-block-start: 216.3mm; inline-size: 81.9mm; block-size: 48.5mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
<h2 class="box" style="inset-inline-start: 52.2mm; inset-block-start: 218.5mm; inline-size: 17.6mm; block-size: 2.8mm; font-size: 8.5pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 17.9mm; inset-block-start: 223.5mm; inline-size: 86.2mm; block-size: 33.4mm; font-size: 10.0pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 51.3mm; inset-block-start: 260.3mm; inline-size: 19.4mm; block-size: 3.1mm; font-size: 9.5pt">{{ slot_8 }}</h2>
</div></body>
</html>
