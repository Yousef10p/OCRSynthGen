<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 22.4mm; inset-block-start: 10.2mm; inline-size: 77.1mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 22.8mm; inline-size: 215.2mm; block-size: 86.2mm; font-size: 34.9pt"></div>
<h2 class="box" style="inset-inline-start: 21.6mm; inset-block-start: 110.4mm; inline-size: 179.3mm; block-size: 58.1mm; font-size: 40.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 175.6mm; inline-size: 82.8mm; block-size: 18.1mm; font-size: 12.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 110.2mm; inset-block-start: 175.6mm; inline-size: 82.6mm; block-size: 32.4mm; font-size: 13.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.4mm; inset-block-start: 197.8mm; inline-size: 81.2mm; block-size: 51.4mm; font-size: 13.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.2mm; inset-block-start: 212.1mm; inline-size: 84.0mm; block-size: 13.3mm; font-size: 12.6pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 22.2mm; inset-block-start: 269.9mm; inline-size: 36.4mm; block-size: 2.4mm; font-size: 6.8pt">{{ slot_6 }}</footer>
</div></body>
</html>
