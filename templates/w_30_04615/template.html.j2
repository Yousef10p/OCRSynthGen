<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
}

header {
  position: fixed;
  top: 0;
  right: 0;
  width: 200px;
  height: 100%;
  background: #f8f8f8;
  display: flex;
  align-items: center;
}

nav ul {
  list-style-type: none;
}

nav ul li a {
  display: block;
  text-decoration: none;
  color: #000;
  padding: 10px;
}

nav ul li a:hover {
  background: #eee;
}

section {
  margin-right: 200px;
  padding: 20px;
  height: 100vh;
  position: relative;
}

section .carousel div {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 0;
  right: 0;
}

section .carousel div .image {
  width: 200px;
  height: 200px;
  background: #ddd;
}

section .carousel div span {
  position: absolute;
  top: 25px;
  right: 25px;
}

section .carousel div p {
  position: absolute;
  bottom: 25px;
  right: 25px;
}

section#contact form {
  display: flex;
  flex-direction: column;
  width: 50%;
  margin: 20px auto;
}

section#contact form input, section#contact form textarea {
  margin: 10px 0;
  padding: 10px;
  border: 1px solid #ddd;
}

footer {
  position: fixed;
  bottom: 0;
  right: 0;
  width: 100%;
  padding: 10px;
  text-align: center;
  background: #f8f8f8;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
