<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 4.8mm; inline-size: 46.3mm; block-size: 6.9mm; font-size: 19.6pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 7.2mm; inset-block-start: 11.6mm; inline-size: 127.6mm; block-size: 107.3mm; font-size: 23.4pt"></div>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 124.8mm; inline-size: 134.3mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 138.2mm; inline-size: 86.6mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 145.9mm; inline-size: 133.1mm; block-size: 36.4mm; font-size: 12.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 184.7mm; inline-size: 133.0mm; block-size: 18.2mm; font-size: 12.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 139.2mm; inset-block-start: 205.8mm; inline-size: 3.8mm; block-size: 4.1mm; font-size: 11.7pt"></div>
</div></body>
</html>
