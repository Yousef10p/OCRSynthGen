<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.5mm; inset-block-start: 16.2mm; inline-size: 85.9mm; block-size: 97.4mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 103.6mm; inset-block-start: 16.2mm; inline-size: 86.0mm; block-size: 63.0mm; font-size: 19.8pt"></div>
<p class="box" style="inset-inline-start: 103.8mm; inset-block-start: 81.9mm; inline-size: 86.2mm; block-size: 12.6mm; font-size: 8.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 103.5mm; inset-block-start: 98.2mm; inline-size: 85.8mm; block-size: 75.0mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 116.3mm; inline-size: 59.7mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 13.6mm; inset-block-start: 124.0mm; inline-size: 85.9mm; block-size: 60.0mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 103.7mm; inset-block-start: 175.8mm; inline-size: 80.5mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.8mm; inset-block-start: 186.8mm; inline-size: 59.5mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 187.4mm; inline-size: 71.9mm; block-size: 11.5mm; font-size: 16.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 198.2mm; inline-size: 86.8mm; block-size: 49.5mm; font-size: 12.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 200.5mm; inline-size: 86.9mm; block-size: 54.0mm; font-size: 12.7pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.7mm; inline-size: 5.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
