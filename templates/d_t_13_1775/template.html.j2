<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 20.5mm; inset-block-start: 30.7mm; inline-size: 39.5mm; block-size: 20.3mm; font-size: 14.4pt"></div>
<header class="box" style="inset-inline-start: 62.2mm; inset-block-start: 32.2mm; inline-size: 53.6mm; block-size: 8.0mm; font-size: 10.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 62.2mm; inset-block-start: 43.5mm; inline-size: 49.9mm; block-size: 6.4mm; font-size: 8.0pt">{{ slot_1 }}</header><h1 class="box" style="inset-inline-start: 30.2mm; inset-block-start: 83.8mm; inline-size: 154.3mm; block-size: 9.4mm; font-size: 24.0pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 58.8mm; inset-block-start: 102.0mm; inline-size: 97.0mm; block-size: 8.6mm; font-size: 22.0pt">{{ slot_3 }}</h1>
<h1 class="box" style="inset-inline-start: 50.3mm; inset-block-start: 120.9mm; inline-size: 112.1mm; block-size: 8.6mm; font-size: 22.0pt">{{ slot_4 }}</h1>
<h1 class="box" style="inset-inline-start: 57.8mm; inset-block-start: 148.4mm; inline-size: 98.7mm; block-size: 7.0mm; font-size: 18.0pt">{{ slot_5 }}</h1>
<h1 class="box" style="inset-inline-start: 58.4mm; inset-block-start: 167.6mm; inline-size: 93.6mm; block-size: 6.3mm; font-size: 16.0pt">{{ slot_6 }}</h1>
<footer class="box" style="inset-inline-start: 22.2mm; inset-block-start: 275.2mm; inline-size: 107.5mm; block-size: 14.8mm; font-size: 9.0pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 169.5mm; inset-block-start: 286.2mm; inline-size: 20.3mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
