    background-color: #f8f8f8;
    padding: 20px;
}

header img {
    width: 100px;
    height: 100px;
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: space-around;
    width: 50%;
}

main {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 50px;
}

section {
    width: 90%;
}

.products, .services {
    display: flex;
