<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

header {
    background-color: #f8f9fa;
    padding: 20px;
    width: 100%;
    text-align: center;
}

header h1 {
    margin: 0;
}

header form {
    margin-top: 20px;
}

header form input {
    width: 300px;
    height: 30px;
    padding: 20px;
}

main {
    margin-top: 20px;
    display: grid;
    grid-template-columns: auto auto auto;
}

.properties {
    margin-top: 20px;
    margin-left: 20px;
}

.property {
    margin: 500px;
}

.image {
    width: 200px;
    height: 100px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</form>
</header>
<main>
<h2>{{ slot_2 }}</h2>
<div class="properties">
<div class="property">{{ slot_3 }} <div class="image ph"></div><p>{{ slot_4 }}</p></div>
<div class="property">{{ slot_5 }} <div class="image ph"></div><p>{{ slot_6 }}</p></div>
<div class="property">{{ slot_7 }} <div class="image ph"></div><p>{{ slot_8 }}</p></div>
<div class="property">{{ slot_9 }} <div class="image ph"></div><p>{{ slot_10 }}</p></div>
<div class="property">{{ slot_11 }} <div class="image ph"></div><p>{{ slot_12 }}</p></div>
<div class="property">{{ slot_13 }} <div class="image ph"></div><p>{{ slot_14 }}</p></div>
</div>
</main>
</body>
</html>