* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
}

header, nav, section, aside, footer {
  padding: 20px;
}

header {
  background-color: #f2f2f2;
}

nav ul {
  display: flex;
  justify-content: center;
}

nav li {
  margin: 0 10px;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-gap: 20px;
}

.gallery__item {
  aspect-ratio: 16/9;
  background-color: #f2f2f2; 
}

form {
  display: grid;
  grid-gap: 10px;
}

footer {
  background-color: #f2f2f2;
  text-align: center;
  padding: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
