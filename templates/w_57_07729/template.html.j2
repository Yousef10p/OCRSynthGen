    align-items: center;
}

.hero-rectangle {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background-color: #ccc;
}

.product {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
}

.product-rectangle {
    width: 200px;
    height: 200px;
    background-color: #ccc;
}

.cta {
    display: inline-block;
