    padding: 50px;
    text-align: center;
}

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333; 
}

nav ul li {
    float: right;
}

nav ul li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

.content {
    display: flex;
    margin: 20px;
}

.content aside {
    flex: 1;
    background: #f2f2f2; 
    padding: 20px;
}

.content article {
    flex: 3;
    background-color: #fff; 
    padding: 20px;
    margin-right: 20px;
}

footer {
    background-color: #333; 
    color: white;
    text-align: center;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
