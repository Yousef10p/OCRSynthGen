<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 22.6mm; inset-block-start: 19.8mm; inline-size: 47.4mm; block-size: 6.1mm; font-size: 17.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 112.9mm; inset-block-start: 19.8mm; inline-size: 79.8mm; block-size: 46.1mm; font-size: 13.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 22.6mm; inset-block-start: 27.9mm; inline-size: 79.8mm; block-size: 41.3mm; font-size: 13.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 31.8mm; inset-block-start: 71.7mm; inline-size: 59.7mm; block-size: 46.6mm; font-size: 18.9pt"></div>
<div class="box ph" style="inset-inline-start: 118.1mm; inset-block-start: 76.1mm; inline-size: 66.3mm; block-size: 35.2mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 112.9mm; inset-block-start: 121.8mm; inline-size: 80.3mm; block-size: 46.1mm; font-size: 13.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.6mm; inset-block-start: 125.2mm; inline-size: 80.7mm; block-size: 50.8mm; font-size: 13.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 3.0mm; inset-block-start: 181.9mm; inline-size: 209.6mm; block-size: 69.4mm; font-size: 15.1pt"></div>
<footer class="box" style="inset-inline-start: 171.8mm; inset-block-start: 257.5mm; inline-size: 13.6mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 194.8mm; inset-block-start: 270.2mm; inline-size: 1.8mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
