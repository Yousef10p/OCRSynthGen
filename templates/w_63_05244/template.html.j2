    padding-bottom: 5px;
}

p {
    line-height: 1.6;
}

section {
    margin: 100px 0;
    padding: 20px;
    width: 100%;
    max-width: 800px;
}

.portfolio-item {
    width: 25%;
    height: 200px;
    background-color: #333;
    display: inline-block;
    margin: 10px;
}

aside {
    width: 20%;
    float: left;
    background-color: #555;
    color: #fff;
    padding: 20px;
    position: fixed;
    top: 0;
    left: 0;
    width: 20%;
    height: 100%;
    overflow: auto;
}

aside h3 {
    margin-top: 30px;
}

aside ul {
    list-style: none;
    padding: 0;
}

aside a {
    text-decoration: none;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
