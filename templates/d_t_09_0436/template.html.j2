<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 44.4mm; inset-block-start: 47.0mm; inline-size: 126.5mm; block-size: 11.2mm; font-size: 10.9pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.4mm; inset-block-start: 65.6mm; inline-size: 126.5mm; block-size: 11.2mm; font-size: 10.9pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.4mm; inset-block-start: 84.2mm; inline-size: 126.5mm; block-size: 11.2mm; font-size: 10.9pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.4mm; inset-block-start: 102.9mm; inline-size: 126.5mm; block-size: 11.2mm; font-size: 10.9pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 44.4mm; inset-block-start: 121.5mm; inline-size: 126.5mm; block-size: 18.9mm; font-size: 10.9pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 44.4mm; inset-block-start: 156.4mm; inline-size: 31.1mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 44.4mm; inset-block-start: 168.8mm; inline-size: 126.5mm; block-size: 49.8mm; font-size: 10.9pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 89.4mm; inset-block-start: 225.9mm; inline-size: 36.5mm; block-size: 10.2mm; font-size: 10.9pt"></div>
