}

.game-review, .game-tutorial {
    margin-bottom: 15px;
}

.image-placeholder {
    background: #d1d5db;
    height: 150px;
    margin-top: 15px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
