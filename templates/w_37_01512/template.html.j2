    padding: 15px 0;
}

nav ul {
    list-style-type: none;
    display: flex;
    justify-content: space-around;
}

nav ul li a {
    text-decoration: none;
    color: #f3f4f6;
}

.banner {
    background: #a5b4fc;
    color: #f3f4f6;
    padding: 20px;
