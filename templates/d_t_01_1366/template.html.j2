<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.1mm; inset-block-start: 0.5mm; inline-size: 57.4mm; block-size: 51.2mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 89.4mm; inline-size: 59.7mm; block-size: 10.0mm; font-size: 28.4pt">{{ slot_0 }}</p>
<header class="box" style="inset-inline-start: 199.7mm; inset-block-start: 89.4mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 116.3mm; inset-block-start: 121.2mm; inline-size: 81.0mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 57.3mm; inset-block-start: 133.1mm; inline-size: 140.0mm; block-size: 27.2mm; font-size: 19.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 57.3mm; inset-block-start: 168.5mm; inline-size: 141.3mm; block-size: 35.0mm; font-size: 19.8pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 56.9mm; inset-block-start: 219.7mm; inline-size: 153.0mm; block-size: 52.0mm; font-size: 14.7pt"></div>
</div></body>
</html>
