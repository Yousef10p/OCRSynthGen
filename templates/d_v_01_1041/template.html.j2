<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.0mm; inset-block-start: 15.6mm; inline-size: 86.5mm; block-size: 49.8mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 68.1mm; inline-size: 47.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 78.6mm; inline-size: 81.2mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 84.7mm; inline-size: 81.3mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 95.4mm; inline-size: 84.4mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 106.0mm; inline-size: 84.9mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 116.6mm; inline-size: 85.5mm; block-size: 13.2mm; font-size: 12.4pt"><li>{{ slot_5 }}</li></ul>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 135.4mm; inline-size: 19.9mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 141.0mm; inline-size: 88.9mm; block-size: 44.8mm; font-size: 12.7pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 26.3mm; inset-block-start: 189.4mm; inline-size: 86.3mm; block-size: 46.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 238.6mm; inline-size: 86.1mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 194.9mm; inset-block-start: 262.8mm; inline-size: 8.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
