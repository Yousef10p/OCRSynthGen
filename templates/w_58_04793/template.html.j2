<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #EFEFEF;
}

nav ul {
    display: flex;
    flex-direction: row;
    list-style-type: none;
    justify-content: space-around;
}

nav ul li a {
    text-decoration: none;
    color: #000;
}

.content {
    display: flex;
    flex-direction: row;
    margin-top: 50px;
}

.product {
    width: 100px;
    height: 100px;
    background-color: #FF0000;
    margin: 10px;
}

.new-arrivals, .trends {
    flex: 1;
}

h1, p {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<div class="content">
<section class="new-arrivals">
<h1>{{ slot_6 }}</h1>
<div class="product">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
<div class="product">{{ slot_9 }}</div>
<p>{{ slot_10 }}</p>
</section>
<section class="trends">
<h1>{{ slot_11 }}</h1>
<div class="product">{{ slot_12 }}</div>
<p>{{ slot_13 }}</p>
<div class="product">{{ slot_14 }}</div>
<p>{{ slot_15 }}</p>
</section>
</div>
</body>
</html>