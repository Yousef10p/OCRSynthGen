<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 64.3mm; inset-block-start: 52.6mm; inline-size: 97.6mm; block-size: 31.1mm; font-size: 11.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 64.3mm; inset-block-start: 88.4mm; inline-size: 97.7mm; block-size: 14.9mm; font-size: 10.5pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 64.5mm; inset-block-start: 112.0mm; inline-size: 44.2mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 64.2mm; inset-block-start: 116.8mm; inline-size: 97.8mm; block-size: 30.8mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 64.4mm; inset-block-start: 152.4mm; inline-size: 97.5mm; block-size: 14.9mm; font-size: 10.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 64.2mm; inset-block-start: 172.1mm; inline-size: 98.0mm; block-size: 27.0mm; font-size: 10.9pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 64.4mm; inset-block-start: 203.9mm; inline-size: 42.4mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 64.1mm; inset-block-start: 208.6mm; inline-size: 97.8mm; block-size: 15.1mm; font-size: 10.7pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 111.8mm; inset-block-start: 229.8mm; inline-size: 3.4mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
