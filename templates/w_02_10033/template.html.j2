<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html, * {margin:0;padding:0;}

body, input, a, p, textarea, button {
    font-size: 16px;
    font-family: var(--font-body);
}

div {
    width: 100%;
    padding: 25px;
}

.nav-left {
    float: right;
    width: 20%;
    background-color: #333;
    color: #fff;
}

li {
    list-style-type: none;
}

a {
    color: #fff;
    text-decoration: none;
}

.filter-category, .featured-center {
    float: left;
    width: 80%;
    background-color: #f8f8f8;
}

.filter-category ul, .featured-center ul {
    padding-right: 20px;
}

.service-box {
    background-color: darkred;
    color: #fff;
    padding: 10px;
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="nav-left">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="filter-category">
<h2>{{ slot_5 }}</h2>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</div>
<div class="featured-center">
<h2>{{ slot_10 }}</h2>
<div class="service-box">
<h3>{{ slot_11 }}</h3>
</div>
<div class="service-box">
<h3>{{ slot_12 }}</h3>
</div>
<div class="service-box">
<h3>{{ slot_13 }}</h3>
</div>
<div class="service-box">
<h3>{{ slot_14 }}</h3>
</div>
</div>
</body>
</html>