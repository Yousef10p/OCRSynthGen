<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 10.0mm; inset-block-start: 2.0mm; inline-size: 196.1mm; block-size: 15.8mm; font-size: 22.4pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 27.1mm; inset-block-start: 33.6mm; inline-size: 102.8mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 26.9mm; inset-block-start: 40.6mm; inline-size: 158.6mm; block-size: 163.9mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 209.2mm; inline-size: 70.8mm; block-size: 4.2mm; font-size: 6.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 34.0mm; inset-block-start: 213.7mm; inline-size: 125.3mm; block-size: 4.2mm; font-size: 5.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 34.0mm; inset-block-start: 218.2mm; inline-size: 142.0mm; block-size: 8.7mm; font-size: 6.2pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 34.0mm; inset-block-start: 227.2mm; inline-size: 141.4mm; block-size: 8.7mm; font-size: 6.2pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 34.0mm; inset-block-start: 236.2mm; inline-size: 148.0mm; block-size: 8.7mm; font-size: 6.2pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 245.2mm; inline-size: 153.3mm; block-size: 17.7mm; font-size: 8.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 263.2mm; inline-size: 151.6mm; block-size: 17.7mm; font-size: 10.0pt">{{ slot_8 }}</p>
</div></body>
</html>
