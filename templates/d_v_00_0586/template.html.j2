<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 19.5mm; inset-block-start: 14.7mm; inline-size: 85.0mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 35.0mm; inline-size: 33.9mm; block-size: 12.0mm; font-size: 11.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 57.4mm; inline-size: 163.0mm; block-size: 16.5mm; font-size: 11.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 79.7mm; inline-size: 166.0mm; block-size: 25.5mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 111.0mm; inline-size: 166.1mm; block-size: 16.5mm; font-size: 11.7pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 24.3mm; inset-block-start: 132.6mm; inline-size: 77.1mm; block-size: 13.1mm; font-size: 37.2pt"></div>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 146.7mm; inline-size: 21.8mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.6mm; inset-block-start: 151.2mm; inline-size: 66.1mm; block-size: 7.6mm; font-size: 10.7pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 13.9mm; inset-block-start: 278.8mm; inline-size: 3.1mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 287.2mm; inline-size: 63.7mm; block-size: 2.3mm; font-size: 6.5pt">{{ slot_8 }}</footer>
</div></body>
</html>
