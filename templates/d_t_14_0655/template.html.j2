<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 140.3mm; inset-block-start: 2.1mm; inline-size: 69.6mm; block-size: 34.8mm; font-size: 14.1pt"></div>
<div class="box ph" style="inset-inline-start: 14.5mm; inset-block-start: 17.1mm; inline-size: 42.0mm; block-size: 20.6mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 50.2mm; inline-size: 160.2mm; block-size: 11.6mm; font-size: 9.0pt">{{ slot_0 }}</p>
<h1 class="box" style="inset-inline-start: 91.0mm; inset-block-start: 68.2mm; inline-size: 30.0mm; block-size: 6.8mm; font-size: 16.0pt">{{ slot_1 }}</h1>
<h1 class="box" style="inset-inline-start: 31.2mm; inset-block-start: 81.4mm; inline-size: 149.4mm; block-size: 20.5mm; font-size: 16.0pt">{{ slot_2 }}</h1>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 106.2mm; inline-size: 157.3mm; block-size: 18.9mm; font-size: 11.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 133.3mm; inline-size: 13.3mm; block-size: 3.8mm; font-size: 9.0pt">{{ slot_4 }}</h2>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 139.3mm; inline-size: 154.0mm; block-size: 19.3mm; font-size: 9.0pt"><li>{{ slot_5 }}</li></ul>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 166.7mm; inline-size: 38.9mm; block-size: 3.8mm; font-size: 9.0pt">{{ slot_6 }}</h2>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 172.7mm; inline-size: 154.0mm; block-size: 15.4mm; font-size: 9.0pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 190.2mm; inline-size: 154.0mm; block-size: 23.2mm; font-size: 9.0pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 215.5mm; inline-size: 153.9mm; block-size: 23.2mm; font-size: 9.0pt"><li>{{ slot_9 }}</li></ul>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 240.8mm; inline-size: 153.9mm; block-size: 11.6mm; font-size: 9.0pt"><li>{{ slot_10 }}</li></ul>
<footer class="box" style="inset-inline-start: 133.0mm; inset-block-start: 274.9mm; inline-size: 52.4mm; block-size: 9.6mm; font-size: 8.0pt">{{ slot_11 }}</footer>
</div></body>
</html>
