<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 20px;
    font-family: var(--font-body);
}

header, .slider .slide, .events-container, .volunteering-container {
    padding: 20px;
}

header {
    background-color: #0066cc;
    color: white;
}

h1 {
    font-size: 2em;
    margin-bottom: 20px;
}

.cta {
    display: inline-block;
    background-color: white;
    padding: 10px 20px;
    color: #0066cc;
    text-decoration: none;
}

.slide, .event, .opportunity {
    border: 1px solid #000;
    padding: 20px;
    margin-bottom: 10px;
}

.slide:nth-child(1) {
    background-color: #ffcc00;
}

.slide:nth-child(2) {
    background-color: #ff6600;
}

.slide:nth-child(3) {
    background-color: #ff0000;
}

.event, .opportunity {
    background-color: #cccccc;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<a class="cta">{{ slot_1 }}</a>
</header>
<div class="slider">
<div class="slide">
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
</div>
<div class="slide">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
</div>
<div class="slide">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
</div>
<div class="events-container">
<h2>{{ slot_8 }}</h2>
<div class="event">{{ slot_9 }}</div>
<div class="event">{{ slot_10 }}</div>
<div class="event">{{ slot_11 }}</div>
</div>
<div class="volunteering-container">
<h2>{{ slot_12 }}</h2>
<div class="opportunity">{{ slot_13 }}</div>
<div class="opportunity">{{ slot_14 }}</div>
<div class="opportunity">{{ slot_15 }}</div>
</div>
</body>
</html>