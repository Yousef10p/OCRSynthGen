<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 7.1mm; inset-block-start: 5.9mm; inline-size: 44.7mm; block-size: 34.6mm; font-size: 14.0pt"></div>
<div class="box ph" style="inset-inline-start: 57.9mm; inset-block-start: 6.2mm; inline-size: 45.0mm; block-size: 34.4mm; font-size: 13.9pt"></div>
<div class="box ph" style="inset-inline-start: 109.4mm; inset-block-start: 6.1mm; inline-size: 44.8mm; block-size: 34.4mm; font-size: 13.9pt"></div>
<p class="box" style="inset-inline-start: 26.3mm; inset-block-start: 63.2mm; inline-size: 71.7mm; block-size: 26.6mm; font-size: 15.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 115.2mm; inset-block-start: 63.2mm; inline-size: 75.5mm; block-size: 77.7mm; font-size: 15.7pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 26.1mm; inset-block-start: 96.7mm; inline-size: 76.2mm; block-size: 56.0mm; font-size: 14.4pt"></div>
<div class="box ph" style="inset-inline-start: 115.0mm; inset-block-start: 149.9mm; inline-size: 74.9mm; block-size: 108.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 37.3mm; inset-block-start: 153.0mm; inline-size: 52.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 26.3mm; inset-block-start: 165.3mm; inline-size: 72.2mm; block-size: 26.7mm; font-size: 15.1pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 26.3mm; inset-block-start: 198.5mm; inline-size: 55.1mm; block-size: 5.6mm; font-size: 15.8pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 26.3mm; inset-block-start: 209.7mm; inline-size: 74.4mm; block-size: 43.6mm; font-size: 15.5pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 25.8mm; inset-block-start: 263.3mm; inline-size: 35.3mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_6 }}</footer>
</div></body>
</html>
