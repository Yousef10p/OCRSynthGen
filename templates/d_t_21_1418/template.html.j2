<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 54.4mm; inline-size: 141.4mm; block-size: 24.9mm; font-size: 17.6pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 33.5mm; inset-block-start: 85.9mm; inline-size: 146.0mm; block-size: 37.0mm; font-size: 15.0pt"></div>
<p class="box" style="inset-inline-start: 46.7mm; inset-block-start: 127.2mm; inline-size: 116.7mm; block-size: 5.9mm; font-size: 16.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 138.2mm; inline-size: 19.5mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_5 }}</p>
