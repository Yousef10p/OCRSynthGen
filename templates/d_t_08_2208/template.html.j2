<div class="box ph" style="inset-inline-start: 60.2mm; inset-block-start: 131.9mm; inline-size: 119.7mm; block-size: 12.4mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 30.0mm; inset-block-start: 150.0mm; inline-size: 150.0mm; block-size: 50.2mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 210.6mm; inline-size: 135.3mm; block-size: 6.0mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 84.8mm; inset-block-start: 224.3mm; inline-size: 95.1mm; block-size: 9.2mm; font-size: 10.9pt"></div>
<div class="box ph" style="inset-inline-start: 71.2mm; inset-block-start: 232.8mm; inline-size: 108.8mm; block-size: 12.4mm; font-size: 10.9pt"></div>
