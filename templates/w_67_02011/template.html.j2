    border-bottom: 2px solid #343a40;
}

form button {
    background-color: #343a40;
    color: #f8f9fa;
    cursor: pointer;
    border: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
