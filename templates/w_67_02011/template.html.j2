    margin: 0;
    padding: 1rem;
}

nav ul {
    list-style-type: none;
    padding-inline-start: 0;
}

nav ul li {
    display: inline;
    margin: 0 1rem;
}

nav ul li a {
    text-decoration: none;
    color: #f8f9fa;
    font-weight: bold;
}


section {
    margin: 4rem 0;
}


form {
    display: flex;
