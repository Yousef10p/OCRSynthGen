  background-color: #f8f9fa;
}

#nutrition-info a,
#contact-details p {
  font-size: 14px;
  color: #6c757d;
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
