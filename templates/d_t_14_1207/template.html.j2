<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.6mm; inset-block-start: 13.4mm; inline-size: 57.2mm; block-size: 15.3mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 93.7mm; inset-block-start: 13.5mm; inline-size: 28.4mm; block-size: 20.6mm; font-size: 8.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 149.7mm; inset-block-start: 13.5mm; inline-size: 22.1mm; block-size: 14.8mm; font-size: 8.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 43.9mm; inline-size: 159.2mm; block-size: 8.6mm; font-size: 10.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 56.7mm; inline-size: 44.9mm; block-size: 4.7mm; font-size: 11.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 65.7mm; inline-size: 159.7mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 87.2mm; inline-size: 161.8mm; block-size: 17.1mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 25.6mm; inset-block-start: 109.4mm; inline-size: 158.1mm; block-size: 147.4mm; font-size: 14.9pt"></div>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 275.5mm; inline-size: 101.8mm; block-size: 7.9mm; font-size: 8.0pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 165.1mm; inset-block-start: 280.0mm; inline-size: 20.6mm; block-size: 3.4mm; font-size: 8.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
