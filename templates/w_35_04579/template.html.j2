<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

.nav {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #f8f9fa;
}

.nav ul {
    padding: 0;
    margin: 0;
    list-style-type: none;
    overflow: hidden;
}

.nav li {
    float: right;
}

.nav li a {
    display: block;
    text-decoration: none;
    padding: 1em;
    color: #495057;
}

.nav li a:hover {
    background-color: #e9ecef;
}

.main-content {
    padding: 5em;
}

h1, h2 {
    color: #007bff;
}

p {
    line-height: 1.6;
}



@media (max-width: 600px) {
    .nav li {
        float: none;
        width: 100%;
    }

    .nav a {
        text-align: center;
    }

    .main-content {
        padding: 1em;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="nav">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="main-content">
<h1>{{ slot_6 }}</h1>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
</body>
</html>