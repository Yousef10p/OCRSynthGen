<p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 81.6mm; inline-size: 160.0mm; block-size: 20.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 106.9mm; inline-size: 160.0mm; block-size: 37.5mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 27.4mm; inset-block-start: 150.9mm; inline-size: 160.0mm; block-size: 45.9mm; font-size: 12.0pt">{{ slot_6 }}</p>
