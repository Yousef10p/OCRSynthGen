<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  color: #333;
}

.nav {
  background: linear-gradient(to bottom, #333, #666);
  color: #fff;
  padding: 10px 0;
}

.nav__list {
  list-style: none;
  text-align: center;
}

.nav__item {
  display: inline-block;
  margin: 0 5px;
}

.nav__item--active {
  font-weight: bold;
}

.sidebar {
  background: #eee;
}

.sidebar__list {
  list-style: none;
}

button {
  background: #333;
  color: #fff;
  border: none;
  padding: 10px;
  cursor: pointer;
}

button:hover {
  background: #666;
}

.content__paragraph {
  display: none;
}

.content {
  padding: 20px;
  box-shadow: 0 0 10px rgba(0,0,0,0.3);
}

.footer {
  position: sticky;
  bottom: 0;
  width: 100%;
  background: #333;
  color: #fff;
  text-align: center;
  padding: 10px 0;
}


@media screen and (max-width: 768px) {
  .sidebar, .content {
    width: 100%;
  }
}


@media screen and (min-width: 769px) and (max-width: 990px) {
  .sidebar, .content {
    width: 50%;
  }
}


@media screen and (min-width: 991px) {
  .content {
    width: 70%;
  }
  .sidebar {
    width: 30%;
    float: left;
  }
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
