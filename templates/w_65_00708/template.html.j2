    text-align: center;
    padding: 20px 0;
}
.footer-content {
    margin: 20px 0;
}
.footer-logo {
    font-size: 36px;
    margin: 20px 0;
}
.social-media a {
    color: white;
    margin: 0 10px;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
