<p class="box" style="inset-inline-start: 17.3mm; inset-block-start: 46.3mm; inline-size: 85.5mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 19.4mm; inset-block-start: 58.1mm; inline-size: 179.2mm; block-size: 5.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 17.3mm; inset-block-start: 73.1mm; inline-size: 181.3mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 17.3mm; inset-block-start: 91.7mm; inline-size: 181.5mm; block-size: 28.5mm; font-size: 12.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 71.6mm; inset-block-start: 129.5mm; inline-size: 72.5mm; block-size: 3.9mm; font-size: 12.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 17.3mm; inset-block-start: 138.9mm; inline-size: 181.4mm; block-size: 36.4mm; font-size: 12.0pt">{{ slot_6 }}</p>
