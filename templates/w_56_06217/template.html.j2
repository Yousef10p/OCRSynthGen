}

#image-slider article {
    position: relative;
    color: #000;
    
}

#image-slider .image {
    width: 100%;
    height: 300px;
    
    background-color: #fff;
    
}

#image-slider h2 {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    
}

#image-slider p,
#image-slider a {
    color: #000;
}

#products div {
    width: 30%;
    margin: 20px;
    height: 500px;
    float: right;
    background-color: #fff;
    
}

footer {
    background-color: #000;
    color: #fff;
    text-align: center;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
