<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 21.9mm; inset-block-start: 26.3mm; inline-size: 166.9mm; block-size: 10.5mm; font-size: 10.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 27.2mm; inset-block-start: 40.4mm; inline-size: 112.1mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 69.6mm; inset-block-start: 52.6mm; inline-size: 119.3mm; block-size: 14.8mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 21.9mm; inset-block-start: 74.2mm; inline-size: 167.0mm; block-size: 31.6mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 40.2mm; inset-block-start: 115.2mm; inline-size: 124.0mm; block-size: 62.4mm; font-size: 6.8pt"></div>
<p class="box" style="inset-inline-start: 21.9mm; inset-block-start: 186.1mm; inline-size: 166.9mm; block-size: 7.7mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 56.0mm; inset-block-start: 206.1mm; inline-size: 90.4mm; block-size: 51.9mm; font-size: 7.2pt"></div>
<p class="box" style="inset-inline-start: 28.5mm; inset-block-start: 264.0mm; inline-size: 153.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 103.6mm; inset-block-start: 279.5mm; inline-size: 3.5mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
