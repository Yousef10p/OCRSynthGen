}
.product-image {
    width: 300px;
    height: 200px;
    background-color: #f5f5f5;
}
button {
    padding: 10px 20px;
    background-color: #000;
    color: #fff;
    border: none;
    cursor: pointer;
}
aside {
    position: absolute;
    left: 0;
    width: 20%;
    background-color: #fafafa;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
