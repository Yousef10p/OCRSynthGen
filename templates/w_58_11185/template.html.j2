<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

nav {
    display: flex;
    justify-content: space-between;
    background-color: #f8f8f8;
    padding: 10px;
}

nav a {
    text-decoration: none;
    color: #000;
    padding: 5px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 10px;
    padding: 10px;
}

.grid-cell {
    background-color: #ccc;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</nav>
<section class="grid">
<div class="grid-cell"><p>{{ slot_4 }}</p></div>
<div class="grid-cell"><p>{{ slot_5 }}</p></div>
<div class="grid-cell"><p>{{ slot_6 }}</p></div>
<div class="grid-cell"><p>{{ slot_7 }}</p></div>
<div class="grid-cell"><p>{{ slot_8 }}</p></div>
<div class="grid-cell"><p>{{ slot_9 }}</p></div>
<div class="grid-cell"><p>{{ slot_10 }}</p></div>
<div class="grid-cell"><p>{{ slot_11 }}</p></div>
<div class="grid-cell"><p>{{ slot_12 }}</p></div>
<div class="grid-cell"><p>{{ slot_13 }}</p></div>
<div class="grid-cell"><p>{{ slot_14 }}</p></div>
</section>
</body>
</html>