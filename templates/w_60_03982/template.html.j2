<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  height: 100%;
}



body {
  font-family: var(--font-body);
  color: #333;
  display: grid;
  grid-template-rows: auto 1fr auto;
}

header,
main,
footer {
  padding: 2rem;
}

header {
  position: relative;
  background: linear-gradient(to bottom, #000, #333),
               none;
  background-size: cover;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

header::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

header > div {
  position: relative;
  z-index: 1;
}

form {
  display: grid;
  gap: 1rem;
  margin-top: 2rem;
}

input,
textarea {
  padding: 0.5rem;
  border: none;
  border-radius: 0.25rem;
}

input[type="submit"] {
  background-color: #008CBA;
  color: #fff;
  cursor: pointer;
}

main {
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

section {
  padding: 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

footer {
  display: flex;
  justify-content: center;
  background-color: #333;
  color: #fff;
}

ul {
  list-style: none;
  display: flex;
}

ul li {
  margin: 0 1rem;
}

ul li a {
  color: #fff;
  text-decoration: none;
  position: relative;
}

ul li a::after {
  content: "";
  position: absolute;
  bottom: -2px;
  right: 0;
  width: 100%;
  height: 2px;
  background-color: #fff;
  transform: scaleX(0);
  transition: transform 0.3s ease-in;
}

ul li a:hover::after {
  transform: scaleX(1);
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
