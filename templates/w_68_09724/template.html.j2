<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
}
header {
  	position: relative;
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 1em;
}
header img {
	max-width: 2em;
}
header nav {
	position: absolute;
	left: 1em;
	top: 50%;
	transform: translateY(-50%);
}
header ul {
	display: none;
}
header ul li {
	margin: 1.5em 0;
}
#mobile_menudropdown {
	display: block;
}
main {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
	padding: 1em;
}
main section {
	border: 1px solid #ddd;
	padding: 1em;
	margin: 1em;
}
footer {
	display: flex;
	justify-content: center;
	align-items: center;
	gap: 1em;
	padding: 1em 0;
	background-color: #f5f5f5;
}
footer img {
	max-width: 2em;
}
@media (min-width: 600px) {    
	header #hamburger_icon {
		display: none;
	}
	header ul {
		display: flex;
		gap: 1em;
	}
	#mobile_menu {
		display: none;
	}
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
