*􀋞􀋟 {
    box-sizing: border-box;
}
body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}
header {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #f8f8f8;
    padding: 10px;
}
nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
}
nav ul li {
    margin: 0 10px;
}
nav form {
    margin-right: auto;
}
main {
    margin: 150px 20px;
}
#news-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}
.news-article {
    background-color: #e0e0e0;
    padding: 15px;
    border-radius: 5px;
    margin-bottom: 10px;
}
.fake-image {
    height: 150px;
    margin-top: 10px;
}
aside {
    background-color: #f0f0f0;
    padding: 10px;
    border-radius: 5px;
    width: 30%;
    margin-right: 20px;
}
.social-media {
    display: flex;
    flex-direction: column;
    margin-top: 10px;
}
.social-link {
    background-color: #444;
    color: white;
    text-decoration: none;
    padding: 10px;
    margin-top: 10px;
    border-radius: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
