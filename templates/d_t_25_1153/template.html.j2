<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 118.6mm; inline-size: 150.6mm; block-size: 11.0mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 133.3mm; inline-size: 154.1mm; block-size: 11.0mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 155.0mm; inline-size: 157.9mm; block-size: 18.4mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 177.1mm; inline-size: 159.7mm; block-size: 18.4mm; font-size: 11.8pt">{{ slot_7 }}</p>
