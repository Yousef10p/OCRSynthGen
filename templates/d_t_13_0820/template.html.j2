<tr>
<th>{{ slot_1 }}</th>
<th>{{ slot_2 }}</th>
</tr>
<tr>
<td>{{ slot_3 }}</td>
<td>{{ slot_4 }}</td>
</tr>
<tr>
<td>{{ slot_5 }}</td>
<td>{{ slot_6 }}</td>
</tr>
</table></div>
<footer class="box" style="inset-inline-start: 174.6mm; inset-block-start: 258.5mm; inline-size: 4.6mm; block-size: 4.5mm; font-size: 13.8pt">{{ slot_7 }}</footer>
</div></body>
</html>
