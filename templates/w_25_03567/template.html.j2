}

.header, .services, .schedule-content, .publish-content, .track-metrics, .manage-accounts {
    padding: 20px;
}

.header {
    text-align: center;
    background-color: #4d4d4d;
    color: white;
}

.services ul {
    list-style-type: square;
}

.image-placeholder {
    width: 100%;
    height: 200px;
    background-color: #ddd;
}

@media (min-width: 768px) {
    .container {
        display: flex;
        justify-content: space-between;
    }

    .services, .schedule-content, .publish-content, .track-metrics, .manage-accounts {
        width: 48%;
    }

    .image-placeholder {
        height: 150px;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
