<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.navbar {
    background: #333;
    color: #fff;
    padding: 15px;
    text-align: center;
}

.navlist {
    list-style-type: none;
    padding: 0;
}

.navitem {
    display: inline;
    margin: 0 10px;
}

.navitem a {
    text-decoration: none;
    color: white;
}

.section1, .section2, .section3, .section4 {
    margin: 10px;
    padding: 10px;
}

.section-heading {
    font-size: 24px;
    color: #333;
}

.section-para {
    font-size: 14px;
    color: #333;
    margin-bottom: 20px;
}

.img1, .img2, .img3, .img4 {
    height: 200px;
    width: 100%;
    background: grey;
    margin-bottom: 20px;
}

.calculator-form {
    margin-bottom: 20px;
}

.calculator-form input[type="text"] {
    width: 100%;
    margin-bottom: 10px;
    padding: 10px;
    font-size: 14px;
}

.calculator-form input[type="submit"] {
    padding: 10px 20px;
    font-size: 14px;
    background: #333;
    color: #fff;
    border: none;
}

.review-container {
    display: flex;
    justify-content: space-between;
}

.review-box {
    flex: 1;
    margin-left: 10px;
    text-align: center;
}

.review-box img {
    height: 100px;
    width: 100px;
    background: grey; 
    border-radius: 50%;
}

.review-box p {
    margin: 5px 0;
}

@media screen and (max-width: 600px) {
    .review-container {
        flex-direction: column;
    }

    .review-box {
        margin-bottom: 20px;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
