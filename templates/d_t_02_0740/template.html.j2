<header class="box" style="inset-inline-start: 199.7mm; inset-block-start: 89.4mm; inline-size: 3.9mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 99.6mm; inline-size: 160.3mm; block-size: 11.6mm; font-size: 16.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 119.1mm; inline-size: 160.5mm; block-size: 11.6mm; font-size: 16.5pt">{{ slot_6 }}</p>
