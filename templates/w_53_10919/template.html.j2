<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  color: #333;
}

.header {
  position: relative;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.logo {
  position: absolute;
  top: 20px;
  right: 20px;
}

nav {
  position: absolute;
  top: 20px;
  left: 20px;
}

nav ul {
  list-style: none;
}

nav ul li {
  display: inline;
  margin-left: 20px;
}

.hero {
  text-align: center;
  padding: 20px;
}

.hero button {
  background-color: #333;
  color: #fff;
  padding: 10px 20px;
  border-radius: 20px;
  margin-top: 20px;
}

.services {
  display: flex;
  justify-content: space-around;
  padding: 50px;
}

.service {
  text-align: center;
  border: 1px solid #333;
  padding: 20px;
  border-radius: 10px;
}

.contact {
  text-align: center;
  padding: 50px;
}

.contact input,
.contact textarea {
  display: block;
  margin-bottom: 20px;
  padding: 10px;
  width: 100%;
}

footer {
  background-color: #333;
  color: #fff;
  text-align: center;
  padding: 20px;
  position: fixed;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
