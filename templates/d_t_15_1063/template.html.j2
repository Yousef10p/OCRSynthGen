<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.9mm; inset-block-start: 15.8mm; inline-size: 85.5mm; block-size: 88.6mm; font-size: 35.9pt"></div>
<div class="box ph" style="inset-inline-start: 116.7mm; inset-block-start: 16.3mm; inline-size: 85.8mm; block-size: 84.7mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 117.0mm; inset-block-start: 103.7mm; inline-size: 80.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 107.3mm; inline-size: 44.5mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 116.9mm; inset-block-start: 111.7mm; inline-size: 85.8mm; block-size: 92.0mm; font-size: 29.0pt"></div>
<div class="box ph" style="inset-inline-start: 26.6mm; inset-block-start: 114.3mm; inline-size: 86.1mm; block-size: 87.7mm; font-size: 35.5pt"></div>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 204.7mm; inline-size: 58.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 117.0mm; inset-block-start: 205.9mm; inline-size: 27.6mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 194.9mm; inset-block-start: 262.8mm; inline-size: 7.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_4 }}</footer>
</div></body>
</html>
