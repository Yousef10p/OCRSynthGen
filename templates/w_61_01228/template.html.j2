<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    font-family: var(--font-body);
}

header {
    background-color: #f8f8f8;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header form input{
    padding: 10px 20px;
    border-radius: 5px;
    border: 1px solid #ccc;
    outline: none;
}

header nav ul{
    display: flex;
}

header nav ul li{
    padding: 0 15px;
    position: relative;
}

header nav ul li a{
    text-decoration: none;
    text-transform: uppercase;
    color: black;
}

header nav ul li ul{
    background-color: #f8f8f8;
    position: absolute;
    top: 100%;
    right: 0;
    display: none;
    padding: 20px;
}

header nav ul li:hover ul{
    display: block;
}

#destinationSection {
    padding: 40px;
    display: flex;
    justify-content: space-between;
}

.destination {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.destination p, .travelTip p{
    margin: 0;
    text-align: center;
    padding: 10px;
}

#destinationSection .destinationImage, .travelTip .tipImage{
    display: block;
}

aside {
    width: 30%;
    padding: 20px;
    background-color: #f0f0f0; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
