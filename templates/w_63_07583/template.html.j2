<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	font-family: var(--font-body);
	color: #fff;
	background-color: #006600;
}

header {
	padding: 20px;
	background-color: #ff4d4d;
}

header h1 {
	text-align: center;
}

header nav ul {
	display: flex;
	justify-content: space-around;
	list-style: none;
}

header nav a {
	color: #000;
	text-decoration: none;
}

header nav a:hover {
	color: #fff;
}

main {
	margin: 20px;
}

main .game, main .event {
	margin-bottom: 20px;
	padding: 20px;
	background-color: #4da6ff;
	color: #000;
}

footer {
	padding: 20px;
	background-color: #ff8000;
}

footer h2 {
	margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
</header>
<main>
<h2>{{ slot_7 }}</h2>
<div class="game" id="game1">{{ slot_8 }}</div>
<div class="game" id="game2">{{ slot_9 }}</div>
<h2>{{ slot_10 }}</h2>
<div class="event" id="event1">{{ slot_11 }}</div>
<div class="event" id="event2">{{ slot_12 }}</div>
</main>
<footer>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<h2>{{ slot_17 }}</h2>
<p>{{ slot_18 }}</p>
</footer>
</body>
</html>