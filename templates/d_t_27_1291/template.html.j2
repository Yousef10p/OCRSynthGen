<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 48.9mm; inline-size: 139.1mm; block-size: 4.7mm; font-size: 13.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 60.5mm; inline-size: 165.1mm; block-size: 50.0mm; font-size: 28.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 117.2mm; inline-size: 160.8mm; block-size: 38.4mm; font-size: 27.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 162.8mm; inline-size: 160.6mm; block-size: 16.0mm; font-size: 22.7pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 38.2mm; inset-block-start: 185.8mm; inline-size: 19.8mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 197.0mm; inline-size: 160.6mm; block-size: 38.7mm; font-size: 27.4pt">{{ slot_7 }}</p>
