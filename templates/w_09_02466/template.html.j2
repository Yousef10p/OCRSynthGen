<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    flex-direction: column;
    align-items: center;
}

#hero {
    width: 100%;
    height: 200px;
    background-color: sandybrown;
    color: white;
    font-size: 2em;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 2em;
}

#cta {
    background-color: red;
    color: white;
    border: none;
    padding: 1em 2em;
    margin-bottom: 2em;
}

#destinations {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 2em;
}

.destination {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.image {
    width: 100%;
    height: 200px;
    margin-bottom: 1em;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}

p {
    margin: 0 0 1em 0;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<div id="hero">{{ slot_1 }}</div>
<button id="cta">{{ slot_2 }}</button>
</header>
<section id="destinations">
<div class="destination">
<div class="image">{{ slot_3 }}</div>
<p>{{ slot_4 }}</p>
<button>{{ slot_5 }}</button>
</div>
<div class="destination">
<div class="image">{{ slot_6 }}</div>
<p>{{ slot_7 }}</p>
<button>{{ slot_8 }}</button>
</div>
<div class="destination">
<div class="image">{{ slot_9 }}</div>
<p>{{ slot_10 }}</p>
<button>{{ slot_11 }}</button>
</div>
<div class="destination">
<div class="image">{{ slot_12 }}</div>
<p>{{ slot_13 }}</p>
<button>{{ slot_14 }}</button>
</div>
</section>
</body>
</html>