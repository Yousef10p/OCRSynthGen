<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.9mm; inset-block-start: 16.5mm; inline-size: 175.1mm; block-size: 107.6mm; font-size: 38.1pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 127.1mm; inline-size: 124.3mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 135.6mm; inline-size: 46.5mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 116.4mm; inset-block-start: 136.1mm; inline-size: 85.9mm; block-size: 93.3mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 142.2mm; inline-size: 84.1mm; block-size: 52.0mm; font-size: 12.3pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 198.6mm; inline-size: 44.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 205.4mm; inline-size: 86.8mm; block-size: 35.9mm; font-size: 12.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 232.2mm; inline-size: 51.8mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 195.5mm; inset-block-start: 262.7mm; inline-size: 7.4mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_6 }}</footer>
</div></body>
</html>
