<p class="box" style="inset-inline-start: 19.3mm; inset-block-start: 92.9mm; inline-size: 86.0mm; block-size: 20.2mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 107.8mm; inline-size: 86.5mm; block-size: 117.3mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 121.8mm; inline-size: 86.5mm; block-size: 72.8mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 194.7mm; inline-size: 86.5mm; block-size: 60.7mm; font-size: 10.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 136.8mm; inset-block-start: 235.0mm; inline-size: 36.5mm; block-size: 2.3mm; font-size: 9.0pt">{{ slot_6 }}</h2>
