  justify-content: space-around;
}

.hero {
  background: #f4f4f4;
  text-align: center;
  padding: 20px;
}

.hero h1, .hero p, .hero input {
  margin-bottom: 20px;
}

.service {
  display: flex;
  margin-bottom: 20px;
}

.placeholder {
  width: 200px;
  height: 200px;
  background: #ddd;
  margin-left: 20px;
}

@media (max-width: 768px) {
  .hero {
    flex-direction: column;
  }

  .service {
    flex-direction: column;
    text-align: center;
  }

  .placeholder {
    margin: 0 auto;
  }

  nav ul {
    flex-direction: column;
    text-align: center;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
