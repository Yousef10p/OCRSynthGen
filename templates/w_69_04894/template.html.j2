    height: 200px;
    background-color: #ddd;
}
#tagline {
    padding: 20px 0;
    margin-top: 20px;
    border-top: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
}
#content {
    display: flex;
    margin: 20px 0;
}
#main {
    flex: 3;
    display: flex;
    flex-direction: column;
    padding-left: 20px;
}
#sidebar {
    flex: 1;
}
#recent-posts, #categories {
    margin-bottom: 20px;
}
#newsletter form {
    display: flex;
    flex-direction: column;
}
form input[type="email"] {
    margin-bottom: 10px;
}
form button {
    padding: 5px;
}


@media screen and (max-width: 600px) {
    #content {
        flex-direction: column;
    }
    #main, #sidebar {
        width: 100% !important;
        padding: 20px 0 !important;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
