<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    background: none no-repeat center center fixed;
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    background-size: cover;
}

.navigation {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    text-align: center;
}

.navigation ul {
    display: inline-block;
    list-style-type: none;
}

.navigation li {
    display: inline-block;
    margin-left: 10px;
}

.main-content h2 {
    text-align: center;
}

.service-box,
.doctor-box,
.review-box {
    border: 1px solid black;
    background-color: lightgray;
    width: 200px;
    margin: 10px auto;
    padding: 10px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navigation">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</div>
<div class="main-content">
<h2 id="services">{{ slot_3 }}</h2>
<div class="service-box">{{ slot_4 }}</div>
<div class="service-box">{{ slot_5 }}</div>
<div class="service-box">{{ slot_6 }}</div>
<h2 id="doctors">{{ slot_7 }}</h2>
<div class="doctor-box">{{ slot_8 }}</div>
<div class="doctor-box">{{ slot_9 }}</div>
<div class="doctor-box">{{ slot_10 }}</div>
<h2 id="reviews">{{ slot_11 }}</h2>
<div class="review-box">{{ slot_12 }}</div>
<div class="review-box">{{ slot_13 }}</div>
<div class="review-box">{{ slot_14 }}</div>
</div>
</body>
</html>