}

footer {
    display: flex;
    justify-content: space-between;
    background: #333;
    color: white;
    padding: 20px;
}

footer section {
    flex: 1;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
