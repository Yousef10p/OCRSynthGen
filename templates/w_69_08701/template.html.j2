<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

#header {
    background-color: blue;
    color: white;
    text-align: center;
    font-size: 2em;
    padding: 1em 0;
    width: 100%;
}

#nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: lightblue;
}

#nav li {
    float: right;
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

#content {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    background-color: white;
    color: black;
    padding: 2em;
}

#content .column {
    background-color: lightblue;
    margin: 1em;
    padding: 1em;
}

#sidebar {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    background-color: lightgray;
    color: black;
    padding: 2em;
}

#sidebar .row {
    background-color: lightblue;
    margin: 1em;
    padding: 1em;
}

#footer {
    background-color: blue;
    color: white;
    text-align: center;
    font-size: 1em;
    padding: 0.5em 0;
    position: fixed;
    bottom: 0;
    width: 100%;
}

@media only screen and (max-width: 800px) {
    body {
        width: 100vw;
        overflow-x: hidden; 
    }

    #content, #sidebar {
        grid-template-columns: 1fr;
    }

    #nav ul li {
        float: none;
        width: 100%;
    }
}
.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
