}

form {
    display: flex;
    flex-direction: column;
    max-width: 400px;
    margin: 0 auto;
}

form label, form input, form button {
    margin-bottom: 10px;
}

@media screen and (max-width: 600px) {
    article {
        flex-direction: column;
    }

    .rectangle {
        margin-bottom: 10px;
        margin-left: 0;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
