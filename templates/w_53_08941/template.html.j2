<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.header {
    background-color: #34495e;
    color: white;
    text-align: center;
    padding: 20px 0;
}

.logo {
    margin: 0;
    font-size: 2em;
}

.nav {
    background-color: #2c3e50;
    margin: 0;
    overflow: hidden;
    padding: 0;
}

.nav li {
    float: right;
    list-style: none;
}

.nav li a {
    display: block;
    padding: 10px 20px;
    color: white;
    text-decoration: none;
}

.nav li a:hover {
    background-color: #34495e;
}

.dropdown:hover .dropdown-content {
    display: block;
}

.dropdown-content {
    display: none;
    position: absolute;
    background-color: #34495e;
    min-width: 160px;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
}

.dropdown-content a {
    color: black;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
    text-align: right;
}

.dropdown-content a:hover {
    background-color: #ddd;
}

.container {
    display: flex;
    justify-content: space-around;
    margin: 20px;
}

.product {
    width: calc(33.33% - 20px);
    padding: 20px;
    box-sizing: border-box;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1 class="logo">{{ slot_0 }}</h1>
</div>
<ul class="nav">
<li class="dropdown">
<a>{{ slot_1 }}</a>
<div class="dropdown-content">
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
</div>
</li>
<li class="dropdown">
<a>{{ slot_5 }}</a>
<div class="dropdown-content">
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
<a>{{ slot_8 }}</a>
</div>
</li>
<li class="dropdown">
<a>{{ slot_9 }}</a>
<div class="dropdown-content">
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
</div>
</li>
</ul>
<div class="container">
<div class="product">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<div class="product-image ph"></div>
</div>
<div class="product">
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<div class="product-image ph"></div>
</div>
<div class="product">
<h2>{{ slot_17 }}</h2>
<p>{{ slot_18 }}</p>
<div class="product-image ph"></div>
</div>
</div>
</body>
</html>