<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

body {
    background: linear-gradient(to left, #f7f7f7, #bfbfbf);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.logo {
    font-size: 2em;
    font-weight: bold;
    text-align: center;
    margin-bottom: 2em;
}

.nav-links {
    display: none;
}

.nav-links a {
    text-decoration: none;
    color: black;
}

.menu-icon {
    display: none;
}

.text-container p {
    font-size: 1.2em;
    line-height: 1.4em;
    text-align: justify;
    margin-bottom: 1.4em;
}

.image-placeholder {
    background: #999;
    height: 200px;
    width: 200px;
    margin: auto;
    border: 1px solid black;
}


nav > ul > li {
    display: inline-block;
    position: relative;
}


nav li > ul {
    display: none;
    position: absolute;
    background-color: white;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    z-index: 1;
}


nav li:hover > ul {
    display: block;
}

nav ul ul li {
    width: 200px;
    float: none;
}

nav ul ul a {
    color: initial;
    display: block;
    padding: 10px;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="logo">{{ slot_0 }}</div>
<nav>
