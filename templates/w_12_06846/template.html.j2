<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</li>
<li><a>{{ slot_6 }}</a>
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</li>
<li><a>{{ slot_10 }}</a>
<ul>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
</ul>
</li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</nav>
<div class="text-container">
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
</div>
<div class="image-placeholder ph"></div>
</body>
</html>