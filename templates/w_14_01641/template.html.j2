<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	font-family: var(--font-body);
	display: grid;
	grid-template-columns: 1fr 1fr;
}

.header {
	background: #f8f8f8;
	text-align: center;
	padding: 20px;
}

.travel-packages, .booking, .travel-guide {
	margin: 10px;
	padding: 20px;
	color: white;
}

.travel-packages {
	background: #1a535c;
}

.booking {
	background: #4ecdc4;
}

.travel-guide {
	background: #ff6b6b;
}

.package {
	padding: 5px;
	margin: 5px;
	background: #f7fff7;
	color: #1a535c;
}

form {
	display: grid;
	row-gap: 5px;
}

input, select {
	padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</div>
<div class="travel-packages">
<h2>{{ slot_2 }}</h2>
<div class="package">{{ slot_3 }}</div>
<div class="package">{{ slot_4 }}</div>
<div class="package">{{ slot_5 }}</div>
</div>
<div class="booking">
<h2>{{ slot_6 }}</h2>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_8 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
<button>{{ slot_11 }}</button>
</form>
</div>
<div class="travel-guide">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
