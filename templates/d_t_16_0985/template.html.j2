<h2 class="box" style="inset-inline-start: 108.9mm; inset-block-start: 80.2mm; inline-size: 67.2mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 108.9mm; inset-block-start: 89.2mm; inline-size: 83.3mm; block-size: 20.7mm; font-size: 11.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 108.9mm; inset-block-start: 114.1mm; inline-size: 12.1mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_6 }}</h2>
