<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 187.0mm; inset-block-start: 5.2mm; inline-size: 3.0mm; block-size: 3.3mm; font-size: 9.5pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 13.0mm; inset-block-start: 11.0mm; inline-size: 21.6mm; block-size: 17.4mm; font-size: 16.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 43.6mm; inset-block-start: 11.0mm; inline-size: 22.8mm; block-size: 5.7mm; font-size: 16.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 44.7mm; inset-block-start: 36.0mm; inline-size: 45.1mm; block-size: 19.8mm; font-size: 14.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 103.9mm; inset-block-start: 35.1mm; inline-size: 68.3mm; block-size: 23.9mm; font-size: 22.6pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 103.9mm; inset-block-start: 59.2mm; inline-size: 72.9mm; block-size: 15.0mm; font-size: 10.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 103.9mm; inset-block-start: 75.6mm; inline-size: 81.0mm; block-size: 29.5mm; font-size: 13.9pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 9.2mm; inset-block-start: 92.2mm; inline-size: 89.2mm; block-size: 88.6mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 103.9mm; inset-block-start: 126.7mm; inline-size: 36.0mm; block-size: 33.4mm; font-size: 11.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 10.0mm; inset-block-start: 283.7mm; inline-size: 38.1mm; block-size: 6.1mm; font-size: 8.6pt">{{ slot_8 }}</p>
</div></body>
</html>
