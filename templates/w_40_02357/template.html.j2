<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}
body {
    background: #f2f2f2;
}
.header {
    background: #2f2f2f;
    color: #fff;
    padding: 10px 0;
    position: relative;
}
.header .logo a {
    display: block;
    text-indent: -9999px;
    width: 100px;
    height: 50px;
    background: none no-repeat center;
}
.header nav ul {
    float: left;
    margin-top: 15px;
}
.header nav ul li {
    display: inline-block;
    margin-right: 15px;
}
.header nav ul li a {
    color: #fff;
    text-decoration: none;
}
.hero {
    height: 400px;
    background: none no-repeat center;
    background-size: cover;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
}
.hero-content h1, .hero-content p {
    text-align: center;
}
.programs, .events, .contact {
    max-width: 1170px;
    margin: 0 auto;
    padding: 50px 0;
}
.programs h2, .events h2, .contact h2 {
    text-align: center;
    margin-bottom: 50px;
}
.program, .event {
    float: right;
    width: 33.33%;
    padding: 20px;
    box-sizing: border-box;
    text-align: center;
    background: #efefef;
    margin-bottom: 20px;
}
.program:nth-child(3n), .event:nth-child(3n) {
    margin-left: 0;
}
.contact {
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
