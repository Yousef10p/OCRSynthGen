<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 102.6mm; inline-size: 152.4mm; block-size: 32.5mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 35.3mm; inset-block-start: 129.0mm; inline-size: 150.2mm; block-size: 29.7mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 65.5mm; inset-block-start: 158.2mm; inline-size: 119.9mm; block-size: 22.2mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 189.1mm; inline-size: 152.4mm; block-size: 29.6mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 226.4mm; inline-size: 117.0mm; block-size: 7.3mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 72.1mm; inset-block-start: 236.1mm; inline-size: 113.3mm; block-size: 21.5mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 107.1mm; inset-block-start: 259.4mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
