<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

header {
  background-color: teal;
  color: white;
  padding: 10px;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin-left: 10px;
}

nav ul li a {
  color: white;
  text-decoration: none;
}

.investing, .banking, .credit, .support {
  padding: 10px;
  margin-bottom: 10px;
}

.investing {
  background-color: navy;
  color: white;
}

.banking {
  background-color: darkorange;
  color: white;
}

.credit {
  background-color: darkgreen;
  color: white;
}

.support {
  background-color: darkred;
  color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<section class="investing" id="investing">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<div style="background-color: navy; width:100px; height:100px;"></div>
</section>
<section class="banking" id="banking">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div style="background-color: darkorange; width:100px; height:100px;"></div>
</section>
<section class="credit" id="credit">
<h1>{{ slot_8 }}</h1>
<p>{{ slot_9 }}</p>
<div style="background-color: darkgreen; width:100px; height:100px;"></div>
</section>
<section class="support" id="support" style="float:left; width:20%;">
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
<ul>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
<div style="background-color: darkred; width:100px; height:100px;"></div>
</section>
</body>
</html>