}

#products {
  display: flex;
  justify-content: space-around;
  padding: 50px;
}

#blog {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50px;
}

footer {
  background-color: #f2f2f2;
  text-align: center;
  padding: 20px;
  position: fixed;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
