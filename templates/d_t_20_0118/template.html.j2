<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 38.3mm; inset-block-start: 22.2mm; inline-size: 17.1mm; block-size: 21.4mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 59.3mm; inset-block-start: 22.2mm; inline-size: 109.5mm; block-size: 35.4mm; font-size: 11.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 63.2mm; inline-size: 152.1mm; block-size: 54.4mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 119.4mm; inline-size: 152.1mm; block-size: 11.3mm; font-size: 12.6pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 34.2mm; inset-block-start: 134.3mm; inline-size: 149.8mm; block-size: 32.6mm; font-size: 12.6pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 34.2mm; inset-block-start: 167.9mm; inline-size: 149.8mm; block-size: 11.3mm; font-size: 12.6pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 38.3mm; inset-block-start: 188.7mm; inline-size: 97.7mm; block-size: 10.7mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 204.6mm; inline-size: 152.1mm; block-size: 29.4mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 244.4mm; inline-size: 118.4mm; block-size: 4.6mm; font-size: 9.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 160.4mm; inset-block-start: 257.7mm; inline-size: 23.6mm; block-size: 4.6mm; font-size: 10.8pt">{{ slot_7 }}</footer>
</div></body>
</html>
