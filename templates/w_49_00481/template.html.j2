<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


nav {
    background-color: #000;
    color: #fff;
    padding: 10px 0;
}

nav ul {
    list-style-type: none;
    padding: 0;
    text-align: center;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

nav ul li a:hover {
    color: #f00;
}


.hero {
    background-color: #f00;
    color: #fff;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.hero-text h1 {
    font-size: 3em;
    margin-bottom: 10px;
}

.hero-text p {
    font-size: 1.5em;
}


.try-on, .bts, .social {
    padding: 50px 0;
    text-align: center;
}

.try-on h2, .bts h2, .social h2 {
    font-size: 2em;
    margin-bottom: 20px;
}

.try-on p, .bts p, .social p {
    font-size: 1em;
    margin-bottom: 50px;
}

.try-on-placeholder, .bts-placeholder, .social-placeholder {
    width: 200px;
    height: 200px;
    background-color: #0f0;
    margin: 0 auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div class="hero">
<div class="hero-text">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
</div>
</div>
<div class="try-on">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="try-on-placeholder">{{ slot_9 }}</div>
</div>
<div class="bts">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<div class="bts-placeholder">{{ slot_12 }}</div>
</div>
<div class="social">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<div class="social-placeholder">{{ slot_15 }}</div>
</div>
</body>
</html>