</ul>
<h3>{{ slot_6 }}</h3>
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</div>
<div class="main">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
<div class="post">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</div>
</div>
<div class="footer">
<ul>
