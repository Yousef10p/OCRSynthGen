<p>{{ slot_7 }}</p>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
</div>
<div class="right-column">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
