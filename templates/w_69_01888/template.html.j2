}

.slide-image {
	width: 100%;
	height: 100%;
	background-color: #999;
}

.slide p {
	position: absolute;
	bottom: 20px;
	left: 20px;
	background-color: rgba(255,255,255,0.7);
	padding: 10px;
}

footer {
	background-color: #333;
	color: #fff;
	text-align: center;
	padding: 10px;
	position: absolute;
	bottom: 0;
	width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
