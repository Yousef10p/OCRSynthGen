<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 75.6mm; inset-block-start: 18.9mm; inline-size: 66.0mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 79.5mm; inset-block-start: 27.3mm; inline-size: 58.3mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 52.1mm; inset-block-start: 31.6mm; inline-size: 113.2mm; block-size: 3.2mm; font-size: 9.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 38.6mm; inline-size: 140.6mm; block-size: 36.4mm; font-size: 9.0pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 61.3mm; inline-size: 6.4mm; block-size: 141.9mm; font-size: 20.0pt">{{ slot_4 }}</header><h2 class="box" style="inset-inline-start: 43.6mm; inset-block-start: 83.0mm; inline-size: 37.3mm; block-size: 2.8mm; font-size: 9.0pt">{{ slot_5 }}</h2>
<div class="box ph" style="inset-inline-start: 111.4mm; inset-block-start: 82.1mm; inline-size: 87.2mm; block-size: 103.7mm; font-size: 5.0pt"></div>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 91.9mm; inline-size: 86.5mm; block-size: 68.2mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 160.9mm; inline-size: 86.5mm; block-size: 56.1mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 190.2mm; inline-size: 86.5mm; block-size: 25.3mm; font-size: 9.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 217.8mm; inline-size: 86.5mm; block-size: 15.7mm; font-size: 10.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 111.8mm; inset-block-start: 224.1mm; inline-size: 86.5mm; block-size: 31.8mm; font-size: 10.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 246.3mm; inline-size: 86.5mm; block-size: 5.9mm; font-size: 8.0pt">{{ slot_11 }}</p>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 253.1mm; inline-size: 54.9mm; block-size: 2.5mm; font-size: 6.0pt">{{ slot_12 }}</p>
</div></body>
</html>
