<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	font-family: var(--font-body);
	background-color: #f4f4f4;
}

section {
	display: flex;
}

.center {
	margin: 40px;
	text-align: center;
}

.search-input {
	width: 50%;
	font-size: 20px;
	padding: 10px;
	border: none;
	border-radius: 5px;
	margin-top: 20px;
	text-align: center;
}

.left {
	background-color: #f4f4f4;
	padding: 40px;
	width: 20%;
}

.left li, .left h3 {
	margin-top: 30px;
}

a {
	color: #000;
	text-decoration: none;
}

.slider {
	background-color: lightgray;
	width: 80%;
	padding: 30px 0;
	text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<section class="center">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<span class="search-input" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_2 }}</span>
</section>
<section class="secondary">
<div class="left">
<h3>{{ slot_3 }}</h3>
<ul>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
<h3>{{ slot_7 }}</h3>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
<h3>{{ slot_11 }}</h3>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</div>
<div class="slider">

</div>
</section>
</body>
</html>