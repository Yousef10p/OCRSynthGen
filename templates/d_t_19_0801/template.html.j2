<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 18.3mm; inset-block-start: 10.8mm; inline-size: 89.3mm; block-size: 13.6mm; font-size: 19.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 28.2mm; inline-size: 110.9mm; block-size: 11.9mm; font-size: 11.2pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 18.7mm; inset-block-start: 43.5mm; inline-size: 26.2mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 18.7mm; inset-block-start: 49.7mm; inline-size: 105.2mm; block-size: 9.8mm; font-size: 13.9pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 58.9mm; inset-block-start: 62.4mm; inline-size: 24.7mm; block-size: 23.5mm; font-size: 16.7pt"></div>
<p class="box" style="inset-inline-start: 18.3mm; inset-block-start: 87.5mm; inline-size: 109.6mm; block-size: 9.8mm; font-size: 13.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 41.0mm; inset-block-start: 102.9mm; inline-size: 60.9mm; block-size: 19.3mm; font-size: 13.6pt"></div>
<p class="box" style="inset-inline-start: 18.3mm; inset-block-start: 129.4mm; inline-size: 109.5mm; block-size: 14.0mm; font-size: 13.2pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 41.1mm; inset-block-start: 148.2mm; inline-size: 60.4mm; block-size: 23.0mm; font-size: 16.3pt"></div>
<footer class="box" style="inset-inline-start: 15.0mm; inset-block-start: 198.0mm; inline-size: 3.1mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
