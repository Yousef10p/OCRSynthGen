<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 16.5mm; inset-block-start: 15.7mm; inline-size: 45.2mm; block-size: 8.1mm; font-size: 9.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 16.1mm; inset-block-start: 26.7mm; inline-size: 87.9mm; block-size: 24.8mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 26.6mm; inline-size: 88.4mm; block-size: 39.8mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.1mm; inset-block-start: 51.5mm; inline-size: 89.6mm; block-size: 129.4mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 66.6mm; inline-size: 88.3mm; block-size: 84.4mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.6mm; inset-block-start: 151.3mm; inline-size: 88.8mm; block-size: 44.6mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.5mm; inset-block-start: 181.3mm; inline-size: 88.3mm; block-size: 67.4mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 110.6mm; inset-block-start: 196.2mm; inline-size: 88.7mm; block-size: 63.2mm; font-size: 11.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 16.7mm; inset-block-start: 249.4mm; inline-size: 87.5mm; block-size: 9.9mm; font-size: 11.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 104.3mm; inset-block-start: 261.7mm; inline-size: 8.1mm; block-size: 4.7mm; font-size: 11.9pt">{{ slot_9 }}</footer>
</div></body>
</html>
