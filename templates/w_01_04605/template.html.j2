}

nav ul li a {
    text-decoration: none;
    color: #FFFFFF;
}

.fashion-item {
    width: 100px;
    height: 100px;
    margin: 20px;
    background-color: #FF0000; 
}

#about, #contact {
    margin: 50px;
}

footer {
    background-color: #000000;
    color: #FFFFFF;
    text-align: center;
    padding: 20px 0;
    position: absolute;
    bottom: 0;
    width: 100%;
}

footer img {
    width: 50px;
    height: 50px;
}

.social-links a {
    margin: 0 10px;
    text-decoration: none;
    color: #FFFFFF;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
