<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


#banner {
    background: blue;
    color: white;
    text-align: center;
    font-size: 2em;
    padding: 50px 0;
}


#reservations {
    background: green;
    color: white;
    text-align: center;
    font-size: 1.5em;
    padding: 30px 0;
}

#reservations form {
    margin: 20px 0;
}

#reservations form input {
    margin: 10px 0;
}


#contact {
    background: green;
    color: white;
    text-align: center;
    font-size: 1.5em;
    padding: 30px 0;
}

#contact form {
    margin: 20px 0;
}

#contact form input, #contact form textarea {
    margin: 10px 0;
}


#links {
    background: blue;
    color: white;
    font-size: 1.2em;
    padding: 20px 0;
}

#links ul {
    list-style: none;
}

#links ul li {
    margin: 10px 0;
}

#links ul a {
    color: white;
    text-decoration: none;
}


#footer {
    background: blue;
    color: white;
    font-size: 1em;
    padding: 10px 0;
    position: fixed;
    bottom: 0;
    width: 100%;
}

#footer ul {
    list-style: none;
    text-align: center;
}

#footer ul li {
    display: inline;
    margin: 0 10px;
}

#footer ul a {
    color: white;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="banner">{{ slot_0 }}</div>
<div id="reservations">
<p>{{ slot_1 }}</p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_2 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
<span class="">{{ slot_6 }}</span>
</form>
</div>
<div id="contact">
<p>{{ slot_7 }}</p>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_8 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_10 }}</span>
<span class="">{{ slot_11 }}</span>
</form>
</div>
<div id="links">
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
</ul>
</div>
<div id="footer">
<ul>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</div>
</body>
</html>