<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 106.7mm; inline-size: 165.1mm; block-size: 37.7mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 148.9mm; inline-size: 165.1mm; block-size: 29.3mm; font-size: 12.0pt">{{ slot_4 }}</p>
