<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #333;
    background-color: #f2f2f2;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
}

nav ul {
    list-style-type: none;
    display: flex;
}

nav li {
    margin: 0 10px;
}

nav a {
    text-decoration: none;
    color: #333;
}

address {
    margin-left: 20px;
    text-align: left;
    font-style: normal;
}

main {
    max-width: 1000px;
    margin: 20px auto;
}

.column {
    width: 48%;
    display: inline-block;
    vertical-align: top;
}

.column:first-child {
    margin-left: 4%;
}

h2 {
    color: #444;
}

p {
    line-height: 1.5;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<address>
<p>{{ slot_5 }}</p>
<p>{{ slot_6 }}</p>
<p>{{ slot_7 }}</p>
<p>{{ slot_8 }}</p>
</address>
</header>
<main>
<div class="column">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
</div>
<div class="column">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
</div>
</main>
</body>
</html>