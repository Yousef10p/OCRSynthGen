<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 88.9mm; inset-block-start: 12.8mm; inline-size: 37.1mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 176.2mm; inset-block-start: 12.8mm; inline-size: 13.7mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 103.0mm; inset-block-start: 23.0mm; inline-size: 10.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 58.4mm; inset-block-start: 31.9mm; inline-size: 99.6mm; block-size: 8.0mm; font-size: 11.4pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 48.2mm; inline-size: 163.8mm; block-size: 8.0mm; font-size: 11.3pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 58.9mm; inset-block-start: 64.1mm; inline-size: 95.0mm; block-size: 89.2mm; font-size: 40.0pt"></div>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 165.1mm; inline-size: 162.2mm; block-size: 8.0mm; font-size: 11.4pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 59.8mm; inset-block-start: 181.3mm; inline-size: 96.0mm; block-size: 70.5mm; font-size: 40.0pt"></div>
<footer class="box" style="inset-inline-start: 95.9mm; inset-block-start: 262.7mm; inline-size: 18.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 173.2mm; inset-block-start: 262.7mm; inline-size: 17.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
