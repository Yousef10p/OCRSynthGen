<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  background: black;
  font-family: var(--font-body);
  color: white;
}

#slider {
  display: flex;
  height: 200px;
  margin-bottom: 20px;
}
.slide {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

form {
  display: grid;
  grid-template-columns: auto auto;
  gap: 10px 20px;
}

#reservation, #menu {
  margin: 20px 0;
}

article {
  margin-bottom: 20px;
}

h2, p {
  margin: 0;
}

.dish {
  margin: 5px 0;
  height: 100px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<section id="slider">
<div class="slide" style="background:red">{{ slot_0 }}</div>
<div class="slide" style="background:orange">{{ slot_1 }}</div>
<div class="slide" style="background:yellow">{{ slot_2 }}</div>
<div class="slide" style="background:green">{{ slot_3 }}</div>
</section>
<section id="reservation">
<form>
<label>{{ slot_4 }} <span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span></label><br>
<label>{{ slot_6 }} <span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span></label><br>
<label>{{ slot_8 }} <span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_9 }}</span></label><br>
<button>{{ slot_10 }}</button>
</form>
</section>
<section id="menu">
<article>
<h2>{{ slot_11 }}</h2>
<div class="dish" style="background:lime"></div>
<p>{{ slot_12 }}</p>
</article>
<article>
<h2>{{ slot_13 }}</h2>
<div class="dish" style="background:teal"></div>
<p>{{ slot_14 }}</p>
</article>

</section>
</body>
</html>