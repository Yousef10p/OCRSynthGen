<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 102.4mm; inset-block-start: 13.2mm; inline-size: 17.5mm; block-size: 3.3mm; font-size: 10.0pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 26.0mm; inline-size: 53.9mm; block-size: 3.9mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 34.2mm; inline-size: 166.1mm; block-size: 11.7mm; font-size: 10.0pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 36.0mm; inset-block-start: 50.1mm; inline-size: 118.4mm; block-size: 3.3mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 36.0mm; inset-block-start: 57.6mm; inline-size: 105.3mm; block-size: 3.3mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 65.1mm; inline-size: 45.9mm; block-size: 3.3mm; font-size: 10.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 37.8mm; inset-block-start: 69.6mm; inline-size: 159.1mm; block-size: 167.6mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 36.0mm; inset-block-start: 246.0mm; inline-size: 166.9mm; block-size: 7.5mm; font-size: 10.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 195.4mm; inset-block-start: 263.0mm; inline-size: 7.8mm; block-size: 3.3mm; font-size: 10.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
