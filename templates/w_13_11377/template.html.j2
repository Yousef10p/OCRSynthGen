<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="hero">
<h1>{{ slot_4 }}</h1>
<h2>{{ slot_5 }}</h2>
<div class="image">{{ slot_6 }}</div>
</div>
<div class="content">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</div>
<div class="footer">
<div class="logo">{{ slot_15 }}</div>
<div class="social-icons">
<a><i class="fa fa-facebook"></i></a>
<a><i class="fa fa-twitter"></i></a>
<a><i class="fa fa-linkedin"></i></a>
</div>
</div>
</body>
</html>