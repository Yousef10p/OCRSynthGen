<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 21.1mm; inline-size: 133.3mm; block-size: 45.0mm; font-size: 12.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 71.5mm; inline-size: 133.3mm; block-size: 13.7mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 90.6mm; inline-size: 134.3mm; block-size: 22.7mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 63.0mm; inset-block-start: 122.3mm; inline-size: 21.9mm; block-size: 4.8mm; font-size: 6.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 52.9mm; inset-block-start: 126.7mm; inline-size: 43.2mm; block-size: 4.9mm; font-size: 6.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.2mm; inset-block-start: 157.4mm; inline-size: 94.7mm; block-size: 4.9mm; font-size: 13.8pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 126.4mm; inset-block-start: 205.6mm; inline-size: 16.6mm; block-size: 3.8mm; font-size: 10.7pt"></div>
</div></body>
</html>
