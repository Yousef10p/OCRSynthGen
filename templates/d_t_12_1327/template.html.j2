<p class="box" style="inset-inline-start: 17.7mm; inset-block-start: 142.1mm; inline-size: 83.3mm; block-size: 11.9mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 17.7mm; inset-block-start: 162.3mm; inline-size: 83.3mm; block-size: 41.5mm; font-size: 10.0pt">{{ slot_5 }}</p>
