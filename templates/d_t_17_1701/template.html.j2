<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 85.1mm; inset-block-start: 26.3mm; inline-size: 41.0mm; block-size: 3.4mm; font-size: 10.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 75.0mm; inset-block-start: 32.6mm; inline-size: 61.1mm; block-size: 3.3mm; font-size: 10.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 39.6mm; inline-size: 147.6mm; block-size: 7.6mm; font-size: 10.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 51.0mm; inline-size: 147.6mm; block-size: 20.4mm; font-size: 10.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 75.1mm; inline-size: 147.6mm; block-size: 7.6mm; font-size: 10.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 91.8mm; inline-size: 29.1mm; block-size: 2.6mm; font-size: 8.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 97.0mm; inline-size: 147.3mm; block-size: 6.5mm; font-size: 8.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 158.6mm; inset-block-start: 250.0mm; inline-size: 38.1mm; block-size: 33.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 31.5mm; inset-block-start: 252.5mm; inline-size: 8.8mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 31.5mm; inset-block-start: 264.8mm; inline-size: 37.0mm; block-size: 2.2mm; font-size: 7.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 31.5mm; inset-block-start: 276.2mm; inline-size: 47.6mm; block-size: 2.2mm; font-size: 7.0pt">{{ slot_9 }}</p>
</div></body>
</html>
