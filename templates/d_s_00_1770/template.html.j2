<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 26.3mm; inline-size: 5.9mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 25.9mm; inset-block-start: 35.5mm; inline-size: 163.1mm; block-size: 28.7mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 71.1mm; inline-size: 159.2mm; block-size: 10.5mm; font-size: 10.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 50.9mm; inset-block-start: 88.3mm; inline-size: 133.9mm; block-size: 31.0mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 124.9mm; inline-size: 159.2mm; block-size: 21.6mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 25.5mm; inset-block-start: 156.3mm; inline-size: 165.8mm; block-size: 42.7mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 198.8mm; inline-size: 74.3mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 62.4mm; inset-block-start: 206.0mm; inline-size: 122.3mm; block-size: 21.5mm; font-size: 10.0pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 229.3mm; inline-size: 159.2mm; block-size: 17.6mm; font-size: 10.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 103.3mm; inset-block-start: 279.5mm; inline-size: 3.5mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
