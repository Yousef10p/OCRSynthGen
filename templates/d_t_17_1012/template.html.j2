<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 88.9mm; inset-block-start: 12.8mm; inline-size: 38.1mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 178.1mm; inset-block-start: 12.8mm; inline-size: 13.3mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_1 }}</header><ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 22.3mm; inline-size: 163.8mm; block-size: 8.0mm; font-size: 11.4pt"><li>{{ slot_2 }}</li></ul>
<div class="box ph" style="inset-inline-start: 43.4mm; inset-block-start: 38.9mm; inline-size: 156.5mm; block-size: 90.1mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 103.0mm; inset-block-start: 140.8mm; inline-size: 10.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 149.1mm; inline-size: 62.0mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 161.2mm; inline-size: 161.6mm; block-size: 8.0mm; font-size: 11.3pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 29.6mm; inset-block-start: 176.2mm; inline-size: 122.7mm; block-size: 77.5mm; font-size: 36.6pt"></div>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 262.7mm; inline-size: 16.8mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_6 }}</footer><footer class="box" style="inset-inline-start: 99.8mm; inset-block-start: 262.7mm; inline-size: 16.9mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
