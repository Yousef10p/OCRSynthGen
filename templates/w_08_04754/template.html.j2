    color: white;
    padding: 10px;
    text-align: center;
}
#navigation ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #333;
}
#navigation li {
    float: right;
}
#navigation li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}
#content .game {
    background-color: #bbb;
    width: 300px;
    height: 200px;
    margin: 0 auto;
    line-height: 200px;
    text-align: center;
    margin-bottom: 20px;
}
#footer {
    background-color: #333;
    color: white;
    padding: 10px;
    text-align: center;
    margin-top: 20px;
}
#footer-links a, #footer-hardware a {
    color: white;
    text-decoration: none;
    margin: 0 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
