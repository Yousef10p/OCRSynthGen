<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

#header {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
}

#header video {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
}

#navigation {
    position: absolute;
    top: 20px;
    left: 20px;
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        li {
            a {
                color: white;
                text-decoration: none;
                margin: 0 10px;
            }
        }
    }
}

#value-proposition {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    text-align: center;
    color: white;
    button {
        background-color: white;
        color: black;
        padding: 20px 40px;
        border: none;
        cursor: pointer;
    }
}

#services, #about-us, #contact {
    padding: 50px 20px;
    h2 {
        text-align: center;
    }
    .service-rectangle {
        background-color: lightgray;
        height: 200px;
        margin: auto;
    }
}

#contact {
    form {
        display: flex;
        flex-direction: column;
        align-items: center;
        input, textarea {
            margin-bottom: 20px;
            padding: 10px;
            width: 50%;
            border: none;
            background-color: lightgray;
        }
        button {
            background-color: black;
            color: white;
            padding: 20px 40px;
            border: none;
            cursor: pointer;
        }
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
