<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 8.5mm; inset-block-start: 7.6mm; inline-size: 133.3mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 8.2mm; inset-block-start: 13.9mm; inline-size: 43.1mm; block-size: 251.7mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 55.6mm; inset-block-start: 22.2mm; inline-size: 132.1mm; block-size: 26.1mm; font-size: 14.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 55.6mm; inset-block-start: 48.7mm; inline-size: 108.2mm; block-size: 15.5mm; font-size: 14.6pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 170.0mm; inset-block-start: 50.6mm; inline-size: 39.8mm; block-size: 246.1mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 55.6mm; inset-block-start: 80.4mm; inline-size: 72.0mm; block-size: 47.3mm; font-size: 14.9pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 55.6mm; inset-block-start: 129.5mm; inline-size: 23.1mm; block-size: 4.2mm; font-size: 11.9pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 55.6mm; inset-block-start: 134.0mm; inline-size: 60.2mm; block-size: 12.9mm; font-size: 12.2pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 55.5mm; inset-block-start: 170.6mm; inline-size: 90.3mm; block-size: 67.4mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 35.7mm; inset-block-start: 268.6mm; inline-size: 6.1mm; block-size: 22.3mm; font-size: 40.0pt"></div>
</div></body>
</html>
