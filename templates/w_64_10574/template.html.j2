<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
}

nav {
  position: fixed;
  top: 0;
  width: 100%;
  background-color: #333;
  color: #fff;
  height: 50px;
  line-height: 50px;
  text-align: center;
}

nav ul {
  list-style: none;
  padding: 0;
}

nav li {
  display: inline-block;
  margin-left: 20px;
}

nav a {
  color: #fff;
  text-decoration: none;
}

#logo {
  width: 200px;
  height: 200px;
  background-color: #f00;
  margin: 0 auto;
}

h1, h2 {
  text-align: center;
}

p, .promotion {
  margin: 1em auto;
}

#promotions, #classes {
  display: flex;
  justify-content: space-around;
}

.promotion, .class {
  width: 45%;
  padding: 1em;
  text-align: center;
  border: 1px solid #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div class="ph"></div>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<div id="promotions">
<div class="promotion">{{ slot_8 }}</div>
<div class="promotion">{{ slot_9 }}</div>
</div>
<h2>{{ slot_10 }}</h2>
<div id="classes">
<div class="class">{{ slot_11 }}</div>
<div class="class">{{ slot_12 }}</div>
<div class="class">{{ slot_13 }}</div>
<div class="class">{{ slot_14 }}</div>
<div class="class">{{ slot_15 }}</div>
</div>
</body>
</html>