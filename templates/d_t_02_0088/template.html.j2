<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 0.4mm; inline-size: 177.5mm; block-size: 51.3mm; font-size: 14.5pt"></div>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 51.9mm; inline-size: 51.6mm; block-size: 51.1mm; font-size: 14.5pt"></div>
<h2 class="box" style="inset-inline-start: 62.8mm; inset-block-start: 67.1mm; inline-size: 70.1mm; block-size: 10.0mm; font-size: 28.4pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 63.6mm; inset-block-start: 90.0mm; inline-size: 20.9mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 63.6mm; inset-block-start: 97.9mm; inline-size: 121.0mm; block-size: 57.6mm; font-size: 18.1pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 63.6mm; inset-block-start: 163.2mm; inline-size: 24.2mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 63.6mm; inset-block-start: 171.1mm; inline-size: 121.8mm; block-size: 57.6mm; font-size: 18.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 0.2mm; inset-block-start: 245.2mm; inline-size: 92.4mm; block-size: 51.1mm; font-size: 14.5pt"></div>
<div class="box ph" style="inset-inline-start: 142.8mm; inset-block-start: 245.4mm; inline-size: 60.1mm; block-size: 51.0mm; font-size: 14.5pt"></div>
</div></body>
</html>
