<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}
.header {
  background-color: #f8f8f8;
  text-align: center;
  padding: 20px;
}
.grid-container {
  display: grid;
  grid-template-columns: auto auto auto;
  padding: 10px;
}
.grid-item {
  background-color: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(0, 0, 0, 0.8);
  padding: 20px;
  font-size: 30px;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
</div>
<div class="grid-container">
<div class="grid-item">
<div class="image">{{ slot_1 }}</div>
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
</div>
<div class="grid-item">
<div class="image">{{ slot_4 }}</div>
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</div>
<div class="grid-item">
<div class="image">{{ slot_7 }}</div>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="grid-item">
<div class="image">{{ slot_10 }}</div>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</div>
<div class="grid-item">
<div class="image">{{ slot_13 }}</div>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</div>
</div>
</body>
</html>