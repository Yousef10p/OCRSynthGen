<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 50.4mm; inset-block-start: 32.0mm; inline-size: 79.7mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_0 }}</p>
<ul class="box" style="inset-inline-start: 42.8mm; inset-block-start: 39.3mm; inline-size: 153.6mm; block-size: 31.3mm; font-size: 22.1pt"><li>{{ slot_1 }}</li></ul>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 77.0mm; inline-size: 158.6mm; block-size: 40.7mm; font-size: 22.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 118.7mm; inline-size: 87.8mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 129.7mm; inline-size: 162.3mm; block-size: 82.2mm; font-size: 22.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 212.9mm; inline-size: 38.7mm; block-size: 5.9mm; font-size: 22.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 223.9mm; inline-size: 158.7mm; block-size: 20.0mm; font-size: 22.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 33.4mm; inset-block-start: 249.1mm; inline-size: 163.5mm; block-size: 13.1mm; font-size: 22.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 130.5mm; inset-block-start: 269.8mm; inline-size: 60.7mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
