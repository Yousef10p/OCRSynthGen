<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.0mm; inline-size: 215.9mm; block-size: 142.3mm; font-size: 14.9pt"></div>
<div class="box ph" style="inset-inline-start: 132.5mm; inset-block-start: 147.6mm; inline-size: 61.2mm; block-size: 39.3mm; font-size: 15.9pt"></div>
<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 151.7mm; inline-size: 65.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 157.8mm; inline-size: 107.6mm; block-size: 25.4mm; font-size: 14.4pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 10.2mm; inset-block-start: 198.4mm; inline-size: 43.8mm; block-size: 38.3mm; font-size: 15.5pt"></div>
<h2 class="box" style="inset-inline-start: 63.5mm; inset-block-start: 205.3mm; inline-size: 39.0mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 63.5mm; inset-block-start: 211.5mm; inline-size: 130.9mm; block-size: 19.8mm; font-size: 14.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 16.9mm; inset-block-start: 246.8mm; inline-size: 182.4mm; block-size: 15.0mm; font-size: 14.2pt"></div>
<footer class="box" style="inset-inline-start: 171.3mm; inset-block-start: 271.1mm; inline-size: 27.7mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_4 }}</footer>
</div></body>
</html>
