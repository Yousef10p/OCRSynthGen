<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 355.6mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 15.0mm; inset-block-start: 19.9mm; inline-size: 30.0mm; block-size: 5.1mm; font-size: 14.5pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 22.2mm; inset-block-start: 26.3mm; inline-size: 15.9mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 97.7mm; inset-block-start: 26.7mm; inline-size: 27.2mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 37.4mm; inline-size: 174.7mm; block-size: 31.7mm; font-size: 18.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 23.3mm; inset-block-start: 70.2mm; inline-size: 175.4mm; block-size: 90.9mm; font-size: 18.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 162.5mm; inline-size: 174.0mm; block-size: 90.9mm; font-size: 18.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 24.3mm; inset-block-start: 254.5mm; inline-size: 175.7mm; block-size: 51.4mm; font-size: 18.2pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 107.9mm; inset-block-start: 319.1mm; inline-size: 7.8mm; block-size: 5.1mm; font-size: 14.5pt">{{ slot_7 }}</footer>
</div></body>
</html>
