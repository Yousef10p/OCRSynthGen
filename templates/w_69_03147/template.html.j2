}

nav ul {
    list-style-type: none;
}

nav ul li {
    display: inline;
    margin-left: 10px;
}

nav ul li a {
    text-decoration: none;
    color: black;
}

nav ul li a:hover {
    color: yellow;
}

footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    background-color: white;
    color: black;
}

section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

form {
    display: flex;
    flex-direction: column;
    width: 300px;
    margin: 20px auto;
}

input[type="submit"] {
    background-color: yellow;
}

input[type="text"],
input[type="email"] {
    border: 1px solid black;
    padding: 5px;
    margin-bottom: 10px;
}

@media (max-width: 768px) {
    section {
        padding: 10px;
    }
}

@media (max-width: 425px) {
    main {
        flex-direction: column;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
