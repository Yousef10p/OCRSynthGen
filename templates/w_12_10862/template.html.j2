<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  color: white;
  background-color: black;
  font-family: var(--font-body);
}
a {
  color: lightblue;
}


#top-section {
  position: relative;
  height: 500px;
}
.latest-tech-gadget {
  background-color: lightgreen;
  height: 90%;
  margin: 10px;
}
nav ul {
  list-style-type: none;
  display: flex;
  justify-content: space-evenly;
}
nav ul li a {
  color: white;
  text-decoration: none;
}


.section {
  margin: 20px;
  padding: 20px;
  border: 1px solid white;
}
.section h2 {
  color: lightgreen;
}
.article, .review, .product-info {
  background-color: lightblue;
  margin: 10px 0;
  height: 50px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="section" id="top-section">
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<div class="latest-tech-gadget">{{ slot_3 }}</div>
</div>
<div class="section" id="articles">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<div class="article">{{ slot_6 }}</div>
<div class="article">{{ slot_7 }}</div>
</div>
<div class="section" id="reviews">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="review">{{ slot_10 }}</div>
<div class="review">{{ slot_11 }}</div>
</div>
<div class="section" id="product-info">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="product-info">{{ slot_14 }}</div>
<div class="product-info">{{ slot_15 }}</div>
</div>
</body>
</html>