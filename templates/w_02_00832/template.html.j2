<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div id="about">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
</div>
<div id="properties">
<h2>{{ slot_6 }}</h2>
<div class="property" style="background-color: yellow;">{{ slot_7 }}</div>
<div class="property" style="background-color: green;">{{ slot_8 }}</div>
</div>
<div id="contact">
