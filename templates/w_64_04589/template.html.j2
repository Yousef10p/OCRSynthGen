  padding: 10px;
  background-color: #f8f8f8;
}

nav ul {
  list-style-type: none;
}

nav ul li {
  display: inline;
  margin-left: 10px;
}

nav ul li a {
  text-decoration: none;
  color: black;
}

main {
  margin-top: 20px;
}

#programs, #products {
  display: block;
  margin: 20px 10px;
  background-color: #f0f0f0;
  padding: 10px;
}

footer {
  margin-top: 50px;
  padding: 10px;
  background-color: #f0f0f0;
}

.social-link, .other-link {
  display: inline-block;
  margin-left: 10px;
  margin-bottom: 10px;
  padding: 5px;
  background-color: #f0f0f0;
}

.placeholder-rectangle {
  height: 200px;
  width: 200px;
  background-color: #f0f0f0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
