float: right;
width: 25%;
padding: 10px;
background-color: #a4d6a3;
}

main {
float: left;
width: 75%;
padding: 10px;
}

input[type="text"] {
padding: 5px;
}

nav ul {
list-style-type: none;
padding: 0;
}

nav ul li {
display: inline;
margin-left: 10px;
}

button {
background-color: #5dc159;
color: white;
border: none;
padding: 10px;
