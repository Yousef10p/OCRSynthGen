<h2 class="box" style="inset-inline-start: 63.6mm; inset-block-start: 121.8mm; inline-size: 22.8mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 63.6mm; inset-block-start: 125.9mm; inline-size: 121.1mm; block-size: 34.2mm; font-size: 13.8pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 153.1mm; inline-size: 51.3mm; block-size: 51.3mm; font-size: 14.5pt"></div>
<h2 class="box" style="inset-inline-start: 63.6mm; inset-block-start: 164.6mm; inline-size: 12.8mm; block-size: 3.7mm; font-size: 10.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 63.6mm; inset-block-start: 168.7mm; inline-size: 121.0mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 63.6mm; inset-block-start: 174.5mm; inline-size: 121.0mm; block-size: 13.5mm; font-size: 12.8pt">{{ slot_6 }}</p>
