  color: black;
  border: none;
  padding: 15px 32px;
  text-align: center;
  display: inline-block;
  font-size: 16px;
  margin: 4px 2px;
  cursor: pointer;
}

header, main, footer {
  padding: 20px;
  box-sizing: border-box;
}

.sidebar, .main-content, .contact {
