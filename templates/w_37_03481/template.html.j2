<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

header {
  position: relative;
  width: 100%;
  height: 100px;
  background-color: lightblue;
  padding: 10px;
  box-sizing: border-box;
}

.hero-image {
  position: relative;
  width: 100%;
  height: 200px;
  background-color: lightgray;
  padding: 20px;
  box-sizing: border-box;
}

.hero-image form input {
  width: 100%;
  height: 50px;
  position: absolute;
  top: 50%;
  right: 50%;
  transform: translate(50%, -50%);
}

.content {
  margin: 20px;
}

footer {
  position: relative;
  width: 100%;
  height: 200px;
  background-color: lightyellow;
  padding: 10px;
  box-sizing: border-box;
}

a {
  text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
</nav>
</header>
<div class="hero-image ph"></div>
<div class="content">
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<h2>{{ slot_4 }}</h2>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</div>
<footer>
<h3>{{ slot_8 }}</h3>
<p><a>{{ slot_9 }}</a> {{ slot_10 }} <a>{{ slot_11 }}</a> {{ slot_12 }} <a>{{ slot_13 }}</a></p>
<h3>{{ slot_14 }}</h3>
<p>{{ slot_15 }}</p>
<p>{{ slot_16 }}</p>
<h3>{{ slot_17 }}</h3>
<p>{{ slot_18 }}</p>
</footer>
</body>
</html>