<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.8mm; inset-block-start: 16.2mm; inline-size: 85.1mm; block-size: 77.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 15.5mm; inline-size: 86.7mm; block-size: 103.4mm; font-size: 12.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 14.2mm; inset-block-start: 97.3mm; inline-size: 85.9mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 108.6mm; inline-size: 87.2mm; block-size: 62.8mm; font-size: 12.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 123.8mm; inline-size: 86.5mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 139.0mm; inline-size: 83.9mm; block-size: 13.2mm; font-size: 12.4pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 106.9mm; inset-block-start: 154.1mm; inline-size: 83.3mm; block-size: 13.2mm; font-size: 12.4pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 13.9mm; inset-block-start: 175.6mm; inline-size: 175.1mm; block-size: 75.4mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 14.0mm; inset-block-start: 253.5mm; inline-size: 106.1mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 9.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_7 }}</footer>
</div></body>
</html>
