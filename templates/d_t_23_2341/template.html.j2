<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 91.8mm; inset-block-start: 19.9mm; inline-size: 30.3mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 62.2mm; inset-block-start: 25.2mm; inline-size: 7.3mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 144.6mm; inset-block-start: 25.4mm; inline-size: 7.1mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 99.9mm; inset-block-start: 30.5mm; inline-size: 14.3mm; block-size: 2.7mm; font-size: 7.7pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 33.6mm; inset-block-start: 34.6mm; inline-size: 153.1mm; block-size: 38.4mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 33.6mm; inset-block-start: 74.9mm; inline-size: 153.1mm; block-size: 32.2mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 33.6mm; inset-block-start: 109.3mm; inline-size: 153.1mm; block-size: 32.2mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 33.7mm; inset-block-start: 143.5mm; inline-size: 153.1mm; block-size: 32.2mm; font-size: 40.0pt"></div>
