}
nav ul {
  list-style-type: none;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}
nav ul li {
  position: relative;
  display: inline-block;
}
nav ul li:hover ul {
  display: block;
}
nav ul ul {
  display: none;
  position: absolute;
  background-color: lightgray;
  padding: 10px;
  width: 100px;
}
section {
  margin: 20px;
}
.image {
  height: 200px;
  margin: 10px 0;
  background-color: lightgrey;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
