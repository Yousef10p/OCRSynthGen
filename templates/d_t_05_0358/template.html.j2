<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.0mm; inset-block-start: 6.4mm; inline-size: 48.6mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 89.4mm; inset-block-start: 6.4mm; inline-size: 31.9mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 170.2mm; inset-block-start: 6.4mm; inline-size: 20.5mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_2 }}</header><h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 10.4mm; inline-size: 27.6mm; block-size: 13.6mm; font-size: 19.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 55.0mm; inline-size: 55.2mm; block-size: 3.5mm; font-size: 10.1pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 10.0mm; inset-block-start: 283.0mm; inline-size: 11.0mm; block-size: 6.6mm; font-size: 18.7pt">{{ slot_5 }}</footer>
</div></body>
</html>
