<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.0mm; inset-block-start: 88.3mm; inline-size: 63.0mm; block-size: 7.3mm; font-size: 20.6pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 14.0mm; inset-block-start: 126.2mm; inline-size: 137.6mm; block-size: 11.7mm; font-size: 33.1pt">{{ slot_1 }}</h2>
<header class="box" style="inset-inline-start: 200.1mm; inset-block-start: 131.9mm; inline-size: 2.7mm; block-size: 32.0mm; font-size: 40.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 143.6mm; inline-size: 137.4mm; block-size: 52.0mm; font-size: 16.4pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 23.8mm; inset-block-start: 204.3mm; inline-size: 35.0mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 209.5mm; inline-size: 137.3mm; block-size: 40.0mm; font-size: 16.2pt">{{ slot_5 }}</p>
</div></body>
</html>
