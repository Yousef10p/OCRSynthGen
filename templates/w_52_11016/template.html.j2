}
nav ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
}
nav ul li {
  display: inline-block;
}
nav ul li a {
  display: block;
  padding: 10px;
  color: #333;
  text-decoration: none;
}
nav ul ul {
  display: none;
  position: absolute;
  background-color: #f0f0f0;
  padding: 10px;
}
nav ul li:hover > ul {
  display: block;
}
section {
  padding: 80px 20px;
}
.hero {
  background-color: #333;
  color: #fff;
  text-align: center;
  padding: 50px 0;
}
.services, .products {
  display: flex;
  justify-content: space-between;
}
.services div, .products div {
  width: 30%;
  height: 200px;
  background-color: #f0f0f0;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
