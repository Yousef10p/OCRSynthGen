<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 113.1mm; inset-block-start: 19.1mm; inline-size: 69.4mm; block-size: 54.0mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 113.3mm; inset-block-start: 75.1mm; inline-size: 47.1mm; block-size: 7.7mm; font-size: 11.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 13.0mm; inset-block-start: 90.1mm; inline-size: 90.0mm; block-size: 13.1mm; font-size: 37.2pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 20.2mm; inset-block-start: 106.4mm; inline-size: 181.4mm; block-size: 13.7mm; font-size: 12.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 20.3mm; inset-block-start: 125.8mm; inline-size: 86.7mm; block-size: 37.1mm; font-size: 13.2pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 112.8mm; inset-block-start: 126.5mm; inline-size: 44.1mm; block-size: 3.4mm; font-size: 9.7pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 135.2mm; inline-size: 87.7mm; block-size: 23.1mm; font-size: 13.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 163.4mm; inline-size: 89.8mm; block-size: 18.4mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 20.3mm; inset-block-start: 168.1mm; inline-size: 85.6mm; block-size: 27.8mm; font-size: 13.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 186.8mm; inline-size: 86.9mm; block-size: 23.1mm; font-size: 13.1pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 20.3mm; inset-block-start: 200.9mm; inline-size: 88.3mm; block-size: 27.8mm; font-size: 13.1pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 215.0mm; inline-size: 88.7mm; block-size: 37.1mm; font-size: 13.2pt">{{ slot_10 }}</p>
<h2 class="box" style="inset-inline-start: 20.3mm; inset-block-start: 234.5mm; inline-size: 30.2mm; block-size: 3.4mm; font-size: 9.7pt">{{ slot_11 }}</h2>
<p class="box" style="inset-inline-start: 20.3mm; inset-block-start: 243.2mm; inline-size: 85.2mm; block-size: 13.7mm; font-size: 12.9pt">{{ slot_12 }}</p>
</div></body>
</html>
