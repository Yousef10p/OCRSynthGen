}

.left-column, .right-column {
    height: 100%;
    padding: 20px;
}

.left-column {
    flex: 1;
    background-color: #f0f0f0;
    border-left: 1px solid #ccc;
}

.right-column {
    flex: 3;
    background-color: #fff;
}


.categories, .featured-items, .recommended-items, .search-bar {
    margin-bottom: 20px;
}

.categories, .featured-items, .recommended-items {
    min-height: 100px;
    background-color: #ddd;
}

.search-bar {
    display: flex;
    align-items: center;
