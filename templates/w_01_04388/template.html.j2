    padding: 5px;
}

.search-bar button {
    padding: 5px;
    background-color: #fff;
    border: 1px solid #ccc;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
