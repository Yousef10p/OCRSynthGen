<li>{{ slot_6 }}</li>
</ul>
</div>
<div class="center-footer">
<h2>{{ slot_7 }}</h2>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</div>
<div class="right-footer">
