<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.container {
  display: flex;
  justify-content: space-between;
  padding: 20px;
}
.left-column, .main-content, .right-column {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.left-column, .right-column {
  width: 20%;
}
.main-content {
  width: 60%;
  justify-content: space-between;
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.product, .category, .review, .faq, .search { 
  background-color: gray; 
  padding: 20px;
  color: white;
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="left-column">
<h1>{{ slot_0 }}</h1>
<div class="category"><a>{{ slot_1 }}</a></div>
<div class="category"><a>{{ slot_2 }}</a></div>
<div class="category"><a>{{ slot_3 }}</a></div>
<div class="category"><a>{{ slot_4 }}</a></div>
</div>
<div class="main-content">
<h1>{{ slot_5 }}</h1>
<div class="product-grid">
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
<div class="product">{{ slot_9 }}</div>

</div>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
</div>
<div class="right-column">
<h1>{{ slot_11 }}</h1>
<div class="review"><a>{{ slot_12 }}</a></div>
<div class="review"><a>{{ slot_13 }}</a></div>
<h1>{{ slot_14 }}</h1>
<div class="faq"><a>{{ slot_15 }}</a></div>
<div class="faq"><a>{{ slot_16 }}</a></div>
</div>
</div>
</body>
</html>