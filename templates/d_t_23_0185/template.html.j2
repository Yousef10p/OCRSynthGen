<div class="box ph" style="inset-inline-start: 30.5mm; inset-block-start: 136.8mm; inline-size: 5.1mm; block-size: 23.9mm; font-size: 13.5pt"></div>
<p class="box" style="inset-inline-start: 39.5mm; inset-block-start: 135.9mm; inline-size: 101.1mm; block-size: 6.0mm; font-size: 12.6pt">{{ slot_4 }}</p>
