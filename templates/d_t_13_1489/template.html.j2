<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 87.3mm; inset-block-start: 12.4mm; inline-size: 39.5mm; block-size: 4.9mm; font-size: 13.8pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 32.2mm; inset-block-start: 30.1mm; inline-size: 72.9mm; block-size: 8.0mm; font-size: 11.3pt"></div>
<p class="box" style="inset-inline-start: 155.5mm; inset-block-start: 34.8mm; inline-size: 23.2mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_1 }}</p>
<h1 class="box" style="inset-inline-start: 65.6mm; inset-block-start: 70.4mm; inline-size: 90.5mm; block-size: 6.9mm; font-size: 19.5pt">{{ slot_2 }}</h1>
<h1 class="box" style="inset-inline-start: 95.8mm; inset-block-start: 93.8mm; inline-size: 32.5mm; block-size: 6.9mm; font-size: 19.5pt">{{ slot_3 }}</h1>
<h1 class="box" style="inset-inline-start: 52.9mm; inset-block-start: 110.1mm; inline-size: 118.3mm; block-size: 6.9mm; font-size: 19.5pt">{{ slot_4 }}</h1>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 262.0mm; inline-size: 33.7mm; block-size: 26.7mm; font-size: 40.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 107.4mm; inset-block-start: 262.7mm; inline-size: 31.3mm; block-size: 25.2mm; font-size: 40.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 146.4mm; inset-block-start: 262.7mm; inline-size: 37.4mm; block-size: 17.7mm; font-size: 40.0pt">{{ slot_7 }}</p>
</div></body>
</html>
