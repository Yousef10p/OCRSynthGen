<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 68.2mm; inline-size: 83.2mm; block-size: 43.0mm; font-size: 15.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 70.0mm; inline-size: 83.4mm; block-size: 37.5mm; font-size: 15.2pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 207.0mm; inset-block-start: 105.1mm; inline-size: 3.7mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_5 }}</footer><p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 116.0mm; inline-size: 83.3mm; block-size: 77.2mm; font-size: 15.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 119.5mm; inline-size: 83.3mm; block-size: 54.4mm; font-size: 15.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 182.1mm; inline-size: 83.2mm; block-size: 37.5mm; font-size: 15.2pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 201.6mm; inline-size: 83.4mm; block-size: 25.9mm; font-size: 14.7pt">{{ slot_9 }}</p>
</div></body>
</html>
