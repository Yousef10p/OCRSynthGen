<li><a>{{ slot_4 }}</a></li>
</ul>
</li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
</header>
<div class="hero-image">{{ slot_7 }}</div>
<section>
