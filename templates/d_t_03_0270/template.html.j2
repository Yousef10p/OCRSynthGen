<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 355.6mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 208.4mm; inset-block-start: 47.7mm; inline-size: 114.2mm; block-size: 120.5mm; font-size: 34.2pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 75.4mm; inset-block-start: 55.8mm; inline-size: 29.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 52.2mm; inset-block-start: 62.1mm; inline-size: 75.9mm; block-size: 4.3mm; font-size: 12.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 32.7mm; inset-block-start: 83.9mm; inline-size: 114.8mm; block-size: 76.2mm; font-size: 16.6pt">{{ slot_3 }}</p>
</div></body>
</html>
