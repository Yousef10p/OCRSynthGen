<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 50.3mm; inset-block-start: 49.7mm; inline-size: 84.5mm; block-size: 7.5mm; font-size: 10.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 50.3mm; inset-block-start: 66.6mm; inline-size: 26.9mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 50.3mm; inset-block-start: 70.1mm; inline-size: 17.2mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 50.3mm; inset-block-start: 73.5mm; inline-size: 55.4mm; block-size: 43.6mm; font-size: 9.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 110.3mm; inset-block-start: 73.5mm; inline-size: 54.6mm; block-size: 40.2mm; font-size: 9.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.3mm; inset-block-start: 128.9mm; inline-size: 28.9mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 110.3mm; inset-block-start: 135.0mm; inline-size: 15.2mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 110.3mm; inset-block-start: 138.4mm; inline-size: 14.0mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 172.2mm; inset-block-start: 236.6mm; inline-size: 3.1mm; block-size: 1.9mm; font-size: 5.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
