<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

#mega-menu {
    background: #f8f8f8;
    margin: 0;
    padding: 0;
}

#mega-menu ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
}

#mega-menu ul li {
    display: inline-block;
    margin-left: 10px;
}

#mega-menu ul li a {
    text-decoration: none;
    color: #000;
}

#mega-menu ul li ul {
    display: none;
    position: absolute;
    background: #f8f8f8;
    margin-top: 10px;
}

#mega-menu ul li:hover ul {
    display: block;
}

#mega-menu ul li ul li {
    display: block;
    margin: 0;
}

#products {
    margin-top: 50px;
}

.product {
    color: #000;
    background-color: #f8f8f8; 
    padding: 10px;
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="mega-menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</li>
<li><a>{{ slot_5 }}</a>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</li>
<li><a>{{ slot_9 }}</a>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>
</li>
</ul>
</div>
<div id="products">
<p class="product">{{ slot_13 }}</p>
<p class="product">{{ slot_14 }}</p>
<p class="product">{{ slot_15 }}</p>
</div>
</body>
</html>