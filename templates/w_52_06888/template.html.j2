<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    background-color: #f1f1f1;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin-left: 10px;
}

#cart-icon {
    position: relative;
}

#cart-icon:hover::after {
    content: "";
    position: absolute;
    top: 100%;
    right: 0;
    padding: 10px;
    background-color: #f1f1f1;
    border: 1px solid #ccc;
    display: none;
}

#cart-icon:hover::after {
    display: block;
}

.product-box {
    margin: 20px;
    padding: 20px;
    border: 1px solid #ccc;
    display: inline-block;
    width: calc(33.3% - 40px);
    height: 200px;
    background-color: #f1f1f1;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li>{{ slot_0 }}</li>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</nav>
<h1>{{ slot_5 }}</h1>
<div id="cart-icon">{{ slot_6 }}</div>
</header>
<main>
<p>{{ slot_7 }}</p>
<div class="product-box">{{ slot_8 }}</div>
<div class="product-box">{{ slot_9 }}</div>
<div class="product-box">{{ slot_10 }}</div>
<div class="product-box">{{ slot_11 }}</div>
<div class="product-box">{{ slot_12 }}</div>
<div class="product-box">{{ slot_13 }}</div>
<div class="product-box">{{ slot_14 }}</div>
<div class="product-box">{{ slot_15 }}</div>
<div class="product-box">{{ slot_16 }}</div>
<div class="product-box">{{ slot_17 }}</div>
</main>
</body>
</html>