  position: relative;
}

nav ul li a {
  display: inline-block;
  color: #007BFF;
  text-decoration: none;
  padding: 5px 10px;
}

nav ul li:hover {
  background-color: #f8f8f8;
}

nav ul li ul {
  display: none;
