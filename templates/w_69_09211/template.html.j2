<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    background-color: #f2f2f2;
    font-family: var(--font-body);
}
.wrapper {
    display: flex;
    justify-content: space-between;
}
.logo {
    background-color: red;
    width: 100px;
    height: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
}
.logo-text {
    color: #fff;
}
.nav-menu {
    width: 20%;
    background-color: blue;
}
.nav-menu ul {
    list-style-type: none;
    padding: 0;
}
.nav-menu a {
    color: #fff;
    display: block;
    padding: 8px 16px;
    text-decoration: none;
}
.nav-menu a:hover {
    background-color: #555;
    color: white;
}
.content {
    width: 75%;
    padding: 10px;
}
.game, .player-interview {
    margin-bottom: 20px;
}
.game-image, .player-image {
    width: 200px;
    height: 200px;
    background-color: grey;
}
table {
    width: 100%;
}
td, th {
    border: 1px solid #ddd;
    padding: 8px;
}
tr:nth-child(even){background-color: #f2f2f2;}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="wrapper">
<div class="logo">
<div class="logo-text">{{ slot_0 }}</div>
</div>
<div class="nav-menu">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="content">
<h1>{{ slot_5 }}</h1>
<div class="game">
<div class="game-image ph"></div>
<p>{{ slot_6 }}</p>
</div>
<div class="player-interview">
<div class="player-image ph"></div>
<p>{{ slot_7 }}</p>
</div>
<div class="schedule">
<h1>{{ slot_8 }}</h1>
<table>
<tr>
<th>{{ slot_9 }}</th>
<th>{{ slot_10 }}</th>
</tr>
<tr>
<td>{{ slot_11 }}</td>
<td>{{ slot_12 }}</td>
</tr>
<tr>
<td>{{ slot_13 }}</td>
<td>{{ slot_14 }}</td>
</tr>
</table>
</div>
</div>
</div>
</body>
</html>