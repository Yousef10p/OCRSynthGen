  margin: 50px 0;
}

.drop-down {
  display: none;
}

.services-menu:hover .drop-down,
.products-menu:hover .drop-down,
.resources-menu:hover .drop-down {
  display: block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
