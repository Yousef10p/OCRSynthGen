<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 25.4mm; inline-size: 164.2mm; block-size: 14.0mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 64.6mm; inset-block-start: 46.5mm; inline-size: 86.2mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 62.4mm; inset-block-start: 54.3mm; inline-size: 90.3mm; block-size: 4.7mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 39.5mm; inset-block-start: 64.0mm; inline-size: 136.4mm; block-size: 3.5mm; font-size: 8.0pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 66.5mm; inline-size: 6.3mm; block-size: 124.0mm; font-size: 20.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 53.2mm; inset-block-start: 71.7mm; inline-size: 108.9mm; block-size: 11.2mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 48.6mm; inset-block-start: 86.9mm; inline-size: 118.1mm; block-size: 3.5mm; font-size: 8.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 45.9mm; inset-block-start: 94.6mm; inline-size: 123.4mm; block-size: 3.5mm; font-size: 8.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 54.5mm; inset-block-start: 102.2mm; inline-size: 106.2mm; block-size: 11.2mm; font-size: 10.9pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 37.3mm; inset-block-start: 119.1mm; inline-size: 140.6mm; block-size: 121.3mm; font-size: 10.9pt">{{ slot_9 }}</p>
</div></body>
</html>
