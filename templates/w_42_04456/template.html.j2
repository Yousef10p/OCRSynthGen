<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

.hero-image {
  background: linear-gradient(to left, #0062E6, #33AEFF);
  color: white;
  text-align: center;
  padding: 100px 0;
}

.title {
  font-size: 36px;
}

.subtitle {
  font-size: 24px;
  margin-top: 10px;
}

.main-menu {
  background-color: #333;
  color: white;
  text-align: center;
  margin-bottom: 20px;
}

.menu {
  list-style-type: none;
}

.menu > li {
  display: inline-block;
  margin: 0 10px;
  position: relative;
}

.menu > li > ul {
  display: none;
  position: absolute;
  background-color: #333;
  padding: 10px;
}

.menu > li:hover > ul {
  display: block;
}

.menu > li > ul > li {
  display: block;
  margin: 5px 0;
}

.main-content {
  max-width: 960px;
  margin: 0 auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero-image">
<h1 class="title">{{ slot_0 }}</h1>
<p class="subtitle">{{ slot_1 }}</p>
</div>
<div class="main-menu">
<ul class="menu">
<li class="dropdown">
<a>{{ slot_2 }}</a>
<ul class="submenu">
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</li>
<li class="dropdown">
<a>{{ slot_8 }}</a>
<ul class="submenu">
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>
</li>
<li class="dropdown">
<a>{{ slot_13 }}</a>
<ul class="submenu">
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
<li><a>{{ slot_16 }}</a></li>
<li><a>{{ slot_17 }}</a></li>
</ul>
</li>
</ul>
<div class="main-content">
<p>{{ slot_18 }}</p>
<p>{{ slot_19 }}</p>
<div class="ph" style="inline-size: 150px"></div>
<p>{{ slot_20 }}</p>
<p>{{ slot_21 }}</p>
</div>
</div>
</body>
</html>