}

section:first-child h1, section:first-child p {
  font-size: 2em;
  color: #2196f3;
}

section:first-child button {
  background: #2196f3;
  color: #fff;
  padding: 0.5em 1em;
}

section:nth-child(2) h2, section:nth-child(2) h3 {
  color: #2196f3;
}

footer ul {
  list-style: none;
}

footer ul li {
