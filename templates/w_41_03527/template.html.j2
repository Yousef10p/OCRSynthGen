  margin-left: 1em;
}

footer form input {
  display: block;
  margin-bottom: 1em;
}

footer form button {
  background: #2196f3;
  color: #fff;
  padding: 0.5em 1em;
  display: block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
