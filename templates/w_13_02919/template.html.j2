footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 2.5rem;
    background: #ccc;
    text-align: center;
    padding: 2.5%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
