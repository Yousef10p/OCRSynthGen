}

nav ul li a {
    text-decoration: none;
    color: #000;
}

nav ul li a:hover {
    text-decoration: underline;
}

#slider, #highlight, article div {
    height: 150px;
    width: 100%;
    background: #ccc;
    margin: 1% auto;
}

#featured-story {
    height: 400px;
}

h2 {
    font-size: 1.5em;
