<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

.main_container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    padding: 10px;
}

header {
    position: fixed;
    bottom: 0;
    width: 100%;
    background-color: #333;
    color: #fff;
    padding: 20px;
}

.logo {
    margin: 20px;
    height: 100px;
    width: 100px;
    background-color: #333;
    color: #fff;
}

.menu {
    display: flex;
    justify-content: space-between;
    list-style: none;
}

.menu li {
    padding: 10px;
}

.menu a {
    color: #fff;
    text-decoration: none;
}

.card {
    background-color: #f2f2f2;
    padding: 20px;
    margin: 20px 0;
}

.card_header {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 10px;
}

.card_content {
    font-size: 16px;
    color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="main_container">
<header>
<div class="logo">{{ slot_0 }}</div>
<nav class="menu">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<section class="content_container">
<div class="card">
<div class="card_header">{{ slot_5 }}</div>
<div class="card_content">
<p>{{ slot_6 }}</p>
</div>
</div>
<div class="card">
<div class="card_header">{{ slot_7 }}</div>
<div class="card_content">
<p>{{ slot_8 }}</p>
</div>
</div>
<div class="card">
<div class="card_header">{{ slot_9 }}</div>
<div class="card_content">
<p>{{ slot_10 }}</p>
</div>
</div>
<div class="card">
<div class="card_header">{{ slot_11 }}</div>
<div class="card_content">
<p>{{ slot_12 }}</p>
</div>
</div>
<div class="card">
