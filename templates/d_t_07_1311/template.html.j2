<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 16.4mm; inset-block-start: 12.8mm; inline-size: 22.9mm; block-size: 12.2mm; font-size: 17.3pt"></div>
<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 47.4mm; inline-size: 140.7mm; block-size: 16.1mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 41.3mm; inset-block-start: 68.8mm; inline-size: 95.1mm; block-size: 44.7mm; font-size: 21.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 15.3mm; inset-block-start: 131.8mm; inline-size: 55.6mm; block-size: 54.5mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 78.3mm; inset-block-start: 135.0mm; inline-size: 54.4mm; block-size: 108.8mm; font-size: 11.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 139.7mm; inset-block-start: 135.0mm; inline-size: 55.2mm; block-size: 56.1mm; font-size: 11.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 190.1mm; inline-size: 55.5mm; block-size: 56.1mm; font-size: 11.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 139.7mm; inset-block-start: 194.6mm; inline-size: 49.2mm; block-size: 7.4mm; font-size: 10.5pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 139.7mm; inset-block-start: 205.5mm; inline-size: 53.3mm; block-size: 27.7mm; font-size: 11.2pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 139.7mm; inset-block-start: 236.7mm; inline-size: 52.3mm; block-size: 15.5mm; font-size: 11.0pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 16.9mm; inset-block-start: 265.1mm; inline-size: 52.6mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
