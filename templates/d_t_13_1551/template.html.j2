<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 29.2mm; inset-block-start: 18.7mm; inline-size: 38.2mm; block-size: 19.0mm; font-size: 13.5pt"></div>
<header class="box" style="inset-inline-start: 71.8mm; inset-block-start: 18.0mm; inline-size: 59.3mm; block-size: 19.8mm; font-size: 11.0pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 133.1mm; inset-block-start: 59.6mm; inline-size: 32.8mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 28.0mm; inset-block-start: 71.5mm; inline-size: 43.4mm; block-size: 14.4mm; font-size: 12.0pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 28.0mm; inset-block-start: 96.0mm; inline-size: 122.0mm; block-size: 15.1mm; font-size: 12.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 28.0mm; inset-block-start: 121.0mm; inline-size: 156.1mm; block-size: 14.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 28.0mm; inset-block-start: 137.7mm; inline-size: 145.9mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 28.0mm; inset-block-start: 147.4mm; inline-size: 156.1mm; block-size: 9.6mm; font-size: 12.0pt"><li>{{ slot_6 }}</li></ul>
