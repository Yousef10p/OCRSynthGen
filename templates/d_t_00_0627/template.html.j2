<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 87.2mm; inline-size: 71.7mm; block-size: 36.7mm; font-size: 10.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 100.4mm; inset-block-start: 87.2mm; inline-size: 67.4mm; block-size: 21.6mm; font-size: 10.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 100.4mm; inset-block-start: 113.6mm; inline-size: 65.8mm; block-size: 32.9mm; font-size: 10.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 128.7mm; inline-size: 69.1mm; block-size: 36.7mm; font-size: 10.4pt">{{ slot_4 }}</p>
