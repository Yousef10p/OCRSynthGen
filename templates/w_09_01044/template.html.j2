<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

.container {
  display: flex;
}

.menu {
  width: 20%;
  background-color: #f0f0f0;
}

.menu ul {
  list-style: none;
  padding: 0;
}

.menu li {
  padding: 10px;
  margin: 5px;
  background-color: #ccc;
}

.gallery {
  width: 80%;
  display: flex;
  flex-wrap: wrap;
}

.product {
  width: 30%;
  height: 200px;
  margin: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
}

.content {
  padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="menu">
<ul>
<li>{{ slot_0 }}</li>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
<div class="content">
<div class="gallery">
<div class="product" style="background-color: red;">{{ slot_6 }}</div>
<div class="product" style="background-color: orange;">{{ slot_7 }}</div>
<div class="product" style="background-color: yellow;">{{ slot_8 }}</div>
<div class="product" style="background-color: green;">{{ slot_9 }}</div>
<div class="product" style="background-color: blue;">{{ slot_10 }}</div>
<div class="product" style="background-color: indigo;">{{ slot_11 }}</div>
</div>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
<p>{{ slot_15 }}</p>
</div>
</div>
</body>
</html>