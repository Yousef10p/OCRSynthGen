<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 140.2mm; inline-size: 128.0mm; block-size: 6.7mm; font-size: 10.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 144.9mm; inline-size: 170.1mm; block-size: 14.7mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 167.1mm; inline-size: 170.1mm; block-size: 14.9mm; font-size: 10.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 74.7mm; inset-block-start: 189.4mm; inline-size: 66.4mm; block-size: 24.1mm; font-size: 10.9pt"></div>
