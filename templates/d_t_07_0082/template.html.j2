<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.2mm; inset-block-start: 18.3mm; inline-size: 129.5mm; block-size: 18.1mm; font-size: 25.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 13.2mm; inset-block-start: 39.9mm; inline-size: 55.3mm; block-size: 68.1mm; font-size: 12.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 80.7mm; inset-block-start: 45.2mm; inline-size: 51.3mm; block-size: 7.9mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 148.1mm; inset-block-start: 45.2mm; inline-size: 55.9mm; block-size: 35.4mm; font-size: 11.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 80.7mm; inset-block-start: 57.0mm; inline-size: 56.4mm; block-size: 55.0mm; font-size: 11.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 148.1mm; inset-block-start: 84.5mm; inline-size: 55.4mm; block-size: 43.3mm; font-size: 11.1pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 12.8mm; inset-block-start: 113.1mm; inline-size: 57.1mm; block-size: 43.6mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 80.7mm; inset-block-start: 115.9mm; inline-size: 56.9mm; block-size: 23.6mm; font-size: 11.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 148.1mm; inset-block-start: 131.6mm; inline-size: 57.3mm; block-size: 62.9mm; font-size: 11.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 148.1mm; inset-block-start: 198.3mm; inline-size: 52.5mm; block-size: 31.5mm; font-size: 11.2pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 147.3mm; inset-block-start: 251.1mm; inline-size: 55.4mm; block-size: 19.3mm; font-size: 27.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
