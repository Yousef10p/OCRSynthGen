<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.col-12, .col-8, .col-4 {
    float: right;
    padding: 15px;
    box-sizing: border-box;
    color: white;
}

.col-12 {
    width: 100%;
    background: grey;
}

.col-8 {
    width: 66.67%;
    background: brown;
}

.col-4 {
    width: 33.33%;
    background: black;
}

h1, h2 {
    text-align: center;
}

.work-container, .team-container {
    display: flex;
    justify-content: space-around;
}

.work-item, .team-item {
    width: 30%;
    padding: 20px;
    box-sizing: border-box;
    text-align: center;
}

.work-item {
    background: red;
}

.team-item {
    background: blue;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header class="col-12">
<h1>{{ slot_0 }}</h1>
</header>
<div class="row">
<div class="col-8">
<h2>{{ slot_1 }}</h2>
<div class="work-container">
<div class="work-item">{{ slot_2 }}</div>
<div class="work-item">{{ slot_3 }}</div>
<div class="work-item">{{ slot_4 }}</div>
</div>
</div>
<div class="col-4">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
<h2>{{ slot_11 }}</h2>
<div class="team-container">
<div class="team-item">{{ slot_12 }}</div>
<div class="team-item">{{ slot_13 }}</div>
<div class="team-item">{{ slot_14 }}</div>
</div>
</div>
</div>
</body>
</html>