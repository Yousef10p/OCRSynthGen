<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}

header {
  background-color: lightblue;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100px;
}

.movies, .tv-shows, .music {
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.movie-grid, .tv-grid, .music-grid{
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  grid-gap: 20px;
}

.movie, .tv, .song {
  background-color: lightblue;
  height: 300px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</header>
<section class="movies">
<h1>{{ slot_0 }}</h1>
<div class="movie-grid">
<div class="movie">{{ slot_1 }}</div>
<div class="movie">{{ slot_2 }}</div>
<div class="movie">{{ slot_3 }}</div>
<div class="movie">{{ slot_4 }}</div>
<div class="movie">{{ slot_5 }}</div>
<div class="movie">{{ slot_6 }}</div>
</div>
</section>
<section class="tv-shows">
<h1>{{ slot_7 }}</h1>
<div class="tv-grid">
<div class="tv">{{ slot_8 }}</div>
<div class="tv">{{ slot_9 }}</div>
<div class="tv">{{ slot_10 }}</div>
</div>
</section>
<section class="music">
<h1>{{ slot_11 }}</h1>
<div class="music-grid">
<div class="song">{{ slot_12 }}</div>
<div class="song">{{ slot_13 }}</div>
<div class="song">{{ slot_14 }}</div>
</div>
</section>
</body>
</html>