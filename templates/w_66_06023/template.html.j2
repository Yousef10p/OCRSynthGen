<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    color: #333;
}

.navbar {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 50px;
    background-color: #333;
}

.nav-item {
    color: #fff;
}

.hero {
    height: 200px;
    text-align: center;
    line-height: 200px;
    background-color: #e1e1e1;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    grid-gap: 20px;
    padding: 20px;
}

.product, .blog {
    background-color: #e1e1e1;
    height: 200px;
    padding: 20px;
}


.hero:before, .product:before, .blog:before {
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    background-color: #e1e1e1;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav class="navbar">
<div class="nav-item"><i class="fa fa-dumbbell"></i> {{ slot_0 }}</div>
<div class="nav-item"><i class="fa fa-users"></i> {{ slot_1 }}</div>
<div class="nav-item"><i class="fa fa-shopping-cart"></i> {{ slot_2 }}</div>
<div class="nav-item"><i class="fa fa-book"></i> {{ slot_3 }}</div>
</nav>
<div class="hero">
<p>{{ slot_4 }}</p>
</div>
<div class="grid">
<div class="product">{{ slot_5 }}<p>{{ slot_6 }}</p></div>
<div class="product">{{ slot_7 }}<p>{{ slot_8 }}</p></div>
<div class="product">{{ slot_9 }}<p>{{ slot_10 }}</p></div>
<div class="blog">{{ slot_11 }}<p>{{ slot_12 }}</p></div>
<div class="blog">{{ slot_13 }}<p>{{ slot_14 }}</p></div>
</div>
</body>
</html>