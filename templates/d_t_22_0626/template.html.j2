<div class="box ph" style="inset-inline-start: 45.2mm; inset-block-start: 96.9mm; inline-size: 46.8mm; block-size: 66.7mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 94.0mm; inset-block-start: 96.7mm; inline-size: 47.5mm; block-size: 66.9mm; font-size: 14.6pt"></div>
<h2 class="box" style="inset-inline-start: 14.5mm; inset-block-start: 165.4mm; inline-size: 19.0mm; block-size: 8.4mm; font-size: 8.0pt">{{ slot_5 }}</h2>
