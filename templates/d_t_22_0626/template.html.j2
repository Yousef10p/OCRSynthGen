<h2 class="box" style="inset-inline-start: 54.6mm; inset-block-start: 67.4mm; inline-size: 30.9mm; block-size: 4.6mm; font-size: 6.5pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 104.6mm; inset-block-start: 67.2mm; inline-size: 32.5mm; block-size: 4.6mm; font-size: 6.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 51.0mm; inset-block-start: 72.2mm; inline-size: 38.9mm; block-size: 19.0mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 99.9mm; inset-block-start: 71.7mm; inline-size: 41.9mm; block-size: 13.9mm; font-size: 7.9pt">{{ slot_4 }}</p>
