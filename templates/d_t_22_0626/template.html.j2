<h2 class="box" style="inset-inline-start: 101.8mm; inset-block-start: 165.3mm; inline-size: 36.5mm; block-size: 8.4mm; font-size: 8.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 47.0mm; inset-block-start: 169.5mm; inline-size: 45.3mm; block-size: 30.9mm; font-size: 8.8pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 9.0mm; inset-block-start: 173.9mm; inline-size: 29.9mm; block-size: 19.1mm; font-size: 9.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 102.3mm; inset-block-start: 173.9mm; inline-size: 38.6mm; block-size: 19.1mm; font-size: 9.0pt">{{ slot_10 }}</p>
<div class="box ph" style="inset-inline-start: 139.2mm; inset-block-start: 205.8mm; inline-size: 3.9mm; block-size: 4.0mm; font-size: 11.4pt"></div>
</div></body>
</html>
