<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 101.6mm; inset-block-start: 15.3mm; inline-size: 18.0mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 66.9mm; inset-block-start: 20.5mm; inline-size: 4.7mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 149.3mm; inset-block-start: 20.5mm; inline-size: 5.0mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_2 }}</header><div class="box ph" style="inset-inline-start: 31.2mm; inset-block-start: 25.1mm; inline-size: 95.3mm; block-size: 51.0mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 32.2mm; inset-block-start: 76.5mm; inline-size: 102.0mm; block-size: 25.9mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 30.9mm; inset-block-start: 111.4mm; inline-size: 76.7mm; block-size: 9.8mm; font-size: 9.2pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 114.7mm; inset-block-start: 110.9mm; inline-size: 73.3mm; block-size: 146.3mm; font-size: 15.9pt"></div>
<div class="box ph" style="inset-inline-start: 32.2mm; inset-block-start: 125.0mm; inline-size: 73.7mm; block-size: 81.1mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 30.9mm; inset-block-start: 212.2mm; inline-size: 76.7mm; block-size: 9.8mm; font-size: 9.2pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 49.2mm; inset-block-start: 226.0mm; inline-size: 41.1mm; block-size: 31.9mm; font-size: 9.0pt"></div>
</div></body>
</html>
