<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}
.header {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 50px;
    background-color: #333;
}
.header nav ul {
    display: flex;
    list-style: none;
}
.header nav ul li {
    margin: 0 20px;
}
.header nav ul li a {
    color: #fff;
    text-decoration: none;
}
.header nav ul li a img {
    width: 20px;
    height: 20px;
    margin-left: 5px;
}
.header nav ul li a span {
    font-weight: bold;
}
.products, .services {
    margin: 20px;
}
.product, .service {
    width: 100px;
    height: 100px;
    margin: 20px;
    background-color: #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<nav>
<ul>
<li><a><div class="ph" style="inline-size: 100%; block-size: 150px"></div><span>{{ slot_0 }}</span></a></li>
<li><a><div class="ph" style="inline-size: 100%; block-size: 150px"></div><span>{{ slot_1 }}</span></a></li>
<li><a><div class="ph" style="inline-size: 100%; block-size: 150px"></div><span>{{ slot_2 }}</span></a></li>
<li><a><div class="ph" style="inline-size: 100%; block-size: 150px"></div><span>{{ slot_3 }}</span></a></li>
</ul>
</nav>
</div>
<div class="products">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<div class="product">{{ slot_6 }}</div>
<p>{{ slot_7 }}</p>
<div class="product">{{ slot_8 }}</div>
<p>{{ slot_9 }}</p>
<div class="product">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
</div>
<div class="services">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="service">{{ slot_14 }}</div>
<p>{{ slot_15 }}</p>
<div class="service">{{ slot_16 }}</div>
<p>{{ slot_17 }}</p>
<div class="service">{{ slot_18 }}</div>
<p>{{ slot_19 }}</p>
</div>
</body>
</html>