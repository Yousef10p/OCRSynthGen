<div class="box ph" style="inset-inline-start: 8.4mm; inset-block-start: 102.1mm; inline-size: 60.9mm; block-size: 55.7mm; font-size: 26.3pt"></div>
<p class="box" style="inset-inline-start: 74.5mm; inset-block-start: 125.3mm; inline-size: 110.5mm; block-size: 26.9mm; font-size: 10.9pt">{{ slot_4 }}</p>
