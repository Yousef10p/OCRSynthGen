<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}


nav ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background-color: #333;
}

nav ul li {
  float: right;
}

nav ul li a {
  display: block;
  color: white;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}

nav ul li a:hover {
  background-color: #111;
}


#top-section {
  height: 450px;
  background-image: none;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}

#top-section button { 
  display: block;
  width: 200px;
  height: 50px;
  background-color: #4CAF50;
  color: white;
  text-align: center;
  border: none;
  cursor: pointer;
}

#top-section button:hover { 
  background-color: #45a049; 
}


#middle-section {
  padding: 20px;
}


#middle-section div:first-child {
  float: right;
  width: 70%;
}


#middle-section div:last-child {
  float: left;
  width: 30%;
  padding: 20px;
}


#bottom-section {
  padding: 20px;
}


#bottom-section div:first-child {
  float: right;
  width: 70%;
}


#bottom-section div:last-child {
  float: left;
  width: 30%;
  padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
