<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 58.6mm; inline-size: 43.3mm; block-size: 7.8mm; font-size: 24.8pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 83.1mm; inline-size: 87.3mm; block-size: 7.8mm; font-size: 24.8pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 108.7mm; inline-size: 165.1mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 72.3mm; inset-block-start: 132.3mm; inline-size: 71.3mm; block-size: 4.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 147.9mm; inline-size: 14.2mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 65.6mm; inset-block-start: 156.1mm; inline-size: 84.6mm; block-size: 4.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 168.6mm; inline-size: 165.1mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 55.9mm; inset-block-start: 192.2mm; inline-size: 104.2mm; block-size: 4.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 207.6mm; inline-size: 165.1mm; block-size: 29.3mm; font-size: 12.0pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 105.9mm; inset-block-start: 251.1mm; inline-size: 4.1mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
