<h2 class="box" style="inset-inline-start: 23.6mm; inset-block-start: 113.8mm; inline-size: 22.9mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_3 }}</h2>
<h2 class="box" style="inset-inline-start: 108.4mm; inset-block-start: 113.8mm; inline-size: 32.4mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 23.6mm; inset-block-start: 119.9mm; inline-size: 79.8mm; block-size: 28.5mm; font-size: 10.1pt">{{ slot_5 }}</p>
