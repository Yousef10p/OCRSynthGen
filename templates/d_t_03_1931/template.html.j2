<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Legal landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 355.6mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 17.3mm; inset-block-start: 63.1mm; inline-size: 95.6mm; block-size: 95.9mm; font-size: 12.9pt"></div>
<div class="box ph" style="inset-inline-start: 192.4mm; inset-block-start: 63.2mm; inline-size: 95.4mm; block-size: 95.8mm; font-size: 11.8pt"></div>
<h2 class="box" style="inset-inline-start: 123.9mm; inset-block-start: 64.3mm; inline-size: 34.0mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 298.9mm; inset-block-start: 64.2mm; inline-size: 34.0mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 118.6mm; inset-block-start: 74.7mm; inline-size: 45.0mm; block-size: 23.8mm; font-size: 9.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 293.4mm; inset-block-start: 74.9mm; inline-size: 45.0mm; block-size: 13.1mm; font-size: 9.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 293.2mm; inset-block-start: 99.6mm; inline-size: 45.1mm; block-size: 20.2mm; font-size: 9.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 118.6mm; inset-block-start: 103.2mm; inline-size: 45.0mm; block-size: 9.5mm; font-size: 9.0pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 6.8mm; inset-block-start: 122.1mm; inline-size: 4.1mm; block-size: 30.8mm; font-size: 40.0pt">{{ slot_6 }}</header><header class="box" style="inset-inline-start: 344.8mm; inset-block-start: 122.1mm; inline-size: 3.8mm; block-size: 30.8mm; font-size: 40.0pt">{{ slot_7 }}</header><p class="box" style="inset-inline-start: 293.2mm; inset-block-start: 124.5mm; inline-size: 45.1mm; block-size: 13.1mm; font-size: 9.3pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 293.5mm; inset-block-start: 142.4mm; inline-size: 44.9mm; block-size: 13.1mm; font-size: 9.3pt">{{ slot_9 }}</p>
</div></body>
</html>
