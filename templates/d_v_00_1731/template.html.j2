<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 26.0mm; inline-size: 165.1mm; block-size: 21.3mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 52.0mm; inline-size: 165.1mm; block-size: 12.2mm; font-size: 12.0pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 30.4mm; inset-block-start: 72.4mm; inline-size: 160.1mm; block-size: 12.2mm; font-size: 12.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 30.4mm; inset-block-start: 92.8mm; inline-size: 121.7mm; block-size: 3.7mm; font-size: 12.0pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 31.6mm; inset-block-start: 104.7mm; inline-size: 123.0mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.7mm; inline-size: 165.1mm; block-size: 20.6mm; font-size: 12.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 151.4mm; inline-size: 136.0mm; block-size: 5.4mm; font-size: 17.2pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 165.3mm; inline-size: 165.1mm; block-size: 37.5mm; font-size: 12.0pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 214.5mm; inline-size: 93.0mm; block-size: 4.8mm; font-size: 14.3pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 226.3mm; inline-size: 165.1mm; block-size: 12.4mm; font-size: 12.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 104.9mm; inset-block-start: 251.1mm; inline-size: 6.2mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
