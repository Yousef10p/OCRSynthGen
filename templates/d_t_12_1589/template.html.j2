<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 45.3mm; inline-size: 77.7mm; block-size: 16.2mm; font-size: 10.0pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 113.1mm; inset-block-start: 46.8mm; inline-size: 61.8mm; block-size: 92.7mm; font-size: 6.4pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 62.3mm; inline-size: 77.7mm; block-size: 66.8mm; font-size: 10.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 135.5mm; inline-size: 41.1mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 142.0mm; inline-size: 77.7mm; block-size: 41.5mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 106.6mm; inset-block-start: 146.1mm; inline-size: 77.7mm; block-size: 16.2mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 106.6mm; inset-block-start: 170.7mm; inline-size: 77.8mm; block-size: 37.5mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 184.3mm; inline-size: 77.7mm; block-size: 20.4mm; font-size: 10.0pt">{{ slot_6 }}</p>
