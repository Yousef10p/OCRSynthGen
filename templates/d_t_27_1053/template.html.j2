<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 92.2mm; inset-block-start: 19.0mm; inline-size: 25.8mm; block-size: 30.4mm; font-size: 14.4pt"></div>
<h1 class="box" style="inset-inline-start: 33.7mm; inset-block-start: 56.9mm; inline-size: 144.2mm; block-size: 7.0mm; font-size: 18.0pt">{{ slot_0 }}</h1>
<h1 class="box" style="inset-inline-start: 76.6mm; inset-block-start: 68.3mm; inline-size: 58.1mm; block-size: 5.9mm; font-size: 15.0pt">{{ slot_1 }}</h1>
<p class="box" style="inset-inline-start: 78.9mm; inset-block-start: 80.0mm; inline-size: 51.9mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 96.7mm; inset-block-start: 89.2mm; inline-size: 17.6mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 37.7mm; inset-block-start: 104.7mm; inline-size: 135.8mm; block-size: 50.9mm; font-size: 14.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 37.5mm; inset-block-start: 167.8mm; inline-size: 130.1mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.0mm; inset-block-start: 174.1mm; inline-size: 161.2mm; block-size: 88.0mm; font-size: 14.0pt">{{ slot_6 }}</p>
</div></body>
</html>
