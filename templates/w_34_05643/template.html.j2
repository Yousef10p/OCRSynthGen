<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: var(--font-body);
    color: #333;
}

header, footer {
    background: #f2f2f2;
    padding: 20px;
}

header ul, footer p {
    list-style: none;
    display: flex;
    align-items: center;
}

header ul li a, footer p a {
    margin-left: 10px;
    text-decoration: none;
    color: #333;
}

main {
    margin: 20px;
}

.banner {
    width: 100%;
    height: 200px;
    background: #cfcfcf;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
}

p {
    line-height: 1.5;
    margin-bottom: 10px;
}

footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    background: #f2f2f2;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</header>
<main>
<div class="banner">{{ slot_3 }}</div>
<p>{{ slot_4 }}</p>
<p>{{ slot_5 }}</p>
</main>
<footer>
<p>{{ slot_6 }} <a>{{ slot_7 }}</a>{{ slot_8 }} <a>{{ slot_9 }}</a>{{ slot_10 }} <a>{{ slot_11 }}</a></p>
<p>{{ slot_12 }} <a>{{ slot_13 }}</a> {{ slot_14 }}</p>
</footer>
</body>
</html>