<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 88.8mm; inset-block-start: 10.9mm; inline-size: 38.1mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 177.7mm; inset-block-start: 10.9mm; inline-size: 12.8mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_1 }}</header><h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 19.4mm; inline-size: 80.5mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 77.7mm; inline-size: 172.3mm; block-size: 106.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 75.4mm; inset-block-start: 212.5mm; inline-size: 66.0mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 91.6mm; inset-block-start: 265.9mm; inline-size: 33.7mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_4 }}</footer>
</div></body>
</html>
