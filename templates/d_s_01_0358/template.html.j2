<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 12.3mm; inset-block-start: 14.7mm; inline-size: 44.9mm; block-size: 8.1mm; font-size: 9.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 12.0mm; inset-block-start: 25.7mm; inline-size: 90.5mm; block-size: 29.4mm; font-size: 11.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 106.1mm; inset-block-start: 25.3mm; inline-size: 86.6mm; block-size: 24.5mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 106.3mm; inset-block-start: 50.3mm; inline-size: 88.2mm; block-size: 119.3mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 12.2mm; inset-block-start: 55.4mm; inline-size: 89.2mm; block-size: 79.1mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.0mm; inset-block-start: 134.9mm; inline-size: 88.3mm; block-size: 59.3mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 107.1mm; inset-block-start: 169.9mm; inline-size: 88.5mm; block-size: 88.0mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 13.5mm; inset-block-start: 194.6mm; inline-size: 88.1mm; block-size: 63.0mm; font-size: 11.8pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 101.0mm; inset-block-start: 259.8mm; inline-size: 8.1mm; block-size: 4.6mm; font-size: 11.8pt">{{ slot_8 }}</footer>
</div></body>
</html>
