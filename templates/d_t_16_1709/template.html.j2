<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 227.6mm; inline-size: 83.5mm; block-size: 28.0mm; font-size: 13.2pt">{{ slot_7 }}</p>
<ul class="box" style="inset-inline-start: 108.8mm; inset-block-start: 238.2mm; inline-size: 78.2mm; block-size: 9.0mm; font-size: 8.5pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 108.8mm; inset-block-start: 246.6mm; inline-size: 78.8mm; block-size: 9.0mm; font-size: 8.5pt"><li>{{ slot_9 }}</li></ul>
<footer class="box" style="inset-inline-start: 18.0mm; inset-block-start: 265.9mm; inline-size: 5.1mm; block-size: 4.4mm; font-size: 12.4pt">{{ slot_10 }}</footer>
</div></body>
</html>
