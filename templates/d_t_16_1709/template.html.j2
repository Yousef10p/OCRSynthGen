<p class="box" style="inset-inline-start: 107.7mm; inset-block-start: 185.2mm; inline-size: 64.5mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 189.0mm; inline-size: 42.4mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 196.9mm; inline-size: 83.5mm; block-size: 28.0mm; font-size: 13.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 106.9mm; inset-block-start: 195.8mm; inline-size: 83.5mm; block-size: 14.3mm; font-size: 13.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 106.9mm; inset-block-start: 214.2mm; inline-size: 34.1mm; block-size: 6.2mm; font-size: 17.6pt">{{ slot_5 }}</h2>
