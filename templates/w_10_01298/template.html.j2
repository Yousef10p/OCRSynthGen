<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div id="content">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div class="image-placeholder">{{ slot_7 }}</div>
<h2>{{ slot_8 }}</h2>
