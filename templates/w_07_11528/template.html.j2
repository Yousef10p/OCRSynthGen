<li class="food"><a>{{ slot_3 }}</a></li>
<li class="events"><a>{{ slot_4 }}</a></li>
<li class="contact"><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<div id="content">
<div id="home">
<p>{{ slot_6 }}</p>
<div class="home-image">{{ slot_7 }}</div>
</div>
<div id="beer">
<p>{{ slot_8 }}</p>
<div class="beer-image">{{ slot_9 }}</div>
</div>
<div id="food">
<p>{{ slot_10 }}</p>
<div class="food-image">{{ slot_11 }}</div>
</div>
<div id="events">
<p>{{ slot_12 }}</p>
<div class="events-image">{{ slot_13 }}</div>
</div>
<div id="contact">
<p>{{ slot_14 }}</p>
<div class="contact-image">{{ slot_15 }}</div>
</div>
</div>
