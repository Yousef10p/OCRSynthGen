}

#splash {
    background: none no-repeat center center;
    height: 100vh;
}

#splash button {
    display: block;
    margin: 300px auto;
    padding: 20px;
    font-size: 2em;
    background-color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

h1, p, ul {
    padding: 20px;
    max-width: 900px;
    margin: 0 auto;
}

li:before {
    content: "";
    padding-left: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
