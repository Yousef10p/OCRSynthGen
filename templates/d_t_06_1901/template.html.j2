<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 39.9mm; inset-block-start: 15.8mm; inline-size: 136.1mm; block-size: 68.5mm; font-size: 13.9pt"></div>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 90.4mm; inline-size: 79.1mm; block-size: 33.6mm; font-size: 10.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 90.4mm; inline-size: 79.1mm; block-size: 37.8mm; font-size: 11.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 124.3mm; inline-size: 79.1mm; block-size: 25.2mm; font-size: 8.9pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 110.1mm; inset-block-start: 132.7mm; inline-size: 44.4mm; block-size: 8.3mm; font-size: 7.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 141.2mm; inline-size: 79.1mm; block-size: 25.2mm; font-size: 8.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 149.7mm; inline-size: 79.1mm; block-size: 42.1mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 166.6mm; inline-size: 79.1mm; block-size: 33.7mm; font-size: 9.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 27.5mm; inset-block-start: 192.0mm; inline-size: 79.1mm; block-size: 59.1mm; font-size: 11.2pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 200.4mm; inline-size: 79.1mm; block-size: 25.2mm; font-size: 10.2pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 109.2mm; inset-block-start: 227.0mm; inline-size: 43.8mm; block-size: 15.4mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 110.1mm; inset-block-start: 242.7mm; inline-size: 61.4mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_9 }}</p>
</div></body>
</html>
