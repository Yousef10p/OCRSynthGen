<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 55.8mm; inset-block-start: 16.3mm; inline-size: 104.3mm; block-size: 11.0mm; font-size: 15.6pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 14.8mm; inset-block-start: 32.5mm; inline-size: 62.1mm; block-size: 17.0mm; font-size: 12.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 181.1mm; inset-block-start: 32.7mm; inline-size: 20.6mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.1mm; inset-block-start: 55.1mm; inline-size: 176.9mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 65.8mm; inline-size: 54.1mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 76.0mm; inline-size: 112.3mm; block-size: 8.5mm; font-size: 12.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 91.4mm; inline-size: 47.4mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 27.6mm; inset-block-start: 101.6mm; inline-size: 35.0mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 122.9mm; inset-block-start: 223.5mm; inline-size: 66.4mm; block-size: 10.8mm; font-size: 15.3pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 123.5mm; inset-block-start: 236.1mm; inline-size: 64.3mm; block-size: 17.8mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 122.2mm; inset-block-start: 256.1mm; inline-size: 67.2mm; block-size: 6.1mm; font-size: 8.7pt">{{ slot_9 }}</p>
</div></body>
</html>
