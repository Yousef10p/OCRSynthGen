<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
}


.navbar {
  position: fixed;
  top: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f8f8f8;
  padding: 10px;
}

.navbar a {
  text-decoration: none;
  color: #000;
}

.navbar input[type="text"] {
  width: 30%;
  padding: 5px;
  border: 1px solid #000;
}


.content {
  margin-top: 50px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 20px;
  padding: 10px;
}


.article {
  border: 1px solid #000;
  padding: 10px;
  background-color: #f8f8f8;
}


.footer {
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f8f8f8;
  padding: 10px;
}

.footer a {
  text-decoration: none;
  color: #000;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="navbar">
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</div>
<div class="content">
<div class="article">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<div class="image" style="background-color: red;">{{ slot_8 }}</div>
</div>

<div class="article">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<div class="image" style="background-color: green;">{{ slot_11 }}</div>
</div>
</div>
<div class="footer">
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
</div>
</body>
</html>