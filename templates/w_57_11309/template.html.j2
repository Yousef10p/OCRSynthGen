  align-items: center;
  justify-content: space-between;
}

h1 {
  font-size: 2em;
}

nav ul {
  list-style: none;
}

nav ul li {
  display: inline-block;
  margin-right: 1em;
}

form input {
  padding: 0.5em;
  border: 1px solid #ddd;
}

main {
  padding: 1em;
  display: flex;
  justify-content: space-between;
}

.product {
  background-color: #ddd;
  height: 200px; 
  width: 100%;
