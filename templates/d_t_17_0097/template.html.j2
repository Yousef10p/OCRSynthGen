<div class="box ph" style="inset-inline-start: 29.5mm; inset-block-start: 99.6mm; inline-size: 156.6mm; block-size: 75.3mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 40.3mm; inset-block-start: 180.1mm; inline-size: 136.5mm; block-size: 5.5mm; font-size: 15.7pt">{{ slot_4 }}</p>
