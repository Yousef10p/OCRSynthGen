    padding: 20px 0;
    text-align: center;
    background-color: #f2f2f2;
}

nav ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
}

nav ul li a {
    text-decoration: none;
    color: #333;
}

#logo {
    width: 50px;
    height: 50px;
    background-color: #ff0000;
