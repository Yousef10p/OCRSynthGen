<div class="box ph" style="inset-inline-start: 59.7mm; inset-block-start: 84.8mm; inline-size: 44.6mm; block-size: 45.5mm; font-size: 14.3pt"></div>
<div class="box ph" style="inset-inline-start: 108.1mm; inset-block-start: 84.8mm; inline-size: 45.2mm; block-size: 45.2mm; font-size: 14.2pt"></div>
<div class="box ph" style="inset-inline-start: 156.1mm; inset-block-start: 85.2mm; inline-size: 45.5mm; block-size: 44.8mm; font-size: 15.9pt"></div>
<div class="box ph" style="inset-inline-start: 11.1mm; inset-block-start: 136.6mm; inline-size: 44.8mm; block-size: 45.2mm; font-size: 14.2pt"></div>
