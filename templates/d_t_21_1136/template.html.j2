<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 5.2mm; inline-size: 14.8mm; block-size: 5.6mm; font-size: 8.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 10.7mm; inline-size: 121.4mm; block-size: 8.2mm; font-size: 7.8pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 19.2mm; inline-size: 128.3mm; block-size: 8.3mm; font-size: 7.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 26.9mm; inline-size: 119.5mm; block-size: 8.3mm; font-size: 5.9pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 34.6mm; inline-size: 125.6mm; block-size: 8.3mm; font-size: 5.9pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 42.3mm; inline-size: 127.5mm; block-size: 8.3mm; font-size: 5.9pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 50.0mm; inline-size: 129.4mm; block-size: 15.8mm; font-size: 7.5pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 8.0mm; inset-block-start: 65.3mm; inline-size: 128.7mm; block-size: 23.6mm; font-size: 9.6pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 135.9mm; inset-block-start: 191.8mm; inline-size: 5.0mm; block-size: 5.1mm; font-size: 14.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
