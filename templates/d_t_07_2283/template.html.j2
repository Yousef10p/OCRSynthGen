<p class="box" style="inset-inline-start: 113.2mm; inset-block-start: 88.3mm; inline-size: 88.8mm; block-size: 33.6mm; font-size: 11.9pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 99.5mm; inline-size: 36.9mm; block-size: 16.3mm; font-size: 23.1pt">{{ slot_6 }}</h2>
