  display: inline;
  margin-left: 10px;
}

header a {
  text-decoration: none;
  color: #333;
}

.container {
  margin: 0 auto;
  max-width: 1200px;
}

.row {
  display: flex;
}

.column {
  flex: 1;
  padding: 15px;
  background-color: #ddd;
  margin: 10px;
  text-align: center;
}

footer {
  background-color: #f8f8f8;
  text-align: center;
  margin-top: 10px;
  padding: 10px;
}

footer ul {
  list-style-type: none;
  padding: 0;
}

footer li {
  display: inline;
  margin-left: 10px;
}

footer a {
  text-decoration: none;
  color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
