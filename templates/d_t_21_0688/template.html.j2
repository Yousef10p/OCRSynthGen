<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 134.5mm; inline-size: 172.8mm; block-size: 7.6mm; font-size: 9.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 62.3mm; inset-block-start: 146.8mm; inline-size: 92.0mm; block-size: 69.3mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 221.1mm; inline-size: 173.9mm; block-size: 3.7mm; font-size: 9.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 224.9mm; inline-size: 111.9mm; block-size: 3.7mm; font-size: 9.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 230.8mm; inline-size: 159.7mm; block-size: 3.7mm; font-size: 9.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 236.8mm; inline-size: 172.7mm; block-size: 7.6mm; font-size: 9.0pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 106.2mm; inset-block-start: 261.1mm; inline-size: 3.6mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
