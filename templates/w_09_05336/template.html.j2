<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

header {
    width: 100%;
    height: 80px;
    background-color: #f8f8f8;
    position: relative;
}

#logo-header {
    width: 300px;
    height: 80px;
    position: absolute;
    top: 0;
    right: 0;
    background-color: #ff0000;
}

#nav {
    width: 80%;
    height: 80px;
    position: absolute;
    top: 0;
    left: 0;
}

#nav ul {
    margin: 0;
    padding: 0;
    list-style-type: none;
    float: left;
}

#nav li {
    display: inline-block;
    margin-left: 15px;
    line-height: 80px;
}

#nav a {
    color: #000;
    text-decoration: none;
}

#content {
    width: 80%;
    margin: 0 auto;
    clear: both;
}

#content .section {
    width: 100%;
    margin-top: 50px;
}

#content .sub-section {
    width: 25%;
    float: right;
    padding: 15px;
    box-sizing: border-box;
}

#content .sub-section label {
    font-size: 20px;
    margin-bottom: 15px;
}

#content .sub-section .product {
    width: 100%;
    height: 200px;
    margin-bottom: 15px;
    background-color: #f8f8f8;
}

footer {
    width: 100%;
    height: 50px;
    background-color: #f8f8f8;
    position: absolute;
    bottom: 0;
}

footer ul {
    margin: 0;
    padding: 0;
    list-style-type: none;
}

footer li {
    display: inline-block;
    margin-left: 15px;
    line-height: 50px;
}

footer a {
    color: #000;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
