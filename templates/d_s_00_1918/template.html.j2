<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 123.0mm; inline-size: 164.5mm; block-size: 11.0mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 33.9mm; inset-block-start: 136.5mm; inline-size: 156.0mm; block-size: 23.1mm; font-size: 10.9pt"></div>
