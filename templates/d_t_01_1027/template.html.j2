<p class="box" style="inset-inline-start: 15.9mm; inset-block-start: 139.9mm; inline-size: 171.5mm; block-size: 13.2mm; font-size: 12.5pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 15.4mm; inset-block-start: 162.0mm; inline-size: 35.3mm; block-size: 9.7mm; font-size: 13.8pt"></div>
<p class="box" style="inset-inline-start: 15.9mm; inset-block-start: 173.7mm; inline-size: 36.1mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_5 }}</p>
