<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 83.3mm; inset-block-start: 11.9mm; inline-size: 5.8mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 210.4mm; inset-block-start: 12.1mm; inline-size: 5.2mm; block-size: 2.3mm; font-size: 6.7pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 173.6mm; inset-block-start: 21.4mm; inline-size: 80.4mm; block-size: 69.0mm; font-size: 11.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 45.5mm; inset-block-start: 22.1mm; inline-size: 79.3mm; block-size: 35.0mm; font-size: 11.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 45.5mm; inset-block-start: 60.5mm; inline-size: 79.2mm; block-size: 89.5mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 174.8mm; inset-block-start: 93.6mm; inline-size: 81.4mm; block-size: 98.2mm; font-size: 11.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 45.7mm; inset-block-start: 153.3mm; inline-size: 79.1mm; block-size: 7.2mm; font-size: 10.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 45.7mm; inset-block-start: 163.7mm; inline-size: 79.1mm; block-size: 15.7mm; font-size: 11.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 45.8mm; inset-block-start: 183.1mm; inline-size: 79.1mm; block-size: 10.9mm; font-size: 10.3pt">{{ slot_8 }}</p>
</div></body>
</html>
