<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
}

#header {
  position: fixed;
  width: 100%;
  height: 80px;
  background-color: #f8f8f8;
  padding: 10px 0;
  top: 0;
}

#navigation {
  list-style-type: none;
  margin: 0;
  padding: 0;
  overflow: hidden;
}

#navigation li {
  float: right;
}

#navigation a {
  display: block;
  color: black;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}

#search {
  float: left;
  margin-top: 20px;
  margin-left: 20px;
}

#main {
  margin-top: 80px;
  padding: 20px;
}

.technology-box, .services-box {
  height: 200px;
  width: 200px;
}

#footer {
  position: fixed;
  bottom: 0;
  width: 100%;
  height: 50px;
  background-color: #f8f8f8;
  padding: 15px 0;
}

#footer a {
  text-decoration: none;
  margin: 0 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<ul id="navigation">
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</div>
<div id="main">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<div class="technology-box" style="background-color: blue;"></div>
<p>{{ slot_8 }}</p>
<div class="services-box" style="background-color: green;"></div>
<p>{{ slot_9 }}</p>
</div>
<div id="footer">
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</div>
</body>
</html>