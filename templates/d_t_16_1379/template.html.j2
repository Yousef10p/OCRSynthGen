<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.3mm; inset-block-start: 16.2mm; inline-size: 86.3mm; block-size: 72.0mm; font-size: 22.7pt"></div>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 15.6mm; inline-size: 40.9mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 20.7mm; inline-size: 86.8mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 47.9mm; inline-size: 51.0mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 53.0mm; inline-size: 86.9mm; block-size: 44.8mm; font-size: 12.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 90.9mm; inline-size: 65.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 100.5mm; inline-size: 86.7mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 116.6mm; inset-block-start: 101.8mm; inline-size: 76.5mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 107.0mm; inline-size: 86.4mm; block-size: 13.2mm; font-size: 12.4pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 26.8mm; inset-block-start: 126.9mm; inline-size: 175.7mm; block-size: 124.0mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 253.9mm; inline-size: 47.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 194.9mm; inset-block-start: 262.8mm; inline-size: 7.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
