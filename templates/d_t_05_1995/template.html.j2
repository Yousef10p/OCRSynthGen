<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 147.8mm; inset-block-start: 6.6mm; inline-size: 44.0mm; block-size: 4.9mm; font-size: 13.9pt"></div>
<header class="box" style="inset-inline-start: 197.7mm; inset-block-start: 7.6mm; inline-size: 3.8mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_0 }}</header><ul class="box" style="inset-inline-start: 17.4mm; inset-block-start: 48.2mm; inline-size: 57.1mm; block-size: 13.9mm; font-size: 9.8pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.4mm; inset-block-start: 65.9mm; inline-size: 51.2mm; block-size: 6.8mm; font-size: 9.6pt"><li>{{ slot_2 }}</li></ul>
<h2 class="box" style="inset-inline-start: 17.4mm; inset-block-start: 76.4mm; inline-size: 45.6mm; block-size: 3.3mm; font-size: 5.0pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 17.4mm; inset-block-start: 80.0mm; inline-size: 59.0mm; block-size: 49.1mm; font-size: 9.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 17.4mm; inset-block-start: 132.9mm; inline-size: 59.3mm; block-size: 49.1mm; font-size: 9.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 17.4mm; inset-block-start: 195.1mm; inline-size: 77.2mm; block-size: 20.8mm; font-size: 14.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 17.4mm; inset-block-start: 230.2mm; inline-size: 57.6mm; block-size: 15.5mm; font-size: 8.8pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 79.9mm; inset-block-start: 230.6mm; inline-size: 121.8mm; block-size: 42.7mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 17.4mm; inset-block-start: 248.8mm; inline-size: 52.0mm; block-size: 12.4mm; font-size: 8.8pt">{{ slot_8 }}</p>
</div></body>
</html>
