* {
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
}

#navbar {
  background-color: #333;
  color: #fff;
  padding: 10px;
  text-align: center;
}

#navbar ul {
  list-style-type: none;
}

#navbar li {
  display: inline;
  margin: 0 20px;
}

.dropdown {
  position: relative;
  display: inline-block;
}

.dropdown-content {
  display: none;
  position: absolute;
  background-color: #333;
  min-width: 160px;
  padding: 12px 16px;
}

.dropdown:hover .dropdown-content {
  display: block;
}

#logo {
  font-size: 40px;
  text-align: center;
  margin: 20px 0;
  padding: 20px;
  background-color: #eee;
}

#donate {
