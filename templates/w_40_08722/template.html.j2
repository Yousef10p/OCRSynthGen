  height: 200px;
  background-color: #777;
  margin: 20px 0;
  text-align: center;
  line-height: 200px;
  color: #fff;
  font-weight: bold;
}
button {
  background-color: #FFA500;
  color: #fff;
  padding: 15px 32px;
  text-align: center;
  display: inline-block;
  font-size: 16px;
  margin: 4px 2px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
