  border: none;
  cursor: pointer;
}

#container {
  margin-top: 50px;
  padding: 20px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.destination {
  border: 1px solid #ddd;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.destination img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  margin-bottom: 10px;
}

#comparisonTool {
  margin-top: 50px;
  padding: 20px;
  border: 1px solid #ddd;
}

#comparisonTool p {
  margin-bottom: 10px;
}

#comparisonTool select {
  margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
