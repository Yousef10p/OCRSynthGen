<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 15.1mm; inset-block-start: 23.6mm; inline-size: 114.7mm; block-size: 79.8mm; font-size: 17.4pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 163.6mm; inset-block-start: 23.6mm; inline-size: 117.5mm; block-size: 48.2mm; font-size: 17.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 163.6mm; inset-block-start: 79.5mm; inline-size: 115.3mm; block-size: 103.7mm; font-size: 17.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 15.1mm; inset-block-start: 111.1mm; inline-size: 117.5mm; block-size: 72.0mm; font-size: 17.0pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 14.8mm; inset-block-start: 196.6mm; inline-size: 1.2mm; block-size: 2.1mm; font-size: 5.9pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 163.3mm; inset-block-start: 196.6mm; inline-size: 1.2mm; block-size: 2.1mm; font-size: 5.9pt">{{ slot_5 }}</footer>
</div></body>
</html>
