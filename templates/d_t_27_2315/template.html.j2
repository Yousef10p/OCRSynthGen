<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 5.1mm; inset-block-start: 3.6mm; inline-size: 19.8mm; block-size: 2.6mm; font-size: 11.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 5.4mm; inset-block-start: 10.5mm; inline-size: 21.6mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 23.1mm; inline-size: 199.4mm; block-size: 12.8mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 40.0mm; inline-size: 199.4mm; block-size: 22.6mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 66.6mm; inline-size: 199.4mm; block-size: 6.3mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 77.0mm; inline-size: 193.4mm; block-size: 6.3mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 87.4mm; inline-size: 199.4mm; block-size: 15.3mm; font-size: 13.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 106.5mm; inline-size: 107.4mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 113.6mm; inline-size: 198.9mm; block-size: 21.4mm; font-size: 13.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 138.8mm; inline-size: 199.4mm; block-size: 27.5mm; font-size: 13.0pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 165.4mm; inset-block-start: 179.1mm; inline-size: 39.1mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
