<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: #333;
}

.hero {
    background-color: #007BFF;
    color: white;
    text-align: center;
    padding: 50px 0;
}

nav {
    background-color: #007BFF;
    color: white;
    position: sticky;
    top: 0;
}

nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
}

nav ul li a {
    color: white;
    text-decoration: none;
}

.content {
    display: flex;
    flex-wrap: wrap;
}

.content > div {
    flex: 1 0 200px;
    margin: 10px;
    padding: 20px;
    border: 1px solid #ddd;
}

.hero, .content {
    max-width: 900px;
    margin: 0 auto;
}

.hero h1, .content h2 {
    margin-top: 0;
}

.cause, .post, .event, .opportunity {
    height: 150px;
    background-color: #f1f1f1;
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<button>{{ slot_2 }}</button>
</div>
<nav>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
<div class="content">
<div class="featured">
<h2>{{ slot_7 }}</h2>
<div class="cause">{{ slot_8 }}</div>
<div class="cause">{{ slot_9 }}</div>
</div>
<div class="blog">
<h2>{{ slot_10 }}</h2>
<div class="post">{{ slot_11 }}</div>
</div>
<div class="events">
<h2>{{ slot_12 }}</h2>
<div class="event">{{ slot_13 }}</div>
</div>
<div class="volunteer">
<h2>{{ slot_14 }}</h2>
<div class="opportunity">{{ slot_15 }}</div>
</div>
</div>
</body>
</html>