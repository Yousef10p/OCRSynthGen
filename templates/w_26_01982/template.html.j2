<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  width: 100%;
  height: 100%;
  font-family: var(--font-body);
}

a {
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
}



nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background-color: #f1f1f1;
}

nav ul {
  display: flex;
  gap: 10px;
}



main {
  padding: 20px;
}

.foodRecipes, .restaurants {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

article img {
  width: 200px;
  height: 100px;
  background-color: #ccc;
}

footer {
  text-align: center;
  padding: 20px;
  background-color: #f1f1f1;
}


body.dark-mode {
  background-color: #333;
  color: #fff;
}

body.dark-mode nav,
body.dark-mode footer {
  background-color: #555;
}

body.dark-mode a {
  color: #00c;
}

body.dark-mode article img {
  filter: invert(100%);
}


@media screen and (max-width: 600px) {
  nav ul {
    flex-direction: column;
    gap: 20px;
  }
  
  .foodRecipes, .restaurants {
    grid-template-columns: 1fr;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
