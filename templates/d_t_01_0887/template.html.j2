<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 175.4mm; inset-block-start: 16.0mm; inline-size: 52.7mm; block-size: 24.3mm; font-size: 23.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 175.4mm; inset-block-start: 50.4mm; inline-size: 94.1mm; block-size: 25.0mm; font-size: 14.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 175.4mm; inset-block-start: 82.6mm; inline-size: 98.1mm; block-size: 57.2mm; font-size: 14.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 175.4mm; inset-block-start: 147.0mm; inline-size: 91.8mm; block-size: 30.4mm; font-size: 14.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.4mm; inset-block-start: 165.2mm; inline-size: 87.1mm; block-size: 18.0mm; font-size: 10.2pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 162.7mm; inset-block-start: 199.4mm; inline-size: 58.7mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_5 }}</footer>
</div></body>
</html>
