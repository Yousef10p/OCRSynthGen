<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 38.0mm; inline-size: 165.3mm; block-size: 21.9mm; font-size: 22.1pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 68.2mm; inline-size: 168.7mm; block-size: 46.4mm; font-size: 22.1pt"><li>{{ slot_1 }}</li></ul>
<div class="box ph" style="inset-inline-start: 20.1mm; inset-block-start: 121.9mm; inline-size: 172.9mm; block-size: 73.8mm; font-size: 14.9pt"></div>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 204.8mm; inline-size: 170.7mm; block-size: 46.4mm; font-size: 22.1pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.9mm; inset-block-start: 259.4mm; inline-size: 169.8mm; block-size: 5.9mm; font-size: 22.1pt"><li>{{ slot_3 }}</li></ul>
<footer class="box" style="inset-inline-start: 133.0mm; inset-block-start: 269.8mm; inline-size: 39.1mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_4 }}</footer><footer class="box" style="inset-inline-start: 185.9mm; inset-block-start: 269.8mm; inline-size: 5.4mm; block-size: 4.6mm; font-size: 17.4pt">{{ slot_5 }}</footer>
</div></body>
</html>
