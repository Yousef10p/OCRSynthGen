<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.8mm; inset-block-start: 15.1mm; inline-size: 175.6mm; block-size: 73.0mm; font-size: 29.5pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 90.9mm; inline-size: 41.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 13.8mm; inset-block-start: 99.2mm; inline-size: 85.8mm; block-size: 14.8mm; font-size: 14.0pt"></div>
<div class="box ph" style="inset-inline-start: 103.6mm; inset-block-start: 98.9mm; inline-size: 85.8mm; block-size: 151.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 116.5mm; inline-size: 29.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 126.7mm; inline-size: 85.2mm; block-size: 22.2mm; font-size: 12.6pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 150.9mm; inline-size: 85.3mm; block-size: 31.2mm; font-size: 12.6pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 184.1mm; inline-size: 85.0mm; block-size: 17.7mm; font-size: 12.5pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 206.2mm; inline-size: 15.2mm; block-size: 4.8mm; font-size: 13.5pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 211.3mm; inline-size: 87.2mm; block-size: 17.7mm; font-size: 12.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 233.9mm; inline-size: 88.0mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 103.8mm; inset-block-start: 254.5mm; inline-size: 31.5mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 10.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
