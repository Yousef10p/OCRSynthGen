<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 141.3mm; inset-block-start: 0.7mm; inline-size: 74.4mm; block-size: 277.5mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 30.6mm; inline-size: 114.1mm; block-size: 13.3mm; font-size: 12.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 48.0mm; inline-size: 116.0mm; block-size: 13.0mm; font-size: 12.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 65.2mm; inline-size: 116.8mm; block-size: 22.6mm; font-size: 12.8pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 12.3mm; inset-block-start: 93.7mm; inline-size: 19.4mm; block-size: 2.8mm; font-size: 7.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 100.8mm; inline-size: 114.9mm; block-size: 22.6mm; font-size: 12.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 127.5mm; inline-size: 116.4mm; block-size: 17.8mm; font-size: 12.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 149.5mm; inline-size: 113.4mm; block-size: 32.2mm; font-size: 13.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 12.3mm; inset-block-start: 187.6mm; inline-size: 32.6mm; block-size: 2.8mm; font-size: 7.8pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 194.7mm; inline-size: 117.1mm; block-size: 37.0mm; font-size: 13.1pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 235.8mm; inline-size: 105.2mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 12.1mm; inset-block-start: 246.3mm; inline-size: 48.6mm; block-size: 13.7mm; font-size: 13.0pt"></div>
<p class="box" style="inset-inline-start: 12.3mm; inset-block-start: 262.7mm; inline-size: 68.2mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 6.1mm; inset-block-start: 270.1mm; inline-size: 1.7mm; block-size: 2.8mm; font-size: 7.8pt">{{ slot_11 }}</footer>
</div></body>
</html>
