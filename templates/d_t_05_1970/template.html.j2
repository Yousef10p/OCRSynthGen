<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 13.0mm; inline-size: 176.4mm; block-size: 8.2mm; font-size: 11.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 24.8mm; inline-size: 178.0mm; block-size: 8.2mm; font-size: 11.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 36.6mm; inline-size: 179.4mm; block-size: 21.1mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 61.2mm; inline-size: 182.1mm; block-size: 34.4mm; font-size: 12.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 99.1mm; inline-size: 183.2mm; block-size: 55.3mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 158.0mm; inline-size: 181.9mm; block-size: 25.4mm; font-size: 12.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 186.9mm; inline-size: 183.4mm; block-size: 51.1mm; font-size: 12.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 16.6mm; inset-block-start: 241.5mm; inline-size: 182.6mm; block-size: 21.1mm; font-size: 11.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 105.7mm; inset-block-start: 266.6mm; inline-size: 4.5mm; block-size: 4.0mm; font-size: 11.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
