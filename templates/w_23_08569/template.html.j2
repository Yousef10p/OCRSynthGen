}

h2 {
  color: #0066cc;
}

button {
  background-color: #0066cc;
  color: white;
  padding: 10px;
  border: none;
  cursor: pointer;
}

form {
  display: flex;
  flex-direction: column;
}

input {
  margin-bottom: 10px;
  padding: 5px;
}


img {
  width: 100%;
  height: 200px;
  background-color: #0066cc;
  color: white;
  text-align: center;
  line-height: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
