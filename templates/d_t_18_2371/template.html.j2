<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 32.0mm; inset-block-start: 15.1mm; inline-size: 64.4mm; block-size: 77.2mm; font-size: 14.6pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 100.1mm; inline-size: 32.4mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 107.2mm; inline-size: 108.0mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 112.0mm; inline-size: 48.4mm; block-size: 4.7mm; font-size: 12.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.9mm; inline-size: 59.4mm; block-size: 4.7mm; font-size: 12.0pt"><li>{{ slot_3 }}</li></ul>
<div class="box ph" style="inset-inline-start: 31.3mm; inset-block-start: 121.5mm; inline-size: 52.0mm; block-size: 25.2mm; font-size: 12.0pt"></div>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 152.0mm; inline-size: 58.1mm; block-size: 4.7mm; font-size: 12.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 25.4mm; inset-block-start: 156.9mm; inline-size: 116.4mm; block-size: 4.7mm; font-size: 12.0pt"><li>{{ slot_5 }}</li></ul>
<div class="box ph" style="inset-inline-start: 31.6mm; inset-block-start: 166.0mm; inline-size: 95.1mm; block-size: 38.8mm; font-size: 15.7pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 209.1mm; inline-size: 169.4mm; block-size: 9.6mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 223.7mm; inline-size: 155.2mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 198.3mm; inset-block-start: 259.5mm; inline-size: 6.2mm; block-size: 5.5mm; font-size: 14.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
