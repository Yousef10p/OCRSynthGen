   padding: 10px;
   background-color: rgba(0, 0, 0, 0.5);
}
header h1 {
   color: gold;
}
header nav ul {
   display: flex;
   list-style: none;
}
header nav ul li {
   padding: 20px;
}
section {
   display: flex;
   flex-direction: column;
   align-items: center;
   padding: 20px;
}
.type, .service {
   width: 200px;
   height: 200px;
   border: 1px solid gold;
   margin: 20px;
   display: flex;
   align-items: center;
   justify-content: center;
   background-color: white;
}
footer {
   position: fixed;
   right: 0;
   bottom: 0;
   width: 100%;
   background-color: rgba(0, 0, 0, 0.5);
   color: white;
   text-align: center;
   padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
