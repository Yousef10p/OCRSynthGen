<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 6.3mm; inline-size: 199.4mm; block-size: 48.0mm; font-size: 13.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 58.5mm; inline-size: 199.4mm; block-size: 6.5mm; font-size: 13.0pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 9.9mm; inset-block-start: 69.3mm; inline-size: 127.3mm; block-size: 3.1mm; font-size: 13.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 9.9mm; inset-block-start: 72.7mm; inline-size: 100.1mm; block-size: 3.1mm; font-size: 13.0pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 80.1mm; inline-size: 153.9mm; block-size: 3.1mm; font-size: 13.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 9.9mm; inset-block-start: 87.4mm; inline-size: 105.4mm; block-size: 3.1mm; font-size: 13.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 9.9mm; inset-block-start: 90.8mm; inline-size: 79.8mm; block-size: 3.1mm; font-size: 13.0pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 98.2mm; inline-size: 199.4mm; block-size: 10.0mm; font-size: 13.0pt">{{ slot_7 }}</p>
