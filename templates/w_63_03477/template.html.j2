<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

nav {
    background-color: #f8f8f8;
    padding: 20px;
}

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: space-between;
}

nav input[type="text"] {
    padding: 10px;
    border: none;
    border-radius: 5px;
}

.central-section {
    display: flex;
    justify-content: space-between;
    margin: 50px 0;
}

.highlight-box, .deals-box {
    width: 45%;
    padding: 20px;
}

.highlight-img, .deals-img {
    background-color: #ddd;
    height: 200px;
}

button {
    display: block;
    margin: 50px auto;
    padding: 10px 20px;
    background-color: #008CBA;
    color: #fff;
    border: none;
    border-radius: 5px;
}

footer {
    background-color: #333;
    color: #fff;
    padding: 50px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
</nav>
<div class="central-section">
<div class="highlight-box">
<h2>{{ slot_5 }}</h2>
<div class="highlight-img ph"></div>
<p>{{ slot_6 }}</p>
</div>
<div class="deals-box">
<h2>{{ slot_7 }}</h2>
<div class="deals-img ph"></div>
<p>{{ slot_8 }}</p>
</div>
<button>{{ slot_9 }}</button>
</div>
<footer>
<div class="reviews-box">
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>
<div class="contact-info">
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</footer>
</body>
</html>