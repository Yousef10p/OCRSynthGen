<div class="box ph" style="inset-inline-start: 67.3mm; inset-block-start: 96.6mm; inline-size: 76.7mm; block-size: 79.5mm; font-size: 9.6pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 184.9mm; inline-size: 164.5mm; block-size: 16.2mm; font-size: 10.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 49.1mm; inset-block-start: 211.6mm; inline-size: 140.8mm; block-size: 9.2mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 225.0mm; inline-size: 82.6mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_4 }}</p>
