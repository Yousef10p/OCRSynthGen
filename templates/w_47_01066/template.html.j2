* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
}

header {
    background-color: #f0f0f0;
    text-align: center;
    padding: 20px;
}

.content {
    display: flex;
    margin: 20px;
}

.content aside {
    width: 20%;
    background-color: #f0f0f0;
    padding: 20px;
}

.content main {
    width: 80%;
    background-color: #e0e0e0;
    padding: 20px;
}

.search input[type=text] {
    padding: 10px;
    width: 100%;
}

.feature-image {
    width: 100%;
    height: 200px;
    background-color: #008000;
    margin: 20px 0;
}

.design-element {
    position: absolute;
    top: 0;
    left: 0;
    width: 40%;
    height: 80%;
    background-image: none; 
    background-size: cover;
    background-position: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
