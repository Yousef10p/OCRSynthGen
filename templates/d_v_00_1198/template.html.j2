<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 14.0mm; inset-block-start: 9.4mm; inline-size: 1.5mm; block-size: 3.4mm; font-size: 9.8pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 14.0mm; inset-block-start: 13.5mm; inline-size: 27.3mm; block-size: 5.8mm; font-size: 8.3pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 204.0mm; inset-block-start: 33.0mm; inline-size: 3.0mm; block-size: 9.8mm; font-size: 27.9pt">{{ slot_2 }}</header><div class="box ph" style="inset-inline-start: 13.2mm; inset-block-start: 49.2mm; inline-size: 135.5mm; block-size: 232.0mm; font-size: 23.5pt"></div>
<header class="box" style="inset-inline-start: 204.0mm; inset-block-start: 85.0mm; inline-size: 3.0mm; block-size: 17.3mm; font-size: 16.4pt">{{ slot_3 }}</header><header class="box" style="inset-inline-start: 204.0mm; inset-block-start: 137.0mm; inline-size: 3.0mm; block-size: 38.6mm; font-size: 40.0pt">{{ slot_4 }}</header><header class="box" style="inset-inline-start: 204.0mm; inset-block-start: 189.0mm; inline-size: 3.0mm; block-size: 12.4mm; font-size: 35.2pt">{{ slot_5 }}</header><header class="box" style="inset-inline-start: 204.0mm; inset-block-start: 241.0mm; inline-size: 3.0mm; block-size: 21.3mm; font-size: 40.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 151.2mm; inset-block-start: 264.2mm; inline-size: 44.6mm; block-size: 7.6mm; font-size: 10.8pt">{{ slot_7 }}</p>
</div></body>
</html>
