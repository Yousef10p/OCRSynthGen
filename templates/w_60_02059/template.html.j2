<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    font-family: var(--font-body);
}

.sidenav {
    height: 100vh;
    width: 200px;
    position: fixed;
    background-color: #f8f9fa;
    overflow-x: hidden;
    padding-top: 20px;
}

.sidenav a {
    padding: 6px 16px 6px 8px;
    text-decoration: none;
    font-size: 25px;
    color: #212529;
    display: block;
}

.location-filter, .cuisine-filter {
    position: absolute;
    top: 150px;
    padding: 20px;
}

.featured-menu {
    column-count: 3;
    column-gap: 40px;
    margin-right: 240px;
}

.menu-item {
    margin-bottom: 40px;
    height: 200px;
}

.menu-item:nth-child(4n+1) {
    background-color: #ff6666;
}

.menu-item:nth-child(4n+2) {
    background-color: #99ccff;
}

.menu-item:nth-child(4n+3) {
    background-color: #ffcc33;
}

.menu-item:nth-child(4n+4) {
    background-color: #66ff66;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="sidenav">
<a>{{ slot_0 }}</a>
<a>{{ slot_1 }}</a>
</div>
<div class="location-filter">
<p>{{ slot_2 }}</p>
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
<a>{{ slot_8 }}</a>
</div>
<div class="cuisine-filter">
<p>{{ slot_9 }}</p>
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
</div>
<div class="featured-menu">
<div class="menu-item"></div>
<div class="menu-item"></div>
<div class="menu-item"></div>
<div class="menu-item"></div>
<div class="menu-item"></div>
<div class="menu-item"></div>
<div class="menu-item"></div>
<div class="menu-item"></div>
<div class="menu-item"></div>
</div>
</body>
</html>