<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 36.5mm; inline-size: 37.5mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 44.9mm; inline-size: 135.0mm; block-size: 12.6mm; font-size: 12.0pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 82.3mm; inset-block-start: 68.1mm; inline-size: 96.1mm; block-size: 4.9mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 84.2mm; inline-size: 135.0mm; block-size: 15.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 101.0mm; inline-size: 134.9mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 125.8mm; inline-size: 135.0mm; block-size: 30.0mm; font-size: 12.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 48.5mm; inset-block-start: 164.3mm; inline-size: 16.9mm; block-size: 4.2mm; font-size: 12.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.5mm; inset-block-start: 176.2mm; inline-size: 16.9mm; block-size: 4.2mm; font-size: 12.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.5mm; inset-block-start: 188.0mm; inline-size: 16.9mm; block-size: 4.2mm; font-size: 12.0pt"><li>{{ slot_7 }}</li></ul>
<p class="box" style="inset-inline-start: 43.4mm; inset-block-start: 200.7mm; inline-size: 135.0mm; block-size: 63.3mm; font-size: 12.0pt">{{ slot_8 }}</p>
