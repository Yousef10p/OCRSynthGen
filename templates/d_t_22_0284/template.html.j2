<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 27.6mm; inset-block-start: 1.9mm; inline-size: 92.9mm; block-size: 9.8mm; font-size: 27.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 15.3mm; inline-size: 133.1mm; block-size: 19.7mm; font-size: 11.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 35.9mm; inline-size: 133.2mm; block-size: 19.7mm; font-size: 11.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 8.1mm; inset-block-start: 55.7mm; inline-size: 132.2mm; block-size: 50.9mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 107.8mm; inline-size: 59.8mm; block-size: 5.4mm; font-size: 15.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 114.0mm; inline-size: 133.2mm; block-size: 27.3mm; font-size: 11.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 8.0mm; inset-block-start: 143.1mm; inline-size: 67.3mm; block-size: 5.4mm; font-size: 15.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 8.0mm; inset-block-start: 149.2mm; inline-size: 81.8mm; block-size: 38.7mm; font-size: 11.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 91.5mm; inset-block-start: 150.3mm; inline-size: 50.4mm; block-size: 38.9mm; font-size: 15.7pt"></div>
</div></body>
</html>
