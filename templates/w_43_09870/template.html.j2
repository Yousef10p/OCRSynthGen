    padding: 10px;
    color: #fff;
}

header ul {
    display: flex;
    justify-content: flex-end;
    list-style: none;
    padding: 0;
}

header li {
    margin: 0 10px;
}

header a {
    color: #fff;
    text-decoration: none;
}

#slider {
    height: 100vh;
