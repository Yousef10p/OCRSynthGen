<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.0mm; inset-block-start: 50.4mm; inline-size: 132.6mm; block-size: 33.3mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 92.9mm; inline-size: 129.1mm; block-size: 21.8mm; font-size: 20.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 117.7mm; inline-size: 25.3mm; block-size: 2.9mm; font-size: 8.2pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 19.7mm; inset-block-start: 136.9mm; inline-size: 58.6mm; block-size: 64.8mm; font-size: 18.4pt"></div>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 137.4mm; inline-size: 99.3mm; block-size: 16.1mm; font-size: 15.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 155.4mm; inline-size: 100.5mm; block-size: 48.9mm; font-size: 15.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 206.2mm; inline-size: 98.4mm; block-size: 9.4mm; font-size: 13.3pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 19.7mm; inset-block-start: 211.3mm; inline-size: 53.6mm; block-size: 52.3mm; font-size: 18.5pt"></div>
<p class="box" style="inset-inline-start: 90.0mm; inset-block-start: 227.7mm; inline-size: 100.1mm; block-size: 44.3mm; font-size: 15.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 266.6mm; inline-size: 49.1mm; block-size: 10.0mm; font-size: 9.4pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 8.0mm; inset-block-start: 284.6mm; inline-size: 59.8mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
