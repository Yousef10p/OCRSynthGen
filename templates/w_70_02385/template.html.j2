* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: #333;
}
body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 50px;
}
h1, h2, h3 {
    margin-bottom: 20px;
}
p {
    margin-bottom: 30px;
    line-height: 1.5;
}
ul {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 50px;
}
nav > ul > li {
    list-style-type: none;
}
nav > ul > li > a {
    text-decoration: none;
    color: #333;
}

.project-img {
    width: 200px;
    height: 200px;
    background-color: #ccc;
    margin-bottom: 20px;
}


form {
    display: flex;
    flex-direction: column;
}
input, textarea, button {
    margin-bottom: 20px;
    padding: 10px;
    border: 1px solid #ccc;
}
button {
    background-color: #333;
    color: #fff;
    cursor: pointer;
}


@media screen and (max-width: 600px) {
    body {
        padding: 20px;
    }
    .project {
        width: 100%;
        text-align: center;
    }
    .project-img {
        width: 100%;
        margin-bottom: 30px;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
