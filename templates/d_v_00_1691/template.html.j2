<ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 92.3mm; inline-size: 151.7mm; block-size: 6.0mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 102.1mm; inline-size: 160.2mm; block-size: 10.5mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 113.3mm; inline-size: 159.2mm; block-size: 41.8mm; font-size: 10.0pt">{{ slot_6 }}</p>
