<p class="box" style="inset-inline-start: 36.5mm; inset-block-start: 74.1mm; inline-size: 141.2mm; block-size: 41.9mm; font-size: 19.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 36.5mm; inset-block-start: 120.0mm; inline-size: 62.0mm; block-size: 34.2mm; font-size: 19.4pt">{{ slot_5 }}</p>
