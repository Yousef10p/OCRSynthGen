<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</li>
</ul>
</nav>
</header>
<div class="banner">
<p class="banner-text">{{ slot_9 }}</p>
</div>
<main>
