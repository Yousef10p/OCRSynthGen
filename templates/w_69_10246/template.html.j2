}
  
#dest3 {
    background: none no-repeat center center/cover;
}
  
form {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0 20%;
}
  
form input, form textarea {
    margin: 10px 0;
    padding: 10px;
    border: 1px solid #333;
}
  
footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    text-align: center;
    background: #333;
    color: #fff;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
