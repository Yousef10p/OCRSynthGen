<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #fff;
}
#hero {
    height: 50vh;
    width: 100%;
    background-color: #964B00;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}
#hero .overlay {
    text-align: center;
}
#hero h1 {
    font-size: 4em;
    margin: 0;
}
#hero p {
    font-size: 2em;
}
a.btn {
    display: inline-block;
    padding: 10px 20px;
    background-color: #CF6736;
    color: #fff;
    text-decoration: none;
    margin-top: 20px;
}
#menu, #events, #reserve {
    padding: 50px;
    text-align: center;
}
#menu h2, #events h2, #reserve h2 {
    font-size: 3em;
}
#menu ul {
    list-style: none;
    padding: 0;
}
#menu ul li {
    font-size: 1.5em;
}
#reserve form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin: 30px 0;
}
#reserve form input, #reserve form textarea {
    padding: 10px;
    border: none;
}
#reserve form input[type="submit"] {
    background-color: #CF6736;
    color: #fff;
    cursor: pointer;
}
#reserve h3, #reserve p {
    font-size: 1.5em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
