</div>
</div>
<div id="menu">
<h2>{{ slot_3 }}</h2>
<ul>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
</div>
<div id="events">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<a class="btn">{{ slot_9 }}</a>
</div>
<div id="reserve">
<h2>{{ slot_10 }}</h2>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_12 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_13 }}</span>
<span class="btn">{{ slot_14 }}</span>
