<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}


#header {
    background: none center no-repeat;
    background-size: cover;
    text-align: center;
    padding: 20px;
}

#logo {
    font-size: 2em;
    color: white;
}

nav ul {
    list-style-type: none;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

form {
    margin: 10px 0;
}

form input {
    padding: 5px;
}


#popular {
    margin: 20px;
}

h2 {
    font-size: 1.5em;
    margin-bottom: 10px;
}

.destination, .accommodation, .activity {
    background: #f1f1f1;
    padding: 10px;
    margin: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<div id="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
</form>
</div>
<div id="popular">
<h2>{{ slot_6 }}</h2>
<div class="destination">{{ slot_7 }}</div>
<div class="destination">{{ slot_8 }}</div>
<h2>{{ slot_9 }}</h2>
<div class="accommodation">{{ slot_10 }}</div>
<div class="accommodation">{{ slot_11 }}</div>
<h2>{{ slot_12 }}</h2>
<div class="activity">{{ slot_13 }}</div>
<div class="activity">{{ slot_14 }}</div>
</div>
</body>
</html>