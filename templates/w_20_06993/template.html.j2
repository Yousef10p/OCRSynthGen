</div>
<div class="menu">
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
</div>
<div class="sections">
<div class="section">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<button>{{ slot_8 }}</button>
</div>
