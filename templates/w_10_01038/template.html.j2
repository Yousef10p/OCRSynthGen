<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: #333;
}

ul {
    list-style: none;
}

.grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
}


header#showcase {
    height: 50vh;
    color: #fff;
    text-align: center;
}

header#showcase .bg-image {
    position: absolute;
    background: none no-repeat center center/cover; 
    height: 100%;
    width: 100%;
    z-index: -1;
    opacity: 0.3;
}

header#showcase .content-wrap {
    z-index: 2;
    align-self: center;
}

header#showcase .content-wrap h1 {
    font-size: 50px;
}

header#showcase .btn {
    display: inline-block;
    background: #333;
    color: #fff;
    padding: 10px 20px;
    border: #fff 1px solid;
    margin-top: 25px;
}

header#showcase .btn:hover {
    background: #f4f4f4;
    color: #333;
}


footer#main-footer {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 20px;
}

footer#main-footer a {
    color: #f4f4f4;
}


#section-a .content-wrap {
    grid-column: 1 / 3;
}


#section-b ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
}

#section-b .card-content {
    background: #f4f4f4;
}


#section-c .content-wrap {
    grid-column: 2;
    grid-row: 1;
}


#section-d .box {
    grid-column: 1 / 3;
    background: #f4f4f4;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>

