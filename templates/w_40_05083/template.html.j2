}


.footer-section {
    padding: 20px;
    background: #333;
    color: white;
    display: flex;
    justify-content: space-between;
}

.contact-info, .services-links {
    width: 45%;
}

.contact-info {
    text-align: left;
}

ul {
    list-style-type: none;
    padding: 0;
}

ul li a {
    color: white;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
