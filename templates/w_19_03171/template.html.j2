<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

header, footer {
    background-color: #F7F7F7;
    padding: 20px;
    text-align: center;
}

input[type="text"] {
    width: 80%;
    height: 30px;
    margin: 20px 0;
}

#banner {
    background-color: #D3D3D3;
    padding: 20px;
    text-align: center;
}

main {
    padding: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.restaurant, .filter {
    background-color: #C0C0C0;
    padding: 20px;
    margin: 10px;
    text-align: center;
}

footer a {
    color: #000;
    text-decoration: none;
    margin: 0 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
</header>
<main>
<section id="banner">
<h2>{{ slot_1 }}</h2>
</section>
<h2>{{ slot_2 }}</h2>
<section id="restaurants">
<div class="restaurant">{{ slot_3 }}</div>
<div class="restaurant">{{ slot_4 }}</div>
<div class="restaurant">{{ slot_5 }}</div>
</section>
<h2>{{ slot_6 }}</h2>
<section id="filters">
<div class="filter">{{ slot_7 }}</div>
<div class="filter">{{ slot_8 }}</div>
<div class="filter">{{ slot_9 }}</div>
</section>
</main>
<footer>
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</footer>
</body>
</html>