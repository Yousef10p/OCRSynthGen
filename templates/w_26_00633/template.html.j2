<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
font-family: var(--font-body);
margin: 0;
padding: 0;
}

header {
background-color: #ddd;
display: flex;
justify-content: space-between;
align-items: center;
padding: 20px;
}

.hero {
background-color: #f9f9f9;
padding: 50px;
display: flex;
flex-direction: column;
align-items: center;
text-align: center;
}

.testimonials {
display: grid;
grid-template-columns: 1fr 1fr 1fr;
grid-gap: 20px;
padding: 20px;
}

.destinations {
display: grid;
grid-template-columns: 1fr 1fr 1fr;
grid-gap: 20px;
padding: 20px;
}

.testimonial, .destination {
border: 1px solid #ddd;
padding: 20px;
}

button.cta {
background-color: #ff0000;
color: #fff;
border: none;
padding: 10px 20px;
text-decoration: none;
}

button.cta:hover {
background-color: #bb0000;
}

.destination p {
background-color: #ddd;
width: 100px;
height: 100px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1><a>{{ slot_0 }}</a></h1>
<button class="cta">{{ slot_1 }}</button>
</header>
<section class="hero">
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<button>{{ slot_4 }}</button>
</section>
<section class="testimonials">
<h2>{{ slot_5 }}</h2>
<div class="testimonial">
<p>{{ slot_6 }}</p>
</div>
<div class="testimonial">
<p>{{ slot_7 }}</p>
</div>
<div class="testimonial">
<p>{{ slot_8 }}</p>
</div>
</section>
<section class="destinations">
<h2>{{ slot_9 }}</h2>
<div class="destination">
<p>{{ slot_10 }}</p>
<h3>{{ slot_11 }}</h3>
</div>
<div class="destination">
<p>{{ slot_12 }}</p>
<h3>{{ slot_13 }}</h3>
</div>
<div class="destination">
<p>{{ slot_14 }}</p>
<h3>{{ slot_15 }}</h3>
</div>
</section>
</body>
</html>