<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 118.2mm; inline-size: 152.4mm; block-size: 20.7mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 35.7mm; inset-block-start: 148.6mm; inline-size: 148.5mm; block-size: 17.9mm; font-size: 12.0pt"></div>
