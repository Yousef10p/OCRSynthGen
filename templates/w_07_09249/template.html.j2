  text-align: center;
  padding: 20px;
  margin-top: 50px;
}

footer a {
  color: white;
  text-decoration: none;
  margin-left: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
