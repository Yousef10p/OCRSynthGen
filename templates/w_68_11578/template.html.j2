  }
  
  .header-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .header-links a {
    margin: 5px 0;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
