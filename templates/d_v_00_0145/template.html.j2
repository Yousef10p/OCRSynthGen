<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 200.6mm; inset-block-start: 8.4mm; inline-size: 1.2mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 24.3mm; inline-size: 39.5mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 22.3mm; inset-block-start: 29.5mm; inline-size: 181.9mm; block-size: 23.1mm; font-size: 10.9pt"></div>
<h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 59.3mm; inline-size: 30.5mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 22.6mm; inset-block-start: 65.4mm; inline-size: 182.2mm; block-size: 23.1mm; font-size: 10.9pt"></div>
<h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 216.3mm; inline-size: 36.7mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_3 }}</h2>
<div class="box ph" style="inset-inline-start: 21.7mm; inset-block-start: 220.9mm; inline-size: 180.5mm; block-size: 31.7mm; font-size: 22.5pt"></div>
<h2 class="box" style="inset-inline-start: 22.5mm; inset-block-start: 257.3mm; inline-size: 37.4mm; block-size: 3.0mm; font-size: 8.6pt">{{ slot_4 }}</h2>
<div class="box ph" style="inset-inline-start: 21.9mm; inset-block-start: 261.6mm; inline-size: 180.3mm; block-size: 28.6mm; font-size: 27.0pt"></div>
</div></body>
</html>
