<h1>{{ slot_0 }}</h1>
</header>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div class="main-section">
<div class="recipes">
<h2>{{ slot_4 }}</h2>
<div class="recipe">
<h3>{{ slot_5 }}</h3>
<p>{{ slot_6 }}</p>
<div class="recipe-image" style="background-color:orange;">{{ slot_7 }}</div> 
</div>
<div class="recipe">
<h3>{{ slot_8 }}</h3>
<p>{{ slot_9 }}</p>
<div class="recipe-image" style="background-color:green;">{{ slot_10 }}</div> 
</div>
</div>
<div class="cook-tech">
<h2>{{ slot_11 }}</h2>
<div class="tech">
