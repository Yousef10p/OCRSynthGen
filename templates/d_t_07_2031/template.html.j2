<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 54.4mm; inline-size: 86.8mm; block-size: 63.7mm; font-size: 12.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 54.4mm; inline-size: 87.7mm; block-size: 64.3mm; font-size: 13.0pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 122.7mm; inline-size: 61.0mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 121.5mm; inline-size: 86.8mm; block-size: 41.1mm; font-size: 12.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 129.3mm; inline-size: 86.0mm; block-size: 54.5mm; font-size: 12.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 165.4mm; inline-size: 87.9mm; block-size: 31.8mm; font-size: 12.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 186.6mm; inline-size: 88.4mm; block-size: 54.5mm; font-size: 12.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 107.9mm; inset-block-start: 200.1mm; inline-size: 86.6mm; block-size: 41.1mm; font-size: 12.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 269.5mm; inline-size: 27.9mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
