<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</div>
<div id="hero">
<h1>{{ slot_3 }}</h1>
<a class="cta">{{ slot_4 }}</a>
</div>
<div id="main_content">
<h2 id="laptops">{{ slot_5 }}</h2>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<h2 id="smartphones">{{ slot_8 }}</h2>
<div class="product">{{ slot_9 }}</div>
<div class="product">{{ slot_10 }}</div>
<h2 id="headphones">{{ slot_11 }}</h2>
<div class="product">{{ slot_12 }}</div>
<div class="product">{{ slot_13 }}</div>
</div>
<div id="footer">
<ul>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
<li><a>{{ slot_16 }}</a></li>
</ul>
</div>
</body>
</html>