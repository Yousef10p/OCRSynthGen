<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 12.7mm; inline-size: 18.5mm; block-size: 5.0mm; font-size: 10.5pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 17.0mm; inset-block-start: 23.9mm; inline-size: 88.8mm; block-size: 6.2mm; font-size: 13.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 34.2mm; inline-size: 160.6mm; block-size: 5.0mm; font-size: 10.5pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 18.9mm; inset-block-start: 43.7mm; inline-size: 10.8mm; block-size: 15.6mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 64.7mm; inline-size: 176.0mm; block-size: 16.2mm; font-size: 10.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 85.6mm; inline-size: 176.0mm; block-size: 16.2mm; font-size: 10.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 17.0mm; inset-block-start: 108.0mm; inline-size: 54.7mm; block-size: 6.2mm; font-size: 13.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 118.3mm; inline-size: 176.0mm; block-size: 10.6mm; font-size: 10.5pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 17.9mm; inset-block-start: 133.5mm; inline-size: 14.1mm; block-size: 13.6mm; font-size: 12.9pt"></div>
<p class="box" style="inset-inline-start: 17.0mm; inset-block-start: 152.5mm; inline-size: 176.0mm; block-size: 21.7mm; font-size: 10.5pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 187.3mm; inset-block-start: 288.5mm; inline-size: 5.3mm; block-size: 4.3mm; font-size: 9.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
