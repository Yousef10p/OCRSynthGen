<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 196.2mm; inline-size: 84.4mm; block-size: 8.7mm; font-size: 12.3pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 196.2mm; inline-size: 88.9mm; block-size: 53.8mm; font-size: 12.7pt">{{ slot_5 }}</p>
