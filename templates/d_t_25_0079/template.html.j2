<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 27.4mm; inset-block-start: 18.3mm; inline-size: 32.6mm; block-size: 6.0mm; font-size: 16.9pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 71.4mm; inset-block-start: 19.8mm; inline-size: 23.4mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 105.7mm; inset-block-start: 19.7mm; inline-size: 26.8mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_2 }}</header><header class="box" style="inset-inline-start: 150.8mm; inset-block-start: 19.2mm; inline-size: 35.9mm; block-size: 4.7mm; font-size: 13.5pt">{{ slot_3 }}</header><div class="box ph" style="inset-inline-start: 38.1mm; inset-block-start: 95.6mm; inline-size: 141.5mm; block-size: 90.9mm; font-size: 13.6pt"></div>
<p class="box" style="inset-inline-start: 97.1mm; inset-block-start: 195.1mm; inline-size: 21.3mm; block-size: 4.5mm; font-size: 12.9pt">{{ slot_4 }}</p>
</div></body>
</html>
