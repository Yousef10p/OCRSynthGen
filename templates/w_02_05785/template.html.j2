<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: var(--font-body);
}

#main {
    width: 80%;
    height: 80%;
    display: grid;
    grid-template-columns: 1fr 3fr;
    grid-template-rows: 1fr 3fr 1fr;
    gap: 10px;
}

#logo {
    background-color: red;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2em;
    grid-column: 1 / span 2;
}

#categories {
    background-color: blue;
    color: white;
}

#search {
    grid-row: 2;
    grid-column: 2;
    padding: 10px;
}

#content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 10px;
    grid-column: 2;
    grid-row: 3;
}

.product {
    background-color: red;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.5em;
}

#social {
    background-color: blue;
    color: white;
    grid-row: 2;
    grid-column: 1;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="main">
<div id="logo">{{ slot_0 }}</div>
<div id="categories">
<h3>{{ slot_1 }}</h3>
<ul>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
<div id="search">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_6 }}</span>
</div>
<div id="content">
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
<div class="product">{{ slot_9 }}</div>
<div class="product">{{ slot_10 }}</div>
<div class="product">{{ slot_11 }}</div>
<div class="product">{{ slot_12 }}</div>

</div>
<div id="social">
<h3>{{ slot_13 }}</h3>
<ul>
<li>{{ slot_14 }}</li>
<li>{{ slot_15 }}</li>
<li>{{ slot_16 }}</li>
<li>{{ slot_17 }}</li>
</ul>
</div>
</div>
</body>
</html>