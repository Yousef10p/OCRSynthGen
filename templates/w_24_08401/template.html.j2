<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, header, aside, main {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}


header {
  position: relative;
}
.hero-image {
  height: 200px;
  background-color: lightblue;
  color: white;
  text-align: center;
  font-size: 2em;
  padding: 20px;
}
.call-to-action {
  position: absolute;
  left: 20px;
  top: 20px;
  background-color: blue;
  color: white;
  border: none;
  padding: 10px 20px;
}


aside {
  width: 200px;
  padding: 20px;
  position: absolute;
}
.left-sidebar {
  right: 0;
  background-color: lavender;
}
.right-sidebar {
  left: 0;
  background-color: lavenderblush;
}


main {
  margin-right: 220px;
  margin-left: 220px;
  padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="hero-image">{{ slot_0 }}</div>
<button class="call-to-action">{{ slot_1 }}</button>
</header>
<aside class="left-sidebar">
<h2>{{ slot_2 }}</h2>
<ul>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</aside>
<main>
<p>{{ slot_6 }}</p>
</main>
<aside class="right-sidebar">
<h2>{{ slot_7 }}</h2>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
<h2>{{ slot_11 }}</h2>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</aside>
</body>
</html>