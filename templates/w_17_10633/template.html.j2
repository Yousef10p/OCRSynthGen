<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  color: #000;
  background-color: #FFF;
}

#main-menu {
  position: fixed;
  top: 0;
  left: 0;
  background-color: #FF0000; 
}

#main-menu span {
  color: #FFF; 
  display: block;
  padding: 10px;
  cursor: pointer;
}

#carousel {
  height: 150px;
  background-color: #FFFF00; 
  overflow-x: scroll;
  white-space: nowrap;
}

#carousel .slide {
  display: inline-block;
  height: 150px;
  width: 240px;
  background-color: #FFF; 
  color: #000; 
  margin: 0 10px;
  padding: 10px;
  white-space: normal;
}

#menu {
  margin-top: 170px; 
  column-count: 2;
}

#menu .dish {
  padding: 10px;
  break-inside: avoid; 
  background-color: #FF0000; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="main-menu">
<span>{{ slot_0 }}</span>
<span>{{ slot_1 }}</span>
<span>{{ slot_2 }}</span>
</div>
<div id="carousel">
<div class="slide">{{ slot_3 }}</div>
<div class="slide">{{ slot_4 }}</div>
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
</div>
<div id="menu">
<div class="dish">
<p>{{ slot_7 }}</p>
<p>{{ slot_8 }}</p>
</div>
<div class="dish">
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>
</div>
<div class="dish">
<p>{{ slot_11 }}</p>
<p>{{ slot_12 }}</p>
</div>
<div class="dish">
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>