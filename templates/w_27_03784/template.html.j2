<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
</ul>

<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<span class="">{{ slot_5 }}</span>
</form>

<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>

<div id="right-column">

<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<p>{{ slot_10 }}</p>

<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>

<h2>{{ slot_13 }}</h2>
<ul>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
<li><a>{{ slot_16 }}</a></li>
</ul>
</div>
</div> 
</body>
</html>