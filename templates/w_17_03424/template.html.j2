<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    background-color: #f5f5f5;
}

.header-image {
    width: 100%;
    height: 200px;
    background-color: pink;
}

.container {
    display: flex;
}

.col1 {
    width: 30%;
    padding: 20px;
}

.col2 {
    width: 70%;
    padding: 20px;
}

form, .col1 h2 {
    font-family: var(--font-heading);
}

input, textarea, button {
    width: 100%;
    margin: 10px 0;
}

article, ul {
    font-family: var(--font-body);
}

ul {
    list-style-type: none;
    padding: 0;
}

li > a {
    background-color: #f5f5f5;
    display: block;
    padding: 10px;
    margin-bottom: 5px;
    text-decoration: none;
    color: black;
}

a:hover {
    text-decoration: underline;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="header-image ph"></div>
</header>
<div class="container">
<div class="col1">
<h2>{{ slot_0 }}</h2>
<p>{{ slot_1 }}</p>
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<h2>{{ slot_4 }}</h2>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_6 }}</span>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_7 }}</span>
<button>{{ slot_8 }}</button>
</form>
</div>
<div class="col2">
<h2>{{ slot_9 }}</h2>
<article>
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</article>
<h2>{{ slot_12 }}</h2>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</div>
</div>
</body>
</html>