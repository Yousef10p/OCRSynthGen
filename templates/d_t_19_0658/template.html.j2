<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 34.5mm; inset-block-start: 24.4mm; inline-size: 31.4mm; block-size: 6.5mm; font-size: 18.5pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 34.5mm; inset-block-start: 41.1mm; inline-size: 69.5mm; block-size: 18.0mm; font-size: 25.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 94.9mm; inline-size: 141.0mm; block-size: 31.5mm; font-size: 17.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 127.2mm; inline-size: 141.3mm; block-size: 31.4mm; font-size: 17.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 159.5mm; inline-size: 141.1mm; block-size: 18.4mm; font-size: 17.3pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 67.5mm; inset-block-start: 202.7mm; inline-size: 76.5mm; block-size: 34.1mm; font-size: 24.2pt"></div>
<p class="box" style="inset-inline-start: 62.7mm; inset-block-start: 240.7mm; inline-size: 84.7mm; block-size: 5.8mm; font-size: 16.5pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 103.8mm; inset-block-start: 264.3mm; inline-size: 3.8mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
