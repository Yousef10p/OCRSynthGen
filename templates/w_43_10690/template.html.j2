    padding: 0;
    text-align: center;
}
nav ul li {
    display: inline-block;
    margin: 0 10px;
}
nav ul li a {
    color: white;
}


#columns {
    display: flex;
    justify-content: space-between;
}
#features, #advice {
    width: 45%;
    padding: 20px;
}


footer {
    background: red;
