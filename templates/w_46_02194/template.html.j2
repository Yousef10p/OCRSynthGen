<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	font-family: var(--font-body);
	margin: 0;
	padding: 0;
	background: #f4f4f4;
}


nav {
	background: #333;
	color: #fff;
	padding: 10px 0;
	text-align: center;
}

nav ul {
	list-style: none;
}

nav ul li {
	display: inline;
	margin: 0 20px;
}

nav ul li a {
	color: #fff;
	text-decoration: none;
}


#latest-games, #ticket-availability, #roster, #player-stats {
	float: right;
	width: 25%;
	padding: 10px;
}

#logo {
	width: 100%;
	text-align: center;
	font-size: 2em;
}

.game, .player, .ticket, .stats {
	margin: 10px;
	padding: 5px;
	background: #ddd;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div id="logo">{{ slot_4 }}</div>
<div class="main">
<div id="latest-games">
<h2>{{ slot_5 }}</h2>
<div class="game">{{ slot_6 }}</div>
<div class="game">{{ slot_7 }}</div>
</div>
<div id="ticket-availability">
<h2>{{ slot_8 }}</h2>
<div>{{ slot_9 }}</div>
<div>{{ slot_10 }}</div>
</div>
<div id="roster">
<h2>{{ slot_11 }}</h2>
<div class="player">{{ slot_12 }}</div>
<div class="player">{{ slot_13 }}</div>
</div>
<div id="player-stats">
<h2>{{ slot_14 }}</h2>
<div>{{ slot_15 }}</div>
<div>{{ slot_16 }}</div>
</div>
</div>
</body>
</html>