<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 104.7mm; inset-block-start: 10.4mm; inline-size: 3.8mm; block-size: 3.1mm; font-size: 8.7pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 20.7mm; inset-block-start: 20.4mm; inline-size: 172.0mm; block-size: 14.4mm; font-size: 20.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.9mm; inset-block-start: 38.3mm; inline-size: 172.2mm; block-size: 75.8mm; font-size: 23.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.2mm; inset-block-start: 118.2mm; inline-size: 30.9mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.2mm; inset-block-start: 126.0mm; inline-size: 157.2mm; block-size: 31.8mm; font-size: 22.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 21.8mm; inset-block-start: 161.4mm; inline-size: 172.2mm; block-size: 75.4mm; font-size: 23.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 32.1mm; inset-block-start: 240.8mm; inline-size: 30.9mm; block-size: 4.7mm; font-size: 13.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 32.2mm; inset-block-start: 248.6mm; inline-size: 157.1mm; block-size: 31.9mm; font-size: 22.6pt">{{ slot_7 }}</p>
</div></body>
</html>
