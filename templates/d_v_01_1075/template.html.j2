<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.2mm; inset-block-start: 16.2mm; inline-size: 176.3mm; block-size: 159.2mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 13.6mm; inset-block-start: 178.3mm; inline-size: 78.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 13.4mm; inset-block-start: 186.4mm; inline-size: 86.3mm; block-size: 39.6mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 103.0mm; inset-block-start: 186.8mm; inline-size: 86.3mm; block-size: 49.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 229.0mm; inline-size: 41.1mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 103.4mm; inset-block-start: 238.5mm; inline-size: 46.2mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 10.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_3 }}</footer>
</div></body>
</html>
