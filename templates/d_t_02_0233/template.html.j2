<ul class="box" style="inset-inline-start: 75.6mm; inset-block-start: 179.3mm; inline-size: 94.4mm; block-size: 17.0mm; font-size: 16.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 75.6mm; inset-block-start: 204.7mm; inline-size: 73.2mm; block-size: 4.3mm; font-size: 12.1pt"><li>{{ slot_5 }}</li></ul>
