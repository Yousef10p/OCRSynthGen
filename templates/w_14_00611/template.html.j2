    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 1em;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    color: white;
}

.left-column {
    background-color: #f44336;
}

.middle-column {
    background-color: #2196F3;
}

.right-column {
    background-color: #4CAF50;
}

form {
    display: flex;
    flex-direction: column;
}

input, button {
    margin-top: 1em;
    padding: 0.5em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
