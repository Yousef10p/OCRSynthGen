<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 123.7mm; inline-size: 33.3mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 129.5mm; inline-size: 83.3mm; block-size: 29.3mm; font-size: 13.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 112.2mm; inset-block-start: 137.4mm; inline-size: 84.7mm; block-size: 24.0mm; font-size: 13.6pt">{{ slot_6 }}</p>
