<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: flex;
  font-family: var(--font-body);
}


.sidebar {
  width: 200px;
  margin-left: 20px;
}

.sidebar h2 {
  font-size: 1.2em;
}

.slide {
  background: #eee;
  padding: 10px;
  margin-bottom: 10px;
  text-align: center;
}


.content {
  width: 80%;
}

.content h1 {
  font-size: 2em;
}

.content h2 {
  font-size: 1.5em;  
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.box {
  background: #eee;
  padding: 10px;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<aside class="sidebar">
<h2>{{ slot_0 }}</h2>
<div class="slide">{{ slot_1 }}</div>
<h2>{{ slot_2 }}</h2>
<div class="slide">{{ slot_3 }}</div>
</aside>
<main class="content">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<h2>{{ slot_6 }}</h2>
<div class="grid">
<div class="box">{{ slot_7 }}</div>
<div class="box">{{ slot_8 }}</div>
<div class="box">{{ slot_9 }}</div>
<div class="box">{{ slot_10 }}</div>
</div>
<h2>{{ slot_11 }}</h2>
<div class="grid">
<div class="box">{{ slot_12 }}</div>
<div class="box">{{ slot_13 }}</div>
<div class="box">{{ slot_14 }}</div>
</div>
</main>
</body>
</html>