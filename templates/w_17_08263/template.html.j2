    text-align: center;
    font-size: 3em;
    padding: 1em;
    background-color: #f1c40f;
    color: white;
    width: 100%;
}

nav {
    display: flex;
    justify-content: space-around;
    width: 100%;
    padding: 1em 0;
    background-color: #3498db;
    color: white;
}

nav a {
    color: white;
    text-decoration: none;
}

#searchbar {
    margin: 1em 0;
    width: 80%;
    padding: 0.5em;
    font-size: 1.2em;
}

main {
    display: flex;
    width: 100%;
    padding: 2em;
}

main section {
    width: 70%;
    padding-left: 2em;
}

main aside {
    width: 30%;
    padding-right: 2em;
    border-right: 1px solid #bdc3c7;
}

.courseimage {
    height: 150px;
