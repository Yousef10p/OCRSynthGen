.ph { background: #d0d0d0; }

body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

header, #main, aside, footer {
  width: 80%;
  margin: 20px;
}

header {
  display: flex;
  justify-content: space-between;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.product {
  height: 200px;
  background-color: lightgray;
}

aside ul {
  list-style-type: none;
  padding: 0;
}

footer {
  display: flex;
  justify-content: space-between;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
