  padding: 10px 20px;
  border: none;
  cursor: pointer;
}

.products, .materials, .blog, .consultation {
  padding: 20px;
  margin: 0 auto;
  max-width: 800px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
