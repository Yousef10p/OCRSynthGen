<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 51.7mm; inset-block-start: 7.0mm; inline-size: 44.6mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 16.4mm; inline-size: 60.9mm; block-size: 4.5mm; font-size: 12.8pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 24.5mm; inline-size: 32.8mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 33.1mm; inline-size: 107.8mm; block-size: 19.1mm; font-size: 10.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 55.3mm; inline-size: 27.4mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_4 }}</h2>
<ul class="box" style="inset-inline-start: 17.6mm; inset-block-start: 63.3mm; inline-size: 114.2mm; block-size: 34.4mm; font-size: 10.8pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.6mm; inset-block-start: 101.6mm; inline-size: 113.9mm; block-size: 15.2mm; font-size: 10.8pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 17.6mm; inset-block-start: 120.8mm; inline-size: 113.4mm; block-size: 11.4mm; font-size: 10.8pt"><li>{{ slot_7 }}</li></ul>
