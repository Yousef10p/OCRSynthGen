<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 143.9mm; inline-size: 108.4mm; block-size: 22.9mm; font-size: 10.8pt">{{ slot_9 }}</p>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 170.5mm; inline-size: 24.1mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_10 }}</h2>
<p class="box" style="inset-inline-start: 23.9mm; inset-block-start: 178.5mm; inline-size: 107.9mm; block-size: 11.4mm; font-size: 10.8pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 68.5mm; inset-block-start: 196.7mm; inline-size: 4.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_12 }}</footer>
</div></body>
</html>
