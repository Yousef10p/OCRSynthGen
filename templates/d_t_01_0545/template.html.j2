<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 56.4mm; inset-block-start: 33.4mm; inline-size: 130.7mm; block-size: 40.9mm; font-size: 16.6pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 56.4mm; inset-block-start: 76.9mm; inline-size: 127.0mm; block-size: 47.1mm; font-size: 16.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 28.4mm; inset-block-start: 83.8mm; inline-size: 19.4mm; block-size: 21.4mm; font-size: 12.1pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 56.4mm; inset-block-start: 126.7mm; inline-size: 127.6mm; block-size: 34.7mm; font-size: 16.4pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 201.2mm; inset-block-start: 146.4mm; inline-size: 1.4mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 56.4mm; inset-block-start: 164.1mm; inline-size: 131.1mm; block-size: 40.9mm; font-size: 16.6pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 28.4mm; inset-block-start: 170.9mm; inline-size: 18.4mm; block-size: 12.0mm; font-size: 11.4pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 56.4mm; inset-block-start: 207.6mm; inline-size: 125.6mm; block-size: 47.1mm; font-size: 16.7pt">{{ slot_7 }}</p>
</div></body>
</html>
