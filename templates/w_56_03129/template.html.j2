    background-color: #ddd;
}

.overlay {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    text-align: center;
    color: white;
}


.sidebar {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 200px;
    background-color: #eee;
}


