<div class="box ph" style="inset-inline-start: 66.2mm; inset-block-start: 69.4mm; inline-size: 125.2mm; block-size: 45.1mm; font-size: 18.3pt"></div>
<p class="box" style="inset-inline-start: 66.7mm; inset-block-start: 118.2mm; inline-size: 120.0mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_4 }}</p>
