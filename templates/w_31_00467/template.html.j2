  margin: 0 5px;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-size: 1.5em;
  text-align: center;
}

section {
  padding: 20px;
  line-height: 1.5em;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
