  padding: 20px;
  position: sticky;
  top: 0;
}

h1 {
  margin: 0;
}

nav ul {
  list-style-type: none;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
}

nav li {
  margin: 0 10px;
}

nav a {
  color: black;
  text-decoration: none;
}

#slider .slider-content {
  display: flex;
