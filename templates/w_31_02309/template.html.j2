    text-decoration: none;
    color: #333;
}

.article, .blog-image, #newsletter {
    margin: 2rem;
}

.article p, #newsletter p {
    line-height: 1.5;
}

.article-image, .blog-image {
    width: 100%;
    height: 20rem;
    background-color: #ccc;
    margin: 1rem 0;
}

form {
    display: flex;
    flex-direction: column;
    max-width: 20rem;
}

form input, form button {
    margin: 0.5rem 0;
    padding: 0.5rem;
}

form button {
    cursor: pointer;
}

@media only screen and (min-width: 768px) {
    #articles {
        display: flex;
        justify-content: center;
    }

    .article {
        flex: 1;
        margin: 1rem;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
