<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 18.3mm; inset-block-start: 12.6mm; inline-size: 71.7mm; block-size: 57.0mm; font-size: 14.7pt"></div>
<div class="box ph" style="inset-inline-start: 114.5mm; inset-block-start: 14.8mm; inline-size: 75.5mm; block-size: 72.8mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 74.6mm; inline-size: 90.0mm; block-size: 7.8mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 88.7mm; inline-size: 90.0mm; block-size: 8.4mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 122.8mm; inset-block-start: 90.3mm; inline-size: 59.2mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 18.6mm; inset-block-start: 101.0mm; inline-size: 72.5mm; block-size: 109.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 107.4mm; inset-block-start: 100.1mm; inline-size: 90.0mm; block-size: 22.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 107.4mm; inset-block-start: 124.9mm; inline-size: 92.4mm; block-size: 90.9mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 214.3mm; inline-size: 89.9mm; block-size: 20.7mm; font-size: 10.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 107.4mm; inset-block-start: 218.5mm; inline-size: 90.0mm; block-size: 58.8mm; font-size: 12.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 10.5mm; inset-block-start: 241.4mm; inline-size: 90.0mm; block-size: 35.9mm; font-size: 12.0pt">{{ slot_7 }}</p>
</div></body>
</html>
