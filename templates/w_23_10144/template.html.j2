<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

#logo {
    margin: 20px 0;
}

nav {
    width: 100%;
    background-color: #f0f0f0;
    display: flex;
    justify-content: center;
}

nav ul {
    list-style: none;
    padding: 0;
    display: flex;
}

nav ul li {
    margin: 0 10px;
}

main {
    width: 80%;
    margin: 20px 0;
    text-align: center;
}

.cta {
    display: block;
    margin: 20px 0;
    padding: 10px 20px;
    background-color: #f0f0f0;
    text-decoration: none;
}

.products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 20px 0;
}

.product-item {
    background-color: #f0f0f0;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="logo">
<p>{{ slot_0 }}</p>
</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<main>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<a class="cta">{{ slot_7 }}</a>
<div class="products">
<div class="product-item">{{ slot_8 }}</div>
<div class="product-item">{{ slot_9 }}</div>
<div class="product-item">{{ slot_10 }}</div>
<div class="product-item">{{ slot_11 }}</div>
<div class="product-item">{{ slot_12 }}</div>
<div class="product-item">{{ slot_13 }}</div>
</div>
<a class="cta">{{ slot_14 }}</a>
</main>
</body>
</html>