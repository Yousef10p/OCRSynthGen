}

#discussion-area textarea {
    height: 100px;
}

footer {
    background: #eee;
    padding: 20px;
    width: 100%;
    text-align: center;
    position: fixed;
    bottom: 0;
    width: 100%;
}


#upcoming-games::before,
#fan-discuss::before {
    content: "";
    display: block;
    margin-top: 10px;
    width: 100%;
    height: 200px;
    background: #eee;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
