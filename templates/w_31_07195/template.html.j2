<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}
#header {
  background: blue;
  color: white;
  padding: 20px;
  text-align: center;
}
#header h1 {
  display: inline;
  font-size: 36px;
}
#donate a.button {
  background: red;
  color: white;
  padding: 10px 20px;
  text-decoration: none;
  border-radius: 5px;
  float: left;
}
#main {
  padding: 20px;
}
#main h2 {
  background: green;
  color: white;
  padding: 10px;
}
#main p, #main li {
  font-size: 16px;
}
#footer {
  background: gray;
  color: white;
  text-align: center;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<h1>{{ slot_0 }}</h1>
<div id="donate">
<a class="button">{{ slot_1 }}</a>
</div>
</div>
<div id="main">
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<h2>{{ slot_4 }}</h2>
<ul>
<li><span>{{ slot_5 }}</span> {{ slot_6 }}</li>
<li><span>{{ slot_7 }}</span> {{ slot_8 }}</li>
</ul>
<h2>{{ slot_9 }}</h2>
<ul>
<li><span>{{ slot_10 }}</span> {{ slot_11 }}</li>
<li><span>{{ slot_12 }}</span> {{ slot_13 }}</li>
</ul>
</div>
<div id="footer">
<p>{{ slot_14 }}</p>
</div>
</body>
</html>