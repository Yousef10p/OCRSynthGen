<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 51.1mm; inset-block-start: 100.9mm; inline-size: 39.9mm; block-size: 5.6mm; font-size: 8.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 112.1mm; inset-block-start: 101.9mm; inline-size: 56.1mm; block-size: 15.9mm; font-size: 9.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 51.1mm; inset-block-start: 107.7mm; inline-size: 54.1mm; block-size: 39.7mm; font-size: 9.4pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 112.1mm; inset-block-start: 121.0mm; inline-size: 56.8mm; block-size: 2.2mm; font-size: 6.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 112.1mm; inset-block-start: 124.4mm; inline-size: 56.4mm; block-size: 29.5mm; font-size: 9.3pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 51.1mm; inset-block-start: 150.7mm; inline-size: 34.3mm; block-size: 5.6mm; font-size: 8.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 51.1mm; inset-block-start: 157.5mm; inline-size: 54.7mm; block-size: 32.9mm; font-size: 9.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 51.1mm; inset-block-start: 193.7mm; inline-size: 54.8mm; block-size: 26.1mm; font-size: 9.2pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 172.8mm; inset-block-start: 236.9mm; inline-size: 1.1mm; block-size: 1.9mm; font-size: 5.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
