  background-color: #F0F0F0;
  font-family: var(--font-body);
}

main {
  width: 100%;
  padding: 20px;
}

article {
  display: flex;
  justify-content: space-around;
}

section {
  width: 45%;
}

footer {
  width: 100%;
  display: flex;
  justify-content: space-around;
}

#company-column, #services-column {
  display: flex;
  flex-direction: column;
}

#company-column img {
  width: 80%;
  height: 200px;
  
  background-color: #FF9900;
}

#social-media-links {
  display: flex;
  justify-content: space-between;
}

#social-media-links a {
  text-decoration: none;
}

#contact-information {
  text-align: left;
}

@media screen and (max-width: 768px) {
  article {
    flex-direction: column;
  }
  section {
    width: 90%;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
