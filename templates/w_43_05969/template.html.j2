  color: #fff;
  padding: 10px;
  text-align: center;
}
main {
  padding: 50px;
}
.artists, .playlists {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 20px;
}
.artist, .playlist {
  border: 1px solid #ff69b4;
  padding: 20px;
}
footer {
  background-color: #ff69b4;
  color: #fff;
  text-align: center;
  padding: 20px;
  position: absolute;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
