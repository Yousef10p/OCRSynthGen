    justify-content: space-around;
    padding: 20px;
    background-color: darkgreen;
    color: white;
}

#address, #social-media, #about-us {
    display: flex;
    flex-direction: column;
}

a {
    color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
