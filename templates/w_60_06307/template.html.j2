  margin-bottom: 15px;
}

.service-type {
  background-color: #f2f2f2;
  margin-bottom: 15px;
  padding: 15px;
}

#contact-form {
  display: flex;
  flex-direction: column;
}

input, textarea, button {
  margin-bottom: 15px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
