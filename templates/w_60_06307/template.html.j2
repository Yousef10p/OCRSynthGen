  padding: 10px 0;
}

header nav ul {
  list-style-type: none;
  padding: 0;
}

header nav ul li {
  display: inline;
  margin-left: 15px;
}

header nav ul li a {
  color: #fff;
  text-decoration: none;
}

main {
