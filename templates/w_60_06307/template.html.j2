  color: #fff;
  text-decoration: none;
}

button {
  background-color: #333;
  color: #fff;
  border: none;
  padding: 10px 20px;
  cursor: pointer;
  transition: background-color 0.3s, transform 0.3s;
}

button:hover {
  background-color: #fff;
  color: #333;
  transform: scale(1.05);
}

#portfolio-section {
  display: flex;
  flex-direction: column;
}

.portfolio-item {
  margin-bottom: 15px;
}

#services-section {
