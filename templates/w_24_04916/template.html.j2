<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<fullscreen-slider id="slider">
<slide>
<div class="image">{{ slot_5 }}</div>
<p>{{ slot_6 }}</p>
