<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 188.5mm; inset-block-start: 6.0mm; inline-size: 1.5mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 13.1mm; inset-block-start: 12.0mm; inline-size: 18.7mm; block-size: 16.4mm; font-size: 15.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 102.0mm; inset-block-start: 138.6mm; inline-size: 87.4mm; block-size: 30.0mm; font-size: 21.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 10.1mm; inset-block-start: 187.9mm; inline-size: 88.7mm; block-size: 45.7mm; font-size: 10.8pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 102.0mm; inset-block-start: 188.0mm; inline-size: 44.7mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 102.0mm; inset-block-start: 193.7mm; inline-size: 85.4mm; block-size: 30.2mm; font-size: 10.7pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 102.0mm; inset-block-start: 226.7mm; inline-size: 87.8mm; block-size: 22.4mm; font-size: 10.6pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 10.1mm; inset-block-start: 236.4mm; inline-size: 86.5mm; block-size: 14.7mm; font-size: 10.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 102.0mm; inset-block-start: 251.9mm; inline-size: 88.5mm; block-size: 18.6mm; font-size: 10.5pt">{{ slot_8 }}</p>
</div></body>
</html>
