}

.services .service, .products .product {
    border: 1px solid #ddd;
    padding: 1em;
    text-align: center;
}

h2, p {
    margin: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
