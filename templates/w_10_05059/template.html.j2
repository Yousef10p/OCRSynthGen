  padding: 20px;
  text-align: center;
}

nav {
  display: flex;
  justify-content: space-around;
  padding: 10px;
}

nav form {
  display: flex;
  gap: 10px;
}

main {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
