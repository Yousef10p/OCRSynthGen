<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.6mm; inset-block-start: 22.5mm; inline-size: 79.7mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 112.8mm; inset-block-start: 22.5mm; inline-size: 71.5mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 29.0mm; inline-size: 82.7mm; block-size: 31.6mm; font-size: 14.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 29.0mm; inline-size: 56.4mm; block-size: 8.7mm; font-size: 12.4pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 5.3mm; inset-block-start: 42.9mm; inline-size: 3.7mm; block-size: 64.9mm; font-size: 40.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 46.1mm; inline-size: 83.0mm; block-size: 117.2mm; font-size: 15.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 69.0mm; inline-size: 83.1mm; block-size: 43.0mm; font-size: 15.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 120.3mm; inline-size: 82.5mm; block-size: 37.3mm; font-size: 15.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 166.0mm; inline-size: 76.7mm; block-size: 31.6mm; font-size: 14.9pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 110.7mm; inset-block-start: 168.1mm; inline-size: 73.5mm; block-size: 9.7mm; font-size: 13.8pt"></div>
<p class="box" style="inset-inline-start: 112.8mm; inset-block-start: 183.1mm; inline-size: 35.7mm; block-size: 14.4mm; font-size: 13.6pt">{{ slot_9 }}</p>
</div></body>
</html>
