<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 37.0mm; inset-block-start: 11.7mm; inline-size: 49.5mm; block-size: 4.0mm; font-size: 11.2pt">{{ slot_0 }}</h2>
<header class="box" style="inset-inline-start: 20.9mm; inset-block-start: 25.8mm; inline-size: 2.5mm; block-size: 54.9mm; font-size: 40.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 36.8mm; inset-block-start: 38.8mm; inline-size: 39.1mm; block-size: 49.7mm; font-size: 20.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 82.1mm; inset-block-start: 37.9mm; inline-size: 101.9mm; block-size: 42.5mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 36.8mm; inset-block-start: 98.3mm; inline-size: 56.9mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 36.8mm; inset-block-start: 105.5mm; inline-size: 141.5mm; block-size: 34.4mm; font-size: 19.5pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 36.8mm; inset-block-start: 149.6mm; inline-size: 20.7mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 36.8mm; inset-block-start: 156.8mm; inline-size: 136.5mm; block-size: 11.3mm; font-size: 16.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 121.1mm; inset-block-start: 172.2mm; inline-size: 58.2mm; block-size: 57.7mm; font-size: 20.4pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 22.3mm; inset-block-start: 175.8mm; inline-size: 93.4mm; block-size: 72.7mm; font-size: 22.9pt"></div>
<p class="box" style="inset-inline-start: 121.1mm; inset-block-start: 234.1mm; inline-size: 58.4mm; block-size: 34.5mm; font-size: 19.6pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 35.4mm; inset-block-start: 251.9mm; inline-size: 68.4mm; block-size: 14.3mm; font-size: 13.5pt"></div>
<p class="box" style="inset-inline-start: 36.8mm; inset-block-start: 272.7mm; inline-size: 142.7mm; block-size: 11.3mm; font-size: 16.0pt">{{ slot_9 }}</p>
</div></body>
</html>
