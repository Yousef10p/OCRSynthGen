<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 28.5mm; inset-block-start: 1.2mm; inline-size: 90.6mm; block-size: 10.5mm; font-size: 29.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 38.3mm; inset-block-start: 16.7mm; inline-size: 73.7mm; block-size: 12.9mm; font-size: 18.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 33.6mm; inline-size: 132.4mm; block-size: 17.5mm; font-size: 9.9pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 31.3mm; inset-block-start: 50.4mm; inline-size: 86.3mm; block-size: 9.3mm; font-size: 6.6pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 58.9mm; inline-size: 131.3mm; block-size: 9.0mm; font-size: 8.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 71.5mm; inline-size: 127.3mm; block-size: 25.9mm; font-size: 12.3pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 32.6mm; inset-block-start: 100.9mm; inline-size: 37.4mm; block-size: 28.1mm; font-size: 15.9pt"></div>
<div class="box ph" style="inset-inline-start: 73.6mm; inset-block-start: 101.5mm; inline-size: 41.6mm; block-size: 27.3mm; font-size: 15.5pt"></div>
<h2 class="box" style="inset-inline-start: 8.2mm; inset-block-start: 132.2mm; inline-size: 60.6mm; block-size: 4.6mm; font-size: 9.3pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 139.9mm; inline-size: 133.8mm; block-size: 34.7mm; font-size: 9.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 174.0mm; inline-size: 120.4mm; block-size: 8.2mm; font-size: 9.3pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 181.6mm; inline-size: 126.2mm; block-size: 4.4mm; font-size: 9.3pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 185.4mm; inline-size: 132.0mm; block-size: 4.4mm; font-size: 9.3pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 8.2mm; inset-block-start: 189.2mm; inline-size: 104.8mm; block-size: 4.4mm; font-size: 9.3pt">{{ slot_11 }}</p>
<div class="box ph" style="inset-inline-start: 138.9mm; inset-block-start: 204.7mm; inline-size: 4.4mm; block-size: 3.8mm; font-size: 10.9pt"></div>
</div></body>
</html>
