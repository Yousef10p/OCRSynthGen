<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 23.6mm; inset-block-start: 14.3mm; inline-size: 24.8mm; block-size: 29.5mm; font-size: 14.0pt"></div>
<p class="box" style="inset-inline-start: 62.8mm; inset-block-start: 25.0mm; inline-size: 39.7mm; block-size: 12.4mm; font-size: 8.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 25.0mm; inline-size: 27.7mm; block-size: 9.3mm; font-size: 8.8pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 27.9mm; inset-block-start: 56.8mm; inline-size: 149.8mm; block-size: 12.8mm; font-size: 18.2pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 76.7mm; inline-size: 156.8mm; block-size: 17.7mm; font-size: 12.6pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 31.4mm; inset-block-start: 101.1mm; inline-size: 31.6mm; block-size: 11.7mm; font-size: 16.5pt"></div>
<p class="box" style="inset-inline-start: 28.6mm; inset-block-start: 117.9mm; inline-size: 23.3mm; block-size: 4.4mm; font-size: 12.5pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 30.4mm; inset-block-start: 127.4mm; inline-size: 26.9mm; block-size: 10.1mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 143.4mm; inline-size: 23.1mm; block-size: 8.7mm; font-size: 8.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 28.7mm; inset-block-start: 151.9mm; inline-size: 25.5mm; block-size: 4.4mm; font-size: 6.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 27.9mm; inset-block-start: 226.6mm; inline-size: 68.0mm; block-size: 5.2mm; font-size: 7.3pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 103.9mm; inset-block-start: 252.9mm; inline-size: 9.0mm; block-size: 5.0mm; font-size: 14.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
