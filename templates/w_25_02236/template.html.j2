    padding: 10px;
}


li, a, header img, section {
    background-color: #87ceeb;
    color: #333;
    text-align: center;
    padding: 10px;
}

a {
    display: block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
