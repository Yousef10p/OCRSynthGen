<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 91.8mm; inset-block-start: 20.0mm; inline-size: 30.5mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 63.3mm; inset-block-start: 25.2mm; inline-size: 4.5mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 145.7mm; inset-block-start: 25.2mm; inline-size: 4.8mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 58.8mm; inset-block-start: 30.5mm; inline-size: 14.5mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 141.2mm; inset-block-start: 30.5mm; inline-size: 14.4mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 33.8mm; inset-block-start: 34.2mm; inline-size: 70.3mm; block-size: 92.6mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 116.0mm; inset-block-start: 35.3mm; inline-size: 70.3mm; block-size: 43.3mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 116.0mm; inset-block-start: 93.9mm; inline-size: 70.3mm; block-size: 58.4mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 33.6mm; inset-block-start: 136.7mm; inline-size: 70.4mm; block-size: 124.1mm; font-size: 35.2pt"></div>
<div class="box ph" style="inset-inline-start: 115.7mm; inset-block-start: 167.7mm; inline-size: 70.8mm; block-size: 93.0mm; font-size: 33.0pt"></div>
</div></body>
</html>
