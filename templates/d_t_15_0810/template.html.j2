<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 47.0mm; inset-block-start: 60.7mm; inline-size: 134.1mm; block-size: 27.5mm; font-size: 19.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 47.1mm; inset-block-start: 92.3mm; inline-size: 130.6mm; block-size: 12.6mm; font-size: 17.9pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 47.8mm; inset-block-start: 112.4mm; inline-size: 38.5mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 47.0mm; inset-block-start: 120.3mm; inline-size: 137.6mm; block-size: 27.9mm; font-size: 19.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 46.9mm; inset-block-start: 152.2mm; inline-size: 142.5mm; block-size: 20.1mm; font-size: 19.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 47.4mm; inset-block-start: 180.0mm; inline-size: 65.9mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 46.4mm; inset-block-start: 187.9mm; inline-size: 145.0mm; block-size: 35.8mm; font-size: 20.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 46.5mm; inset-block-start: 227.5mm; inline-size: 139.9mm; block-size: 12.0mm; font-size: 17.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 114.8mm; inset-block-start: 260.5mm; inline-size: 9.3mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
