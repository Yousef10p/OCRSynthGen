<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.0mm; inset-block-start: 15.4mm; inline-size: 176.7mm; block-size: 172.7mm; font-size: 10.6pt"></div>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 190.2mm; inline-size: 61.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 26.0mm; inset-block-start: 198.0mm; inline-size: 87.5mm; block-size: 55.2mm; font-size: 31.3pt"></div>
<p class="box" style="inset-inline-start: 116.6mm; inset-block-start: 198.8mm; inline-size: 86.7mm; block-size: 26.7mm; font-size: 12.6pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 227.5mm; inline-size: 69.8mm; block-size: 4.1mm; font-size: 11.7pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 233.7mm; inline-size: 31.8mm; block-size: 4.1mm; font-size: 11.7pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 239.8mm; inline-size: 55.5mm; block-size: 4.1mm; font-size: 11.7pt"><li>{{ slot_4 }}</li></ul>
<p class="box" style="inset-inline-start: 26.8mm; inset-block-start: 255.3mm; inline-size: 68.8mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 192.9mm; inset-block-start: 262.8mm; inline-size: 9.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_6 }}</footer>
</div></body>
</html>
