<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 157.5mm; inset-block-start: 20.9mm; inline-size: 22.5mm; block-size: 90.6mm; font-size: 28.5pt"></div>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 24.8mm; inline-size: 95.0mm; block-size: 35.9mm; font-size: 17.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 62.9mm; inline-size: 95.3mm; block-size: 61.3mm; font-size: 15.8pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 80.3mm; inset-block-start: 123.7mm; inline-size: 104.0mm; block-size: 15.2mm; font-size: 21.5pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 55.3mm; inset-block-start: 151.1mm; inline-size: 160.4mm; block-size: 107.7mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 12.7mm; inset-block-start: 152.0mm; inline-size: 39.4mm; block-size: 83.7mm; font-size: 11.9pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 12.7mm; inset-block-start: 266.4mm; inline-size: 49.6mm; block-size: 2.5mm; font-size: 7.2pt">{{ slot_4 }}</footer>
</div></body>
</html>
