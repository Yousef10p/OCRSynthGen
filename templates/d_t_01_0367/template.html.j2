<h2 class="box" style="inset-inline-start: 31.5mm; inset-block-start: 113.2mm; inline-size: 17.9mm; block-size: 3.1mm; font-size: 8.8pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 31.5mm; inset-block-start: 119.5mm; inline-size: 161.8mm; block-size: 17.5mm; font-size: 12.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 31.5mm; inset-block-start: 140.1mm; inline-size: 162.6mm; block-size: 12.8mm; font-size: 12.1pt">{{ slot_6 }}</p>
