<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

.header {
  background-color: #f4f4f4;
  padding: 20px;
  text-align: center;
}

.menu {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  background-color: #333;
  color: #fff;
}

.menu nav ul {
  list-style-type: none;
  padding: 0;
  text-align: center;
}

.menu nav ul li {
  display: inline-block;
  padding: 10px;
}

.slider {
  margin: 20px;
  height: 300px;
  position: relative;
  overflow: hidden;
}

.slide {
  background-color: #ccc;
  width: 100%;
  height: 100%;
}

.content {
  margin: 20px;
}

.footer {
  background-color: #f4f4f4;
  padding: 20px;
  text-align: center;
  position: fixed;
  bottom: 0;
  width: 100%;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
</div>
<div class="menu">
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</div>
<div class="slider">
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
<div class="slide">{{ slot_7 }}</div>
</div>
<div class="content">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
<div class="footer">
<p>{{ slot_14 }}</p>
</div>
</body>
</html>