<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
}

.logo {
    background-color: #000;
    width: 100px;
    height: 50px;
    color: #FFF;
    display: flex;
    align-items: center;
    justify-content: center;
}

nav ul {
    display: flex;
}

nav ul li {
    margin: 0 10px;
}

main {
    display: flex;
}

.service, .specialty {
    border: 1px solid #000;
    width: 45%;
    padding: 10px;
}

aside {
    border-right: 1px solid #000;
    width: 20%;
    padding: 10px;
}

div[class*="review"], div[class*="rating"] {
    margin: 10px 0;
    height: 50px;
    background-color: #DEC;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="logo">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<main>
<div class="service">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
</div>
<div class="service">
<h1>{{ slot_8 }}</h1>
<p>{{ slot_9 }}</p>
</div>
<div class="specialty">
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }}</p>
</div>
<div class="specialty">
<h1>{{ slot_12 }}</h1>
<p>{{ slot_13 }}</p>
</div>

<aside>
<div class="review">{{ slot_14 }}</div>
<div class="review">{{ slot_15 }}</div>
<div class="rating">{{ slot_16 }}</div>
<div class="rating">{{ slot_17 }}</div>
</aside>
</main>
</body>
</html>