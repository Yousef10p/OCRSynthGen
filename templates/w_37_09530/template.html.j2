<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  background-color: lavender;
  height: 100vh;
  margin: 0;
  display: flex;
  justify-content: space-between;
}

nav {
  position: fixed;
  width: 100%;
  top: 0;
  background-color: lightgray;
}

nav ul {
  list-style-type: none;
  padding: 20px;
  display: flex;
  justify-content: space-around;
}

.slide {
  height: 300px;
  background-color: darkgray;
  color: white;
  margin: 20px;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

aside {
  width: 30%;
  background-color: gray;
  color: white;
  padding: 20px;
  margin: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
</ul>
</nav>
<div class="slider">
<div class="slide">{{ slot_2 }}<p>{{ slot_3 }}</p></div>
<div class="slide">{{ slot_4 }}<p>{{ slot_5 }}</p></div>
<div class="slide">{{ slot_6 }}<p>{{ slot_7 }}</p></div>
<div class="slide">{{ slot_8 }}<p>{{ slot_9 }}</p></div>
</div>
<aside>
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
<h3>{{ slot_12 }}</h3>
<p>{{ slot_13 }}</p>
<h3>{{ slot_14 }}</h3>
<p>{{ slot_15 }}</p>
</aside>
</body>
</html>