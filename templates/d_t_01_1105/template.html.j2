<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 33.0mm; inline-size: 71.7mm; block-size: 26.8mm; font-size: 12.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 116.1mm; inset-block-start: 33.0mm; inline-size: 71.9mm; block-size: 31.4mm; font-size: 12.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 64.4mm; inline-size: 73.1mm; block-size: 54.7mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 116.1mm; inset-block-start: 70.7mm; inline-size: 73.9mm; block-size: 32.3mm; font-size: 18.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 116.1mm; inset-block-start: 108.7mm; inline-size: 71.4mm; block-size: 50.1mm; font-size: 12.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 123.8mm; inline-size: 72.8mm; block-size: 36.1mm; font-size: 12.8pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 117.3mm; inset-block-start: 162.9mm; inline-size: 56.6mm; block-size: 17.5mm; font-size: 16.5pt"></div>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 166.2mm; inline-size: 57.5mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 172.7mm; inline-size: 72.7mm; block-size: 40.8mm; font-size: 12.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 116.1mm; inset-block-start: 185.9mm; inline-size: 55.4mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 218.1mm; inline-size: 70.9mm; block-size: 40.8mm; font-size: 12.8pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 10.8mm; inset-block-start: 270.5mm; inline-size: 3.4mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_10 }}</footer>
</div></body>
</html>
