<p class="box" style="inset-inline-start: 222.5mm; inset-block-start: 112.8mm; inline-size: 53.5mm; block-size: 45.7mm; font-size: 10.8pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 164.5mm; inset-block-start: 124.5mm; inline-size: 54.1mm; block-size: 38.0mm; font-size: 10.8pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 20.5mm; inset-block-start: 159.4mm; inline-size: 54.2mm; block-size: 26.3mm; font-size: 10.7pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 10.5mm; inset-block-start: 198.7mm; inline-size: 25.7mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_12 }}</footer><footer class="box" style="inset-inline-start: 261.4mm; inset-block-start: 198.7mm; inline-size: 25.2mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_13 }}</footer>
</div></body>
</html>
