<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.5mm; inset-block-start: 0.0mm; inline-size: 295.5mm; block-size: 47.5mm; font-size: 15.0pt"></div>
<h2 class="box" style="inset-inline-start: 19.3mm; inset-block-start: 55.4mm; inline-size: 10.7mm; block-size: 5.7mm; font-size: 16.3pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 163.2mm; inset-block-start: 55.4mm; inline-size: 36.5mm; block-size: 5.7mm; font-size: 16.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 20.5mm; inset-block-start: 66.2mm; inline-size: 52.8mm; block-size: 34.1mm; font-size: 10.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 78.5mm; inset-block-start: 66.2mm; inline-size: 54.5mm; block-size: 22.4mm; font-size: 10.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 164.5mm; inset-block-start: 66.2mm; inline-size: 54.0mm; block-size: 30.2mm; font-size: 10.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 222.5mm; inset-block-start: 66.2mm; inline-size: 54.6mm; block-size: 41.8mm; font-size: 10.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 78.5mm; inset-block-start: 93.4mm; inline-size: 52.6mm; block-size: 14.7mm; font-size: 10.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 164.5mm; inset-block-start: 101.2mm; inline-size: 52.7mm; block-size: 18.6mm; font-size: 10.5pt">{{ slot_7 }}</p>
