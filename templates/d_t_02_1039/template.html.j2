<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 41.2mm; inset-block-start: 6.1mm; inline-size: 133.6mm; block-size: 1.9mm; font-size: 5.4pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 20.1mm; inset-block-start: 56.2mm; inline-size: 148.1mm; block-size: 4.6mm; font-size: 13.1pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 62.0mm; inline-size: 84.2mm; block-size: 14.2mm; font-size: 10.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 67.5mm; inline-size: 83.6mm; block-size: 56.3mm; font-size: 10.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 110.4mm; inset-block-start: 81.1mm; inline-size: 84.2mm; block-size: 60.1mm; font-size: 10.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 128.8mm; inline-size: 84.9mm; block-size: 90.7mm; font-size: 10.7pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 110.7mm; inset-block-start: 157.1mm; inline-size: 61.6mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_6 }}</h2>
<div class="box ph" style="inset-inline-start: 109.2mm; inset-block-start: 160.3mm; inline-size: 87.0mm; block-size: 36.5mm; font-size: 17.3pt"></div>
