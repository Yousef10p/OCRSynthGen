<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
}

.left-menu {
    position: fixed;
    width: 20%;
    height: 100vh;
    background-color: #f0f0f0;
}

.left-menu ul {
    list-style: none;
    padding: 0;
}

.left-menu li {
    padding: 10px;
}

.full-width {
    margin-right: 20%;
    width: 80%;
    padding: 20px;
}

.performers, .ticket-purchase {
    width: 50%;
    float: right;
}


.full-width div::before {
    content: "";
    display: inline-block;
    width: 100px;
    height: 100px;
    background-color: #f00;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<aside class="left-menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</aside>
<section class="full-width">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div class="performers">
<h2>{{ slot_7 }}</h2>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>

</ul>
</div>
<div class="ticket-purchase">
<h2>{{ slot_11 }}</h2>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>

</ul>
</div>
</section>
</body>
</html>