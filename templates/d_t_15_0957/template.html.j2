<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.4mm; inset-block-start: 16.0mm; inline-size: 176.2mm; block-size: 91.9mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 110.8mm; inline-size: 154.5mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 26.5mm; inset-block-start: 117.4mm; inline-size: 85.9mm; block-size: 69.3mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 126.4mm; inset-block-start: 116.8mm; inline-size: 72.2mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_1 }}</p>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 122.9mm; inline-size: 83.8mm; block-size: 58.5mm; font-size: 12.8pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 183.2mm; inline-size: 84.1mm; block-size: 49.5mm; font-size: 12.7pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 26.6mm; inset-block-start: 189.5mm; inline-size: 86.2mm; block-size: 8.1mm; font-size: 11.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 36.5mm; inset-block-start: 201.2mm; inline-size: 76.9mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 216.3mm; inline-size: 83.6mm; block-size: 35.9mm; font-size: 12.7pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 119.9mm; inset-block-start: 234.5mm; inline-size: 83.8mm; block-size: 17.9mm; font-size: 12.7pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 197.4mm; inset-block-start: 262.7mm; inline-size: 5.6mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
