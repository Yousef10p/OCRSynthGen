<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
}

#brand {
    font-size: 1.5em;
    color: #007BFF;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin-left: 15px;
}

nav ul li a {
    text-decoration: none;
    color: #007BFF;
}

#intro, #quiz, #challenges {
    margin: 20px;
    padding: 20px;
    color: white;
}

#intro {
    background-color: #007BFF;
    border-radius: 5px;
}

#quiz, #challenges {
    display: none;
    background-color: #FFC107;
    border-radius: 5px;
}

footer {
    position: fixed;
    bottom: 0;
    width: 100%;
    text-align: center;
    padding: 10px;
    background-color: #007BFF;
    color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div id="brand">{{ slot_0 }}</div>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<section id="intro">
<h1>{{ slot_4 }}</h1>
<h2>{{ slot_5 }}</h2>
</section>
<section id="quiz">
<h2>{{ slot_6 }}</h2>
<h3 id="quiz-title">{{ slot_7 }}</h3>
<button id="start-quiz">{{ slot_8 }}</button>
<div id="quiz-box">{{ slot_9 }}</div>
</section>
<section id="challenges">
<h2>{{ slot_10 }}</h2>
<h3 id="challenge-title">{{ slot_11 }}</h3>
<p id="challenge-desc">{{ slot_12 }}</p>
<button id="start-challenge">{{ slot_13 }}</button>
</section>
<footer>
<p>{{ slot_14 }}</p>
</footer>

</body>
</html>