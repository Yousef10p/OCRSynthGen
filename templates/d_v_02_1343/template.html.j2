<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 27.4mm; inset-block-start: 20.1mm; inline-size: 57.3mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 89.4mm; inset-block-start: 19.5mm; inline-size: 53.3mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 148.7mm; inset-block-start: 19.1mm; inline-size: 38.3mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_2 }}</header><div class="box ph" style="inset-inline-start: 35.4mm; inset-block-start: 50.4mm; inline-size: 139.7mm; block-size: 70.9mm; font-size: 16.7pt"></div>
<p class="box" style="inset-inline-start: 96.4mm; inset-block-start: 129.0mm; inline-size: 21.2mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 32.9mm; inset-block-start: 164.9mm; inline-size: 146.1mm; block-size: 69.1mm; font-size: 32.6pt"></div>
<p class="box" style="inset-inline-start: 96.3mm; inset-block-start: 243.3mm; inline-size: 21.4mm; block-size: 4.5mm; font-size: 12.7pt">{{ slot_4 }}</p>
</div></body>
</html>
