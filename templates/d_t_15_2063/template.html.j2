<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 26.2mm; inset-block-start: 15.7mm; inline-size: 86.0mm; block-size: 68.8mm; font-size: 15.0pt"></div>
<div class="box ph" style="inset-inline-start: 116.2mm; inset-block-start: 15.6mm; inline-size: 86.1mm; block-size: 54.1mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 72.0mm; inline-size: 30.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 116.2mm; inset-block-start: 78.5mm; inline-size: 86.1mm; block-size: 50.6mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 86.7mm; inline-size: 85.5mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 26.2mm; inset-block-start: 92.5mm; inline-size: 86.0mm; block-size: 134.6mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 131.6mm; inline-size: 30.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 116.1mm; inset-block-start: 138.5mm; inline-size: 86.1mm; block-size: 50.8mm; font-size: 14.4pt"></div>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 191.6mm; inline-size: 30.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 116.1mm; inset-block-start: 197.9mm; inline-size: 86.3mm; block-size: 51.3mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 26.7mm; inset-block-start: 229.6mm; inline-size: 57.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 26.7mm; inset-block-start: 236.9mm; inline-size: 33.3mm; block-size: 4.8mm; font-size: 13.6pt">{{ slot_5 }}</h2>
<ul class="box" style="inset-inline-start: 30.0mm; inset-block-start: 244.1mm; inline-size: 83.2mm; block-size: 13.2mm; font-size: 12.4pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 116.7mm; inset-block-start: 251.7mm; inline-size: 30.4mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 194.9mm; inset-block-start: 262.8mm; inline-size: 7.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_8 }}</footer>
</div></body>
</html>
