  justify-content: space-around;
  list-style: none;
  padding: 0;
}

nav a {
  color: #fff;
}

.fullscreen-slider {
  flex-grow: 1;
  position: relative;
}

.slide {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
}

.slide-content {
