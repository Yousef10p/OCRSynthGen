  height: 80px;
  padding: 0 20px;
  background-color: #FFD700;
}

nav ul {
  display: flex;
  list-style-type: none;
}

nav ul li {
  margin-left: 10px;
}

nav ul li ul {
  display: none;
  position: absolute;
  background-color: #DDD;
  padding: 10px;
}

nav ul li:hover ul {
  display: block;
}

footer {
  text-align: center;
  padding: 20px;
  background-color: #111;
  color: #FFD700;
}

.hero-image {
  width: 100%;
  height: 500px;
  background-color: #111;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
