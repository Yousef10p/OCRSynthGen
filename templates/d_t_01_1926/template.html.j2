<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.3mm; inset-block-start: 10.3mm; inline-size: 24.1mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 20.3mm; inset-block-start: 29.4mm; inline-size: 172.3mm; block-size: 24.1mm; font-size: 22.7pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 19.8mm; inset-block-start: 90.2mm; inline-size: 54.0mm; block-size: 41.3mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 108.8mm; inset-block-start: 90.9mm; inline-size: 54.3mm; block-size: 40.5mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 20.3mm; inset-block-start: 137.7mm; inline-size: 28.7mm; block-size: 27.3mm; font-size: 12.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 68.6mm; inset-block-start: 137.7mm; inline-size: 31.7mm; block-size: 27.3mm; font-size: 12.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 109.2mm; inset-block-start: 137.7mm; inline-size: 35.1mm; block-size: 32.1mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 149.1mm; inset-block-start: 137.7mm; inline-size: 28.0mm; block-size: 17.8mm; font-size: 12.6pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 68.3mm; inset-block-start: 180.4mm; inline-size: 54.4mm; block-size: 40.5mm; font-size: 14.3pt"></div>
<div class="box ph" style="inset-inline-start: 149.3mm; inset-block-start: 180.4mm; inline-size: 44.3mm; block-size: 59.1mm; font-size: 15.2pt"></div>
</div></body>
</html>
