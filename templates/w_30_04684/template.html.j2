<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
<a>{{ slot_6 }}</a>
</div>
</div>
<a><div class="cart-icon ph" style="inline-size: 100%; block-size: 150px"></div></a>
</div>
<section class="hero-section">
<h1>{{ slot_7 }}</h1>
<p>{{ slot_8 }}</p>
</section>
<section class="products">
<div class="product-item">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<div class="image-placeholder">{{ slot_11 }}</div>
</div>
