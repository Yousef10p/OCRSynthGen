nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: pink;
}

nav ul li {
    float: right;
    width: 20%;
}

nav ul li:hover {
    background-color: black;
}

nav ul li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

nav ul li ul {
    display: none;
    position: absolute;
    min-width: 100%;
}

nav ul li:hover > ul {
    display: block;
}

nav ul li ul li {
    position: relative;
}

nav ul li ul li ul {
    left: 100%;
    top: 0;
}


      
    
.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
