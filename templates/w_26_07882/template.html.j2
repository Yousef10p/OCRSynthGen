	list-style: none;
	padding: 0;
}
nav ul li {
	display: inline;
	margin: 0 10px;
}
nav ul li a {
	color: #fff;
	text-decoration: none;
}
main {
	margin: 20px;
}
h1, h2 {
	color: #333;
}
.rectangle {
	height: 100px;
	width: 100px;
	margin: 10px auto;
	background-color: #999;
}
footer {
	background-color: #333;
	color: #fff;
	clear: both;
	position: absolute;
	width: 100%;
	text-align: center;
	padding: 10px 0;
}
footer ul {
	list-style: none;
	padding: 0;
}
footer ul li {
	display: inline;
	margin: 0 10px;
}
footer ul li a {
	color: #fff;
	text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
