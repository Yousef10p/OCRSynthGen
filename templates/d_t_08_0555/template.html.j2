<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 44.4mm; inset-block-start: 47.0mm; inline-size: 126.5mm; block-size: 18.9mm; font-size: 10.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 98.6mm; inset-block-start: 72.3mm; inline-size: 17.9mm; block-size: 11.9mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 44.4mm; inset-block-start: 90.4mm; inline-size: 126.5mm; block-size: 11.2mm; font-size: 10.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 44.4mm; inset-block-start: 105.9mm; inline-size: 126.5mm; block-size: 18.9mm; font-size: 10.9pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 95.2mm; inset-block-start: 125.0mm; inline-size: 24.9mm; block-size: 11.9mm; font-size: 10.9pt"></div>
<p class="box" style="inset-inline-start: 44.4mm; inset-block-start: 140.5mm; inline-size: 126.5mm; block-size: 11.2mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 64.3mm; inset-block-start: 158.2mm; inline-size: 82.5mm; block-size: 17.5mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 44.4mm; inset-block-start: 183.5mm; inline-size: 126.5mm; block-size: 26.6mm; font-size: 10.9pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 106.7mm; inset-block-start: 243.9mm; inline-size: 1.9mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
