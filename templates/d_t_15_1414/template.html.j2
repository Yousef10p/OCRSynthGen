<p class="box" style="inset-inline-start: 14.0mm; inset-block-start: 132.0mm; inline-size: 86.8mm; block-size: 31.2mm; font-size: 12.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 139.8mm; inline-size: 87.0mm; block-size: 35.7mm; font-size: 12.7pt">{{ slot_4 }}</p>
