<p class="box" style="inset-inline-start: 12.0mm; inset-block-start: 109.6mm; inline-size: 75.4mm; block-size: 16.9mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 11.2mm; inset-block-start: 130.6mm; inline-size: 76.0mm; block-size: 29.2mm; font-size: 13.8pt"></div>
<div class="box ph" style="inset-inline-start: 99.1mm; inset-block-start: 169.6mm; inline-size: 27.9mm; block-size: 16.2mm; font-size: 15.3pt"></div>
<div class="box ph" style="inset-inline-start: 140.2mm; inset-block-start: 169.3mm; inline-size: 29.0mm; block-size: 16.5mm; font-size: 15.6pt"></div>
<div class="box ph" style="inset-inline-start: 182.2mm; inset-block-start: 169.3mm; inline-size: 27.8mm; block-size: 16.5mm; font-size: 15.6pt"></div>
