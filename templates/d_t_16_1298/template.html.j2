<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 95.0mm; inline-size: 26.1mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_3 }}</h2>
<div class="box ph" style="inset-inline-start: 103.2mm; inset-block-start: 94.4mm; inline-size: 86.4mm; block-size: 59.1mm; font-size: 27.9pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 101.5mm; inline-size: 86.9mm; block-size: 39.4mm; font-size: 12.4pt">{{ slot_4 }}</p>
