<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}
body {
    background-color: #f0f0f0;
    color: #333;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
}
.header {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100px;
    background-color: #333;
}
.logo {
    height: 50px;
    width: 50px;
}
.navigation ul {
    list-style: none;
}
.navigation li {
    display: inline;
    margin: 0 10px;
    color: white;
}
.rectangle-row {
    display: flex;
    justify-content: space-between;
    width: 80%;
    margin: 20px auto;
}
.main .rectangle {
    height: 300px;
    width: 30%;
    margin: 0 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}
.contact form {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 20px auto;
    width: 80%;
}
.contact input, .contact textarea {
    margin: 10px 0;
    padding: 10px;
    border: none;
    border-radius: 5px;
}
.contact input[type="submit"] {
    color: white;
    background-color: #333;
    cursor: pointer;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header class="header">
<div class="logo ph" style="inline-size: 100%; block-size: 150px"></div>
<nav class="navigation">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<main class="main">
<div class="rectangle-row">
<div class="rectangle" id="mathematics"></div>
<div class="rectangle" id="science"></div>
<div class="rectangle" id="history"></div>
</div>
<p id="mathematics-info">{{ slot_4 }}</p>
<p id="science-info">{{ slot_5 }}</p>
<p id="history-info">{{ slot_6 }}</p>
</main>
<footer class="footer">
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
<form>
<label>{{ slot_10 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_11 }}</span>
<label>{{ slot_12 }}</label>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em; display: block; min-block-size: 4em">{{ slot_13 }}</span>
<span class="">{{ slot_14 }}</span>
</form>
</footer>
</body>
</html>