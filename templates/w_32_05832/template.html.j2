}

header { grid-area: header; }
#nav-bar { grid-area: nav; }
#trending-topics { grid-area: trending; }
main { grid-area: main; }
#advertisements { grid-area: ads; }

#search-bar, .ad-container {
    height: 40px;
    background-color: grey;
}

h2 { 
    color: blue; 
}
a { 
    color: red; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
