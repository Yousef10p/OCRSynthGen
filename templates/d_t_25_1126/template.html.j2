<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 96.5mm; inline-size: 154.9mm; block-size: 10.2mm; font-size: 10.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 109.9mm; inline-size: 156.5mm; block-size: 23.5mm; font-size: 10.7pt">{{ slot_5 }}</p>
