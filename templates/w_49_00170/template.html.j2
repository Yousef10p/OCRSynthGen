body {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--font-body);
}

nav ul {
  position: fixed;
  width: 100%;
  background: #f5f5f5;
  padding: 20px 0;
  text-align: center;
}

nav li {
  display: inline-block;
  margin: 0 20px;
