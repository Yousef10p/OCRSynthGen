    top: 0;
    right: 0;
    left: 0;
    height: 50px;
    background-color: #f8f8f8;
}

nav {
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 100%;
}

section {
    margin: 60px auto 0;
    padding: 20px;
    max-width: 800px;
}

footer {
