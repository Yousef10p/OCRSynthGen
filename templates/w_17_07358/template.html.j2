    background-color: #f8f8f8;
    height: 50px;
}

.blog-post {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
}

form input, form textarea {
    padding: 10px;
    border: 1px solid #ccc;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
