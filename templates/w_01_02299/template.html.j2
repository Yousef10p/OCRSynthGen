<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>


<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_6 }}</span>
</header>


<main>

<h1>{{ slot_7 }}</h1>

<p class="imgPlaceholder">{{ slot_8 }}</p>
</main>


<footer>

<h2>{{ slot_9 }}</h2>
<ul>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
<li><a>{{ slot_12 }}</a></li>
</ul>

<h2>{{ slot_13 }}</h2>
<ul>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
<li><a>{{ slot_16 }}</a></li>
</ul>
</footer>

</body>
</html>