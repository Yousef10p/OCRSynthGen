<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 130.6mm; inline-size: 165.3mm; block-size: 19.3mm; font-size: 12.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.9mm; inset-block-start: 153.6mm; inline-size: 165.3mm; block-size: 9.5mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 20.9mm; inset-block-start: 165.0mm; inline-size: 167.3mm; block-size: 17.0mm; font-size: 11.0pt"></div>
