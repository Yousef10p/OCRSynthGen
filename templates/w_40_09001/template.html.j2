    padding: 30px;
    text-align: center;
}

nav ul {
    list-style-type: none;
    background-color: #333;
    display: flex;
    justify-content: space-around;
    padding: 20px 0;
}

nav li a {
    color: #fff;
    text-decoration: none;
}

.hero-image {
    width: 100%;
    height: 300px;
    background-color: #666;
}

section {
    padding: 50px;
}

footer {
    background-color: #333;
    color: #fff;
    padding: 30px;
    text-align: center;
}

footer a {
    color: #fff;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
