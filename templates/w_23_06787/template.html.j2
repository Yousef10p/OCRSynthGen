<li><a>{{ slot_2 }}</a></li>
</ul>
</div>
<div id="filter">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_3 }}</span>
<h2>{{ slot_4 }}</h2>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</div>
<div id="main">
<h1>{{ slot_8 }}</h1>

<div class="product-placeholder ph"></div>
<p>{{ slot_9 }}</p>

</div>
<div id="footer">
<p>{{ slot_10 }} <a>{{ slot_11 }}</a> {{ slot_12 }} <a>{{ slot_13 }}</a></p>
<p>{{ slot_14 }} <a>{{ slot_15 }}</a> {{ slot_16 }}</p>
<p>{{ slot_17 }}</p>
</div>
</body>
</html>