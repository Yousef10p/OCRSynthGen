<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 69.3mm; inline-size: 199.4mm; block-size: 13.9mm; font-size: 15.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 5.1mm; inset-block-start: 87.0mm; inline-size: 86.8mm; block-size: 3.6mm; font-size: 15.0pt">{{ slot_6 }}</h2>
