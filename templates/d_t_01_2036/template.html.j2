<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 31.8mm; inset-block-start: 13.7mm; inline-size: 24.0mm; block-size: 14.1mm; font-size: 39.9pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 66.1mm; inset-block-start: 13.2mm; inline-size: 118.1mm; block-size: 14.3mm; font-size: 20.3pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 31.8mm; inset-block-start: 28.2mm; inline-size: 119.5mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 31.8mm; inset-block-start: 37.1mm; inline-size: 50.6mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 42.1mm; inline-size: 72.1mm; block-size: 68.8mm; font-size: 11.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 46.2mm; inline-size: 72.2mm; block-size: 109.3mm; font-size: 11.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 115.9mm; inline-size: 72.2mm; block-size: 44.6mm; font-size: 11.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 80.7mm; inset-block-start: 262.8mm; inline-size: 55.4mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_7 }}</footer>
</div></body>
</html>
