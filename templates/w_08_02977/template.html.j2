}

main {
    margin-top: 5em;
}

section {
    margin-bottom: 2em;
}

h1 {
    text-align: center;
}

.restaurants, .reviews, .deals {
    display: flex;
    justify-content: space-around;
}

.restaurants div, .reviews p, .deals div {
    background-color: #eee;
    padding: 1em;
    margin: 1em;
    width: 30%;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
