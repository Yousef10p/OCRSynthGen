.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

nav {
    background-color: #000;
    color: #fff;
    position: fixed;
    width: 100%;
}

nav ul {
    display: flex;
    justify-content: space-around;
