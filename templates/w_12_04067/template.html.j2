<div class="item">{{ slot_5 }}</div>
<div class="item">{{ slot_6 }}</div>
</div>
<div class="podcasts-section">
<h2>{{ slot_7 }}</h2>
<div class="item">{{ slot_8 }}</div>
<div class="item">{{ slot_9 }}</div>
</div>
<div class="quiz-section">
<h2>{{ slot_10 }}</h2>
<div class="quiz-item">{{ slot_11 }}</div>
<div class="quiz-item">{{ slot_12 }}</div>
</div>
<div class="poll-section">
<h2>{{ slot_13 }}</h2>
<div class="poll-item">{{ slot_14 }}</div>
<div class="poll-item">{{ slot_15 }}</div>
</div>
</div>
</body>
</html>