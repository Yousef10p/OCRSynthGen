    margin: 0;
    color: green;
}

.menu {
    list-style-type: none;
    padding: 0;
}

.menu li {
    display: inline;
    margin-left: 10px;
}

.menu a {
    color: green;
    text-decoration: none;
}

.featured, .reviews {
    margin: 20px;
}

.product, .review {
    margin-bottom: 20px;
}

.product-image, .review-author {
    width: 200px;
    height: 200px;
    background-color: green;
    margin-bottom: 10px;
}

.footer {
    background-color: white;
    text-align: center;
    padding: 20px;
    box-shadow: 0px -2px 4px rgba(0,0,0,0.1);
    color: green;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
