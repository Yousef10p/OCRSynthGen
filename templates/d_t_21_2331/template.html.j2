<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 40.4mm; inset-block-start: 0.7mm; inline-size: 68.6mm; block-size: 10.5mm; font-size: 29.7pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 7.0mm; inset-block-start: 14.4mm; inline-size: 32.0mm; block-size: 27.9mm; font-size: 15.8pt"></div>
<p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 13.8mm; inline-size: 91.5mm; block-size: 21.9mm; font-size: 12.4pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 7.3mm; inset-block-start: 48.7mm; inline-size: 31.7mm; block-size: 28.2mm; font-size: 16.0pt"></div>
<p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 48.3mm; inline-size: 91.2mm; block-size: 21.9mm; font-size: 12.4pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 6.7mm; inset-block-start: 82.6mm; inline-size: 32.3mm; block-size: 28.5mm; font-size: 16.2pt"></div>
<p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 82.7mm; inline-size: 92.0mm; block-size: 34.3mm; font-size: 13.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 119.7mm; inline-size: 91.6mm; block-size: 21.9mm; font-size: 12.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 7.0mm; inset-block-start: 120.2mm; inline-size: 27.8mm; block-size: 36.6mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 7.0mm; inset-block-start: 163.5mm; inline-size: 43.3mm; block-size: 36.6mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 163.0mm; inline-size: 92.2mm; block-size: 26.3mm; font-size: 12.4pt">{{ slot_5 }}</p>
</div></body>
</html>
