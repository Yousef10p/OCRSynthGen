.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: column;
    align-items: center;
}
nav {
    display: flex;
    justify-content: center;
}
.product-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
}
.product {
    margin: 10px;
    text-align: center;
}
.product-image {
    width: 200px;
    height: 200px;
    background-color: grey;
}
.cart {
    position: fixed;
    left: 0;
    top: 0;
    background-color: lightgrey;
    padding: 20px;
}
footer {
    width: 100%;
    background-color: darkgrey;
    color: white;
    text-align: center;
    padding: 20px;
}
form {
    display: flex;
    flex-direction: column;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
