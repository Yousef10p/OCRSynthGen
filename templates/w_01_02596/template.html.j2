<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
	font-family: var(--font-body);
}
.header {
	background-color: grey;
	color: white;
	padding: 10px;
}
.header h1 {
	font-size: 24px;
}
.nav ul {
	list-style-type: none;
	padding: 0;
}
.nav li {
	display: inline;
	margin: 5px;
}
.info {
	background-color: lightgrey;
	padding: 10px;
}
.service {
	height: 100px;
	width: 100px;
	margin: 10px;
	float: right;
	text-align: center;
}
.disclaimer {
	clear: both;
	background-color: lightgrey;
	padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
</div>
<div class="nav">
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</div>
<div class="info">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="services">
<h2>{{ slot_9 }}</h2>

<div class="service" style="background-color:red;">{{ slot_10 }}</div>
<div class="service" style="background-color:orange;">{{ slot_11 }}</div>
<div class="service" style="background-color:yellow;">{{ slot_12 }}</div>
<div class="service" style="background-color:green;">{{ slot_13 }}</div>
<div class="service" style="background-color:blue;">{{ slot_14 }}</div>
</div>
<div class="disclaimer">
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
</body>
</html>