<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 94.2mm; inline-size: 85.6mm; block-size: 122.6mm; font-size: 12.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 112.1mm; inset-block-start: 95.6mm; inline-size: 85.6mm; block-size: 86.0mm; font-size: 12.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 112.1mm; inset-block-start: 184.5mm; inline-size: 85.5mm; block-size: 58.4mm; font-size: 12.7pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 15.9mm; inset-block-start: 220.7mm; inline-size: 39.3mm; block-size: 4.1mm; font-size: 11.5pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 18.4mm; inset-block-start: 227.5mm; inline-size: 85.4mm; block-size: 26.3mm; font-size: 12.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 112.1mm; inset-block-start: 245.9mm; inline-size: 85.5mm; block-size: 8.0mm; font-size: 11.3pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 30.5mm; inset-block-start: 257.5mm; inline-size: 10.8mm; block-size: 12.0mm; font-size: 11.3pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 17.6mm; inset-block-start: 270.2mm; inline-size: 3.5mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_10 }}</footer>
</div></body>
</html>
