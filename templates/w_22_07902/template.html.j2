<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.hero {
    background-color: lightblue;
    padding: 100px 0;
    text-align: center;
}

.hero-text {
    display: inline-block;
    vertical-align: middle;
    width: 100%;
}

.schedule-button {
    background-color: blue;
    color: white;
    padding: 10px;
    text-transform: uppercase;
}

.service-links a {
    margin: 0 10px;
    text-decoration: none;
}

.services, .insurance {
    margin: 50px;
}

.services h2, .insurance h2 {
    text-align: center;
    text-transform: uppercase;
}

.services ul, .insurance ul {
    list-style-type: none;
    text-align: center;
}

.services li::before, .insurance li::before {
    content: "";
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<div class="hero-text">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<button class="schedule-button">{{ slot_2 }}</button>
<div class="service-links">
<a>{{ slot_3 }}</a>
<a>{{ slot_4 }}</a>
<a>{{ slot_5 }}</a>
</div>
</div>
</div>
<section class="services">
<h2>{{ slot_6 }}</h2>
<ul>
<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</section>
<section class="insurance">
<h2>{{ slot_11 }}</h2>
<ul>
<li>{{ slot_12 }}</li>
<li>{{ slot_13 }}</li>
<li>{{ slot_14 }}</li>
</ul>
</section>
</body>
</html>