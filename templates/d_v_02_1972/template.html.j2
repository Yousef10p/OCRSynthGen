<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 5.5mm; inset-block-start: 13.2mm; inline-size: 84.9mm; block-size: 3.8mm; font-size: 16.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 18.7mm; inline-size: 93.8mm; block-size: 9.6mm; font-size: 13.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 108.8mm; inset-block-start: 18.7mm; inline-size: 93.8mm; block-size: 35.6mm; font-size: 13.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 30.1mm; inline-size: 95.5mm; block-size: 35.6mm; font-size: 13.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 108.8mm; inset-block-start: 56.1mm; inline-size: 95.1mm; block-size: 29.1mm; font-size: 13.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 67.5mm; inline-size: 94.0mm; block-size: 9.6mm; font-size: 13.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 5.1mm; inset-block-start: 78.8mm; inline-size: 94.1mm; block-size: 38.9mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 108.8mm; inset-block-start: 87.0mm; inline-size: 89.0mm; block-size: 9.6mm; font-size: 13.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 5.9mm; inset-block-start: 129.4mm; inline-size: 45.3mm; block-size: 2.6mm; font-size: 11.0pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 199.5mm; inset-block-start: 129.4mm; inline-size: 4.3mm; block-size: 2.6mm; font-size: 11.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
