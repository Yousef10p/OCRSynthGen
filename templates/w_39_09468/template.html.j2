}

.section {
    width: 30%;
    text-align: center;
}

footer {
    background-color: #f8f8f8;
    text-align: center;
    padding: 10px 0;
    position: sticky; bottom: 0;
}

.contact, .social-media {
    width: 50%;
    display: inline-block;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
