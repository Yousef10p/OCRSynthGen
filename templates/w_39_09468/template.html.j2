    z-index: 100;
}

.logo {
    width: 100px;
    height: 50px;
    background-color: #ddd;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav li {
    display: inline;
    margin: 0 10px;
}

.video-container {
    width: 100%;
    height: 500px;
    background-color: #ddd;
    margin: 20px 0;
}

.content {
    margin: 0 auto;
    width: 80%;
    display: flex;
