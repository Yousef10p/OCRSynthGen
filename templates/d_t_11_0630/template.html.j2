<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 143.9mm; inline-size: 164.5mm; block-size: 26.9mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 65.6mm; inset-block-start: 174.9mm; inline-size: 124.3mm; block-size: 14.5mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 64.9mm; inset-block-start: 188.1mm; inline-size: 125.0mm; block-size: 14.4mm; font-size: 12.0pt"></div>
