}

.product {
    width: 30%;
    margin: 1%;
    float: right;
    background-color: #f4f4f4;
    padding: 10px;
    border: 1px solid #ccc;
}

.product-image {
    width: 100%;
    height: 200px;
}

@media screen and (max-width: 600px) {
    .product {
        width: 100%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
