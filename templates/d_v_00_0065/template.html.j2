<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.1mm; inset-block-start: 0.0mm; inline-size: 209.8mm; block-size: 78.0mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 80.4mm; inline-size: 65.7mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 24.9mm; inset-block-start: 89.8mm; inline-size: 105.5mm; block-size: 50.4mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 90.4mm; inline-size: 43.5mm; block-size: 22.9mm; font-size: 10.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 116.7mm; inline-size: 49.2mm; block-size: 51.3mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 142.4mm; inline-size: 29.4mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 47.2mm; inset-block-start: 153.3mm; inline-size: 61.6mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_4 }}</h2>
<div class="box ph" style="inset-inline-start: 24.5mm; inset-block-start: 158.9mm; inline-size: 105.8mm; block-size: 118.8mm; font-size: 37.4pt"></div>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 171.4mm; inline-size: 48.1mm; block-size: 14.8mm; font-size: 10.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 189.7mm; inline-size: 46.4mm; block-size: 18.9mm; font-size: 10.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 211.9mm; inline-size: 48.8mm; block-size: 14.8mm; font-size: 10.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 230.2mm; inline-size: 48.8mm; block-size: 27.0mm; font-size: 10.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 25.8mm; inset-block-start: 287.5mm; inline-size: 2.2mm; block-size: 2.0mm; font-size: 5.8pt">{{ slot_9 }}</footer>
</div></body>
</html>
