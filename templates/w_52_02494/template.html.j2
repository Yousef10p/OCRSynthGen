<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}


.header {
  background: #a9a9a9;
  height: 50px;
  line-height: 50px;
  text-align: center;
}


.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-gap: 20px;
  margin: 20px;
}

.menu-item {
  background: #00ff00;
  padding: 20px;
  border-radius: 10px;
}


.reserve {
  display: block;
  margin: auto;
  padding: 10px;
  color: white;
  background: #ff0000;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header class="header">
<h1>{{ slot_0 }}</h1>
</header>
<div class="menu-grid">
<div class="menu-item">{{ slot_1 }}<br>{{ slot_2 }}</div>
<div class="menu-item">{{ slot_3 }}<br>{{ slot_4 }}</div>
<div class="menu-item">{{ slot_5 }}<br>{{ slot_6 }}</div>
<div class="menu-item">{{ slot_7 }}<br>{{ slot_8 }}</div>
<div class="menu-item">{{ slot_9 }}<br>{{ slot_10 }}</div>
<div class="menu-item">{{ slot_11 }}<br>{{ slot_12 }}</div>
<div class="menu-item">{{ slot_13 }}<br>{{ slot_14 }}</div>
<div class="menu-item">{{ slot_15 }}<br>{{ slot_16 }}</div>
<div class="menu-item">{{ slot_17 }}<br>{{ slot_18 }}</div>
</div>
<button class="reserve">{{ slot_19 }}</button>
</body>
</html>