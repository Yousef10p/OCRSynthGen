<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-body);
    color: white;
    background-color: black;
}

ul {
    list-style: none;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    width: 100%;
    height: auto;
}

header {
    position: fixed;
    z-index: 1;
    top: 0;
    right: 0;
    width: 100%;
}

footer {
    position: fixed;
    z-index: 1;
    bottom: 0;
    right: 0;
    width: 100%;
    text-align: center;
}


nav ul {
    display: flex;
    justify-content: space-around;
    background-color: blue;
    padding: 20px 0;
}

nav ul li a {
    font-size: 20px;
    font-weight: bold;
    color: white;
}


#prod {
    margin-top: 70px;
    padding: 20px;
}

#prod .product {
    margin: 20px 0;
}

#prod .product img {
    background-color: blue;
    width: 100%;
    height: 200px;
    border-radius: 10px;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% {
        opacity: 0.5;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: 0.5;
    }
}


#testi {
    padding: 20px;
}

#testi .testimonial img {
    background-color: blue;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin: 0 auto 20px;
}


#blog {
    padding: 20px;
}

#blog article {
    margin: 20px 0;
}


#careers {
    padding: 20px;
}

#careers .job {
    margin: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
