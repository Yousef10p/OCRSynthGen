<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 142.7mm; inline-size: 79.9mm; block-size: 53.6mm; font-size: 12.7pt"></div>
<div class="box ph" style="inset-inline-start: 114.1mm; inset-block-start: 142.4mm; inline-size: 82.6mm; block-size: 53.6mm; font-size: 12.7pt"></div>
<div class="box ph" style="inset-inline-start: 24.4mm; inset-block-start: 202.2mm; inline-size: 81.5mm; block-size: 47.2mm; font-size: 33.5pt"></div>
<div class="box ph" style="inset-inline-start: 113.0mm; inset-block-start: 201.8mm; inline-size: 84.7mm; block-size: 47.4mm; font-size: 16.8pt"></div>
