<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 6.4mm; inset-block-start: 6.0mm; inline-size: 45.1mm; block-size: 34.8mm; font-size: 14.1pt"></div>
<div class="box ph" style="inset-inline-start: 57.1mm; inset-block-start: 6.1mm; inline-size: 44.9mm; block-size: 34.6mm; font-size: 14.0pt"></div>
<h2 class="box" style="inset-inline-start: 110.6mm; inset-block-start: 17.8mm; inline-size: 79.8mm; block-size: 11.9mm; font-size: 33.8pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 26.4mm; inset-block-start: 50.2mm; inline-size: 36.3mm; block-size: 5.6mm; font-size: 15.8pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 63.1mm; inline-size: 75.3mm; block-size: 26.9mm; font-size: 15.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 115.1mm; inset-block-start: 63.2mm; inline-size: 75.5mm; block-size: 83.4mm; font-size: 15.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 93.9mm; inline-size: 71.5mm; block-size: 21.1mm; font-size: 15.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 25.3mm; inset-block-start: 120.2mm; inline-size: 77.1mm; block-size: 91.4mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 115.1mm; inset-block-start: 150.5mm; inline-size: 74.9mm; block-size: 49.3mm; font-size: 15.5pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 115.1mm; inset-block-start: 203.6mm; inline-size: 75.2mm; block-size: 43.6mm; font-size: 15.5pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 38.4mm; inset-block-start: 211.8mm; inline-size: 50.8mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 26.4mm; inset-block-start: 220.4mm; inline-size: 71.4mm; block-size: 26.9mm; font-size: 15.2pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 25.8mm; inset-block-start: 263.2mm; inline-size: 34.9mm; block-size: 4.3mm; font-size: 12.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
