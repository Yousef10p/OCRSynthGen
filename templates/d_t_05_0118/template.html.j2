<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 29.2mm; inset-block-start: 25.5mm; inline-size: 101.7mm; block-size: 12.9mm; font-size: 36.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 29.2mm; inset-block-start: 76.7mm; inline-size: 37.7mm; block-size: 4.1mm; font-size: 11.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 29.2mm; inset-block-start: 86.0mm; inline-size: 125.5mm; block-size: 33.6mm; font-size: 13.6pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 29.2mm; inset-block-start: 123.7mm; inline-size: 125.5mm; block-size: 43.5mm; font-size: 13.7pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 79.2mm; inset-block-start: 186.9mm; inline-size: 75.0mm; block-size: 19.9mm; font-size: 18.8pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 151.4mm; inset-block-start: 263.7mm; inline-size: 50.6mm; block-size: 3.8mm; font-size: 10.8pt">{{ slot_5 }}</footer>
</div></body>
</html>
