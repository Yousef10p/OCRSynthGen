<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 40.3mm; inset-block-start: 44.4mm; inline-size: 135.3mm; block-size: 15.3mm; font-size: 20.7pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 36.8mm; inset-block-start: 67.4mm; inline-size: 77.7mm; block-size: 23.5mm; font-size: 14.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 124.3mm; inset-block-start: 67.4mm; inline-size: 54.8mm; block-size: 29.8mm; font-size: 14.3pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 76.2mm; inline-size: 6.3mm; block-size: 123.1mm; font-size: 20.0pt">{{ slot_3 }}</header><p class="box" style="inset-inline-start: 92.5mm; inset-block-start: 101.9mm; inline-size: 32.8mm; block-size: 5.3mm; font-size: 14.3pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 100.8mm; inset-block-start: 112.1mm; inline-size: 14.3mm; block-size: 3.5mm; font-size: 10.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 42.1mm; inset-block-start: 118.7mm; inline-size: 131.8mm; block-size: 65.6mm; font-size: 10.9pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 31.7mm; inset-block-start: 194.0mm; inline-size: 35.1mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 31.7mm; inset-block-start: 204.9mm; inline-size: 152.4mm; block-size: 37.5mm; font-size: 12.0pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 36.5mm; inset-block-start: 246.5mm; inline-size: 131.1mm; block-size: 3.1mm; font-size: 7.6pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 106.9mm; inset-block-start: 256.6mm; inline-size: 2.1mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_10 }}</footer>
</div></body>
</html>
