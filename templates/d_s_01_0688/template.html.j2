<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 13.0mm; inset-block-start: 18.5mm; inline-size: 41.3mm; block-size: 8.2mm; font-size: 9.9pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 11.5mm; inset-block-start: 29.7mm; inline-size: 89.2mm; block-size: 98.8mm; font-size: 11.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 105.8mm; inset-block-start: 29.2mm; inline-size: 89.4mm; block-size: 89.1mm; font-size: 11.8pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 106.2mm; inset-block-start: 120.7mm; inline-size: 53.2mm; block-size: 4.7mm; font-size: 11.8pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 106.3mm; inset-block-start: 126.1mm; inline-size: 88.9mm; block-size: 64.9mm; font-size: 11.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 11.5mm; inset-block-start: 128.9mm; inline-size: 90.7mm; block-size: 89.4mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 106.8mm; inset-block-start: 191.2mm; inline-size: 88.4mm; block-size: 34.5mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 12.5mm; inset-block-start: 219.0mm; inline-size: 89.4mm; block-size: 41.2mm; font-size: 11.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 107.0mm; inset-block-start: 226.0mm; inline-size: 88.1mm; block-size: 34.2mm; font-size: 11.8pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 101.2mm; inset-block-start: 263.0mm; inline-size: 4.8mm; block-size: 3.9mm; font-size: 9.9pt">{{ slot_9 }}</footer>
</div></body>
</html>
