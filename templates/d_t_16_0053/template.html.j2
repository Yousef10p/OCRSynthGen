<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 23.5mm; inset-block-start: 14.0mm; inline-size: 174.3mm; block-size: 29.1mm; font-size: 13.8pt"></div>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 57.9mm; inline-size: 83.3mm; block-size: 25.1mm; font-size: 11.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 58.8mm; inline-size: 86.2mm; block-size: 111.7mm; font-size: 12.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 88.3mm; inline-size: 83.2mm; block-size: 20.7mm; font-size: 11.8pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 114.3mm; inset-block-start: 113.8mm; inline-size: 53.8mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 119.7mm; inline-size: 83.4mm; block-size: 77.1mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 175.8mm; inline-size: 83.2mm; block-size: 20.7mm; font-size: 11.8pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 23.4mm; inset-block-start: 204.2mm; inline-size: 174.6mm; block-size: 50.4mm; font-size: 14.3pt"></div>
<p class="box" style="inset-inline-start: 23.8mm; inset-block-start: 256.5mm; inline-size: 173.6mm; block-size: 6.3mm; font-size: 8.9pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 188.5mm; inset-block-start: 269.1mm; inline-size: 9.0mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_7 }}</footer>
</div></body>
</html>
