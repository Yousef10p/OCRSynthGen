<p class="box" style="inset-inline-start: 13.8mm; inset-block-start: 144.5mm; inline-size: 187.7mm; block-size: 12.1mm; font-size: 17.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 13.8mm; inset-block-start: 158.6mm; inline-size: 178.9mm; block-size: 12.1mm; font-size: 17.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 11.6mm; inset-block-start: 178.8mm; inline-size: 91.0mm; block-size: 31.4mm; font-size: 11.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 115.4mm; inset-block-start: 179.8mm; inline-size: 84.6mm; block-size: 12.2mm; font-size: 11.5pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 111.1mm; inset-block-start: 193.6mm; inline-size: 88.9mm; block-size: 35.1mm; font-size: 12.4pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 13.8mm; inset-block-start: 211.9mm; inline-size: 88.9mm; block-size: 16.7mm; font-size: 11.9pt">{{ slot_7 }}</p>
<ul class="box" style="inset-inline-start: 13.8mm; inset-block-start: 230.2mm; inline-size: 88.9mm; block-size: 16.7mm; font-size: 11.9pt"><li>{{ slot_8 }}</li></ul>
<ul class="box" style="inset-inline-start: 111.1mm; inset-block-start: 230.2mm; inline-size: 88.9mm; block-size: 30.5mm; font-size: 12.4pt"><li>{{ slot_9 }}</li></ul>
<ul class="box" style="inset-inline-start: 13.8mm; inset-block-start: 248.6mm; inline-size: 88.9mm; block-size: 12.2mm; font-size: 11.5pt"><li>{{ slot_10 }}</li></ul>
<footer class="box" style="inset-inline-start: 202.4mm; inset-block-start: 269.6mm; inline-size: 1.9mm; block-size: 2.8mm; font-size: 8.0pt">{{ slot_11 }}</footer>
</div></body>
</html>
