<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  display: grid;
  grid-template-areas: 
    "hero hero hero"
    "sidebar-left main-content sidebar-right";
  grid-template-columns: 1fr 1fr 1fr;
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

.hero-header {
  grid-area: hero;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200px;
  background: #eee;
}

.left-sidebar {
  grid-area: sidebar-left;
  padding: 10px;
  background: #eee;
}

.right-sidebar {
  grid-area: sidebar-right;
  padding: 10px;
  background: #eee;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header class="hero-header">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<h1>{{ slot_2 }}</h1>
<p>{{ slot_3 }}</p>
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</header>
<aside class="left-sidebar">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</aside>
<aside class="right-sidebar">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
<h2>{{ slot_16 }}</h2>
<p>{{ slot_17 }}</p>
</aside>
</body>
</html>