<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A5 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 148mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 13.1mm; inline-size: 116.0mm; block-size: 7.3mm; font-size: 10.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 21.7mm; inline-size: 116.0mm; block-size: 37.3mm; font-size: 11.8pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 60.4mm; inline-size: 116.0mm; block-size: 11.6mm; font-size: 10.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 77.5mm; inline-size: 116.0mm; block-size: 20.1mm; font-size: 11.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 48.1mm; inset-block-start: 99.0mm; inline-size: 53.3mm; block-size: 3.0mm; font-size: 8.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 16.3mm; inset-block-start: 100.1mm; inline-size: 21.6mm; block-size: 33.5mm; font-size: 15.8pt"></div>
<p class="box" style="inset-inline-start: 48.1mm; inset-block-start: 103.3mm; inline-size: 83.9mm; block-size: 37.3mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 15.9mm; inset-block-start: 136.0mm; inline-size: 25.0mm; block-size: 4.1mm; font-size: 5.9pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 16.0mm; inset-block-start: 201.6mm; inline-size: 6.4mm; block-size: 1.8mm; font-size: 5.0pt">{{ slot_7 }}</footer>
</div></body>
</html>
