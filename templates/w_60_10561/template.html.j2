<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
}
body {
  display: flex;
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}
nav {
  width: 200px;
  background-color: #f8f8f8;
  padding: 20px;
}
nav ul {
  list-style-type: none;
  padding: 0;
}
header .banner {
  background-color: #8c8c8c;
  color: #fff;
  font-size: 2em;
  padding: 20px;
  text-align: center;
}
main {
  flex: 1;
  padding: 20px;
}
.service {
  margin-bottom: 40px;
}
h2 {
  color: #222;
}
p {
  color: #555;
}
.chart, .graph {
  background-color: #ccc;
  height: 200px;
  margin-top: 20px;
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="banner">{{ slot_0 }}</div>
</header>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<main>
<div class="service service1" id="service1">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<div class="chart chart1">{{ slot_6 }}</div>
<div class="graph graph1">{{ slot_7 }}</div>
</div>
<div class="service service2" id="service2">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
<div class="chart chart2">{{ slot_10 }}</div>
<div class="graph graph2">{{ slot_11 }}</div>
</div>
<div class="service service3" id="service3">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<div class="chart chart3">{{ slot_14 }}</div>
<div class="graph graph3">{{ slot_15 }}</div>
</div>
</main>
</body>
</html>