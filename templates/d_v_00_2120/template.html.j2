<p class="box" style="inset-inline-start: 30.7mm; inset-block-start: 125.2mm; inline-size: 152.3mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 27.3mm; inset-block-start: 148.9mm; inline-size: 162.6mm; block-size: 26.8mm; font-size: 10.9pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 27.3mm; inset-block-start: 179.5mm; inline-size: 162.6mm; block-size: 19.1mm; font-size: 10.9pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 27.3mm; inset-block-start: 202.4mm; inline-size: 162.5mm; block-size: 11.5mm; font-size: 10.9pt"><li>{{ slot_7 }}</li></ul>
