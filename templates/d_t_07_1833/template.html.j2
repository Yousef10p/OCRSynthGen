<p class="box" style="inset-inline-start: 106.5mm; inset-block-start: 63.5mm; inline-size: 83.5mm; block-size: 17.9mm; font-size: 10.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 106.5mm; inset-block-start: 82.6mm; inline-size: 83.7mm; block-size: 17.9mm; font-size: 10.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.5mm; inset-block-start: 95.5mm; inline-size: 85.4mm; block-size: 48.1mm; font-size: 15.2pt">{{ slot_6 }}</p>
