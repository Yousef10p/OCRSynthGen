}

#departments, #resources {
    flex: 1;
}

#departments ul, #resources ul {
    list-style-type: none;
    padding: 0;
}

#departments ul li a, #resources ul li a {
    color: #fff;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
