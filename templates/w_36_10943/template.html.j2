<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

html, body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

.hero, .navbar, .content div {
  padding: 20px;
  box-sizing: border-box;
}

.hero {
  height: 300px;
  background-color: #eee;
  text-align: center;
  line-height: 300px;
}

.navbar ul {
  display: flex;
  justify-content: center;
  list-style-type: none;
  padding: 0;
}

.navbar li {
  margin: 0 20px;
}

.content {
  display: flex;
}

.left-column, .right-column {
  width: 50%;
}

.image {
  height: 200px;
  background-color: #ddd;
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<p>{{ slot_0 }}</p>
</div>
<div class="navbar">
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
<div class="content">
<div class="left-column">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="right-column">
<h2>{{ slot_10 }}</h2>
<div class="image ph"></div>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<div class="image ph"></div>
<p>{{ slot_13 }}</p>
<h2>{{ slot_14 }}</h2>
<div class="image ph"></div>
<p>{{ slot_15 }}</p>
</div>
</div>
</body>
</html>