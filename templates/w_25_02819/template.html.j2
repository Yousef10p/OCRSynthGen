    grid-template-columns: 1fr 3fr;
    grid-template-rows: auto auto auto;
    gap: 1em;
}
header, footer {
    grid-column: 1 / span 2;
    background-color: #f5f5f5;
    padding: 1em;
    text-align: center;
}
nav {
