<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 46.1mm; inset-block-start: 48.4mm; inline-size: 133.3mm; block-size: 28.3mm; font-size: 20.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 45.9mm; inset-block-start: 80.6mm; inline-size: 139.0mm; block-size: 36.0mm; font-size: 20.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 45.5mm; inset-block-start: 120.5mm; inline-size: 139.7mm; block-size: 35.6mm; font-size: 20.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 46.0mm; inset-block-start: 164.1mm; inline-size: 54.8mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 45.1mm; inset-block-start: 172.1mm; inline-size: 143.1mm; block-size: 20.0mm; font-size: 18.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 45.3mm; inset-block-start: 196.1mm; inline-size: 144.3mm; block-size: 19.8mm; font-size: 11.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 45.1mm; inset-block-start: 219.6mm; inline-size: 137.4mm; block-size: 20.5mm; font-size: 19.4pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 113.0mm; inset-block-start: 263.0mm; inline-size: 9.3mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_7 }}</footer>
</div></body>
</html>
