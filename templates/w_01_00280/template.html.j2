:root {
    --color-primary: #3498db;
    --color-secondary: #ecf0f1;
}
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    font-family: var(--font-body);
}
.logo,
.image-placeholder {
