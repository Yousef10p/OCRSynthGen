    color: var(--color-secondary);
    text-align: center;
}
.social-links {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
}
.social-links a {
    color: var(--color-secondary);
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
