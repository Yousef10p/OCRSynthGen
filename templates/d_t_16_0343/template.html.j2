<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 12.9mm; inset-block-start: 16.0mm; inline-size: 177.0mm; block-size: 91.9mm; font-size: 7.4pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 111.2mm; inline-size: 138.4mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 23.5mm; inset-block-start: 120.6mm; inline-size: 80.0mm; block-size: 21.3mm; font-size: 12.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 120.6mm; inline-size: 89.6mm; block-size: 16.8mm; font-size: 11.9pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 144.7mm; inline-size: 86.1mm; block-size: 30.3mm; font-size: 12.3pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 143.1mm; inline-size: 89.2mm; block-size: 70.9mm; font-size: 12.6pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 180.8mm; inline-size: 89.8mm; block-size: 48.4mm; font-size: 9.8pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 219.0mm; inline-size: 50.7mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 225.6mm; inline-size: 86.9mm; block-size: 30.3mm; font-size: 12.3pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 235.0mm; inline-size: 86.9mm; block-size: 21.3mm; font-size: 12.1pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.8mm; inline-size: 5.2mm; block-size: 4.4mm; font-size: 12.6pt">{{ slot_9 }}</footer>
</div></body>
</html>
