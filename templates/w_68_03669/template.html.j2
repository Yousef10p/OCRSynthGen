  padding: 1em;
  border-radius: 10px;
}

label {
  color: black;
  font-weight: bold;
}

.input-field {
  width: 100%;
  padding: 0.5em;
  margin: 0.5em 0 1em 0;
  box-sizing: border-box;
  border: 1px solid #002651;
}

.button {
  background-color: #17A2B8;
  color: white;
  padding: 0.5em 1em;
  border: none;
  cursor: pointer
}

.button:hover {
  opacity: 0.8;
}


nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  background-color: #002651;
  color: #FFFFFF;
  margin: 0.5em 0;
  padding: 0.5em;
  border-radius: 10px;
}

nav ul li:hover {
  opacity: 0.8;
}

nav ul li a {
  text-decoration: none;
  color: #17A2B8;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
