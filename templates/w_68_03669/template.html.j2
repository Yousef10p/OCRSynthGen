body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
  color: #002651;
  background-color: #F0F0F0;
}


aside, main {
  float: right;
  padding: 1em;
  box-sizing: border-box;
  height: 500px;
  overflow-y: auto;
}

aside {
  width: 20%;
}

main {
  width: 60%;
}

section.middle {
  margin: 0 1%;
}

main::after {
  content: "";
  clear: both;
  display: table;
}


header {
  width: 100%;
  height: 200px;
  background-color: #074580;
  color: #FFFFFF;
  text-align: center;
  padding: 3em 0;
}


form {
