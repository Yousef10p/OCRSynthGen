    right: 0;
    width: 20%;
}

nav ul {
    list-style-type: none;
}

.hero {
    position: relative;
    background: none;
    background-size: cover;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.tutorials, .reviews {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.tutorial, .review {
    margin: 20px 0;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    background: #333;
    color: #fff;
    display: flex;
    justify-content: space-around;
    padding: 20px 0;
}

footer ul {
    list-style-type: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
