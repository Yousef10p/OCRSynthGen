    grid-template-areas:
    "navbar navbar navbar navbar navbar"
    "sidebar top_stories top_stories top_stories image"
    "sidebar top_stories top_stories image";
    grid-gap: 10px;
    background-color: #ffffff;
    padding: 10px;
}
.navbar {
