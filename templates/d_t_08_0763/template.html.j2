<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 53.8mm; inset-block-start: 45.3mm; inline-size: 108.2mm; block-size: 5.4mm; font-size: 17.2pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 66.9mm; inset-block-start: 60.3mm; inline-size: 82.0mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 89.4mm; inset-block-start: 72.1mm; inline-size: 37.2mm; block-size: 3.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 75.7mm; inline-size: 6.3mm; block-size: 125.4mm; font-size: 20.0pt">{{ slot_3 }}</header><h2 class="box" style="inset-inline-start: 100.2mm; inset-block-start: 86.7mm; inline-size: 15.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 94.9mm; inline-size: 145.9mm; block-size: 78.2mm; font-size: 10.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 184.8mm; inline-size: 39.9mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 197.2mm; inline-size: 165.1mm; block-size: 57.6mm; font-size: 10.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 107.0mm; inset-block-start: 261.9mm; inline-size: 1.9mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_8 }}</footer>
</div></body>
</html>
