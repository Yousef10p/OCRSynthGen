<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 36.3mm; inset-block-start: 32.9mm; inline-size: 98.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 169.3mm; inset-block-start: 32.9mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 47.4mm; inline-size: 74.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 91.8mm; inset-block-start: 59.5mm; inline-size: 81.7mm; block-size: 10.6mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 36.3mm; inset-block-start: 77.8mm; inline-size: 137.1mm; block-size: 30.0mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 79.3mm; inset-block-start: 114.8mm; inline-size: 94.1mm; block-size: 11.3mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 89.5mm; inset-block-start: 136.0mm; inline-size: 83.9mm; block-size: 11.3mm; font-size: 10.0pt"></div>
<div class="box ph" style="inset-inline-start: 89.5mm; inset-block-start: 157.1mm; inline-size: 83.9mm; block-size: 10.6mm; font-size: 12.0pt"></div>
<div class="box ph" style="inset-inline-start: 89.5mm; inset-block-start: 177.7mm; inline-size: 83.9mm; block-size: 10.1mm; font-size: 12.0pt"></div>
