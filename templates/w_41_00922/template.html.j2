}

nav ul li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

main {
    padding: 20px;
}

footer div {
    float: right;
    margin-left: 20px;
}

footer input[type="text"] {
    width: 150px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
