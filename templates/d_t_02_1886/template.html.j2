<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 16.9mm; inline-size: 176.0mm; block-size: 40.3mm; font-size: 28.6pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 33.0mm; inset-block-start: 85.7mm; inline-size: 151.1mm; block-size: 5.1mm; font-size: 14.6pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 96.3mm; inline-size: 89.1mm; block-size: 13.5mm; font-size: 12.7pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 96.3mm; inline-size: 89.3mm; block-size: 29.4mm; font-size: 13.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 114.8mm; inline-size: 87.8mm; block-size: 18.8mm; font-size: 13.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 130.7mm; inline-size: 87.8mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.9mm; inset-block-start: 138.6mm; inline-size: 87.8mm; block-size: 13.5mm; font-size: 12.7pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 145.3mm; inline-size: 45.4mm; block-size: 2.3mm; font-size: 6.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 26.0mm; inset-block-start: 168.3mm; inline-size: 158.7mm; block-size: 7.7mm; font-size: 21.9pt">{{ slot_8 }}</p>
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 190.0mm; inline-size: 215.8mm; block-size: 89.3mm; font-size: 40.0pt"></div>
</div></body>
</html>
