<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 67.0mm; inset-block-start: 4.6mm; inline-size: 142.8mm; block-size: 230.8mm; font-size: 14.9pt"></div>
<h2 class="box" style="inset-inline-start: 5.4mm; inset-block-start: 58.5mm; inline-size: 43.8mm; block-size: 11.0mm; font-size: 10.4pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 5.4mm; inset-block-start: 74.6mm; inline-size: 56.2mm; block-size: 38.9mm; font-size: 11.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 5.4mm; inset-block-start: 118.6mm; inline-size: 56.4mm; block-size: 74.9mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 101.3mm; inset-block-start: 240.2mm; inline-size: 85.8mm; block-size: 16.7mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 103.4mm; inset-block-start: 259.3mm; inline-size: 44.0mm; block-size: 5.7mm; font-size: 8.1pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 86.5mm; inset-block-start: 283.7mm; inline-size: 36.8mm; block-size: 1.4mm; font-size: 5.0pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 103.9mm; inset-block-start: 287.3mm; inline-size: 1.8mm; block-size: 1.1mm; font-size: 5.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
