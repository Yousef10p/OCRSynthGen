<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
</header>
<main>
<section>
<h2>{{ slot_8 }}</h2>
<div class="programs">
<div class="program">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
</div>
<div class="program">
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}</p>
</div>
<div class="program">
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</div>
</div>
</section>
</main>
</body>
</html>