    padding: 0;
}

header, footer {
    background-color: #f8f9fa;
    padding: 20px;
}

nav a {
    margin-left: 10px;
}

main {
    margin: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    grid-gap: 20px;
}

article {
    border: 1px solid #dee2e6;
    padding: 20px;
}

div.placeholder-img {
    background-color: #dee2e6;
    width: 100%;
