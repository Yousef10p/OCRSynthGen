<p class="box" style="inset-inline-start: 60.8mm; inset-block-start: 71.6mm; inline-size: 128.8mm; block-size: 38.4mm; font-size: 12.1pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 57.0mm; inset-block-start: 111.1mm; inline-size: 51.3mm; block-size: 4.2mm; font-size: 11.8pt"><li>{{ slot_5 }}</li></ul>
<p class="box" style="inset-inline-start: 60.8mm; inset-block-start: 117.0mm; inline-size: 128.2mm; block-size: 24.7mm; font-size: 11.7pt">{{ slot_6 }}</p>
