    max-width: 1200px;
}

article {
    background-color: #FF8800;
    padding: 20px;
    text-align: center;
    color: white;
}

img {
    width: 100%;
    height: 400px;
    background-color: #0088FF;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
