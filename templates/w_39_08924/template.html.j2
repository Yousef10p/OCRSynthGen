.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: column;
    align-items: center;
}

header {
    width: 100%;
    background-color: #FF8800;
    text-align: center;
    padding: 20px;
    color: white;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
