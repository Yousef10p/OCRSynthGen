<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 25.1mm; inset-block-start: 22.8mm; inline-size: 1.6mm; block-size: 2.3mm; font-size: 9.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 91.7mm; inset-block-start: 22.8mm; inline-size: 26.8mm; block-size: 2.3mm; font-size: 9.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 29.3mm; inset-block-start: 30.4mm; inline-size: 76.7mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 44.4mm; inline-size: 160.0mm; block-size: 20.3mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 74.7mm; inline-size: 120.4mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 67.1mm; inset-block-start: 84.7mm; inline-size: 118.0mm; block-size: 10.0mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 100.4mm; inline-size: 159.9mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 25.1mm; inset-block-start: 107.2mm; inline-size: 152.2mm; block-size: 85.3mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 29.3mm; inset-block-start: 198.8mm; inline-size: 88.9mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 57.4mm; inset-block-start: 211.1mm; inline-size: 127.7mm; block-size: 17.5mm; font-size: 12.0pt"></div>
<p class="box" style="inset-inline-start: 25.1mm; inset-block-start: 236.8mm; inline-size: 160.0mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 70.1mm; inset-block-start: 255.3mm; inline-size: 115.0mm; block-size: 18.2mm; font-size: 12.0pt"></div>
</div></body>
</html>
