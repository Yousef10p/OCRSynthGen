<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.8em">
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}<ol style="list-style-type: decimal; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
</ol>
</li>
</ul></main><footer style="display: flex; justify-content: space-between; gap: 1em; font-size: 0.85em; padding-block: 0.3em; margin-block: 0.8em; border-block-start: 1px solid #444"><span>{{ slot_13 }}</span></footer>
</div></body>
</html>
