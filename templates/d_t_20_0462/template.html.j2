<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 114.7mm; inset-block-start: 25.2mm; inline-size: 89.5mm; block-size: 50.1mm; font-size: 15.8pt"></div>
<div class="box ph" style="inset-inline-start: 18.0mm; inset-block-start: 31.5mm; inline-size: 89.5mm; block-size: 54.9mm; font-size: 15.6pt"></div>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 77.3mm; inline-size: 20.0mm; block-size: 3.6mm; font-size: 8.5pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 114.9mm; inset-block-start: 84.0mm; inline-size: 89.1mm; block-size: 66.9mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 88.7mm; inline-size: 80.2mm; block-size: 7.3mm; font-size: 8.5pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 18.3mm; inset-block-start: 99.0mm; inline-size: 89.2mm; block-size: 118.9mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 152.9mm; inline-size: 70.2mm; block-size: 7.3mm; font-size: 8.5pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 114.6mm; inset-block-start: 163.2mm; inline-size: 89.5mm; block-size: 66.9mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 17.8mm; inset-block-start: 219.9mm; inline-size: 74.1mm; block-size: 7.3mm; font-size: 8.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 114.3mm; inset-block-start: 232.2mm; inline-size: 36.1mm; block-size: 3.6mm; font-size: 8.5pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 106.2mm; inset-block-start: 261.1mm; inline-size: 3.7mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
