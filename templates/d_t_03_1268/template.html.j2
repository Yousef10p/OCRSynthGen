<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 9.8mm; inset-block-start: 11.4mm; inline-size: 88.3mm; block-size: 9.7mm; font-size: 13.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 9.8mm; inset-block-start: 19.5mm; inline-size: 72.1mm; block-size: 7.8mm; font-size: 7.3pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 9.8mm; inset-block-start: 36.9mm; inline-size: 36.4mm; block-size: 4.9mm; font-size: 6.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 93.5mm; inset-block-start: 36.9mm; inline-size: 81.0mm; block-size: 32.7mm; font-size: 11.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 9.8mm; inset-block-start: 40.9mm; inline-size: 79.7mm; block-size: 24.7mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 9.8mm; inset-block-start: 66.8mm; inline-size: 81.2mm; block-size: 64.5mm; font-size: 11.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 93.5mm; inset-block-start: 70.7mm; inline-size: 66.2mm; block-size: 8.8mm; font-size: 12.4pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 91.6mm; inset-block-start: 85.1mm; inline-size: 19.7mm; block-size: 6.0mm; font-size: 17.1pt"></div>
<p class="box" style="inset-inline-start: 93.5mm; inset-block-start: 92.5mm; inline-size: 20.9mm; block-size: 8.8mm; font-size: 12.5pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 93.5mm; inset-block-start: 124.3mm; inline-size: 23.0mm; block-size: 8.8mm; font-size: 12.4pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 9.8mm; inset-block-start: 132.4mm; inline-size: 33.0mm; block-size: 4.9mm; font-size: 13.8pt">{{ slot_9 }}</h2>
<footer class="box" style="inset-inline-start: 9.8mm; inset-block-start: 263.0mm; inline-size: 2.7mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_10 }}</footer>
</div></body>
</html>
