<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
}

body {
    font-family: var(--font-body);
    line-height: 1.6;
}

.nav-bar {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background-color: #333;
    color: #fff;
    height: 60px;
}

.nav-bar ul {
    list-style: none;
    display: flex;
}

.nav-bar ul li a {
    color: #fff;
    text-decoration: none;
    padding: 7px 13px;
}

.hero-video, .portfolio, .testimonials, .about-us {
    text-align: center;
    padding: 1em;
}

.container {
    display: flex;
    justify-content: space-around;
}

.placeholder {
    width: 200px;
    height: 200px;
    background-color: #ccc;
}

.hero-video h1, .portfolio h2, .testimonials h2, .about-us h2 {
    margin-bottom: 1em;
}

.btn {
    display: inline-block;
    background-color: #333;
    color: #fff;
    padding: 10px 20px;
    margin-top: 1em;
    text-decoration: none;
}

.testimonials .container, .about-us .container {
    margin-top: 2em;
}

footer {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 1em;
    position: fixed;
    width: 100%;
    bottom: 0;
}


@media(max-width: 768px) {
    .container {
        flex-direction: column;
    }

    .project {
        margin: 1em 0;
    }

    .btn {
        margin-top: 0.5em;
    }
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
