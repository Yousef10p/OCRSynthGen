<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-areas: 
        "header header"
        "performers ticket";
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 10px;
}

.header {
    grid-area: header;
    background-color: lavender;
    padding: 10px;
}

.stages {
    grid-area: performers;
}

.stage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 10px 0;
}

.performer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 10px 0;
}

.ticket {
    grid-area: ticket;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.types {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 10px 0;
}

.button {
    grid-area: ticket;
    margin: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">{{ slot_0 }}</div>
<div class="stages">
<div class="stage">
<div class="performers">
<div class="performer">
<div class="name">{{ slot_1 }}</div>
<div class="details">{{ slot_2 }}</div>
</div>
<div class="performer">
<div class="name">{{ slot_3 }}</div>
<div class="details">{{ slot_4 }}</div>
</div>
</div>
<div class="date">{{ slot_5 }}</div>
</div>
<div class="stage">
<div class="performers">
<div class="performer">
<div class="name">{{ slot_6 }}</div>
<div class="details">{{ slot_7 }}</div>
</div>
<div class="performer">
<div class="name">{{ slot_8 }}</div>
<div class="details">{{ slot_9 }}</div>
</div>
</div>
<div class="date">{{ slot_10 }}</div>
</div>
</div>
<div class="ticket">
<div class="types">
<div class="type">{{ slot_11 }}</div>
<div class="price">{{ slot_12 }}</div>
</div>
<div class="types">
<div class="type">{{ slot_13 }}</div>
<div class="price">{{ slot_14 }}</div>
</div>
<button>{{ slot_15 }}</button>
</div>
</body>
</html>