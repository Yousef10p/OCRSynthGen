<div class="option">{{ slot_7 }}</div>
<div class="option">{{ slot_8 }}</div>
</div>
</div>
<div id="content">
<h1>{{ slot_9 }}</h1>
<p>{{ slot_10 }}</p>
<div id="product-grid">
