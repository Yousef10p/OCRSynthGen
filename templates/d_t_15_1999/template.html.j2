<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 279.4mm; --page-height: 215.9mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.9mm; inset-block-start: 9.5mm; inline-size: 214.9mm; block-size: 28.2mm; font-size: 39.9pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 47.3mm; inset-block-start: 41.7mm; inline-size: 183.4mm; block-size: 119.6mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 8.5mm; inset-block-start: 163.5mm; inline-size: 262.0mm; block-size: 23.6mm; font-size: 33.4pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 174.2mm; inset-block-start: 190.6mm; inline-size: 21.3mm; block-size: 20.2mm; font-size: 14.3pt"></div>
<footer class="box" style="inset-inline-start: 16.5mm; inset-block-start: 193.1mm; inline-size: 77.4mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_2 }}</footer><footer class="box" style="inset-inline-start: 197.9mm; inset-block-start: 195.0mm; inline-size: 36.8mm; block-size: 11.2mm; font-size: 15.9pt">{{ slot_3 }}</footer><footer class="box" style="inset-inline-start: 262.2mm; inset-block-start: 197.0mm; inline-size: 5.2mm; block-size: 6.5mm; font-size: 18.4pt">{{ slot_4 }}</footer>
</div></body>
</html>
