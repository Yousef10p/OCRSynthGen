.ph { background: #d0d0d0; }

html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    background-color: #f0f0f0;
}

h1, h2 {
    text-align: center;
    color: #4CAF50;
}

header {
    background-color: #2196F3;
    padding: 20px;
