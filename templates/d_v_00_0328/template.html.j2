<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.1mm; inset-block-start: 37.5mm; inline-size: 48.7mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 106.8mm; inset-block-start: 37.5mm; inline-size: 66.0mm; block-size: 9.4mm; font-size: 13.4pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 43.4mm; inline-size: 68.9mm; block-size: 44.5mm; font-size: 15.8pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 106.8mm; inset-block-start: 55.0mm; inline-size: 52.6mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 106.8mm; inset-block-start: 60.9mm; inline-size: 71.3mm; block-size: 50.4mm; font-size: 15.9pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 20.1mm; inset-block-start: 96.0mm; inline-size: 58.9mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 101.8mm; inline-size: 72.0mm; block-size: 62.0mm; font-size: 16.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 103.5mm; inset-block-start: 136.5mm; inline-size: 74.9mm; block-size: 36.2mm; font-size: 40.0pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 6.0mm; inset-block-start: 186.5mm; inline-size: 174.9mm; block-size: 98.3mm; font-size: 40.0pt"></div>
<header class="box" style="inset-inline-start: 194.7mm; inset-block-start: 279.2mm; inline-size: 1.5mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_8 }}</header><footer class="box" style="inset-inline-start: 133.4mm; inset-block-start: 286.9mm; inline-size: 65.4mm; block-size: 2.3mm; font-size: 6.5pt">{{ slot_9 }}</footer>
</div></body>
</html>
