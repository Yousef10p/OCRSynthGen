<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 54.0mm; inset-block-start: 45.8mm; inline-size: 107.9mm; block-size: 57.7mm; font-size: 13.6pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 47.1mm; inset-block-start: 131.5mm; inline-size: 121.7mm; block-size: 15.1mm; font-size: 40.0pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 34.8mm; inset-block-start: 206.4mm; inline-size: 61.0mm; block-size: 38.2mm; font-size: 18.0pt"></div>
<div class="box ph" style="inset-inline-start: 120.6mm; inset-block-start: 206.4mm; inline-size: 60.8mm; block-size: 38.2mm; font-size: 21.6pt"></div>
<footer class="box" style="inset-inline-start: 91.6mm; inset-block-start: 263.2mm; inline-size: 23.9mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_2 }}</footer><footer class="box" style="inset-inline-start: 124.3mm; inset-block-start: 263.2mm; inline-size: 2.3mm; block-size: 2.0mm; font-size: 5.7pt">{{ slot_3 }}</footer>
</div></body>
</html>
