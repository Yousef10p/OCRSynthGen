<p class="box" style="inset-inline-start: 77.4mm; inset-block-start: 243.3mm; inline-size: 56.9mm; block-size: 11.8mm; font-size: 11.2pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 14.8mm; inset-block-start: 261.1mm; inline-size: 1.6mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 182.7mm; inset-block-start: 261.2mm; inline-size: 15.6mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_9 }}</footer>
</div></body>
</html>
