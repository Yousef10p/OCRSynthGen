<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 45.8mm; inset-block-start: 29.4mm; inline-size: 121.5mm; block-size: 115.5mm; font-size: 14.9pt"></div>
<h2 class="box" style="inset-inline-start: 16.9mm; inset-block-start: 60.4mm; inline-size: 25.5mm; block-size: 6.9mm; font-size: 9.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 15.1mm; inset-block-start: 69.9mm; inline-size: 27.7mm; block-size: 45.4mm; font-size: 10.7pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 14.8mm; inset-block-start: 168.4mm; inline-size: 56.5mm; block-size: 11.8mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 77.4mm; inset-block-start: 168.4mm; inline-size: 56.2mm; block-size: 20.6mm; font-size: 11.7pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 139.3mm; inset-block-start: 173.5mm; inline-size: 59.2mm; block-size: 28.0mm; font-size: 11.3pt"></div>
<p class="box" style="inset-inline-start: 14.8mm; inset-block-start: 181.6mm; inline-size: 58.1mm; block-size: 47.1mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 77.4mm; inset-block-start: 190.4mm; inline-size: 57.2mm; block-size: 51.5mm; font-size: 12.2pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 139.7mm; inset-block-start: 204.4mm; inline-size: 59.1mm; block-size: 27.5mm; font-size: 11.1pt"></div>
