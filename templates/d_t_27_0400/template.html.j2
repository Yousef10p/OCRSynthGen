<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 25.2mm; inline-size: 135.6mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 47.7mm; inset-block-start: 37.6mm; inline-size: 107.9mm; block-size: 149.7mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 188.4mm; inline-size: 86.0mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 50.4mm; inset-block-start: 201.4mm; inline-size: 139.5mm; block-size: 7.5mm; font-size: 10.6pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 50.4mm; inset-block-start: 211.6mm; inline-size: 70.5mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 50.4mm; inset-block-start: 217.6mm; inline-size: 140.6mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 50.4mm; inset-block-start: 227.9mm; inline-size: 140.5mm; block-size: 7.5mm; font-size: 10.6pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 50.4mm; inset-block-start: 237.2mm; inline-size: 128.0mm; block-size: 8.4mm; font-size: 11.9pt"><li>{{ slot_6 }}</li></ul>
<footer class="box" style="inset-inline-start: 111.7mm; inset-block-start: 266.3mm; inline-size: 81.3mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_7 }}</footer>
</div></body>
</html>
