<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    height: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

header {
    width: 100%;
    background-color: #FF0000;
    position: sticky;
    top: 0;
}

.hero {
    width: 100%;
    height: 200px;
    background-image: none;
    display: flex;
    justify-content: center;
    align-items: center;
}

.content {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.leftColumn, .rightColumn {
    width: 45%;
}

nav {
    display: flex;
    justify-content: space-around;
    padding: 1em;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</nav>
</header>
<div class="hero">
<h1>{{ slot_6 }}</h1>
</div>
<div class="content">
<div class="leftColumn">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</div>
<div class="rightColumn">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
</div>
</div>
</body>
</html>