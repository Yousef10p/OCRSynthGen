<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 20.0mm; inset-block-start: 32.6mm; inline-size: 50.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 142.5mm; inset-block-start: 32.6mm; inline-size: 47.5mm; block-size: 3.1mm; font-size: 10.0pt">{{ slot_1 }}</header><ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 43.7mm; inline-size: 165.6mm; block-size: 24.3mm; font-size: 10.0pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 71.8mm; inline-size: 163.7mm; block-size: 28.5mm; font-size: 10.0pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 104.2mm; inline-size: 160.9mm; block-size: 15.8mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 123.9mm; inline-size: 162.2mm; block-size: 11.6mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 24.4mm; inset-block-start: 139.3mm; inline-size: 159.6mm; block-size: 7.4mm; font-size: 10.0pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 22.6mm; inset-block-start: 150.6mm; inline-size: 160.8mm; block-size: 11.6mm; font-size: 10.0pt"><li>{{ slot_7 }}</li></ul>
<p class="box" style="inset-inline-start: 20.0mm; inset-block-start: 168.1mm; inline-size: 12.0mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 101.5mm; inset-block-start: 286.6mm; inline-size: 7.0mm; block-size: 3.2mm; font-size: 10.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
