<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
  background-color: #f2f2f2;
  color: #333;
}
header {
  background-color: #333;
  color: #fff;
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 999;
}
nav ul {
  list-style: none;
  text-align: center;
  padding: 20px 0;
}
nav li {
  display: inline;
  margin: 0 20px;
}
nav a {
  text-decoration: none;
  color: #fff;
  transition: all 0.3s ease 0s;
}
nav a:hover {
  color: #f2f2f2;
}
main {
  margin-top: 100px;
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
span {
  color: #333;
  background-color: #f2f2f2;
  padding: 2px;
}
footer {
  background-color: #333;
  color: #fff;
  text-align: center;
  padding: 20px;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</header>
<main>
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }} <span>{{ slot_6 }}</span> {{ slot_7 }} <span>{{ slot_8 }}</span> {{ slot_9 }}</p>
<h1>{{ slot_10 }}</h1>
<p>{{ slot_11 }} <span>{{ slot_12 }}</span> {{ slot_13 }}</p>
<h1>{{ slot_14 }}</h1>
<p>{{ slot_15 }}</p>
</main>
<footer>
<p>{{ slot_16 }}</p>
</footer>
</body>
</html>