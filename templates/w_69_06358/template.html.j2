<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
</div>
<div class="hero">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</div>
<div class="services" id="services">
