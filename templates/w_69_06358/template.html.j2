<p>{{ slot_10 }}</p>
</div>
</div>
<div class="testimonials" id="testimonials">
<h2>{{ slot_11 }}</h2>
<div class="testimonial">
<div class="image">{{ slot_12 }}</div>
<p>{{ slot_13 }}</p>
</div>
