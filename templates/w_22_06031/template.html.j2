<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
nav {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 20px 0;
}
nav ul {
    list-style-type: none;
}
nav ul li {
    display: inline;
    margin: 0 20px;
}
nav ul li a {
    text-decoration: none;
    color: #fff;
}
h2 {
    text-align: center;
    margin: 50px 0 30px;
}
section {
    margin: 50px 0;
}
.team-sports-img, .individual-sports-img {
    width: 200px;
    height: 200px;
    margin: 0 auto;
    background-color: orange;
}
footer {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 10px 0;
}
footer a {
    color: #fff;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
</ul>
</nav>
<section id="team-sports">
<h2>{{ slot_2 }}</h2>
<p>{{ slot_3 }}</p>
<div class="team-sports-img ph"></div>
</section>
<section id="individual-sports">
<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<div class="individual-sports-img ph"></div>
</section>
<footer>
<p>{{ slot_6 }} <a>{{ slot_7 }}</a> {{ slot_8 }} <a>{{ slot_9 }}</a> {{ slot_10 }} <a>{{ slot_11 }}</a></p>
<p>{{ slot_12 }} <a>{{ slot_13 }}</a> {{ slot_14 }} <a>{{ slot_15 }}</a></p>
</footer>
</body>
</html>