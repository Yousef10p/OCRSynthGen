<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 149.3mm; inline-size: 72.9mm; block-size: 38.1mm; font-size: 13.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 30.2mm; inset-block-start: 164.2mm; inline-size: 71.6mm; block-size: 43.0mm; font-size: 13.5pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 111.1mm; inset-block-start: 194.2mm; inline-size: 43.0mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_6 }}</h2>
<div class="box ph" style="inset-inline-start: 109.8mm; inset-block-start: 199.5mm; inline-size: 76.1mm; block-size: 38.1mm; font-size: 9.8pt"></div>
