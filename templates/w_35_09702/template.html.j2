<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
header {
  text-align: center;
  margin-bottom: 20px;
}
header img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}
nav ul {
  list-style-type: none;
  background-color: #333;
}
nav ul li {
  display: inline;
  margin-left: 10px;
}
nav ul li a {
  color: #fff;
  text-decoration: none;
}
nav ul li ul {
  display: none;
}
nav ul li:hover ul {
  display: block;
  position: absolute;
  background-color: #333;
  padding: 10px;
}
form input[type="text"] {
  width: 100%;
  padding: 10px;
  border: 1px solid #333;
}
main {
  column-count: 3;
}
main .column {
  padding: 10px;
}
main .column img {
  width: 100%;
  height: 150px;
  margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
</header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a>
<ul>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span>
</form>
<main>
<div class="column">
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="column">
<h2>{{ slot_10 }}</h2>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<p>{{ slot_11 }}</p>
</div>
<div class="column">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</main>
</body>
</html>