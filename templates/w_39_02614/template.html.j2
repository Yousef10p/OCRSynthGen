<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_6 }}</span></li>
</ul>
</nav>
</header>
<main>
<h1>{{ slot_7 }}</h1>
<h2>{{ slot_8 }}</h2>
<div class="container">
