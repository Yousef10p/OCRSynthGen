}

.image {
    background-color: #ccc;
    height: 200px;
    width: 100%;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2em;
}

footer {
    margin-top: auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
