    justify-content: space-between;
}

header, footer {
    background-color: #eee;
    padding: 20px;
    text-align: center;
}

nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
}

section {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
}

article {
    border: 1px solid #ccc;
    box-shadow: -2px 2px 6px 0px rgba(0,0,0,0.2);
    margin: 20px;
    padding: 20px;
    width: 30%;
