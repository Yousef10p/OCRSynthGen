<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
<main>
<div class="left-menu">
<ul>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
</div>
<div class="main-content">
<h1>{{ slot_12 }}</h1>
<p>{{ slot_13 }}</p>
</div>
</main>
<footer>
<a>{{ slot_14 }}</a>
<a>{{ slot_15 }}</a>
</footer>
</body>
</html>