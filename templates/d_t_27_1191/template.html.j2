<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 107.3mm; inset-block-start: 11.2mm; inline-size: 4.0mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 30.9mm; inset-block-start: 21.0mm; inline-size: 157.6mm; block-size: 63.6mm; font-size: 22.5pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 31.3mm; inset-block-start: 87.4mm; inline-size: 157.3mm; block-size: 22.0mm; font-size: 20.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 31.5mm; inset-block-start: 112.0mm; inline-size: 158.1mm; block-size: 51.2mm; font-size: 20.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 31.9mm; inset-block-start: 165.4mm; inline-size: 157.2mm; block-size: 20.8mm; font-size: 19.7pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 32.0mm; inset-block-start: 188.2mm; inline-size: 157.4mm; block-size: 51.3mm; font-size: 20.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 241.6mm; inline-size: 157.2mm; block-size: 20.9mm; font-size: 19.7pt">{{ slot_6 }}</p>
</div></body>
</html>
