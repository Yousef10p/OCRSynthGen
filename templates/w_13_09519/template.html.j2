<h2>{{ slot_3 }}</h2>
<ul>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
</div>
<div id="events">
<h2>{{ slot_7 }}</h2>
<ul>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</div>
<div id="footer">
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</div>
</body>
</html>