<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 13.5mm; inset-block-start: 15.7mm; inline-size: 175.3mm; block-size: 105.7mm; font-size: 27.2pt"></div>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 123.9mm; inline-size: 49.4mm; block-size: 3.5mm; font-size: 9.8pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 130.3mm; inline-size: 86.8mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 130.3mm; inline-size: 86.6mm; block-size: 13.4mm; font-size: 12.6pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 145.4mm; inline-size: 83.0mm; block-size: 32.1mm; font-size: 13.0pt"><li>{{ slot_3 }}</li></ul>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 148.3mm; inline-size: 86.9mm; block-size: 40.4mm; font-size: 12.7pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 17.0mm; inset-block-start: 179.3mm; inline-size: 82.9mm; block-size: 13.4mm; font-size: 12.6pt"><li>{{ slot_5 }}</li></ul>
<h2 class="box" style="inset-inline-start: 103.6mm; inset-block-start: 193.3mm; inline-size: 38.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_6 }}</h2>
<h2 class="box" style="inset-inline-start: 13.7mm; inset-block-start: 198.1mm; inline-size: 42.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 200.1mm; inline-size: 86.4mm; block-size: 31.4mm; font-size: 12.7pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 13.7mm; inset-block-start: 205.0mm; inline-size: 86.9mm; block-size: 49.5mm; font-size: 12.7pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 103.6mm; inset-block-start: 236.2mm; inline-size: 87.0mm; block-size: 17.9mm; font-size: 12.7pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 13.7mm; inset-block-start: 262.7mm; inline-size: 6.7mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_11 }}</footer>
</div></body>
</html>
