  color: white;
  text-decoration: none;
}

section {
  width: 100%;
  padding: 20px;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.box {
  width: calc(50% - 40px); 
  height: 150px;
  margin: 20px;
  background-color: #2196f3; 
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.portfolio-item {
  width: calc(50% - 40px); 
  height: 300px;
  margin: 20px;
  background-color: #ffeb3b; 
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

footer {
  width: 100%;
  background-color: #4caf50; 
  color: white;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
