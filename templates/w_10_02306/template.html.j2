body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

header {
  width: 100%;
  background-color: #f44336; 
  color: white;
  padding: 20px;
  display: flex;
  justify-content: space-between;
}

