<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 32.1mm; inset-block-start: 32.6mm; inline-size: 89.3mm; block-size: 4.6mm; font-size: 6.5pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 32.1mm; inset-block-start: 37.1mm; inline-size: 90.5mm; block-size: 4.6mm; font-size: 6.5pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 32.1mm; inset-block-start: 49.0mm; inline-size: 22.5mm; block-size: 4.6mm; font-size: 13.0pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 55.9mm; inline-size: 151.6mm; block-size: 33.3mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 91.3mm; inline-size: 151.5mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 102.0mm; inline-size: 151.6mm; block-size: 49.8mm; font-size: 11.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 153.8mm; inline-size: 151.6mm; block-size: 29.2mm; font-size: 11.8pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 185.0mm; inline-size: 151.5mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 195.7mm; inline-size: 151.5mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 206.3mm; inline-size: 151.5mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_9 }}</p>
<div class="box ph" style="inset-inline-start: 8.7mm; inset-block-start: 212.2mm; inline-size: 3.6mm; block-size: 19.5mm; font-size: 13.8pt"></div>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 217.0mm; inline-size: 151.5mm; block-size: 12.7mm; font-size: 12.0pt">{{ slot_10 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 231.8mm; inline-size: 151.5mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_11 }}</p>
<footer class="box" style="inset-inline-start: 8.8mm; inset-block-start: 280.4mm; inline-size: 7.1mm; block-size: 4.6mm; font-size: 12.9pt">{{ slot_12 }}</footer>
</div></body>
</html>
