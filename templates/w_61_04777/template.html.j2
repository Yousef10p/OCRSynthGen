<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  font-family: var(--font-body);
}

header {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
  background: #333;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin: 0 1em;
}

nav ul li a {
  color: white;
  text-decoration: none;
}

.banner {
  text-align: center;
}

.cta {
  display: block;
  padding: 1em;
  background: coral;
  color: white;
  text-decoration: none;
  border-radius: 5px;
  margin-top: 1em;
}

section {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 2em;
}

section:nth-child(odd) {
  background: #f4f4f4;
}

section h2 {
  color: coral;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<div class="banner">
<h1>{{ slot_3 }}</h1>
<p>{{ slot_4 }}</p>
<a class="cta">{{ slot_5 }}</a>
</div>
</header>
<section id="loans">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<a class="cta">{{ slot_8 }}</a>
</section>
<section id="investments">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<a class="cta">{{ slot_11 }}</a>
</section>
<section id="insurance">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<a class="cta">{{ slot_14 }}</a>
</section>
</body>
</html>