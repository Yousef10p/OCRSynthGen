<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 13.2mm; inset-block-start: 42.8mm; inline-size: 28.0mm; block-size: 4.2mm; font-size: 5.9pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 74.5mm; inset-block-start: 42.8mm; inline-size: 21.5mm; block-size: 4.2mm; font-size: 5.9pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 141.8mm; inset-block-start: 42.8mm; inline-size: 30.7mm; block-size: 4.2mm; font-size: 5.9pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 13.2mm; inset-block-start: 47.2mm; inline-size: 36.3mm; block-size: 12.6mm; font-size: 8.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 74.5mm; inset-block-start: 47.2mm; inline-size: 40.8mm; block-size: 8.3mm; font-size: 7.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 141.8mm; inset-block-start: 47.2mm; inline-size: 40.9mm; block-size: 12.6mm; font-size: 8.9pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 1.2mm; inset-block-start: 98.7mm; inline-size: 191.8mm; block-size: 143.7mm; font-size: 15.1pt"></div>
<footer class="box" style="inset-inline-start: 144.1mm; inset-block-start: 266.8mm; inline-size: 55.4mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_6 }}</footer>
</div></body>
</html>
