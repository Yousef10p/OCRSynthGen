<p class="box" style="inset-inline-start: 22.7mm; inset-block-start: 134.2mm; inline-size: 160.6mm; block-size: 15.9mm; font-size: 15.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.7mm; inset-block-start: 152.4mm; inline-size: 159.0mm; block-size: 34.0mm; font-size: 16.1pt">{{ slot_5 }}</p>
