    padding: 20px;
}

main {
    width: 80%;
    padding: 20px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.grid-item {
    border: 1px solid #ddd;
    padding: 20px;
}

input, textarea {
    display: block;
    width: 100%;
    margin-bottom: 20px;
}

form {
    width: 20%;
    background-color: #f0f0f0;
    padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
