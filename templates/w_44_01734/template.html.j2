<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}


.banner {
    background-color: #00008B; 
    color: #fff; 
    text-align: center; 
    padding: 10px; 
}


.content {
    display: flex; 
    padding: 20px; 
}

.left-column {
    width: 50%; 
    background-color: #ADD8E6; 
    padding: 20px; 
}

.right-column {
    width: 50%; 
    background-color: #708090; 
    color: #fff; 
    padding: 20px; 
}


.nav li {
    list-style: none; 
    margin-bottom: 10px; 
}
.nav a {
    color: #fff; 
    text-decoration: none; 
}


.social-icons {
    background-color: #gray;
    width: 50px; 
    height: 50px; 
    display: inline-block; 
    margin-left: 10px; 
}


.cta {
    background-color: #00008B;
    color: #fff;
    padding: 10px 20px;
    border: none; 
    cursor: pointer; 
}

.cta:hover {
    background-color: #0000CD;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="banner">{{ slot_0 }}</div>
<div class="content">
<div class="left-column">
<h2>{{ slot_1 }}</h2>
<p>{{ slot_2 }}</p>
<button class="cta">{{ slot_3 }}</button>
</div>
<div class="right-column">
<h2>{{ slot_4 }}</h2>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_5 }}</span>
<h2>{{ slot_6 }}</h2>
<ul class="nav">
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
<h2>{{ slot_11 }}</h2>
<div class="social-icons">{{ slot_12 }}</div>
<div class="social-icons">{{ slot_13 }}</div>
<div class="social-icons">{{ slot_14 }}</div>
</div>
</div>
</body>
</html>