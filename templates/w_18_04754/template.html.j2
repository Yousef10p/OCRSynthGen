<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}

#nav-bar {
  position: fixed;
  top: 0;
  right: 0;
  width: 200px;
  height: 100%;
  background: #333;
  color: #fff;
  transform: translateX(200px);
  transition: transform 0.3s ease;
}

#nav-bar:hover {
  transform: translateX(0);
}

#nav-bar ul {
  list-style: none;
  padding: 0;
}

#nav-bar li {
  border-bottom: 1px solid #666;
  padding: 10px;
}

#nav-bar li a {
  color: #ccc;
  text-decoration: none;
}

#nav-bar li a:hover {
  color: #fff;
}

.item {
  width: 100px;
  height: 100px;
  background: #333;
  color: #fff;
  margin: 10px;
}

#content {
  margin-right: 200px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="nav-bar">
<ul>
<li><a>{{ slot_0 }}</a>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</li>
<li><a>{{ slot_4 }}</a>
<ul>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</li>
<li><a>{{ slot_8 }}</a>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
</li>
</ul>
</div>
<div id="content">
<p>{{ slot_12 }}</p>
<div class="item">{{ slot_13 }}</div>
<div class="item">{{ slot_14 }}</div>
<div class="item">{{ slot_15 }}</div>
</div>
</body>
</html>