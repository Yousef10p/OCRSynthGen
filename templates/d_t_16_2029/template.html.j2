<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 18.1mm; inset-block-start: 14.9mm; inline-size: 172.4mm; block-size: 123.0mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 17.7mm; inset-block-start: 140.7mm; inline-size: 164.4mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 147.0mm; inline-size: 83.5mm; block-size: 32.6mm; font-size: 13.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 106.9mm; inset-block-start: 147.0mm; inline-size: 83.5mm; block-size: 23.4mm; font-size: 13.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 106.9mm; inset-block-start: 173.1mm; inline-size: 83.5mm; block-size: 32.6mm; font-size: 13.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 182.3mm; inline-size: 83.5mm; block-size: 41.8mm; font-size: 13.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 106.9mm; inset-block-start: 208.4mm; inline-size: 83.5mm; block-size: 28.0mm; font-size: 13.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 18.0mm; inset-block-start: 226.7mm; inline-size: 83.5mm; block-size: 32.6mm; font-size: 13.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 106.9mm; inset-block-start: 239.1mm; inline-size: 83.5mm; block-size: 18.9mm; font-size: 13.4pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 18.0mm; inset-block-start: 265.9mm; inline-size: 9.0mm; block-size: 4.4mm; font-size: 12.4pt">{{ slot_8 }}</footer>
</div></body>
</html>
