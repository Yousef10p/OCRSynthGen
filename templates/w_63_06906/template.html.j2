<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
}

header {
  background-color: #f8f9fa;
  padding: 16px;
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

header nav ul {
  display: flex;
  list-style: none;
}

header nav ul li {
  margin-right: 16px;
}

header nav ul li a {
  text-decoration: none;
  color: #495057;
  transition: color 0.3s ease;
}

header nav ul li a:hover {
  color: #212529;
}

#hero {
  height: 450px;
  background-color: #f8f9fa;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

#destinations {
  padding: 48px 16px;
}

#map {
  height: 240px;
  margin-bottom: 24px;
  background-color: #adb5bd;
  display: flex;
  justify-content: center;
  align-items: center;
}

#book {
  background-color: #e9ecef;
  padding: 64px 16px;
}

#book form {
  display: flex;
  flex-direction: column;
}

#book form input,
#book form button {
  margin-bottom: 16px;
  padding: 8px 16px;
  border: 1px solid #ced4da;
  border-radius: 4px;
}

#book form button {
  background-color: #007bff;
  color: #ffffff;
  cursor: pointer;
}

#about {
  padding: 48px 16px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
