<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 70.7mm; inset-block-start: 108.1mm; inline-size: 67.4mm; block-size: 32.0mm; font-size: 15.1pt"></div>
<div class="box ph" style="inset-inline-start: 76.5mm; inset-block-start: 187.7mm; inline-size: 105.1mm; block-size: 17.4mm; font-size: 16.5pt"></div>
<div class="box ph" style="inset-inline-start: 76.1mm; inset-block-start: 207.1mm; inline-size: 42.3mm; block-size: 6.9mm; font-size: 19.5pt"></div>
<h2 class="box" style="inset-inline-start: 120.8mm; inset-block-start: 205.4mm; inline-size: 46.5mm; block-size: 8.3mm; font-size: 11.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 120.8mm; inset-block-start: 213.1mm; inline-size: 43.5mm; block-size: 9.3mm; font-size: 8.8pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 76.3mm; inset-block-start: 224.3mm; inline-size: 82.4mm; block-size: 7.1mm; font-size: 20.1pt"></div>
<p class="box" style="inset-inline-start: 75.9mm; inset-block-start: 230.9mm; inline-size: 58.2mm; block-size: 4.9mm; font-size: 13.8pt">{{ slot_2 }}</p>
</div></body>
</html>
