<h2>{{ slot_4 }}</h2>
<p>{{ slot_5 }}</p>
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
</div>
<div class="right-column">
<h2>{{ slot_8 }}</h2>
<ul>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
</ul>
<form>
