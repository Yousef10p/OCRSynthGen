<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 17.6mm; inset-block-start: 54.8mm; inline-size: 178.3mm; block-size: 33.8mm; font-size: 16.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 17.6mm; inset-block-start: 104.6mm; inline-size: 37.9mm; block-size: 6.0mm; font-size: 17.0pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 99.7mm; inset-block-start: 103.0mm; inline-size: 99.5mm; block-size: 62.0mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 17.6mm; inset-block-start: 112.0mm; inline-size: 76.9mm; block-size: 37.7mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 17.6mm; inset-block-start: 152.9mm; inline-size: 71.9mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 125.2mm; inset-block-start: 185.4mm; inline-size: 41.9mm; block-size: 6.0mm; font-size: 17.0pt">{{ slot_4 }}</h2>
<div class="box ph" style="inset-inline-start: 21.5mm; inset-block-start: 188.2mm; inline-size: 99.7mm; block-size: 62.5mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 125.2mm; inset-block-start: 192.8mm; inline-size: 76.8mm; block-size: 46.2mm; font-size: 11.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 125.2mm; inset-block-start: 242.1mm; inline-size: 71.9mm; block-size: 8.1mm; font-size: 11.5pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 10.6mm; inset-block-start: 269.0mm; inline-size: 38.6mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_7 }}</footer>
</div></body>
</html>
