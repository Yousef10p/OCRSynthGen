<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<h2>{{ slot_7 }}</h2>
<section class="col1">
<div></div><p>{{ slot_8 }}</p>
<div></div><p>{{ slot_9 }}</p>
<div></div><p>{{ slot_10 }}</p>
</section>
<h2>{{ slot_11 }}</h2>
<section class="col2">
<div></div><p>{{ slot_12 }}</p>
<div></div><p>{{ slot_13 }}</p>
<div></div><p>{{ slot_14 }}</p>
</section>
<h2>{{ slot_15 }}</h2>
<section class="col1">
