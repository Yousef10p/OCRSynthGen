<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

header, footer {
  background-color: #f8f8f8;
  text-align: center;
  padding: 20px 0;
  position: relative;
}

header:before {
  content: "";
  display: block;
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  background: none no-repeat center center/cover;
  z-index: -1;
}

h1, h2 {
  color: #333;
}

nav ul {
  list-style-type: none;
  padding: 0;
  text-align: center;
}

nav ul li {
  display: inline-block;
  margin: 0 10px;
}

nav ul li a {
  text-decoration: none;
  color: #333;
}

section {
  padding: 20px;
  box-sizing: border-box;
  float: right;
  width: 33.3%;
}

footer {
  clear: both;
  background-color: #f8f8f8;
  padding: 10px 0;
  position: fixed;
  width: 100%;
  bottom: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<h1>{{ slot_0 }}</h1>
<nav>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<main>
<section>
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
</section>
<section>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</section>
<section>
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<p>{{ slot_11 }} <a>{{ slot_12 }}</a></p>
<p>{{ slot_13 }} <a>{{ slot_14 }}</a></p>
</section>
</main>
<footer>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>