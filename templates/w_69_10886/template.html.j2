<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
}

body {
    font-family: var(--font-body);
}

header, footer {
    background-color: #ccc;
    padding: 20px;
    display: flex;
    justify-content: space-between;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin-right: 20px;
}

main {
    padding: 20px;
}

footer {
    position: fixed;
    bottom: 0;
    width: 100%;
}


.carousel {
    display: flex;
    overflow: hidden;
    position: relative;
}

.carousel img {
    display: none;
    width: 100%;
    height: auto;
}

.carousel img.active {
    display: block;
}

.caption {
    position: absolute;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    padding: 10px;
}


@keyframes fade {
    from {opacity: .4}
    to {opacity: 1}
}

.carousel img.active {
    animation: fade 0.5s;
}


section {
    margin-top: 20px;
}

section h2 {
    margin-bottom: 20px;
}


.team-member {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
}

.team-member img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin-left: 20px;
}


form {
    display: flex;
    flex-direction: column;
}

form input, form textarea {
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
