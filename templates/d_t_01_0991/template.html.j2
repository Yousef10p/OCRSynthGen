<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 24.8mm; inset-block-start: 12.7mm; inline-size: 84.3mm; block-size: 49.8mm; font-size: 15.7pt"></div>
<p class="box" style="inset-inline-start: 116.4mm; inset-block-start: 19.8mm; inline-size: 85.8mm; block-size: 21.0mm; font-size: 19.9pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 78.3mm; inline-size: 84.3mm; block-size: 5.4mm; font-size: 15.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 90.9mm; inline-size: 165.2mm; block-size: 19.8mm; font-size: 11.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 112.1mm; inline-size: 166.2mm; block-size: 19.8mm; font-size: 11.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 133.2mm; inline-size: 165.1mm; block-size: 24.0mm; font-size: 11.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 158.6mm; inline-size: 165.1mm; block-size: 7.1mm; font-size: 10.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 77.7mm; inset-block-start: 170.0mm; inline-size: 82.4mm; block-size: 74.6mm; font-size: 19.2pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 28.2mm; inset-block-start: 173.9mm; inline-size: 39.7mm; block-size: 70.9mm; font-size: 22.3pt"></div>
<footer class="box" style="inset-inline-start: 104.0mm; inset-block-start: 268.8mm; inline-size: 52.1mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 162.8mm; inset-block-start: 268.8mm; inline-size: 33.5mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 203.5mm; inset-block-start: 268.8mm; inline-size: 1.8mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_9 }}</footer>
</div></body>
</html>
