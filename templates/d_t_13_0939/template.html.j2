<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 50.8mm; inset-block-start: 25.4mm; inline-size: 136.6mm; block-size: 41.5mm; font-size: 14.7pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 50.8mm; inset-block-start: 72.1mm; inline-size: 136.5mm; block-size: 31.1mm; font-size: 14.7pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 38.1mm; inset-block-start: 108.4mm; inline-size: 92.0mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 50.8mm; inset-block-start: 118.8mm; inline-size: 136.1mm; block-size: 51.9mm; font-size: 14.7pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 50.8mm; inset-block-start: 175.9mm; inline-size: 136.6mm; block-size: 20.8mm; font-size: 14.7pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 50.8mm; inset-block-start: 201.8mm; inline-size: 136.3mm; block-size: 25.9mm; font-size: 14.7pt"><li>{{ slot_5 }}</li></ul>
<h2 class="box" style="inset-inline-start: 38.1mm; inset-block-start: 233.0mm; inline-size: 64.6mm; block-size: 5.2mm; font-size: 14.7pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 50.8mm; inset-block-start: 243.4mm; inline-size: 136.2mm; block-size: 25.9mm; font-size: 14.7pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 102.9mm; inset-block-start: 274.7mm; inline-size: 5.3mm; block-size: 4.7mm; font-size: 13.3pt">{{ slot_8 }}</footer>
</div></body>
</html>
