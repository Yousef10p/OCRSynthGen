}

section.products .product-img {
	width: 100px;
	height: 100px;
	background-color: lightgray;
}

footer {
	background: #222;
	color: white;
	text-align: center;
	padding: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
