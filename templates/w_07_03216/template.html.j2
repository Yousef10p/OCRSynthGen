<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    color: #333;
    background-color: #f4f4f4;
}

header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
}

header img#logo {
    height: 3rem;
    background-color: #f00;
}

header nav ul {
    list-style: none;
    display: flex;
}

header nav ul li {
    padding: 0 1rem;
}

header nav ul li a {
    color: inherit;
    text-decoration: none;
}

#banner {
    width: 100%;
    height: 10rem;
    background-color: #0f0;
}

main {
    padding: 1rem;
}

main section {
    margin: 1rem 0;
}

main section h2 {
    color: #00f;
}

main .product {
    display: flex;
    align-items: center;
    margin: 1rem 0;
}

main .product h3 {
    width: 50%;
    color: #0f0;
}

main .product-image {
    width: 50%;
    height: 5rem;
    background-color: #00f;
}

footer {
    text-align: center;
    padding: 1rem;
    background-color: #000;
    color: #fff;
}

@media (max-width: 600px) {
    header nav ul, #banner, main .product {
        width: 100%;
    }
    main .product h3, main .product, .product-image {
        width: 100%;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
