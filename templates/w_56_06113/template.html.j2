<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
}
.menu {
  position: absolute;
  top: 10px;
  left: 10px;
}
.menu ul li {
  display: inline;
  margin-left: 10px;
}
.menu ul li a {
  text-decoration: none;
  color: black;
}
.world-map {
  height: 500px;
  width: 500px;
  position: absolute;
  bottom: 20px;
  left: 20px;
}
.world-map .place {
  height: 100px;
  width: 100px;
  margin: 5px;
  float: right;
  color: white;
  text-align: center;
  padding-top: 40px;
}
.red { background-color: red; }
.blue { background-color: blue; }
.green { background-color: green; }
.yellow { background-color: yellow; color: black; }
.description {
  margin: 50px;
  position: absolute;
  top: 70px;
  right: 70px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</div>
<div class="world-map">
<div class="place red">{{ slot_8 }}</div>
<div class="place blue">{{ slot_9 }}</div>
<div class="place green">{{ slot_10 }}</div>
<div class="place yellow">{{ slot_11 }}</div>
</div>
<div class="description">
<h1>{{ slot_12 }}</h1>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>