<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 14.5mm; inset-block-start: 32.3mm; inline-size: 143.3mm; block-size: 76.7mm; font-size: 8.5pt"></div>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 118.9mm; inline-size: 151.1mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 136.5mm; inline-size: 98.8mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 143.8mm; inline-size: 151.1mm; block-size: 11.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 95.0mm; inset-block-start: 155.8mm; inline-size: 88.6mm; block-size: 10.0mm; font-size: 12.0pt"></div>
<h2 class="box" style="inset-inline-start: 37.7mm; inset-block-start: 174.7mm; inline-size: 42.4mm; block-size: 3.4mm; font-size: 10.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 32.4mm; inset-block-start: 186.6mm; inline-size: 151.1mm; block-size: 29.4mm; font-size: 12.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 103.8mm; inset-block-start: 236.5mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
