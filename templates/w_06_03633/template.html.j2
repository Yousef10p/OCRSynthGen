<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: grid;
    grid-template-areas: 
        "header header"
        "sidebar content"
        "footer footer";
    grid-template-rows: auto 1fr auto;
    grid-template-columns: 1fr 3fr;
}
.header, .footer {
    grid-column: 1 / span 2;
}
.sidebar, .content {
    padding: 20px;
}
.property {
    display: grid;
    grid-template-columns: 1fr 3fr;
    margin-bottom: 20px;
}
.image {
    background-color: #cccccc;
    width: 100px;
    height: 100px;
}
a {
    color: blue;
    text-decoration: none;
}


.header {
    grid-area: header;
    background-color: #eeeeee;
    padding: 5px;
}


.sidebar {
    grid-area: sidebar;
    background-color: #dddddd;
}


.content {
    grid-area: content;
}


.footer {
    grid-area: footer;
    background-color: #eeeeee;
    padding: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="header">{{ slot_0 }}</div>
<div class="sidebar">
<h2>{{ slot_1 }}</h2>
<ul>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="content">
<div class="property">
<div class="image ph"></div>
<p>{{ slot_5 }}</p>
</div>
<div class="property">
<div class="image ph"></div>
<p>{{ slot_6 }}</p>
</div>
<div class="property">
<div class="image ph"></div>
<p>{{ slot_7 }}</p>
</div>
</div>
<div class="footer">
<h2>{{ slot_8 }}</h2>
<ul>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
<h2>{{ slot_12 }}</h2>
<ul>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
<li><a>{{ slot_15 }}</a></li>
</ul>
</div>
</body>
</html>