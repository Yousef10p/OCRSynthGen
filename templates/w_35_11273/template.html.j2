<li>{{ slot_7 }}</li>
<li>{{ slot_8 }}</li>
<li>{{ slot_9 }}</li>
<li>{{ slot_10 }}</li>
</ul>
</div>
<div class="right-col">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
