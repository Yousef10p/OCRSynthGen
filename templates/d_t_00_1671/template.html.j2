<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 landscape; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 297mm; --page-height: 210mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 62.7mm; inset-block-start: 55.6mm; inline-size: 60.5mm; block-size: 6.0mm; font-size: 17.1pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 208.1mm; inset-block-start: 182.4mm; inline-size: 59.0mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 215.2mm; inset-block-start: 186.5mm; inline-size: 56.8mm; block-size: 6.6mm; font-size: 9.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 178.6mm; inset-block-start: 188.4mm; inline-size: 30.6mm; block-size: 2.8mm; font-size: 8.1pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 9.6mm; inset-block-start: 188.7mm; inline-size: 5.6mm; block-size: 2.9mm; font-size: 8.1pt">{{ slot_4 }}</footer><p class="box" style="inset-inline-start: 208.1mm; inset-block-start: 194.7mm; inline-size: 54.8mm; block-size: 2.5mm; font-size: 7.1pt">{{ slot_5 }}</p>
</div></body>
</html>
