<ul class="box" style="inset-inline-start: 74.7mm; inset-block-start: 76.9mm; inline-size: 49.2mm; block-size: 18.6mm; font-size: 10.5pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 74.7mm; inset-block-start: 98.3mm; inline-size: 48.3mm; block-size: 10.7mm; font-size: 10.1pt"><li>{{ slot_6 }}</li></ul>
