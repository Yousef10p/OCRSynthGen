}

.sections p {
  text-align: center;
  padding: 10px;
}

footer {
  background-color: #212121;  
  color: #fff;
  text-align: center;
  padding: 10px 0;
}

@media screen and (max-width: 600px) {
  .main-menu {
    flex-direction: column;
  }
  
  .main-menu li {
    margin: 10px 0;
  }
  
  section {
    margin: 20px 0;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
