<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 113.9mm; inline-size: 172.7mm; block-size: 43.8mm; font-size: 13.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 163.3mm; inline-size: 172.7mm; block-size: 19.1mm; font-size: 13.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 22.2mm; inset-block-start: 188.0mm; inline-size: 172.8mm; block-size: 33.9mm; font-size: 13.7pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 22.2mm; inset-block-start: 271.2mm; inline-size: 21.0mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 191.1mm; inset-block-start: 271.2mm; inline-size: 2.6mm; block-size: 3.1mm; font-size: 8.9pt">{{ slot_8 }}</footer>
</div></body>
</html>
