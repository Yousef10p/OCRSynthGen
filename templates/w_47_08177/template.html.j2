<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<main>
<section>
<div class="menu-image">{{ slot_5 }}</div>
<p>{{ slot_6 }}</p>
</section>
<section>
<div class="restaurant-image">{{ slot_7 }}</div>
<p>{{ slot_8 }}</p>
</section>
</main>
<footer>
