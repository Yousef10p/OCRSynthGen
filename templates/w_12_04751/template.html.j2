    background: #f1f1f1;
    padding: 10px 20px;
}
.sidebar p {
    margin-bottom: 0;
}
.sidebar ul {
    list-style: none;
    padding-right: 0;
}
.sidebar ul li {
    margin: 5px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
