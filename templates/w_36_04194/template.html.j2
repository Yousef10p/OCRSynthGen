  padding: 0;
}

header h1, nav a {
  display: inline-block;
  margin: 20px 10px;
  color: inherit;
  text-decoration: none;
}

section {
  margin: 20px;
}

footer {
  background-color: #333;
  color: white;
  text-align: center;
  padding: 20px;
}

.event, .news-item {
  border: 1px solid #333;
  margin: 20px 0;
}

.news-image, .timer {
  height: 200px;
  width: 200px;
  background-color: #999; 
  margin: 20px;
}

.scrolling-news {
  height: 400px;
  overflow-y: auto;
}

@keyframes timer {
  from {background-color: red;}
  to {background-color: yellow;}
}

.timer {
  animation-name: timer;
  animation-duration: 2s;
  animation-iteration-count: 1;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
