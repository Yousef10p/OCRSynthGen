<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 26.4mm; inline-size: 165.1mm; block-size: 39.0mm; font-size: 10.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 31.4mm; inset-block-start: 70.3mm; inline-size: 145.2mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 82.8mm; inline-size: 165.1mm; block-size: 30.2mm; font-size: 10.9pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 28.4mm; inset-block-start: 120.7mm; inline-size: 133.0mm; block-size: 3.8mm; font-size: 10.9pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 28.4mm; inset-block-start: 132.4mm; inline-size: 161.9mm; block-size: 15.4mm; font-size: 10.9pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 83.1mm; inset-block-start: 155.5mm; inline-size: 59.0mm; block-size: 7.4mm; font-size: 9.4pt"></div>
<p class="box" style="inset-inline-start: 35.0mm; inset-block-start: 171.3mm; inline-size: 43.1mm; block-size: 6.7mm; font-size: 10.9pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 28.4mm; inset-block-start: 183.1mm; inline-size: 53.3mm; block-size: 3.8mm; font-size: 10.9pt"><li>{{ slot_6 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 194.1mm; inline-size: 165.0mm; block-size: 13.2mm; font-size: 10.9pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 216.0mm; inline-size: 165.1mm; block-size: 46.5mm; font-size: 10.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 106.0mm; inset-block-start: 261.7mm; inline-size: 3.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_9 }}</footer>
</div></body>
</html>
