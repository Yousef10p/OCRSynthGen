<p class="box" style="inset-inline-start: 48.2mm; inset-block-start: 143.3mm; inline-size: 137.1mm; block-size: 4.3mm; font-size: 10.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 26.2mm; inset-block-start: 157.0mm; inline-size: 89.3mm; block-size: 94.4mm; font-size: 11.9pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 120.6mm; inset-block-start: 157.0mm; inline-size: 88.8mm; block-size: 84.3mm; font-size: 11.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 121.1mm; inset-block-start: 241.6mm; inline-size: 87.2mm; block-size: 19.5mm; font-size: 11.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 26.9mm; inset-block-start: 251.6mm; inline-size: 86.8mm; block-size: 9.7mm; font-size: 11.9pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 113.8mm; inset-block-start: 263.7mm; inline-size: 6.8mm; block-size: 3.9mm; font-size: 9.9pt">{{ slot_6 }}</footer>
</div></body>
</html>
