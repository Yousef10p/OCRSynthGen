<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 50.7mm; inset-block-start: 25.4mm; inline-size: 108.7mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 71.3mm; inset-block-start: 36.4mm; inline-size: 67.3mm; block-size: 4.0mm; font-size: 7.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 27.0mm; inset-block-start: 46.0mm; inline-size: 155.7mm; block-size: 3.2mm; font-size: 7.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 49.1mm; inset-block-start: 54.1mm; inline-size: 110.4mm; block-size: 3.2mm; font-size: 7.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 97.3mm; inset-block-start: 72.0mm; inline-size: 15.4mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 80.5mm; inline-size: 159.2mm; block-size: 38.6mm; font-size: 10.0pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 82.7mm; inline-size: 6.3mm; block-size: 128.5mm; font-size: 20.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 124.7mm; inline-size: 154.6mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_7 }}</p>
<h2 class="box" style="inset-inline-start: 25.5mm; inset-block-start: 145.6mm; inline-size: 38.9mm; block-size: 4.5mm; font-size: 14.3pt">{{ slot_8 }}</h2>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 157.1mm; inline-size: 159.2mm; block-size: 101.9mm; font-size: 10.0pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 29.3mm; inset-block-start: 262.4mm; inline-size: 100.5mm; block-size: 2.6mm; font-size: 7.0pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 104.2mm; inset-block-start: 279.5mm; inline-size: 1.8mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_11 }}</footer>
</div></body>
</html>
