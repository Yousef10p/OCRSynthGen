<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 18.6mm; inset-block-start: 17.2mm; inline-size: 29.1mm; block-size: 3.3mm; font-size: 9.4pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 76.4mm; inset-block-start: 47.1mm; inline-size: 53.5mm; block-size: 79.1mm; font-size: 18.7pt"></div>
<div class="box ph" style="inset-inline-start: 134.4mm; inset-block-start: 47.2mm; inline-size: 54.8mm; block-size: 79.1mm; font-size: 18.7pt"></div>
<div class="box ph" style="inset-inline-start: 18.1mm; inset-block-start: 47.8mm; inline-size: 52.8mm; block-size: 78.1mm; font-size: 13.8pt"></div>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 141.3mm; inline-size: 82.4mm; block-size: 74.7mm; font-size: 15.1pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 107.1mm; inset-block-start: 141.3mm; inline-size: 82.5mm; block-size: 69.2mm; font-size: 15.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 18.6mm; inset-block-start: 222.5mm; inline-size: 82.9mm; block-size: 20.5mm; font-size: 14.5pt">{{ slot_3 }}</p>
<footer class="box" style="inset-inline-start: 18.6mm; inset-block-start: 256.2mm; inline-size: 1.5mm; block-size: 3.5mm; font-size: 9.9pt">{{ slot_4 }}</footer>
</div></body>
</html>
