<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
<h2>{{ slot_6 }}</h2>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_7 }}</span>
</div>
<div id="content">
<h1>{{ slot_8 }}</h1>
<div class="product">
<div class="image ph"></div>
<div class="description">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
</div>
</div>

</div>
<div id="right">
<h2>{{ slot_11 }}</h2>

</div>
<div id="footer">
<p>{{ slot_12 }} <a>{{ slot_13 }}</a>{{ slot_14 }} <a>{{ slot_15 }}</a>{{ slot_16 }} <a>{{ slot_17 }}</a></p>
</div>
</body>
</html>