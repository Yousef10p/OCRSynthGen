    justify-content: space-around;
}
header nav ul li {
    position: relative;
}
header nav ul li a {
    text-decoration: none;
    color: inherit;
}
header nav ul li .dropdown {
    display: none;
    position: absolute;
    width: 100%;
    text-align: center;
}
header nav ul li:hover .dropdown {
    display: block;
    background-color: #333;
    color: #fff;
    padding: 10px 0;
}
.image-placeholder {
    width: 200px;
    height: 200px;
    background-color: #aaa;
    margin: 20px auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
