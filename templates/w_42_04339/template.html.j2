<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

:root {
    --black: rgba(0, 0, 0, 0.8);
    --white: rgba(255, 255, 255, 0.8);
    --accent: #007BFF;
    --margin: 1em;
}



* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    background: linear-gradient(to left, var(--accent), var(--white));
    color: var(--black);
    font-family: var(--font-body);
    animation: bg-color 2s infinite;
}


@keyframes bg-color {
    0% { background-color: var(--white); }
    50% { background-color: var(--accent); }
    100% { background-color: var(--white); }
}

h2, form {
    margin: var(--margin);
}

input {
    margin: var(--margin);
    padding: var(--margin);
    border: 1px solid var(--black);
    border-radius: var(--margin);
    background: var(--white);
    transition: all 0.2s;
}

input:hover {
    transform: scale(1.1);
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
}


nav ul {
    display: flex;
    justify-content: space-around;
    list-style-type: none;
    background: linear-gradient(to left, var(--white), var(--accent));
}

nav ul li a {
    display: block;
    padding: var(--margin);
    color: var(--black);
    text-decoration: none;
}


.testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--margin);
}

.testimonials-grid > div {
    background: var(--white);
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
    padding: var(--margin);
    opacity: 0.8;
}



@media screen and (max-width: 600px) {
    nav ul { flex-direction: column; }
}


.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
