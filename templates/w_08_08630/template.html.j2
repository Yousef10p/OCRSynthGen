    padding: 10px;
}

nav ul {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: space-around;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

section {
    padding: 20px;
}

section h1 {
    text-align: center;
}

section div {
    background-color: #ccc;
    height: 200px;
    margin: 20px 0;
}

footer {
