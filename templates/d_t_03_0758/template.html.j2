<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 14.8mm; inline-size: 111.7mm; block-size: 244.1mm; font-size: 40.0pt"></div>
<div class="box ph" style="inset-inline-start: 172.5mm; inset-block-start: 12.5mm; inline-size: 39.0mm; block-size: 38.8mm; font-size: 15.7pt"></div>
<div class="box ph" style="inset-inline-start: 172.8mm; inset-block-start: 58.8mm; inline-size: 38.6mm; block-size: 38.6mm; font-size: 15.6pt"></div>
<div class="box ph" style="inset-inline-start: 172.6mm; inset-block-start: 104.3mm; inline-size: 38.8mm; block-size: 38.6mm; font-size: 15.6pt"></div>
<div class="box ph" style="inset-inline-start: 137.7mm; inset-block-start: 129.4mm; inline-size: 11.6mm; block-size: 106.5mm; font-size: 15.1pt"></div>
<header class="box" style="inset-inline-start: 198.7mm; inset-block-start: 151.2mm; inline-size: 5.1mm; block-size: 102.0mm; font-size: 40.0pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 111.8mm; inset-block-start: 239.8mm; inline-size: 8.6mm; block-size: 9.2mm; font-size: 26.1pt"></div>
<p class="box" style="inset-inline-start: 121.6mm; inset-block-start: 241.2mm; inline-size: 68.3mm; block-size: 25.8mm; font-size: 14.6pt">{{ slot_1 }}</p>
<footer class="box" style="inset-inline-start: 202.5mm; inset-block-start: 265.6mm; inline-size: 1.7mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_2 }}</footer>
</div></body>
</html>
