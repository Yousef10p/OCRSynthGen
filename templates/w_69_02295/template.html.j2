    align-items: center;
    padding: 2em 0;
    background: #f1f1f1;
}

#subscribe-form {
    display: flex;
    flex-direction: column;
    width: 50%;
}

#subscribe-form input,
#subscribe-form button {
    margin-bottom: 1em;
    padding: 1em;
    font-size: 1em;
}


#social-media ul {
    display: flex;
    justify-content: center;
}

#social-media ul li {
    margin: 0 1em;
}


footer {
    text-align: center;
    padding: 1em 0;
    background: #000;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
