<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 27.0mm; inset-block-start: 25.4mm; inline-size: 161.2mm; block-size: 14.0mm; font-size: 14.3pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 63.0mm; inset-block-start: 46.5mm; inline-size: 89.0mm; block-size: 4.7mm; font-size: 8.0pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 54.9mm; inline-size: 6.4mm; block-size: 153.2mm; font-size: 20.0pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 54.9mm; inset-block-start: 54.9mm; inline-size: 105.5mm; block-size: 11.6mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 62.1mm; inset-block-start: 70.4mm; inline-size: 91.0mm; block-size: 11.6mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 54.9mm; inset-block-start: 85.8mm; inline-size: 105.5mm; block-size: 11.6mm; font-size: 10.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 50.9mm; inset-block-start: 101.3mm; inline-size: 113.4mm; block-size: 11.6mm; font-size: 10.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 35.7mm; inset-block-start: 116.7mm; inline-size: 143.8mm; block-size: 3.9mm; font-size: 8.0pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 104.6mm; inset-block-start: 266.7mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_8 }}</footer>
</div></body>
</html>
