<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 0.1mm; inline-size: 209.9mm; block-size: 77.8mm; font-size: 14.7pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 80.4mm; inline-size: 16.3mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 23.4mm; inset-block-start: 89.3mm; inline-size: 51.8mm; block-size: 51.4mm; font-size: 14.6pt"></div>
<div class="box ph" style="inset-inline-start: 78.6mm; inset-block-start: 89.7mm; inline-size: 51.7mm; block-size: 51.2mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 90.4mm; inline-size: 49.2mm; block-size: 20.3mm; font-size: 11.5pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 135.3mm; inset-block-start: 114.2mm; inline-size: 17.0mm; block-size: 3.0mm; font-size: 8.5pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 119.3mm; inline-size: 45.7mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 134.5mm; inline-size: 49.0mm; block-size: 51.2mm; font-size: 12.1pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 142.4mm; inline-size: 23.1mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 80.4mm; inset-block-start: 142.4mm; inline-size: 31.1mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_6 }}</p>
<div class="box ph" style="inset-inline-start: 23.1mm; inset-block-start: 148.6mm; inline-size: 107.4mm; block-size: 51.3mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 189.5mm; inline-size: 46.2mm; block-size: 35.5mm; font-size: 14.4pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 201.3mm; inline-size: 35.6mm; block-size: 2.2mm; font-size: 6.2pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 135.3mm; inset-block-start: 228.5mm; inline-size: 46.7mm; block-size: 15.9mm; font-size: 11.3pt">{{ slot_9 }}</p>
<footer class="box" style="inset-inline-start: 25.8mm; inset-block-start: 287.5mm; inline-size: 2.2mm; block-size: 2.0mm; font-size: 5.8pt">{{ slot_10 }}</footer>
</div></body>
</html>
