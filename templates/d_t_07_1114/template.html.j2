<h2 class="box" style="inset-inline-start: 20.7mm; inset-block-start: 202.3mm; inline-size: 17.7mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 212.5mm; inline-size: 30.7mm; block-size: 21.0mm; font-size: 14.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 79.4mm; inset-block-start: 212.5mm; inline-size: 27.0mm; block-size: 17.5mm; font-size: 16.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.7mm; inset-block-start: 237.8mm; inline-size: 30.7mm; block-size: 17.5mm; font-size: 16.5pt">{{ slot_5 }}</p>
