<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 34.4mm; inset-block-start: 13.3mm; inline-size: 46.4mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 31.7mm; inset-block-start: 28.2mm; inline-size: 145.0mm; block-size: 38.8mm; font-size: 27.5pt"></div>
<p class="box" style="inset-inline-start: 63.1mm; inset-block-start: 70.6mm; inline-size: 82.8mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 81.4mm; inline-size: 140.9mm; block-size: 25.2mm; font-size: 17.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 107.3mm; inline-size: 141.3mm; block-size: 38.1mm; font-size: 18.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 32.5mm; inset-block-start: 160.0mm; inline-size: 145.0mm; block-size: 81.3mm; font-size: 28.8pt"></div>
<p class="box" style="inset-inline-start: 64.8mm; inset-block-start: 245.5mm; inline-size: 80.6mm; block-size: 5.7mm; font-size: 16.2pt">{{ slot_4 }}</p>
</div></body>
</html>
