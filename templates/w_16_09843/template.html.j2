  margin-left: 10px;
}
.right-column {
  flex: 3;
}
nav ul {
  list-style-type: none;
  padding: 0;
}
nav ul li {
  margin-bottom: 10px;
}
nav ul li a {
  color: #FFA500; 
  text-decoration: none;
}
.image-placeholder {
  background-color: #708090; 
  width: 200px;
  height: 200px;
  margin-bottom: 10px;
}
h2 {
  color: #FFA500; 
}
p {
  color: #FFA500; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
