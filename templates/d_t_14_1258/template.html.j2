<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 71.7mm; inline-size: 181.1mm; block-size: 21.4mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 15.0mm; inset-block-start: 98.0mm; inline-size: 28.8mm; block-size: 4.3mm; font-size: 10.0pt">{{ slot_5 }}</p>
