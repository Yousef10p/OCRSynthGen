<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	font-family: var(--font-body);
}

a {
	text-decoration: none;
}


.container {
	display: flex;
	padding: 20px;
	box-sizing: border-box;
}

.navigation, .content, .promotions {
	flex: 1;
	padding: 10px;
}


.navigation {
	border-left: 1px solid #000;
}

.navigation ul {
	list-style-type: none;
	padding: 0;
}


.content {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}

.content p {
	margin-bottom: 20px;
}


.btn {
	display: inline-block;
	padding: 10px;
	background-color: #000;
	color: #fff;
	border-radius: 5px;
}


.promotions {
	border-right: 1px solid #000;
	text-align: left;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="container">
<div class="navigation">
<h3>{{ slot_0 }}</h3>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</div>
<div class="content">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<div class="menu">
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
<a class="btn">{{ slot_9 }}</a>
</div>
<div class="reservation">
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
<a class="btn">{{ slot_12 }}</a>
</div>
</div>
<div class="promotions">
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
<a class="btn">{{ slot_15 }}</a>
</div>
</div>
</body>
</html>