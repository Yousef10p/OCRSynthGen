</ul>
</nav>
</header>
<main>
<div id="products">
<h2>{{ slot_3 }}</h2>

<div class="product" style="background-color: #f00;">{{ slot_4 }}</div>
<div class="product" style="background-color: #0f0;">{{ slot_5 }}</div>
<div class="product" style="background-color: #00f;">{{ slot_6 }}</div>
</div>
<div id="resources">
<h2>{{ slot_7 }}</h2>
<a>{{ slot_8 }}</a>
</div>
<div id="case-studies">
<h2>{{ slot_9 }}</h2>
<div class="case-study" style="background-color: #ff0;">{{ slot_10 }}</div>
<div class="case-study" style="background-color: #0ff;">{{ slot_11 }}</div>
</div>
</main>
<aside>
