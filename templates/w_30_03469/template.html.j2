<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	margin: 0;
	padding: 0;
	background-color: #ffe6cc;
	font-family: var(--font-body);
	color: #333;
}


.hero {
	position: relative;
	height: 400px;
	background-color: #ff6600;
	display: flex;
	align-items: center;
	justify-content: center;
}

.hero-text {
	color: white;
	text-align: center;
}


.search-bar {
	padding: 20px 0;
	display: flex;
	justify-content: center;
}

.search-bar input {
	width: 80%;
	padding: 10px;
	border-radius: 20px;
	border: none;
}


.menu ul {
	list-style: none;
	display: flex;
	justify-content: space-around;
	margin: 40px 0;
	padding: 0;
}

.menu ul li {
	color: #333;
	text-decoration: none;
	font-size: 18px;
}


.reviews {
	padding: 20px;
	text-align: center;
}

.reviews p {
	margin: 0;
	padding: 10px 0;
}


.footer {
	background-color: #ff6600;
	color: white;
	position: fixed;
	width: 100%;
	bottom: 0;
	padding: 20px;
	display: flex;
	justify-content: space-around;
}

.footer a {
	color: white;
	text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero">
<div class="hero-text">
<h1>{{ slot_0 }}</h1>
</div>
</div>
<div class="search-bar">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_1 }}</span>
</div>
<div class="menu">
<ul>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
</ul>
</div>
<div class="reviews">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<p>{{ slot_9 }}</p>
</div>
<div class="footer">
<div class="socials">
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
</div>
<div class="contact">
<a>{{ slot_13 }}</a>
<p>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>