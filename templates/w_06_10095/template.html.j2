<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
    font-family: var(--font-body);
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background: #222;
    color: #fff;
    overflow-y: auto;
}

nav, aside {
    position: fixed;
    width: 100%;
}

nav {
    top: 0;
    text-align: center;
    background-color: #222;
    padding: 20px 0;
}

nav ul {
    list-style: none;
}

nav ul li {
    display: inline-block;
    margin: 0 20px;
}

aside {
    bottom: 0;
    display: flex;
    justify-content: space-around;
    align-items: center;
    background-color: #222;
    padding: 20px 0;
}

button {
    padding: 10px 20px;
    background: #f44336;
    color: #fff;
    border: none;
    cursor: pointer;
}

main {
    width: 100%;
}

.social-icons a {
    margin: 0 10px;
}

.hero, .case-studies, .pricing, .contact {
    padding: 50px;
}

.case-studies, .pricing, .contact {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
}

form {
    display: flex;
    flex-direction: column;
}

form input, form textarea {
    margin-bottom: 10px;
    padding: 10px;
    border: none;
    background: #444;
    color: #fff;
}

form button {
    align-self: flex-end;
}

@media screen and (max-width: 768px) {
    nav, aside {
        position: static;
        width: 100%;
    }

    main {
        width: 100%;
    }

    .hero, .case-studies, .pricing, .contact {
        width: 100%;
    }    
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
