<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
    margin: 0;
    padding: 0;
    height: 100%;
}

nav {
    display: flex;
    justify-content: space-around;
    background-color: lightgray;
    padding: 10px 0;
}

.menu li {
    list-style: none;
    display: inline-block;
    position: relative;
}

.menu > li > a {
    text-decoration: none;
    display: block;
    padding: 10px 20px;
    color: black;
}

.menu li a:hover {
    color: white;
}

.submenu {
    display: none;
    position: absolute;
    min-width: 100px;
    background-color: lightgray;
}

.menu li:hover .submenu {
    display: block;
}

.search-container {
    margin: auto;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    grid-gap: 1rem;
}

.product-box {
    border: 1px solid black;
    padding: 10px;
}

.productImage {
    height: 100px;
    width: 100px;
    background-color: gray;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul class="menu">
<li><a>{{ slot_0 }}</a>
<ul class="submenu">
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</li>
<li><a>{{ slot_4 }}</a>
<ul class="submenu">
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
</ul>
</li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
<div class="search-container">
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_10 }}</span>
</div>
</nav>
<div class="product-grid">
<div class="product-box"><div class="productImage ph"></div><p>{{ slot_11 }}</p></div>
<div class="product-box"><div class="productImage ph"></div><p>{{ slot_12 }}</p></div>
<div class="product-box"><div class="productImage ph"></div><p>{{ slot_13 }}</p></div>
<div class="product-box"><div class="productImage ph"></div><p>{{ slot_14 }}</p></div>

</div>
</body>
</html>