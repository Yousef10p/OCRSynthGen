    text-align: center;
    background-color: #f0f0f0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 10px;
}

h1, h2 {
    color: #333;
}

a {
    color: #000;
}

ul {
    display: flex;
    justify-content: center;
    list-style-type: none;
    padding: 10px;
}

ul li {
    padding: 0 10px;
} 

ul a {
    text-decoration: none;
}

nav {
    background-color:#808080;
    position: sticky;
    top: 0;
}

#services, #calculators, #about, #contact {
    margin: 20px;
    padding: 20px;
    box-shadow: 0px 0px 10px #000;
    border-radius: 5px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
