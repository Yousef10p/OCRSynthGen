<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 81.3mm; inline-size: 162.7mm; block-size: 8.8mm; font-size: 12.4pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 93.5mm; inline-size: 162.7mm; block-size: 45.4mm; font-size: 12.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 28.1mm; inset-block-start: 142.3mm; inline-size: 162.8mm; block-size: 36.3mm; font-size: 12.8pt">{{ slot_6 }}</p>
