<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 6.0mm; inset-block-start: 0.1mm; inline-size: 104.7mm; block-size: 73.0mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 121.0mm; inset-block-start: 20.2mm; inline-size: 30.4mm; block-size: 27.0mm; font-size: 12.8pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 113.7mm; inset-block-start: 66.8mm; inline-size: 65.9mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_1 }}</h2>
<div class="box ph" style="inset-inline-start: 63.4mm; inset-block-start: 73.2mm; inline-size: 97.7mm; block-size: 66.0mm; font-size: 15.6pt"></div>
<p class="box" style="inset-inline-start: 16.3mm; inset-block-start: 90.9mm; inline-size: 38.1mm; block-size: 11.8mm; font-size: 11.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 16.3mm; inset-block-start: 105.7mm; inline-size: 37.8mm; block-size: 18.9mm; font-size: 10.7pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 5.9mm; inset-block-start: 139.4mm; inline-size: 105.8mm; block-size: 56.4mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 119.1mm; inset-block-start: 148.9mm; inline-size: 34.0mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 119.1mm; inset-block-start: 163.3mm; inline-size: 35.4mm; block-size: 22.6mm; font-size: 10.7pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 62.8mm; inset-block-start: 196.1mm; inline-size: 98.4mm; block-size: 88.6mm; font-size: 14.8pt"></div>
<p class="box" style="inset-inline-start: 14.6mm; inset-block-start: 208.2mm; inline-size: 29.9mm; block-size: 11.5mm; font-size: 10.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 14.6mm; inset-block-start: 222.7mm; inline-size: 40.7mm; block-size: 15.2mm; font-size: 10.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 14.6mm; inset-block-start: 240.8mm; inline-size: 38.1mm; block-size: 18.9mm; font-size: 10.7pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 14.6mm; inset-block-start: 262.7mm; inline-size: 41.5mm; block-size: 7.8mm; font-size: 11.0pt">{{ slot_9 }}</p>
</div></body>
</html>
