  text-align: center;
}

footer ul {
  list-style: none;
  padding: 0;
}

footer a {
  color: #fff;
  text-decoration: none;
}

footer p {
  margin: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
