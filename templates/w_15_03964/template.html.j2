<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
}


nav {
    background-color: #222;
    color: white;
    padding: 15px 0;
}

nav ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
}


.playback-control {
    background-color: #222;
    color: white;
    padding: 20px 0;
    text-align: center;
}


.featured-playlists {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    list-style: none;
}

.featured-playlists li {
    border: 1px solid #222;
    margin: 10px;
    padding: 40px;
    width: 200px;
}


.playlist-image::before {
    content: "";
    color: #222;
    display: block;
    height: 100px;
    margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li>{{ slot_0 }}</li>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
</ul>
</nav>
<section class="playback-control">
<div class="control-buttons">
<span class="play">{{ slot_5 }}</span>
<span class="pause">{{ slot_6 }}</span>
</div>
</section>
<section class="featured-playlists">
<ul>
<li><span class="playlist-image">{{ slot_7 }}</span> {{ slot_8 }} <br><p>{{ slot_9 }}</p></li>
<li><span class="playlist-image">{{ slot_10 }}</span> {{ slot_11 }} <br><p>{{ slot_12 }}</p></li>
<li><span class="playlist-image">{{ slot_13 }}</span> {{ slot_14 }} <br><p>{{ slot_15 }}</p></li>
<li><span class="playlist-image">{{ slot_16 }}</span> {{ slot_17 }} <br><p>{{ slot_18 }}</p></li>
<li><span class="playlist-image">{{ slot_19 }}</span> {{ slot_20 }} <br><p>{{ slot_21 }}</p></li>
</ul>
</section>
</body>
</html>