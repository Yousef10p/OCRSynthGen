<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 116.8mm; inline-size: 153.7mm; block-size: 12.9mm; font-size: 10.0pt">{{ slot_4 }}</p>
<ul class="box" style="inset-inline-start: 31.8mm; inset-block-start: 133.9mm; inline-size: 151.1mm; block-size: 8.5mm; font-size: 10.0pt"><li>{{ slot_5 }}</li></ul>
