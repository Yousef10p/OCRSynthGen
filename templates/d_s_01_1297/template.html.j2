<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 87.1mm; inset-block-start: 7.7mm; inline-size: 37.5mm; block-size: 3.9mm; font-size: 10.9pt">{{ slot_0 }}</header><h2 class="box" style="inset-inline-start: 80.3mm; inset-block-start: 21.7mm; inline-size: 49.3mm; block-size: 14.3mm; font-size: 40.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 27.9mm; inset-block-start: 40.8mm; inline-size: 154.3mm; block-size: 9.7mm; font-size: 27.5pt">{{ slot_2 }}</h2>
<div class="box ph" style="inset-inline-start: 40.5mm; inset-block-start: 62.3mm; inline-size: 129.4mm; block-size: 86.6mm; font-size: 15.3pt"></div>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 160.7mm; inline-size: 154.2mm; block-size: 31.6mm; font-size: 17.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 198.8mm; inline-size: 156.2mm; block-size: 12.6mm; font-size: 17.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 219.9mm; inline-size: 159.5mm; block-size: 18.9mm; font-size: 17.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.5mm; inset-block-start: 245.3mm; inline-size: 158.6mm; block-size: 25.3mm; font-size: 17.9pt">{{ slot_6 }}</p>
</div></body>
</html>
