body {
  font-family: var(--font-body);
  margin: 0;
  padding: 0;
}

#navbar {
  background: #000;
  color: #fff;
  padding: 10px;
}

#navbar ul {
  list-style-type: none;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: space-around;
}

#navbar a {
  color: #fff;
  text-decoration: none;
}

h1 {
  text-align: center;
  padding: 20px;
}

#call-to-action {
  text-align: center;
  padding: 20px;
