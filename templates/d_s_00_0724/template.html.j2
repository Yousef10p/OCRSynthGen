<p class="box" style="inset-inline-start: 110.5mm; inset-block-start: 93.8mm; inline-size: 88.3mm; block-size: 54.8mm; font-size: 15.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 110.5mm; inset-block-start: 158.5mm; inline-size: 71.1mm; block-size: 24.1mm; font-size: 22.8pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 16.0mm; inset-block-start: 176.7mm; inline-size: 88.7mm; block-size: 54.8mm; font-size: 15.5pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 110.5mm; inset-block-start: 192.2mm; inline-size: 62.2mm; block-size: 10.9mm; font-size: 15.5pt">{{ slot_7 }}</h2>
