<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 80.6mm; inline-size: 167.5mm; block-size: 22.3mm; font-size: 12.6pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 108.6mm; inline-size: 166.3mm; block-size: 17.6mm; font-size: 12.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 131.9mm; inline-size: 167.4mm; block-size: 87.6mm; font-size: 13.1pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 225.4mm; inline-size: 166.2mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 239.2mm; inline-size: 167.1mm; block-size: 17.6mm; font-size: 12.5pt">{{ slot_7 }}</p>
