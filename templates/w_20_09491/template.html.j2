<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
	font-family: var(--font-body);
	margin: 0;
	padding: 0;
}
#header {
	background-color: #f8f8f8;
	padding: 20px;
}
#logo {
	width: 100px;
	height: 100px;
	background-color: #ff0000;
	float: right;
}
#menu {
	float: left;
	margin-top: 40px;
}
#menu ul {
	list-style-type: none;
}
#menu ul li {
	display: inline;
	margin-left: 20px;
}
#banner {
	background-color: #00ff00;
	color: white;
	padding: 100px;
	text-align: center;
}
#content {
	clear: both;
	padding: 20px;
}
.product {
	width: 30%;
	float: right;
	margin-left: 5%;
	text-align: center;
}
.product .image {
	width: 100%;
	height: 200px;
	background-color: #0000ff;
}
#footer {
	clear: both;
	background-color: #4d4d4d;
	color: white;
	text-align: center;
	padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="header">
<div class="ph"></div>
<div id="menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</div>
</div>
<div id="banner">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
</div>
<div id="content">
<div class="product">
<div class="image">{{ slot_6 }}</div>
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
</div>
<div class="product">
<div class="image">{{ slot_9 }}</div>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
<div class="product">
<div class="image">{{ slot_12 }}</div>
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
</div>
</div>
<div id="footer">
<p>{{ slot_15 }}</p>
</div>
</body>
</html>