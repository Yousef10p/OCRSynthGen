<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: white;
}

a {
    color: white;
    text-decoration: none;
}

header {
    min-height: 100vh;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

nav ul {
    display: flex; 
    list-style-type: none;
}

nav ul li {
    margin: 0 20px;
}

nav ul li a {
    font-size: 20px;
    transition: all 0.3s;
}

nav ul li a:hover {
    color: rgba(255, 255, 255, 0.7);
}

h1 {
    font-size: 3rem;
    margin: 20px 0;
}

.hero {
    width: 100%;
    height: 60vh;
    background-image: linear-gradient(to left, #52c234, #4070a0);
    margin-bottom: 50px;
}

main {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 50px;
    padding: 50px;
}

main section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #52c234;
    height: 300px;
    padding: 50px;
    transition: all 0.3s;
}

main section:nth-child(odd) {
    background-color: #4070a0;
}

main section:hover {
    background-color: #4070a0;
}

main section:nth-child(odd):hover {
    background-color: #52c234;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
