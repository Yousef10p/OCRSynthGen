#nav {
  list-style: none;
  background-color: #333;
  color: white;
  height: 50px;
}

#nav li {
  display: inline-block;
  padding: 10px 20px;
}

#nav li:hover {
  background-color: #111;
}

#nav ul {
  visibility: hidden;
  opacity: 0;
  position: absolute;
  transition: opacity .5s linear;
}

#nav li:hover > ul, #nav li ul:hover {
  visibility: visible;
  opacity: 1;
}


