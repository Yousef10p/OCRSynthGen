<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

.hero-image {
    width: 100%;
    height: 500px;
    background-color: #ddd;
}

nav {
    position: fixed;
    top: 0;
    width: 200px;
    background-color: #333;
    color: #fff;
    height: 100%;
}

.menu li {
    margin-bottom: 10px;
}

.menu li a,
.sub-menu li a {
    color: #fff;
    text-decoration: none;
}

.sub-menu {
    margin-right: 20px;
    display: none;
}

.menu li:hover .sub-menu,
.sub-menu li:hover .sub-menu {
    display: block;
}

.content-area {
    margin-right: 220px;
    padding: 20px;
}

.service {
    width: 30%;
    display: inline-block;
}

.icon {
    width: 100px;
    height: 100px;
    background-color: #ddd;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="hero-image ph"></div>
<nav>
<ul class="menu">
<li><a>{{ slot_0 }}</a></li>
<li>
<a>{{ slot_1 }}</a>
<ul class="sub-menu">
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
</nav>
<div class="content-area">
<div class="service">
<div class="icon">{{ slot_7 }}</div>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="service">
<div class="icon">{{ slot_10 }}</div>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
</div>
<div class="service">
<div class="icon">{{ slot_13 }}</div>
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</div>
</div>
</body>
</html>