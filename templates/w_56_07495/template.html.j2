}


header {
    position: relative;
}
.header-image {
    width: 100%;
    height: 400px;
    background-color: lightgray;
}
.logo {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    width: 200px;
    height: 100px;
    background-color: lightblue;
}


.content {
    display: flex;
    justify-content: space-between;
}
.sidebar, .main {
    flex: 1;
    padding: 1em;
}
.portfolio-item {
    margin-bottom: 1em;
