<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 168.8mm; inset-block-start: 13.4mm; inline-size: 16.7mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_0 }}</header><div class="box ph" style="inset-inline-start: 27.2mm; inset-block-start: 22.2mm; inline-size: 155.7mm; block-size: 65.5mm; font-size: 15.5pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 98.6mm; inline-size: 161.0mm; block-size: 8.9mm; font-size: 10.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 107.8mm; inline-size: 158.4mm; block-size: 18.1mm; font-size: 10.0pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 25.9mm; inset-block-start: 128.9mm; inline-size: 158.2mm; block-size: 63.0mm; font-size: 14.9pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 204.7mm; inline-size: 160.4mm; block-size: 8.8mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 216.8mm; inline-size: 154.0mm; block-size: 13.5mm; font-size: 10.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 182.7mm; inset-block-start: 260.2mm; inline-size: 2.8mm; block-size: 3.9mm; font-size: 11.0pt">{{ slot_5 }}</footer><div class="box ph" style="inset-inline-start: 24.6mm; inset-block-start: 263.9mm; inline-size: 68.8mm; block-size: 20.5mm; font-size: 14.5pt"></div>
</div></body>
</html>
