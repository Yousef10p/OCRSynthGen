<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background-color: lightgray;
}

nav ul {
    display: flex;
    list-style-type: none;
}

nav ul li {
    margin: 0 10px;
}

main {
    margin: 20px;
}

.color-box {
    width: 200px;
    height: 200px;
    margin: 20px;
    display: inline-block;
    text-align: center;
    line-height: 200px;
    font-size: 20px;
    color: white;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
</header>
<main>
<section id="italian">
<h2>{{ slot_3 }}</h2>
<p>{{ slot_4 }}</p>
<div class="color-box" style="background-color: red">{{ slot_5 }}</div>
<div class="color-box" style="background-color: orange">{{ slot_6 }}</div>
</section>
<section id="american">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="color-box" style="background-color: green">{{ slot_9 }}</div>
<div class="color-box" style="background-color: blue">{{ slot_10 }}</div>
</section>
<section id="mexican">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<div class="color-box" style="background-color: yellow">{{ slot_13 }}</div>
<div class="color-box" style="background-color: purple">{{ slot_14 }}</div>
</section>
</main>
</body>
</html>