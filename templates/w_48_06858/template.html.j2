                    <i class="fa fa-caret-down"></i>
</button>
<div class="dropdown-content">
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
<a>{{ slot_8 }}</a>
</div>
</div>
</nav>
</header>
<main>
<section class="grid">
<div>{{ slot_9 }}</div>
<div>{{ slot_10 }}</div>
<div>{{ slot_11 }}</div>
<div>{{ slot_12 }}</div>
