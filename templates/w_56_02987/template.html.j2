<p>{{ slot_12 }}</p>
<a>{{ slot_13 }}</a>
</section>
<section id="game3">
            {{ slot_14 }}
            <h1>{{ slot_15 }}</h1>
<p>{{ slot_16 }}</p>
<a>{{ slot_17 }}</a>
</section>
</main>
</body>
</html>