<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  font-family: var(--font-body);
}

body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
  background-color: #f0f0f0;
  color: #333;
}

h1 {
  font-size: 2.5em;
  text-align: center;
}

p {
  font-size: 1.2em;
}

ul, ol {
  list-style: none;
  padding: 0;
}

a {
  color: #0066CC;
  text-decoration: none;
}

button {
  display: block;
  margin: 20px auto;
  padding: 10px 20px;
  background-color: #CC0000;
  color: #fff;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

.schedule, .info {
  margin: 20px;
}


.schedule li, .info p {
  font-size: 1.2em;
}


a:hover {
  color: green;
}


.enroll {
  padding: 20px 40px;
  font-size: 1.5em;
  background-color: #fff;
  color: #000;
  border: 1px solid #000;
  transition: background-color 0.3s;
}

.enroll:hover {
  background-color: #000;
  color: #fff;
}


body > img {
  width: 100px;
  height: 100px;
  background-color: #ff0000;
  display: block;
  margin: 20px auto;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="schedule">
<h1>{{ slot_0 }}</h1>
<ul>
<li>{{ slot_1 }}</li>
<li>{{ slot_2 }}</li>
<li>{{ slot_3 }}</li>
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
</ul>
</div>
<div class="info">
<p><strong>{{ slot_6 }}</strong> {{ slot_7 }}</p>
<p><strong>{{ slot_8 }}</strong> {{ slot_9 }}</p>
<p><strong>{{ slot_10 }}</strong> {{ slot_11 }}</p>
<p><strong>{{ slot_12 }}</strong> {{ slot_13 }}</p>
<p><strong>{{ slot_14 }}</strong> <a>{{ slot_15 }}</a></p>
<p><strong>{{ slot_16 }}</strong> <a>{{ slot_17 }}</a></p>
<button class="enroll">{{ slot_18 }}</button>
</div>
</body>
</html>