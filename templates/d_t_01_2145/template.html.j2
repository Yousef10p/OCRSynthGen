<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 31.8mm; inline-size: 109.2mm; block-size: 41.8mm; font-size: 16.9pt">{{ slot_0 }}</p>
<div class="box ph" style="inset-inline-start: 26.5mm; inset-block-start: 34.7mm; inline-size: 48.4mm; block-size: 67.1mm; font-size: 14.6pt"></div>
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 76.5mm; inline-size: 104.1mm; block-size: 18.3mm; font-size: 17.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 97.6mm; inline-size: 103.8mm; block-size: 18.3mm; font-size: 17.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 118.8mm; inline-size: 108.1mm; block-size: 18.3mm; font-size: 17.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 140.0mm; inline-size: 107.4mm; block-size: 67.7mm; font-size: 19.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 81.3mm; inset-block-start: 210.5mm; inline-size: 109.5mm; block-size: 32.4mm; font-size: 18.4pt">{{ slot_5 }}</p>
<footer class="box" style="inset-inline-start: 12.7mm; inset-block-start: 266.1mm; inline-size: 35.4mm; block-size: 3.6mm; font-size: 10.3pt">{{ slot_6 }}</footer>
</div></body>
</html>
