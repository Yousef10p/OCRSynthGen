<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div class="hero">
<div class="hero-text">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
<a class="cta-button">{{ slot_7 }}</a>
</div>
</div>
<div class="grid-container">
<div class="grid-item">
<div class="grid-item-image ph"></div>
<h2>{{ slot_8 }}</h2>
<p>{{ slot_9 }}</p>
</div>
<div class="grid-item">
<div class="grid-item-image ph"></div>
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
<div class="grid-item">
<div class="grid-item-image ph"></div>
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
