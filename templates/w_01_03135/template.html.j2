body, html {
    margin: 0;
    padding: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}


body {
    font-family: var(--font-body);
    line-height: 1.6;
    color: #333;
}

