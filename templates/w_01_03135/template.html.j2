    background-color: #c8c8c8;
    padding: 20px;
}

.article {
    margin-bottom: 20px;
}

.article-image {
    width: 100%;
    height: 200px;
    background-color: #ff0000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
