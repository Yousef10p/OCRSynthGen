<div class="service">{{ slot_8 }}</div>
<div class="service">{{ slot_9 }}</div>
<div class="service">{{ slot_10 }}</div>
</section>
<section>
<h2>{{ slot_11 }}</h2>

<div class="product">{{ slot_12 }}</div>
