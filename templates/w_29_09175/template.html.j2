<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  font-family: var(--font-body);
}

header, nav {
  display: flex;
  justify-content: space-between;
  padding: 1em;
  background-color: #333;
  color: #fff;
}

nav ul {
  list-style: none;
  display: flex;
}

nav ul li {
  margin: 0 1em;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}

.projects .project {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.projects .project .before, 
.projects .project .after {
  height: 200px;
  width: 200px;
  background-color: #333;
}

.blog h2, .contact h2 {
  text-align: center;
}

.blog article {
  border: 1px solid #333;
  margin: 1em;
  padding: 1em;
}

.contact form {
  display: flex;
  flex-direction: column;
  max-width: 500px;
  margin: 0 auto;
}

.contact form label {
  margin: 1em 0 .5em;
}

.contact form input, 
.contact form textarea {
  padding: .5em;
  margin-bottom: 1em;
  border: 1px solid #333;
}

.contact form input[type="submit"] {
  background-color: #333;
  color: #fff;
  border: none;
  padding: 1em;
  cursor: pointer;
  transition: background-color .3s ease-in-out;
}

.contact form input[type="submit"]:hover {
  background-color: #666;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
