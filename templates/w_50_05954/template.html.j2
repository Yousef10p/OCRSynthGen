<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
  box-sizing: border-box;
  font-family: var(--font-body);
}

body {
  margin: 0;
  padding: 0;
  background-color: rgba(66, 166, 235, 0.5); 
}

nav {
  position: sticky;
  top: 0;
  width: 100%;
  background-color: rgba(23, 100, 209, 0.8);
  padding: 10px;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin-left: 20px;
}

nav ul li a {
  color: #fff;
  text-decoration: none;
}

.search-container {
  float: left;
  margin-top: 10px;
}

.search-container form {
  display: flex;
}

.search-container input[type=text] {
  padding: 6px;
  margin-top: 8px;
  border: none;
}

.search-container button {
  padding: 6px 10px;
  margin-top: 8px;
  background: #ddd;
  border: none;
  cursor: pointer;
}

.rectangle {
  height: 200px;
  background-color: rgba(248, 24, 148, 0.6);
}

.main-image {
  display: flex;
  justify-content: center;
  align-items: center;
  height: calc(100vh - 250px);
}

.column-container {
  display: flex;
  justify-content: space-around;
  margin: 50px 0;
}

.column {
  flex: 1;
  text-align: center;
  margin: 20px;
  padding: 20px;
  border: 1px solid #ccc;
  background-color: rgba(89, 133, 216, 0.3);
}

footer {
  position: fixed;
  right: 0;
  bottom: 0;
  width: 100%;
  background-color: rgba(23, 100, 209, 0.8);
  color: white;
  text-align: center;
  padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
<div class="search-container">
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_4 }}</span>
<button>{{ slot_5 }}</button>
</form>
</div>
</nav>
<div class="main-image ph"></div>
<div class="column-container">
<div class="column">
<h2>{{ slot_6 }}</h2>
<p>{{ slot_7 }}</p>
<a>{{ slot_8 }}</a>
</div>
<div class="column">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<a>{{ slot_11 }}</a>
</div>
<div class="column">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<a>{{ slot_14 }}</a>
</div>
</div>
<footer>
<p>{{ slot_15 }}</p>
</footer>
</body>
</html>