<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 125.2mm; inset-block-start: 13.7mm; inline-size: 48.8mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 25.2mm; inline-size: 142.2mm; block-size: 38.1mm; font-size: 18.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 72.6mm; inline-size: 140.6mm; block-size: 77.0mm; font-size: 14.5pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 159.9mm; inline-size: 41.1mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 54.8mm; inset-block-start: 174.1mm; inline-size: 38.2mm; block-size: 4.3mm; font-size: 12.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 186.4mm; inline-size: 141.9mm; block-size: 19.3mm; font-size: 18.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 206.5mm; inline-size: 142.0mm; block-size: 18.4mm; font-size: 17.4pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 34.2mm; inset-block-start: 233.8mm; inline-size: 54.3mm; block-size: 6.2mm; font-size: 17.5pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 242.7mm; inline-size: 141.9mm; block-size: 18.8mm; font-size: 17.7pt">{{ slot_8 }}</p>
</div></body>
</html>
