<h2 class="box" style="inset-inline-start: 44.2mm; inset-block-start: 122.7mm; inline-size: 116.3mm; block-size: 14.4mm; font-size: 40.0pt">{{ slot_4 }}</h2>
<div class="box ph" style="inset-inline-start: 44.5mm; inset-block-start: 137.3mm; inline-size: 25.7mm; block-size: 32.3mm; font-size: 40.0pt"></div>
