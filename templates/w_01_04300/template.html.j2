    background-color: #ccc;
    margin: 20px auto;
}

footer {
    background-color: #333;
    color: #fff;
    padding: 10px;
    text-align: center;
    position: fixed; 
    width: 100%;
    bottom: 0;
}

footer .logo {
    font-size: 1em;
    font-weight: normal;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
