}

.hero, .features, .reviews, .testimonials {
    padding: 50px;
    text-align: center;
}

.hero {
    background-color: #f0f0f0;
}

.features, .reviews, .testimonials {
    background-color: #fff;
}

.feature-img, .review-img, .testimonial-img {
    
    height: 200px;
