<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body, html {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
}

.sidebar {
  position: fixed;
  top: 0;
  right: 0;
  width: 200px;
  height: 100%;
  background: #f8f8f8;
  overflow: auto;
}

.sidebar ul {
  list-style-type: none;
  padding: 10px;
}

.sidebar .dropdown {
  margin-bottom: 10px;
}

.sidebar .dropdown .dropdown-label {
  cursor: pointer;
  font-size: 18px;
}

.sidebar .dropdown .dropdown-content {
  display: none;
  padding-right: 20px;
}

.sidebar .dropdown .dropdown-content a {
  display: block;
  margin-bottom: 5px;
  color: #333;
  text-decoration: none;
}

.content {
  margin-right: 220px;
  padding: 20px;
}

.content p {
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav class="sidebar">
<ul>
<li class="dropdown">
<span class="dropdown-label">{{ slot_0 }} </span>
<div class="dropdown-content">
<a>{{ slot_1 }}</a>
<a>{{ slot_2 }}</a>
<a>{{ slot_3 }}</a>
</div>
</li>
<li class="dropdown">
<span class="dropdown-label">{{ slot_4 }} </span>
<div class="dropdown-content">
<a>{{ slot_5 }}</a>
<a>{{ slot_6 }}</a>
<a>{{ slot_7 }}</a>
</div>
</li>
<li class="dropdown">
<span class="dropdown-label">{{ slot_8 }}</span>
<div class="dropdown-content">
<a>{{ slot_9 }}</a>
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
</div>
</li>
</ul>
</nav>
<div class="content">
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</div>
</body>
</html>