<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 8.9mm; inset-block-start: 16.3mm; inline-size: 45.6mm; block-size: 6.2mm; font-size: 17.5pt">{{ slot_0 }}</h2>
<div class="box ph" style="inset-inline-start: 90.0mm; inset-block-start: 16.8mm; inline-size: 106.7mm; block-size: 59.8mm; font-size: 15.4pt"></div>
<h2 class="box" style="inset-inline-start: 8.9mm; inset-block-start: 23.3mm; inline-size: 38.1mm; block-size: 17.3mm; font-size: 24.5pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 8.9mm; inset-block-start: 48.5mm; inline-size: 57.0mm; block-size: 29.8mm; font-size: 12.1pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 8.9mm; inset-block-start: 82.7mm; inline-size: 57.4mm; block-size: 72.7mm; font-size: 12.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 8.9mm; inset-block-start: 159.8mm; inline-size: 58.2mm; block-size: 38.4mm; font-size: 12.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 90.3mm; inset-block-start: 181.0mm; inline-size: 106.6mm; block-size: 59.4mm; font-size: 15.3pt"></div>
<h2 class="box" style="inset-inline-start: 8.9mm; inset-block-start: 202.6mm; inline-size: 28.7mm; block-size: 4.1mm; font-size: 5.9pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 8.9mm; inset-block-start: 206.9mm; inline-size: 56.9mm; block-size: 34.1mm; font-size: 10.7pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 5.3mm; inset-block-start: 269.8mm; inline-size: 1.6mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_7 }}</footer>
</div></body>
</html>
