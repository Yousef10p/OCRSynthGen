<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 28.3mm; inline-size: 169.3mm; block-size: 13.2mm; font-size: 12.5pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 43.3mm; inline-size: 173.0mm; block-size: 28.2mm; font-size: 13.3pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 75.7mm; inline-size: 172.4mm; block-size: 63.3mm; font-size: 13.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 143.1mm; inline-size: 171.1mm; block-size: 13.3mm; font-size: 12.5pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 158.2mm; inline-size: 170.4mm; block-size: 18.2mm; font-size: 12.9pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 24.5mm; inset-block-start: 178.2mm; inline-size: 170.8mm; block-size: 8.2mm; font-size: 11.6pt">{{ slot_5 }}</p>
<div class="box ph" style="inset-inline-start: 120.7mm; inset-block-start: 195.5mm; inline-size: 76.9mm; block-size: 51.9mm; font-size: 40.0pt"></div>
<h2 class="box" style="inset-inline-start: 45.9mm; inset-block-start: 220.8mm; inline-size: 58.3mm; block-size: 5.3mm; font-size: 15.1pt">{{ slot_6 }}</h2>
<p class="box" style="inset-inline-start: 32.5mm; inset-block-start: 230.0mm; inline-size: 85.6mm; block-size: 14.9mm; font-size: 14.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 43.7mm; inset-block-start: 247.6mm; inline-size: 126.5mm; block-size: 9.1mm; font-size: 12.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 110.4mm; inset-block-start: 268.3mm; inline-size: 1.4mm; block-size: 2.6mm; font-size: 7.3pt">{{ slot_9 }}</footer>
</div></body>
</html>
