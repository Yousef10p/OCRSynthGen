    width: 50%;
}

nav ul li {
    list-style: none;
}

nav ul a {
    text-decoration: none;
}

main {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2em;
    padding: 2em;
}

main section h2 {
    font-size: 1.5em;
    margin-bottom: 1em;
}

main section img {
    width: 100%;
    height: 200px;
