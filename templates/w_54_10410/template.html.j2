<div class="movie-thumbnail">{{ slot_11 }}</div>
<div class="movie-thumbnail">{{ slot_12 }}</div>
<div class="movie-thumbnail">{{ slot_13 }}</div>
<div class="movie-thumbnail">{{ slot_14 }}</div>
<div class="movie-thumbnail">{{ slot_15 }}</div>
<div class="movie-thumbnail">{{ slot_16 }}</div>
<div class="movie-thumbnail">{{ slot_17 }}</div>
</section>

</body>
</html>