    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #f0f0f0;
    font-family: var(--font-body);
}

.nav {
    position: fixed;
    top: 0;
    right: 0;
    width: 300px;
    height: 100%;
    background-color: #2c3e50;
    color: #fff;
}

.nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
}

.nav a {
    display: block;
    padding: 20px;
    color: #fff;
    text-decoration: none;
}

.content {
    margin-right: 300px;
    padding: 20px;
}

.product {
    display: flex;
