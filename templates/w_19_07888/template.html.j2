    margin-bottom: 20px;
}

.product .image {
    width: 100px;
    height: 100px;
    margin-left: 20px;
    background-color: #1abc9c;
}

.testimonials blockquote {
    margin: 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
