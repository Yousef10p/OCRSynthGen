<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 12pt; --line-height: 1.6; --align: start; --page-width: 210mm; --page-height: 297mm; --page-margin: 21mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
@counter-style arabic-letters { system: alphabetic; symbols: "\0623" "\0628" "\062C" "\062F" "\0647" "\0648" "\0632" "\062D" "\0637" "\064A"; suffix: ") "; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 style="font-size: calc(var(--base-size) * 1.8); text-align: start; margin-block: 0.3em 0.5em">{{ slot_0 }}</h1>
<main style="column-count: 2; column-gap: 8mm; column-rule: 1px solid #bbb"><p style="margin-block: 0 1em; text-indent: 0; text-align: justify; font-size: 1.05em">{{ slot_1 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.15); text-align: end; margin-block: 1.4em 0.4em; border-block-end: 1px solid #000; padding-block-end: 0.15em">{{ slot_2 }}</h2>
<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 1.2em">
<li>{{ slot_3 }}<ul style="list-style-type: disc; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_4 }}</li>
<li>{{ slot_5 }}</li>
<li>{{ slot_6 }}</li>
<li>{{ slot_7 }}</li>
</ul>
</li>
<li>{{ slot_8 }}</li>
</ul>
<p style="margin-block: 0 0.7em; text-indent: 0; text-align: start; font-size: 1em">{{ slot_9 }}</p>
<ol style="list-style-type: arabic-letters; margin-block: 0.3em; padding-inline-start: 2.4em">
<li>{{ slot_10 }}</li>
<li>{{ slot_11 }}</li>
<li>{{ slot_12 }}</li>
</ol>
<p style="margin-block: 0 0.4em; text-indent: 0; text-align: start; font-size: 0.95em">{{ slot_13 }}</p>
<p style="margin-block: 0 1em; text-indent: 1.5em; text-align: var(--align); font-size: 0.95em">{{ slot_14 }}</p>
<p style="margin-block: 0 0.7em; text-indent: 1.5em; text-align: var(--align); font-size: 1em">{{ slot_15 }}</p>
<h2 style="font-size: calc(var(--base-size) * 1.5); text-align: start; margin-block: 1.4em 0.4em">{{ slot_16 }}</h2></main>
</div></body>
</html>
