}

nav ul li {
    margin-left: 20px;
}

main {
    display: flex;
    justify-content: space-around;
    margin-top: 60px;
}

aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px;
}

aside .hero-image {
    width: 200px;
    height: 200px;
    background-color: grey;
    margin-bottom: 10px;
}

footer {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 100%;
    background-color: #f8f8f8;
    text-align: center;
    padding: 10px;
}

.cta {
    display: block;
    margin: 20px 0;
    padding: 10px;
    background-color: #008CBA;
    color: white;
    text-decoration: none;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
