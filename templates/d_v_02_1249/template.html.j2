<h2 class="box" style="inset-inline-start: 100.3mm; inset-block-start: 93.4mm; inline-size: 8.9mm; block-size: 3.5mm; font-size: 9.7pt">{{ slot_3 }}</h2>
<div class="box ph" style="inset-inline-start: 76.6mm; inset-block-start: 102.4mm; inline-size: 56.2mm; block-size: 41.7mm; font-size: 14.8pt"></div>
