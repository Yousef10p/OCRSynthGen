<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 138.4mm; inline-size: 175.6mm; block-size: 25.0mm; font-size: 14.2pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 30.0mm; inset-block-start: 169.8mm; inline-size: 153.5mm; block-size: 10.4mm; font-size: 14.8pt"></div>
<div class="box ph" style="inset-inline-start: 57.7mm; inset-block-start: 183.0mm; inline-size: 98.2mm; block-size: 5.0mm; font-size: 14.1pt"></div>
