  padding: 0;
  font-family: var(--font-body);
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px;
}

nav ul {
  display: flex;
  list-style: none;
}

nav ul li {
  margin: 0 10px;
}

main {
  display: flex;
}

section {
  width: 50%;
  padding: 20px;
}

button {
  display: block;
  margin: 20px auto;
}

footer {
  display: flex;
  justify-content: center;
}

footer a {
