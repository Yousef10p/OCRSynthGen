    margin: 0;
    padding: 0;
}


nav {
    background-color: #333;
    color: #fff;
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 50px;
}

nav ul {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
}


#specials {
    margin-top: 50px;
    padding: 20px;
