<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 161.8mm; inset-block-start: 26.9mm; inline-size: 29.0mm; block-size: 11.3mm; font-size: 32.1pt"></div>
<div class="box ph" style="inset-inline-start: 24.7mm; inset-block-start: 40.7mm; inline-size: 46.5mm; block-size: 10.7mm; font-size: 15.2pt"></div>
<h1 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 60.5mm; inline-size: 152.4mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_0 }}</h1>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 67.5mm; inline-size: 59.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 24.1mm; inset-block-start: 79.6mm; inline-size: 28.2mm; block-size: 4.0mm; font-size: 5.7pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 83.7mm; inline-size: 164.9mm; block-size: 16.0mm; font-size: 9.1pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 103.7mm; inline-size: 161.0mm; block-size: 16.0mm; font-size: 11.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 123.3mm; inline-size: 165.8mm; block-size: 16.0mm; font-size: 11.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 143.3mm; inline-size: 162.9mm; block-size: 24.0mm; font-size: 11.3pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 171.4mm; inline-size: 88.6mm; block-size: 3.9mm; font-size: 11.2pt">{{ slot_7 }}</p>
<div class="box ph" style="inset-inline-start: 25.5mm; inset-block-start: 179.5mm; inline-size: 155.6mm; block-size: 48.5mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 228.2mm; inline-size: 71.6mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 25.4mm; inset-block-start: 263.1mm; inline-size: 71.9mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_9 }}</footer><footer class="box" style="inset-inline-start: 188.7mm; inset-block-start: 263.1mm; inline-size: 1.8mm; block-size: 3.6mm; font-size: 10.2pt">{{ slot_10 }}</footer>
</div></body>
</html>
