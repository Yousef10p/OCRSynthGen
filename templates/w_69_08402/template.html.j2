    align-items: center;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    margin: 10px 0;
}

#hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
}

.hero-img {
    width: 80%;
    height: 50vh;
    background: grey;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

section {
    margin: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.product, .recipe {
    width: 80%;
    height: 30vh;
    background: lightgray;
    margin: 20px 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
