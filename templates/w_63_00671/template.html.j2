    align-items: center;
    text-align: center;
}

.logo {
    width: 100px;
    height: 100px;
    background-color: black;
    display: inline-block;
}

.mission, .programs, .events {
    padding: 40px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
