    padding: 14px 16px;
    text-decoration: none;
}

.dropdown {
    display: none;
    position: absolute;
    background-color: #333;
    min-width: 160px;
}

.dropdown li {
    float: none;
}

.dropdown li:hover {
    background-color: #111;
}

.banner {
    height: 600px;
    background-color: lightgray;
