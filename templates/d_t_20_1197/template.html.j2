<div class="box ph" style="inset-inline-start: 16.9mm; inset-block-start: 135.4mm; inline-size: 79.0mm; block-size: 71.3mm; font-size: 15.6pt"></div>
<ul class="box" style="inset-inline-start: 20.1mm; inset-block-start: 212.0mm; inline-size: 110.2mm; block-size: 5.0mm; font-size: 10.5pt"><li>{{ slot_9 }}</li></ul>
