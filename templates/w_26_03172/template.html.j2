}

nav li {
  margin: 0 10px;
}

.content {
  width: 300px;
  margin: 10px;
}

.image {
  width: 300px;
  height: 200px;
  background: #00ff00;
}

.social a {
  margin: 0 10px;
}

form {
  margin: 10px;
}

@media screen and (max-width: 768px) {
  header, main, footer {
    width: 100%;
  }
  
  .content, .image {
    width: 100%;
  }
  
  nav ul {
    flex-direction: column;
    align-items: center;
  }
  
  .top-info {
    text-align: center;
  }
  
  .social {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
