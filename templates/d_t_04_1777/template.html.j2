<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 91.8mm; inline-size: 151.5mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 102.5mm; inline-size: 151.6mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 113.1mm; inline-size: 151.6mm; block-size: 16.9mm; font-size: 11.9pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 36.9mm; inset-block-start: 132.0mm; inline-size: 151.5mm; block-size: 8.6mm; font-size: 12.2pt">{{ slot_7 }}</p>
