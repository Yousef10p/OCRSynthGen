<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 38.8mm; inset-block-start: 31.1mm; inline-size: 137.2mm; block-size: 56.8mm; font-size: 5.0pt"></div>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 97.2mm; inline-size: 152.4mm; block-size: 24.7mm; font-size: 12.0pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 33.0mm; inset-block-start: 129.4mm; inline-size: 75.5mm; block-size: 5.5mm; font-size: 17.2pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 146.6mm; inline-size: 152.4mm; block-size: 41.0mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 33.0mm; inset-block-start: 192.3mm; inline-size: 152.4mm; block-size: 21.1mm; font-size: 12.0pt">{{ slot_3 }}</p>
<ul class="box" style="inset-inline-start: 37.9mm; inset-block-start: 224.5mm; inline-size: 60.6mm; block-size: 7.3mm; font-size: 12.0pt"><li>{{ slot_4 }}</li></ul>
<div class="box ph" style="inset-inline-start: 74.8mm; inset-block-start: 235.3mm; inline-size: 79.1mm; block-size: 17.4mm; font-size: 12.0pt"></div>
<footer class="box" style="inset-inline-start: 107.1mm; inset-block-start: 259.4mm; inline-size: 4.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_5 }}</footer>
</div></body>
</html>
