<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #f8f9fa;
    padding: 10px 20px;
}

.logo {
    color: #007bff;
}

.search-bar input {
    padding: 5px;
    border-radius: 5px;
    border: 1px solid #ced4da;
}

nav {
    background-color: #343a40;
    padding: 10px;
}

nav ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: space-around;
}

nav ul li a {
    color: white;
    text-decoration: none;
}

.promotions, .new-menu-items, .events {
    color: white;
    padding: 20px;
    margin: 10px;
}

.promotions {
    background-color: #dc3545;
}

.new-menu-items {
    background-color: #28a745;
}

.events {
    background-color: #007bff;
}

.story {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
}

.slider {
    display: flex;
    justify-content: center;
    align-items: center;
}

.slide {
    background-color: #6c757d;
    color: white;
    margin: 0 10px;
    padding: 20px;
    border-radius: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
