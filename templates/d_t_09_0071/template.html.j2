<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h1 class="box" style="inset-inline-start: 39.1mm; inset-block-start: 66.3mm; inline-size: 137.0mm; block-size: 6.6mm; font-size: 20.7pt">{{ slot_0 }}</h1>
<header class="box" style="inset-inline-start: 6.5mm; inset-block-start: 72.7mm; inline-size: 6.3mm; block-size: 116.4mm; font-size: 20.0pt">{{ slot_1 }}</header><p class="box" style="inset-inline-start: 69.8mm; inset-block-start: 84.3mm; inline-size: 75.8mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 76.9mm; inset-block-start: 94.8mm; inline-size: 61.4mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 85.3mm; inset-block-start: 105.2mm; inline-size: 44.7mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 84.7mm; inset-block-start: 115.7mm; inline-size: 46.0mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 53.8mm; inset-block-start: 126.1mm; inline-size: 108.0mm; block-size: 5.1mm; font-size: 14.3pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 99.2mm; inset-block-start: 144.2mm; inline-size: 16.9mm; block-size: 2.7mm; font-size: 10.9pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 49.4mm; inset-block-start: 154.9mm; inline-size: 117.2mm; block-size: 81.3mm; font-size: 10.9pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 106.6mm; inset-block-start: 244.5mm; inline-size: 2.1mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
