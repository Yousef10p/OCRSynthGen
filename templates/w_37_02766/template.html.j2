<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    display: flex;
    flex-direction: row;
}

.nav {
    width: 20%;
    padding: 10px;
}

.carousel {
    width: 80%;
    padding: 10px;
}

.game, .review {
    margin-bottom: 10px;
    height: 200px;
    background-color: #bbb;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #fff;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="nav">
<h3>{{ slot_0 }}</h3>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
<h3>{{ slot_5 }}</h3>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</div>
<div class="carousel">
<div class="game" id="game1"><p>{{ slot_9 }}</p></div>
<div class="game" id="game2"><p>{{ slot_10 }}</p></div>
<div class="game" id="game3"><p>{{ slot_11 }}</p></div>
</div>
<div class="reviews">
<h3>{{ slot_12 }}</h3>
<div class="review" id="review1"><p>{{ slot_13 }}</p></div>
<div class="review" id="review2"><p>{{ slot_14 }}</p></div>
<div class="review" id="review3"><p>{{ slot_15 }}</p></div>
</div>
</body>
</html>