    margin-bottom: 15px;
}

.product-card {
    background-color: white;
    color: black;
    padding: 20px;
    text-align: center;
    min-height: 200px;
}

.product-card .product-image {
    background-color: black;
    height: 100px;
    margin: 20px 0;
}

footer {
    background-color: #222;
    color: white;
    text-align: center;
    padding: 10px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
