<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    margin: 0;
    padding: 0;
}

#title {
    grid-area: title;
    text-align: center;
    background-color: lightgray;
    padding: 25px;
    border: 1px solid black;
}

nav {
    grid-area: nav;
    background-color: lightblue;
    padding: 25px;
    border: 1px solid black;
}

main {
    grid-area: main;
    padding: 25px;
    border: 1px solid black;
}

.article-box { 
    margin: 25px;
    padding: 25px;
    border: 1px solid black;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div id="title">{{ slot_0 }}</div>
<nav>
<a>{{ slot_1 }}</a> {{ slot_2 }}
    <a>{{ slot_3 }}</a> {{ slot_4 }}
    <a>{{ slot_5 }}</a> {{ slot_6 }}
    <a>{{ slot_7 }}</a> {{ slot_8 }}
    <a> {{ slot_9 }}</a>
</nav>
<main>
<div style="grid-area: main; display: grid; grid-template-columns: auto auto auto; padding: 25px 0; margin: 0;">
<article class="article-box">
<div style="height:40px;width:400px;background-color:red;">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
</div>
<div style="height:40px;width:400px;background-color:green;">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
</div>
<div style="height:40px;width:400px;background-color:blue;">
<h2>{{ slot_14 }}</h2>
<p>{{ slot_15 }}</p>
</div>
</article>
</div></main></body>
</html>