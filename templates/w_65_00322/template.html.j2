	justify-content: space-between;
	align-items: center;
	padding: 10px 50px;
}

nav ul {
	display: flex;
	list-style-type: none;
}

nav ul li {
	margin: 0 15px;
}

nav ul li a {
	color: #fff;
	text-decoration: none;
	padding: 7px 13px;
	border-radius: 3px;
	background-color: rgba(255,255,255,0.5);
}

main {
	padding-top: 50px;
	margin: 0 50px;
	background-color: #cccccc;
}

section {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: 100vh;
	scroll-snap-align: start;
}

footer {
	background-color: #666666;
	color: #fff;
	text-align: center;
	padding: 20px;
}

img[src*="#"] {
	width: 100px;
	height: 100px;
	background-color: rgba(0,0,0,0.5);
	border-radius: 5px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
