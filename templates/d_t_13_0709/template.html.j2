<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 63.0mm; inset-block-start: 25.9mm; inline-size: 88.8mm; block-size: 9.3mm; font-size: 12.0pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 45.1mm; inline-size: 151.9mm; block-size: 5.6mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 60.1mm; inline-size: 110.7mm; block-size: 5.6mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 76.5mm; inline-size: 22.1mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 90.2mm; inline-size: 171.2mm; block-size: 5.6mm; font-size: 12.0pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 20.6mm; inset-block-start: 111.7mm; inline-size: 62.1mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 20.8mm; inset-block-start: 121.4mm; inline-size: 161.8mm; block-size: 28.8mm; font-size: 12.0pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 20.8mm; inset-block-start: 161.7mm; inline-size: 28.3mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 20.4mm; inset-block-start: 171.4mm; inline-size: 175.6mm; block-size: 28.8mm; font-size: 12.0pt">{{ slot_8 }}</p>
<h2 class="box" style="inset-inline-start: 20.8mm; inset-block-start: 211.7mm; inline-size: 64.5mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_9 }}</h2>
<p class="box" style="inset-inline-start: 20.6mm; inset-block-start: 221.4mm; inline-size: 175.7mm; block-size: 28.8mm; font-size: 12.0pt">{{ slot_10 }}</p>
</div></body>
</html>
