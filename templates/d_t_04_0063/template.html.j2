<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 9.1mm; inline-size: 64.8mm; block-size: 23.3mm; font-size: 11.0pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 92.6mm; inset-block-start: 9.1mm; inline-size: 66.1mm; block-size: 31.1mm; font-size: 11.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 34.3mm; inline-size: 66.1mm; block-size: 27.2mm; font-size: 11.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 92.6mm; inset-block-start: 42.1mm; inline-size: 64.7mm; block-size: 27.2mm; font-size: 11.0pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 23.1mm; inset-block-start: 64.2mm; inline-size: 47.8mm; block-size: 5.9mm; font-size: 8.3pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 69.5mm; inline-size: 66.4mm; block-size: 37.5mm; font-size: 10.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 92.6mm; inset-block-start: 71.1mm; inline-size: 66.0mm; block-size: 38.8mm; font-size: 11.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 23.1mm; inset-block-start: 108.8mm; inline-size: 66.3mm; block-size: 54.3mm; font-size: 11.0pt">{{ slot_7 }}</p>
<header class="box" style="inset-inline-start: 204.5mm; inset-block-start: 181.6mm; inline-size: 4.2mm; block-size: 28.2mm; font-size: 40.0pt">{{ slot_8 }}</header><footer class="box" style="inset-inline-start: 137.2mm; inset-block-start: 269.3mm; inline-size: 20.9mm; block-size: 5.7mm; font-size: 8.1pt">{{ slot_9 }}</footer><footer class="box" style="inset-inline-start: 187.5mm; inset-block-start: 268.7mm; inline-size: 5.3mm; block-size: 5.8mm; font-size: 16.5pt">{{ slot_10 }}</footer>
</div></body>
</html>
