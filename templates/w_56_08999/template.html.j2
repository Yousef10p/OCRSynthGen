  color: #fff;
  position: fixed;
  top: 0;
  right: 0;
  z-index: 1;
  transition: opacity 0.5s ease-in-out;
}

#header.scrolled {
  opacity: 0;
}

#navbar {
  display: flex;
  justify-content: center;
  list-style: none;
  padding: 0;
}

#navbar li {
  padding: 10px;
}

#navbar a {
  color: #fff;
  text-decoration: none;
}

#content {
  margin-top: 80px;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.section {
  max-width: 300px;
  margin: 10px;
  text-align: center;
}

footer {
  position: fixed;
  bottom: 0;
  width: 100%;
  background-color: #000;
  color: #fff;
  text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
