<h2 class="box" style="inset-inline-start: 19.2mm; inset-block-start: 110.7mm; inline-size: 82.2mm; block-size: 5.9mm; font-size: 16.7pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 117.0mm; inline-size: 118.8mm; block-size: 55.6mm; font-size: 14.3pt">{{ slot_5 }}</p>
<header class="box" style="inset-inline-start: 201.8mm; inset-block-start: 118.1mm; inline-size: 9.9mm; block-size: 147.0mm; font-size: 40.0pt">{{ slot_6 }}</header><p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 175.4mm; inline-size: 119.8mm; block-size: 39.2mm; font-size: 13.9pt">{{ slot_7 }}</p>
