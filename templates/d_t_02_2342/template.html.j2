<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 51.9mm; inline-size: 81.8mm; block-size: 22.8mm; font-size: 12.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 107.8mm; inset-block-start: 51.9mm; inline-size: 81.0mm; block-size: 92.8mm; font-size: 13.2pt">{{ slot_1 }}</p>
<h2 class="box" style="inset-inline-start: 21.4mm; inset-block-start: 78.7mm; inline-size: 18.7mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 83.4mm; inline-size: 81.5mm; block-size: 102.1mm; font-size: 13.2pt">{{ slot_3 }}</p>
<header class="box" style="inset-inline-start: 200.9mm; inset-block-start: 145.9mm; inline-size: 3.3mm; block-size: 3.2mm; font-size: 9.1pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 107.8mm; inset-block-start: 147.0mm; inline-size: 80.8mm; block-size: 64.8mm; font-size: 13.1pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 187.8mm; inline-size: 81.1mm; block-size: 27.5mm; font-size: 13.0pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 21.4mm; inset-block-start: 217.6mm; inline-size: 81.9mm; block-size: 22.8mm; font-size: 12.9pt">{{ slot_7 }}</p>
</div></body>
</html>
