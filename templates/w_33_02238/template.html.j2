<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
</ul>
</li>
<li>
<a>{{ slot_9 }}</a>
<ul class="submenu">
<li><a>{{ slot_10 }}</a></li>
<li><a>{{ slot_11 }}</a></li>
</ul>
</li>
</ul>
</nav>
<div class="content">
