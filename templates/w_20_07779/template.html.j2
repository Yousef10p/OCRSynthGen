<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<main>
<section class="products">
<h2>{{ slot_5 }}</h2>
<div class="product">{{ slot_6 }}</div>
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
<button>{{ slot_9 }}</button>
</section>
</main>
<footer>
<div class="social-icons">
<a>{{ slot_10 }}</a>
<a>{{ slot_11 }}</a>
<a>{{ slot_12 }}</a>
</div>
<div class="legal">
<a>{{ slot_13 }}</a>
<a>{{ slot_14 }}</a>
</div>
</footer>
</body>
</html>