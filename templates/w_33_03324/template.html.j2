<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  font-family: var(--font-body);
  color: $font-color;
  background-color: $background-color;
  margin: 0;
  padding: 0;
}

header, footer {
  display: flex;
  justify-content: space-between;
  background-color: $primary-color;
  color: $background-color;
  padding: 15px;
}

input[type="text"] {
  border: 2px solid $border-color;
  padding: 10px;
  border-radius: 5px;
  outline: none;
  background-color: $secondary-color;
}

ul {
  list-style: none;
  display: flex;
}

li {
  margin: 0 15px;
}

a {
  color: $background-color;
  text-decoration: none;
  &:hover {
    color: $secondary-color;
  }
}

section {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 100vh;
  text-align: center;
}

img {
  width: 100%;
  height: 100%;
  background-color: #ccc;
  object-fit: cover;
}

@mixin section-style($color) {
  background-color: $color;
  color: $font-color;
}

#home { @include section-style($primary-color); }
#listings { @include section-style($secondary-color); }
#about { @include section-style($primary-color); }
#services { @include section-style($secondary-color); }
#contact { @include section-style($primary-color); }

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
