<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<div id="hero-image">{{ slot_4 }}</div>
</div>
<div id="main-content">
<h1>{{ slot_5 }}</h1>
<p>{{ slot_6 }}</p>
</div>
<div id="footer">
<p>{{ slot_7 }}</p>
<p><a>{{ slot_8 }}</a> {{ slot_9 }} <a>{{ slot_10 }}</a> {{ slot_11 }} <a>{{ slot_12 }}</a> {{ slot_13 }} <a>{{ slot_14 }}</a></p>
</div>
</body>
</html>