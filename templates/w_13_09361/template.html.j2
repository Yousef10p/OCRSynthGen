    background-color: #f8cbc1;
}

#tutorial1, #tutorial2, #tutorial3 {
    height: 400px;
    background-color: #f8cbc1;
}

form {
    display: flex;
    flex-direction: column;
}

input, textarea {
    margin-bottom: 20px;
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #433a40;
}

button {
    background-color: #433a40;
    color: #f2efe6;
    padding: 10px 20px;
    border-radius: 5px;
    border: none;
    cursor: pointer;
}

button:hover {
    background-color: #7c7477;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
