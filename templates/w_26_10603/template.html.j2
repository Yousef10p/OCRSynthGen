<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    color: #444;
    margin: 0;
    padding: 0;
    background-color: #f6f6f6;
}
nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #e41c83;
}
nav ul li {
    float: right;
}
nav ul li a {
    display: block;
    color: white;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}
nav ul li a:hover {
    background-color: #ffbcdd;
    color: #444;
}
.slider {
    height: 200px;
    background-color: #ffd7a7;
    text-align: center;
    padding-top: 70px;
    color: #444;
}
.product, .partnership {
    height: 100px;
    margin: 20px 0;
    background-color: #8a8a8a;
    color: #fff;
    text-align: center;
    padding-top: 35px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
<div class="slider">
<div class="slide">{{ slot_5 }}</div>
<div class="slide">{{ slot_6 }}</div>
<div class="slide">{{ slot_7 }}</div>
</div>
<section>
<h1>{{ slot_8 }}</h1>
<div class="product">{{ slot_9 }}</div>
<div class="product">{{ slot_10 }}</div>
<div class="product">{{ slot_11 }}</div>
</section>
<section>
<h1>{{ slot_12 }}</h1>
<div class="partnership">{{ slot_13 }}</div>
<div class="partnership">{{ slot_14 }}</div>
<div class="partnership">{{ slot_15 }}</div>
</section>
</body>
</html>