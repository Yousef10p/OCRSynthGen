<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 0.0mm; inset-block-start: 75.1mm; inline-size: 144.2mm; block-size: 96.2mm; font-size: 15.1pt"></div>
<p class="box" style="inset-inline-start: 149.6mm; inset-block-start: 84.8mm; inline-size: 53.3mm; block-size: 50.2mm; font-size: 11.9pt">{{ slot_0 }}</p>
<p class="box" style="inset-inline-start: 149.6mm; inset-block-start: 139.2mm; inline-size: 51.8mm; block-size: 28.6mm; font-size: 11.6pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 145.4mm; inset-block-start: 181.5mm; inline-size: 21.3mm; block-size: 20.8mm; font-size: 11.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 67.9mm; inset-block-start: 181.8mm; inline-size: 17.4mm; block-size: 20.9mm; font-size: 11.8pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 71.8mm; inset-block-start: 210.1mm; inline-size: 33.0mm; block-size: 6.9mm; font-size: 9.8pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 149.1mm; inset-block-start: 210.1mm; inline-size: 34.1mm; block-size: 11.3mm; font-size: 10.6pt">{{ slot_5 }}</p>
</div></body>
</html>
