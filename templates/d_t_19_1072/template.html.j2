<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 143.2mm; inset-block-start: 13.6mm; inline-size: 30.7mm; block-size: 5.1mm; font-size: 14.5pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 25.7mm; inline-size: 142.5mm; block-size: 57.7mm; font-size: 18.2pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 30.9mm; inset-block-start: 89.8mm; inline-size: 145.7mm; block-size: 37.1mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 50.8mm; inset-block-start: 131.4mm; inline-size: 108.1mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 34.0mm; inset-block-start: 148.8mm; inline-size: 71.7mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 46.8mm; inset-block-start: 157.6mm; inline-size: 92.2mm; block-size: 15.8mm; font-size: 22.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 33.9mm; inset-block-start: 184.7mm; inline-size: 68.8mm; block-size: 5.8mm; font-size: 16.4pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 46.8mm; inset-block-start: 193.5mm; inline-size: 43.6mm; block-size: 15.8mm; font-size: 22.4pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 34.1mm; inset-block-start: 214.6mm; inline-size: 141.6mm; block-size: 12.1mm; font-size: 17.1pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 227.7mm; inline-size: 141.5mm; block-size: 18.7mm; font-size: 17.7pt">{{ slot_8 }}</p>
</div></body>
</html>
