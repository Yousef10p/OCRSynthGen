<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 64.4mm; inset-block-start: 13.9mm; inline-size: 78.8mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 26.1mm; inline-size: 169.8mm; block-size: 103.8mm; font-size: 26.7pt">{{ slot_1 }}</p>
<header class="box" style="inset-inline-start: 5.6mm; inset-block-start: 36.1mm; inline-size: 1.1mm; block-size: 2.4mm; font-size: 6.7pt">{{ slot_2 }}</header><p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 134.8mm; inline-size: 163.7mm; block-size: 44.5mm; font-size: 25.2pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 184.2mm; inline-size: 169.7mm; block-size: 34.6mm; font-size: 24.5pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 18.1mm; inset-block-start: 228.9mm; inline-size: 79.7mm; block-size: 30.9mm; font-size: 14.6pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 107.6mm; inset-block-start: 228.9mm; inline-size: 64.8mm; block-size: 3.6mm; font-size: 10.1pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 107.6mm; inset-block-start: 234.3mm; inline-size: 78.3mm; block-size: 9.0mm; font-size: 12.8pt">{{ slot_7 }}</p>
<p class="box" style="inset-inline-start: 107.6mm; inset-block-start: 245.3mm; inline-size: 79.6mm; block-size: 14.5mm; font-size: 13.7pt">{{ slot_8 }}</p>
</div></body>
</html>
