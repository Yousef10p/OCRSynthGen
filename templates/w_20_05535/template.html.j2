<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

.hero-content {
    text-align: center;
    padding: 50px 0;
    background-color: #f4f4f4;
}

.cta-button {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    background-color: #008CBA;
    color: #fff;
    text-decoration: none;
    border-radius: 5px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 20px;
}

.grid:before {
    content: "";
    display: block;
    padding-bottom: 100%;
    background-color: #dbdbdb;
    border-radius: 5px;
}

section {
    padding: 30px;
}

h1, h2 {
    color: #333;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<section id="hero">
<div class="hero-content">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<a class="cta-button">{{ slot_2 }}</a>
</div>
</section>
<section id="content">
<div id="properties">
<h2>{{ slot_3 }}</h2>
<div class="grid">{{ slot_4 }}</div>
<div class="grid">{{ slot_5 }}</div>
<div class="grid">{{ slot_6 }}</div>
</div>
<div id="neighborhoods">
<h2>{{ slot_7 }}</h2>
<div class="grid">{{ slot_8 }}</div>
<div class="grid">{{ slot_9 }}</div>
<div class="grid">{{ slot_10 }}</div>
</div>
<div id="agents">
<h2>{{ slot_11 }}</h2>
<div class="grid">{{ slot_12 }}</div>
<div class="grid">{{ slot_13 }}</div>
<div class="grid">{{ slot_14 }}</div>
</div>
</section>
</body>
</html>