<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 47.9mm; inset-block-start: 27.8mm; inline-size: 137.4mm; block-size: 76.8mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 105.6mm; inline-size: 70.5mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_0 }}</p>
<h2 class="box" style="inset-inline-start: 22.9mm; inset-block-start: 115.8mm; inline-size: 47.6mm; block-size: 4.2mm; font-size: 12.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 125.0mm; inline-size: 141.3mm; block-size: 11.7mm; font-size: 11.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 48.4mm; inset-block-start: 142.3mm; inline-size: 91.4mm; block-size: 56.2mm; font-size: 14.5pt"></div>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 199.2mm; inline-size: 39.0mm; block-size: 2.9mm; font-size: 8.3pt">{{ slot_3 }}</p>
<h2 class="box" style="inset-inline-start: 48.3mm; inset-block-start: 208.3mm; inline-size: 27.7mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_4 }}</h2>
<p class="box" style="inset-inline-start: 48.3mm; inset-block-start: 213.7mm; inline-size: 119.0mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_5 }}</p>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 219.7mm; inline-size: 107.0mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 48.3mm; inset-block-start: 225.7mm; inline-size: 129.4mm; block-size: 3.3mm; font-size: 9.2pt"><li>{{ slot_7 }}</li></ul>
<footer class="box" style="inset-inline-start: 132.5mm; inset-block-start: 266.3mm; inline-size: 60.5mm; block-size: 3.3mm; font-size: 9.2pt">{{ slot_8 }}</footer>
</div></body>
</html>
