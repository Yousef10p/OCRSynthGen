<header class="box" style="inset-inline-start: 207.0mm; inset-block-start: 105.1mm; inline-size: 3.7mm; block-size: 2.7mm; font-size: 7.6pt">{{ slot_4 }}</header><h2 class="box" style="inset-inline-start: 19.6mm; inset-block-start: 109.0mm; inline-size: 39.2mm; block-size: 3.7mm; font-size: 10.4pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 19.6mm; inset-block-start: 116.0mm; inline-size: 73.3mm; block-size: 20.1mm; font-size: 14.3pt">{{ slot_6 }}</p>
