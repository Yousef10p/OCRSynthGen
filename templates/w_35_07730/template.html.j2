<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-body);
}

nav ul {
    list-style-type: none;
}

nav ul li {
    float: right;
    width: 200px;
}

nav ul li a {
    display: block;
    background-color: #f9f9f9;
    padding: 10px;
    text-decoration: none;
    color: #333;
}

nav ul ul {
    display: none;
    position: absolute;
    min-width: 100%;
    right: 0;
    top: 100%;
}

nav ul li:hover > ul {
    display: block;
}

.hero {
    width: 100%;
    height: 300px;
    background-color: #000;
    color: #fff;
    text-align: center;
    line-height: 300px;
    font-size: 30px;
}

.column {
    width: 30%;
    margin: 10px;
    padding: 15px;
    background-color: #f9f9f9;
    border: 1px solid #333;
    font-size: 18px;
    text-align: center;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li>
<a>{{ slot_0 }}</a>
<ul>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</li>
<li>
<a>{{ slot_5 }}</a>
<ul>
<li><a>{{ slot_6 }}</a></li>
<li><a>{{ slot_7 }}</a></li>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
</ul>
</li>
</ul>
</nav>
<div class="hero">{{ slot_10 }}</div>
<div class="column">{{ slot_11 }}</div>
<div class="column">{{ slot_12 }}</div>
<div class="column">{{ slot_13 }}</div>
<div class="column">{{ slot_14 }}</div>
</body>
</html>