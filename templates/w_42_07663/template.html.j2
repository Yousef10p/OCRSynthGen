<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    background-color: #f0f0f0;
}
h1, h2 {
    color: #333;
}
a {
    color: #000;
}
button {
    background-color: #444;
    color: #fff;
}


header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: #888;
}
nav ul {
    display: flex;
    gap: 20px;
}


#product {
    display: grid;
    grid-template-columns: 2fr 1fr;
}
#product-image {
    background-color: #000;
    height: 50vh;
}
#product-options {
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
}


aside {
    padding: 20px;
    background-color: #ccc;
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    width: 20%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
</ul>
</nav>
<h1>{{ slot_4 }}</h1>
</header>
<section id="product">
<div class="ph"></div>
<div id="product-options">
<button>{{ slot_5 }}</button>
<button>{{ slot_6 }}</button>
<button>{{ slot_7 }}</button>
</div>
</section>
<aside>
<h2>{{ slot_8 }}</h2>
<a>{{ slot_9 }}</a>
<a>{{ slot_10 }}</a>
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
<p>{{ slot_13 }}</p>
<button>{{ slot_14 }}</button>
</aside>
</body>
</html>