}

.related-products .product-image .image-rect {
    width: 100px;
    height: 100px;
    background: #f2f2f2;
}

.wishlist {
    clear: both;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
