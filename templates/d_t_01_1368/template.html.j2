<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 15.1mm; inset-block-start: 29.7mm; inline-size: 194.9mm; block-size: 63.7mm; font-size: 40.0pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 15.1mm; inset-block-start: 86.2mm; inline-size: 102.0mm; block-size: 35.4mm; font-size: 40.0pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 119.3mm; inset-block-start: 101.2mm; inline-size: 85.8mm; block-size: 39.7mm; font-size: 22.5pt">{{ slot_2 }}</p>
<h2 class="box" style="inset-inline-start: 40.8mm; inset-block-start: 128.5mm; inline-size: 35.6mm; block-size: 7.3mm; font-size: 6.9pt">{{ slot_3 }}</h2>
<p class="box" style="inset-inline-start: 40.8mm; inset-block-start: 136.0mm; inline-size: 45.6mm; block-size: 3.3mm; font-size: 5.0pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 40.4mm; inset-block-start: 142.8mm; inline-size: 38.9mm; block-size: 55.7mm; font-size: 22.6pt"></div>
<p class="box" style="inset-inline-start: 111.1mm; inset-block-start: 158.5mm; inline-size: 86.3mm; block-size: 95.9mm; font-size: 12.9pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.2mm; inset-block-start: 247.3mm; inline-size: 81.1mm; block-size: 6.9mm; font-size: 9.7pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 19.1mm; inset-block-start: 265.6mm; inline-size: 65.6mm; block-size: 3.4mm; font-size: 9.6pt">{{ slot_7 }}</footer><footer class="box" style="inset-inline-start: 88.2mm; inset-block-start: 265.1mm; inline-size: 112.3mm; block-size: 4.1mm; font-size: 11.7pt">{{ slot_8 }}</footer>
</div></body>
</html>
