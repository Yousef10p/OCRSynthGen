<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 34.5mm; inset-block-start: 13.6mm; inline-size: 46.2mm; block-size: 5.2mm; font-size: 14.8pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 34.4mm; inset-block-start: 25.9mm; inline-size: 141.0mm; block-size: 38.5mm; font-size: 18.2pt">{{ slot_1 }}</p>
<div class="box ph" style="inset-inline-start: 32.9mm; inset-block-start: 80.6mm; inline-size: 146.3mm; block-size: 15.2mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 60.0mm; inset-block-start: 99.9mm; inline-size: 90.3mm; block-size: 5.7mm; font-size: 16.1pt">{{ slot_2 }}</p>
<div class="box ph" style="inset-inline-start: 32.7mm; inset-block-start: 123.6mm; inline-size: 145.5mm; block-size: 35.6mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 62.9mm; inset-block-start: 162.9mm; inline-size: 85.1mm; block-size: 5.7mm; font-size: 16.1pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 32.6mm; inset-block-start: 184.7mm; inline-size: 146.6mm; block-size: 17.0mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 62.1mm; inset-block-start: 205.9mm; inline-size: 86.8mm; block-size: 5.7mm; font-size: 16.1pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 32.7mm; inset-block-start: 228.1mm; inline-size: 145.3mm; block-size: 18.3mm; font-size: 40.0pt"></div>
<p class="box" style="inset-inline-start: 57.7mm; inset-block-start: 249.6mm; inline-size: 96.1mm; block-size: 5.7mm; font-size: 16.1pt">{{ slot_5 }}</p>
</div></body>
</html>
