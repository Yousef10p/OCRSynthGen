<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 34.3mm; inset-block-start: 35.3mm; inline-size: 28.5mm; block-size: 4.9mm; font-size: 13.9pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 88.1mm; inset-block-start: 36.0mm; inline-size: 29.8mm; block-size: 3.4mm; font-size: 5.0pt">{{ slot_1 }}</h2>
<h2 class="box" style="inset-inline-start: 139.2mm; inset-block-start: 34.3mm; inline-size: 20.4mm; block-size: 4.9mm; font-size: 13.8pt">{{ slot_2 }}</h2>
<p class="box" style="inset-inline-start: 68.6mm; inset-block-start: 38.6mm; inline-size: 67.0mm; block-size: 10.1mm; font-size: 7.2pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 38.5mm; inset-block-start: 58.8mm; inline-size: 127.6mm; block-size: 97.5mm; font-size: 15.4pt"></div>
<p class="box" style="inset-inline-start: 99.3mm; inset-block-start: 156.9mm; inline-size: 13.5mm; block-size: 4.0mm; font-size: 11.4pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 48.7mm; inset-block-start: 163.6mm; inline-size: 120.1mm; block-size: 92.0mm; font-size: 15.3pt"></div>
</div></body>
</html>
