<ul class="box" style="inset-inline-start: 25.5mm; inset-block-start: 77.8mm; inline-size: 164.0mm; block-size: 13.3mm; font-size: 10.0pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 19.1mm; inset-block-start: 96.1mm; inline-size: 110.4mm; block-size: 7.1mm; font-size: 18.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 19.1mm; inset-block-start: 108.7mm; inline-size: 81.0mm; block-size: 3.9mm; font-size: 10.0pt">{{ slot_6 }}</p>
