<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 32.9mm; inset-block-start: 57.6mm; inline-size: 20.7mm; block-size: 4.2mm; font-size: 11.8pt">{{ slot_0 }}</h2>
<p class="box" style="inset-inline-start: 32.9mm; inset-block-start: 64.0mm; inline-size: 141.8mm; block-size: 21.0mm; font-size: 14.9pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 32.8mm; inset-block-start: 88.7mm; inline-size: 117.3mm; block-size: 26.9mm; font-size: 15.2pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 158.5mm; inset-block-start: 101.9mm; inline-size: 38.0mm; block-size: 70.0mm; font-size: 15.3pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 32.7mm; inset-block-start: 119.2mm; inline-size: 114.6mm; block-size: 38.5mm; font-size: 15.6pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 32.8mm; inset-block-start: 163.7mm; inline-size: 30.9mm; block-size: 5.0mm; font-size: 14.1pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 32.8mm; inset-block-start: 172.7mm; inline-size: 139.8mm; block-size: 26.9mm; font-size: 15.2pt">{{ slot_6 }}</p>
<p class="box" style="inset-inline-start: 32.7mm; inset-block-start: 203.3mm; inline-size: 144.9mm; block-size: 21.0mm; font-size: 14.9pt">{{ slot_7 }}</p>
<footer class="box" style="inset-inline-start: 195.4mm; inset-block-start: 279.6mm; inline-size: 3.3mm; block-size: 7.2mm; font-size: 20.4pt">{{ slot_8 }}</footer><footer class="box" style="inset-inline-start: 128.3mm; inset-block-start: 282.6mm; inline-size: 57.2mm; block-size: 2.1mm; font-size: 6.0pt">{{ slot_9 }}</footer>
</div></body>
</html>
