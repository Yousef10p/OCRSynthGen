<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    color: #fff;
    background-color: #222;
}

header {
    position: relative;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}
.header-image {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background-color: #444;
    animation: image-animation 10s infinite;
}
@keyframes image-animation {
    0%   {background-color: #444;}
    50%  {background-color: #777;}
    100% {background-color: #444;}
}
nav {
    z-index: 1;
    display: flex;
    justify-content: space-between;
    width: 100%;
    background-color: #333;
    color: #fff;
}
.left-column {
    width: 30%;
    
}
.right-column {
    width: 50%;
    display: flex;
    justify-content: space-around;
    list-style-type: none;
}
.product-launch-image {
    margin: 50px auto;
    width: 200px;
    height: 200px;
    background-color: #666;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: product-launch 5s infinite;
}
@keyframes product-launch {
    0%   {background-color: #666;}
    50%  {background-color: #999;}
    100% {background-color: #666;}
}
section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 50px 0;
}
p {
    width: 50%;
    text-align: center;
    margin: 50px 0;
    font-size: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
