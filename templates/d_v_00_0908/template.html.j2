<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 75.9mm; inset-block-start: 23.4mm; inline-size: 45.2mm; block-size: 5.2mm; font-size: 14.8pt"></div>
<h2 class="box" style="inset-inline-start: 32.3mm; inset-block-start: 49.4mm; inline-size: 151.0mm; block-size: 16.6mm; font-size: 15.7pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 32.3mm; inset-block-start: 73.3mm; inline-size: 60.8mm; block-size: 5.4mm; font-size: 15.4pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 32.3mm; inset-block-start: 82.2mm; inline-size: 147.9mm; block-size: 8.1mm; font-size: 11.4pt">{{ slot_2 }}</p>
<ul class="box" style="inset-inline-start: 38.6mm; inset-block-start: 93.9mm; inline-size: 148.2mm; block-size: 31.2mm; font-size: 11.1pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 38.6mm; inset-block-start: 128.6mm; inline-size: 148.2mm; block-size: 27.4mm; font-size: 11.1pt"><li>{{ slot_4 }}</li></ul>
<h2 class="box" style="inset-inline-start: 32.3mm; inset-block-start: 159.5mm; inline-size: 87.8mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 32.3mm; inset-block-start: 168.0mm; inline-size: 148.6mm; block-size: 27.3mm; font-size: 11.1pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 32.3mm; inset-block-start: 198.7mm; inline-size: 42.2mm; block-size: 5.0mm; font-size: 14.2pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 32.3mm; inset-block-start: 207.2mm; inline-size: 153.8mm; block-size: 15.8mm; font-size: 11.2pt">{{ slot_8 }}</p>
<p class="box" style="inset-inline-start: 32.3mm; inset-block-start: 226.5mm; inline-size: 153.6mm; block-size: 23.5mm; font-size: 11.1pt">{{ slot_9 }}</p>
<p class="box" style="inset-inline-start: 137.1mm; inset-block-start: 261.8mm; inline-size: 48.3mm; block-size: 6.4mm; font-size: 9.1pt">{{ slot_10 }}</p>
<footer class="box" style="inset-inline-start: 161.8mm; inset-block-start: 287.8mm; inline-size: 28.2mm; block-size: 2.8mm; font-size: 7.9pt">{{ slot_11 }}</footer><footer class="box" style="inset-inline-start: 196.1mm; inset-block-start: 286.8mm; inline-size: 3.9mm; block-size: 4.0mm; font-size: 11.3pt">{{ slot_12 }}</footer>
</div></body>
</html>
