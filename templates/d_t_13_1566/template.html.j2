<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 157.0mm; inset-block-start: 12.1mm; inline-size: 41.8mm; block-size: 2.6mm; font-size: 8.0pt">{{ slot_0 }}</header><header class="box" style="inset-inline-start: 53.7mm; inset-block-start: 15.8mm; inline-size: 102.3mm; block-size: 12.8mm; font-size: 11.0pt">{{ slot_1 }}</header><header class="box" style="inset-inline-start: 162.7mm; inset-block-start: 18.6mm; inline-size: 31.5mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_2 }}</header><div class="box ph" style="inset-inline-start: 30.0mm; inset-block-start: 19.5mm; inline-size: 18.1mm; block-size: 10.5mm; font-size: 14.9pt"></div>
<header class="box" style="inset-inline-start: 74.6mm; inset-block-start: 30.9mm; inline-size: 60.2mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_3 }}</header><header class="box" style="inset-inline-start: 169.7mm; inset-block-start: 31.3mm; inline-size: 17.5mm; block-size: 3.5mm; font-size: 9.0pt">{{ slot_4 }}</header><p class="box" style="inset-inline-start: 50.8mm; inset-block-start: 54.3mm; inline-size: 105.2mm; block-size: 12.8mm; font-size: 16.0pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 56.7mm; inset-block-start: 84.5mm; inline-size: 100.7mm; block-size: 6.3mm; font-size: 16.0pt">{{ slot_6 }}</p>
<h1 class="box" style="inset-inline-start: 81.5mm; inset-block-start: 118.9mm; inline-size: 43.8mm; block-size: 7.1mm; font-size: 18.0pt">{{ slot_7 }}</h1>
<h1 class="box" style="inset-inline-start: 62.5mm; inset-block-start: 136.9mm; inline-size: 81.7mm; block-size: 6.3mm; font-size: 16.0pt">{{ slot_8 }}</h1>
</div></body>
</html>
