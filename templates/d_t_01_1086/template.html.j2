<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 19.7mm; inset-block-start: 38.7mm; inline-size: 47.8mm; block-size: 3.7mm; font-size: 10.5pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 19.7mm; inset-block-start: 44.8mm; inline-size: 39.1mm; block-size: 3.2mm; font-size: 8.9pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 49.7mm; inline-size: 167.2mm; block-size: 27.1mm; font-size: 12.8pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 80.1mm; inline-size: 166.8mm; block-size: 31.9mm; font-size: 12.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 115.4mm; inline-size: 166.8mm; block-size: 46.4mm; font-size: 13.2pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 165.2mm; inline-size: 165.8mm; block-size: 17.4mm; font-size: 12.3pt">{{ slot_5 }}</p>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 185.9mm; inline-size: 164.2mm; block-size: 22.2mm; font-size: 12.6pt">{{ slot_6 }}</p>
<h2 class="box" style="inset-inline-start: 19.7mm; inset-block-start: 212.5mm; inline-size: 43.1mm; block-size: 3.2mm; font-size: 8.9pt">{{ slot_7 }}</h2>
<p class="box" style="inset-inline-start: 19.7mm; inset-block-start: 217.4mm; inline-size: 165.9mm; block-size: 51.2mm; font-size: 13.2pt">{{ slot_8 }}</p>
<footer class="box" style="inset-inline-start: 97.9mm; inset-block-start: 276.4mm; inline-size: 29.8mm; block-size: 2.6mm; font-size: 7.4pt">{{ slot_9 }}</footer>
</div></body>
</html>
