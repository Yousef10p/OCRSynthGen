<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
}

nav {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #333;
    color: #fff;
    padding: 10px 0;
}

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    text-align: center;
}

nav ul li {
    display: inline-block;
    margin: 0 10px;
}

#slideshow {
    width: 100%;
    height: 300px;
    position: relative;
}

.slide {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 300px;
    text-align: center;
    padding-top: 100px; 
}

#tops { background-color: #f00; }
#bottoms { background-color: #0f0; }
#accessories { background-color: #00f; }

#products-tops, #products-bottoms, #products-accessories {
    display: flex;
    flex-wrap: wrap;
}

.product {
    width: 50%; 
    height: 100px;
    text-align: center;
    padding-top: 30px; 
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
</ul>
</nav>
<div id="slideshow">
<div class="slide" id="tops">{{ slot_3 }}</div>
<div class="slide" id="bottoms">{{ slot_4 }}</div>
<div class="slide" id="accessories">{{ slot_5 }}</div>
</div>
<h2>{{ slot_6 }}</h2>
<div id="products-tops">
<div class="product">{{ slot_7 }}</div>
<div class="product">{{ slot_8 }}</div>
</div>
<h2>{{ slot_9 }}</h2>
<div id="products-bottoms">
<div class="product">{{ slot_10 }}</div>
<div class="product">{{ slot_11 }}</div>
</div>
<h2>{{ slot_12 }}</h2>
<div id="products-accessories">
<div class="product">{{ slot_13 }}</div>
<div class="product">{{ slot_14 }}</div>
</div>
</body>
</html>