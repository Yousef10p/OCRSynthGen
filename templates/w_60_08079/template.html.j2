<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
  color: #333;
  background: #f4f4f4;
}

header {
  background: #333;
  color: #fff;
  padding: 10px 0;
  position: fixed;
  width: 100%;
}

header ul {
  list-style: none;
  text-align: left;
}

header ul li {
  display: inline;
  margin-left: 10px;
}

header ul li a {
  color: #fff;
  text-decoration: none;
}

.video-container {
  position: relative;
  text-align: center;
  color: white;
}

.overlay-text {
  position: absolute;
  top: 50%;
  right: 50%;
  transform: translate(50%, -50%);
}

.overlay-text h1 {
  font-size: 50px;
}

.overlay-text p {
  font-size: 25px;
}

.overlay-text a {
  color: white;
  padding: 10px 20px;
  border: 1px solid white;
  text-decoration: none;
}

.image {
  width: 100%;
  height: 500px;
  background: #666;
  margin-top: 50px;
}

#about {
  background: #999;
}

#features {
  background: #bbb;
}

#buy {
  background: #ddd;
}

footer {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 20px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
