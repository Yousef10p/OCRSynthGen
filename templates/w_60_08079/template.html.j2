</ul>
</nav>
</header>
<div class="video-container">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<div class="overlay-text">
<h1>{{ slot_4 }}</h1>
<p>{{ slot_5 }}</p>
<a class="button">{{ slot_6 }}</a>
</div>
</div>
<section id="about">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<div class="image ph"></div>
</section>
<section id="features">
<h2>{{ slot_9 }}</h2>
<p>{{ slot_10 }}</p>
<div class="image ph"></div>
</section>
<section id="buy">
<h2>{{ slot_11 }}</h2>
<p>{{ slot_12 }}</p>
