<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<header class="box" style="inset-inline-start: 10.9mm; inset-block-start: 3.5mm; inline-size: 36.7mm; block-size: 3.7mm; font-size: 10.6pt">{{ slot_0 }}</header><p class="box" style="inset-inline-start: 146.4mm; inset-block-start: 22.2mm; inline-size: 54.6mm; block-size: 42.4mm; font-size: 20.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 21.0mm; inset-block-start: 27.7mm; inline-size: 106.7mm; block-size: 40.3mm; font-size: 14.3pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 146.4mm; inset-block-start: 68.8mm; inline-size: 54.6mm; block-size: 57.9mm; font-size: 20.5pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 19.1mm; inset-block-start: 79.1mm; inline-size: 110.6mm; block-size: 161.2mm; font-size: 15.2pt"></div>
<p class="box" style="inset-inline-start: 146.4mm; inset-block-start: 130.9mm; inline-size: 55.4mm; block-size: 81.2mm; font-size: 20.9pt">{{ slot_4 }}</p>
<div class="box ph" style="inset-inline-start: 149.6mm; inset-block-start: 225.4mm; inline-size: 44.8mm; block-size: 32.0mm; font-size: 15.1pt"></div>
<footer class="box" style="inset-inline-start: 106.2mm; inset-block-start: 270.9mm; inline-size: 3.7mm; block-size: 3.3mm; font-size: 9.3pt">{{ slot_5 }}</footer>
</div></body>
</html>
