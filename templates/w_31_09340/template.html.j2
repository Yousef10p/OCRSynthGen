<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
.wrapper {
    display: flex;
}
.left-column {
    flex: 60%;
    padding: 20px;
}
.right-column {
    flex: 40%;
    padding: 20px;
}
h1 {
    margin: 20px 0;
}
ul {
    list-style-type: none;
    padding: 0;
}
li {
    margin: 10px 0;
}
.price {
    float: left;
}
.image-placeholder {
    width: 100%;
    height: 200px;
    background-color: #e0e0e0;
    margin: 20px 0;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="wrapper">
<div class="left-column">
<h1>{{ slot_0 }}</h1>
<p>{{ slot_1 }}</p>
<h2>{{ slot_2 }}</h2>
<ul>
<li>{{ slot_3 }} <span class="price">{{ slot_4 }}</span></li>
<li>{{ slot_5 }} <span class="price">{{ slot_6 }}</span></li>
</ul>
<h2>{{ slot_7 }}</h2>
<ul>
<li>{{ slot_8 }} <span class="price">{{ slot_9 }}</span></li>
<li>{{ slot_10 }} <span class="price">{{ slot_11 }}</span></li>
</ul>
<h2>{{ slot_12 }}</h2>
<ul>
<li>{{ slot_13 }} <span class="price">{{ slot_14 }}</span></li>
<li>{{ slot_15 }} <span class="price">{{ slot_16 }}</span></li>
</ul>
</div>
<div class="right-column">
<div class="image-placeholder ph"></div>
<h1>{{ slot_17 }}</h1>
<p>{{ slot_18 }}</p>
<div class="image-placeholder ph"></div>
</div>
</div>
</body>
</html>