<h2>{{ slot_9 }}</h2>
<div class="image">{{ slot_10 }}</div>
<p>{{ slot_11 }}</p>
<h2>{{ slot_12 }}</h2>
<div class="image">{{ slot_13 }}</div>
<p>{{ slot_14 }}</p>
<h2>{{ slot_15 }}</h2>
<div class="image">{{ slot_16 }}</div>
<p>{{ slot_17 }}</p>
<h2>{{ slot_18 }}</h2>
<div class="image">{{ slot_19 }}</div>
<p>{{ slot_20 }}</p>
</div>
</div>
</body>
</html>