<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    color: white;
    margin: 0;
    padding: 0;
    background-color: black;
}

header {
    position: sticky;
    top: 0;
    background-color: black;
    padding: 10px;
    text-align: center;
}

nav ul {
    list-style-type: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 10px;
}

nav ul li a {
    color: white;
    text-decoration: none;
}

main {
    padding: 10px;
}

section {
    margin: 20px 0;
}

.player-spotlight-image, .game-schedules-image, .statistics-image {
    width: 100px;
    height: 100px;
    background-color: gray; 
}

.button {
    display: inline-block;
    background-color: orange;
    color: white;
    padding: 5px 10px;
    text-decoration: none;
}

footer {
    background-color: black;
    color: white;
    text-align: center;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<nav>
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
</ul>
</nav>
</header>
<main>
<section id="player-spotlight">
<h2>{{ slot_5 }}</h2>
<p>{{ slot_6 }}</p>
<div class="player-spotlight-image ph"></div>
</section>
<section id="tickets">
<h2>{{ slot_7 }}</h2>
<p>{{ slot_8 }}</p>
<a class="button">{{ slot_9 }}</a>
</section>
<section id="merchandise">
<h2>{{ slot_10 }}</h2>
<p>{{ slot_11 }}</p>
<a class="button">{{ slot_12 }}</a>
</section>
<section id="game-schedules">
<h2>{{ slot_13 }}</h2>
<p>{{ slot_14 }}</p>
<div class="game-schedules-image ph"></div>
</section>
<section id="statistics">
<h2>{{ slot_15 }}</h2>
<p>{{ slot_16 }}</p>
<div class="statistics-image ph"></div>
</section>
</main>
<footer>
<p>{{ slot_17 }}</p>
</footer>
</body>
</html>