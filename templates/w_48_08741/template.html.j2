<li>{{ slot_5 }} <p>{{ slot_6 }}</p></li>
</ul>
<h3>{{ slot_7 }}</h3>
<p>{{ slot_8 }}</p>
</div>
<div class="middle-col">

<div class="placeholder-img ph"></div>

<div class="placeholder-img ph"></div>
</div>
<div class="right-col">
<h3>{{ slot_9 }}</h3>
<p>{{ slot_10 }}</p>
<h3>{{ slot_11 }}</h3>
<p>{{ slot_12 }}<br>{{ slot_13 }}<br>{{ slot_14 }}</p>
</div>
</div>
</body>
</html>