<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 34.2mm; inset-block-start: 13.9mm; inline-size: 44.4mm; block-size: 5.0mm; font-size: 14.0pt">{{ slot_0 }}</h2>
<ul class="box" style="inset-inline-start: 43.8mm; inset-block-start: 25.0mm; inline-size: 114.2mm; block-size: 5.5mm; font-size: 15.6pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.9mm; inset-block-start: 33.6mm; inline-size: 119.0mm; block-size: 5.5mm; font-size: 15.6pt"><li>{{ slot_2 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.8mm; inset-block-start: 42.3mm; inline-size: 121.8mm; block-size: 11.9mm; font-size: 16.9pt"><li>{{ slot_3 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.7mm; inset-block-start: 57.5mm; inline-size: 122.7mm; block-size: 25.0mm; font-size: 17.7pt"><li>{{ slot_4 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.7mm; inset-block-start: 85.6mm; inline-size: 122.2mm; block-size: 18.5mm; font-size: 17.4pt"><li>{{ slot_5 }}</li></ul>
<ul class="box" style="inset-inline-start: 61.7mm; inset-block-start: 105.0mm; inline-size: 97.8mm; block-size: 11.9mm; font-size: 16.9pt"><li>{{ slot_6 }}</li></ul>
<ul class="box" style="inset-inline-start: 61.8mm; inset-block-start: 117.9mm; inline-size: 104.4mm; block-size: 12.0mm; font-size: 17.1pt"><li>{{ slot_7 }}</li></ul>
<ul class="box" style="inset-inline-start: 43.8mm; inset-block-start: 133.1mm; inline-size: 122.5mm; block-size: 11.9mm; font-size: 16.9pt"><li>{{ slot_8 }}</li></ul>
<p class="box" style="inset-inline-start: 34.2mm; inset-block-start: 148.0mm; inline-size: 141.4mm; block-size: 89.7mm; font-size: 18.2pt">{{ slot_9 }}</p>
</div></body>
</html>
