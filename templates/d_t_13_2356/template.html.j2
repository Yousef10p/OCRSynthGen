<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<div class="box ph" style="inset-inline-start: 8.7mm; inset-block-start: 20.0mm; inline-size: 43.1mm; block-size: 30.0mm; font-size: 14.2pt"></div>
<h1 class="box" style="inset-inline-start: 23.4mm; inset-block-start: 55.9mm; inline-size: 156.4mm; block-size: 85.5mm; font-size: 14.0pt">{{ slot_0 }}</h1>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 164.3mm; inline-size: 149.1mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_1 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 182.1mm; inline-size: 160.0mm; block-size: 4.7mm; font-size: 12.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 199.8mm; inline-size: 152.4mm; block-size: 10.4mm; font-size: 12.0pt">{{ slot_3 }}</p>
<div class="box ph" style="inset-inline-start: 12.1mm; inset-block-start: 256.8mm; inline-size: 37.9mm; block-size: 11.7mm; font-size: 16.6pt"></div>
<p class="box" style="inset-inline-start: 56.5mm; inset-block-start: 261.3mm; inline-size: 64.9mm; block-size: 4.3mm; font-size: 11.0pt">{{ slot_4 }}</p>
<footer class="box" style="inset-inline-start: 12.6mm; inset-block-start: 285.8mm; inline-size: 58.5mm; block-size: 3.2mm; font-size: 8.0pt">{{ slot_5 }}</footer><footer class="box" style="inset-inline-start: 175.9mm; inset-block-start: 285.8mm; inline-size: 15.1mm; block-size: 3.2mm; font-size: 8.0pt">{{ slot_6 }}</footer>
</div></body>
</html>
