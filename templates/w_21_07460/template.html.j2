<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

body {
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
}

header {
    position: relative;
}

.banner-image {
    height: 400px;
    background-color: #eee;
}

form {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
}

input[type="text"] {
    padding: 10px;
    width: 300px;
}

input[type="submit"] {
    padding: 10px;
    background-color: lightblue;
    border: none;
    cursor: pointer;
}

.cta {
    padding: 10px;
    background-color: blue;
    color: white;
    text-decoration: none;
    display: inline-block;
    margin-top: 10px;
}

aside {
    position: absolute;
    top: 0;
    left: 0;
    width: 300px;
    background-color: lightgray;
    padding: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<header>
<div class="banner-image ph"></div>
<form>
<span class="" style="display: inline-block; min-inline-size: 10em; border: 1px solid #999; padding: 0.2em 0.4em">{{ slot_0 }}</span>
<span class="">{{ slot_1 }}</span>
</form>
<a class="cta">{{ slot_2 }}</a>
</header>
<aside>
<h2>{{ slot_3 }}</h2>
<ul>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
<li><a>{{ slot_6 }}</a></li>
</ul>
<h2>{{ slot_7 }}</h2>
<ul>
<li><a>{{ slot_8 }}</a></li>
<li><a>{{ slot_9 }}</a></li>
<li><a>{{ slot_10 }}</a></li>
</ul>
<h2>{{ slot_11 }}</h2>
<ul>
<li><a>{{ slot_12 }}</a></li>
<li><a>{{ slot_13 }}</a></li>
<li><a>{{ slot_14 }}</a></li>
</ul>
</aside>
<main></main>
<footer></footer>
</body>
</html>