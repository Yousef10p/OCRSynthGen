<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: Letter portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 215.9mm; --page-height: 279.4mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<ul class="box" style="inset-inline-start: 28.4mm; inset-block-start: 26.4mm; inline-size: 162.1mm; block-size: 12.7mm; font-size: 10.9pt"><li>{{ slot_0 }}</li></ul>
<ul class="box" style="inset-inline-start: 28.4mm; inset-block-start: 47.1mm; inline-size: 162.1mm; block-size: 12.7mm; font-size: 10.9pt"><li>{{ slot_1 }}</li></ul>
<ul class="box" style="inset-inline-start: 28.4mm; inset-block-start: 67.9mm; inline-size: 120.3mm; block-size: 3.8mm; font-size: 10.9pt"><li>{{ slot_2 }}</li></ul>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 79.2mm; inline-size: 165.0mm; block-size: 13.3mm; font-size: 10.9pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 101.6mm; inline-size: 165.1mm; block-size: 74.1mm; font-size: 10.9pt">{{ slot_4 }}</p>
<h2 class="box" style="inset-inline-start: 25.4mm; inset-block-start: 185.2mm; inline-size: 105.8mm; block-size: 3.8mm; font-size: 12.0pt">{{ slot_5 }}</h2>
<p class="box" style="inset-inline-start: 25.4mm; inset-block-start: 196.5mm; inline-size: 165.2mm; block-size: 56.6mm; font-size: 10.9pt">{{ slot_6 }}</p>
<footer class="box" style="inset-inline-start: 106.0mm; inset-block-start: 261.7mm; inline-size: 3.8mm; block-size: 3.8mm; font-size: 10.9pt">{{ slot_7 }}</footer>
</div></body>
</html>
