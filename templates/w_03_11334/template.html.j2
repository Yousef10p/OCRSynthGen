<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 18mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: var(--font-body);
}


.menu {
    background-color: #333;
    color: #fff;
    text-align: right;
    padding: 20px;
}

.menu ul {
    list-style-type: none;
    padding: 0;
}

.menu li {
    display: inline;
    margin-left: 10px;
}


.hero {
    text-align: center;
    padding: 50px;
}

.hero h1 {
    font-size: 36px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    margin-bottom: 30px;
}

.hero button {
    font-size: 24px;
    padding: 10px 20px;
    background-color: #f44336;
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.hero button:hover {
    background-color: #d32f2f;
}


.team {
    margin: 50px;
}

.team h2 {
    font-size: 24px;
    margin-bottom: 30px;
}

.team-member img {
    width: 100px;
    height: 100px;
    background-color: #bbdefb;  
}

.team-member h3 {
    font-size: 20px;
    margin-bottom: 10px;
}


.investors {
    margin: 50px;
}

.investors h2 {
    font-size: 24px;
    margin-bottom: 30px;
}

.investor img {
    width: 100px;
    height: 100px;
    background-color: #b2dfdb;  
}

.investor h3 {
    font-size: 20px;
    margin-bottom: 10px;
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
</style><style>{{ style }}</style></head>
<body>
<div class="menu">
<ul>
<li><a>{{ slot_0 }}</a></li>
<li><a>{{ slot_1 }}</a></li>
<li><a>{{ slot_2 }}</a></li>
<li><a>{{ slot_3 }}</a></li>
<li><a>{{ slot_4 }}</a></li>
<li><a>{{ slot_5 }}</a></li>
</ul>
</div>
<div class="hero">
<h1>{{ slot_6 }}</h1>
<p>{{ slot_7 }}</p>
<button>{{ slot_8 }}</button>
</div>
<div class="team">
<h2>{{ slot_9 }}</h2>
<div class="team-member">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h3>{{ slot_10 }}</h3>
<p>{{ slot_11 }}</p>
</div>

</div>
<div class="investors">
<h2>{{ slot_12 }}</h2>
<div class="investor">
<div class="ph" style="inline-size: 100%; block-size: 150px"></div>
<h3>{{ slot_13 }}</h3>
<p>{{ slot_14 }}</p>
</div>

</div>
</body>
</html>