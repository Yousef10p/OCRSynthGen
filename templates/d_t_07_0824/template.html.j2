<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<style>@page { size: A4 portrait; margin: 0; }
:root { --font-body: "Noto Naskh Arabic", "Amiri", serif; --font-heading: "Noto Naskh Arabic", "Amiri", serif; --base-size: 11pt; --line-height: 1.6; --align: justify; --page-width: 210mm; --page-height: 297mm; --page-margin: 0mm; }
html { font-family: var(--font-body); font-size: var(--base-size); line-height: var(--line-height); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--font-heading); margin-block: 0 0.4em; }
.page { box-sizing: border-box; inline-size: var(--page-width); min-block-size: var(--page-height); padding: var(--page-margin); text-align: var(--align); }
.ph { background: #d0d0d0; }
.page { position: relative; block-size: var(--page-height); padding: 0; overflow: hidden; }
.box { position: absolute; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; }
h1.box, h2.box { font-weight: bold; }
ul.box { list-style-position: inside; }
.box table { inline-size: 100%; block-size: 100%; border-collapse: collapse; table-layout: fixed; }
.box th, .box td { border: 1px solid #888; padding: 0 0.2em; overflow: hidden; }
</style>
<style>{{ style }}</style>
</head>
<body><div class="page">
<h2 class="box" style="inset-inline-start: 20.1mm; inset-block-start: 53.0mm; inline-size: 25.1mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_0 }}</h2>
<h2 class="box" style="inset-inline-start: 111.2mm; inset-block-start: 53.0mm; inline-size: 35.9mm; block-size: 3.9mm; font-size: 11.1pt">{{ slot_1 }}</h2>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 57.9mm; inline-size: 74.7mm; block-size: 24.7mm; font-size: 10.0pt">{{ slot_2 }}</p>
<p class="box" style="inset-inline-start: 111.2mm; inset-block-start: 57.9mm; inline-size: 79.5mm; block-size: 38.8mm; font-size: 10.0pt">{{ slot_3 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 84.7mm; inline-size: 75.8mm; block-size: 17.7mm; font-size: 10.0pt">{{ slot_4 }}</p>
<p class="box" style="inset-inline-start: 20.1mm; inset-block-start: 104.5mm; inline-size: 77.3mm; block-size: 21.2mm; font-size: 10.0pt">{{ slot_5 }}</p>
<h2 class="box" style="inset-inline-start: 21.1mm; inset-block-start: 127.7mm; inline-size: 40.1mm; block-size: 3.5mm; font-size: 10.0pt">{{ slot_6 }}</h2>
<div class="box ph" style="inset-inline-start: 20.8mm; inset-block-start: 133.3mm; inline-size: 168.6mm; block-size: 93.0mm; font-size: 14.6pt"></div>
<footer class="box" style="inset-inline-start: 193.7mm; inset-block-start: 283.0mm; inline-size: 7.8mm; block-size: 6.6mm; font-size: 18.7pt">{{ slot_7 }}</footer>
</div></body>
</html>
