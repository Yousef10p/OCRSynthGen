    font-size: 1.5rem;
    box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.1);
}

#contact {
    position: relative;
}

#contact::before {
    content: "";
    height: 3em;
    width: 3em;
    background-color: #e9ecef;
    position: absolute;
    top: -1.5em;
    right: -1.5em;
}

#contact::after {
    content: "";
    height: 3em;
    width: 3em;
    background-color: #e9ecef;
    position: absolute;
    bottom: -1.5em;
    left: -1.5em;
}

@media (max-width: 600px) {
    .product {
        width: 8em;
        height: 8em;
    }
}

.ph { background: #d0d0d0 !important; background-image: none !important; min-block-size: 2em; }
