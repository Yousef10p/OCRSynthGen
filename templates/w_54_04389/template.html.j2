<p>{{ slot_10 }}</p>
<p>{{ slot_11 }}</p>
</section>
<section id="games">
<h2>{{ slot_12 }}</h2>
<p>{{ slot_13 }}</p>
<p>{{ slot_14 }}</p>
</section>
</main>
</body>
</html>